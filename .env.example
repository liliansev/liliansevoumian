# Formulaire de contact (/api/contact via Resend)
# Clé API depuis https://resend.com (obligatoire en prod, sinon fallback mailto)
RESEND_API_KEY=re_xxxxx
# Optionnel — destinataire (défaut: bonjour@liliansevoumian.fr)
CONTACT_TO=bonjour@liliansevoumian.fr
# Optionnel — expéditeur (domaine vérifié dans Resend en prod)
CONTACT_FROM=contact@liliansevoumian.fr
