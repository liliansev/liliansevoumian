# Copier en .env pour le développement local. En production, ces valeurs vivent
# dans /opt/liliansevoumian/secrets/runtime.env sur le VPS (voir deploy/README.md).

# Newsletter de la page d'accueil : clé Mailcheap « signups only » (création de contacts seulement).
MAILCHEAP_API_KEY=

# Formulaire de contact : clé Resend ; CONTACT_FROM et CONTACT_TO sont facultatifs.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# Lecture des statistiques DataFast (scripts, pas le site).
DATAFAST_API_KEY=
