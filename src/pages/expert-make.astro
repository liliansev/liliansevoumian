const faqs = [
  {
    q: 'Make ou n8n, lequel choisir ?',
    a: reponseMakeOuN8n,
    html: reponseMakeOuN8nHtml,
  },
  {
    q: 'Mon équipe pourra-t-elle maintenir les scénarios sans moi ?',
