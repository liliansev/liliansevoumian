---
/*
 * /expert-make — landing SEO ciblée « expert Make » (ex-Integromat).
 * Angle propre à Make : visuel, maintenable par l'équipe, certification Niveau 5.
 * Contenu distinct de /expert-n8n (pas de page doublon — angles, cas d'usage et
 * FAQ différents) ; la charpente, elle, est partagée : voir PageExpertOutil.
 */
import PageExpertOutil from '../layouts/PageExpertOutil.astro';

// Ce que je fais avec Make — props de valeur (angle Make : visuel + maintenable).
const valeur = [
  {
    titre: 'Des scénarios visuels que votre équipe lit',
    texte: "Make rend chaque automatisation lisible étape par étape. Votre équipe voit ce qui se passe, repère une erreur, ajuste un filtre, sans dépendre de moi pour le moindre changement.",
  },
  {
    titre: '1 500+ applications connectées',
    texte: "HubSpot, Pipedrive, Notion, Airtable, Slack, Google Workspace, Stripe, Pennylane… Si vos outils ont une API, je les branche entre eux et fais circuler la donnée au bon endroit.",
  },
  {
    titre: 'Une couche d’erreur sur chaque scénario',
    texte: "try/catch, alertes Slack, reprise propre. Quand une API tierce bouge, vous le voyez et vous savez quoi faire, même un dimanche soir.",
  },
  {
    titre: 'Du premier scénario au transfert',
    texte: "Je conçois, je documente (une doc custom qui colle à votre setup), je forme. L'objectif : à la livraison, vos équipes sont autonomes sur les modifications courantes.",
  },
];

// Ce qu'on peut automatiser avec Make — cas d'usage (SEO + concret).
const casUsage = [
  'Synchroniser votre CRM avec vos autres outils (lead → CRM → facturation → Slack)',
  'Automatiser les relances commerciales et l’onboarding client',
  'Consolider votre reporting (Google Sheets, Notion, tableaux de bord)',
  'Générer devis, factures et documents à partir d’un formulaire',
  'Router les demandes entrantes vers la bonne personne, sans tri manuel',
  'Connecter vos formulaires, paiements et e-mails en un flux unique',
];

const faqs = [
  {
    q: 'Make ou n8n, lequel choisir ?',
    a: "Make si vous voulez du visuel, maintenable par votre équipe, et une connexion rapide à des outils SaaS courants. n8n si vous avez des contraintes de souveraineté (données sensibles, RGPD strict), du volume de données important, ou besoin d’agents IA et de code sur-mesure. Je travaille les deux et je vous dis lequel colle à votre cas.",
  },
  {
    q: 'Mon équipe pourra-t-elle maintenir les scénarios sans moi ?',
    a: "Oui, c’est le but. Make est visuel par nature, et je livre une documentation custom + une session de formation. Modifier un filtre, ajouter un destinataire, dupliquer un scénario : votre équipe le fait seule. Pour les évolutions profondes, une séance à la carte suffit.",
  },
  {
    q: 'Combien de temps pour un premier scénario ?',
    a: "On valide le périmètre pendant l'appel de 20 minutes, avant de lancer quoi que ce soit. Le délai dépend du nombre d'outils à connecter et de la logique métier. Je vous l'annonce à ce moment-là.",
  },
  {
    q: 'Make est-il assez puissant pour mon besoin ?',
    a: "Pour la grande majorité des automatisations métiers (connecter des outils, faire circuler la donnée, déclencher des actions), oui, largement. Si votre besoin tire vers du traitement de gros volumes de données ou de l’hébergement maîtrisé, je bascule sur n8n, et je vous le dis.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  /* Un `@id` propre, rattaché à l'entité globale par `isPartOf` : sans lui, un
     moteur voit deux ProfessionalService sans savoir s'il s'agit de la même
     organisation. */
  "@id": "https://liliansevoumian.fr/expert-make#service",
  "isPartOf": { "@id": "https://liliansevoumian.fr/automatisations-ia#service" },
  "name": "Expert Make freelance · Lilian Sevoumian",
  "description": "Expert Make (ex-Integromat) freelance, certifié Niveau 5. Automatisation des processus métier, intégration d’outils et scénarios no-code maintenables.",
  "url": "https://liliansevoumian.fr/expert-make",
  "areaServed": "France",
  "serviceType": ["Automatisation Make", "Intégration Make", "Conseil no-code", "Formation Make"],
  "knowsAbout": ["Make", "Integromat", "Automatisation des processus", "Intégration API", "No-Code", "Workflow"],
  "provider": { "@id": "https://liliansevoumian.fr/#person" },
};

const stats = [
  { label: 'CERTIFICATION', valeur: 'Make Niveau 5' },
  { label: 'EN PRODUCTION', valeur: 'Depuis 2020' },
  { label: 'APRÈS LIVRAISON', valeur: 'Corrections incluses' },
];
---

<PageExpertOutil
  outil="Make"
  url="/expert-make"
  titreSeo="Expert Make freelance · automatisation no-code | Lilian Sevoumian"
  descriptionSeo="Expert Make (ex-Integromat) freelance, certifié Niveau 5, le premier en France. J'automatise vos processus métier et connecte vos outils en scénarios visuels maintenables. Réponse sous 48 h."
  serviceSchema={serviceSchema}
  icone="simple-icons:make"
  badge="EXPERT MAKE · CERTIFIÉ NIVEAU 5"
  titreHtml="Expert <mark>Make</mark> freelance."
  chapo="Certifié Niveau 5, le premier en France. J'automatise vos processus métier et connecte vos outils en scénarios visuels que votre équipe peut lire, suivre et maintenir."
  titreValeur="Du visuel, du robuste, du maintenable."
  valeur={valeur}
  titreCasUsage="Ce qu'on peut automatiser avec Make."
  casUsage={casUsage}
  titrePourquoi="Le premier certifié Make Niveau 5 en France."
  textePourquoi="J'automatise des process depuis 2020, pour des fondateurs, des dirigeants et des équipes ops. Des automatisations qui tiennent dans le temps, documentées, avec une couche d'erreur sur chacune."
  stats={stats}
  titreFaq="Les questions qui reviennent sur Make."
  faqs={faqs}
  lienCroise={{ question: 'BESOIN PLUTÔT DE n8n ?', href: '/expert-n8n', libelle: 'VOIR LA PAGE EXPERT N8N' }}
  titreCtaFinal="Un scénario Make en tête ?"
>
  <Fragment slot="preuves">
    <span class="text-[var(--color-accent-text)]">MAKE CERTIFIÉ N5</span> · 300+ PERSONNES FORMÉES · RÉPONSE SOUS 48&nbsp;H
  </Fragment>

  <Fragment slot="cta-texte">
    20&nbsp;min pour poser votre process à plat. Sans engagement. Votre scénario Make existe déjà et il casse&nbsp;? <a class="lien-prose" href="/reprendre-une-automatisation-qui-casse">Je le reprends</a>.
  </Fragment>
</PageExpertOutil>
