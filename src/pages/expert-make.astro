  misAJour="2026-10-03"
  faqs={faqs}
  titreFin="Un scénario Make <mark>en tête ?</mark>"
  suiteFin={'Décrivez-le en une phrase, je vous réponds <span class="whitespace-nowrap">moi-même</span>. Il existe déjà et il casse ? <a class="lien-prose" href="/reprendre-une-automatisation-qui-casse">Je le reprends</a>.'}
/>
