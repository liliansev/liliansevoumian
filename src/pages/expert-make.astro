 * questions différents) ; la charpente est partagée : voir PageExpertOutil.
 *
 * Les phrases des cas reprennent les chiffres des fiches de
 * `src/content/cas-clients` : en changer un là-bas, c'est le changer ici.
 */
import PageExpertOutil from '../layouts/PageExpertOutil.astro';
import { DUREE_RESERVATION_MINUTES } from '../lib/reservation';
import { reponseMakeOuN8n, reponseMakeOuN8nHtml } from '../data/make-ou-n8n';

