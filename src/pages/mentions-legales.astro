---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import TeteDePage from '../components/tete-de-page.astro';

const title = "Mentions légales · Lilian Sevoumian";
const description = "Mentions légales du site liliansevoumian.fr · Expert Automatisation Make & n8n.";

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Mentions légales", url: "/mentions-legales" },
];

const sections = [
  {
    title: "Éditeur du site",
    body: [
      ["Identité", "Lilian Sevoumian, Entrepreneur individuel"],
      ["Contact", "lilian.sevoumian@gmail.com"],
      ["Site", "https://liliansevoumian.fr"],
    ],
  },
  {
    title: "Hébergement",
    body: [
      /* La société qui contracte avec un client de l'Union européenne, d'après
         les conditions générales de Hostinger (relevé le 3 octobre 2026). Le
         site tourne sur un serveur privé virtuel loué chez elle. */
      ["Hébergeur", "Hostinger International Limited"],
      ["Adresse", "61 Lordou Vironos Street, 6023 Larnaca, Chypre"],
      ["Site", "https://www.hostinger.com"],
    ],
  },
  {
    title: "Propriété intellectuelle",
    text: "L’ensemble du contenu de ce site (textes, graphismes, logo, icônes, code) est la propriété exclusive de Lilian Sevoumian, sauf mention contraire. Toute reproduction, distribution, modification ou utilisation sans autorisation préalable est interdite.",
  },
  {
    title: "Données personnelles",
    text: "Ce site n’utilise pas de cookies tiers. L’outil d’analyse (DataFast) fonctionne sans cookie : aucune donnée personnelle identifiante n’est collectée, aucun cookie n’est déposé. Pour exercer vos droits RGPD (accès, rectification, suppression), contactez lilian.sevoumian@gmail.com.",
  },
  {
    title: "Mesure d’audience",
    body: [
      ["DataFast", "Mesure d’audience sans cookie, relayée par le serveur du site. Pas de cookie tiers, pas de traceur d’un site à l’autre."],
    ],
  },
  {
    title: "Responsabilité",
    text: "Les informations fournies sur ce site le sont à titre indicatif. Lilian Sevoumian ne saurait être tenu responsable des erreurs, d’une absence de disponibilité des informations ou de la présence de virus sur le site.",
  },
];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs} noindex={true}>
  <Navigation ctaSource="mentions_nav" />

  <main id="main-content" tabindex="-1" class="outline-none">
    <TeteDePage titre="<mark>Mentions légales</mark>" />

    {/* Un document : le nom de la rubrique à gauche, son contenu à droite.
        Ni numéro, ni cadre, ni filet entre les rubriques. */}
    <section class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]">
      <div class="mentions mx-auto max-w-[1200px]">
        {sections.map((section) => (
          <article class="mention reveal">
            <h2>{section.title}</h2>

            {section.text && <p>{section.text}</p>}

            {section.body && (
              <dl>
                {section.body.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            )}
          </article>
        ))}

        <p class="mentions__date reveal">Dernière mise à jour : octobre 2026</p>
      </div>
    </section>
  </main>

  <Footer showContact />
</Layout>

<style>
  .mentions {
    display: grid;
    gap: var(--spacing-bloc);
  }

  .mention {
    display: grid;
    gap: var(--spacing-lie);
  }

  .mention h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-title-lg);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .mention p,
  .mention dl {
    max-width: 46ch;
    margin: 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  .mention dl {
    display: grid;
    gap: 0.75rem;
  }

  .mention dt {
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .mention dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .mentions__date {
    margin: 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  @media (min-width: 1024px) {
    .mention {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      column-gap: var(--spacing-gouttiere);
      align-items: start;
    }
  }
</style>
