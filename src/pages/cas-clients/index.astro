---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import MobileCTABar from '../../components/MobileCTABar.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getCollection } from 'astro:content';

// Cas clients = collection Markdown locale (src/content/cas-clients/).
// Brouillons (draft: true) : visibles en dev, exclus du build de prod.
const showDrafts = !import.meta.env.PROD;
const all = await getCollection('cas-clients');
const entries = all
  .filter((entry) => showDrafts || !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const displayStudies = entries.map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  secteur: entry.data.secteur,
  tags: entry.data.tags,
  tools: entry.data.tools,
  kpis: entry.data.kpis,
}));

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Cas clients Automatisation - Lilian Sevoumian",
  "description": "Cas clients d'automatisation Make, n8n et Airtable. Workflows réels, métriques mesurées, contexte chiffré.",
  "url": "https://liliansevoumian.fr/cas-clients",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": displayStudies.map((cs, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://liliansevoumian.fr/cas-clients/${cs.slug}`,
      "name": cs.title
    }))
  },
  "author": { "@type": "Person", "name": "Lilian Sevoumian" }
};

const total = displayStudies.length;

/* Nombre de colonnes de la grille de cartes, déduit du nombre de cas.
   Il était figé à `lg:grid-cols-3`, et le nombre de cas vient de la collection :
   à quatre fiches, la grille rendait trois cartes en rang 1 et une orpheline en
   rang 2. Mesuré à 1440 px, les deux cellules laissées vides faisaient
   816 × 463 px de blanc au milieu de la page, soit un tiers de la grille — la
   même page à 768 px, en deux colonnes, affichait un 2 × 2 sans trou.
   La règle qui remplace la valeur figée compte les trous : on garde le nombre
   de colonnes qui en laisse le moins, et on préfère la grille la plus dense à
   égalité. 3 cas → 3 colonnes, 4 → 2 × 2, 5 → 3 + 2, 6 → 3 × 3, 8 → 2 × 4.
   Aucune configuration ne peut plus laisser une rangée à moitié vide.
   Les classes sont écrites en toutes lettres et non interpolées : Tailwind
   scanne le source, une classe construite à la volée n'existerait pas au build. */
const trous = (colonnes: number) => (colonnes - (total % colonnes)) % colonnes;
const colonnesLg = total < 3 ? Math.max(total, 1) : trous(3) <= trous(2) ? 3 : 2;
const classeLg =
  colonnesLg === 3 ? 'lg:grid-cols-3' : colonnesLg === 2 ? 'lg:grid-cols-2' : 'lg:grid-cols-1';
const classeMd = total >= 2 ? 'md:grid-cols-2' : 'md:grid-cols-1';

/* Grille de KPI : une seule colonne, à toutes les tailles.
   Deux raisons mesurées. Le séparateur est le fond du conteneur qui
   transparaît par le `gap-px` : toute cellule manquante se remplit de gris, et
   trois KPI sur deux colonnes laissaient un carré gris dans la carte. Et les
   cartes tiennent à trois de front, soit ~390 px : découpées en trois
   colonnes, les cellules tombaient à 111 px pour des libellés qui en
   demandaient 117, et « AUTOMATIQUEMENT » débordait de la carte.
   La page de détail, elle, dispose de toute la largeur et garde ses trois
   colonnes. */
---

<Layout
  title="Cas clients Automatisation Make & n8n | Lilian Sevoumian"
  description="Cas clients d'automatisation Make, n8n et Airtable. Workflows réels, métriques mesurées, contexte chiffré."
  breadcrumbs={breadcrumbs}
  articleSchema={collectionSchema}
>
  <Navigation />

  <main id="main-content">
    <section
      data-section
      class="relative pt-[80px] md:pt-[88px] px-[var(--spacing-section-x)]"
    >
      <div class="relative max-w-[1200px] mx-auto pt-12 md:pt-20 pb-[var(--spacing-section-y)]">

        <a
          href="/"
          class="tap-44 inline-flex items-center gap-2 mono-caption text-[var(--color-ink-low)] hover:text-[var(--color-ink)] transition-colors mb-8"
        >
          <span aria-hidden="true">←</span>
          RETOUR À L'ACCUEIL
        </a>

        <div class="reveal mb-6 md:mb-8 inline-block bg-[var(--color-paper)] py-1.5 pr-2">
          <span class="mono-caption text-[var(--color-ink-low)]">
            CAS CLIENTS · {total} WORKFLOW{total > 1 ? 'S' : ''} DOCUMENTÉ{total > 1 ? 'S' : ''}
          </span>
        </div>

        {/* Le voile est descendu du conteneur au paragraphe, comme sur la home
            (HeroManifesto.astro:36-47) : englobé dans un `.reveal`, le h1 était
            peint à opacity 0, disqualifié comme candidat LCP, et laissé
            invisible 2,5 s si le module de reveal échouait. */}
        <div class="mb-10 md:mb-12 bg-[var(--color-paper)] max-w-[64ch] py-2 pr-2 relative">
          <h1 class="font-display font-semibold text-[length:var(--text-display)] leading-[0.98] tracking-[-0.045em] text-[var(--color-ink)] m-0 max-w-[18ch]">
            Des workflows en production, documentés.
          </h1>
          <p class="reveal text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 pt-5 max-w-[60ch]">
            Pour chaque cas : le contexte chiffré, l'architecture retenue, les métriques mesurées et les outils utilisés.
          </p>
        </div>

        {displayStudies.length === 0 ? (
          <div class="reveal card p-10 text-center">
            <p class="mono-caption text-[var(--color-ink-low)] mb-3">CAS EN COURS DE PUBLICATION</p>
            <p class="text-[var(--color-ink-mid)] mb-6 max-w-[44ch] mx-auto">
              Pour discuter d'un cas similaire au vôtre, le plus efficace est l'appel direct.
            </p>
            <a href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer" class="btn-primary"
               data-fast-goal="lead_call" data-fast-goal-source="cas_index_empty">
              Réserver mon diagnostic · 20 min
            </a>
          </div>
        ) : (
          <div class:list={['grid grid-cols-1 gap-6 reveal-stagger', classeMd, classeLg]}>
            {displayStudies.map((cs) => {
              const tools = cs.tools || [];
              const kpis = cs.kpis || [];
              const tags = cs.tags || [];
              return (
                <a
                  href={`/cas-clients/${cs.slug}`}
                  class="reveal relative card card-interactive bg-[var(--color-paper)] flex flex-col gap-5"
                >

                  {(cs.secteur || tags.length > 0) && (
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mono-caption text-[var(--color-ink-low)]">
                      {cs.secteur && <span>{cs.secteur.toUpperCase()}</span>}
                      {cs.secteur && tags.length > 0 && <span aria-hidden="true">·</span>}
                      {tags.length > 0 && <span>{tags.join(' · ').toUpperCase()}</span>}
                    </div>
                  )}

                  <h2 class="font-display font-semibold text-[length:var(--text-title)] tracking-[-0.02em] text-[var(--color-ink)] leading-[1.2] m-0">
                    {cs.title}
                  </h2>

                  {kpis.length > 0 && (
                    <div class="grid grid-cols-1 gap-px bg-[var(--color-divider)] mt-auto">
                      {kpis.slice(0, 3).map((kpi) => (
                        <div class="bg-[var(--color-paper)] py-3 flex flex-col gap-1">
                          <span class="font-display font-semibold tabular-nums text-xl tracking-[-0.025em] text-[var(--color-ink)] leading-none">
                            {kpi.value}
                          </span>
                          <span class="mono-caption text-[var(--color-ink-low)] leading-tight">{kpi.label}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  {tools.length > 0 && (
                    <div class="flex flex-wrap gap-2 pt-4 border-t border-[var(--color-divider)]">
                      {tools.slice(0, 4).map((tool) => (
                        <span class="chip chip-accent">{tool}</span>
                      ))}
                      {tools.length > 4 && (
                        <span class="chip chip-dashed">+ {tools.length - 4}</span>
                      )}
                    </div>
                  )}

                  <span class="mono-caption text-[var(--color-accent-text)] inline-flex items-center gap-1.5 mt-2">
                    LIRE LE DÉTAIL
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              );
            })}
          </div>
        )}

      </div>
    </section>

    <!-- CTA section -->
    <section class="bloc-lime relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
      <div class="relative max-w-[1200px] mx-auto">
        <SectionHeader
          title="Un projet qui ressemble à <mark class='inv'>l'un de ceux-là ?</mark>"
          body="20 min pour décider si on travaille ensemble. On regarde un de vos process, je vous dis ce qui est automatisable."
          titleMaxWidth="22ch"
          bodyMaxWidth="60ch"
          class="!mb-0"
        />

        <div class="reveal mt-10 md:mt-12 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary justify-center"
            data-fast-goal="lead_call"
            data-fast-goal-source="cas_index"
          >
            Réserver mon diagnostic · 20 min
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileCTABar />
</Layout>
