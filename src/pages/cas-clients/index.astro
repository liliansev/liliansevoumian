---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import CaseStudyCard from '../../components/ui/CaseStudyCard.astro';
import CTAButton from '../../components/ui/CTAButton.astro';
import { getCaseStudies } from '../../lib/notion';

const caseStudies = await getCaseStudies();

// SEO: Breadcrumbs
const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' }
];

// SEO: Collection Page Schema
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Cas clients Automatisation - Lilian Sevoumian",
  "description": "Découvrez mes réalisations en automatisation Make, n8n et Airtable. Des cas concrets avec résultats mesurables : gain de temps, réduction des erreurs, workflows optimisés.",
  "url": "https://liliansevoumian.fr/cas-clients",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": caseStudies.map((cs, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://liliansevoumian.fr/cas-clients/${cs.slug}`,
      "name": cs.title
    }))
  },
  "author": {
    "@type": "Person",
    "name": "Lilian Sevoumian"
  }
};
---

<Layout
  title="Cas clients Automatisation Make & n8n | Lilian Sevoumian"
  description="Découvrez mes réalisations en automatisation Make, n8n et Airtable. Des cas concrets avec résultats mesurables : gain de temps, réduction des erreurs, workflows optimisés."
  breadcrumbs={breadcrumbs}
  articleSchema={collectionSchema}
>
  <Navigation />

  <main id="main-content">
    <!-- Header -->
    <section class="section-padding px-6 bg-zinc-100 dark:bg-zinc-900 pt-32">
      <div class="max-w-5xl mx-auto">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-zinc-500 dark:text-zinc-400 hover:text-violet-600 dark:hover:text-violet-400 text-sm font-medium mb-10 transition-colors group"
        >
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Retour à l'accueil
        </a>

        <p class="fluid-text-xs text-zinc-500 dark:text-zinc-400 font-medium uppercase mb-3">
          Cas clients
        </p>
        <h1 class="fluid-h1 font-semibold text-zinc-900 dark:text-white max-w-3xl mb-4">
          Des automatisations<br />qui font la différence.
        </h1>
        <p class="fluid-text-lg text-zinc-500 dark:text-zinc-400 max-w-2xl">
          Chaque projet est unique. Découvrez comment j'ai aidé mes clients à gagner du temps et à réduire leurs erreurs grâce à l'automatisation.
        </p>
      </div>
    </section>

    <!-- Case Studies Grid -->
    <section class="section-padding px-6 bg-zinc-100 dark:bg-zinc-900 pt-0">
      <div class="max-w-5xl mx-auto">
        {caseStudies.length > 0 ? (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {caseStudies.map((caseStudy) => (
              <CaseStudyCard caseStudy={caseStudy} />
            ))}
          </div>
        ) : (
          <div class="text-center py-16">
            <p class="text-zinc-500 dark:text-zinc-400">Aucun cas client disponible pour le moment.</p>
          </div>
        )}
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding px-6 bg-zinc-100 dark:bg-zinc-900">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="fluid-h2 font-semibold text-zinc-900 dark:text-white mb-4">
          Un projet similaire ?
        </h2>
        <p class="fluid-text-lg text-zinc-500 dark:text-zinc-400 mb-8">
          Discutons de vos besoins en automatisation.
        </p>
        <CTAButton
          href="https://cal.com/lilian-sevoumian/20min"
          text="Prendre rendez-vous"
          variant="primary"
          size="lg"
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
