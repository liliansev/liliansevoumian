---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getCaseStudies } from '../../lib/notion';
import type { CaseStudy } from '../../types/case-study';

const notionStudies = await getCaseStudies();

// Fallback minimal — aligné sur le système Operator's Console (pas de palette legacy).
// Sert uniquement quand l'API Notion est indisponible au build.
const fallbackStudies: Pick<CaseStudy, 'title' | 'slug' | 'tags' | 'kpis' | 'tools' | 'secteur'>[] = [
  {
    title: "Pipeline ventes : 15 h économisées par semaine",
    slug: "pipeline-ventes-saas",
    secteur: "STARTUP B2B SAAS",
    tags: ["n8n", "Claude"],
    kpis: [
      { value: "15 h", label: "ÉCONOMISÉES /SEM" },
      { value: "€42 K", label: "ÉCONOMIE /AN" },
      { value: "0", label: "ERREUR /MOIS" },
    ],
    tools: ["n8n", "HubSpot", "Slack", "Claude"],
  },
];

const displayStudies: Array<Pick<CaseStudy, 'title' | 'slug' | 'tags' | 'kpis' | 'tools' | 'secteur'>> =
  notionStudies.length > 0 ? notionStudies : fallbackStudies;

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Cas clients Automatisation - Lilian Sevoumian",
  "description": "Cas clients d'automatisation Make, n8n et Airtable. Workflows réels, métriques mesurées, contexte chiffré.",
  "url": "https://liliansevoumian.fr/cas-clients",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": displayStudies.map((cs, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://liliansevoumian.fr/cas-clients/${cs.slug}`,
      "name": cs.title
    }))
  },
  "author": { "@type": "Person", "name": "Lilian Sevoumian" }
};

const total = displayStudies.length;

import { chipClass } from '../../lib/tool-chip';
---

<Layout
  title="Cas clients Automatisation Make & n8n | Lilian Sevoumian"
  description="Cas clients d'automatisation Make, n8n et Airtable. Workflows réels, métriques mesurées, contexte chiffré."
  breadcrumbs={breadcrumbs}
  articleSchema={collectionSchema}
>
  <Navigation />

  <main id="main-content">
    <section
      data-section
      class="relative pt-[80px] md:pt-[88px] px-[var(--spacing-section-x)]"
    >
      <div class="relative max-w-[1200px] mx-auto pt-12 md:pt-20 pb-[var(--spacing-section-y)]">

        <a
          href="/"
          class="inline-flex items-center gap-2 mono-caption text-[var(--color-ink-low)] hover:text-[var(--color-ink)] transition-colors mb-8"
        >
          <span aria-hidden="true">←</span>
          RETOUR À L'ACCUEIL
        </a>

        <div class="reveal mb-6 md:mb-8 inline-block bg-[var(--color-paper)] py-1.5 pr-2">
          <span class="mono-caption text-[var(--color-ink-low)]">
            CAS CLIENTS · {total} WORKFLOW{total > 1 ? 'S' : ''} DOCUMENTÉ{total > 1 ? 'S' : ''}
          </span>
        </div>

        <div class="reveal mb-10 md:mb-12 bg-[var(--color-paper)] max-w-[64ch] py-2 pr-2 relative">
          <h1 class="font-display font-semibold text-[length:var(--text-display)] leading-[0.98] tracking-[-0.045em] text-[var(--color-ink)] m-0 max-w-[18ch]">
            Des workflows en production, documentés.
          </h1>
          <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 pt-5 max-w-[60ch]">
            Chaque cas est documenté avec son contexte, son architecture, ses métriques mesurées. Le contexte chiffré et l'outil utilisé, à chaque fois.
          </p>
        </div>

        {displayStudies.length === 0 ? (
          <div class="reveal card p-10 text-center">
            <p class="mono-caption text-[var(--color-ink-low)] mb-3">CAS EN COURS DE PUBLICATION</p>
            <p class="text-[var(--color-ink-mid)] mb-6 max-w-[44ch] mx-auto">
              Pour discuter d'un cas similaire au vôtre, le plus efficace est l'appel direct.
            </p>
            <a href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer" class="btn-primary">
              Réserver un appel · 20 min
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
            {displayStudies.map((cs) => {
              const tools = cs.tools || [];
              const kpis = cs.kpis || [];
              const tags = cs.tags || [];
              return (
                <a
                  href={`/cas-clients/${cs.slug}`}
                  class="reveal relative card card-interactive bg-[var(--color-paper)] flex flex-col gap-5"
                >

                  {(cs.secteur || tags.length > 0) && (
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mono-caption text-[var(--color-ink-low)]">
                      {cs.secteur && <span>{cs.secteur.toUpperCase()}</span>}
                      {cs.secteur && tags.length > 0 && <span aria-hidden="true">·</span>}
                      {tags.length > 0 && <span>{tags.join(' · ').toUpperCase()}</span>}
                    </div>
                  )}

                  <h3 class="font-display font-semibold text-[length:var(--text-title)] tracking-[-0.02em] text-[var(--color-ink)] leading-[1.2] m-0">
                    {cs.title}
                  </h3>

                  {kpis.length > 0 && (
                    <div class="grid grid-cols-3 gap-px bg-[var(--color-divider)] mt-auto">
                      {kpis.slice(0, 3).map((kpi: { value: string; label: string }) => (
                        <div class="bg-[var(--color-paper)] py-3 flex flex-col gap-1">
                          <span class="font-display font-semibold tabular-nums text-xl tracking-[-0.025em] text-[var(--color-ink)] leading-none">
                            {kpi.value}
                          </span>
                          <span class="mono-caption text-[var(--color-ink-low)] leading-tight">{kpi.label}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  {tools.length > 0 && (
                    <div class="flex flex-wrap gap-2 pt-4 border-t border-[var(--color-divider)]">
                      {tools.slice(0, 4).map((tool: string) => (
                        <span class={chipClass(tool)}>{tool}</span>
                      ))}
                      {tools.length > 4 && (
                        <span class="chip chip-dashed">+ {tools.length - 4}</span>
                      )}
                    </div>
                  )}

                  <span class="mono-caption text-[var(--color-violet-deep)] inline-flex items-center gap-1.5 mt-2">
                    LIRE LE DÉTAIL
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              );
            })}
          </div>
        )}

      </div>
    </section>

    <!-- CTA section -->
    <section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <SectionHeader
          number="↦"
          label="APPEL"
          title="Un projet qui ressemble à l'un de ceux-là ?"
          body="20 min pour décider si on travaille ensemble. Format identique à chaque fois : 5 min de contexte, 15 min sur vos process, 10 min sur la marche à suivre."
          titleMaxWidth="22ch"
          bodyMaxWidth="60ch"
          class="!mb-0"
        />

        <div class="reveal mt-10 md:mt-12 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary justify-center"
          >
            Réserver maintenant
          </a>
          <a
            href="mailto:bonjour@liliansevoumian.fr"
            class="btn-ghost justify-center"
          >
            ou écrire un mail
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
