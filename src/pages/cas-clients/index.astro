---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCaseStudies } from '../../lib/notion';

const caseStudies = await getCaseStudies();

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Cas clients Automatisation - Lilian Sevoumian",
  "description": "Découvrez mes réalisations en automatisation Make, n8n et Airtable. Des cas concrets avec résultats mesurables.",
  "url": "https://liliansevoumian.fr/cas-clients",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": caseStudies.map((cs, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://liliansevoumian.fr/cas-clients/${cs.slug}`,
      "name": cs.title
    }))
  },
  "author": { "@type": "Person", "name": "Lilian Sevoumian" }
};
---

<Layout
  title="Cas clients Automatisation Make & n8n | Lilian Sevoumian"
  description="Découvrez mes réalisations en automatisation Make, n8n et Airtable. Des cas concrets avec résultats mesurables : gain de temps, réduction des erreurs, workflows optimisés."
  breadcrumbs={breadcrumbs}
  articleSchema={collectionSchema}
>
  <Navigation />

  <main id="main-content">
    <!-- Header (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden pt-28 pb-0">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] px-[var(--spacing-section-x)]">
        <div class="max-w-[1200px] mx-auto">
          <a href="/" class="inline-flex items-center gap-2 font-body text-[length:var(--text-body-sm)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors mb-8 group">
            <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
            Retour à l'accueil
          </a>

          <div class="flex flex-col gap-5 fade-in-section">
            <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-purple-dark)]">
              CAS CLIENTS
            </span>
            <h1 class="font-display text-[length:var(--text-display)] font-bold text-[var(--color-text-primary)] leading-[1.08]">
              Des automatisations<br />qui font la différence.
            </h1>
            <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.6] max-w-[640px]">
              Chaque projet est unique. Découvrez comment j'ai aidé mes clients à gagner du temps et à réduire leurs erreurs grâce à l'automatisation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Case Studies Grid (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] py-12 px-[var(--spacing-section-x)]">
        <div class="max-w-[1200px] mx-auto">
          {caseStudies.length > 0 ? (
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
              {caseStudies.map((caseStudy) => (
                <a
                  href={`/cas-clients/${caseStudy.slug}`}
                  class="reveal-card card-3d-hover card-3d-white-orange flex flex-col p-[28px_24px] no-underline group"
                >
                  {caseStudy.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-3">
                      {caseStudy.tags.map((tag: string) => (
                        <span class="rounded-full px-3 py-1 text-[length:var(--text-caption)] font-medium font-mono" style="background: rgba(232, 106, 51, 0.1); color: var(--color-orange);">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                  <h3 class="text-[length:var(--text-body-lg)] font-bold text-[#1A1A1A] font-display mb-3 group-hover:text-[var(--color-orange)] transition-colors">
                    {caseStudy.title}
                  </h3>
                  {caseStudy.kpis.length > 0 && (
                    <div class="grid grid-cols-3 gap-2 mb-3">
                      {caseStudy.kpis.map((kpi: { value: string; label: string }) => (
                        <div class="text-center p-2 rounded-[var(--radius-sm)]" style="background: rgba(232, 106, 51, 0.06);">
                          <p class="font-mono text-sm font-bold text-[var(--color-orange)]">{kpi.value}</p>
                          <p class="text-[length:var(--text-micro)] text-[var(--color-text-muted)] leading-tight">{kpi.label}</p>
                        </div>
                      ))}
                    </div>
                  )}
                  {caseStudy.tools.length > 0 && (
                    <div class="flex flex-wrap gap-2 pt-3 mt-auto border-t border-black/[0.06]">
                      {caseStudy.tools.map((tool: string) => (
                        <span class="font-mono text-[length:var(--text-micro)] text-[var(--color-text-muted)] px-2 py-1 rounded-[var(--radius-sm)]" style="background: rgba(26, 26, 26, 0.04);">
                          {tool}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          ) : (
            <div class="text-center py-16">
              <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)]">Aucun cas client disponible pour le moment.</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- CTA (WHITE) -->
    <section data-bg="white" class="relative bg-white overflow-hidden">
      <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[600px] mx-auto text-center flex flex-col items-center gap-4 fade-in-section">
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)]">
            Un projet similaire&nbsp;?
          </h2>
          <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)]">
            Discutons de vos besoins en automatisation — l'appel est gratuit, 30&nbsp;min, sans engagement.
          </p>
          <a
            href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
            class="btn-3d inline-flex items-center justify-center font-body text-[length:var(--text-body)] font-semibold px-7 py-3.5 mt-2 group"
          >
            Réserver mon appel stratégique <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
