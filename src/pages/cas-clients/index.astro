---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import TeteDePage from '../../components/tete-de-page.astro';
import FinDePage from '../../components/fin-de-page.astro';
import Outils from '../../components/robot/outils.astro';
import { espaces } from '../../lib/espaces';
import { clients } from '../../data/clients';
import { getCollection } from 'astro:content';

// Cas clients = collection Markdown locale (src/content/cas-clients/).
// Brouillons (draft: true) : visibles en dev, exclus du build de prod.
const showDrafts = !import.meta.env.PROD;
const all = await getCollection('cas-clients');
// Même ordre que sur l'accueil (`robot/projets.astro`) : les cas qui ont un
// avant / après d'abord, puis du plus récent au plus ancien. La page promet
// « avant et après » : sa première feuille doit le montrer.
const entries = all
  .filter((entry) => showDrafts || !entry.data.draft)
  .sort((a, b) => Number(!!b.data.bascule) - Number(!!a.data.bascule) || b.data.date.getTime() - a.data.date.getTime());

/* Les espaces insécables du français, posées à l'affichage (`lib/espaces.ts`) :
   les textes des cas ne les portent pas. */

// Le titre garde aussi sa forme d'origine : c'est elle que lit le balisage
// de la collection. Sur la page, chaque cas porte son titre en clair
// (`enClair` : ce qui a été construit), le nom du client au-dessus.
//
// Une feuille montre quatre outils et quatre lignes au plus : le cas complet
// est derrière le lien. Le nom du client s'écrit en lettres, comme sur
// l'accueil ; son logo, quand il en a un (`data/clients.ts`), signe la ligne.
// Le trait d'union d'un secteur ne se coupe pas (« E- / commerce » à 360 px),
// et son point médian reste au bout de la ligne, jamais au début de la suivante.
const displayStudies = entries.map((entry) => {
  const client = entry.data.client ?? entry.data.title;
  return {
    slug: entry.id,
    title: entry.data.title,
    client,
    logo: clients.find((c) => c.nom === client)?.logo,
    secteur: entry.data.secteur && espaces(entry.data.secteur).replace(/-/g, '\u2011').replace(/ ·/g, '\u00a0·'),
    titre: espaces(entry.data.enClair ?? entry.data.title),
    texte: espaces(entry.data.accroche ?? entry.data.description ?? ''),
    tools: entry.data.tools.slice(0, 4),
    ecarts: (entry.data.bascule ?? []).slice(0, 4).map((l) => ({ avant: espaces(l.avant), apres: espaces(l.apres) })),
    parcours: (entry.data.parcours ?? []).map((e) => ({ qui: espaces(e.kicker), quoi: espaces(e.title) })),
    scopeNote: entry.data.scopeNote && espaces(entry.data.scopeNote),
  };
});

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://liliansevoumian.fr/cas-clients#collection",
  "name": "Cas clients : automatisations et applications métiers - Lilian Sevoumian",
  "description": "Projets Make, n8n et Glide : contexte, fonctionnalités réalisées et résultats disponibles. Cas clients d’automatisation et d’applications métiers.",
  "url": "https://liliansevoumian.fr/cas-clients",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": displayStudies.map((cs, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://liliansevoumian.fr/cas-clients/${cs.slug}`,
      "name": `${cs.client} : ${cs.titre}`
    }))
  },
  "author": { "@id": "https://liliansevoumian.fr/#person" }
};

const total = displayStudies.length;

// Le nombre de cas ouvre le titre, en toutes lettres jusqu'à dix.
const EN_LETTRES = ['', 'Un', 'Deux', 'Trois', 'Quatre', 'Cinq', 'Six', 'Sept', 'Huit', 'Neuf', 'Dix'];
const titre =
  total > 1 ? `${EN_LETTRES[total] ?? total} cas clients, <mark>avant et après.</mark>` : 'Cas clients, <mark>avant et après.</mark>';
---

<Layout
  title="Cas clients : automatisations et applications · Lilian Sevoumian"
  description="Projets Make, n8n et Glide : contexte, fonctionnalités réalisées et résultats disponibles. Cas clients d’automatisation et d’applications métiers."
  breadcrumbs={breadcrumbs}
  articleSchema={collectionSchema}
>
  <Navigation ctaSource="cas_index_nav" />

  <main id="main-content">
    <TeteDePage
      titre={titre}
      titreLargeur="14ch"
      chapo="Des automatisations et des applications construites pour des clients. Pour chacune, ce que j’ai construit et ce que ça a changé, avec l’écart mesuré quand il y en a un."
      enchaine
    />

    {/* Une feuille par cas, sur toute la colonne : ce qui a été construit à
        gauche, la preuve à droite. La preuve est le registre de l'avant et
        de l'après (l'accueil n'en montre que la première ligne) : sa
        première ligne est le résultat phare du cas, dit en grand sur lilas ;
        un cas qui n'a pas d'écart mesuré montre son parcours, sans lilas, et
        le dit. La page porte la grammaire de l'accueil (`.tenue-robot`) :
        mêmes feuilles, mêmes pastilles d'outils, mêmes puits au noir de la
        page, même flèche d'écart. */}
    <section class="registre tenue-robot px-[var(--spacing-section-x)]" aria-label="Les cas clients">
      <div class="registre__in">
        {total === 0 ? (
          <div class="registre__vide">
            <p>Les cas sont en cours de publication.</p>
            <p>Pour parler d’un projet proche du vôtre, écrivez-moi une phrase juste en dessous&nbsp;: je vous réponds moi-même.</p>
          </div>
        ) : (
          <ul class="registre__liste" role="list">
            {displayStudies.map((cs, rang) => (
              <li>
                <article class="fiche" id={cs.slug}>
                  <div class="fiche__dit">
                    {/* Le client : son nom en lettres, comme sur l'accueil, et
                        son secteur ; son logo, ramené au blanc comme sur le
                        mur de l'accueil, signe la ligne à droite quand il y
                        en a un (le nom est déjà écrit : `alt` vide). */}
                    <p class="fiche__client">
                      <span class="fiche__qui">
                        <span class="fiche__nom">{cs.client}</span>
                        {cs.secteur && <span class="fiche__secteur">{cs.secteur}</span>}
                      </span>
                      {cs.logo && (
                        <img class="fiche__logo" src={cs.logo.src} alt="" width={cs.logo.largeur} height={cs.logo.hauteur} style={cs.logo.echelle ? `--e:${cs.logo.echelle}` : undefined} loading={rang < 2 ? 'eager' : 'lazy'} decoding="async" />
                      )}
                    </p>
                    {/* Le lien est le titre, et il s'étend à toute la feuille
                        (`::after`) : la feuille entière se clique, et un
                        lecteur d'écran n'entend que le titre comme nom du lien. */}
                    <h2 class="fiche__titre">
                      <a href={`/cas-clients/${cs.slug}`}>{cs.titre}</a>
                    </h2>
                    {cs.texte && <p class="fiche__texte">{cs.texte}</p>}
                    {cs.tools.length > 0 && <Outils outils={cs.tools} />}
                  </div>

                  <div class="fiche__preuve">
                    {cs.ecarts.length > 0 ? (
                      <div class="ecarts">
                        <p class="ecarts__tete" aria-hidden="true"><span>Avant</span><span class="ecarts__vers"></span><span>Après</span></p>
                        <ul class="ecarts__lignes" role="list" aria-label={`Avant et après chez ${cs.client}`}>
                          {cs.ecarts.map((l, i) => (
                            <li class:list={[i === 0 && 'ecarts__phare']}>
                              <span class="ecarts__avant"><span class="sr-only">Avant&nbsp;: </span>{l.avant}</span>
                              <span class="ecarts__vers" aria-hidden="true"></span>
                              <span class="ecarts__apres"><span class="sr-only">Après&nbsp;: </span>{l.apres}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ) : cs.parcours.length > 0 && (
                      <div class="ecarts ecarts--parcours">
                        <p class="ecarts__tete" aria-hidden="true"><span>Le parcours dans l’application</span></p>
                        <ol class="ecarts__lignes" role="list" aria-label={`Le parcours dans l’application de ${cs.client}`}>
                          {cs.parcours.map((e, i) => (
                            <li>
                              <span class="ecarts__avant"><span class="ecarts__rang" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{e.qui}</span>
                              <span class="ecarts__apres">{e.quoi}</span>
                            </li>
                          ))}
                        </ol>
                      </div>
                    )}
                    {cs.scopeNote && <p class="fiche__reserve">{cs.scopeNote}</p>}
                  </div>
                  {/* Après la preuve sur téléphone, en bas à gauche au bureau. */}
                  <span class="fiche__lire" aria-hidden="true">
                    Lire le cas<span class="fiche__fleche">↗</span>
                  </span>
                </article>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <FinDePage
      source="cas_index_fin"
      titre="Un projet qui ressemble à <mark>l’un de ceux-là&nbsp;?</mark>"
      suite="Écrivez-moi une phrase&nbsp;: je vous réponds moi-même."
    />
  </main>

  <Footer />
</Layout>

<style>
  /* La colonne est celle de l'en-tête (`tete-de-page`) : 1200 px, mêmes marges.
     Pas d'écart dessous : `fin-de-page` apporte le sien. */

  .registre__in {
    max-width: 1200px;
    margin-inline: auto;
  }

  .registre__vide {
    display: grid;
    gap: 8px;
    color: var(--r-texte-2);
  }

  .registre__liste {
    display: grid;
    gap: 20px;
  }

  /* Ces `li` portent une feuille ou une ligne du registre, pas de la prose :
     la mesure de lecture de `global.css` (66ch) ne les concerne pas. */
  .registre__liste > li,
  .ecarts__lignes > li,
  .ecarts__tete {
    max-width: none;
  }

  /* Trois tailles de petit texte sur la page, pas six : 13 px (les mots du
     registre), 15 px (le secteur, la réserve, « Lire le cas »), 16 px (le
     texte et les lignes). */

  /* ---------- la feuille d'un cas ---------- */
  .fiche {
    position: relative;
    display: grid;
    gap: 24px;
    padding: 24px 22px 22px;
    border: 1px solid var(--r-trait-2);
    border-radius: 24px;
    background: var(--r-surface-2);
    transition: border-color 0.3s var(--r-sortie);
    /* Une ancre (`/cas-clients#humble-plus`) arrive sous la barre fixe. */
    scroll-margin-top: 96px;
  }

  .fiche__dit {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
  }

  .fiche__client {
    display: flex;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    gap: 16px;
    max-width: none;
    min-height: 48px;
    margin-bottom: 12px;
  }

  .fiche__qui {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .fiche__nom {
    color: var(--r-texte);
    font-size: 16px;
    font-weight: 600;
    line-height: 22px;
    letter-spacing: -0.008em;
  }

  .fiche__secteur {
    color: var(--r-gris);
    font-size: 15px;
    line-height: 20px;
  }

  /* La taille du défilé de l'accueil, où ces logos se lisent ; 48 px au plus. */
  .fiche__logo {
    flex: none;
    width: auto;
    height: auto;
    max-width: 116px;
    max-height: min(calc(26px * var(--e, 1)), 48px);
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.82;
  }

  .fiche__titre {
    margin-bottom: 4px;
    font-size: clamp(24px, 2.35vw, 32px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }

  /* Le survol et le focus se lisent sous le pointeur : un trait lilas tiré
     sous le titre, en plus du filet de la feuille. */
  .fiche__titre a {
    text-decoration: underline transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.16em;
    transition: text-decoration-color 0.3s var(--r-sortie);
    /* Au clavier, la feuille entière vient à l'écran, pas son seul titre. */
    scroll-margin-block: 96px 22rem;
  }

  .fiche__titre a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .fiche__texte {
    max-width: 30em;
    margin-bottom: 4px;
    color: var(--r-texte-2);
    font-size: 16px;
    text-wrap: pretty;
  }

  /* « Lire le cas » : la même pilule au trait que sur l'accueil. Elle ne se
     clique pas elle-même (toute la feuille est le lien) : au survol de la
     feuille, sa flèche passe au citron et tourne. */
  .fiche__lire {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
    height: 44px;
    padding: 0 6px 0 18px;
    border: 1px solid var(--r-trait-3);
    border-radius: 999px;
    color: var(--r-texte);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.005em;
    transition: border-color 0.25s var(--r-sortie);
  }

  .fiche__fleche {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--r-noir);
    font-size: 16px;
    transition:
      transform 0.4s var(--r-sortie),
      background-color 0.25s var(--r-sortie),
      color 0.25s var(--r-sortie);
  }

  .fiche:has(a:focus-visible) {
    outline: 2px solid var(--r-lilas);
    outline-offset: 3px;
  }

  .fiche__titre a:focus-visible {
    outline: none;
    text-decoration-color: var(--r-lilas);
  }

  /* Touchée ou cliquée, la feuille répond tout de suite : son filet passe au lilas. */
  .fiche:has(.fiche__titre a:active) {
    border-color: var(--r-lilas);
  }

  @media (hover: hover) and (pointer: fine) {
    .fiche:hover {
      border-color: var(--r-trait-3);
    }

    .fiche:hover .fiche__titre a {
      text-decoration-color: var(--r-lilas);
    }

    .fiche:hover .fiche__lire {
      border-color: var(--r-gris);
    }

    .fiche:hover .fiche__fleche {
      background: var(--r-citron);
      color: var(--r-encre);
      transform: rotate(45deg);
    }
  }

  /* ---------- la preuve : le registre de l'avant et de l'après ---------- */
  .fiche__preuve {
    display: grid;
    align-content: start;
    gap: 12px;
    min-width: 0;
  }

  /* Un puits au noir de la page, creusé dans la feuille (les trois couches du
     verrou : page, feuille, puits). Les hauteurs de ligne sont des nombres
     pairs de pixels : la flèche, centrée, tombe sur un pixel entier. */
  .ecarts {
    --vers: 24px;
    border: 1px solid var(--r-trait-2);
    border-radius: 18px;
    background: var(--r-noir);
    font-size: 16px;
    line-height: 22px;
  }

  .ecarts__tete {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 10px;
    border-bottom: 1px solid var(--r-trait);
    color: var(--r-gris);
    font-size: 13px;
    line-height: 16px;
  }

  .ecarts__tete span:last-child:not(:first-child) {
    color: var(--r-lilas);
  }

  /* La flèche de l'écart : le dessin de l'accueil (`.r-ecart__vers`), un trait
     lilas et sa pointe ; le citron est aux gestes. */
  .ecarts__vers {
    position: relative;
    flex: none;
    width: var(--vers);
    height: 2px;
  }

  .ecarts__vers::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1.5px;
    background: var(--r-lilas);
  }

  .ecarts__vers::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0.75px;
    width: 7px;
    height: 7px;
    border: solid var(--r-lilas);
    border-width: 1.5px 1.5px 0 0;
    transform: translateY(-50%) rotate(45deg);
  }

  /* Sur téléphone : l'avant, puis la flèche et l'après sur la ligne suivante. */
  .ecarts__lignes > li {
    display: grid;
    grid-template-columns: var(--vers) minmax(0, 1fr);
    gap: 4px 10px;
    padding: 14px 18px;
  }

  .ecarts__lignes > li + li {
    border-top: 1px solid var(--r-trait);
  }

  .ecarts__avant {
    grid-column: 1 / -1;
    color: var(--r-gris);
    text-wrap: pretty;
  }

  .ecarts__lignes .ecarts__vers {
    margin-top: 10px;
  }

  .ecarts__apres {
    color: var(--r-texte);
    font-weight: 600;
    letter-spacing: -0.008em;
    text-wrap: pretty;
  }

  /* La première ligne est le résultat phare du cas : l'après sur lilas, en
     grand. Une seule cellule lilas par feuille, et aucune quand rien n'a été
     mesuré. Sa marge de 4 px et son rayon de 14 suivent le rayon du puits (18). */
  .ecarts__lignes > li.ecarts__phare {
    gap: 10px;
    padding: 14px 4px 4px;
  }

  .ecarts__phare .ecarts__avant {
    padding-inline: 14px;
    color: var(--r-texte-2);
    font-size: 18px;
    line-height: 24px;
  }

  .ecarts__phare .ecarts__vers {
    display: none;
  }

  .ecarts__phare .ecarts__apres {
    grid-column: 1 / -1;
    padding: 16px 14px;
    border-radius: 14px;
    background: var(--r-lilas);
    color: var(--r-encre);
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -0.016em;
    text-wrap: balance;
  }

  /* Le parcours d'une application : un rang et qui agit, puis ce qu'il fait. */
  .ecarts--parcours .ecarts__lignes > li {
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
  }

  .ecarts__rang {
    display: inline-block;
    width: 34px;
    color: var(--r-gris);
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .ecarts--parcours .ecarts__apres {
    padding-left: 34px;
  }

  .fiche__reserve {
    max-width: none;
    padding-inline: 4px;
    color: var(--r-gris);
    font-size: 15px;
    line-height: 1.45;
  }

  /* À partir de 620 px le registre tient sur trois colonnes, les mêmes pour
     les deux variantes : l'avant, la flèche, l'après, alignés d'une ligne à
     l'autre et d'une feuille à l'autre. */
  @media (min-width: 620px) {
    .fiche {
      padding: 28px;
      border-radius: 28px;
    }

    .ecarts {
      --vers: 30px;
    }

    .ecarts__tete,
    .ecarts__lignes > li,
    .ecarts--parcours .ecarts__lignes > li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--vers) minmax(0, 1fr);
      gap: 4px 16px;
      align-items: start;
    }

    .ecarts__tete .ecarts__vers {
      visibility: hidden;
    }

    .ecarts__tete span:only-child {
      grid-column: 1 / -1;
    }

    .ecarts__avant {
      grid-column: auto;
    }

    .ecarts__lignes .ecarts__vers {
      width: 24px;
    }

    /* La bande : l'avant à gauche, la flèche, puis la cellule lilas, qui
       déborde de sa colonne pour que son texte reste sur l'axe des « après ». */
    .ecarts__lignes > li.ecarts__phare {
      gap: 4px 16px;
      align-items: center;
      padding: 4px 4px 4px 18px;
    }

    .ecarts__phare .ecarts__avant {
      padding: 12px 0;
    }

    .ecarts__phare .ecarts__vers {
      display: block;
      margin-top: 0;
    }

    .ecarts__phare .ecarts__apres {
      grid-column: auto;
      margin-left: -16px;
      padding: 18px 14px 18px 16px;
    }

    .ecarts--parcours .ecarts__apres {
      grid-column: 3;
      padding-left: 0;
    }
  }

  /* Au bureau : ce qui a été construit à gauche, la preuve à droite, les
     puits alignés en haut des feuilles, sur le nom du client. */
  @media (min-width: 1100px) {
    .fiche {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: 28px 48px;
    }

    .fiche__dit {
      grid-area: 1 / 1;
    }

    .fiche__preuve {
      grid-area: 1 / 2 / 3 / 3;
    }

    /* Le bouton suit les pastilles à la même distance sur chaque feuille. */
    .fiche__lire {
      grid-area: 2 / 1;
      align-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fiche,
    .fiche__titre a,
    .fiche__lire,
    .fiche__fleche {
      transition: none;
    }
  }
</style>
