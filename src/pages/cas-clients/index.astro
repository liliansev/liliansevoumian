---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Retour from '../../components/retour.astro';
import FinDePage from '../../components/fin-de-page.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

// Cas clients = collection Markdown locale (src/content/cas-clients/).
// Brouillons (draft: true) : visibles en dev, exclus du build de prod.
const showDrafts = !import.meta.env.PROD;
const all = await getCollection('cas-clients');
const entries = all
  .filter((entry) => showDrafts || !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

/* Les textes des cas ne portent pas les espaces insécables du français : sans
   elles, un deux-points ou une unité passait seul à la ligne. Elles sont
   posées ici, à l'affichage : avant `: ; ? !` et le guillemet fermant, après le
   guillemet ouvrant, entre un nombre et son unité. La page d'un cas fait de
   même sur son corps (`[slug].astro`). */
const espaces = (texte: string) =>
  texte
    .replace(/ ([:;?!»])/g, '\u00a0$1')
    .replace(/« /g, '«\u00a0')
    .replace(/(\d) (?=(?:h|min|%|€)(?![\p{L}\d]))/gu, '$1\u00a0');

// Le titre garde aussi sa forme d'origine : c'est elle que lit le balisage
// de la collection.
const displayStudies = entries.map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  titre: espaces(entry.data.title),
  secteur: entry.data.secteur,
  tags: entry.data.tags,
  tools: entry.data.tools,
  kpis: entry.data.kpis.map((kpi) => ({ value: espaces(kpi.value), label: espaces(kpi.label) })),
  description: entry.data.description && espaces(entry.data.description),
  scopeNote: entry.data.scopeNote && espaces(entry.data.scopeNote),
}));

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Cas clients : automatisations et applications métiers - Lilian Sevoumian",
  "description": "Projets Make, n8n et Glide : contexte, fonctionnalités réalisées et résultats disponibles. Cas clients d’automatisation et d’applications métiers.",
  "url": "https://liliansevoumian.fr/cas-clients",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": displayStudies.map((cs, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://liliansevoumian.fr/cas-clients/${cs.slug}`,
      "name": cs.title
    }))
  },
  "author": { "@type": "Person", "name": "Lilian Sevoumian" }
};

const total = displayStudies.length;

// Le nombre de cas ouvre le chapô, en toutes lettres jusqu'à dix.
const EN_LETTRES = ['', 'Un', 'Deux', 'Trois', 'Quatre', 'Cinq', 'Six', 'Sept', 'Huit', 'Neuf', 'Dix'];
const debut =
  total > 0 ? `${EN_LETTRES[total] ?? total} projet${total > 1 ? 's' : ''}, automatisations` : 'Automatisations';
---

<Layout
  title="Cas clients : automatisations et applications | Lilian Sevoumian"
  description="Projets Make, n8n et Glide : contexte, fonctionnalités réalisées et résultats disponibles. Cas clients d’automatisation et d’applications métiers."
  breadcrumbs={breadcrumbs}
  articleSchema={collectionSchema}
>
  <Navigation ctaSource="cas_index_nav" />

  <main id="main-content">
    <section
      data-section
      class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)]"
    >
      {/* Même dégagement sous la barre que `tete-de-page`. */}
      <div class="relative max-w-[1200px] mx-auto pt-[calc(var(--spacing-barre)+var(--spacing-bloc))] pb-[var(--spacing-section-y)]">

        {/* L'en-tête arrive, il ne s'affiche pas : `.entree` fait monter ses
            enfants directs l'un après l'autre, dans l'ordre où on les lit.
            Ce sont des `@keyframes` jouées au chargement, pas un voile levé par
            script : sans JS le titre est peint dans son état final. */}
        <div class="entree mb-[var(--spacing-bloc)]">
          <div class="mb-[var(--spacing-groupe)]"><Retour href="/" /></div>
          <h1 class="m-0 max-w-[18ch]">Des projets métier, documentés.</h1>
          <p class="mt-[var(--spacing-lie)] mb-0 text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5]">
            {debut} et applications&nbsp;: le besoin de départ, la solution réalisée et les résultats disponibles, avec leur contexte.
          </p>
        </div>

        {/* Une liste, pas une grille de cartes : un cas par rangée, ce qu'il
            est à gauche, ce qu'il a donné à droite. Rien ne l'encadre et aucun
            filet ne sépare les rangées : c'est l'espace qui le fait. */}
        {total === 0 ? (
          <div class="reveal">
            <p class="m-0 text-[length:var(--text-body-large)] text-[var(--color-ink)]">
              Les cas sont en cours de publication.
            </p>
            <p class="mt-[var(--spacing-colle)] mb-0 text-[var(--color-ink-mid)]">
              Pour parler d’un projet proche du vôtre, écrivez-moi une phrase juste en dessous&nbsp;: je vous réponds moi-même.
            </p>
          </div>
        ) : (
          <ul class="cas-liste reveal-stagger" role="list">
            {displayStudies.map((cs) => (
              <li class="reveal">
                <article class="cas">
                  <div class="cas__tete">
                    {/* Le lien est le titre, et il s'étend à toute la rangée
                        (`::after`) : la rangée entière se clique, et un lecteur
                        d'écran n'entend que le titre comme nom du lien. */}
                    <h2 class="cas__titre">
                      <a href={`/cas-clients/${cs.slug}`} class="cas__lien">{cs.titre}</a>
                    </h2>
                    {(cs.secteur || cs.tags.length > 0) && (
                      <p class="cas__meta">
                        {cs.secteur && <span class="cas__secteur">{cs.secteur}</span>}
                        {cs.tags.length > 0 && <span>{cs.tags.join(', ')}</span>}
                      </p>
                    )}
                  </div>

                  {/* À droite, les résultats ; un cas qui n'a pas de chiffre y
                      dit en une phrase ce qui a été réalisé. */}
                  <div class="cas__preuves">
                    {cs.kpis.length > 0 ? (
                      <dl class="faits">
                        {cs.kpis.slice(0, 3).map((kpi) => (
                          <div>
                            <dt class="fait__valeur">{kpi.value}</dt>
                            <dd class="fait__detail">{kpi.label}</dd>
                          </div>
                        ))}
                      </dl>
                    ) : (
                      cs.description && <p class="cas__resume">{cs.description}</p>
                    )}
                    {cs.scopeNote && <p class="cas__reserve">{cs.scopeNote}</p>}
                  </div>

                  <div class="cas__pied">
                    {cs.tools.length > 0 && (
                      <ul class="cas__outils" role="list" aria-label="Outils">
                        {cs.tools.map((tool) => <li class="chip">{tool}</li>)}
                      </ul>
                    )}
                    <span class="link-cta" aria-hidden="true">
                      <span class="link-cta__label">Lire le détail</span>
                      <Icon name="lucide:arrow-right" class="link-cta__arrow" />
                    </span>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )}

      </div>
    </section>

    <FinDePage
      source="cas_index_fin"
      titre="Un projet qui ressemble à <mark>l’un de ceux-là&nbsp;?</mark>"
    />
  </main>

  <Footer />
</Layout>

<style>
  .cas-liste {
    display: grid;
    row-gap: var(--spacing-bloc);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* La règle de base plafonne un `li` à une mesure de prose : ici c'est une
     rangée, sur toute la colonne. */
  .cas-liste > li {
    max-width: none;
  }

  .cas {
    position: relative;
    display: grid;
    gap: var(--spacing-lie);
  }

  .cas__titre {
    max-width: 30ch;
    margin: 0;
    font-size: var(--text-title-lg);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cas__lien {
    color: inherit;
    text-decoration: none;
  }

  /* Toute la rangée se clique. La zone déborde un peu du texte, pour que le
     cadre de focus ne le serre pas. */
  .cas__lien::after {
    content: '';
    position: absolute;
    inset: -0.75rem;
    border-radius: var(--radius-md);
  }

  .cas__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    max-width: none;
    margin: var(--spacing-colle) 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .cas__secteur {
    color: var(--color-ink-mid);
  }

  /* Les résultats, un par ligne : ce qu'on retient, puis ce qui le précise,
     comme les faits de « Pourquoi moi » sur l'accueil. */
  .faits {
    display: grid;
    gap: var(--spacing-lie);
    margin: 0;
  }

  .fait__valeur {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .fait__detail {
    margin: 0.25rem 0 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.45;
  }

  .cas__resume {
    margin: 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  .cas__reserve {
    margin: var(--spacing-colle) 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .cas__pied {
    display: grid;
    justify-items: start;
    gap: var(--spacing-colle);
  }

  /* Les outils ne se cliquent pas : le pointeur les traverse, la rangée reste
     une seule cible. */
  .cas__outils {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  /* La rangée répond par son lien fléché : la pastille se déroule sous
     « Lire le détail » et la flèche avance, au survol comme au clavier. */
  .cas:focus-within .link-cta__label::before {
    clip-path: inset(0 0 0 0 round 9999px);
  }

  .cas:focus-within .link-cta__label {
    color: var(--color-night);
  }

  .cas:focus-within :global(.link-cta__arrow) {
    transform: translateX(4px);
    color: var(--color-accent-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .cas:hover .link-cta__label::before {
      clip-path: inset(0 0 0 0 round 9999px);
    }

    .cas:hover .link-cta__label {
      color: var(--color-night);
    }

    .cas:hover :global(.link-cta__arrow) {
      transform: translateX(4px);
      color: var(--color-accent-text);
    }
  }

  /* Le cadre de focus entoure la rangée, pas le seul titre. Même condition que
     la règle générale : pas de cadre sur un écran purement tactile. */
  @media (any-hover: hover), (any-pointer: fine) {
    .cas__lien:focus-visible {
      outline: none;
    }

    .cas__lien:focus-visible::after {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }
  }

  /* À partir de la tablette : le cas à gauche, ses résultats à droite, sur
     deux colonnes égales. */
  @media (min-width: 48rem) {
    .cas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      column-gap: var(--spacing-gouttiere);
      align-items: start;
    }

    .cas__tete {
      grid-column: 1;
      grid-row: 1;
    }

    .cas__pied {
      grid-column: 1;
      grid-row: 2;
    }

    .cas__preuves {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  /* Grand écran : chaque résultat tient sur une ligne, la valeur puis ce qui
     la précise. Les valeurs partagent une colonne, les précisions partent
     toutes du même bord. */
  @media (min-width: 64rem) {
    .faits {
      grid-template-columns: minmax(9.5rem, max-content) minmax(0, 1fr);
      gap: 0.75rem var(--spacing-lie);
      align-items: baseline;
    }

    .faits > div {
      display: contents;
    }

    .fait__detail {
      margin: 0;
    }
  }
</style>
