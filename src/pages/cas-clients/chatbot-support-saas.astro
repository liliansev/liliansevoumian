---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const title = "Chatbot IA support client : 850 tickets/mois traités automatiquement | Lilian Sevoumian";
const description = "Étude de cas : comment un SaaS B2B a triplé la capacité de son support client grâce à un chatbot IA (Claude + Make + Intercom) déployé en 3 semaines. Temps de réponse passé de 4h à 2 min.";

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Cas clients", url: "/cas-clients" },
  { name: "Chatbot support SaaS", url: "/cas-clients/chatbot-support-saas" },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Chatbot IA support client : 850 tickets/mois traités automatiquement",
  "description": description,
  "author": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "publisher": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://liliansevoumian.fr/cas-clients/chatbot-support-saas" },
  "articleSection": "Cas client",
  "keywords": ["chatbot IA", "support client automatisé", "Claude Anthropic", "Make", "Intercom", "SaaS B2B", "automatisation support", "no-code", "intelligence artificielle"],
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Déployer un chatbot IA pour le support client SaaS",
  "description": "Les étapes pour créer un assistant IA intelligent capable de résoudre les tickets de support niveau 1 automatiquement.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Analyse des tickets existants", "text": "Analyse de l'historique des tickets pour identifier les demandes récurrentes et les patterns de résolution." },
    { "@type": "HowToStep", "position": 2, "name": "Entraînement de l'IA", "text": "Configuration de Claude sur la documentation produit, la FAQ et l'historique des résolutions." },
    { "@type": "HowToStep", "position": 3, "name": "Intégration dans Intercom", "text": "Connexion du chatbot IA à Intercom via Make avec logique d'escalade vers l'équipe humaine." },
    { "@type": "HowToStep", "position": 4, "name": "Tests et ajustements", "text": "Phase de test en conditions réelles, ajustement des réponses et des seuils d'escalade." },
  ],
};
---

<Layout title={title} description={description} ogType="article" breadcrumbs={breadcrumbs} articleSchema={{ ...articleSchema, hasPart: howToSchema }}>
  <Navigation />

  <main id="main-content">
    <!-- Hero (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden pt-28 pb-0">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto">
          <a href="/cas-clients" class="inline-flex items-center gap-2 font-body text-[length:var(--text-body-sm)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors mb-8 group">
            <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
            Retour aux cas clients
          </a>

          <div class="flex flex-col gap-5 fade-in-section">
            <span class="inline-block self-start rounded-full px-4 py-1.5 text-[length:var(--text-micro)] font-semibold tracking-[2px] uppercase font-mono text-[var(--color-purple-dark)]" style="background: rgba(147, 51, 234, 0.12);">
              SAAS B2B
            </span>
            <h1 class="font-display text-[length:var(--text-display)] font-bold text-[var(--color-text-primary)] leading-[1.08]">
              Support client&nbsp;: 850&nbsp;tickets/mois sans recrutement
            </h1>
            <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.6] max-w-[640px]">
              Comment un SaaS B2B a <strong>triplé sa capacité de traitement support</strong> grâce à un chatbot IA intelligent, sans embaucher.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- KPIs (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] py-12 px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto">
          <div class="grid grid-cols-3 gap-4 fade-in-section">
            <div class="card-3d-white-purple p-6 flex flex-col items-center text-center">
              <span class="font-mono text-3xl md:text-4xl font-bold text-[var(--color-purple)]">3x</span>
              <span class="font-body text-[length:var(--text-caption)] text-[var(--color-text-secondary)] uppercase tracking-[1px] mt-1">capacité support</span>
            </div>
            <div class="card-3d-white-purple p-6 flex flex-col items-center text-center">
              <span class="font-mono text-3xl md:text-4xl font-bold text-[var(--color-purple)]">2 min</span>
              <span class="font-body text-[length:var(--text-caption)] text-[var(--color-text-secondary)] uppercase tracking-[1px] mt-1">temps de réponse</span>
            </div>
            <div class="card-3d-white-purple p-6 flex flex-col items-center text-center">
              <span class="font-mono text-3xl md:text-4xl font-bold text-[var(--color-purple)]">3 sem.</span>
              <span class="font-body text-[length:var(--text-caption)] text-[var(--color-text-secondary)] uppercase tracking-[1px] mt-1">de déploiement</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Le problème (WHITE) -->
    <section data-bg="white" class="relative bg-white overflow-hidden">
      <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto fade-in-section">
          <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-purple-dark)] mb-3">
            LE PROBLÈME
          </span>
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)] mb-6">
            Une équipe support noyée sous les demandes répétitives
          </h2>
          <div class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.7] space-y-4">
            <p>
              L'équipe support de ce SaaS B2B croulait sous les demandes&nbsp;: réinitialisation de mot de passe, questions sur les fonctionnalités, problèmes de facturation. <strong>60% des tickets concernaient des questions déjà documentées</strong>.
            </p>
            <p>
              Les temps de réponse s'allongeaient (<strong>4&nbsp;heures en moyenne</strong>), la satisfaction client chutait, et les agents perdaient du temps sur des tâches à faible valeur ajoutée. L'alternative — recruter — aurait coûté <strong>40&nbsp;000&nbsp;€/an minimum</strong>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- La solution (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto fade-in-section">
          <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-orange)] mb-3">
            LA SOLUTION
          </span>
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)] mb-6">
            Un assistant IA qui résout le niveau&nbsp;1 et escalade intelligemment
          </h2>
          <div class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.7] space-y-4">
            <p>
              J'ai déployé un <strong>assistant IA basé sur Claude</strong>, entraîné sur la documentation produit et l'historique des tickets résolus. Il est intégré directement dans <strong>Intercom</strong> via un workflow <strong>Make</strong>.
            </p>
            <ul class="space-y-3 ml-1">
              <li class="flex items-start gap-3">
                <span class="font-mono text-[var(--color-purple)] font-bold shrink-0 mt-0.5">→</span>
                <span><strong>Résolution automatique</strong> des demandes niveau&nbsp;1 (FAQ, tutos, résolutions standard)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="font-mono text-[var(--color-purple)] font-bold shrink-0 mt-0.5">→</span>
                <span><strong>Escalade intelligente</strong> vers l'équipe humaine avec tout le contexte nécessaire</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="font-mono text-[var(--color-purple)] font-bold shrink-0 mt-0.5">→</span>
                <span><strong>Apprentissage continu</strong> : chaque ticket résolu enrichit la base de connaissances</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="font-mono text-[var(--color-purple)] font-bold shrink-0 mt-0.5">→</span>
                <span><strong>Réponses en 2&nbsp;minutes</strong> au lieu de 4&nbsp;heures, 24h/24</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Les résultats (WHITE) -->
    <section data-bg="white" class="relative bg-white overflow-hidden">
      <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto fade-in-section">
          <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-cyan-dark)] mb-3">
            LES RÉSULTATS
          </span>
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)] mb-6">
            3x plus de capacité, 40K€ économisés par an
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="card-3d-light-purple p-6">
              <span class="font-mono text-2xl font-bold text-[var(--color-purple)]">850+</span>
              <p class="font-body text-[length:var(--text-body)] text-[var(--color-text-secondary)] mt-1">tickets résolus <strong>automatiquement</strong> chaque mois</p>
            </div>
            <div class="card-3d-light-purple p-6">
              <span class="font-mono text-2xl font-bold text-[var(--color-purple)]">2 min</span>
              <p class="font-body text-[length:var(--text-body)] text-[var(--color-text-secondary)] mt-1">temps de réponse moyen (contre <strong>4&nbsp;heures</strong> avant)</p>
            </div>
            <div class="card-3d-light-purple p-6">
              <span class="font-mono text-2xl font-bold text-[var(--color-purple)]">3x</span>
              <p class="font-body text-[length:var(--text-body)] text-[var(--color-text-secondary)] mt-1">capacité de traitement <strong>sans recrutement</strong></p>
            </div>
            <div class="card-3d-light-purple p-6">
              <span class="font-mono text-2xl font-bold text-[var(--color-purple)]">3 sem.</span>
              <p class="font-body text-[length:var(--text-body)] text-[var(--color-text-secondary)] mt-1">de déploiement, <strong>ROI immédiat</strong></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Outils (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto fade-in-section">
          <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-purple-dark)] mb-3">
            STACK TECHNIQUE
          </span>
          <h2 class="font-display text-[length:var(--text-subheading)] font-bold text-[var(--color-text-primary)] mb-6">
            Outils utilisés pour cette automatisation
          </h2>
          <div class="flex flex-wrap gap-3">
            {["Claude (Anthropic)", "Make", "Intercom", "Notion"].map((tool) => (
              <span class="rounded-full px-4 py-2 text-[length:var(--text-body-sm)] font-medium font-mono" style="background: rgba(147, 51, 234, 0.1); color: var(--color-purple-dark);">
                {tool}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA (WHITE) -->
    <section data-bg="white" class="relative bg-white overflow-hidden">
      <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[600px] mx-auto text-center flex flex-col items-center gap-4 fade-in-section">
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)]">
            Un support client à automatiser&nbsp;?
          </h2>
          <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)]">
            Parlons de votre situation — l'appel est gratuit, 30&nbsp;min, sans engagement.
          </p>
          <a
            href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
            class="btn-3d inline-flex items-center justify-center font-body text-[length:var(--text-body)] font-semibold px-7 py-3.5 mt-2 group"
          >
            Réserver mon appel stratégique <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
