---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const title = "Chatbot IA : 3x plus de tickets traités | Lilian Sevoumian";
const description = "Comment un SaaS B2B a triplé la capacité de son support client grâce à un chatbot IA déployé en 3 semaines.";

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Cas clients", url: "/cas-clients" },
  { name: "Chatbot support SaaS", url: "/cas-clients/chatbot-support-saas" },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Support client : 850 tickets/mois sans recrutement",
  "description": description,
  "author": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "publisher": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://liliansevoumian.fr/cas-clients/chatbot-support-saas" },
  "articleSection": "Cas client",
  "keywords": "automatisation, chatbot, IA, Claude, Anthropic, support client, SaaS, Make, Intercom",
};
---

<Layout title={title} description={description} ogType="article" breadcrumbs={breadcrumbs} articleSchema={articleSchema}>
  <Navigation />

  <main id="main-content" class="bg-black pt-[56px]">
    <!-- Hero -->
    <section class="py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
      <div class="max-w-[800px] mx-auto">
        <a href="/#cas-clients" class="inline-flex items-center gap-2 font-[var(--font-body)] text-sm text-[#888888] hover:text-[#EDEDED] transition-colors mb-8">
          &larr; Retour aux cas clients
        </a>

        <div class="flex flex-col gap-6 mb-12">
          <span class="inline-block self-start rounded-full px-4 py-1.5 text-[11px] font-medium tracking-[2px] uppercase" style="background: #1A1028; border: 1px solid rgba(139,92,246,0.19); font-family: var(--font-mono); color: #8B5CF6;">
            SAAS B2B
          </span>
          <h1 class="font-[var(--font-display)] text-[length:var(--text-heading)] font-bold text-[#EDEDED] leading-[1.15]">
            Support client : 850 tickets/mois sans recrutement
          </h1>
          <p class="font-[var(--font-body)] text-lg text-[#888888] leading-[1.6]">
            Comment un SaaS B2B a triplé sa capacité de traitement support grâce à un chatbot IA intelligent.
          </p>
        </div>

        <!-- Metric -->
        <div class="flex items-center gap-8 mb-16 p-8 rounded-xl" style="background: #0A0A0A; border: 1px solid #1A1A1A;">
          <div class="flex flex-col">
            <span class="font-[var(--font-mono)] text-5xl md:text-6xl font-bold text-[#8B5CF6]">3x</span>
            <span class="font-[var(--font-body)] text-sm text-[#8B5CF6] tracking-[1px] uppercase mt-1">capacité de traitement</span>
          </div>
        </div>

        <!-- Content -->
        <div class="flex flex-col gap-10 font-[var(--font-body)] text-[#EDEDED] leading-[1.7]">
          <div>
            <h2 class="font-[var(--font-display)] text-xl font-semibold text-[#EDEDED] mb-4">Le problème</h2>
            <p class="text-[#888888]">
              L'équipe support de ce SaaS B2B croulait sous les demandes répétitives : réinitialisation de mot de passe, questions sur les fonctionnalités, problèmes de facturation. 60% des tickets concernaient des questions déjà documentées. L'alternative — recruter — aurait coûté 40K€/an minimum.
            </p>
          </div>

          <div>
            <h2 class="font-[var(--font-display)] text-xl font-semibold text-[#EDEDED] mb-4">La solution</h2>
            <p class="text-[#888888]">
              Un assistant IA basé sur Claude, entraîné sur la documentation produit et l'historique des tickets. Il résout automatiquement les demandes niveau 1 (FAQ, tutos, résolutions standard) et escalade les cas complexes vers l'équipe humaine avec tout le contexte nécessaire.
            </p>
          </div>

          <div>
            <h2 class="font-[var(--font-display)] text-xl font-semibold text-[#EDEDED] mb-4">Les résultats</h2>
            <ul class="text-[#888888] space-y-3">
              <li class="flex items-start gap-3">
                <span class="font-[var(--font-mono)] text-[#8B5CF6] font-bold shrink-0">→</span>
                <span>850+ tickets résolus automatiquement par mois</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="font-[var(--font-mono)] text-[#8B5CF6] font-bold shrink-0">→</span>
                <span>Capacité de traitement multipliée par 3 sans recrutement</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="font-[var(--font-mono)] text-[#8B5CF6] font-bold shrink-0">→</span>
                <span>Temps de réponse moyen passé de 4h à 2min</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="font-[var(--font-mono)] text-[#8B5CF6] font-bold shrink-0">→</span>
                <span>Déployé en 3 semaines, ROI immédiat</span>
              </li>
            </ul>
          </div>

          <div>
            <h2 class="font-[var(--font-display)] text-xl font-semibold text-[#EDEDED] mb-4">Outils utilisés</h2>
            <div class="flex flex-wrap gap-2">
              {["Claude (Anthropic)", "Make", "Intercom", "Notion"].map((tool) => (
                <span class="rounded-md px-3 py-1.5 text-xs font-medium" style="background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.2); color: #8B5CF6; font-family: var(--font-mono);">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-16 p-8 rounded-xl text-center flex flex-col items-center gap-4" style="background: #0A0A0A; border: 1px solid #1A1A1A;">
          <p class="font-[var(--font-display)] text-xl font-semibold text-[#EDEDED]">Un cas similaire ?</p>
          <p class="font-[var(--font-body)] text-sm text-[#888888]">Parlons de votre situation — l'appel est gratuit.</p>
          <a href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-[#8B5CF6] text-white font-[var(--font-body)] text-[15px] font-medium rounded-lg px-7 py-3.5 hover:bg-[#7C3AED] transition-colors">
            Parlons automatisations →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
