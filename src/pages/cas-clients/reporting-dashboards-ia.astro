---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const title = "Reporting automatisé : 12 rapports manuels remplacés par des dashboards IA | Lilian Sevoumian";
const description = "Étude de cas : comment un cabinet conseil a économisé 15h par semaine en remplaçant 12 rapports Excel manuels par des dashboards temps réel avec alertes IA via Make et Airtable. ROI en 3 semaines.";

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Cas clients", url: "/cas-clients" },
  { name: "Reporting & dashboards IA", url: "/cas-clients/reporting-dashboards-ia" },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Reporting automatisé : 12 rapports manuels remplacés par des dashboards IA temps réel",
  "description": description,
  "author": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "publisher": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://liliansevoumian.fr/cas-clients/reporting-dashboards-ia" },
  "articleSection": "Cas client",
  "keywords": ["reporting automatisé", "dashboards temps réel", "alertes IA", "Make", "Airtable", "cabinet conseil", "automatisation Excel", "Google Sheets", "no-code", "business intelligence"],
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Automatiser le reporting d'un cabinet conseil avec Make et Airtable",
  "description": "Les étapes pour remplacer des rapports manuels Excel par des dashboards automatisés avec alertes IA.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Cartographie des rapports existants", "text": "Inventaire des 12 rapports, identification des sources de données (CRM, Analytics, Ads) et des formats de sortie." },
    { "@type": "HowToStep", "position": 2, "name": "Design de la base de données centralisée", "text": "Création de la structure Airtable pour consolider les données de 4 outils différents." },
    { "@type": "HowToStep", "position": 3, "name": "Automatisation de la collecte", "text": "Workflows Make pour la collecte automatique des données, la consolidation et la mise à jour temps réel." },
    { "@type": "HowToStep", "position": 4, "name": "Alertes IA et envoi automatique", "text": "Configuration des alertes IA sur les KPIs critiques et envoi automatique des rapports chaque lundi." },
  ],
};
---

<Layout title={title} description={description} ogType="article" breadcrumbs={breadcrumbs} articleSchema={{ ...articleSchema, hasPart: howToSchema }}>
  <Navigation />

  <main id="main-content">
    <!-- Hero (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden pt-28 pb-0">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto">
          <a href="/cas-clients" class="inline-flex items-center gap-2 font-body text-[length:var(--text-body-sm)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors mb-8 group">
            <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
            Retour aux cas clients
          </a>

          <div class="flex flex-col gap-5 fade-in-section">
            <span class="inline-block self-start rounded-full px-4 py-1.5 text-[length:var(--text-micro)] font-semibold tracking-[2px] uppercase font-mono text-[var(--color-cyan-dark)]" style="background: rgba(13, 148, 136, 0.12);">
              CABINET CONSEIL
            </span>
            <h1 class="font-display text-[length:var(--text-display)] font-bold text-[var(--color-text-primary)] leading-[1.08]">
              12 rapports manuels remplacés par des dashboards temps réel
            </h1>
            <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.6] max-w-[640px]">
              Comment un cabinet conseil a <strong>récupéré 15&nbsp;heures par semaine</strong> en automatisant entièrement son reporting avec des alertes IA.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- KPIs (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] py-12 px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto">
          <div class="grid grid-cols-3 gap-4 fade-in-section">
            <div class="card-3d-white-cyan p-6 flex flex-col items-center text-center">
              <span class="font-mono text-3xl md:text-4xl font-bold" style="color: var(--color-cyan-dark);">+15h</span>
              <span class="font-body text-[length:var(--text-caption)] text-[var(--color-text-secondary)] uppercase tracking-[1px] mt-1">par semaine</span>
            </div>
            <div class="card-3d-white-cyan p-6 flex flex-col items-center text-center">
              <span class="font-mono text-3xl md:text-4xl font-bold" style="color: var(--color-cyan-dark);">12</span>
              <span class="font-body text-[length:var(--text-caption)] text-[var(--color-text-secondary)] uppercase tracking-[1px] mt-1">rapports automatisés</span>
            </div>
            <div class="card-3d-white-cyan p-6 flex flex-col items-center text-center">
              <span class="font-mono text-3xl md:text-4xl font-bold" style="color: var(--color-cyan-dark);">3 sem.</span>
              <span class="font-body text-[length:var(--text-caption)] text-[var(--color-text-secondary)] uppercase tracking-[1px] mt-1">pour le ROI</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Le problème (WHITE) -->
    <section data-bg="white" class="relative bg-white overflow-hidden">
      <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto fade-in-section">
          <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase mb-3" style="color: var(--color-cyan-dark);">
            LE PROBLÈME
          </span>
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)] mb-6">
            2 jours par semaine perdus à compiler des rapports Excel
          </h2>
          <div class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.7] space-y-4">
            <p>
              Ce cabinet conseil produisait <strong>12 rapports différents chaque semaine</strong> pour ses clients. Le processus était entièrement manuel&nbsp;: extraction de données depuis <strong>4 outils différents</strong>, consolidation dans Excel, mise en forme et envoi par email.
            </p>
            <p>
              <strong>Deux consultants y consacraient 2&nbsp;jours par semaine</strong> — du temps qui ne pouvait pas être facturé aux clients. Les rapports arrivaient souvent en retard, contenaient des erreurs de copier-coller, et les consultants n'avaient aucune visibilité en temps réel sur les KPIs critiques.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- La solution (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto fade-in-section">
          <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-orange)] mb-3">
            LA SOLUTION
          </span>
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)] mb-6">
            Des dashboards automatisés avec alertes IA proactives
          </h2>
          <div class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.7] space-y-4">
            <p>
              J'ai mis en place des <strong>dashboards alimentés en temps réel</strong> par les données des outils clients (CRM, Analytics, Ads). Un workflow <strong>Make</strong> orchestre l'ensemble&nbsp;:
            </p>
            <ul class="space-y-3 ml-1">
              <li class="flex items-start gap-3">
                <span class="font-mono font-bold shrink-0 mt-0.5" style="color: var(--color-cyan-dark);">→</span>
                <span><strong>Collecte automatique</strong> des données depuis les 4 sources (CRM, Google Analytics, Google Ads, réseaux sociaux)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="font-mono font-bold shrink-0 mt-0.5" style="color: var(--color-cyan-dark);">→</span>
                <span><strong>Consolidation dans Airtable</strong> avec calculs et visualisations intégrées</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="font-mono font-bold shrink-0 mt-0.5" style="color: var(--color-cyan-dark);">→</span>
                <span><strong>Alertes IA</strong> via Claude quand un KPI dévie de sa trajectoire (baisse de trafic, hausse du coût par lead...)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="font-mono font-bold shrink-0 mt-0.5" style="color: var(--color-cyan-dark);">→</span>
                <span><strong>Envoi automatique chaque lundi</strong> des rapports formatés aux bons interlocuteurs</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Les résultats (WHITE) -->
    <section data-bg="white" class="relative bg-white overflow-hidden">
      <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto fade-in-section">
          <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-purple-dark)] mb-3">
            LES RÉSULTATS
          </span>
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)] mb-6">
            15h récupérées, des rapports sans erreurs, ROI en 3 semaines
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="card-3d-light-cyan p-6">
              <span class="font-mono text-2xl font-bold" style="color: var(--color-cyan-dark);">15h/sem.</span>
              <p class="font-body text-[length:var(--text-body)] text-[var(--color-text-secondary)] mt-1"><strong>économisées</strong> sur la compilation de rapports</p>
            </div>
            <div class="card-3d-light-cyan p-6">
              <span class="font-mono text-2xl font-bold" style="color: var(--color-cyan-dark);">12 rapports</span>
              <p class="font-body text-[length:var(--text-body)] text-[var(--color-text-secondary)] mt-1">générés et envoyés <strong>automatiquement</strong> chaque lundi</p>
            </div>
            <div class="card-3d-light-cyan p-6">
              <span class="font-mono text-2xl font-bold" style="color: var(--color-cyan-dark);">Temps réel</span>
              <p class="font-body text-[length:var(--text-body)] text-[var(--color-text-secondary)] mt-1">alertes IA <strong>proactives</strong> sur les KPIs critiques</p>
            </div>
            <div class="card-3d-light-cyan p-6">
              <span class="font-mono text-2xl font-bold" style="color: var(--color-cyan-dark);">3 semaines</span>
              <p class="font-body text-[length:var(--text-body)] text-[var(--color-text-secondary)] mt-1">pour atteindre le <strong>retour sur investissement</strong></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Outils (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto fade-in-section">
          <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase mb-3" style="color: var(--color-cyan-dark);">
            STACK TECHNIQUE
          </span>
          <h2 class="font-display text-[length:var(--text-subheading)] font-bold text-[var(--color-text-primary)] mb-6">
            Outils utilisés pour cette automatisation
          </h2>
          <div class="flex flex-wrap gap-3">
            {["Make", "Airtable", "Claude (Anthropic)", "Google Sheets", "Gmail"].map((tool) => (
              <span class="rounded-full px-4 py-2 text-[length:var(--text-body-sm)] font-medium font-mono" style="background: rgba(13, 148, 136, 0.1); color: var(--color-cyan-dark);">
                {tool}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA (WHITE) -->
    <section data-bg="white" class="relative bg-white overflow-hidden">
      <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[600px] mx-auto text-center flex flex-col items-center gap-4 fade-in-section">
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)]">
            Du reporting à automatiser&nbsp;?
          </h2>
          <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)]">
            Parlons de votre situation — l'appel est gratuit, 30&nbsp;min, sans engagement.
          </p>
          <a
            href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
            class="btn-3d inline-flex items-center justify-center font-body text-[length:var(--text-body)] font-semibold px-7 py-3.5 mt-2 group"
          >
            Réserver mon appel stratégique <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
