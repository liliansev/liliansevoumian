---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { chipClass } from '../../lib/tool-chip';

export async function getStaticPaths() {
  const entries = await getCollection('cas-clients', (entry) =>
    import.meta.env.PROD ? !entry.data.draft : true,
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const cs = entry.data;
const dateISO = cs.date.toISOString();

// Cas voisins : meme tag d abord, puis complement par les plus recents. Deux
// cartes, jamais le cas courant. Transforme quatre culs-de-sac en carrefours.
const tous = await getCollection('cas-clients', (e) => import.meta.env.DEV || !e.data.draft);
const autres = tous.filter((e) => e.id !== entry.id);
const voisins = [
  ...autres.filter((e) => e.data.tags.some((t) => cs.tags.includes(t))),
  ...autres.filter((e) => !e.data.tags.some((t) => cs.tags.includes(t))),
].slice(0, 2);

// L outil principal du cas, pour renvoyer vers sa page dediee avec l ancre
// de requete exacte.
const pageOutil = cs.tools.includes('n8n')
  ? { nom: 'n8n', href: '/expert-n8n' }
  : cs.tools.includes('Make')
    ? { nom: 'Make', href: '/expert-make' }
    : null;

// La description redigee prime. A defaut, on compose, mais on coupe au
// dernier espace avant 155 caracteres au lieu de trancher en plein mot.
const brut = `${cs.title}. ${cs.kpis.length > 0 ? `Résultats : ${cs.kpis.map((k) => `${k.value} ${k.label}`).join(', ')}. ` : ''}Automatisation ${cs.tools.length > 0 ? `avec ${cs.tools.join(', ')} ` : ''}${cs.secteur ? `pour un projet ${cs.secteur}` : ''}.`;
const seoDescription =
  cs.description ??
  (brut.length <= 155 ? brut : brut.slice(0, brut.lastIndexOf(' ', 155)) + '…');

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' },
  { name: cs.title, url: `/cas-clients/${entry.id}` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: cs.title,
  description: seoDescription,
  author: { '@id': 'https://liliansevoumian.fr/#person' },
  publisher: { '@id': 'https://liliansevoumian.fr/#person' },
  image: 'https://liliansevoumian.fr/og-image.jpg',
  datePublished: dateISO,
  about: [{ '@type': 'Thing', name: 'Automatisation des processus' }],
  mentions: cs.tools.map((t) => ({ '@type': 'Thing', name: t })),
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://liliansevoumian.fr/cas-clients/${entry.id}` },
  articleSection: 'Cas client',
  keywords: ['automatisation', 'cas client', cs.secteur, ...cs.tags, ...cs.tools].filter(Boolean).join(', '),
};
---

<Layout
  title={cs.seoTitle ?? `${cs.title} · cas client`}
  description={seoDescription}
  ogType="article"
  publishedDate={dateISO}
  articleSchema={articleSchema}
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content">

    <!-- HERO -->
    <section data-section class="relative pt-[80px] md:pt-[88px] px-[var(--spacing-section-x)]">
      <div class="relative max-w-[1200px] mx-auto pt-12 md:pt-20 pb-12">

        <a
          href="/cas-clients"
          class="inline-flex items-center gap-2 mono-caption text-[var(--color-ink-low)] hover:text-[var(--color-ink)] transition-colors mb-8"
        >
          <span aria-hidden="true">←</span>
          RETOUR AUX CAS
        </a>

        <!-- Meta header -->
        <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-2 mono-caption text-[var(--color-ink-low)] mb-6 md:mb-8">
          {cs.secteur && <span>{cs.secteur.toUpperCase()}</span>}
          {cs.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{cs.tags.join(' · ').toUpperCase()}</span>
            </>
          )}
          <>
            <span aria-hidden="true">·</span>
            <span>{cs.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' }).toUpperCase()}</span>
          </>
        </div>

        <!-- Title -->
        <div class="reveal mb-10 md:mb-12 bg-[var(--color-paper)] max-w-[64ch] py-2 pr-2 relative">
          <h1 class="font-display font-semibold text-[length:var(--text-display)] leading-[0.98] tracking-[-0.045em] text-[var(--color-ink)] m-0">
            {cs.title}
          </h1>
        </div>

        <!-- KPIs row -->
        {cs.kpis.length > 0 && (
          <div class="reveal grid grid-cols-1 sm:grid-cols-3 gap-px bg-[var(--color-divider)] border border-[var(--color-divider)] rounded-[var(--radius-md)] overflow-hidden max-w-3xl">
            {cs.kpis.map((kpi) => (
              <div class="bg-[var(--color-paper)] p-5 md:p-6 flex flex-col gap-1.5">
                <div class="font-display font-semibold tabular-nums text-3xl md:text-4xl tracking-[-0.035em] text-[var(--color-ink)] leading-none">
                  {kpi.value}
                </div>
                <div class="mono-caption text-[var(--color-ink-low)]">{kpi.label}</div>
              </div>
            ))}
          </div>
        )}

      </div>
    </section>

    <!-- CORPS DU CAS (Markdown) -->
    <section data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
      <div class="relative max-w-[72ch] mx-auto reveal case-prose">
        <Content />
      </div>
    </section>

    <!-- TÉMOIGNAGE + STACK -->
    {(cs.testimonial?.quote || cs.tools.length > 0) && (
      <section
        data-section
        class="relative bg-[var(--color-surface-low)] py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-b border-[var(--color-divider)]"
      >
        <div class="relative max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-start">

          {cs.testimonial?.quote && (
            <blockquote class="reveal max-w-[60ch] m-0 p-0">
              <div class="mono-caption text-[var(--color-ink-low)] mb-4">TÉMOIGNAGE</div>
              <p class="font-display font-semibold text-[length:var(--text-title-lg)] tracking-[-0.025em] text-[var(--color-ink)] leading-[1.25] m-0">
                « {cs.testimonial.quote} »
              </p>
              {(cs.testimonial.name || cs.testimonial.role) && (
                <footer class="mono-caption text-[var(--color-ink-low)] mt-5 not-italic">
                  {cs.testimonial.name}
                  {cs.testimonial.role && <span> · {cs.testimonial.role}</span>}
                </footer>
              )}
            </blockquote>
          )}

          {cs.tools.length > 0 && (
            <div class="reveal lg:max-w-[300px] w-full">
              <div class="mono-caption text-[var(--color-ink-low)] mb-4">STACK</div>
              <div class="flex flex-wrap gap-2">
                {cs.tools.map((tool) => (
                  <span class={chipClass(tool)}>{tool}</span>
                ))}
              </div>
            </div>
          )}

        </div>
      </section>
    )}

    <!-- CAS VOISINS -->
    {voisins.length > 0 && (
      <section data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]">
        <div class="relative max-w-[1200px] mx-auto">
          <div class="section-number mb-6">↦ AUTRES CAS</div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {voisins.map((v) => (
              <a href={`/cas-clients/${v.id}`} class="voisin">
                <span class="voisin-secteur">{v.data.secteur}</span>
                <span class="voisin-titre">{v.data.title}</span>
                {v.data.kpis.length > 0 && (
                  <span class="voisin-kpi">{v.data.kpis[0].value} {v.data.kpis[0].label}</span>
                )}
              </a>
            ))}
          </div>

          {pageOutil && (
            <p class="voisin-outil">
              Ce projet tourne sur <a href={pageOutil.href}>{pageOutil.nom}</a>.
            </p>
          )}
        </div>
      </section>
    )}

    <!-- CTA -->
    <section data-section class="bloc-lime relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal mb-8 md:mb-10 inline-block py-2 pr-2 relative">
          <div class="section-number" style="margin-bottom: 0.5rem;">↦ APPEL</div>
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[22ch]">
            Un projet <mark>similaire&nbsp;?</mark>
          </h2>
          <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 pt-3 max-w-[55ch]">
            20&nbsp;min pour poser votre process à plat. Sans engagement.
          </p>
        </div>

        <div class="reveal flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
          <a
            href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
            class="btn-primary justify-center"
            data-fast-goal="lead_call"
            data-fast-goal-source="cas_article"
          >
            Réserver mon diagnostic&nbsp;· 20&nbsp;min
          </a>
          <a
            href="mailto:bonjour@liliansevoumian.fr"
            class="btn-ghost justify-center"
          >
            ou écrire un mail
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .voisin {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-top: 2px solid var(--color-ink);
    padding-top: 1rem;
    text-decoration: none;
  }
  .voisin-secteur {
    font-size: var(--text-mono-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-low);
  }
  .voisin-titre {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-title);
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .voisin-kpi {
    margin-top: 0.35rem;
    align-self: flex-start;
    background: var(--color-lime);
    color: var(--color-ink);
    padding: 0.3em 0.6em;
    font-size: var(--text-body-sm);
    font-weight: 600;
  }
  .voisin-outil {
    margin-top: 2.5rem;
    color: var(--color-ink-mid);
  }
  .voisin-outil a {
    color: var(--color-ink);
    font-weight: 600;
    border-bottom: 2px solid var(--color-lime);
  }
</style>

<style>
  /* Corps Markdown des cas — calé sur les tokens du site. */
  .case-prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-headline);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 2.5em 0 0.75em;
  }
  .case-prose :global(h2:first-child) { margin-top: 0; }
  .case-prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-title);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 1.75em 0 0.5em;
  }
  .case-prose :global(p) {
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.65;
    margin: 0 0 1.1em;
  }
  .case-prose :global(strong) { color: var(--color-ink); font-weight: 600; }
  .case-prose :global(ul) {
    margin: 0 0 1.3em;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }
  .case-prose :global(li) {
    position: relative;
    padding-left: 1.4em;
    color: var(--color-ink-mid);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .case-prose :global(li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
  }
  /* Citation : fond différencié + bordure pleine — pas de side-stripe accent
     (ban DS « bordure latérale colorée >1px »). */
  .case-prose :global(blockquote) {
    margin: 1.5em 0;
    padding: 1em 1.25em;
    border: 1px solid var(--color-divider);
    background: var(--color-surface-low);
    border-radius: var(--radius-sm);
    color: var(--color-ink-mid);
  }
  .case-prose :global(a) {
    /* accent-text (pas accent vif) : lien dans du corps de texte → AA 4.5:1. */
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
