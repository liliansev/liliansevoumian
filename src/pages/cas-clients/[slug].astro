---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCaseStudies, getCaseStudyBySlug } from '../../lib/notion';

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();
  return caseStudies
    .filter(cs => cs.slug)
    .map(cs => ({
      params: { slug: cs.slug },
    }));
}

const { slug } = Astro.params;
const caseStudy = await getCaseStudyBySlug(slug as string);

if (!caseStudy) {
  return Astro.redirect('/cas-clients');
}

const seoDescription = `${caseStudy.title}. ${caseStudy.kpis.length > 0 ? `Résultats : ${caseStudy.kpis.map(k => `${k.value} ${k.label}`).join(', ')}. ` : ''}Découvrez comment l'automatisation ${caseStudy.tools.length > 0 ? `avec ${caseStudy.tools.join(', ')} ` : ''}a transformé ${caseStudy.secteur ? `ce projet ${caseStudy.secteur}` : 'cette entreprise'}.`.substring(0, 160);

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' },
  { name: caseStudy.title, url: `/cas-clients/${caseStudy.slug}` }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": caseStudy.title,
  "description": seoDescription,
  "author": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "publisher": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "datePublished": caseStudy.date || new Date().toISOString(),
  "dateModified": caseStudy.date || new Date().toISOString(),
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://liliansevoumian.fr/cas-clients/${caseStudy.slug}` },
  "articleSection": "Cas client",
  "keywords": ["automatisation", "cas client", caseStudy.secteur, ...caseStudy.tags, ...caseStudy.tools].filter(Boolean).join(", "),
};

const howToSchema = caseStudy.etapes ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `Comment automatiser : ${caseStudy.title}`,
  "description": caseStudy.probleme?.substring(0, 200),
  "tool": caseStudy.tools.map(tool => ({ "@type": "HowToTool", "name": tool })),
} : null;

const combinedSchema = howToSchema
  ? { ...articleSchema, hasPart: howToSchema }
  : articleSchema;

const accentColors = ['#E86A33', '#9333EA', '#22D3EE'];
---

<Layout
  title={`${caseStudy.title} | Cas client Automatisation - Lilian Sevoumian`}
  description={seoDescription}
  ogType="article"
  publishedDate={caseStudy.date}
  articleSchema={combinedSchema}
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content">
    <!-- Hero (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden pt-28 pb-0">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] px-[var(--spacing-section-x)]">
        <div class="max-w-[800px] mx-auto">
          <a href="/cas-clients" class="inline-flex items-center gap-2 font-body text-[length:var(--text-body-sm)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors mb-8 group">
            <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
            Retour aux cas clients
          </a>

          <div class="flex flex-col gap-5 fade-in-section">
            <div class="flex flex-wrap items-center gap-3">
              {caseStudy.secteur && (
                <span class="inline-block rounded-full px-4 py-1.5 text-[length:var(--text-micro)] font-semibold tracking-[2px] uppercase font-mono text-[var(--color-orange)]" style="background: rgba(232, 106, 51, 0.12);">
                  {caseStudy.secteur}
                </span>
              )}
              {caseStudy.tags.map((tag: string) => (
                <span class="rounded-full px-3 py-1 text-[length:var(--text-caption)] font-medium font-mono" style="background: rgba(147, 51, 234, 0.08); color: var(--color-purple-dark);">
                  {tag}
                </span>
              ))}
            </div>

            <h1 class="font-display text-[length:var(--text-display)] font-bold text-[var(--color-text-primary)] leading-[1.08]">
              {caseStudy.title}
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- KPIs (CREAM) -->
    {caseStudy.kpis.length > 0 && (
      <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
        <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
        <div class="relative z-[1] py-12 px-[var(--spacing-section-x)]">
          <div class="max-w-[800px] mx-auto">
            <div class="grid grid-cols-3 gap-4 fade-in-section">
              {caseStudy.kpis.map((kpi: { value: string; label: string }, i: number) => (
                <div class="card-3d-white-orange p-6 flex flex-col items-center text-center">
                  <span class="font-mono text-3xl md:text-4xl font-bold" style={`color: ${accentColors[i % 3]};`}>{kpi.value}</span>
                  <span class="font-body text-[length:var(--text-caption)] text-[var(--color-text-secondary)] uppercase tracking-[1px] mt-1">{kpi.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Entreprise (WHITE) -->
    {caseStudy.entreprise && (
      <section data-bg="white" class="relative bg-white overflow-hidden">
        <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
        <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
          <div class="max-w-[800px] mx-auto fade-in-section">
            <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-purple-dark)] mb-3">
              L'ENTREPRISE
            </span>
            <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.7] whitespace-pre-line">
              {caseStudy.entreprise}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- Le défi (CREAM) -->
    {caseStudy.probleme && (
      <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
        <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
        <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
          <div class="max-w-[800px] mx-auto fade-in-section">
            <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-orange)] mb-3">
              LE DÉFI
            </span>
            <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.7] whitespace-pre-line">
              {caseStudy.probleme}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- Témoignage (WHITE) -->
    {caseStudy.testimonial?.quote && (
      <section data-bg="white" class="relative bg-white overflow-hidden">
        <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
        <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
          <div class="max-w-[700px] mx-auto text-center fade-in-section">
            <blockquote>
              <p class="font-body text-[length:var(--text-subheading)] font-medium text-[var(--color-text-primary)] leading-[1.5] mb-6 italic">
                "{caseStudy.testimonial.quote}"
              </p>
              {(caseStudy.testimonial.name || caseStudy.testimonial.role) && (
                <footer class="font-body text-[length:var(--text-body)]">
                  <span class="font-semibold text-[var(--color-text-primary)]">{caseStudy.testimonial.name}</span>
                  {caseStudy.testimonial.role && (
                    <span class="text-[var(--color-text-secondary)]"> · {caseStudy.testimonial.role}</span>
                  )}
                </footer>
              )}
            </blockquote>
          </div>
        </div>
      </section>
    )}

    <!-- La solution (CREAM) -->
    {caseStudy.solution && (
      <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
        <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
        <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
          <div class="max-w-[800px] mx-auto fade-in-section">
            <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-cyan-dark)] mb-3">
              LA SOLUTION
            </span>
            <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.7] whitespace-pre-line">
              {caseStudy.solution}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- Résultats détaillés (WHITE) -->
    {caseStudy.resultatsDetails && (
      <section data-bg="white" class="relative bg-white overflow-hidden">
        <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
        <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
          <div class="max-w-[800px] mx-auto fade-in-section">
            <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-orange)] mb-3">
              LES RÉSULTATS
            </span>
            <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.7] whitespace-pre-line">
              {caseStudy.resultatsDetails}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- Étapes (CREAM) -->
    {caseStudy.etapes && (
      <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
        <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
        <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
          <div class="max-w-[800px] mx-auto fade-in-section">
            <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-purple-dark)] mb-3">
              LES ÉTAPES
            </span>
            <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] leading-[1.7] whitespace-pre-line">
              {caseStudy.etapes}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- Outils (WHITE) -->
    {caseStudy.tools.length > 0 && (
      <section data-bg="white" class="relative bg-white overflow-hidden">
        <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>
        <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
          <div class="max-w-[800px] mx-auto fade-in-section">
            <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-orange)] mb-3">
              STACK TECHNIQUE
            </span>
            <div class="flex flex-wrap gap-3">
              {caseStudy.tools.map((tool: string) => (
                <span class="rounded-full px-4 py-2 text-[length:var(--text-body-sm)] font-medium font-mono" style="background: rgba(232, 106, 51, 0.1); color: var(--color-orange);">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- CTA (CREAM) -->
    <section data-bg="cream" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
      <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
      <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
        <div class="max-w-[600px] mx-auto text-center flex flex-col items-center gap-4 fade-in-section">
          <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-primary)]">
            Un projet similaire&nbsp;?
          </h2>
          <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)]">
            Parlons de votre situation — l'appel est gratuit, 30&nbsp;min, sans engagement.
          </p>
          <a
            href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
            class="btn-3d inline-flex items-center justify-center font-body text-[length:var(--text-body)] font-semibold px-7 py-3.5 mt-2 group"
          >
            Réserver mon appel stratégique <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
