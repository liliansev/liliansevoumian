---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import CTAButton from '../../components/ui/CTAButton.astro';
import { getCaseStudies, getCaseStudyBySlug } from '../../lib/notion';

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();
  return caseStudies
    .filter(cs => cs.slug)
    .map(cs => ({
      params: { slug: cs.slug },
    }));
}

const { slug } = Astro.params;
const caseStudy = await getCaseStudyBySlug(slug as string);

if (!caseStudy) {
  return Astro.redirect('/cas-clients');
}
---

<Layout
  title={`${caseStudy.title} | Cas client - Lilian Sevoumian`}
  description={`${caseStudy.entreprise.substring(0, 150)}...`}
>
  <Navigation />

  <main id="main-content">
    <!-- Hero -->
    <section class="px-6 bg-zinc-900 pt-32 pb-16 lg:pb-24">
      <div class="max-w-5xl mx-auto">
        <!-- Back link -->
        <a
          href="/cas-clients"
          class="inline-flex items-center gap-2 text-zinc-400 hover:text-violet-400 text-sm font-medium mb-10 transition-colors group"
        >
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Retour aux cas clients
        </a>

        <!-- Tags + Stack ensemble -->
        <div class="flex flex-wrap items-center gap-3 mb-8">
          {caseStudy.secteur && (
            <span class="px-3 py-1.5 bg-violet-500 text-white text-sm font-medium rounded-full">
              {caseStudy.secteur}
            </span>
          )}
          {caseStudy.tags.map(tag => (
            <span class="px-3 py-1.5 bg-zinc-800 text-zinc-200 text-sm font-medium rounded-full border border-zinc-600">
              {tag}
            </span>
          ))}
          {caseStudy.tools.length > 0 && (
            <>
              <span class="text-zinc-500 mx-1">•</span>
              {caseStudy.tools.map(tool => (
                <span class="px-3 py-1.5 text-sm text-zinc-300 bg-zinc-800/70 rounded-full border border-zinc-700/50">
                  {tool}
                </span>
              ))}
            </>
          )}
        </div>

        <!-- Title -->
        <h1 class="fluid-h1 font-semibold text-white mb-16 max-w-4xl leading-tight">
          {caseStudy.title}
        </h1>

        <!-- KPIs -->
        {caseStudy.kpis.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 lg:gap-20 pt-12 border-t border-violet-500/30">
            {caseStudy.kpis.map(kpi => (
              <div>
                <p class="text-6xl lg:text-7xl font-bold text-white tracking-tighter">
                  {kpi.value}
                </p>
                <p class="text-sm lg:text-base text-zinc-400 mt-3 uppercase tracking-wide">
                  {kpi.label}
                </p>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Le contexte -->
    {caseStudy.entreprise && (
      <section class="py-20 lg:py-32 px-6 bg-zinc-100">
        <div class="max-w-5xl mx-auto">
          <div class="grid lg:grid-cols-[280px_1fr] gap-8 lg:gap-24">
            <div>
              <p class="text-xs text-violet-500 uppercase tracking-widest font-medium mb-3">01</p>
              <h2 class="text-2xl lg:text-3xl font-semibold text-zinc-900 leading-tight">
                L'entreprise
              </h2>
            </div>
            <div>
              <p class="text-lg lg:text-xl text-zinc-600 leading-relaxed whitespace-pre-line">
                {caseStudy.entreprise}
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Le défi -->
    {caseStudy.probleme && (
      <section class="py-20 lg:py-32 px-6 bg-white">
        <div class="max-w-5xl mx-auto">
          <div class="grid lg:grid-cols-[280px_1fr] gap-8 lg:gap-24">
            <div>
              <p class="text-xs text-violet-500 uppercase tracking-widest font-medium mb-3">02</p>
              <h2 class="text-2xl lg:text-3xl font-semibold text-zinc-900 leading-tight">
                Le défi
              </h2>
            </div>
            <div class="space-y-6">
              <p class="text-lg lg:text-xl text-zinc-600 leading-relaxed whitespace-pre-line">
                {caseStudy.probleme}
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Témoignage -->
    {caseStudy.testimonial?.quote && (
      <section class="py-24 lg:py-36 px-6 bg-zinc-900">
        <div class="max-w-4xl mx-auto text-center">
          <svg class="w-12 h-12 text-violet-500/60 mx-auto mb-10" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
          <blockquote>
            <p class="text-xl lg:text-2xl font-medium text-white leading-relaxed mb-10">
              {caseStudy.testimonial.quote}
            </p>
            {(caseStudy.testimonial.name || caseStudy.testimonial.role) && (
              <footer class="text-base lg:text-lg">
                <span class="text-white font-semibold">{caseStudy.testimonial.name}</span>
                {caseStudy.testimonial.role && (
                  <span class="text-zinc-400"> · {caseStudy.testimonial.role}</span>
                )}
              </footer>
            )}
          </blockquote>
        </div>
      </section>
    )}

    <!-- Ce qu'on a automatisé -->
    {caseStudy.solution && (
      <section class="py-20 lg:py-32 px-6 bg-zinc-100">
        <div class="max-w-5xl mx-auto">
          <div class="grid lg:grid-cols-[280px_1fr] gap-8 lg:gap-24">
            <div>
              <p class="text-xs text-violet-500 uppercase tracking-widest font-medium mb-3">03</p>
              <h2 class="text-2xl lg:text-3xl font-semibold text-zinc-900 leading-tight">
                Ce qu'on a<br class="hidden lg:block" /> automatisé
              </h2>
            </div>
            <div class="prose prose-zinc prose-lg max-w-none">
              <div class="text-lg lg:text-xl text-zinc-600 leading-relaxed whitespace-pre-line [&>strong]:text-zinc-900 [&>strong]:font-semibold [&>strong]:block [&>strong]:mt-10 [&>strong]:mb-4 first:[&>strong]:mt-0">
                {caseStudy.solution}
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Les résultats -->
    {caseStudy.resultatsDetails && (
      <section class="py-20 lg:py-32 px-6 bg-white">
        <div class="max-w-5xl mx-auto">
          <div class="grid lg:grid-cols-[280px_1fr] gap-8 lg:gap-24">
            <div>
              <p class="text-xs text-violet-500 uppercase tracking-widest font-medium mb-3">04</p>
              <h2 class="text-2xl lg:text-3xl font-semibold text-zinc-900 leading-tight">
                Les résultats
              </h2>
            </div>
            <div class="prose prose-zinc prose-lg max-w-none">
              <div class="text-lg lg:text-xl text-zinc-600 leading-relaxed whitespace-pre-line [&>strong]:text-zinc-900 [&>strong]:font-semibold [&>strong]:block [&>strong]:mt-10 [&>strong]:mb-4 first:[&>strong]:mt-0">
                {caseStudy.resultatsDetails}
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Les étapes -->
    {caseStudy.etapes && (
      <section class="py-20 lg:py-32 px-6 bg-zinc-100">
        <div class="max-w-5xl mx-auto">
          <div class="grid lg:grid-cols-[280px_1fr] gap-8 lg:gap-24">
            <div>
              <p class="text-xs text-violet-500 uppercase tracking-widest font-medium mb-3">05</p>
              <h2 class="text-2xl lg:text-3xl font-semibold text-zinc-900 leading-tight">
                Les étapes
              </h2>
            </div>
            <div class="prose prose-zinc prose-lg max-w-none">
              <div class="text-lg lg:text-xl text-zinc-600 leading-relaxed whitespace-pre-line [&>strong]:text-zinc-900 [&>strong]:font-semibold [&>strong]:block [&>strong]:mt-10 [&>strong]:mb-4 first:[&>strong]:mt-0">
                {caseStudy.etapes}
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="py-28 lg:py-40 px-6 bg-zinc-900">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-semibold text-white mb-5">
          Un projet similaire ?
        </h2>
        <p class="text-lg lg:text-xl text-zinc-400 mb-12">
          Discutons de vos besoins en automatisation.
        </p>
        <CTAButton
          href="https://cal.com/liliansevoumian/diagnostic"
          text="Prendre rendez-vous"
          variant="inverted"
          size="lg"
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
