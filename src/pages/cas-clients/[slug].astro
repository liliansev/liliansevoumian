    border-radius: var(--radius-full);
    /* accent-text et non accent : la pièce des résultats est un panneau clair,
       où une puce pêche de 6 px ne tient que 1,64:1. Ce jeton vaut la pêche
       sur la nuit et la nuit sur le clair. */
    background: var(--color-accent-text);
  }

  /* La pêche dit un gain, partout ailleurs sur le site. Dans « Le problème »
     elle marquait des pannes : seize factures bloquées, un bug d'acomptes, zéro
     visibilité. La puce y devient un anneau creux, qui énumère sans féliciter.
     Même raison dans « Les étapes », qui décrit un déroulé, pas un résultat. */
  #le-problème .case-prose :global(ul > li::before),
  #les-étapes .case-prose :global(ul > li::before) {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--color-ink-faint);
  }

  /* Une liste ordonnée garde ses numéros : l'ordre y est l'information. */
  .case-prose :global(ol) {
    counter-reset: rang;
  }

  .case-prose :global(ol > li) {
    counter-increment: rang;
  }

  .case-prose :global(ol > li::before) {
