---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Retour from '../../components/retour.astro';
import FinDePage from '../../components/fin-de-page.astro';
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import MockupWindow from '../../components/mockups/MockupWindow.astro';
import WorkflowCanvas from '../../components/mockups/WorkflowCanvas.astro';
import { brandColorFor } from '../../data/brands';
import Outil from '../../components/Outil.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cas-clients', (entry) =>
    import.meta.env.PROD ? !entry.data.draft : true,
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
await render(entry);
const cs = entry.data;
const subject = cs.category === 'application' ? 'Application métier' : 'Automatisation des processus';

/*
 * Un cas est une page de lecture. Son corps est découpé en PIÈCES, une par
 * <h2> : le titre de la pièce tient dans la marge de gauche, où il accompagne
 * la lecture, et le texte dans une colonne calme à droite. Sur une colonne
 * (téléphone, tablette), le titre passe au-dessus.
 *
 * Le découpage lit `entry.rendered.html` et coupe sur les ancres que Astro
 * pose déjà (`<h2 id="…">`). Pas de plugin rehype : il faudrait une dépendance,
 * une entrée de config, un cache à débusquer, et il travaillerait à l'aveugle
 * hors de tout contexte visuel. Ici tout est dans le gabarit, sous les yeux.
 */
const HTML_RENDU: string = (entry as unknown as { rendered?: { html?: string } }).rendered?.html ?? '';

interface Piece { id: string; titre: string; reserve: string; corps: string }

function decouper(html: string): Piece[] {
  if (!html) return [];
  const morceaux = html.split(/(?=<h2\b)/);
  const pieces: Piece[] = [];
  for (const m of morceaux) {
    const tete = m.match(/^<h2\b[^>]*\bid="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/);
    if (!tete) continue;
    let corps = m.slice(tete[0].length);
    /* Une réserve en tête de pièce est extraite pour être rendue AVANT la
       bascule : elle restreint la portée de tout ce qui suit, on ne peut pas
       la lire après les chiffres qu'elle qualifie. */
    let reserve = '';
    const tetePiece = corps.match(/^\s*<blockquote[\s\S]*?<\/blockquote>/);
    if (tetePiece) {
      reserve = tetePiece[0];
      corps = corps.slice(tetePiece[0].length);
    }
    pieces.push({
      id: tete[1],
      titre: tete[2].replace(/<[^>]+>/g, '').trim(),
      reserve,
      corps,
    });
  }
  return pieces;
}

/* Le Markdown ne pose pas les espaces insécables du français : sans elles, un
   deux-points ou un « € » passait seul à la ligne. Elles sont posées ici, sur
   le texte rendu : avant `: ; ? !` et le guillemet fermant, après le guillemet
   ouvrant, entre un nombre et son unité. Aucune balise ne contient ces suites. */
const espaces = (texte: string) =>
  texte
    .replace(/ ([:;?!»])/g, '\u00a0$1')
    .replace(/« /g, '«\u00a0')
    .replace(/(\d) (?=(?:h|min|%|€)(?![\p{L}\d]))/gu, '$1\u00a0');

const pieces = decouper(espaces(HTML_RENDU));

/* Le clair de la page : la pièce des résultats, et elle seule. C'est ce que le
   lecteur est venu vérifier. Un cas sans résultats mesurés n'a pas d'île. La
   clé est l'ancre que Astro dérive du titre. */
const ILE = 'les-résultats';

const ROLES: Record<string, string> = {
  declencheur: 'Déclencheur',
  agent: 'IA',
  action: 'Action',
  controle: 'Contrôle',
};
const dateISO = cs.date.toISOString();
const datePubliee = cs.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' });

// Cas voisins : meme tag d abord, puis complement par les plus recents. Deux
// cas, jamais le cas courant.
const tous = await getCollection('cas-clients', (e) => import.meta.env.DEV || !e.data.draft);
const autres = tous.filter((e) => e.id !== entry.id);
/* Le tri par tags partagés ne discriminait rien : les quatre cas portent tous
   « Ops », donc la première liste les contenait tous et `slice(0, 2)` retenait
   toujours les deux mêmes. M Partners, dernier dans l'ordre de chargement,
   n'apparaissait sur aucune fiche sœur — 2 liens entrants contre 5 pour les
   autres. On départage d'abord par NOMBRE de tags communs, puis par date, et
   on fait tourner la sélection selon la position du cas courant pour que les
   quatre soient cités autant de fois. */
const rang = tous.findIndex((e) => e.id === entry.id);
const classes = autres
  .map((e) => ({ e, communs: e.data.tags.filter((t) => cs.tags.includes(t)).length }))
  .sort((a, b) => b.communs - a.communs || b.e.data.date.getTime() - a.e.data.date.getTime())
  .map((x) => x.e);
const voisins = [...classes.slice(rang % classes.length), ...classes.slice(0, rang % classes.length)].slice(0, 2);

// L outil principal du cas, pour renvoyer vers sa page dediee avec l ancre
// de requete exacte.
const pageOutil = cs.tools.includes('n8n')
  ? { nom: 'n8n', href: '/expert-n8n', icone: 'simple-icons:n8n' }
  : cs.tools.includes('Make')
    ? { nom: 'Make', href: '/expert-make', icone: 'simple-icons:make' }
    : null;

// La description redigee prime. A defaut, on compose, mais on coupe au
// dernier espace avant 155 caracteres au lieu de trancher en plein mot.
const brut = `${cs.title}. ${cs.kpis.length > 0 ? `Résultats : ${cs.kpis.map((k) => `${k.value} ${k.label}`).join(', ')}. ` : ''}${subject} ${cs.tools.length > 0 ? `avec ${cs.tools.join(', ')} ` : ''}${cs.secteur ? `pour un projet ${cs.secteur}` : ''}.`;
const seoDescription =
  cs.description ??
  (brut.length <= 155 ? brut : brut.slice(0, brut.lastIndexOf(' ', 155)) + '…');

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' },
  { name: cs.title, url: `/cas-clients/${entry.id}` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `https://liliansevoumian.fr/cas-clients/${entry.id}#article`,
  headline: cs.title,
  description: seoDescription,
  author: { '@id': 'https://liliansevoumian.fr/#person' },
  publisher: { '@id': 'https://liliansevoumian.fr/#person' },
  image: 'https://liliansevoumian.fr/og-image.png',
  datePublished: dateISO,
  dateModified: dateISO,
  inLanguage: 'fr-FR',
  about: [{ '@type': 'Thing', name: subject }],
  mentions: cs.tools.map((t) => ({ '@type': 'Thing', name: t })),
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://liliansevoumian.fr/cas-clients/${entry.id}` },
  articleSection: 'Cas client',
  keywords: [subject, 'cas client', cs.secteur, ...cs.tags, ...cs.tools].filter(Boolean).join(', '),
};
---

<Layout
  title={cs.seoTitle ?? `${cs.title} · cas client`}
  description={seoDescription}
  ogType="article"
  publishedDate={dateISO}
  articleSchema={articleSchema}
  breadcrumbs={breadcrumbs}
>
  <Navigation ctaSource="cas_article_nav" />

  <main id="main-content" tabindex="-1" class="outline-none">

    <section data-section class="relative px-[var(--spacing-section-x)]">
      {/* `.entree` : le fil de retour, le titre, la ligne de contexte puis les
          chiffres montent l'un après l'autre, dans l'ordre de lecture. Ce sont
          des `@keyframes` jouées au chargement et non un voile levé par
          script : le titre du cas est le message de la page, sans script il
          est simplement là. */}
      <div class="entree relative max-w-[1200px] mx-auto pt-[calc(var(--spacing-barre)+var(--spacing-bloc))] pb-[var(--spacing-bloc)]">

        <div class="mb-[var(--spacing-groupe)]">
          <Retour href="/cas-clients">Retour aux cas</Retour>
        </div>

        <h1 class="cas-titre">{espaces(cs.title)}</h1>

        {cs.scopeNote && <p class="cas-chapo">{cs.scopeNote}</p>}

        {/* Le secteur, les sujets et la date sont de vraies informations : une
            ligne sobre sous le titre, comme la signature d'un article. */}
        <p class="cas-meta">
          {cs.secteur && <span class="cas-meta__secteur">{cs.secteur}</span>}
          {cs.tags.length > 0 && <span>{cs.tags.join(', ')}</span>}
          <span>Publié en <time datetime={dateISO.slice(0, 10)}>{datePubliee}</time></span>
        </p>

        {/* Les chiffres du cas, un par colonne, sans cadre : ce qu'on retient,
            puis ce qui le précise. Ils partent des mêmes lignes verticales que
            les pièces qui suivent. */}
        {cs.kpis.length > 0 && (
          <dl class="faits">
            {cs.kpis.map((kpi) => (
              <div>
                <dt class="fait__valeur">{espaces(kpi.value)}</dt>
                <dd class="fait__detail">{espaces(kpi.label)}</dd>
              </div>
            ))}
          </dl>
        )}

      </div>
    </section>

    {/* Une pièce par <h2>, toutes sur la nuit, séparées par un filet. Seule la
        pièce des résultats passe sur le panneau clair : c'est le pic de la
        page. Le filet s'efface autour de lui, le panneau se détache seul. */}
    {pieces.map((piece, i) => {
      const ile = piece.id === ILE;
      const apresIle = i > 0 && pieces[i - 1].id === ILE;
      return (
        <section
          data-section
          id={piece.id}
          class:list={[
            'piece relative px-[var(--spacing-section-x)]',
            ile && 'bloc-encre',
            !ile && !apresIle && 'piece--filet',
          ]}
        >
          <div class="piece__grille relative max-w-[1200px] mx-auto">
            <h2 class="piece__titre">{piece.titre}</h2>

            <div class="piece__corps">
              {piece.reserve && <div class="reveal case-prose piece-reserve" set:html={piece.reserve} />}

              {/* Le schéma ouvre « La solution » : le lecteur voit le parcours
                  avant de lire les paragraphes qui le détaillent. C'est une
                  reconstitution, jamais une capture (les écrans clients sont
                  confidentiels), et la barre de la fenêtre le dit (`schema`).
                  Un cas dont la chaîne ne rentre pas dans la géométrie n'a pas
                  de `flow`, donc pas de schéma : rien vaut mieux qu'un dessin
                  faux. */}
              {piece.id === 'la-solution' && cs.flow && (
                <div class="reveal piece-schema">
                  <MockupWindow file={`${cs.tools[0] ?? 'workflow'} · parcours`} schema flush>
                    <WorkflowCanvas
                      describe={cs.flow.describe}
                      trigger={{ ...cs.flow.trigger, color: brandColorFor(cs.flow.trigger.icon) }}
                      agent={{ ...cs.flow.agent, color: brandColorFor(cs.flow.agent.icon) }}
                      actions={cs.flow.actions.map((a) => ({ ...a, color: brandColorFor(a.icon) }))}
                    />
                  </MockupWindow>
                </div>
              )}

              {/* La bascule ouvre « Les résultats » : ce que le client achète,
                  c'est un écart, et il doit se lire avant la liste qui le
                  détaille. La pastille pêche ne marque QUE la colonne
                  « après » : un état obtenu, jamais un terme d'avant, jamais
                  un objectif. */}
              {ile && cs.bascule && (
                <dl class="reveal bascule">
                  <div class="bascule-entete" aria-hidden="true">
                    <dt>Avant</dt>
                    <dd>Après</dd>
                  </div>
                  {cs.bascule.map((ligne) => (
                    <div class="bascule-ligne">
                      <dt>{espaces(ligne.avant)}</dt>
                      <dd>{espaces(ligne.apres)}</dd>
                    </div>
                  ))}
                </dl>
              )}

              <div class="reveal case-prose" set:html={piece.corps} />

              {/* La nomenclature clôt « La solution » : après le récit, le
                  relevé, dans son panneau. Ses rangs restent : l'ordre des
                  étapes est l'information. La pastille pêche y marque les
                  CONTRÔLES, et eux seuls : c'est la thèse du portfolio rendue
                  visible d'un coup d'œil, l'IA extrait et les règles
                  décident. */}
              {piece.id === 'la-solution' && cs.nomenclature && (
                <div class="reveal nomenclature">
                  <p class="nomenclature-tete">
                    <strong>Nomenclature</strong>
                    <span>{cs.nomenclature.length} étapes · {cs.nomenclature.filter((n) => n.role === 'controle').length} contrôles</span>
                  </p>
                  <ol class="nomenclature-liste">
                    {cs.nomenclature.map((n, k) => (
                      <li class="nomenclature-ligne">
                        <span class="nomenclature-rang">{k + 1}</span>
                        <span class="nomenclature-etape">{espaces(n.etape)}</span>
                        <span class="nomenclature-porte">
                          {n.outil && <span class="nomenclature-outil">{n.outil}</span>}
                          <span class:list={['nomenclature-role', n.role === 'controle' && 'est-controle']}>
                            {ROLES[n.role]}
                          </span>
                        </span>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </div>
          </div>
        </section>
      );
    })}

    {/* CAS VOISINS. Deux autres cas, sur la même grille que les pièces : le
        titre dans la marge, un cas par colonne. Le lien est le titre et
        s'étend à tout le bloc, comme sur la page des cas. Le filet du haut
        s'efface quand le panneau clair précède ; celui du bas sépare de la fin
        de page. */}
    {voisins.length > 0 && (
      <section
        data-section
        class:list={[
          'relative border-b border-[var(--color-divider)] py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]',
          pieces.at(-1)?.id !== ILE && 'border-t',
        ]}
      >
        <div class="voisins relative max-w-[1200px] mx-auto">
          <h2 class="m-0">Autres cas</h2>

          <div class="voisins__liste">
            {voisins.map((v) => (
              <article class="voisin">
                <h3 class="voisin__titre">
                  <a href={`/cas-clients/${v.id}`} class="voisin__lien">{v.data.title}</a>
                </h3>
                {v.data.secteur && <p class="voisin__meta">{v.data.secteur}</p>}
                {v.data.kpis.length > 0 && (
                  <p class="voisin__fait"><strong>{espaces(v.data.kpis[0].value)}</strong> {espaces(v.data.kpis[0].label)}</p>
                )}
                <span class="link-cta" aria-hidden="true">
                  <span class="link-cta__label">Lire le détail</span>
                  <Icon name="lucide:arrow-right" class="link-cta__arrow" />
                </span>
              </article>
            ))}
          </div>

          {pageOutil && (
            <p class="voisin-outil">
              Expertise associée&nbsp;: <Outil icon={pageOutil.icone}><a href={pageOutil.href}>{pageOutil.nom}</a></Outil>.
            </p>
          )}
        </div>
      </section>
    )}

    <FinDePage source="cas_article_fin" titre="Un projet <mark>similaire&nbsp;?</mark>" />

  </main>

  <Footer />
</Layout>

<style>
  /* ── L'en-tête ── */
  /* Le titre d'un cas est une phrase : il prend la taille d'affiche de
     l'accueil, un rang sous le titre des pages d'index. */
  .cas-titre {
    max-width: 20ch;
    margin: 0;
    font-size: var(--text-affiche);
  }

  .cas-chapo {
    margin: var(--spacing-lie) 0 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.5;
  }

  .cas-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    max-width: none;
    margin: var(--spacing-lie) 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .cas-meta__secteur {
    color: var(--color-ink-mid);
  }

  .faits {
    display: grid;
    gap: var(--spacing-lie) var(--spacing-gouttiere);
    margin: var(--spacing-bloc) 0 0;
  }

  .fait__valeur {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .fait__detail {
    max-width: 34ch;
    margin: var(--spacing-colle) 0 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.45;
  }

  @media (min-width: 48rem) {
    .faits {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ── La pièce ── */
  .piece {
    padding-block: var(--spacing-bloc);
  }

  .piece--filet {
    border-top: 1px solid var(--color-divider);
  }

  .piece__grille {
    display: grid;
    gap: var(--spacing-groupe);
  }

  .piece__titre {
    margin: 0;
  }

  .piece__corps {
    min-width: 0;
  }

  /* Grand écran : trois colonnes, les mêmes que celles des chiffres de
     l'en-tête. Le titre de la pièce tient dans la première et reste en vue
     pendant qu'on lit la pièce ; le texte occupe les deux autres. */
  @media (min-width: 64rem) {
    .piece__grille {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--spacing-gouttiere);
      align-items: start;
    }

    .piece__titre {
      position: sticky;
      top: 7rem;
    }

    .piece__corps {
      grid-column: 2 / span 2;
    }
  }

  /* Le schéma est la seule figure qui prend toute la colonne. L'encadré de
     réserve, la bascule et la nomenclature gardent la mesure du texte : un
     seul bord droit pour tout ce qui se lit. */
  .piece-schema,
  .piece-reserve {
    margin-bottom: var(--spacing-groupe);
  }

  /* ── La nomenclature : un relevé dans son panneau. Pas de filet entre les
        lignes : les colonnes sont communes à toutes (`subgrid`), c'est
        l'alignement qui tient le tableau. La taille posée ici ne sert qu'à
        donner au plafond de 46ch la mesure des paragraphes. ── */
  .nomenclature {
    max-width: 46ch;
    margin-top: var(--spacing-groupe);
    padding: var(--spacing-panneau);
    border-radius: var(--radius-md);
    background: var(--color-surface-low);
    font-size: var(--text-body-large);
  }

  .nomenclature-tete {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    max-width: none;
    margin: 0 0 var(--spacing-lie);
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .nomenclature-tete strong {
    color: var(--color-ink);
    font-weight: 500;
  }

  .nomenclature-liste {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) max-content max-content;
    gap: 0.75rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* La règle de base plafonne tout `li` à une mesure de prose. Ici la ligne
     est une rangée de tableau, sur toute la largeur du panneau. */
  .nomenclature-ligne {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: baseline;
    max-width: none;
  }

  .nomenclature-porte {
    display: contents;
  }

  .nomenclature-rang,
  .nomenclature-outil,
  .nomenclature-role {
    font-size: var(--text-mono-label);
    white-space: nowrap;
  }

  /* ink-low et non ink-faint : le rang se lit, c'est du texte porteur. */
  .nomenclature-rang {
    color: var(--color-ink-low);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .nomenclature-etape {
    min-width: 0;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    line-height: 1.4;
  }

  .nomenclature-outil {
    grid-column: 3;
    color: var(--color-ink-low);
  }

  .nomenclature-role {
    grid-column: 4;
    justify-self: start;
    padding: 0.15rem 0.6rem;
    color: var(--color-ink-low);
  }

  /* La pêche ne marque QUE le contrôle, et par la couleur du mot : la pastille
     pleine est réservée au bouton d'appel. `--color-accent-text` est la pêche
     sur la nuit, la nuit dans une île claire. */
  .nomenclature-role.est-controle {
    color: var(--color-accent-text);
    font-weight: 600;
  }

  /* Téléphone : le rang et l'étape sur une ligne, l'outil et le rôle dessous. */
  @media (max-width: 40rem) {
    .nomenclature-liste {
      grid-template-columns: max-content minmax(0, 1fr);
    }

    .nomenclature-ligne {
      row-gap: 0.25rem;
    }

    .nomenclature-porte {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
      grid-column: 2;
    }

    .nomenclature-role:not(.est-controle) {
      padding-inline: 0;
    }
  }

  /* ── La bascule avant / après : deux colonnes, sans filet, à la mesure
        des paragraphes (même taille posée, même plafond de 46ch) ── */
  .bascule {
    display: grid;
    row-gap: var(--spacing-lie);
    max-width: 46ch;
    margin: 0 0 var(--spacing-groupe);
    font-size: var(--text-body-large);
  }

  .bascule-entete,
  .bascule-ligne {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.35rem 1.5rem;
    align-items: baseline;
  }

  .bascule-entete dt,
  .bascule-entete dd {
    margin: 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .bascule-ligne dt {
    color: var(--color-ink-mid);
    font-size: var(--text-body);
    line-height: 1.45;
  }

  .bascule-ligne dd {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.45;
  }

  @media (max-width: 34rem) {
    .bascule-entete { display: none; }

    .bascule-ligne {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Sans l'en-tête, il faut dire lequel est lequel. */
    .bascule-ligne dt::before {
      content: 'Avant\00a0: ';
      color: var(--color-ink-low);
    }
  }

  /* ── Le corps Markdown : la colonne de lecture. Les paragraphes, les listes
        et l'encadré partagent une taille et donc une mesure (le plafond de
        46ch de la règle de base, environ 70 caractères). Les titres prennent
        leur taille et leur graisse de la règle commune. ── */
  .case-prose :global(h3) {
    margin: var(--spacing-groupe) 0 var(--spacing-colle);
  }

  .case-prose :global(h3:first-child) {
    margin-top: 0;
