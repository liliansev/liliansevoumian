---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCaseStudies, getCaseStudyBySlug } from '../../lib/notion';

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();
  return caseStudies
    .filter(cs => cs.slug)
    .map(cs => ({
      params: { slug: cs.slug },
    }));
}

const { slug } = Astro.params;
const caseStudy = await getCaseStudyBySlug(slug as string);

if (!caseStudy) {
  return Astro.redirect('/cas-clients');
}

const seoDescription = `${caseStudy.title}. ${caseStudy.kpis.length > 0 ? `Résultats : ${caseStudy.kpis.map(k => `${k.value} ${k.label}`).join(', ')}. ` : ''}Automatisation ${caseStudy.tools.length > 0 ? `avec ${caseStudy.tools.join(', ')} ` : ''}${caseStudy.secteur ? `pour un projet ${caseStudy.secteur}` : ''}.`.substring(0, 160);

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Cas clients', url: '/cas-clients' },
  { name: caseStudy.title, url: `/cas-clients/${caseStudy.slug}` }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": caseStudy.title,
  "description": seoDescription,
  "author": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "publisher": { "@type": "Person", "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr" },
  "datePublished": caseStudy.date || new Date().toISOString(),
  "dateModified": caseStudy.date || new Date().toISOString(),
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://liliansevoumian.fr/cas-clients/${caseStudy.slug}` },
  "articleSection": "Cas client",
  "keywords": ["automatisation", "cas client", caseStudy.secteur, ...caseStudy.tags, ...caseStudy.tools].filter(Boolean).join(", "),
};

const howToSchema = caseStudy.etapes ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `Comment automatiser : ${caseStudy.title}`,
  "description": caseStudy.probleme?.substring(0, 200),
  "tool": caseStudy.tools.map(tool => ({ "@type": "HowToTool", "name": tool })),
} : null;

const combinedSchema = howToSchema
  ? { ...articleSchema, hasPart: howToSchema }
  : articleSchema;

import { chipClass } from '../../lib/tool-chip';
---

<Layout
  title={`${caseStudy.title} | Cas client Automatisation - Lilian Sevoumian`}
  description={seoDescription}
  ogType="article"
  publishedDate={caseStudy.date}
  articleSchema={combinedSchema}
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content">

    <!-- HERO -->
    <section data-section class="relative pt-[80px] md:pt-[88px] px-[var(--spacing-section-x)]">
      <div class="relative max-w-[1200px] mx-auto pt-12 md:pt-20 pb-12">

        <a
          href="/cas-clients"
          class="inline-flex items-center gap-2 mono-caption text-[var(--color-ink-low)] hover:text-[var(--color-ink)] transition-colors mb-8"
        >
          <span aria-hidden="true">←</span>
          RETOUR AUX CAS
        </a>

        <!-- Meta header -->
        <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-2 mono-caption text-[var(--color-ink-low)] mb-6 md:mb-8">
          {caseStudy.secteur && <span>{caseStudy.secteur.toUpperCase()}</span>}
          {caseStudy.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{caseStudy.tags.join(' · ').toUpperCase()}</span>
            </>
          )}
          {caseStudy.date && (
            <>
              <span aria-hidden="true">·</span>
              <span>{new Date(caseStudy.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' }).toUpperCase()}</span>
            </>
          )}
        </div>

        <!-- Title -->
        <div class="reveal mb-10 md:mb-12 bg-[var(--color-paper)] max-w-[64ch] py-2 pr-2 relative">
          <h1 class="font-display font-semibold text-[length:var(--text-display)] leading-[0.98] tracking-[-0.045em] text-[var(--color-ink)] m-0">
            {caseStudy.title}
          </h1>
        </div>

        <!-- KPIs row -->
        {caseStudy.kpis.length > 0 && (
          <div class="reveal grid grid-cols-1 sm:grid-cols-3 gap-px bg-[var(--color-divider)] border border-[var(--color-divider)] rounded-[var(--radius-md)] overflow-hidden max-w-3xl">
            {caseStudy.kpis.map((kpi: { value: string; label: string }) => (
              <div class="bg-[var(--color-paper)] p-5 md:p-6 flex flex-col gap-1.5">
                <div class="font-display font-semibold tabular-nums text-3xl md:text-4xl tracking-[-0.035em] text-[var(--color-ink)] leading-none">
                  {kpi.value}
                </div>
                <div class="mono-caption text-[var(--color-ink-low)]">{kpi.label}</div>
              </div>
            ))}
          </div>
        )}

      </div>
    </section>

    <!-- CONTEXTE / SOLUTION GRID -->
    <section
      data-section
      class="relative bg-[var(--color-surface-low)] py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-b border-[var(--color-divider)]"
    >
      <div class="relative max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-px bg-[var(--color-divider)] border border-[var(--color-divider)] rounded-[var(--radius-md)] overflow-hidden">

        {caseStudy.entreprise && (
          <article class="reveal bg-[var(--color-paper)] p-8 md:p-10 relative">
            <div class="mono-caption text-[var(--color-ink-low)] mb-4">01 · L'ENTREPRISE</div>
            <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body)] leading-[1.65] whitespace-pre-line max-w-[58ch]">
              {caseStudy.entreprise}
            </p>
          </article>
        )}

        {caseStudy.probleme && (
          <article class="reveal bg-[var(--color-paper)] p-8 md:p-10 relative">
            <div class="mono-caption text-[var(--color-ink-low)] mb-4">02 · LE PROBLÈME</div>
            <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body)] leading-[1.65] whitespace-pre-line max-w-[58ch]">
              {caseStudy.probleme}
            </p>
          </article>
        )}

      </div>
    </section>

    <!-- SOLUTION -->
    {caseStudy.solution && (
      <section data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
        <div class="relative max-w-[1200px] mx-auto">
          <div class="reveal mb-8 md:mb-10 inline-block bg-[var(--color-paper)] py-2 pr-2 relative">
            <div class="section-number" style="margin-bottom: 0.5rem;">03 · LA SOLUTION</div>
            <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[20ch]">
              Le workflow déployé.
            </h2>
          </div>

          <div class="reveal max-w-[64ch]">
            <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body-large)] leading-[1.6] whitespace-pre-line m-0">
              {caseStudy.solution}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- ÉTAPES -->
    {caseStudy.etapes && (
      <section
        data-section
        class="relative bg-[var(--color-surface-low)] py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-b border-[var(--color-divider)]"
      >
        <div class="relative max-w-[1200px] mx-auto">
          <div class="reveal mb-8 md:mb-10 inline-block bg-[var(--color-surface-low)] py-2 pr-2 relative">
            <div class="section-number" style="margin-bottom: 0.5rem;">04 · LES ÉTAPES</div>
            <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[22ch]">
              Comment c'est arrivé en prod.
            </h2>
          </div>

          <div class="reveal max-w-[64ch] card card-elevated bg-[var(--color-paper)] relative">
            <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body)] leading-[1.7] whitespace-pre-line m-0">
              {caseStudy.etapes}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- RÉSULTATS DÉTAILLÉS -->
    {caseStudy.resultatsDetails && (
      <section data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
        <div class="relative max-w-[1200px] mx-auto">
          <div class="reveal mb-8 md:mb-10 inline-block bg-[var(--color-paper)] py-2 pr-2 relative">
            <div class="section-number" style="margin-bottom: 0.5rem;">05 · LES RÉSULTATS</div>
            <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[22ch]">
              Ce qui a vraiment changé.
            </h2>
          </div>

          <div class="reveal max-w-[64ch]">
            <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body-large)] leading-[1.6] whitespace-pre-line m-0">
              {caseStudy.resultatsDetails}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- TÉMOIGNAGE + STACK -->
    {(caseStudy.testimonial?.quote || caseStudy.tools.length > 0) && (
      <section
        data-section
        class="relative bg-[var(--color-surface-low)] py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-b border-[var(--color-divider)]"
      >
        <div class="relative max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-start">

          {caseStudy.testimonial?.quote && (
            <blockquote class="reveal max-w-[60ch] m-0 p-0">
              <div class="mono-caption text-[var(--color-ink-low)] mb-4">06 · TÉMOIGNAGE</div>
              <p class="font-display font-semibold text-2xl md:text-3xl tracking-[-0.025em] text-[var(--color-ink)] leading-[1.25] m-0">
                « {caseStudy.testimonial.quote} »
              </p>
              {(caseStudy.testimonial.name || caseStudy.testimonial.role) && (
                <footer class="mono-caption text-[var(--color-ink-low)] mt-5 not-italic">
                  — {caseStudy.testimonial.name}
                  {caseStudy.testimonial.role && (
                    <span> · {caseStudy.testimonial.role}</span>
                  )}
                </footer>
              )}
            </blockquote>
          )}

          {caseStudy.tools.length > 0 && (
            <div class="reveal lg:max-w-[300px] w-full">
              <div class="mono-caption text-[var(--color-ink-low)] mb-4">STACK</div>
              <div class="flex flex-wrap gap-2">
                {caseStudy.tools.map((tool: string) => (
                  <span class={chipClass(tool)}>{tool}</span>
                ))}
              </div>
            </div>
          )}

        </div>
      </section>
    )}

    <!-- CTA -->
    <section data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal mb-8 md:mb-10 inline-block bg-[var(--color-paper)] py-2 pr-2 relative">
          <div class="section-number" style="margin-bottom: 0.5rem;">↦ APPEL</div>
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[22ch]">
            Un projet similaire ?
          </h2>
          <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 pt-3 max-w-[55ch]">
            20 min pour décider si on travaille ensemble. Sans engagement, réponse claire sous 48 h.
          </p>
        </div>

        <div class="reveal flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary justify-center"
          >
            Réserver maintenant
          </a>
          <a
            href="mailto:bonjour@liliansevoumian.fr"
            class="btn-ghost justify-center"
          >
            ou écrire un mail
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
