---
import Carnet from '../../layouts/Carnet.astro';
import Inscription from '../../components/blog/inscription.astro';
import { render } from 'astro:content';
import { articlesPublies, dateEnClair, espaces, iso, minutesDeLecture, type Article } from '../../lib/blog';

export async function getStaticPaths() {
  const articles = await articlesPublies();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
await render(article);
const a = article.data;

/* Le corps est lu tel qu'Astro l'a rendu, puis reçoit les espaces insécables
   du français, comme les cas clients. */
const HTML_RENDU: string = (article as unknown as { rendered?: { html?: string } }).rendered?.html ?? '';
const corps = espaces(HTML_RENDU);

const publie = iso(a.date);
const misAJour = a.updated ? iso(a.updated) : undefined;
const minutes = minutesDeLecture(article.body);
const url = `https://liliansevoumian.fr/blog/${article.id}`;

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: a.title, url: `/blog/${article.id}` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: a.title,
  description: a.description,
  author: { '@id': 'https://liliansevoumian.fr/#person' },
  publisher: { '@id': 'https://liliansevoumian.fr/#person' },
  image: 'https://liliansevoumian.fr/og-image.png',
  datePublished: publie,
  dateModified: misAJour ?? publie,
  inLanguage: 'fr-FR',
  isPartOf: { '@id': 'https://liliansevoumian.fr/blog#blog' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};
---

<Carnet
  title={`${a.title} · Lilian Sevoumian`}
  description={a.description}
  ogType="article"
  publishedDate={publie}
  modifiedDate={misAJour}
  articleSchema={articleSchema}
  breadcrumbs={breadcrumbs}
  noindex={a.draft}
>
  <article>
    <header class="billet__tete">
      <p class="billet__meta">
        <time datetime={publie}>{dateEnClair(a.date)}</time>
        <span aria-hidden="true"> · </span>{minutes}&nbsp;min de lecture
        {misAJour && a.updated && <><span aria-hidden="true"> · </span>mis à jour le <time datetime={misAJour}>{dateEnClair(a.updated)}</time></>}
      </p>
      <h1 class="billet__titre" set:html={espaces(a.title)} />
    </header>

    <div class="billet__corps" set:html={corps} />
  </article>

  <p class="billet__retour"><a href="/blog">← Tous les articles</a></p>

  <Inscription titre="Recevoir le prochain article par e-mail." />
</Carnet>

<style>
  .billet__meta {
    margin: 0;
    color: var(--carnet-gris);
    font-size: 0.9375rem;
    font-variant-numeric: oldstyle-nums;
  }

  .billet__titre {
    margin: 0.5rem 0 0;
    font-size: 2.75rem;
    font-style: italic;
    line-height: 1.2;
    text-wrap: balance;
  }

  .billet__corps {
    margin-top: 2.5rem;
    hanging-punctuation: first;
  }

  .billet__corps :global(p) {
    margin: 0 0 1.15em;
  }

  /* Les intertitres en petites capitales, comme dans un livre. */
  .billet__corps :global(h2) {
    margin: 2.4em 0 0.6em;
    font-size: 1.5rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.05em;
    line-height: 1.35;
  }

  .billet__corps :global(h3) {
    margin: 2em 0 0.5em;
    font-size: 1.1875rem;
    font-style: italic;
    font-weight: 400;
  }

  .billet__corps :global(:is(ul, ol)) {
    margin: 0 0 1.15em;
    padding-left: 1.4em;
  }

  .billet__corps :global(ul) {
    list-style: disc;
  }

  .billet__corps :global(ol) {
    list-style: decimal;
  }

  .billet__corps :global(li) {
    margin: 0 0 0.35em;
    padding-left: 0.2em;
  }

  .billet__corps :global(li::marker) {
    color: var(--carnet-gris);
  }

  .billet__corps :global(blockquote) {
    margin: 1.6em 0;
    padding: 0 0 0 1.2em;
    border-left: 1px solid var(--carnet-trait);
    color: var(--carnet-gris);
    font-style: italic;
  }

  .billet__corps :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .billet__corps :global(strong) {
    font-weight: 600;
  }

  .billet__corps :global(code) {
    padding: 0.05em 0.3em;
    border-radius: 3px;
    background: rgba(46, 34, 21, 0.08);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.85em;
  }

  .billet__corps :global(pre) {
    overflow-x: auto;
    margin: 1.6em 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--carnet-trait);
    border-radius: 3px;
    background: rgba(46, 34, 21, 0.05) !important;
    color: var(--carnet-encre) !important;
    font-size: 0.85em;
    line-height: 1.55;
  }

  .billet__corps :global(pre code) {
    padding: 0;
    background: none;
    font-size: inherit;
  }

  .billet__corps :global(pre span) {
    color: inherit !important;
  }

  .billet__corps :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2em 0;
  }

  .billet__corps :global(hr) {
    width: 4rem;
    margin: 2.5em auto;
  }

  .billet__retour {
    margin: 3rem 0 0;
    font-size: 1rem;
  }
</style>
