---
import Carnet from '../../layouts/Carnet.astro';
import Inscription from '../../components/blog/inscription.astro';
import { articlesPublies, dateEnClair, espaces, iso } from '../../lib/blog';

// Le blog : ce qui partait en newsletter, en public. Une phrase, la liste du
// plus récent au plus ancien, puis l'inscription. Rien d'autre.
const articles = (await articlesPublies()).map((article) => ({
  slug: article.id,
  titre: espaces(article.data.title),
  title: article.data.title,
  description: espaces(article.data.description),
  date: article.data.date,
  brouillon: article.data.draft,
}));

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Blog', url: '/blog' },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': 'https://liliansevoumian.fr/blog#blog',
  name: 'Le blog de Lilian Sevoumian',
  url: 'https://liliansevoumian.fr/blog',
  inLanguage: 'fr',
  author: { '@id': 'https://liliansevoumian.fr/#person' },
  blogPost: articles.map((article) => ({
    '@type': 'BlogPosting',
    headline: article.title,
    url: `https://liliansevoumian.fr/blog/${article.slug}`,
    datePublished: iso(article.date),
  })),
};
---

<Carnet
  title="Blog · Lilian Sevoumian"
  description="Des idées, des essais et ce que j’apprends en construisant. Ce qui partait en newsletter, publié en clair."
  breadcrumbs={breadcrumbs}
  articleSchema={collectionSchema}
>
  <h1 class="blog__titre">Blog</h1>
  <p class="blog__intro" set:html={espaces('Des idées, des essais, ce que j’apprends en construisant. Ce que j’aurais mis dans une newsletter, écrit ici pour tout le monde.')} />

  {articles.length === 0 ? (
    <p class="blog__vide">Le premier article arrive bientôt.</p>
  ) : (
    <ol class="blog__liste" role="list">
      {articles.map((article) => (
        <li class="blog__article">
          <time datetime={iso(article.date)} class="blog__date">{dateEnClair(article.date)}</time>
          {article.brouillon && <span class="blog__brouillon"> · brouillon</span>}
          <h2 class="blog__nom"><a href={`/blog/${article.slug}`} set:html={article.titre} /></h2>
          <p class="blog__resume" set:html={article.description} />
        </li>
      ))}
    </ol>
  )}

  <Inscription />
</Carnet>

<style>
  .blog__titre {
    margin: 0;
    font-size: 2.5rem;
    line-height: 1.15;
  }

  .blog__intro {
    margin: 1rem 0 0;
    color: var(--carnet-gris);
  }

  .blog__vide {
    margin: 3.5rem 0 0;
    color: var(--carnet-gris);
  }

  /* Une ligne par article, séparée par un filet. */
  .blog__liste {
    display: grid;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--carnet-trait);
  }

  .blog__article {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--carnet-trait);
  }

  .blog__date,
  .blog__brouillon {
    color: var(--carnet-accent-texte);
    font-weight: 500;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .blog__nom {
    margin: 0.3rem 0 0;
    font-size: 1.375rem;
    line-height: 1.3;
  }

  .blog__nom a {
    text-decoration-color: transparent;
  }

  .blog__nom a:hover {
    color: var(--carnet-encre);
    text-decoration-color: var(--carnet-accent);
  }

  .blog__resume {
    margin: 0.4rem 0 0;
    color: var(--carnet-gris);
  }

  @media (max-width: 30rem) {
    .blog__titre {
      font-size: 2rem;
    }
  }
</style>
