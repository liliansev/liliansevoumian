---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import TeteDePage from '../../components/tete-de-page.astro';
import Inscription from '../../components/blog/inscription.astro';
import { articlesPublies, dateEnClair, espaces, iso, minutesDeLecture } from '../../lib/blog';

// Le blog : ce qui partait en newsletter, en public. Une liste, du plus
// récent au plus ancien, puis l'inscription. Pas de bouton d'appel ici.
const articles = (await articlesPublies()).map((article) => ({
  slug: article.id,
  titre: espaces(article.data.title),
  title: article.data.title,
  description: espaces(article.data.description),
  date: article.data.date,
  brouillon: article.data.draft,
  minutes: minutesDeLecture(article.body),
}));

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Blog', url: '/blog' },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': 'https://liliansevoumian.fr/blog#blog',
  name: 'Le blog de Lilian Sevoumian',
  url: 'https://liliansevoumian.fr/blog',
  inLanguage: 'fr',
  author: { '@id': 'https://liliansevoumian.fr/#person' },
  blogPost: articles.map((article) => ({
    '@type': 'BlogPosting',
    headline: article.title,
    url: `https://liliansevoumian.fr/blog/${article.slug}`,
    datePublished: iso(article.date),
  })),
};
---

<Layout
  title="Blog · Lilian Sevoumian"
  description="Des idées, des essais et ce que j’apprends en construisant. Ce qui partait en newsletter, publié en clair."
  breadcrumbs={breadcrumbs}
  articleSchema={collectionSchema}
>
  <Navigation ctaSource="blog_index_nav" />

  <main id="main-content">
    <TeteDePage
      titre="Ce que je pense, <mark>en clair.</mark>"
      chapo="Des idées, des essais, ce que j’apprends en construisant. Ce que j’aurais mis dans une newsletter, publié ici pour tout le monde."
    />

    <section data-section class="px-[var(--spacing-section-x)] py-[var(--spacing-section-y)] border-b border-[var(--color-divider)]">
      <div class="mx-auto max-w-[1200px]">
        {articles.length === 0 ? (
          <p class="m-0 text-[length:var(--text-body-large)] text-[var(--color-ink-mid)]">
            Le premier article arrive bientôt. Inscrivez-vous juste en dessous pour le recevoir.
          </p>
        ) : (
          <ul class="articles" role="list">
            {articles.map((article) => (
              <li>
                <article class="article">
                  <p class="article__meta">
                    <time datetime={iso(article.date)}>{dateEnClair(article.date)}</time>
                    <span>{article.minutes}&nbsp;min de lecture</span>
                    {article.brouillon && <span class="article__brouillon">Brouillon</span>}
                  </p>
                  <h2 class="article__titre">
                    <a href={`/blog/${article.slug}`} class="article__lien">{article.titre}</a>
                  </h2>
                  <p class="article__resume">{article.description}</p>
                </article>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <Inscription />
  </main>

  <Footer />
</Layout>

<style>
  .articles {
    display: grid;
    row-gap: var(--spacing-bloc);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .articles > li {
    max-width: none;
  }

  .article {
    position: relative;
    max-width: 46rem;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .article__brouillon {
    color: var(--color-accent-text);
  }

  .article__titre {
    margin: var(--spacing-colle) 0 0;
    font-size: var(--text-title-lg);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .article__lien {
    color: inherit;
    text-decoration: none;
  }

  /* Toute la rangée se clique ; seul le titre est le nom du lien. */
  .article__lien::after {
    content: '';
    position: absolute;
    inset: -0.75rem;
    border-radius: var(--radius-md);
  }

  .article__resume {
    margin: var(--spacing-colle) 0 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  @media (hover: hover) and (pointer: fine) {
    .article:hover .article__lien {
      text-decoration: underline;
      text-decoration-color: var(--color-accent-text);
      text-underline-offset: 0.18em;
    }
  }

  @media (any-hover: hover), (any-pointer: fine) {
    .article__lien:focus-visible {
      outline: none;
    }

    .article__lien:focus-visible::after {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }
  }
</style>
