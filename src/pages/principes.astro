---
/*
 * /principes — manifesto numéroté, format scroll rapide.
 *
 * 8 principes opinionated sur l'automatisation no-code. La page
 * existe comme page-de-vérité : si on n'est pas alignés sur ces
 * principes, on ne devrait pas travailler ensemble.
 *
 * Ton volontairement direct. Pas de hedging. Format mono-caption
 * numéro + headline display + body court.
 */
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';

const principes = [
  {
    label: "L'IA NE REMPLACE PAS LES WORKFLOWS",
    headline: "L'IA classifie, écrit, qualifie. Les workflows exécutent.",
    body: "Le bon outil est l'enchainement des deux, pas l'un ou l'autre. Un agent IA sans workflow autour, c'est une démo. Un workflow sans IA quand le tri humain est massif, c'est de la sueur perdue.",
  },
  {
    label: "PAS DE MÉTHODE PROPRIÉTAIRE",
    headline: "Quatre étapes claires, pas un framework brandé à 12 phases.",
    body: "Les méthodologies à acronyme servent à justifier des honoraires, pas à livrer plus vite. Diagnostic, conception, mise en prod, transfert. C'est tout.",
  },
  {
    label: "LE MOINS D'OUTILS POSSIBLE",
    headline: "Un workflow qui passe par 8 outils finit par casser.",
    body: "Trois bien branchés tiennent 3 ans. Chaque intégration ajoutée multiplie les surfaces d'erreur (changement d'API, rate limits, déprécations). Si on peut faire avec un outil de moins, on le fait.",
  },
  {
    label: "DOCUMENTATION À LA LIVRAISON OU RIEN",
    headline: "Si tes équipes ne peuvent pas modifier le workflow sans moi, je n'ai pas fait mon job.",
    body: "Je livre une doc custom (pas une page README générique) qui explique la logique, les déclencheurs, les modifs courantes. Cible : ton équipe doit pouvoir ajouter un destinataire ou changer un filtre seule.",
  },
  {
    label: "LE ROI DOIT ÊTRE CHIFFRÉ AVANT LE DEVIS",
    headline: "Si je ne sais pas combien tu vas économiser, je ne sais pas combien te facturer.",
    body: "C'est exactement ce que la phase 1 (diagnostic 30 min) sert à valider. On compare l'estimation à ton coût réel actuel. Si le ROI ne tient pas, on ne fait pas le projet.",
  },
  {
    label: "PAS DE TEMPLATES, DU SUR-MESURE",
    headline: "Tes process ne ressemblent pas aux 50 autres clients.",
    body: "Les marketplaces de scenarios Make ou n8n templates sont utiles pour apprendre, pas pour livrer. Chaque workflow que je conçois part de tes vraies données, tes vrais outils, tes vrais bottlenecks.",
  },
  {
    label: "LA QUALITÉ SE VOIT APRÈS 6 MOIS",
    headline: "Pas le jour de la livraison.",
    body: "Un workflow qui tourne le jour J et qui casse à la première mise à jour d'API n'est pas livré, il est démo. C'est pour ça qu'il y a 30 j de SLA inclus, et que je laisse mon numéro pour le reste.",
  },
  {
    label: "SI JE NE SUIS PAS LE BON, JE LE DIS",
    headline: "Mieux que de prendre un projet que je ne sais pas livrer.",
    body: "Secteur trop spécialisé (santé, défense, certains régulés), contraintes que je ne maîtrise pas, équipe qui veut un internalisation rapide : je dis non et je redirige. Mon temps et le tien valent mieux qu'un mauvais match.",
  },
];
---

<Layout
  title="Principes — Lilian Sevoumian, expert no-code"
  description="Les 8 principes que je suis sur chaque mission d'automatisation. Si on n'est pas alignés, on ne devrait pas travailler ensemble."
>
  <Navigation />

  <main id="main-content">
    <section
      data-section
      class="relative pt-[80px] md:pt-[88px]"
    >
      <div class="relative max-w-[1200px] mx-auto px-[var(--spacing-section-x)] pt-12 md:pt-20 pb-[var(--spacing-section-y)]">

        <SectionHeader
          number="00"
          label="MANIFESTO"
          title="Ce que je crois sur l'automatisation no-code."
          body="Si on n'est pas alignés sur ces principes, on ne devrait pas travailler ensemble. Ils sont publics par exigence : tu sais à quoi t'attendre avant le call."
          titleMaxWidth="22ch"
          bodyMaxWidth="60ch"
        />

        <!-- Liste principes — chaque principe revendique sa cellule de grille (paper-island bordé) -->
        <ol class="reveal-stagger flex flex-col gap-4 md:gap-6 list-none m-0 p-0">
          {principes.map((p, i) => (
            <li class="reveal relative bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] p-6 md:p-8 grid grid-cols-1 md:grid-cols-[7rem_1fr] gap-x-6 gap-y-3">
              <span class="grid-corner tl" aria-hidden="true"></span>
              <span class="grid-corner tr" aria-hidden="true"></span>
              <span class="grid-corner bl" aria-hidden="true"></span>
              <span class="grid-corner br" aria-hidden="true"></span>

              <div class="flex flex-col gap-1">
                <span class="mono-caption text-[var(--color-violet)]">{String(i + 1).padStart(2, '0')}</span>
                <span class="mono-caption text-[var(--color-ink-low)]">{p.label}</span>
              </div>
              <div class="flex flex-col gap-3 max-w-[60ch]">
                <h2
                  class="font-display font-semibold text-[length:var(--text-title-lg)] tracking-[-0.025em] text-[var(--color-ink)] leading-[1.2] m-0"
                >
                  {p.headline}
                </h2>
                <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.55] m-0">
                  {p.body}
                </p>
              </div>
            </li>
          ))}
        </ol>

        <!-- CTA pied -->
        <div class="reveal mt-20 md:mt-24 pt-10 border-t border-[var(--color-divider)] flex flex-col gap-5 max-w-[640px]">
          <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.55] m-0">
            <span class="text-[var(--color-ink)]">Tu trouves ça aligné ?</span>
            Réservons un appel de cadrage de 30 min. On regarde un de tes process, je te dis ce qu'on peut automatiser et combien ça coûte.
          </p>
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary self-start"
          >
            Réserver un appel · 30 min
          </a>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>
