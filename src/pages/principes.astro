---
/*
 * /principes — huit principes sur l'automatisation, à lire d'une traite.
 *
 * La page existe comme page de vérité : si l'on n'est pas alignés sur ces
 * principes, mieux vaut le savoir avant de travailler ensemble. La méthode en
 * quatre étapes que PRODUCT.md promet est ici, et la barre y mène par l'entrée
 * « Méthode ».
 *
 * Ton direct, au vouvoiement comme le reste du site.
 *
 * C'est une page de lecture : chaque principe est une phrase qui se dit en
 * grand, puis ce qui la précise. Ni carte, ni filet, ni numéro (des principes
 * ne forment pas une séquence), ni sur-titre : la phrase est le titre.
 */
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import TeteDePage from '../components/tete-de-page.astro';
import FinDePage from '../components/fin-de-page.astro';
import { DUREE_RESERVATION_MINUTES } from '../lib/reservation';

const principes = [
  {
    titre: 'L’IA classifie, écrit, qualifie. Les workflows exécutent.',
    texte: 'Le bon outil, c’est l’enchaînement des deux. Ce que l’IA propose, le workflow le porte jusqu’au bout : la donnée écrite dans le bon outil, la relance envoyée, l’alerte remontée.',
  },
  {
    titre: 'Quatre étapes claires, du cadrage au transfert.',
    texte: 'Cadrage, conception, mise en production, transfert. Vous savez à chaque instant où en est le projet et ce qui vient ensuite.',
  },
  {
    titre: 'Un workflow qui passe par 8 outils finit par casser.',
    texte: 'Trois bien branchés tiennent 3 ans. Chaque intégration ajoutée multiplie les surfaces d’erreur (changement d’API, limites de débit, dépréciations). Si on peut faire avec un outil de moins, on le fait.',
  },
  {
    titre: 'Vos équipes doivent pouvoir modifier le workflow sans moi.',
    texte: 'Je livre une documentation écrite pour votre installation : la logique, les déclencheurs et les modifications courantes. Ajouter un destinataire, changer un filtre : votre équipe le fait seule.',
  },
  {
    titre: 'Je lance une automatisation quand elle vous fait gagner du temps.',
    texte: `On le regarde ensemble à l’appel de ${DUREE_RESERVATION_MINUTES} min : le temps que vous récupérez, face à ce que ce process vous coûte aujourd’hui. Le calcul décide.`,
  },
  {
    titre: 'Vos process ont leur propre logique.',
    texte: 'Chaque workflow que je conçois part de vos vraies données, de vos vrais outils, de vos vrais points de blocage. Le cadrage sert exactement à ça.',
  },
  {
    titre: 'Un workflow se juge après 6 mois en production.',
    texte: 'Chaque projet s’accompagne d’un abonnement mensuel pour l’hébergement, la maintenance et les petits ajustements de la solution livrée. Les nouveaux processus, agents et fonctionnalités sont chiffrés séparément.',
  },
  {
    titre: 'Je prends les projets que je sais livrer.',
    texte: `Secteur trop spécialisé (santé, défense, certains secteurs régulés), contraintes que je ne maîtrise pas, équipe qui vise une internalisation rapide : je vous le dis dès l’appel de ${DUREE_RESERVATION_MINUTES} min et je vous redirige.`,
  },
].map((p) => ({
  titre: p.titre.replace(/(\d) (outils|ans|mois)/g, '$1 $2'),
  texte: p.texte.replace(/ ([:;?!])/g, ' $1').replace(/(\d) (min|ans|mois)/g, '$1 $2'),
}));

/* Page indexée : elle a droit à son fil d'Ariane, comme /cas-clients et les
   pages de cas. Seules les mentions légales, en noindex, s'en passent. */
const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Principes', url: '/principes' },
];
---

<Layout
  breadcrumbs={breadcrumbs}
  title="Principes · Lilian Sevoumian, expert no-code"
  description="Les 8 principes que je suis sur chaque mission d’automatisation. Publics, pour savoir à quoi vous attendre avant le premier appel."
>
  <Navigation ctaSource="principes_nav" />

  <main id="main-content" tabindex="-1" class="outline-none">
    <TeteDePage
      titre="Ce que je crois sur l’automatisation <mark>no-code.</mark>"
      titreLargeur="18ch"
      chapo="On travaille bien ensemble quand on est alignés sur ces principes. Ils sont publics pour ça&nbsp;: vous savez à quoi vous attendre avant le premier appel."
    />

    <section data-section class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]">
      <ol class="principes mx-auto max-w-[1200px]">
        {principes.map((p) => (
          <li class="principe reveal">
            <h2>{p.titre}</h2>
            <p>{p.texte}</p>
          </li>
        ))}
      </ol>
    </section>

    <FinDePage
      source="principes_fin"
      titre="Vous trouvez ça <mark>aligné&nbsp;?</mark>"
      suite={'Décrivez-moi un de vos process en une phrase. Je vous réponds <span class="whitespace-nowrap">moi-même</span>, et on regarde ensemble ce qui s’automatise.'}
    />
  </main>

  <Footer />
</Layout>

<style>
  /* Une phrase qui se dit en grand, puis ce qui la précise : à gauche et à
     droite sur grand écran, l'une sous l'autre ailleurs. L'espace sépare les
     principes ; il n'y a ni cadre ni filet. */
  .principes {
    display: grid;
    gap: var(--spacing-bloc);
    margin-block: 0;
    padding: 0;
    list-style: none;
  }

  .principe {
    display: grid;
    gap: var(--spacing-lie);
  }

  .principe h2 {
    max-width: 22ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-phrase);
    line-height: var(--leading-phrase);
    letter-spacing: var(--tracking-phrase);
    text-wrap: balance;
  }

  .principe p {
    max-width: 40ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (min-width: 1024px) {
    .principe {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--spacing-gouttiere);
      align-items: start;
    }

    /* Le texte se cale sur la première ligne de la phrase. */
    .principe p {
      padding-top: 0.35em;
    }
  }
</style>
