---
/*
 * /principes — manifesto numéroté, format scroll rapide.
 *
 * 8 principes opinionated sur l'automatisation no-code. La page
 * existe comme page-de-vérité : si on n'est pas alignés sur ces
 * principes, on ne devrait pas travailler ensemble.
 *
 * Ton volontairement direct. Pas de hedging. Format mono-caption
 * numéro + headline display + body court.
 */
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';

const principes = [
  {
    label: "L'IA ET LES WORKFLOWS SE COMPLÈTENT",
    headline: "L'IA classifie, écrit, qualifie. Les workflows exécutent.",
    body: "Le bon outil, c'est l'enchaînement des deux. Ce que l'IA décide, le workflow le porte jusqu'au bout : la donnée écrite dans le bon outil, la relance envoyée, l'alerte remontée.",
  },
  {
    label: "UNE MÉTHODE EN QUATRE ÉTAPES",
    headline: "Quatre étapes claires, du cadrage au transfert.",
    body: "Cadrage, conception, mise en production, transfert. Tu sais à chaque instant où en est le projet et ce qui vient ensuite.",
  },
  {
    label: "LE MOINS D'OUTILS POSSIBLE",
    headline: "Un workflow qui passe par 8 outils finit par casser.",
    body: "Trois bien branchés tiennent 3 ans. Chaque intégration ajoutée multiplie les surfaces d'erreur (changement d'API, rate limits, déprécations). Si on peut faire avec un outil de moins, on le fait.",
  },
  {
    label: "DOCUMENTATION À LA LIVRAISON OU RIEN",
    headline: "Tes équipes doivent pouvoir modifier le workflow sans moi.",
    body: "Je livre une doc custom qui explique la logique, les déclencheurs et les modifications courantes. Ajouter un destinataire, changer un filtre : ton équipe le fait seule.",
  },
  {
    label: "LE GAIN DE TEMPS D'ABORD",
    headline: "Je lance une automatisation quand elle te fait gagner du temps.",
    body: "On le regarde ensemble au premier échange : le temps que tu récupères face à ce que ce process te coûte aujourd'hui en temps. Le calcul décide.",
  },
  {
    label: "DU SUR-MESURE, À CHAQUE FOIS",
    headline: "Tes process ont leur propre logique.",
    body: "Chaque workflow que je conçois part de tes vraies données, tes vrais outils, tes vrais bottlenecks. Le cadrage sert exactement à ça.",
  },
  {
    label: "LA QUALITÉ SE MESURE EN PRODUCTION",
    headline: "Un workflow se juge après 6 mois en production.",
    body: "Le vrai test, c'est la première mise à jour d'API. D’où les corrections incluses le mois qui suit la livraison, et mon numéro pour le reste.",
  },
  {
    label: "LE BON MATCH AVANT LE PROJET",
    headline: "Je prends les projets que je sais livrer.",
    body: "Secteur trop spécialisé (santé, défense, certains régulés), contraintes que je ne maîtrise pas, équipe qui vise une internalisation rapide : je te le dis au premier appel et je te redirige.",
  },
];

/* Page indexée : elle a droit à son fil d'Ariane, comme /cas-clients et les
   pages de cas. Seules les mentions légales, en noindex, s'en passent. */
const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Principes', url: '/principes' },
];
---

<Layout
  breadcrumbs={breadcrumbs}
  title="Principes · Lilian Sevoumian, expert no-code"
  description="Les 8 principes que je suis sur chaque mission d'automatisation. Publics, pour que tu saches à quoi t'attendre avant le call."
>
  <Navigation />

  <main id="main-content">
    <section
      data-section
      class="relative pt-[80px] md:pt-[88px] px-[var(--spacing-section-x)]"
    >
      <div class="relative max-w-[1200px] mx-auto pt-12 md:pt-20 pb-[var(--spacing-section-y)]">

        <SectionHeader
          as="h1"
          label="MANIFESTO"
          title="Ce que je crois sur l’automatisation <mark>no-code.</mark>"
          body="On travaille bien ensemble quand on est alignés sur ces principes. Ils sont publics pour ça : tu sais à quoi t'attendre avant le call."
          titleMaxWidth="22ch"
          bodyMaxWidth="60ch"
        />

        <!-- Liste principes — chaque principe revendique sa cellule de grille (paper-island bordé) -->
        <ol class="reveal-stagger flex flex-col gap-4 md:gap-6 list-none m-0 p-0">
          {principes.map((p, i) => (
            <li class="reveal relative bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] p-6 md:p-8 grid grid-cols-1 md:grid-cols-[7rem_1fr] gap-x-6 gap-y-3">

              <div class="flex flex-col gap-1">
                <span class="mono-caption text-[var(--color-accent-text)]">{String(i + 1).padStart(2, '0')}</span>
                <span class="mono-caption text-[var(--color-ink-low)]">{p.label}</span>
              </div>
              <div class="flex flex-col gap-3 max-w-[60ch]">
                <h2
                  class="font-display font-semibold text-[length:var(--text-title-lg)] tracking-[-0.025em] text-[var(--color-ink)] leading-[1.2] m-0"
                >
                  {p.headline}
                </h2>
                <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.55] m-0">
                  {p.body}
                </p>
              </div>
            </li>
          ))}
        </ol>

        <!-- CTA pied -->
        <div class="reveal bloc-lime mt-20 md:mt-24 p-8 md:p-10 flex flex-col gap-5">
          <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.55] m-0">
            <span class="text-[var(--color-ink)]">Tu trouves ça aligné ?</span>
            On regarde un de tes process ensemble, et je te dis ce qui s'automatise.
          </p>
          <a
            href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
            class="btn-primary w-full sm:w-auto sm:self-start"
            data-fast-goal="lead_call"
            data-fast-goal-source="principes"
          >
            Réserver mon diagnostic&nbsp;· 20&nbsp;min
          </a>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>
