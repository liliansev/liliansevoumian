---
/*
 * /principes — manifesto numéroté, format scroll rapide.
 *
 * 8 principes opinionated sur l'automatisation no-code. La page
 * existe comme page-de-vérité : si on n'est pas alignés sur ces
 * principes, on ne devrait pas travailler ensemble.
 *
 * Ton volontairement direct. Pas de hedging. Format mono-caption
 * numéro + headline display + body court.
 */
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';

const principes = [
  {
    label: "L'IA ET LES WORKFLOWS SE COMPLÈTENT",
    headline: "L'IA classifie, écrit, qualifie. Les workflows exécutent.",
    body: "Le bon outil, c'est l'enchainement des deux. Un agent IA sans workflow autour, c'est une démo. Un workflow sans IA quand le tri est massif et humain, c'est de la sueur perdue.",
  },
  {
    label: "UNE MÉTHODE EN QUATRE ÉTAPES",
    headline: "Quatre étapes claires, du cadrage au transfert.",
    body: "Les méthodologies à acronyme servent surtout à se donner un genre. Moi, je livre en quatre étapes : cadrage, conception, mise en prod, transfert. C'est tout.",
  },
  {
    label: "LE MOINS D'OUTILS POSSIBLE",
    headline: "Un workflow qui passe par 8 outils finit par casser.",
    body: "Trois bien branchés tiennent 3 ans. Chaque intégration ajoutée multiplie les surfaces d'erreur (changement d'API, rate limits, déprécations). Si on peut faire avec un outil de moins, on le fait.",
  },
  {
    label: "DOCUMENTATION À LA LIVRAISON OU RIEN",
    headline: "Si tes équipes ne peuvent pas modifier le workflow sans moi, je n'ai pas fait mon job.",
    body: "Je livre une doc custom qui explique la logique, les déclencheurs, les modifs courantes. Cible : ton équipe doit pouvoir ajouter un destinataire ou changer un filtre seule.",
  },
  {
    label: "SI TU N'Y GAGNES PAS, ON NE LE FAIT PAS",
    headline: "Une automatisation qui ne te fait pas gagner de temps, je ne la lance pas.",
    body: "On le regarde ensemble au premier échange : le temps que tu récupères face à ce que ça te coûte aujourd'hui en temps. Si le compte n'y est pas, on ne lance pas le projet.",
  },
  {
    label: "DU SUR-MESURE, À CHAQUE FOIS",
    headline: "Tes process ne ressemblent pas aux 50 autres clients.",
    body: "Les marketplaces de scénarios Make ou n8n sont bonnes pour apprendre. En mission, chaque workflow que je conçois part de tes vraies données, tes vrais outils, tes vrais bottlenecks.",
  },
  {
    label: "LA QUALITÉ SE VOIT APRÈS 6 MOIS",
    headline: "Elle se confirme après 6 mois en production.",
    body: "Un workflow qui tourne le jour J mais casse à la première mise à jour d'API, c'est une démo. D’où les corrections incluses le mois qui suit la livraison, et mon numéro pour le reste.",
  },
  {
    label: "LE BON MATCH AVANT LE PROJET",
    headline: "Mieux que de prendre un projet que je ne sais pas livrer.",
    body: "Secteur trop spécialisé (santé, défense, certains régulés), contraintes que je ne maîtrise pas, équipe qui veut un internalisation rapide : je dis non et je redirige. Mon temps et le tien valent mieux qu'un mauvais match.",
  },
];
---

<Layout
  title="Principes · Lilian Sevoumian, expert no-code"
  description="Les 8 principes que je suis sur chaque mission d'automatisation. Si on n'est pas alignés, on ne devrait pas travailler ensemble."
>
  <Navigation />

  <main id="main-content">
    <section
      data-section
      class="relative pt-[80px] md:pt-[88px] px-[var(--spacing-section-x)]"
    >
      <div class="relative max-w-[1200px] mx-auto pt-12 md:pt-20 pb-[var(--spacing-section-y)]">

        <SectionHeader
          as="h1"
          number="00"
          label="MANIFESTO"
          title="Ce que je crois sur l'automatisation no-code."
          body="Si on n'est pas alignés sur ces principes, on ne devrait pas travailler ensemble. Ils sont publics par exigence : tu sais à quoi t'attendre avant le call."
          titleMaxWidth="22ch"
          bodyMaxWidth="60ch"
        />

        <!-- Liste principes — chaque principe revendique sa cellule de grille (paper-island bordé) -->
        <ol class="reveal-stagger flex flex-col gap-4 md:gap-6 list-none m-0 p-0">
          {principes.map((p, i) => (
            <li class="reveal relative bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] p-6 md:p-8 grid grid-cols-1 md:grid-cols-[7rem_1fr] gap-x-6 gap-y-3">

              <div class="flex flex-col gap-1">
                <span class="mono-caption text-[var(--color-accent-text)]">{String(i + 1).padStart(2, '0')}</span>
                <span class="mono-caption text-[var(--color-ink-low)]">{p.label}</span>
              </div>
              <div class="flex flex-col gap-3 max-w-[60ch]">
                <h2
                  class="font-display font-semibold text-[length:var(--text-title-lg)] tracking-[-0.025em] text-[var(--color-ink)] leading-[1.2] m-0"
                >
                  {p.headline}
                </h2>
                <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.55] m-0">
                  {p.body}
                </p>
              </div>
            </li>
          ))}
        </ol>

        <!-- CTA pied -->
        <div class="reveal mt-20 md:mt-24 pt-10 border-t border-[var(--color-divider)] flex flex-col gap-5 max-w-[640px]">
          <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.55] m-0">
            <span class="text-[var(--color-ink)]">Tu trouves ça aligné ?</span>
            Dis-moi en deux lignes ton besoin. On regarde un de tes process, je te dis ce qu'on peut automatiser et combien ça coûte.
          </p>
          <a
            href="/#contact-form"
            class="btn-primary w-full sm:w-auto sm:self-start"
          >
            Me contacter
          </a>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>
