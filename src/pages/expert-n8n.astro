---
/*
 * /expert-n8n — landing SEO ciblée « expert n8n ».
 * Angle propre à n8n : self-hostable (RGPD / souveraineté), agents IA, code natif,
 * workflows versionnés. Contenu distinct de /expert-make (angles, cas d'usage et
 * FAQ différents — pas un doublon) ; la charpente est partagée : voir PageExpertOutil.
 */
import PageExpertOutil from '../layouts/PageExpertOutil.astro';
import { DUREE_RESERVATION_MINUTES } from '../lib/reservation';

// Ce que je fais avec n8n — props de valeur (angle n8n : self-host + IA + code).
const valeur = [
  {
    titre: 'Self-hostable : vos données restent chez vous',
    texte: "Hébergé sur vos serveurs quand vos données l'exigent : RGPD strict, santé, finance, secteurs sensibles. Aucune donnée ne transite par un tiers que vous ne contrôlez pas.",
  },
  {
    titre: 'Des agents IA branchés à vos process',
    texte: "n8n orchestre vos LLM (Claude, GPT, Mistral) au cœur du workflow : trier, qualifier, rédiger, classifier. L'IA décide, le workflow exécute, avec des garde-fous (validation, plafonds, reprise) à chaque étape.",
    ia: true,
  },
  {
    titre: 'Du code natif dans le workflow',
    texte: "Nœuds JavaScript/Python natifs, appels API sur-mesure, transformations de données complexes. Le traitement le plus fin reste dans le même outil que le déclencheur.",
  },
  {
    titre: 'Workflows versionnés, exportables en JSON',
    texte: "Chaque automatisation est versionnée et exportable : vous gardez la main sur votre logique métier. Couche d'erreur explicite (try/catch + alerte) sur chacune : une erreur remonte tout de suite.",
  },
];

// Ce qu'on peut automatiser avec n8n — cas d'usage (SEO + concret).
const casUsage = [
  'Pipelines de données lourds : enrichissement, déduplication, transformation',
  'Agents IA : tri, qualification de leads, rédaction, classification de demandes',
  'Synchroniser CRM et ERP avec une logique métier complexe',
  'Process soumis à la souveraineté des données (données sensibles, RGPD strict)',
  'Connecter vos LLM (Claude, GPT, Mistral) à vos outils internes',
  'Orchestrer plusieurs API avec reprise propre sur erreur',
];

const faqs = [
  {
    q: 'n8n ou Make, lequel choisir ?',
    a: "n8n quand vous avez des contraintes de souveraineté (self-hosting, RGPD strict, données sensibles), du volume de données important, ou besoin d'agents IA et de code sur-mesure. Make reste excellent pour des automatisations visuelles que votre équipe maintient seule, sur des outils SaaS courants. Je travaille les deux et je vous oriente.",
  },
  {
    q: 'Peut-on l’héberger sur nos propres serveurs ?',
    a: "Oui, c'est l'un des gros atouts de n8n. Je l'installe sur votre infrastructure (cloud privé ou serveur interne) pour que vos données restent chez vous. Idéal pour les secteurs réglementés et pour toute donnée que vous voulez garder en interne.",
  },
  {
    q: 'n8n peut-il vraiment faire tourner des agents IA ?',
    a: "Oui. n8n branche les LLM (Claude, GPT, Mistral) au sein même de vos workflows : l'agent IA classe, qualifie ou rédige, puis le workflow agit sur le résultat. J'ajoute systématiquement des garde-fous (validation, plafonds, reprise) pour que l'IA reste fiable en production, sous charge réelle.",
  },
  {
    q: 'Et si l’API d’un de mes outils change ?',
    a: "Chaque workflow inclut des alertes d’erreur et reste versionné en JSON exportable. Chaque projet s’accompagne d’un abonnement mensuel pour l’hébergement, la maintenance et les petits ajustements de l’existant. Les nouveaux processus, agents et fonctionnalités font l’objet d’un devis séparé.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  /* Un `@id` propre, rattaché à l'entité globale par `isPartOf` : sans lui, un
     moteur voit deux ProfessionalService sans savoir s'il s'agit de la même
     organisation. */
  "@id": "https://liliansevoumian.fr/expert-n8n#service",
  "isPartOf": { "@id": "https://liliansevoumian.fr/automatisations-ia#service" },
  "name": "Expert n8n freelance · Lilian Sevoumian",
  "description": "Expert n8n freelance : automatisation des processus, agents IA et workflows self-hosted (RGPD). Intégration, code natif et couche d'erreur sur chaque workflow.",
  "url": "https://liliansevoumian.fr/expert-n8n",
  "areaServed": "France",
  "serviceType": ["Automatisation n8n", "Agents IA", "Intégration n8n", "Self-hosting n8n", "Conseil no-code"],
  "knowsAbout": ["n8n", "Automatisation des processus", "Agents IA", "Self-hosting", "RGPD", "Intégration API", "Workflow", "Claude"],
  "provider": { "@id": "https://liliansevoumian.fr/#person" },
};

const stats = [
  { label: 'EN PRODUCTION', valeur: 'Depuis 2020' },
  { label: 'ARCHITECTURE', valeur: 'Self-hosted' },
  { label: 'APRÈS LIVRAISON', valeur: 'Corrections incluses' },
];
---

<PageExpertOutil
  outil="n8n"
  url="/expert-n8n"
  titreSeo="Expert n8n freelance · automatisation & agents IA | Lilian Sevoumian"
  descriptionSeo="Expert n8n freelance. J'automatise vos processus et déploie des agents IA, en self-hosted quand vos données l'exigent (RGPD). Workflows versionnés, réponse sous 48 h."
  serviceSchema={serviceSchema}
  icone="simple-icons:n8n"
  badge="EXPERT N8N · SELF-HOSTED & AGENTS IA"
  titreHtml="Expert <mark>n8n</mark> freelance."
  chapo="J'automatise vos processus et je déploie des agents IA avec n8n, hébergé chez vous quand vos données sont sensibles (RGPD), avec du code natif quand votre logique métier l'exige."
  titreValeur="Souveraineté, agents IA et code natif."
  valeur={valeur}
  titreCasUsage="Ce qu'on peut automatiser avec n8n."
  casUsage={casUsage}
  titrePourquoi="n8n, rodé en production."
  textePourquoi="J'automatise des process depuis 2020, pour des fondateurs, des dirigeants et des équipes ops. Self-hosting maîtrisé, agents IA avec garde-fous, couche d'erreur explicite sur chaque workflow. Des automatisations versionnées, qui tiennent dans le temps."
  stats={stats}
  titreFaq="Les questions qui reviennent sur n8n."
  faqs={faqs}
  lienCroise={{ question: 'PLUTÔT UN BESOIN Make ?', href: '/expert-make', libelle: 'VOIR LA PAGE EXPERT MAKE' }}
  titreCtaFinal="Un workflow n8n ou un agent IA en tête ?"
>
  <Fragment slot="preuves">
    <span class="text-[var(--color-accent-text)]">SELF-HOSTABLE</span> · <span class="text-[var(--color-accent-text)]">AGENTS IA</span> · 300+ PERSONNES FORMÉES · RÉPONSE SOUS 48&nbsp;H
  </Fragment>

  <Fragment slot="cta-texte">
    {DUREE_RESERVATION_MINUTES}&nbsp;min pour poser votre process à plat. Sans engagement. Votre scénario n8n existe déjà et il casse&nbsp;? <a class="lien-prose" href="/reprendre-une-automatisation-qui-casse">Je le reprends</a>.
  </Fragment>
</PageExpertOutil>
