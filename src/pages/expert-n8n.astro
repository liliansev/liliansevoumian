---
/*
 * /expert-n8n — la page « expert n8n ».
 * Angle propre à n8n : installé chez le client quand ses données l'exigent,
 * agents IA, code dans le flux, workflows versionnés. Le contenu est distinct
 * de /expert-make (angles, usages, cas et questions différents) ; la charpente
 * est partagée : voir PageExpertOutil.
 *
 * Les phrases des cas reprennent les chiffres des fiches de
 * `src/content/cas-clients` : en changer un là-bas, c'est le changer ici. Deux
 * réserves y sont écrites et doivent le rester : Humble+ est en phase de
 * stabilisation, et les chiffres de Celeris viennent de l'environnement de test.
 */
import PageExpertOutil from '../layouts/PageExpertOutil.astro';
import { reponseMakeOuN8n, reponseMakeOuN8nHtml } from '../data/make-ou-n8n';

const valeur = [
  {
    titre: 'Auto-hébergé : vos données restent chez vous',
    texte: 'n8n s’installe sur vos serveurs quand vos données l’exigent : RGPD strict, données sensibles. Aucune donnée ne transite par un tiers que vous ne contrôlez pas.',
  },
  {
    titre: 'Des agents IA branchés à vos process',
    texte: 'n8n orchestre vos modèles (Claude, GPT, Mistral) au cœur du workflow : trier, qualifier, rédiger, classer. L’IA lit et propose, le workflow contrôle et exécute, avec des garde-fous (validation, plafonds, reprise) à chaque étape.',
  },
  {
    titre: 'Du code dans le workflow',
    texte: 'Nœuds JavaScript et Python, appels API sur mesure, transformations de données complexes. Le traitement le plus fin reste dans le même outil que le déclencheur.',
  },
  {
    titre: 'Des workflows versionnés, exportables',
    texte: 'Chaque automatisation est versionnée et exportable en JSON : vous gardez la main sur votre logique métier. Une gestion d’erreur explicite, avec alerte, sur chacune : une erreur remonte tout de suite.',
  },
];

const casUsage = [
  'Enrichir, dédoublonner et transformer des données en volume',
  'Agents IA : tri, qualification de leads, rédaction, classement de demandes',
  'Synchroniser CRM et ERP avec une logique métier complexe',
  'Process dont les données doivent rester en interne (RGPD strict)',
  'Connecter vos modèles (Claude, GPT, Mistral) à vos outils internes',
  'Orchestrer plusieurs API avec reprise propre sur erreur',
];

const cas = [
  {
    nom: 'Humble+',
    href: '/cas-clients/humble-plus',
    texte: 'Chez Humble+, marque de compléments alimentaires, un workflow n8n de plus de 60 nœuds lit les bons de commande PDF et Excel, puis crée la commande Shopify et la facture Pennylane sans ressaisie ; sur le cas de référence, les totaux sont identiques au centime dans Slack, Shopify et Pennylane. Le projet est en phase de stabilisation.',
  },
  {
    nom: 'Celeris',
    href: '/cas-clients/celeris',
    texte: 'Chez Celeris, distributeur informatique B2B, deux agents IA sur n8n enrichissent le catalogue dans Odoo ; en test, plus de 60 % des produits sont appariés automatiquement (319 sur environ 515), pour 2 à 3 centimes par fiche générée.',
  },
];

const faqs = [
  {
    q: 'n8n ou Make, lequel choisir ?',
    a: reponseMakeOuN8n,
    html: reponseMakeOuN8nHtml,
  },
  {
    q: 'Peut-on l’héberger sur nos propres serveurs ?',
    a: 'Oui, c’est l’un des gros atouts de n8n. Je l’installe sur votre infrastructure (cloud privé ou serveur interne) pour que vos données restent chez vous. Utile pour toute donnée que vous voulez garder en interne.',
  },
  {
    q: 'n8n peut-il vraiment faire tourner des agents IA ?',
    a: 'Oui. n8n branche les modèles (Claude, GPT, Mistral) au sein même de vos workflows : l’agent IA classe, qualifie ou rédige, puis le workflow agit sur le résultat. J’ajoute systématiquement des garde-fous (validation, plafonds, reprise) pour que l’IA reste fiable en production, sous charge réelle.',
  },
  {
    q: 'Et si l’API d’un de mes outils change ?',
    a: 'Chaque workflow inclut des alertes d’erreur et reste versionné en JSON exportable. Chaque projet s’accompagne d’un abonnement mensuel pour l’hébergement, la maintenance et les petits ajustements de l’existant. Les nouveaux processus, agents et fonctionnalités font l’objet d’un devis séparé.',
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  /* Un `@id` propre, rattaché à l'entité globale par `isPartOf` : sans lui, un
     moteur voit deux ProfessionalService sans savoir s'il s'agit de la même
     organisation. */
  "@id": "https://liliansevoumian.fr/expert-n8n#service",
  "isPartOf": { "@id": "https://liliansevoumian.fr/automatisations-ia#service" },
  "name": "Expert n8n freelance · Lilian Sevoumian",
  "description": "Lilian Sevoumian, expert n8n freelance : automatisation des processus, agents IA et workflows auto-hébergés (RGPD). Intégration, code dans le flux et gestion d’erreur sur chaque workflow.",
  "url": "https://liliansevoumian.fr/expert-n8n",
  "areaServed": "France",
  "serviceType": ["Automatisation n8n", "Agents IA", "Intégration n8n", "Auto-hébergement n8n", "Conseil no-code"],
  "knowsAbout": ["n8n", "Automatisation des processus", "Agents IA", "Auto-hébergement", "RGPD", "Intégration API", "Workflow", "Claude"],
  "provider": { "@id": "https://liliansevoumian.fr/#person" },
};
---

<PageExpertOutil
  outil="n8n"
  url="/expert-n8n"
  titreSeo="Expert n8n freelance, agents IA · Lilian Sevoumian"
  descriptionSeo="Je construis vos workflows et vos agents IA sur n8n, installé chez vous quand vos données l’exigent. Deux cas publiés : Humble+ et Celeris."
  serviceSchema={serviceSchema}
  titreHtml="Expert <mark>n8n</mark> freelance."
  chapo="J’automatise vos processus et je déploie des agents IA avec n8n, installé chez vous quand vos données sont sensibles (RGPD), avec du code quand votre logique métier l’exige."
  preuves="Deux cas publiés, construits avec n8n : Humble+ et Celeris. Plus de 300 personnes formées à Make, à n8n et à l’IA."
  titreValeur="Vos données chez vous, des agents IA, du code."
  valeur={valeur}
  titreCasUsage="Ce qu’on peut automatiser avec n8n."
  casUsage={casUsage}
  lienCroise={{ href: '/expert-make', libelle: 'Plutôt un besoin Make ? La page expert Make' }}
  cas={cas}
  titrePourquoi="n8n, rodé en production."
  fichePourquoi="Lilian Sevoumian, freelance en automatisation et agents IA depuis septembre 2020 et premier Français certifié Make niveau 5 (2022), construit aussi sur n8n : les cas Celeris et Humble+, documentés sur ce site en 2026, ont été réalisés avec cet outil."
  textePourquoi="J’automatise des process depuis 2020, pour des fondateurs, des dirigeants et des équipes ops. Auto-hébergement maîtrisé, agents IA avec garde-fous, gestion d’erreur explicite sur chaque workflow. Des automatisations versionnées, qui tiennent dans le temps."
  titreFaq="Les questions qui reviennent sur n8n."
  faqs={faqs}
  titreFin="Un workflow n8n <mark>en tête ?</mark>"
  suiteFin={'Un agent IA aussi. Décrivez-le en une phrase, je vous réponds <span class="whitespace-nowrap">moi-même</span>. Votre workflow existe déjà et il casse ? <a class="lien-prose" href="/reprendre-une-automatisation-qui-casse">Je le reprends</a>.'}
/>
