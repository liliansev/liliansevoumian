---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import About from '../components/About.astro';
import Tools from '../components/Tools.astro';
import Services from '../components/Services.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Testimonials from '../components/Testimonials.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import ROICalculator from '../components/ROICalculator.tsx';

const faqSchema = [
  {
    question: "Comment se déroule une mission type ?",
    answer: "Tout commence par un appel de 30 minutes gratuit où on identifie vos process les plus chronophages. Sous 48h, je vous envoie un plan d'action détaillé avec livrables, délais et budget fixe. Pas de surprise : vous validez chaque étape avant que je passe à la suivante.",
  },
  {
    question: "Combien ça coûte et quel retour sur investissement attendre ?",
    answer: "Un premier workflow d'automatisation démarre à partir de 1 500 €. La plupart de mes clients constatent un ROI dès le premier mois : quand vous économisez 15h par semaine de travail manuel, le budget est amorti en quelques semaines. Je vous fournis une estimation du ROI dès le premier appel.",
  },
  {
    question: "Combien de temps faut-il pour voir des résultats ?",
    answer: "Un workflow simple est déployé en 3 à 5 jours. Un projet complet (diagnostic + plusieurs automatisations + formation) prend 4 à 8 semaines. Dans tous les cas, les premiers gains de temps sont visibles dès la première semaine de déploiement.",
  },
  {
    question: "Et si mes outils changent ou si j'ai besoin d'évolutions ?",
    answer: "Les automatisations sont construites de façon modulaire : ajouter un outil ou modifier un flux ne nécessite pas de tout reconstruire. Je forme vos équipes à faire les ajustements courants, et je reste disponible pour les évolutions majeures.",
  },
];

/*
 * =============================================
 * INFORMATION ARCHITECTURE — Pencil Design
 * =============================================
 *
 * Section order matches the Pencil design mockup:
 *
 *  1. Navigation
 *  2. Hero              (light bg-page)
 *  3. Problem           (dark bg-dark)
 *  4. Services          (light bg-page)
 *  5. CaseStudies       (white #FFFFFF)
 *  6. ROI Calculator    (dark bg-dark)
 *  7. Tools + About     (SAME dark section bg-dark)
 *  8. Testimonials      (light bg-page #F2F2F2)
 *  9. Process + FAQ     (SAME white #FFFFFF)
 * 10. CTA               (dark bg-dark)
 * 11. Footer            (dark)
 *
 * Removed: Manifeste, LogosBandeau
 *
 * =============================================
 */
---

<Layout faqSchema={faqSchema}>
  <Navigation />

  <main id="main-content">
    <!-- 1. Hero (light bg-page) -->
    <Hero />

    <!-- 2. Problem (dark bg-dark) -->
    <Problem />

    <!-- 3. Services (light bg-page) -->
    <Services />

    <!-- 4. Case Studies / Results (white #FFFFFF) -->
    <CaseStudies />

    <!-- 5. ROI Calculator (dark bg-dark) -->
    <ROICalculator client:visible />

    <!-- 6. Tools + About (SAME dark section bg-dark) -->
    <section class="relative bg-[#1A1A1A] py-[80px] px-[120px] max-md:px-[var(--spacing-section-x)] overflow-hidden">
      <div class="absolute inset-0 dot-grid-dark opacity-30" aria-hidden="true"></div>
      <div class="relative z-[1] max-w-[1200px] mx-auto flex flex-col items-center gap-[48px]">
        <Tools />
        <About />
      </div>
    </section>

    <!-- 7. Testimonials (light bg-page) -->
    <section id="temoignages" class="bg-[var(--color-bg-page)] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
      <div class="max-w-[1200px] mx-auto">
        <Testimonials />
      </div>
    </section>

    <!-- 8. Process + FAQ (SAME white #FFFFFF section) -->
    <section class="bg-white py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
      <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-20">
        <Process />
        <FAQ />
      </div>
    </section>

    <!-- 9. CTA (dark bg-dark) -->
    <CTA />
  </main>

  <Footer />
</Layout>
