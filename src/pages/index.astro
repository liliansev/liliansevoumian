---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HomeHero from '../components/home-hero.astro';
import HomeStory from '../components/home-story.astro';
import HomeTodayPath from '../components/home-today-path.astro';
import HomeServices from '../components/home-services.astro';
import HomeContent from '../components/home-content.astro';
import HomeVoices from '../components/home-voices.astro';
import Questions from '../components/questions.astro';
import FinDePage from '../components/fin-de-page.astro';
import HomeInvite from '../components/home-invite.astro';
import Footer from '../components/Footer.astro';
import { resume, resumeCourt } from '../data/parcours';
import { homeFaqs } from '../data/home-faq';

/* La barre nomme les quatre métiers, dans l'ordre de la page : avant même de
   défiler, on lit ce que fait Lilian. Chaque lien mène au bloc du métier, dans
   `home-services` (sur téléphone, il ouvre son onglet). Le troisième s'appelle
   « Dashboards et outils métiers » ; la barre garde le mot court. */
const homeNavigation = [
  { href: '#automatisation', label: 'Automatisation' },
  { href: '#agents-ia', label: 'Agents IA' },
  { href: '#dashboards', label: 'Dashboards' },
  { href: '#formations', label: 'Formations' },
];

/* La page d'accueil est la page de profil de Lilian : c'est elle qu'un moteur
   doit rattacher à l'entité `Person` déclarée par Layout.astro. */
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://liliansevoumian.fr/#home',
  name: 'Lilian Sevoumian · Freelance en automatisation et agents IA',
  description: resume,
  url: 'https://liliansevoumian.fr/',
  inLanguage: 'fr-FR',
  mainEntity: { '@id': 'https://liliansevoumian.fr/#person' },
};
---

<Layout
  title="Lilian Sevoumian · Freelance automatisation, agents IA, Make et n8n"
  description={resumeCourt}
  ogImage="/og-home.png"
  ogImageAlt="Lilian Sevoumian, expert en automatisations et agents IA : le titre de sa page d’accueil et les logos de ses clients"
  pageSchema={pageSchema}
  causerie={false}
  faqSchema={homeFaqs.map((item) => ({ question: item.q, answer: item.a }))}
>
  <Navigation
    links={homeNavigation}
    ctaSource="home_nav"
    trackHero={true}
  />

  <main id="main-content" tabindex="-1" class="outline-none">
    <HomeHero />
    {/* La barre où l'on écrit à Lilian : sous le titre, puis en bas à droite.
        Sans serveur : elle ouvre WhatsApp, la messagerie ou l'agenda avec le
        message déjà rédigé. Rendue ici, juste après le hero, pour venir au
        clavier là où on la voit (elle est positionnée hors du flux). */}
    <HomeInvite />
    <div class="accueil__suite">
      <HomeStory />
      <HomeServices />
      <HomeTodayPath />
      <HomeContent />
      <HomeVoices />
      <Questions />
      <FinDePage id="offres" source="home_offres" prix />
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  /*
   * La direction de l'accueil, validée par Lilian le 2 octobre 2026 : « tech
   * moderne, propre », sur une grille. Ces règles la tiennent d'un bout à
   * l'autre de la page, y compris dans les sections qui servent aussi à
   * d'autres pages et gardent là-bas leur ancienne allure.
   *
   *   le fond     la nuit la plus profonde, partout ;
   *   la grille   deux filets verticaux qui longent la colonne, du récit
   *               jusqu'aux offres ;
   *   les titres  une graisse moyenne : c'est la taille qui parle ;
   *   le souligné un trait pêche sous un fragment de titre ; la pastille
   *               pleine est le bouton d'appel.
   */
  /* Le fond, les titres, le soulignement, les boutons et les liens
     en bas de casse étaient réglés ici, pour l'accueil seul : ils sont
     maintenant la tenue de tout le site (voir « La tenue commune » dans
     `global.css`). Il ne reste ici que ce qui est propre à cette page. */
  .accueil__suite {
    --marge: var(--spacing-cadre);
    position: relative;
  }

  .accueil__suite::before,
  .accueil__suite::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 1px;
    background: color-mix(in srgb, var(--color-ink) 9%, transparent);
    pointer-events: none;
  }

  /* Le bord de la colonne de 1200 px, ou de la marge de page quand l'écran
     est plus étroit qu'elle. */
  .accueil__suite::before {
    left: calc(max(var(--spacing-section-x), (100% - 1200px) / 2) - var(--marge));
  }

  .accueil__suite::after {
    right: calc(max(var(--spacing-section-x), (100% - 1200px) / 2) - var(--marge));
  }

  @media (max-width: 1023px) {
    .accueil__suite::before,
    .accueil__suite::after {
      display: none;
    }
  }
</style>
