---
import Layout from '../layouts/Layout.astro';
import Entete from '../components/sobre/entete.astro';
import Ouverture from '../components/sobre/ouverture.astro';
import Services from '../components/sobre/services.astro';
import Clients from '../components/sobre/clients.astro';
import Projets from '../components/sobre/projets.astro';
import Terrain from '../components/sobre/terrain.astro';
import Avis from '../components/sobre/avis.astro';
import Contact from '../components/sobre/contact.astro';
import Pied from '../components/sobre/pied.astro';
import '../components/sobre/sobre.css';
import { resume, resumeCourt } from '../data/parcours';

/* L'accueil est « Entre les deux » depuis le 3 novembre 2026, choisi par
   Lilian parmi six directions : « super simple, super sobre, avec des typo
   un peu robot ». Le croisement d'une page de manuel claire et d'un
   afficheur : papier gris très clair, encre presque noire, Geist Mono
   partout, un seul bleu pour ce qui se clique. Une colonne de 900 px.

   C'est une page de marque : qui il est, ce qu'il fait, pour qui, des
   photos de terrain, ce qu'on en dit, et un formulaire pour lui écrire. Ni
   prix ni chiffres de prestation. Le premier geste est de s'abonner sur
   YouTube ; le seul appel est « Parlons de votre projet » (l'en-tête), qui
   mène au formulaire du bas (`sobre/contact.astro`). La grammaire est dans
   `components/sobre/sobre.css` ; le détail des choix dans DESIGN.md.

   Les accueils d'avant (« Le carnet », 27 octobre ; « Le documentaire »,
   14 octobre) restent dans `components/carnet/` et
   `components/documentaire/`, sans être rendus. */

/* La page d'accueil est la page de profil de Lilian : c'est elle qu'un moteur
   doit rattacher à l'entité `Person` déclarée par Layout.astro. */
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://liliansevoumian.fr/#home',
  name: 'Lilian Sevoumian · Freelance en automatisation et agents IA',
  description: resume,
  url: 'https://liliansevoumian.fr/',
  inLanguage: 'fr-FR',
  mainEntity: { '@id': 'https://liliansevoumian.fr/#person' },
};
---

<Layout
  title="Lilian Sevoumian · Automatisation, agents IA, Make et n8n"
  description={resumeCourt}
  ogImage="/og-carnet.png"
  ogImageAlt="Lilian Sevoumian, expert en automatisations et agents IA"
  pageSchema={pageSchema}
>
  <div class="carnet-ui">
    <Entete
      liens={[
        { href: '#services', label: 'services' },
        { href: '#projets', label: 'projets' },
        { href: '#avis', label: 'avis' },
        { href: '/blog', label: 'blog' },
        { href: '#ecrire', label: 'contact' },
      ]}
      source="home_nav"
      sourceMenu="home_menu"
      marqueHref="#main-content"
    />
    <main id="main-content" tabindex="-1" class="accueil">
      <Ouverture />
      <Services />
      <Clients />
      <Projets />
      <Terrain />
      <Avis />
      <Contact />
    </main>
    <Pied surAccueil source="home_pied" />
  </div>
</Layout>
