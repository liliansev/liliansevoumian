---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HomeHero from '../components/home-hero.astro';
import HomeStory from '../components/home-story.astro';
import HomeTodayPath from '../components/home-today-path.astro';
import HomeServices from '../components/home-services.astro';
import HomeContent from '../components/home-content.astro';
import HomeVoices from '../components/home-voices.astro';
import HomeOffers from '../components/home-offers.astro';
import Footer from '../components/Footer.astro';
import { resume, resumeCourt } from '../data/parcours';

/* La barre nomme les quatre métiers : avant même de défiler, on lit ce que
   fait Lilian. Chaque lien mène au bloc du métier, dans `home-services`. */
const homeNavigation = [
  { href: '#automatisation', label: 'Automatisation' },
  { href: '#agents-ia', label: 'Agents IA' },
  { href: '#formations', label: 'Formations' },
  { href: '#sites', label: 'Sites web et dashboards' },
];

/* La page d'accueil est la page de profil de Lilian : c'est elle qu'un moteur
   doit rattacher à l'entité `Person` déclarée par Layout.astro. */
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://liliansevoumian.fr/#home',
  name: 'Lilian Sevoumian · Automatisation, IA et formation',
  description: resume,
  url: 'https://liliansevoumian.fr/',
  inLanguage: 'fr-FR',
  mainEntity: { '@id': 'https://liliansevoumian.fr/#person' },
};
---

<Layout
  title="Lilian Sevoumian | Automatisation, IA, formations Make et n8n"
  description={resumeCourt}
  ogImage="/og-home.png"
  ogImageAlt="Lilian Sevoumian, expert en automatisations et agents IA : le titre de sa page d’accueil et les logos de ses clients"
  pageSchema={pageSchema}
>
  <Navigation
    links={homeNavigation}
    ctaSource="home_nav"
    trackHero={true}
  />

  <main id="main-content" tabindex="-1" class="accueil outline-none">
    <HomeHero />
    <div class="accueil__suite">
      <HomeStory />
      <HomeServices />
      <HomeTodayPath />
      <HomeContent />
      <HomeVoices />
      <HomeOffers />
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  /*
   * La direction de l'accueil, validée par Lilian le 2 octobre 2026 : « tech
   * moderne, propre », sur une grille. Ces règles la tiennent d'un bout à
   * l'autre de la page, y compris dans les sections qui servent aussi à
   * d'autres pages et gardent là-bas leur ancienne allure.
   *
   *   le fond     la nuit la plus profonde, partout ;
   *   la grille   deux filets verticaux qui longent la colonne, du récit
   *               jusqu'aux offres ;
   *   les titres  une graisse moyenne : c'est la taille qui parle ;
   *   le surligné une pastille pêche, droite et ronde, à la place de la
   *               bande penchée.
   */
  .accueil {
    --color-divider: color-mix(in srgb, var(--color-ink) 9%, transparent);
    background: var(--color-night-deep);
  }

  /* Le fond se règle sur la racine, pas sur `main` : la barre, le menu mobile,
     l'agenda en plein écran, la gouttière de défilement et le rebond d'iOS
     lisent tous `--color-paper`, et montraient le bleu du reste du site autour
     d'une page plus sombre. */
  html:has(.accueil) {
    --color-paper: var(--color-night-deep);
  }

  /* La maille de 96 px des gouttières appartient à l'ancienne tenue. Ici elle
     dessinait des fragments à cheval sur les deux lignes de cadre. */
  html:has(.accueil) .technical-grid {
    display: none;
  }

  /* Un seul traitement pour le texte qui se clique : bas de casse, comme la
     barre et les boutons. Les capitales espacées du lien fléché restent sur
     les autres pages. */
  .accueil .link-cta {
    font-size: var(--text-body-sm);
    letter-spacing: 0;
    text-transform: none;
  }

  /* Au survol, la même pastille que dans les titres : droite et ronde, qui se
     déroule de gauche à droite, à la place de la bande penchée. */
  .accueil .link-cta__label {
    margin-left: -0.5em;
    padding: 0.14em 0.5em 0.18em;
  }

  .accueil .link-cta__label::before {
    inset: 0;
    border-radius: 9999px;
    transform: none;
    clip-path: inset(0 100% 0 0 round 9999px);
    transition: clip-path var(--duration-default) var(--ease-out-quint);
  }

  .accueil .link-cta:hover .link-cta__label::before,
  .accueil .link-cta:focus-visible .link-cta__label::before {
    transform: none;
    clip-path: inset(0 0 0 0 round 9999px);
  }

  @media (prefers-reduced-motion: reduce) {
    .accueil .link-cta__label::before {
      transition: none;
    }
  }

  .accueil__suite {
    --marge: clamp(1rem, 2.2vw, 2rem);
    position: relative;
  }

  .accueil__suite::before,
  .accueil__suite::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 1px;
    background: color-mix(in srgb, var(--color-ink) 9%, transparent);
    pointer-events: none;
  }

  /* Le bord de la colonne de 1200 px, ou de la marge de page quand l'écran
     est plus étroit qu'elle. */
  .accueil__suite::before {
    left: calc(max(var(--spacing-section-x), (100% - 1200px) / 2) - var(--marge));
  }

  .accueil__suite::after {
    right: calc(max(var(--spacing-section-x), (100% - 1200px) / 2) - var(--marge));
  }

  @media (max-width: 1023px) {
    .accueil__suite::before,
    .accueil__suite::after {
      display: none;
    }
  }

  .accueil :is(h2, h3) {
    font-weight: 500;
  }

  .accueil mark {
    --angle: 0deg;
    --radius-bande: 9999px;
    display: inline-block;
    padding: 0.02em 0.36em 0.08em;
  }

  .accueil mark::before {
    inset: 0;
  }
</style>
