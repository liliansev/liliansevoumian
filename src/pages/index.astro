---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import AccueilPresentation from '../components/accueil-presentation.astro';
import AccueilProjets from '../components/accueil-projets.astro';
import AccueilExpertises from '../components/accueil-expertises.astro';
import AccueilParcours from '../components/accueil-parcours.astro';
import HomeContent from '../components/home-content.astro';
import HomeVoices from '../components/home-voices.astro';
import FinDePage from '../components/fin-de-page.astro';
import Footer from '../components/Footer.astro';
import { resume, resumeCourt } from '../data/parcours';
import { enCours, persos } from '../data/projets';

/* L'accueil est un site personnel depuis le 14 octobre 2026 (« on n'est pas
   assez site personnel, il y a trop d'animations ») : qui est Lilian, ce
   sur quoi il travaille, ce qu'il sait faire, ce qu'il publie, ce qu'il a
   construit pour lui, d'où il vient. Le récit animé (`home-story`), les
   scènes des métiers (`home-services`), la FAQ et la ligne des prix en sont
   sortis ; les fichiers restent.

   La barre nomme les sections de la page, dans leur ordre. */
const homeNavigation = [
  { href: '#en-ce-moment', label: 'En ce moment' },
  { href: '#expertises', label: 'Expertises' },
  { href: '#contenus', label: 'Vidéos' },
  { href: '#projets-perso', label: 'Projets perso' },
  { href: '#parcours', label: 'Parcours' },
  // Emplacement du lien Blog : il arrive avec la page /blog (fil du blog).
  // { href: '/blog', label: 'Blog' },
];

/* La page d'accueil est la page de profil de Lilian : c'est elle qu'un moteur
   doit rattacher à l'entité `Person` déclarée par Layout.astro. */
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://liliansevoumian.fr/#home',
  name: 'Lilian Sevoumian · Freelance en automatisation et agents IA',
  description: resume,
  url: 'https://liliansevoumian.fr/',
  inLanguage: 'fr-FR',
  mainEntity: { '@id': 'https://liliansevoumian.fr/#person' },
};
---

<Layout
  title="Lilian Sevoumian · Automatisation, agents IA, Make et n8n"
  description={resumeCourt}
  ogImage="/og-home.png"
  ogImageAlt="Lilian Sevoumian, expert en automatisations et agents IA"
  pageSchema={pageSchema}
>
  <Navigation
    links={homeNavigation}
    ctaSource="home_nav"
    trackHero={true}
  />

  <main id="main-content" tabindex="-1" class="outline-none">
    <AccueilPresentation />
    <div class="accueil__suite">
      <AccueilProjets
        id="en-ce-moment"
        titre="En ce moment."
        chapo="Ce sur quoi je travaille cette saison."
        projets={enCours}
        source="home_en_cours"
      />
      <AccueilExpertises />
      <HomeContent />
      <AccueilProjets
        id="projets-perso"
        titre="Mes projets perso."
        chapo="Ce que je construis pour moi, sans client ni cahier des charges."
        projets={persos}
        source="home_projets_perso"
      />
      <AccueilParcours />
      <HomeVoices />
      {/* Emplacement du contact : le fil du formulaire de contact le remplace
          par un formulaire simple (e-mail et message). En attendant, la fin
          de page habituelle, sans la ligne des prix. */}
      <FinDePage id="contact" source="home_offres" titre="Un projet, une idée, une <mark>question&nbsp;?</mark>" />
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  /*
   * La direction de l'accueil, validée par Lilian le 2 octobre 2026 : « tech
   * moderne, propre », sur une grille. Ces règles la tiennent d'un bout à
   * l'autre de la page, y compris dans les sections qui servent aussi à
   * d'autres pages et gardent là-bas leur ancienne allure.
   *
   *   le fond     la nuit la plus profonde, partout ;
   *   la grille   deux filets verticaux qui longent la colonne, du récit
   *               jusqu'aux offres ;
   *   les titres  une graisse moyenne : c'est la taille qui parle ;
   *   le souligné un trait pêche sous un fragment de titre ; la pastille
   *               pleine est le bouton d'appel.
   */
  /* Le fond, les titres, le soulignement, les boutons et les liens
     en bas de casse étaient réglés ici, pour l'accueil seul : ils sont
     maintenant la tenue de tout le site (voir « La tenue commune » dans
     `global.css`). Il ne reste ici que ce qui est propre à cette page. */
  .accueil__suite {
    --marge: var(--spacing-cadre);
    position: relative;
  }

  .accueil__suite::before,
  .accueil__suite::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 1px;
    background: color-mix(in srgb, var(--color-ink) 9%, transparent);
    pointer-events: none;
  }

  /* Le bord de la colonne de 1200 px, ou de la marge de page quand l'écran
     est plus étroit qu'elle. */
  .accueil__suite::before {
    left: calc(max(var(--spacing-section-x), (100% - 1200px) / 2) - var(--marge));
  }

  .accueil__suite::after {
    right: calc(max(var(--spacing-section-x), (100% - 1200px) / 2) - var(--marge));
  }

  @media (max-width: 1023px) {
    .accueil__suite::before,
    .accueil__suite::after {
      display: none;
    }
  }
</style>
