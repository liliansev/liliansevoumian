---
import Layout from '../layouts/Layout.astro';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource/gochi-hand/latin-400.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '../components/carnet/carnet.css';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import Chemin from '../components/carnet/chemin.astro';
import Barre from '../components/carnet/barre.astro';
import Ouverture from '../components/carnet/ouverture.astro';
import Defile from '../components/carnet/defile.astro';
import Suivre from '../components/carnet/suivre.astro';
import Adore from '../components/carnet/adore.astro';
import Methode from '../components/carnet/methode.astro';
import Coulisses from '../components/carnet/coulisses.astro';
import Avis from '../components/carnet/avis.astro';
import Contact from '../components/carnet/contact.astro';
import Pied from '../components/carnet/pied.astro';
import { resume, resumeCourt } from '../data/parcours';

/* L'accueil est « Le carnet » depuis le 27 octobre 2026, choisi par Lilian
   après plusieurs pistes écartées : le carnet d'un ingénieur un peu bricolé,
   papier quadrillé, encre, couleurs vives, notes à la main, inspiré dans
   l'esprit (pas dans la forme) de wisprflow.ai et de gemeosagency.com. C'est
   une page de marque : qui il est, où le suivre, ce qu'il adore faire,
   comment il travaille, et un formulaire pour lui écrire. Ni prix ni
   chiffres de prestation.

   La page se lit comme un scénario Make : chaque section s'ouvre sur un
   module rond et coloré, numéroté, et un chemin de pointillés les relie
   (`components/carnet/chemin.astro`). La grammaire est dans
   `components/carnet/carnet.css`, rangée sous `.accueil-carnet` : les autres pages
   gardent la tenue « nuit et pêche » tant qu'elles n'ont pas été passées au
   carnet. Le détail des choix est dans PRODUCT.md.

   Le premier geste est de s'abonner sur YouTube ; le contact suit, et tous
   les « Écrire » de la page mènent au formulaire du bas (`contact.astro`). */

/* La page d'accueil est la page de profil de Lilian : c'est elle qu'un moteur
   doit rattacher à l'entité `Person` déclarée par Layout.astro. */
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://liliansevoumian.fr/#home',
  name: 'Lilian Sevoumian · Freelance en automatisation et agents IA',
  description: resume,
  url: 'https://liliansevoumian.fr/',
  inLanguage: 'fr-FR',
  mainEntity: { '@id': 'https://liliansevoumian.fr/#person' },
};
---

<Layout
  title="Lilian Sevoumian · Automatisation, agents IA, Make et n8n"
  description={resumeCourt}
  ogImage="/og-home.png"
  ogImageAlt="Lilian Sevoumian, expert en automatisations et agents IA"
  pageSchema={pageSchema}
  themeColor="#f6f2e8"
  policePrechargee={bricolageLatin}
>
  <div class="accueil-carnet">
    <Chemin />
    <Barre />
    <main id="main-content" tabindex="-1">
      <Ouverture />
      <Defile />
      <Suivre />
      <Adore />
      <Methode />
      <Coulisses />
      <Avis />
      <Contact />
    </main>
    <Pied />
  </div>
</Layout>
