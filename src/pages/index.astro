---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HomeHeroPersonal from '../components/HomeHeroPersonal.astro';
import HomeAbout from '../components/HomeAbout.astro';
import HomeServices from '../components/HomeServices.astro';
import HomeAudience from '../components/HomeAudience.astro';
import HomeContent from '../components/home-content.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { homeFaqs } from '../data/home-faq';
const homeNavigation = [
  { href: '#services', label: 'Expertises' },
  { href: '/cas-clients', label: 'Réalisations' },
  { href: '#contenus', label: 'Contenus' },
];

const directionContract = `
THESIS: Lilian apparaît avant les offres ; une preuve compacte rend le choix crédible, puis deux chemins égaux orientent sans transformer le hero en comparateur.
OWN-WORLD: Papier blanc, encre noire et lime en surface ; photo franche, filets de 1 px, Geist, angles droits et aucun décor de substitution.
STORY: Le visiteur peut réserver directement, vérifier la légitimité de Lilian ou explorer les deux expertises avant de prendre contact.
FIRST VIEWPORT: Un titre direct occupe la gauche, un portrait carré et sa légende la droite ; un unique bouton de réservation reste dans l'en-tête fixe, le lien du hero mène aux services.
FORM: Manifeste personnel suivi d'un routeur de services, structure explicitement choisie par l'utilisateur dans le monde visuel établi.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
`.trim();

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://liliansevoumian.fr/#home',
  name: 'Freelance automatisation, IA et sites web · Lilian Sevoumian',
  description:
    'Lilian Sevoumian automatise les opérations, construit des agents IA, des outils métier et des sites web.',
  url: 'https://liliansevoumian.fr/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: { '@id': 'https://liliansevoumian.fr/automatisations-ia#service' },
      },
      {
        '@type': 'ListItem',
        position: 2,
        item: { '@id': 'https://liliansevoumian.fr/sites-web-abonnement#service' },
      },
    ],
  },
};

const faqSchema = homeFaqs.map((faq) => ({ question: faq.q, answer: faq.a }));
---

<Layout
  title="Freelance automatisation, IA et sites web | Lilian Sevoumian"
  description="Redonnez du temps à vos équipes avec des agents IA, des automatisations et des applications métier. Lilian Sevoumian : création et suivi mensuel de vos outils et sites."
  ogImage="/og-home.png"
  ogImageAlt="Lilian Sevoumian, freelance en automatisation, IA et création de sites web"
  pageSchema={pageSchema}
  faqSchema={faqSchema}
  directionContract={directionContract}
>
  <Navigation
    links={homeNavigation}
    ctaSource="home_nav"
    trackHero={true}
  />

  <main id="main-content" tabindex="-1" class="outline-none">
    <HomeHeroPersonal />
    <HomeAbout />
    <HomeServices />
    <HomeAudience />
    <HomeContent />
    <FAQ
      items={homeFaqs}
      title="Avant de travailler ensemble."
      body=""
      showTrainingLink={false}
    />
  </main>

  <Footer />
</Layout>
