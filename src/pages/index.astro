---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HeroManifesto from '../components/HeroManifesto.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Testimonials from '../components/Testimonials.astro';
import Stack from '../components/Stack.astro';
import Offres from '../components/Offres.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import ROICalculator from '../components/ROICalculator.astro';
import MobileCTABar from '../components/MobileCTABar.astro';
import { faqs } from '../data/faq';

const faqSchema = faqs.map((f) => ({ question: f.q, answer: f.a }));
---

<Layout faqSchema={faqSchema}>
  <Navigation />

  <main id="main-content" tabindex="-1" class="outline-none">
    <HeroManifesto />
    <LogoMarquee />
    <CaseStudy />
    <Testimonials />
    <ROICalculator />
    <Stack />
    <Offres />
    <FAQ />
    <CTA />
  </main>

  <Footer />
  <MobileCTABar />
</Layout>
