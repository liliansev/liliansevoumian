---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HeroManifesto from '../components/HeroManifesto.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Stack from '../components/Stack.astro';
import Offres from '../components/Offres.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import ROICalculator from '../components/ROICalculator.astro';

const faqSchema = [
  { question: "Quel ROI réel ?", answer: "Mes clients récupèrent en moyenne 12 à 20 h par semaine après déploiement. À 50 € de coût horaire interne, un workflow à 1 500 € se rembourse en moins de deux semaines. Sur une mission complète à 15 000 €, le ROI est positif à partir du 4e mois." },
  { question: "Et si l'API d'un de mes outils change ?", answer: "Tous mes workflows incluent une couche d'erreur explicite (try/catch + Slack alert) et sont versionnés en JSON exportable. Pendant les 30 j de SLA, je corrige sans surcoût." },
  { question: "Mes équipes ont-elles besoin de skills tech ?", answer: "Non. Les automatisations tournent en arrière-plan. À la livraison, je forme vos équipes aux ajustements courants via une documentation custom + 1 session live." },
  { question: "Make ou n8n ? Lequel et pourquoi ?", answer: "Make est plus rapide à apprendre, plus visuel. n8n est self-hostable, plus puissant pour le data-heavy ou les contraintes de souveraineté. Je propose celui qui fait sens pour vous." },
  { question: "Remote ou sur site ?", answer: "100 % remote sur les missions courtes. Pour les missions complètes, 1 ou 2 jours sur site en kick-off + en formation, le reste en remote. Basé Paris." },
  { question: "Comment je suis sûr que vous comprenez mon métier ?", answer: "C'est exactement ce que la phase 1 (diagnostic 20 min) sert à valider. Si je ne suis pas le bon, je le dis et je vous oriente." },
];
---

<Layout faqSchema={faqSchema}>
  <Navigation />

  <main id="main-content">
    <HeroManifesto />
    <ROICalculator />
    <CaseStudy />
    <Stack />
    <Offres />
    <FAQ />
    <CTA />
  </main>

  <Footer />
</Layout>
