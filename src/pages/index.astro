---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HomeDualServices from '../components/HomeDualServices.astro';
import HomeProofs from '../components/HomeProofs.astro';
import HomeVibeCoding from '../components/HomeVibeCoding.astro';
import HomeAbout from '../components/HomeAbout.astro';
import HomeContact from '../components/HomeContact.astro';
import Footer from '../components/Footer.astro';

const navLinks = [
  { href: '#preuves', label: 'Réalisations' },
  { href: '#methode', label: 'Vibe coding' },
  { href: '#a-propos', label: 'À propos' },
];

const directionContract = `
THESIS: Deux expertises entrent ensemble ; la home oriente au lieu d’empiler tous les services dans une landing unique.
OWN-WORLD: Papier, encre et lime en aplats francs ; deux surfaces égales, filets de 1 px, Geist, angles droits et schémas code-native.
STORY: Le visiteur choisit Automatisation & IA ou Sites web, voit une preuve de chaque pratique, comprend le rôle du vibe coding, puis contacte Lilian.
FIRST VIEWPORT: Sous la navigation, un diptyque strict 50/50 remplit l’écran : lime à gauche, papier à droite, mêmes titres, densité, mini-systèmes et actions.
FORM: Double manifeste, structure classée 6, seed be36f72f, comp approuvée home-double-manifeste.webp.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
`.trim();

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://liliansevoumian.fr/#home',
  name: 'Automatisation, IA et sites web par Lilian Sevoumian',
  description:
    'Deux expertises : automatisation et agents IA, ou création et amélioration de sites web.',
  url: 'https://liliansevoumian.fr/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: { '@id': 'https://liliansevoumian.fr/automatisations-ia#service' },
      },
      {
        '@type': 'ListItem',
        position: 2,
        item: { '@id': 'https://liliansevoumian.fr/sites-web-abonnement#service' },
      },
    ],
  },
};
---

<Layout
  title="Automatisation, IA et sites web | Lilian Sevoumian"
  description="J’automatise vos opérations, je construis des agents IA et je conçois des sites web qui continuent d’évoluer après leur mise en ligne."
  ogImage="/og-home.png"
  ogImageAlt="Automatisation, intelligence artificielle et sites web par Lilian Sevoumian"
  pageSchema={pageSchema}
  directionContract={directionContract}
>
  <Navigation
    links={navLinks}
    ctaLabel="Parler de mon projet"
    ctaSource="home_nav"
    trackHero={true}
  />

  <main id="main-content" tabindex="-1" class="outline-none">
    <HomeDualServices />
    <HomeProofs />
    <HomeVibeCoding />
    <HomeAbout />
    <HomeContact />
  </main>

  <Footer />
</Layout>
