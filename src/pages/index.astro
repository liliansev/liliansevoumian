---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HomeInvite from '../components/home-invite.astro';
import Footer from '../components/Footer.astro';
import Ouverture from '../components/documentaire/ouverture.astro';
import Portrait from '../components/documentaire/portrait.astro';
import EnCeMoment from '../components/documentaire/en-ce-moment.astro';
import Publications from '../components/documentaire/publications.astro';
import Filmographie from '../components/documentaire/filmographie.astro';
import Expertises from '../components/documentaire/expertises.astro';
import Voix from '../components/documentaire/voix.astro';
import Fin from '../components/documentaire/fin.astro';
import BarreChapitres from '../components/documentaire/barre-chapitres.astro';
import '../components/documentaire/documentaire.css';
import { resume, resumeCourt } from '../data/parcours';

/* L'accueil est un site personnel depuis le 14 octobre 2026. Le même jour,
   Lilian a écarté deux versions (des cartes sobres, puis le retour à la DA
   d'avant) et choisi « Le documentaire » : la page se lit comme un court
   documentaire sur lui au travail, en chapitres, avec des photos en grand
   légendées comme dans un reportage. La grammaire commune est dans
   `components/documentaire/documentaire.css`.

   Les chapitres, dans l'ordre : il se présente, ce qu'il construit, ce qu'il
   sait faire (les quatre scènes des métiers, en une séquence), ce qu'il
   publie, ce qu'il a construit pour ses clients (sa filmographie, lue dans les
   cas clients ; ses projets perso en sont sortis le 14 octobre 2026, à sa
   demande), ce qu'en disent ceux qui ont travaillé avec lui, et la fin, où
   on lui écrit (le générique de fin en est sorti le 14 octobre 2026, à sa
   demande). La barre des chapitres (`barre-chapitres.astro`) reprend la même
   liste. Le pied de page y perd sa date (`sansDate`).

   La barre de navigation nomme les chapitres, dans leur ordre. */
const homeNavigation = [
  { href: '#a-propos', label: 'À propos' },
  { href: '#en-ce-moment', label: 'En ce moment' },
  { href: '#services', label: 'Expertises' },
  { href: '#contenus', label: 'Vidéos' },
  { href: '#projets', label: 'Projets clients' },
  // Emplacement du lien Blog : il arrive avec la page /blog (fil du blog).
  // { href: '/blog', label: 'Blog' },
];

/* Les chapitres de la barre de lecture : l'ancre et le nom court de chacun.
   Chaque section porte le même nom dans `data-chapitre`. */
const chapitres = [
  { id: 'hero', nom: 'Au bureau' },
  { id: 'a-propos', nom: 'Portrait' },
  { id: 'en-ce-moment', nom: 'En ce moment' },
  { id: 'services', nom: 'Expertises' },
  { id: 'contenus', nom: 'Vidéos' },
  { id: 'projets', nom: 'Projets clients' },
  { id: 'temoignages', nom: 'Ils en parlent' },
  { id: 'fin', nom: 'Contact' },
];

/* La page d'accueil est la page de profil de Lilian : c'est elle qu'un moteur
   doit rattacher à l'entité `Person` déclarée par Layout.astro. */
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://liliansevoumian.fr/#home',
  name: 'Lilian Sevoumian · Freelance en automatisation et agents IA',
  description: resume,
  url: 'https://liliansevoumian.fr/',
  inLanguage: 'fr-FR',
  mainEntity: { '@id': 'https://liliansevoumian.fr/#person' },
};
---

<Layout
  title="Lilian Sevoumian · Automatisation, agents IA, Make et n8n"
  description={resumeCourt}
  ogImage="/og-home.png"
  ogImageAlt="Lilian Sevoumian, expert en automatisations et agents IA"
  pageSchema={pageSchema}
  causerie={false}
>
  <Navigation
    links={homeNavigation}
    ctaSource="home_nav"
    trackHero={true}
  />

  <main id="main-content" tabindex="-1" class="film outline-none">
    <Ouverture />
    {/* La barre où l'on écrit à Lilian, posée sous le titre (voir l'ouverture). */}
    <HomeInvite />
    <Portrait />
    <EnCeMoment />
    <Expertises />
    <Publications />
    <Filmographie />
    <Voix />
    {/* Le contact : la fin de page commune. Le fil du formulaire de contact
        simple la remplacera. */}
    <Fin />
  </main>

  <BarreChapitres chapitres={chapitres} />
  <Footer sansDate />
</Layout>
