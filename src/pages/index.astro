---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import ExpertiseCards from '../components/ExpertiseCards.astro';
import Parcours from '../components/Parcours.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import TrustLogos from '../components/TrustLogos.astro';
import ToolsCarousel from '../components/ToolsCarousel.astro';
---

<Layout>
  <Navigation />

  <main id="main-content">
    <Hero />
    <TrustLogos />
    <ExpertiseCards />
    <ToolsCarousel />
    <Parcours />
    <Pricing />
    <Testimonials />
    <CTA />
  </main>

  <Footer />
</Layout>
