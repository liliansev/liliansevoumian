---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Manifeste from '../components/Manifeste.astro';
import Problem from '../components/Problem.astro';
import About from '../components/About.astro';
import Tools from '../components/Tools.astro';
import Services from '../components/Services.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Testimonials from '../components/Testimonials.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const faqSchema = [
  {
    question: "Comment se déroule une mission type ?",
    answer: "Tout commence par un appel de 30 minutes gratuit où on identifie vos process les plus chronophages. Sous 48h, je vous envoie un plan d'action détaillé avec livrables, délais et budget fixe. Pas de surprise : vous validez chaque étape avant que je passe à la suivante.",
  },
  {
    question: "Combien ça coûte et quel retour sur investissement attendre ?",
    answer: "Un premier workflow d'automatisation démarre à partir de 1 500 €. La plupart de mes clients constatent un ROI dès le premier mois : quand vous économisez 15h par semaine de travail manuel, le budget est amorti en quelques semaines. Je vous fournis une estimation du ROI dès l'audit.",
  },
  {
    question: "Combien de temps faut-il pour voir des résultats ?",
    answer: "Un workflow simple est déployé en 3 à 5 jours. Un projet complet (audit + plusieurs automatisations + formation) prend 4 à 8 semaines. Dans tous les cas, les premiers gains de temps sont visibles dès la première semaine de déploiement.",
  },
  {
    question: "Et si mes outils changent ou si j'ai besoin d'évolutions ?",
    answer: "Les automatisations sont construites de façon modulaire : ajouter un outil ou modifier un flux ne nécessite pas de tout reconstruire. Je forme vos équipes à faire les ajustements courants, et je reste disponible pour les évolutions majeures.",
  },
];

/*
 * =============================================
 * INFORMATION ARCHITECTURE — AUDIT & RATIONALE
 * =============================================
 *
 * Section order follows the AIDA conversion funnel:
 *   Attention → Interest → Desire → Action
 *
 * PREVIOUS ORDER:
 *   Hero → Manifeste → Problem → About → Tools → Services →
 *   CaseStudies → Testimonials+Process → FAQ → CTA
 *
 * PROBLEMS IDENTIFIED:
 *
 * 1. Manifeste too early (was #2).
 *    A personal conviction quote has no weight when the visitor
 *    doesn't know who Lilian is yet. Moved to #7 — after results
 *    and bio establish credibility, the manifeste becomes a
 *    compelling belief statement rather than an empty claim.
 *
 * 2. Problem was after Manifeste (was #3).
 *    The pain agitation should immediately follow the Hero promise.
 *    Moved to #2: "Here's what you promised to fix — now show me
 *    the pain is real." Classic problem-solution pairing.
 *
 * 3. Services came after Tools (was #6 after #5).
 *    WHAT you do should come before HOW (tools). The visitor needs
 *    to understand the offer before caring about the tech stack.
 *    Services moved to #3, Tools to #5.
 *
 * 4. About was too early (was #4).
 *    Bio before proof = unearned trust. Moved to #6 — after case
 *    studies prove results, the bio has authority.
 *
 * 5. Two dark-dark transitions (Hero+Manifeste, Tools+Services).
 *    The new order creates a strict dark/light alternation:
 *    dark → white → dark → light-gray → dark → light-gray →
 *    dark → white → light-gray → dark
 *    No consecutive same-tone sections.
 *
 * NEW ORDER (AIDA):
 *   1. Hero        (dark, #000)      — ATTENTION: promise + stats
 *   2. Problem     (white, #FFF)     — INTEREST: agitate the pain
 *   3. Services    (dark, #111)      — INTEREST→DESIRE: the solution
 *   4. CaseStudies (light-gray, #F7) — DESIRE: proof with numbers
 *   5. Tools       (dark, #000)      — DESIRE: technical credibility
 *   6. About       (light-gray, #F7) — DESIRE: personal credibility
 *   7. Manifeste   (dark, #000)      — DESIRE: conviction statement
 *   8. Testimonials+Process (white)  — DESIRE: social proof + method
 *   9. FAQ         (light-gray, #F7) — objection handling
 *  10. CTA         (dark, #000)      — ACTION: final conversion
 *
 * CTA TOUCHPOINTS (5 total — sufficient):
 *   - Nav bar (persistent)
 *   - Hero section
 *   - CaseStudies "Un cas similaire ?" links (×3)
 *   - Process step 1 mentions "Audit gratuit"
 *   - Final CTA section
 *
 * =============================================
 */
---

<Layout faqSchema={faqSchema}>
  <Navigation />

  <main id="main-content">
    <!-- 1. ATTENTION — Promise + stats + primary CTA -->
    <Hero />

    <!-- 2. INTEREST — Agitate the pain immediately after the promise -->
    <Problem />

    <!-- 3. INTEREST→DESIRE — Present the solution (what I do) -->
    <Services />

    <!-- 4. DESIRE — Prove it works with real numbers -->
    <CaseStudies />

    <!-- 5. DESIRE — Technical credibility (how I do it) -->
    <Tools />

    <!-- 6. DESIRE — Personal credibility (who I am) -->
    <About />

    <!-- 7. DESIRE — Conviction statement (now it has authority) -->
    <Manifeste />

    <!-- 8. DESIRE — Social proof + clear method (reduces friction) -->
    <section id="temoignages" class="bg-white py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
      <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-20">
        <Testimonials />
        <Process />
      </div>
      <div class="max-w-[1200px] mx-auto mt-[var(--spacing-section)]">
        <div class="h-px bg-[#E5E5E5]" aria-hidden="true"></div>
      </div>
    </section>

    <!-- 9. OBJECTION HANDLING — Answer remaining doubts (hidden for now) -->
    <!-- <FAQ /> -->

    <!-- 10. ACTION — Final conversion CTA -->
    <CTA />
  </main>

  <Footer />
</Layout>
