---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HeroOffre from '../components/HeroOffre.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import KeyMetrics from '../components/KeyMetrics.astro';
import Process from '../components/Process.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Testimonials from '../components/Testimonials.astro';
import Stack from '../components/Stack.astro';
import Offres from '../components/Offres.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import ROICalculator from '../components/ROICalculator.astro';
import MobileCTABar from '../components/MobileCTABar.astro';
import { faqs } from '../data/faq';

const faqSchema = faqs.map((f) => ({ question: f.q, answer: f.a }));
---

<Layout faqSchema={faqSchema}>
  <Navigation />

  <main id="main-content" tabindex="-1" class="outline-none">
    {/* Structure « Offre directe » : agenda au-dessus du pli, puis preuve
        chiffrée, puis déroulé de la mission. Les sections de preuve longues
        (cas, témoignages, ROI, stack) viennent après, une fois la promesse et
        le process posés. */}
    <HeroOffre />
    <LogoMarquee />
    <KeyMetrics />
    <Process />
    <CaseStudy />
    <Testimonials />
    <ROICalculator />
    <Stack />
    <Offres />
    <FAQ />
    <CTA />
  </main>

  <Footer />
  <MobileCTABar />
</Layout>
