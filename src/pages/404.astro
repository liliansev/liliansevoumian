---
/*
 * 404 — l'écran d'une adresse qui n'existe pas (ou plus).
 *
 * Une URL tronquée par LinkedIn, une ancienne adresse, une faute de frappe : le
 * trafic du site vient de posts et de descriptions de vidéos, c'est-à-dire
 * d'endroits où les liens se cassent. Arriver ici n'est pas une faute, et
 * l'écran n'a pas à ressembler à une erreur : il propose les routes qui
 * couvrent à peu près toutes les intentions — les cas, la méthode, les deux
 * pages d'outil, et la conversation.
 */
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import LinkCTA from '../components/LinkCTA.astro';
import BoutonReservation from '../components/BoutonReservation.astro';
import { DUREE_RESERVATION_MINUTES } from '../lib/reservation';
---

<Layout
  title="Page introuvable · Lilian Sevoumian"
  description={`Cette page n’existe pas ou a été déplacée. Les cas clients, la méthode et l’appel de ${DUREE_RESERVATION_MINUTES} minutes sont accessibles depuis ici.`}
  noindex
>
  <Navigation ctaSource="404_nav" />

  <main id="main-content" tabindex="-1" class="outline-none">
    <section class="perdu relative px-[var(--spacing-section-x)]">
      {/* `.entree` : le titre, la phrase, les deux actions puis les quatre
          liens montent l'un après l'autre, et le surlignage se trace une fois
          le titre arrivé. En CSS seul : sans script, tout est déjà là. */}
      <div class="entree relative mx-auto w-full max-w-[1200px]">
        <h1 class="perdu__titre">Cette page n’existe <mark>plus.</mark></h1>

        <p class="perdu__texte">
          Un lien tronqué, une adresse d’avant la refonte, ou une faute de frappe.
          Voilà par où reprendre.
        </p>

        <div class="perdu__actions">
          <BoutonReservation source="404" />
          <LinkCTA href="/">Ou revenir à l’accueil</LinkCTA>
        </div>

        <ul class="perdu__liens">
          <li><a href="/cas-clients" class="lien-404">Les cas clients</a></li>
          <li><a href="/principes" class="lien-404">La méthode</a></li>
          <li><a href="/expert-n8n" class="lien-404">Expert n8n</a></li>
          <li><a href="/expert-make" class="lien-404">Expert Make</a></li>
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Un écran, centré en hauteur sous la barre fixe. */
  .perdu {
    display: flex;
    align-items: center;
    min-height: 70vh;
    padding-block: calc(var(--spacing-barre) + var(--spacing-bloc)) var(--spacing-section-y);
  }

  .perdu__titre {
    max-width: 18ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-display);
    text-wrap: balance;
  }

  .perdu__texte {
    max-width: 46ch;
    margin: var(--spacing-lie) 0 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.5;
  }

  .perdu__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: var(--spacing-groupe);
  }

  .perdu__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    margin: var(--spacing-bloc) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Soulignement et non couleur seule : un lien se signale par un trait, pas
     uniquement par sa teinte. */
  .lien-404 {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-body);
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: text-decoration-thickness var(--duration-default) var(--ease-out-quint);
  }
  .lien-404:hover,
  .lien-404:focus-visible {
    text-decoration-thickness: 2px;
  }
</style>
