---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import BoutonReservation from '../components/BoutonReservation.astro';
import LinkCTA from '../components/LinkCTA.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import Footer from '../components/Footer.astro';
import {
  creationOffers,
  manufacturingSteps,
  productionPromises,
  refusedPromises,
  siteFaqs,
  subscriptionOffers,
} from '../data/sites-web';

const navLinks = [
  { href: '#tarifs', label: 'Création' },
  { href: '#abonnements', label: 'Abonnements' },
  { href: '#methode', label: 'Méthode' },
  { href: '#limites', label: 'Limites' },
  { href: '#realisations', label: 'Réalisations' },
  { href: '#faq', label: 'FAQ' },
];

const faqSchema = siteFaqs.map((faq) => ({ question: faq.q, answer: faq.a }));
const pageDescription = `Landing page dès ${creationOffers[0].price}, site vitrine dès ${creationOffers[1].price}, puis maintenance Care ou amélioration Growth. IA assistée, contrôle humain.`;

const projects = {
  lilian: {
    src: '/sites-web/projects/liliansevoumian-home.webp',
    href: 'https://liliansevoumian.fr',
    name: 'Lilian Sevoumian',
    detail: 'Site personnel',
    alt: 'Page d’accueil du site Lilian Sevoumian, sur fond lime',
  },
  augmentes: {
    src: '/sites-web/projects/augmentes-home.webp',
    href: 'https://augmentes.fr',
    name: 'augmentés',
    detail: 'Plateforme de formation',
    alt: 'Page d’accueil sombre du site augmentés',
  },
  youmanista: {
    src: '/sites-web/projects/youmanista-home.webp',
    href: 'https://youmanista.com',
    name: 'Youmanista',
    detail: 'Cabinet de recrutement',
    alt: 'Page d’accueil colorée du cabinet Youmanista',
  },
  meilleursTools: {
    src: '/sites-web/projects/meilleurs-tools-home.webp',
    href: 'https://meilleurs.tools',
    name: 'meilleurs.tools',
    detail: 'Catalogue éditorial',
    alt: 'Page d’accueil du catalogue meilleurs.tools',
  },
  flameborn: {
    src: '/sites-web/projects/flameborn-home.webp',
    href: 'https://flameborn.fr',
    name: 'Flameborn',
    detail: 'Base de données de jeu',
    alt: 'Page d’accueil sombre de la base de données Flameborn',
  },
  petiteStack: {
    src: '/sites-web/projects/la-petite-stack-home.webp',
    href: 'https://lapetitestack.fr',
    name: 'La Petite Stack',
    detail: 'Configurateur de logiciels',
    alt: 'Page d’accueil du configurateur La Petite Stack',
  },
} as const;

const projectList = [
  projects.lilian,
  projects.augmentes,
  projects.youmanista,
  projects.meilleursTools,
  projects.flameborn,
  projects.petiteStack,
] as const;

const creationVisuals = [projects.youmanista, projects.augmentes, projects.petiteStack] as const;
const subscriptionVisuals = [projects.lilian, projects.meilleursTools] as const;

if (creationVisuals.length !== creationOffers.length || subscriptionVisuals.length !== subscriptionOffers.length) {
  throw new Error('Chaque offre de site doit être associée à un visuel.');
}

const directionContract = `
THESIS: Les sites déjà réalisés font la démonstration ; le texte explique simplement ce qui est créé, maintenu et amélioré.
OWN-WORLD: Papier blanc, encre noire, lime posé en surface, grandes captures réelles, légendes fondues dans l’image, angles droits et une seule famille Geist.
STORY: Le visiteur voit d’abord les réalisations, comprend les trois périmètres, compare Care et Growth, puis réserve un appel de 20 minutes.
FIRST VIEWPORT: Promesse ample à gauche ; trois sites réels composent la moitié droite. Les prix restent lisibles sous l’action primaire.
FORM: Portfolio de fabrication, structure classée 7, seed 244476c3, dense et éditorial, sans cadre décoratif ni simulation d’écran.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
`.trim();

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://liliansevoumian.fr/sites-web-abonnement#service',
  name: 'Création et amélioration de sites web',
  description:
    'Création de landing pages et sites vitrines, puis maintenance Care ou amélioration Growth à partir de données réelles.',
  url: 'https://liliansevoumian.fr/sites-web-abonnement',
  areaServed: { '@type': 'Country', name: 'France' },
  provider: { '@id': 'https://liliansevoumian.fr/#person' },
  serviceType: ['Création de site web', 'Landing page', 'Maintenance de site web', 'Optimisation continue'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Création et abonnements',
    itemListElement: [
      ...creationOffers.map((offer, index) => ({
        '@type': 'Offer',
        name: offer.name,
        description: offer.promise,
        priceSpecification: {
          '@type': 'PriceSpecification',
          ...(index === creationOffers.length - 1
            ? { minPrice: offer.schemaPrice }
            : { price: offer.schemaPrice }),
          priceCurrency: 'EUR',
          valueAddedTaxIncluded: false,
        },
      })),
      ...subscriptionOffers.map((offer) => ({
        '@type': 'Offer',
        name: offer.name,
        description: `${offer.promise} Facturation mensuelle.`,
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: offer.schemaPrice,
          priceCurrency: 'EUR',
          billingDuration: 'P1M',
          valueAddedTaxIncluded: false,
        },
      })),
    ],
  },
};
---

<Layout
  title="Création de site web par abonnement | Lilian Sevoumian"
  description={pageDescription}
  ogImage="/og-sites-web.png"
  ogImageAlt="Création, maintenance Care et amélioration Growth par Lilian Sevoumian"
  breadcrumbs={[
    { name: 'Accueil', url: '/' },
    { name: 'Sites web', url: '/sites-web-abonnement' },
  ]}
  faqSchema={faqSchema}
  pageSchema={serviceSchema}
  directionContract={directionContract}
>
  <Navigation
    links={navLinks}
    ctaLabel="Parler de mon site"
    ctaSource="sites_web_nav"
    trackHero={true}
  />

  <main id="main-content" tabindex="-1" class="outline-none">
    <section id="hero" class="bloc-lime relative px-[var(--spacing-section-x)] pt-28 pb-16 lg:pt-36 lg:pb-20 border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto w-full">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.84fr)_minmax(0,1.16fr)] gap-12 lg:gap-16 items-center">
          <div class="min-w-0 reveal is-visible">
            <h1 class="font-display font-semibold text-[length:var(--text-sites-hero)] leading-[0.95] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[10ch] text-balance">
              Je crée votre site. Puis je le fais <mark class="inv">avancer.</mark>
            </h1>
            <p class="mt-7 mb-0 max-w-[55ch] text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)]">
              Je travaille le message, le design et le développement. Après la mise en ligne, Care couvre la maintenance et Growth réserve du temps pour les améliorations.
            </p>

            <div class="mt-9 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
              <BoutonReservation source="sites_web_hero" class="btn-primary justify-center">
                Parler de mon site
              </BoutonReservation>
              <LinkCTA href="#realisations">Voir les réalisations</LinkCTA>
            </div>

            <p class="mt-8 mb-0 text-[length:var(--text-body-sm)] leading-[1.55] text-[var(--color-ink-low)] max-w-[58ch]">
              Création dès {creationOffers[0].price} · suivi dès {subscriptionOffers[0].price} · périmètre défini avant le démarrage.
            </p>
          </div>

          <div class="hero-portfolio reveal is-visible" role="group" aria-label="Aperçu de trois sites réalisés">
            <ProjectVisual {...projects.lilian} ratio="wide" priority class="hero-portfolio__main" />
            <ProjectVisual {...projects.augmentes} ratio="landscape" />
            <ProjectVisual {...projects.youmanista} ratio="landscape" />
          </div>
        </div>

        <dl class="reveal is-visible mt-12 lg:mt-16 m-0 grid grid-cols-1 sm:grid-cols-3 border-y border-[var(--color-border-strong)]">
          <div class="py-5 sm:pr-6 border-b sm:border-b-0 sm:border-r border-[var(--color-divider)]">
            <dt class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">Build</dt>
            <dd class="mt-1 mb-0 text-[length:var(--text-body-sm)] text-[var(--color-ink-mid)]">Concevoir et publier · dès {creationOffers[0].price}</dd>
          </div>
          <div class="py-5 sm:px-6 border-b sm:border-b-0 sm:border-r border-[var(--color-divider)]">
            <dt class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">Care</dt>
            <dd class="mt-1 mb-0 text-[length:var(--text-body-sm)] text-[var(--color-ink-mid)]">Maintenir · {subscriptionOffers[0].price}</dd>
          </div>
          <div class="py-5 sm:pl-6">
            <dt class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">Growth</dt>
            <dd class="mt-1 mb-0 text-[length:var(--text-body-sm)] text-[var(--color-ink-mid)]">Mesurer et améliorer · {subscriptionOffers[1].price}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="tarifs" data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal grid grid-cols-1 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-8 lg:gap-20 items-end pb-9 border-b border-[var(--color-border-strong)]">
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[18ch] text-balance">
            Trois périmètres, avec le même niveau <mark>d’exigence.</mark>
          </h2>
          <p class="m-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
            Le prix évolue avec le nombre de pages, la profondeur des contenus et la complexité des parcours. Chaque format reçoit le même soin sur mobile, tablette et desktop.
          </p>
        </div>

        <div class="reveal-stagger grid grid-cols-1 lg:grid-cols-3 gap-x-8">
          {creationOffers.map((offer, index) => (
            <article class="reveal py-9 lg:py-10 border-b lg:border-b-0 border-[var(--color-divider)] flex flex-col">
              <ProjectVisual {...creationVisuals[index]} ratio="landscape" />
              <p class="mt-6 mb-0 text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink-low)]">{offer.useCase}</p>
              <h3 class="mt-4 mb-0 font-display font-semibold text-[length:var(--text-title-lg)] leading-[1.15] tracking-[-0.025em] text-[var(--color-ink)]">{offer.name}</h3>
              <p class="mt-3 mb-0 font-display font-semibold text-[length:var(--text-headline)] leading-none tracking-[-0.035em] text-[var(--color-ink)] tabular-nums">{offer.price}</p>
              <p class="mt-6 mb-0 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)]">{offer.promise}</p>
              <ul class="mt-7 mb-0 pt-5 border-t border-[var(--color-divider)] pl-5 space-y-2 text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink-mid)]">
                {offer.includes.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>

        <div class="reveal mt-10 pt-7 border-t border-[var(--color-divider)] flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <p class="m-0 max-w-[64ch] text-[length:var(--text-body-sm)] leading-[1.6] text-[var(--color-ink-low)]">
            Le devis précise les contenus à reprendre, les intégrations, les migrations et les validations attendues. Vous connaissez le périmètre complet avant le démarrage.
          </p>
          <BoutonReservation source="sites_web_tarifs" class="btn-primary justify-center shrink-0">
            Cadrer mon site
          </BoutonReservation>
        </div>
      </div>
    </section>

    <section id="abonnements" data-section class="bloc-encre relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-8 lg:gap-20 items-end pb-9 border-b border-[var(--color-border-strong)]">
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[16ch] text-balance">
            Le site continue après sa <mark class="inv dark-mark">mise en ligne.</mark>
          </h2>
          <p class="m-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
            Care prend en charge l’entretien. Avec Growth, j’analyse les données et je consacre chaque mois un lot de travail à une amélioration prioritaire.
          </p>
        </div>

        <div class="mt-3">
          {subscriptionOffers.map((offer, index) => (
            <article class="reveal grid grid-cols-1 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)] gap-8 lg:gap-14 py-10 border-b border-[var(--color-divider)] items-center">
              <ProjectVisual {...subscriptionVisuals[index]} ratio="wide" />
              <div class="grid grid-cols-1 md:grid-cols-[minmax(0,0.65fr)_minmax(0,1fr)] gap-7 md:gap-10 items-start">
                <div>
                  <p class="m-0 text-[length:var(--text-body-sm)] text-[var(--color-ink-low)]">{offer.role}</p>
                  <h3 class="mt-2 mb-0 font-display font-semibold text-[length:var(--text-title-lg)] leading-[1.15] tracking-[-0.025em] text-[var(--color-ink)]">{offer.name}</h3>
                  <p class="mt-3 mb-0 text-[length:var(--text-title)] font-medium text-[var(--color-ink)] tabular-nums">{offer.price}</p>
                </div>
                <div>
                  <p class="m-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)]">{offer.promise}</p>
                  <ul class="mt-5 mb-0 pl-5 space-y-2 text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink-mid)]">
                    {offer.includes.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="reveal mt-9 grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto] gap-7 items-center">
          <p class="m-0 max-w-[72ch] text-[length:var(--text-body-sm)] leading-[1.6] text-[var(--color-ink-low)]">
            L’offre couvre aujourd’hui la maintenance et l’amélioration du site. La production récurrente d’articles viendra après validation du processus sur mes propres sites.
          </p>
          <BoutonReservation source="sites_web_abonnements" class="btn-primary justify-center">
            Choisir le bon niveau
          </BoutonReservation>
        </div>
      </div>
    </section>

    <section id="methode" data-section class="section-band relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-8 lg:gap-20 items-end pb-9 border-b border-[var(--color-border-strong)]">
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[18ch] text-balance">
            Six étapes, du brief à la <mark>mise en ligne.</mark>
          </h2>
          <p class="m-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
            Je vous montre la structure, puis le contenu, puis le site. Chaque étape produit un livrable à relire avant de passer à la suivante.
          </p>
        </div>

        <div class="reveal mt-10">
          <ProjectVisual {...projects.augmentes} ratio="wide" />
        </div>

        <ol class="m-0 mt-6 p-0 list-none grid grid-cols-1 lg:grid-cols-2 gap-x-14">
          {manufacturingSteps.map((step, index) => (
            <li class="reveal grid grid-cols-[auto_minmax(0,1fr)] gap-5 py-8 border-b border-[var(--color-divider)]">
              <span class="method-index" aria-hidden="true">{index + 1}</span>
              <div>
                <h3 class="font-display font-semibold text-[length:var(--text-title)] leading-[1.2] tracking-[-0.02em] text-[var(--color-ink)] m-0 max-w-[24ch]">{step.title}</h3>
                <p class="mt-4 mb-0 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)] max-w-[66ch]">{step.description}</p>
                <p class="mt-4 mb-0 text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink)]"><strong>Livrable&nbsp;:</strong> {step.output}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="limites" data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-10 lg:gap-16 items-center">
          <div class="reveal">
            <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[18ch] text-balance">
              L’IA accélère. Je garde la <mark class="inv">responsabilité.</mark>
            </h2>
            <p class="mt-6 mb-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
              J’utilise ces outils pour chercher, structurer et produire plus vite. Je vérifie ensuite les faits, les promesses, le ton, le SEO et le fonctionnement de chaque page.
            </p>
          </div>
          <div class="reveal">
            <ProjectVisual {...projects.flameborn} ratio="landscape" />
          </div>
        </div>

        <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 border-y border-[var(--color-border-strong)]">
          <article class="reveal py-9 lg:pr-12 lg:border-r border-[var(--color-divider)]">
            <h3 class="font-display font-semibold text-[length:var(--text-title-lg)] leading-[1.15] tracking-[-0.025em] text-[var(--color-ink)] m-0">Ce que je vérifie</h3>
            <ul class="mt-7 mb-0 pl-5 space-y-4 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)]">
              {productionPromises.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article class="reveal py-9 lg:pl-12 border-t lg:border-t-0 border-[var(--color-divider)]">
            <h3 class="font-display font-semibold text-[length:var(--text-title-lg)] leading-[1.15] tracking-[-0.025em] text-[var(--color-ink)] m-0">Expertises à confier à un spécialiste</h3>
            <ul class="mt-7 mb-0 pl-5 space-y-4 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)]">
              {refusedPromises.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section id="realisations" data-section class="bloc-lime relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal grid grid-cols-1 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-8 lg:gap-20 items-end pb-9 border-b border-[var(--color-border-strong)]">
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[16ch] text-balance">
            Six projets web qui montrent mon <mark>travail.</mark>
          </h2>
          <p class="m-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
            Formation, recrutement, média, annuaire, jeu et logiciel : chaque projet part d’un usage différent et construit son propre langage visuel.
          </p>
        </div>

        <div class="portfolio-grid reveal-stagger mt-10">
          {projectList.map((project) => (
            <ProjectVisual {...project} ratio="landscape" class="reveal" interactive />
          ))}
        </div>

        <div class="reveal mt-9 flex flex-col sm:flex-row gap-4 sm:gap-7">
          <LinkCTA href="/cas-clients">Lire les cas clients</LinkCTA>
          <LinkCTA href="/principes">Voir ma méthode</LinkCTA>
        </div>
      </div>
    </section>

    <section id="faq" data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal grid grid-cols-1 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-8 lg:gap-20 items-end pb-9 border-b border-[var(--color-border-strong)]">
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[17ch] text-balance">
            Ce qu’on cadre avant de <mark class="inv">commencer.</mark>
          </h2>
          <p class="m-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
            Avant l’appel, vous pouvez déjà comparer le périmètre, le budget, la méthode et les limites de l’offre.
          </p>
        </div>

        <div class="reveal mt-10 grid grid-cols-1 md:grid-cols-2 gap-5">
          <ProjectVisual {...projects.youmanista} ratio="wide" />
          <ProjectVisual {...projects.petiteStack} ratio="wide" />
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-14">
          {siteFaqs.map((faq) => (
            <article class="reveal py-8 border-b border-[var(--color-divider)]">
              <h3 class="font-display font-semibold text-[length:var(--text-title)] leading-[1.2] tracking-[-0.02em] text-[var(--color-ink)] m-0 max-w-[32ch]">{faq.q}</h3>
              <p class="mt-4 mb-0 text-[length:var(--text-body)] leading-[1.65] text-[var(--color-ink-mid)] max-w-[68ch]">{faq.a}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bloc-encre relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
