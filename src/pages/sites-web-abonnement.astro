---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import BoutonReservation from '../components/BoutonReservation.astro';
import LinkCTA from '../components/LinkCTA.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { DUREE_RESERVATION_MINUTES } from '../lib/reservation';
import {
  creationOffers,
  manufacturingSteps,
  productionPromises,
  refusedPromises,
  siteFaqs,
  subscriptionOffers,
} from '../data/sites-web';

const navLinks = [
  { href: '#tarifs', label: 'Sites' },
  { href: '#applications', label: 'Applications' },
  { href: '#abonnements', label: 'Suivi des sites' },
  { href: '#methode', label: 'Méthode' },
  { href: '#realisations', label: 'Réalisations' },
  { href: '#faq', label: 'FAQ' },
];

const faqSchema = siteFaqs.map((faq) => ({ question: faq.q, answer: faq.a }));
const pageDescription = `Landing pages et sites web dès ${creationOffers[0].price}. Dashboards, portails clients et applications métiers sur devis. Conception, développement et suivi.`;

const projects = {
  lilian: {
    src: '/sites-web/projects/liliansevoumian-home.webp',
    href: 'https://liliansevoumian.fr',
    name: 'Lilian Sevoumian',
    detail: 'Site personnel',
    alt: 'Page d’accueil du site Lilian Sevoumian, sur fond lime',
  },
  augmentes: {
    src: '/sites-web/projects/augmentes-home.webp',
    href: 'https://augmentes.fr',
    name: 'augmentés',
    detail: 'Plateforme de formation',
    alt: 'Page d’accueil sombre du site augmentés',
  },
  youmanista: {
    src: '/sites-web/projects/youmanista-home.webp',
    href: 'https://youmanista.com',
    name: 'Youmanista',
    detail: 'Cabinet de recrutement',
    alt: 'Page d’accueil colorée du cabinet Youmanista',
  },
  meilleursTools: {
    src: '/sites-web/projects/meilleurs-tools-home.webp',
    href: 'https://meilleurs.tools',
    name: 'meilleurs.tools',
    detail: 'Catalogue éditorial',
    alt: 'Page d’accueil du catalogue meilleurs.tools',
  },
  flameborn: {
    src: '/sites-web/projects/flameborn-home.webp',
    href: 'https://flameborn.fr',
    name: 'Flameborn',
    detail: 'Base de données de jeu',
    alt: 'Page d’accueil sombre de la base de données Flameborn',
  },
  petiteStack: {
    src: '/sites-web/projects/la-petite-stack-home.webp',
    href: 'https://lapetitestack.fr',
    name: 'La Petite Stack',
    detail: 'Configurateur de logiciels',
    alt: 'Page d’accueil du configurateur La Petite Stack',
  },
} as const;

const projectList = [
  projects.lilian,
  projects.augmentes,
  projects.youmanista,
  projects.meilleursTools,
  projects.flameborn,
  projects.petiteStack,
] as const;

const directionContract = `
THESIS: La page distingue les sites commerciaux des applications métiers ; les tarifs de création et de suivi des sites ne promettent pas une application complète.
OWN-WORLD: Papier blanc, encre noire, lime posé en surface, composition éditoriale, angles droits et une seule famille Geist.
STORY: Le visiteur choisit sites ou applications, lit le périmètre correspondant, puis découvre les réalisations avant de parler de son projet.
FIRST VIEWPORT: Promesse typographique sans capture ; deux liens orientent vers sites et applications, et les repères de prix sont explicitement réservés aux sites.
FORM: Dossier de fabrication, structure classée 7, seed 244476c3, dense et éditorial, sans cadre décoratif ni simulation d’écran.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
`.trim();

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://liliansevoumian.fr/sites-web-abonnement#service',
  name: 'Création de sites web et d’applications métiers',
  description:
    'Création de landing pages et sites commerciaux, puis maintenance Care ou amélioration Growth. Dashboards, portails clients et applications métiers avec création et suivi sur devis.',
  url: 'https://liliansevoumian.fr/sites-web-abonnement',
  areaServed: { '@type': 'Country', name: 'France' },
  provider: { '@id': 'https://liliansevoumian.fr/#person' },
  serviceType: ['Création de site web', 'Landing page', 'Maintenance de site web', 'Optimisation continue', 'Développement d’applications métiers', 'Dashboard', 'Portail client'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Création et suivi des sites commerciaux',
    itemListElement: [
      ...creationOffers.map((offer, index) => ({
        '@type': 'Offer',
        name: offer.name,
        description: offer.promise,
        priceSpecification: {
          '@type': 'PriceSpecification',
          ...(index === creationOffers.length - 1
            ? { minPrice: offer.schemaPrice }
            : { price: offer.schemaPrice }),
          priceCurrency: 'EUR',
          valueAddedTaxIncluded: false,
        },
      })),
      ...subscriptionOffers.map((offer) => ({
        '@type': 'Offer',
        name: offer.name,
        description: `${offer.promise} Facturation mensuelle.`,
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: offer.schemaPrice,
          priceCurrency: 'EUR',
          billingDuration: 'P1M',
          valueAddedTaxIncluded: false,
        },
      })),
    ],
  },
};
---

<Layout
  title="Sites web et applications métiers | Lilian Sevoumian"
  description={pageDescription}
  ogImage="/og-sites-web.png"
  ogImageAlt="Création, maintenance Care et amélioration Growth par Lilian Sevoumian"
  breadcrumbs={[
    { name: 'Accueil', url: '/' },
    { name: 'Sites web et applications métiers', url: '/sites-web-abonnement' },
  ]}
  faqSchema={faqSchema}
  pageSchema={serviceSchema}
  directionContract={directionContract}
>
  <Navigation
    links={navLinks}
    ctaLabel="Parler de mon projet"
    ctaSource="sites_web_nav"
    trackHero={true}
  />

  <main id="main-content" tabindex="-1" class="outline-none">
    <section id="hero" class="bloc-lime relative px-[var(--spacing-section-x)] pt-28 pb-14 lg:pt-36 lg:pb-16 border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto w-full">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.45fr)_minmax(17rem,0.55fr)] gap-12 lg:gap-20 items-end">
          <div class="min-w-0 reveal is-visible">
            <h1 class="font-display font-semibold text-[length:var(--text-sites-hero)] leading-[0.95] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[12ch] text-balance">
              Sites web et applications <mark class="inv">métiers.</mark>
            </h1>
            <p class="mt-7 mb-0 max-w-[58ch] text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)]">
              Une landing page pour présenter votre offre, un site pour développer votre activité, une application pour votre équipe. Je conçois, développe et fais évoluer votre projet.
            </p>

            <nav aria-label="Choisir le type de projet web" class="mt-6 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2 sm:gap-x-7">
              <LinkCTA href="#tarifs">Sites et landing pages</LinkCTA>
              <LinkCTA href="#applications">Applications métiers</LinkCTA>
            </nav>

            <div class="mt-9 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
              <BoutonReservation source="sites_web_hero" class="btn-primary justify-center">
                Parler de mon projet
              </BoutonReservation>
              <LinkCTA href="#realisations">Voir les réalisations</LinkCTA>
            </div>
          </div>

          <aside class="reveal is-visible border-y lg:border-y-0 lg:border-l border-[var(--color-border-strong)] lg:pl-8" aria-label="Création et suivi des sites web">
            <p class="my-0 py-5 lg:pt-0 text-[length:var(--text-body)] leading-[1.55] text-[var(--color-ink-mid)]">
              Pour les sites : création, puis suivi mensuel.
            </p>
            <dl class="m-0 grid grid-cols-3 lg:block lg:border-t border-[var(--color-border-strong)]">
              <div class="flex flex-col gap-2 py-4 pr-3 border-r lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-5 lg:py-5 lg:pr-0 lg:border-r-0 lg:border-b border-[var(--color-divider)] lg:items-baseline">
                <dt class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">Créer</dt>
                <dd class="m-0 text-[length:var(--text-body-sm)] lg:text-right text-[var(--color-ink-mid)] tabular-nums">dès {creationOffers[0].price}</dd>
              </div>
              <div class="flex flex-col gap-2 py-4 px-3 border-r lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-5 lg:py-5 lg:px-0 lg:border-r-0 lg:border-b border-[var(--color-divider)] lg:items-baseline">
                <dt class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">Maintenir</dt>
                <dd class="m-0 text-[length:var(--text-body-sm)] lg:text-right text-[var(--color-ink-mid)] tabular-nums whitespace-nowrap">{subscriptionOffers[0].price.replace(' / mois', '/mois')}</dd>
              </div>
              <div class="flex flex-col gap-2 py-4 pl-3 lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-5 lg:py-5 lg:pl-0 lg:items-baseline">
                <dt class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">Améliorer</dt>
                <dd class="m-0 text-[length:var(--text-body-sm)] lg:text-right text-[var(--color-ink-mid)] tabular-nums whitespace-nowrap">{subscriptionOffers[1].price.replace(' / mois', '/mois')}</dd>
              </div>
            </dl>
            <p class="my-0 py-5 text-[length:var(--text-body-sm)] leading-[1.55] text-[var(--color-ink-mid)]">
              Applications métiers : création et suivi sur devis.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section id="tarifs" data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal grid grid-cols-1 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-8 lg:gap-20 items-end pb-9 border-b border-[var(--color-border-strong)]">
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[18ch] text-balance">
            Trois formats pour votre <mark>site web.</mark>
          </h2>
          <p class="m-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
            Landing page, site vitrine ou site avec un outil interactif : le prix de création dépend des pages, des contenus et des parcours. Le suivi mensuel est présenté séparément.
          </p>
        </div>

        <div class="reveal-stagger">
          {creationOffers.map((offer, index) => (
            <article class="reveal grid grid-cols-1 lg:grid-cols-[minmax(12rem,0.72fr)_minmax(0,1.28fr)_minmax(13rem,0.58fr)] gap-7 lg:gap-12 py-9 lg:py-11 border-b border-[var(--color-divider)] items-start">
              <div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-4 items-start">
                <span class="text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink-low)] tabular-nums" aria-hidden="true">{index + 1}</span>
                <div>
                  <h3 class="font-display font-semibold text-[length:var(--text-title-lg)] leading-[1.12] tracking-[-0.025em] text-[var(--color-ink)] m-0">{offer.name}</h3>
                  <p class="mt-3 mb-0 text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink-low)]">{offer.useCase}</p>
                </div>
              </div>

              <div>
                <p class="m-0 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)]">{offer.promise}</p>
                <ul class="mt-5 mb-0 grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3 gap-x-5 gap-y-2 pl-5 text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink-mid)]">
                  {offer.includes.map((item) => <li>{item}</li>)}
                </ul>
              </div>

              <p class="m-0 lg:text-right font-display font-semibold leading-none tracking-[-0.035em] text-[var(--color-ink)] tabular-nums">
                {index === creationOffers.length - 1 ? (
                  <>
                    <span class="block mb-2 font-sans text-[length:var(--text-body-sm)] font-normal leading-[1.4] tracking-normal text-[var(--color-ink-low)]">À partir de</span>
                    <span class="block text-[length:var(--text-title-lg)] whitespace-nowrap">{offer.price.replace('À partir de ', '')}</span>
                  </>
                ) : (
                  <span class="block text-[length:var(--text-title-lg)] whitespace-nowrap">{offer.price}</span>
                )}
              </p>
            </article>
          ))}
        </div>

        <div class="reveal mt-10 pt-7 border-t border-[var(--color-divider)] flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <p class="m-0 max-w-[64ch] text-[length:var(--text-body-sm)] leading-[1.6] text-[var(--color-ink-low)]">
            Le devis précise les contenus, les intégrations et les validations attendues. Un portail client ou une application métier relève d’un périmètre spécifique, présenté ci-dessous.
          </p>
          <BoutonReservation source="sites_web_tarifs" class="btn-primary justify-center shrink-0">
            Parler de mon site
          </BoutonReservation>
        </div>
      </div>
    </section>

    <section id="applications" data-section class="section-band relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-10 lg:gap-20 items-start">
        <div>
          <SectionHeader
            title="Une application pour votre <mark>travail quotidien.</mark>"
            body="Votre équipe a besoin de consulter, saisir ou traiter des données dans ses propres parcours. Je construis l’interface autour de cet usage et des outils déjà en place."
            titleMaxWidth="20ch"
            bodyMaxWidth="58ch"
            spacing="none"
          />
          <div class="reveal mt-8">
            <BoutonReservation source="sites_web_applications" class="btn-primary justify-center">
              Parler de mon application
            </BoutonReservation>
          </div>
          <div class="reveal mt-8">
            <p class="m-0 mb-2 text-[var(--color-ink-mid)] leading-relaxed">
              Pour Deuxième Souffle, j’ai réalisé un premier lot sur Glide et Make : sessions, affectations et pointage des coachs.
            </p>
            <LinkCTA href="/cas-clients/deuxieme-souffle">Voir le cas Deuxième Souffle</LinkCTA>
          </div>
        </div>
        <div class="reveal">
          <dl class="m-0 border-t border-[var(--color-border-strong)]">
            <div class="py-6 border-b border-[var(--color-divider)]">
              <dt class="font-display font-semibold text-[length:var(--text-title)] leading-[1.2] tracking-[-0.02em]">Dashboard</dt>
              <dd class="mt-3 mb-0 ml-0 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)]">Rassembler les informations utiles, suivre une activité et retrouver les dossiers qui demandent une action.</dd>
            </div>
            <div class="py-6 border-b border-[var(--color-divider)]">
              <dt class="font-display font-semibold text-[length:var(--text-title)] leading-[1.2] tracking-[-0.02em]">Portail client</dt>
              <dd class="mt-3 mb-0 ml-0 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)]">Donner à vos clients un espace pour consulter leurs documents, suivre une demande ou transmettre les éléments attendus.</dd>
            </div>
            <div class="py-6 border-b border-[var(--color-divider)]">
              <dt class="font-display font-semibold text-[length:var(--text-title)] leading-[1.2] tracking-[-0.02em]">Interface connectée à vos outils</dt>
              <dd class="mt-3 mb-0 ml-0 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)]">Créer un parcours de saisie, de validation ou de suivi relié à votre CRM, à vos données et à vos automatisations.</dd>
            </div>
          </dl>
          <p class="mt-7 mb-0 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink)]">
            La création et le suivi sont chiffrés sur devis, selon les utilisateurs, les données, les droits d’accès et les intégrations. Nous définissons les parcours et les fonctionnalités avant de fixer le périmètre.
          </p>
        </div>
      </div>
    </section>

    <section id="abonnements" data-section class="bloc-encre relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-8 lg:gap-20 items-end pb-9 border-b border-[var(--color-border-strong)]">
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[16ch] text-balance">
            Le site continue après sa <mark class="inv dark-mark">mise en ligne.</mark>
          </h2>
          <p class="m-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
            Ces deux abonnements concernent les sites commerciaux, après leur création. Care prend en charge l’entretien ; Growth ajoute l’analyse des données et un lot mensuel d’améliorations.
          </p>
        </div>

        <div class="reveal-stagger grid grid-cols-1 lg:grid-cols-2 border-b border-[var(--color-border-strong)]">
          {subscriptionOffers.map((offer, index) => (
            <article class:list={[
              'reveal py-10 lg:py-12',
              index === 0 ? 'lg:pr-12 lg:border-r border-[var(--color-divider)]' : 'border-t lg:border-t-0 lg:pl-12 border-[var(--color-divider)]',
            ]}>
              <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 pb-7 border-b border-[var(--color-divider)]">
                <div>
                  <p class="m-0 text-[length:var(--text-body-sm)] text-[var(--color-ink-low)]">{offer.role}</p>
                  <h3 class="mt-2 mb-0 font-display font-semibold text-[length:var(--text-headline)] leading-none tracking-[-0.035em] text-[var(--color-ink)]">{offer.name}</h3>
                </div>
                <p class="m-0 text-[length:var(--text-title)] font-medium text-[var(--color-ink)] tabular-nums whitespace-nowrap">{offer.price}</p>
              </div>
              <p class="mt-7 mb-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)]">{offer.promise}</p>
              <ul class="mt-6 mb-0 pl-5 space-y-2 text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink-mid)]">
                {offer.includes.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>

        <div class="reveal mt-9 grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto] gap-7 items-center">
          <p class="m-0 max-w-[72ch] text-[length:var(--text-body-sm)] leading-[1.6] text-[var(--color-ink-low)]">
            Care et Growth couvrent la maintenance et l’amélioration du site. Le suivi d’une application métier est défini dans son propre devis. La production récurrente d’articles ne fait pas partie du périmètre actuel.
          </p>
          <BoutonReservation source="sites_web_abonnements" class="btn-primary justify-center">
            Choisir le bon niveau
          </BoutonReservation>
        </div>
      </div>
    </section>

    <section id="methode" data-section class="section-band relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="reveal grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-8 lg:gap-20 items-end pb-9 border-b border-[var(--color-border-strong)]">
          <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[18ch] text-balance">
            Votre site, du brief à la <mark>mise en ligne.</mark>
          </h2>
          <p class="m-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
            Pour un site commercial, je vous montre la structure, puis le contenu, puis les pages. Ces six étapes produisent chacune un livrable à relire avant de passer à la suivante.
          </p>
        </div>

        <ol class="m-0 p-0 list-none grid grid-cols-1 lg:grid-cols-2 gap-x-14">
          {manufacturingSteps.map((step, index) => (
            <li class="reveal grid grid-cols-[auto_minmax(0,1fr)] gap-5 py-8 border-b border-[var(--color-divider)]">
              <span class="method-index" aria-hidden="true">{index + 1}</span>
              <div>
                <h3 class="font-display font-semibold text-[length:var(--text-title)] leading-[1.2] tracking-[-0.02em] text-[var(--color-ink)] m-0 max-w-[24ch]">{step.title}</h3>
                <p class="mt-4 mb-0 text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)] max-w-[66ch]">{step.description}</p>
                <p class="mt-4 mb-0 text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink)]"><strong>Livrable&nbsp;:</strong> {step.output}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="limites" data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] gap-10 lg:gap-20 items-start">
          <div class="reveal">
            <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)] m-0 max-w-[18ch] text-balance">
              L’IA accélère. Je garde la <mark class="inv">responsabilité.</mark>
            </h2>
            <p class="mt-6 mb-0 text-[length:var(--text-body-large)] leading-[1.55] text-[var(--color-ink-mid)] max-w-[62ch]">
              Pour les sites commerciaux, j’utilise ces outils pour chercher, structurer et produire plus vite. Je vérifie ensuite les faits, les promesses, le ton, le SEO et le fonctionnement de chaque page.
            </p>
          </div>
