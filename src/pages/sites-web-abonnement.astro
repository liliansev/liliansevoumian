---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import BoutonReservation from '../components/BoutonReservation.astro';
import LinkCTA from '../components/LinkCTA.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { projectList } from '../data/realisations';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SubscriptionGrid from '../components/SubscriptionGrid.astro';
import ApplicationSystemDiagram from '../components/application-system-diagram.astro';
import Questions from '../components/questions.astro';
import FinDePage from '../components/fin-de-page.astro';
import { maintenanceScope } from '../data/maintenance';
import { DUREE_RESERVATION_MINUTES } from '../lib/reservation';
import {
  creationOffers,
  manufacturingSteps,
  prixEnPhrase,
  siteFaqs,
  subscriptionOffers,
} from '../data/sites-web';

const navLinks = [
  { href: '#tarifs', label: 'Sites' },
  { href: '#applications', label: 'Applications' },
  { href: '#abonnements', label: 'Suivi' },
  { href: '#methode', label: 'Méthode' },
  { href: '#realisations', label: 'Réalisations' },
  { href: '#faq', label: 'FAQ' },
];

// Ce qu'une application métier peut être. Trois formes, sur devis.
const formesApplication = [
  {
    nom: 'Dashboard de suivi',
    texte: 'Vos chiffres, vos dossiers en cours et les actions à traiter dans une même vue.',
  },
  {
    nom: 'Portail client',
    texte: 'Un espace où vos clients retrouvent leurs documents, déposent leurs pièces et suivent leurs demandes.',
  },
  {
    nom: 'Outil interne connecté',
    texte: 'Des formulaires et des étapes de validation reliés à votre CRM, vos données et vos automatisations.',
  },
];

const faqSchema = siteFaqs.map((faq) => ({ question: faq.q, answer: faq.a }));
const pageDescription = `Création de sites web dès ${creationOffers[0].price}, avec abonnement de suivi. Applications métier, dashboards et portails clients sur devis. Échange de ${DUREE_RESERVATION_MINUTES} min.`;


const directionContract = `
THESIS: La page distingue les sites commerciaux des applications métiers ; les tarifs de création et de suivi des sites ne promettent pas une application complète.
OWN-WORLD: Fond bleu nuit, texte blanc, pêche posée en surface et en accent, panneau clair inversé en île arrondie, composition éditoriale, surfaces arrondies et une seule famille Geist.
STORY: Le visiteur choisit sites ou applications, lit le périmètre correspondant, puis découvre les réalisations avant de parler de son projet.
FIRST VIEWPORT: Promesse typographique sans capture ; deux liens orientent vers sites et applications, et les repères de prix sont explicitement réservés aux sites.
FORM: Dossier de fabrication, structure classée 7, seed 244476c3, dense et éditorial, sans cadre décoratif ni simulation d’écran.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
`.trim();

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://liliansevoumian.fr/sites-web-abonnement#service',
  name: 'Création de sites web et d’applications métiers',
  description:
    'Création de landing pages et sites commerciaux avec abonnement mensuel incluant hébergement, maintenance et petits ajustements. Applications métiers avec création et suivi sur devis.',
  url: 'https://liliansevoumian.fr/sites-web-abonnement',
  areaServed: { '@type': 'Country', name: 'France' },
  provider: { '@id': 'https://liliansevoumian.fr/#person' },
  serviceType: ['Création de site web', 'Landing page', 'Maintenance de site web', 'Développement d’applications métier', 'Dashboard', 'Portail client'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Création et suivi des sites commerciaux',
    itemListElement: [
      ...creationOffers.map((offer) => ({
        '@type': 'Offer',
        name: offer.name,
        description: `${offer.promise} Création facturée séparément de l’abonnement mensuel obligatoire.`,
        priceSpecification: {
          '@type': 'PriceSpecification',
          ...(offer.minimum ? { minPrice: offer.schemaPrice } : { price: offer.schemaPrice }),
          priceCurrency: 'EUR',
          valueAddedTaxIncluded: false,
        },
      })),
      ...subscriptionOffers.map((offer) => ({
        '@type': 'Offer',
        name: offer.name,
        description: `${offer.promise} ${offer.includes.join(', ')}. Abonnement mensuel associé à la création, facturée séparément.`,
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          ...(offer.minimum ? { minPrice: offer.schemaPrice } : { price: offer.schemaPrice }),
          priceCurrency: 'EUR',
          billingIncrement: 1,
          unitCode: 'MON',
          valueAddedTaxIncluded: false,
        },
      })),
    ],
  },
};
---

<Layout
  title="Sites web et applications métiers · Lilian Sevoumian"
  description={pageDescription}
  ogImage="/og-sites-web.png"
  ogImageAlt="Création de sites web et applications métiers par Lilian Sevoumian"
  breadcrumbs={[
    { name: 'Accueil', url: '/' },
    { name: 'Sites web et applications métiers', url: '/sites-web-abonnement' },
  ]}
  faqSchema={faqSchema}
  pageSchema={serviceSchema}
  directionContract={directionContract}
>
  <Navigation
    links={navLinks}
    ctaSource="sites_web_nav"
    trackHero={true}
  />

  <main id="main-content" tabindex="-1" class="outline-none">
    {/* Le premier écran reste sur la nuit, sans filet bas : la section qui
        suit est un panneau clair détaché et arrondi, et un trait droit à vingt
        pixels de son arrondi lui servirait de couvercle. */}
    <section id="hero" class="relative px-[var(--spacing-section-x)] pt-28 pb-[var(--spacing-bloc)] lg:pt-36">
      <div class="relative max-w-[1200px] mx-auto w-full">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.45fr)_minmax(19rem,0.55fr)] gap-[var(--spacing-gouttiere)] items-end">
          {/* L'entrée d'auteur : le titre, le chapô puis les actions arrivent
              l'un après l'autre, et le trait du titre se tire. Des keyframes CSS
              jouées au chargement — sans script, la colonne est peinte dans
              son état final. */}
          <div class="min-w-0 entree">
            <h1 class="m-0 max-w-[18ch] text-[length:var(--text-display)]">
              Un site pour vos clients. Une app pour <mark>vos équipes.</mark>
            </h1>
            <p class="mt-[var(--spacing-lie)] mb-0 max-w-[46ch] text-[length:var(--text-body-large)] leading-[1.5] text-[var(--color-ink-mid)]">
              Présenter votre offre, centraliser vos dossiers ou suivre votre activité&nbsp;: je crée le site web ou l’application métier qui répond à votre besoin, puis j’en assure le suivi.
            </p>

            {/* Un bouton, puis les deux portes de la page : les sites et leurs
                tarifs, les applications et leur devis. Les deux portes vont
                ensemble : faute de place à côté du bouton, elles passent
                dessous toutes les deux. */}
            <div class="mt-[var(--spacing-groupe)] flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-x-7 gap-y-2">
              <BoutonReservation source="sites_web_hero" />
              <div class="flex flex-wrap gap-x-7">
                <LinkCTA href="#tarifs">Sites et landing pages</LinkCTA>
                <LinkCTA href="#applications">Applications métier</LinkCTA>
              </div>
            </div>
          </div>

          {/* Les repères de prix forment un seul objet, qui entre d'un bloc après
              le titre. L'enveloppe porte `.entree` parce que le geste anime des
              enfants directs : posé sur l'aside, il aurait fait arriver les
              lignes dans un cadre déjà là, vide. */}
          <div class="min-w-0 entree">
            <aside class="reperes" style="--i: 3" aria-label="Création et suivi des sites web">
              <p>
                Pour votre site web&nbsp;: un budget de création, puis un abonnement mensuel obligatoire.
              </p>
              <dl>
                <div>
                  <dt>Création</dt>
                  <dd>dès {creationOffers[0].price}</dd>
                </div>
                <div>
                  <dt>Suivi</dt>
                  <dd>{prixEnPhrase(subscriptionOffers[0].price)}</dd>
                </div>
              </dl>
              <p class="reperes__devis">
                Application métier&nbsp;: création et suivi sur devis.
              </p>
            </aside>
          </div>
        </div>
      </div>
    </section>

    {/* Premier panneau clair : les tarifs de création, ce qu'on vient vérifier. */}
    <section id="tarifs" data-section class="bloc-encre relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
      <div class="relative max-w-[1200px] mx-auto">
        <SectionHeader
          title="Le site qui correspond à votre offre."
          body="Une page pour une offre précise, plusieurs pages pour vos services, ou un outil pour guider vos visiteurs. Voici les tarifs de création, hors abonnement."
          titleMaxWidth="18ch"
        />

        <div class="reveal">
          <SubscriptionGrid offers={creationOffers} label="Tarifs de création des sites web" unite="HT" />
        </div>

        {/* La sortie se tient plus loin que l'écart entre deux formules, pour
            ne pas se lire comme une quatrième ligne de la liste. */}
        <div class="reveal mt-[var(--spacing-bloc)] flex flex-col md:flex-row md:items-center md:justify-between gap-x-[var(--spacing-gouttiere)] gap-y-3">
          <p class="m-0 max-w-[64ch] text-[length:var(--text-body-sm)] leading-[1.6] text-[var(--color-ink-low)]">
            Nous validons les pages, les contenus et les outils à connecter avant le démarrage. Les applications métier ont leur propre devis, détaillé ci-dessous.
          </p>
          <LinkCTA href="#abonnements" class="shrink-0">Voir l’abonnement de suivi</LinkCTA>
        </div>
      </div>
    </section>

    {/* Entre les deux panneaux clairs, sur la nuit et sans filet. À gauche ce
        qu'est une application métier et ce qu'elle coûte, à droite le schéma
        puis le cas qui l'illustre. C'est aussi là qu'arrive le lien
        « Dashboards et outils métiers » de l'accueil : d'où le bouton. */}
    <section id="applications" data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
      <div class="relative max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-x-[var(--spacing-gouttiere)] gap-y-[var(--spacing-bloc)] items-start">
        <div class="min-w-0">
          <SectionHeader
            title="Vos dossiers au même endroit. Votre équipe y voit clair."
            body={`Des fichiers Excel, des demandes par mail, des informations à recopier : votre équipe passe du temps à faire le lien. Je construis une application métier reliée à vos outils pour rassembler ce travail.`}
            titleMaxWidth="20ch"
            spacing="none"
          />

          <ul class="reveal m-0 mt-[var(--spacing-groupe)] p-0 list-none grid gap-[var(--spacing-lie)]">
            {formesApplication.map((forme) => (
              <li>
                <h3 class="m-0">{forme.nom}</h3>
                <p class="mt-[var(--spacing-colle)] mb-0 leading-[var(--leading-body)] text-[var(--color-ink-mid)]">{forme.texte}</p>
              </li>
            ))}
          </ul>

          <div class="reveal mt-[var(--spacing-groupe)]">
            <p class="m-0 mb-[var(--spacing-lie)] leading-[var(--leading-body)] text-[var(--color-ink)]">
              Création et abonnement sur devis, selon les fonctionnalités, les utilisateurs et les connexions nécessaires.
            </p>
            <BoutonReservation source="sites_web_applications" />
          </div>
        </div>

        <div class="min-w-0 max-w-[720px]">
          <div class="reveal">
            <ApplicationSystemDiagram />
          </div>
          <div class="reveal mt-[var(--spacing-groupe)]">
            <p class="m-0 mb-[var(--spacing-colle)] max-w-[58ch] leading-[var(--leading-body)] text-[var(--color-ink-mid)]">
              Chez Deuxième Souffle, des tableaux Excel servaient à organiser les sessions d’une trentaine de coachs. J’ai livré une première application pour recueillir leurs disponibilités, faciliter les affectations et suivre le pointage.
            </p>
            <LinkCTA href="/cas-clients/deuxieme-souffle">Voir le cas Deuxième Souffle</LinkCTA>
          </div>
        </div>
      </div>
    </section>

    {/* Second panneau clair : ce que coûte le suivi, chaque mois. */}
    <section id="abonnements" data-section class="bloc-encre relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]">
      <div class="relative max-w-[1200px] mx-auto">
        <SectionHeader
          title="Votre site est en ligne. Je m’occupe du suivi."
          body={`Hébergement, maintenance et petits ajustements des pages livrées : l’abonnement fait partie de chaque projet. Son tarif dépend du format de votre site.`}
          titleMaxWidth="16ch"
        />

        <div class="reveal">
          <SubscriptionGrid offers={subscriptionOffers} label="Abonnements de suivi des sites web" />
        </div>

        <p class="reveal mt-[var(--spacing-bloc)] mb-0 max-w-[72ch] text-[length:var(--text-body-sm)] leading-[1.6] text-[var(--color-ink-low)]">
          {maintenanceScope} La rédaction récurrente d’articles est distincte de l’abonnement blog. Le suivi d’une application métier est chiffré sur devis.
        </p>
      </div>
    </section>

    {/* Les étapes gardent leur numéro : ici l'ordre est l'information. */}
    <section id="methode" data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <SectionHeader
          title="De votre idée à la mise en ligne."
          body="Vous validez les choix importants et testez le résultat avant publication. Voici comment nous avançons."
          titleMaxWidth="18ch"
        />

        <ol class="m-0 p-0 list-none grid grid-cols-1 lg:grid-cols-2 gap-x-[var(--spacing-gouttiere)] gap-y-[var(--spacing-groupe)]">
          {manufacturingSteps.map((step, index) => (
            <li class="reveal grid grid-cols-[auto_minmax(0,1fr)] gap-x-4">
              <span class="method-index" aria-hidden="true">{index + 1}</span>
              <div>
                <h3 class="m-0 max-w-[24ch]">{step.title}</h3>
                <p class="mt-3 mb-0 max-w-[58ch] leading-[var(--leading-body)] text-[var(--color-ink-mid)]">{step.description}</p>
                <p class="mt-3 mb-0 max-w-[58ch] text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink)]"><strong>Livrable&nbsp;:</strong> {step.output}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="realisations" data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-b border-[var(--color-divider)]">
      <div class="relative max-w-[1200px] mx-auto">
        <SectionHeader
          title="Quelques sites que j’ai créés."
          body={`Recrutement, formation, catalogues et outils de recherche : ouvrez les sites pour voir le résultat.`}
          titleMaxWidth="16ch"
        />

        <div class="portfolio-grid reveal-stagger">
          {projectList.map((project) => (
            <ProjectVisual
              src={project.src}
              href={project.href}
              name={project.name}
              detail={project.detail}
              alt={project.alt}
              class="reveal"
            />
          ))}
        </div>

        <div class="reveal mt-[var(--spacing-groupe)] flex flex-col sm:flex-row gap-x-7 gap-y-2">
          <LinkCTA href="/cas-clients">Lire les cas clients</LinkCTA>
          <LinkCTA href="/principes">Voir ma méthode</LinkCTA>
        </div>
      </div>
    </section>

    <Questions id="faq" titre="Vos questions, avant de vous lancer." titreLargeur="14ch" items={siteFaqs} />

    <FinDePage
      source="sites_web_fin"
      titre={`Que <span class="whitespace-nowrap">voulez-vous</span> <mark>créer&nbsp;?</mark>`}
      suite={`Une phrase suffit. Je vous réponds <span class="whitespace-nowrap">moi-même</span> et je vous dis ce qui est faisable, avec quel type de site ou d’application.`}
    />
  </main>

  <Footer />
</Layout>

<style>
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.4vw, 1rem);
  }

  /* Le rang d'une étape de la méthode. */
  .method-index {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-body-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  /* ── Les repères de prix du hero ──
     La seule surface du premier écran : un panneau relevé d'un cran, arrondi,
     qui dit en trois lignes ce que coûte un site. Ni filet ni pastille :
     l'espace sépare, et le prix se lit à sa graisse. */
  .reperes {
    display: grid;
    gap: var(--spacing-lie);
    padding: var(--spacing-panneau);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-lg);
    background: var(--color-surface-low);
  }

  .reperes p {
    margin: 0;
    color: var(--color-ink-mid);
    line-height: 1.5;
  }

  .reperes .reperes__devis {
    font-size: var(--text-body-sm);
  }

  .reperes dl {
    display: grid;
    gap: var(--spacing-colle);
    margin: 0;
  }

  /* Le rôle à gauche, le prix à droite ; s'il manque de place, le prix passe
     dessous, entier. */
  .reperes dl > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
  }

  .reperes dt {
    color: var(--color-ink-mid);
  }

  .reperes dd {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-body-large);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
