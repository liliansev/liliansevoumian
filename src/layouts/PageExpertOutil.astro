---
/*
 * PageExpertOutil — le gabarit commun de /expert-make et /expert-n8n.
 *
 * Les deux pages ont le même plan et un contenu différent : tout ce qui se
 * répète est ici, tout ce qui se rédige reste dans la page. Le plan, de haut
 * en bas :
 *
 *   l'en-tête     le titre, le chapô, le bouton, une ligne de preuves
 *                 (`tete-de-page`) ;
 *   la valeur     quatre raisons, en blocs de texte sur deux colonnes ;
 *   les usages    ce qu'on automatise avec l'outil, en liste ;
 *   les cas       les cas clients construits avec l'outil, chacun en une
 *                 phrase qui mène à son récit ;
 *   pourquoi moi  le panneau clair de la page (`pourquoi-moi`) ;
 *   les questions en échange (`questions`) ;
 *   la fin        le champ et le bouton (`fin-de-page`).
 *
 * Ni carte ni filet : les blocs se séparent par l'espace, comme sur l'accueil.
 * Le titre d'une section se tient à gauche, ce qu'il annonce à droite.
 */
import Layout from './Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import TeteDePage from '../components/tete-de-page.astro';
import LinkCTA from '../components/LinkCTA.astro';
import PourquoiMoi from '../components/pourquoi-moi.astro';
import Questions from '../components/questions.astro';
import FinDePage from '../components/fin-de-page.astro';

interface Valeur { titre: string; texte: string }
interface Cas { nom: string; href: string; texte: string }
/** `html` est la réponse affichée quand elle porte un lien ; `a` reste le texte
    brut, lu par le balisage `FAQPage`. */
interface Question { q: string; a: string; html?: string }

interface Props {
  /** Nom de l'outil tel qu'il s'écrit dans le texte : « Make », « n8n ». */
  outil: string;
  /** Chemin de la page, pour le fil d'Ariane. */
  url: string;
  titreSeo: string;
  descriptionSeo: string;
  serviceSchema: object;

  /** L'en-tête. Le h1 porte son `<mark>` : rendu en `set:html`. */
  titreHtml: string;
  chapo: string;
  /** Une ligne, sous le bouton : ce qui se vérifie. */
  preuves: string;

  titreValeur: string;
  valeur: Valeur[];
  titreCasUsage: string;
  casUsage: string[];
  /** Renvoi vers l'autre page d'outil, sous la liste des usages. */
  lienCroise: { href: string; libelle: string };
  cas: Cas[];
  titrePourquoi: string;
  /** La notice à la troisième personne, puis le texte à la première. */
  fichePourquoi: string;
  textePourquoi: string;
  titreFaq: string;
  faqs: Question[];
  /** Le titre et la phrase de la fin de page, en HTML. */
  titreFin: string;
  suiteFin: string;
}

const {
  outil, url, titreSeo, descriptionSeo, serviceSchema,
  titreHtml, chapo, preuves,
  titreValeur, valeur, titreCasUsage, casUsage, lienCroise, cas,
  titrePourquoi, fichePourquoi, textePourquoi,
  titreFaq, faqs, titreFin, suiteFin,
} = Astro.props;

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: `Expert ${outil}`, url },
];

/* La source du suivi se déduit du chemin : `expert-make` dans l'en-tête,
   `expert-make_nav` dans la barre, `expert-make_fin` en bas. */
const source = url.replace(/^\//, '');
---

<Layout
  title={titreSeo}
  description={descriptionSeo}
  breadcrumbs={breadcrumbs}
  faqSchema={faqs.map((f) => ({ question: f.q, answer: f.a }))}
  articleSchema={serviceSchema}
>
  <Navigation ctaSource={`${source}_nav`} />

  <main id="main-content" tabindex="-1" class="outline-none">

    <TeteDePage titre={titreHtml} chapo={chapo} bouton={source} preuves={preuves} />

    {/* Ce que je fais avec l'outil. */}
    <section data-section class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]">
      <div class="relative mx-auto max-w-[1200px]">
        <h2 class="expert-titre reveal">{titreValeur}</h2>
        <div class="expert-valeur reveal">
          {valeur.map((v) => (
            <div class="expert-bloc">
              <h3>{v.titre}</h3>
              <p>{v.texte}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Ce qu'on peut automatiser. */}
    <section data-section class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]">
      <div class="expert-duo relative mx-auto max-w-[1200px]">
        <h2 class="expert-titre reveal">{titreCasUsage}</h2>
        <div class="reveal">
          <ul class="expert-usages">
            {casUsage.map((c) => <li>{c}</li>)}
          </ul>
          <p class="expert-suite">
            <LinkCTA href={lienCroise.href}>{lienCroise.libelle}</LinkCTA>
          </p>
        </div>
      </div>
    </section>

    {/* Les cas construits avec l'outil : une phrase chacun, le récit derrière. */}
    <section data-section class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]">
      <div class="expert-duo relative mx-auto max-w-[1200px]">
        <h2 class="expert-titre reveal">Cas réalisés avec {outil}.</h2>
        <div class="reveal">
          <ul class="expert-cas">
            {cas.map((c) => (
              <li>
                <h3><a href={c.href}>{c.nom}</a></h3>
                <p>{c.texte}</p>
              </li>
            ))}
          </ul>
          <p class="expert-note">
            Ces chiffres sont ceux mesurés chez chaque client&nbsp;; ils ne se transposent pas tels quels.
          </p>
        </div>
      </div>
    </section>

    <PourquoiMoi titre={titrePourquoi} fiche={fichePourquoi} texte={textePourquoi} />

    <Questions
      id="faq"
      titre={titreFaq}
      titreLargeur="16ch"
      items={faqs}
    />

    <FinDePage source={`${source}_fin`} titre={titreFin} suite={suiteFin} />

  </main>

  <Footer />
</Layout>

<style>
  .expert-titre {
    max-width: 16ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-headline);
    text-wrap: balance;
  }

  /* Quatre raisons, deux par rangée : du texte posé sur la page, sans cadre. */
  .expert-valeur {
    display: grid;
    gap: var(--spacing-groupe) var(--spacing-gouttiere);
    margin-top: var(--spacing-bloc);
  }

  .expert-bloc h3,
  .expert-cas h3 {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-title);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .expert-bloc p,
  .expert-cas p {
    max-width: 46ch;
    margin: var(--spacing-colle) 0 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  /* Le titre à gauche, ce qu'il annonce à droite. */
  .expert-duo {
    display: grid;
    gap: var(--spacing-groupe);
  }

  .expert-usages,
  .expert-cas {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .expert-usages {
    gap: 0.875rem;
  }

  .expert-usages li {
    max-width: 40ch;
    color: var(--color-ink);
    font-size: var(--text-body-large);
    line-height: 1.4;
    text-wrap: pretty;
  }

  .expert-suite {
    margin: var(--spacing-groupe) 0 0;
  }

  .expert-cas {
    gap: var(--spacing-groupe);
  }

  /* Le nom du client mène à son récit : souligné, d'un trait qui passe à la
     pêche au survol. */
  .expert-cas a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-ink) 28%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.24em;
    transition: text-decoration-color var(--duration-default) var(--ease-out-quint);
  }

  @media (hover: hover) and (pointer: fine) {
    .expert-cas a:hover {
      text-decoration-color: var(--color-peche);
    }
  }

  .expert-note {
    max-width: 46ch;
    margin: var(--spacing-groupe) 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .expert-valeur {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .expert-duo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      column-gap: var(--spacing-gouttiere);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .expert-cas a {
      transition: none;
    }
  }
</style>
