---
/*
 * Carnet : la charpente du blog (le nom date du carnet kraft d'octobre).
 *
 * Depuis le 3 novembre 2026, le blog porte la DA du site, « Entre les deux »
 * (Lilian : « colle la DA partout dans le site, même le blog ») : le même
 * en-tête et le même pied que les autres pages, le papier, l'encre, Geist
 * Mono et le bleu des liens. Il garde sa forme de blog : une seule colonne
 * de lecture, aucun ornement. Le Layout commun garde le SEO, le balisage et
 * le suivi.
 */
import type { ComponentProps } from 'astro/types';
import Layout from './Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

type Props = ComponentProps<typeof Layout>;

const props = Astro.props as Props;
---

<Layout {...props}>
  <div class="carnet">
    <Navigation ctaSource="blog_nav" />

    <main id="main-content" tabindex="-1" class="carnet__page">
      <slot />
    </main>

    <Footer />
  </div>
</Layout>

<style is:global>
  .carnet {
    /* Les teintes du blog sont celles du site (`carnet/carnet.css`) : l'encre
       sur le papier (16,9:1), le gris (4,8:1), le filet, et le bleu pour ce
       qui se clique (6,1:1). Les repères (trait des intertitres, puces,
       citations) passent à l'encre : le bleu reste aux liens. */
    --carnet-papier: var(--papier);
    --carnet-encre: var(--encre);
    --carnet-gris: var(--encre-doux);
    --carnet-trait: var(--encre-filet);
    --carnet-accent: var(--encre);
    --carnet-accent-texte: var(--violet);
    /* 42 rem de Geist Mono à 16 px : environ 70 signes par ligne. */
    --carnet-colonne: 42rem;

    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    color: var(--carnet-encre);
    font-family: var(--carnet-titre);
    font-size: 1rem;
    line-height: 1.75;
  }

  /* `html` en tête : la tenue commune pose sa graisse et son interlettrage
     sur `.tenue-carnet :is(h1, h2…)`, il faut la dépasser d'un cran. */
  html .carnet :is(h1, h2, h3, h4) {
    color: var(--carnet-encre);
    font-family: var(--carnet-titre);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .carnet :where(p, li, blockquote) {
    max-width: none;
  }

  /* Un lien du texte : en bleu, souligné d'un trait fin ; au survol, il
     passe à l'encre. */
  .carnet__page a {
    color: var(--carnet-accent-texte);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: color 150ms ease;
  }

  .carnet__page a:hover {
    color: var(--carnet-encre);
  }

  .carnet__page {
    flex: 1;
    width: 100%;
    max-width: calc(var(--carnet-colonne) + var(--gauche) + var(--droite));
    margin-inline: auto;
    padding: 4rem var(--droite) 1rem var(--gauche);
    outline: none;
  }

  .carnet hr {
    display: block;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--carnet-trait);
  }

  @media (max-width: 30rem) {
    .carnet__page {
      padding-top: 2.75rem;
    }
  }
</style>
