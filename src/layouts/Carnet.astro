---
/*
 * Carnet : la charpente du blog.
 *
 * Le blog vit sur le site mais ne porte pas sa nuit : il se lit sur fond
 * blanc, en Geist, avec la pêche du site pour seul accent (22 octobre 2026 :
 * le carnet kraft en Garamond était « trop beige, trop italique », Lilian veut
 * un blog personnel qui reste tech). Une seule colonne, aucun ornement. Le
 * Layout commun garde le SEO, le balisage et le suivi ; tout le reste (barre,
 * pied, couleurs) est propre au blog et ne sort pas de cette charpente.
 */
import type { ComponentProps } from 'astro/types';
import Layout from './Layout.astro';

type Props = ComponentProps<typeof Layout>;

const props = Astro.props as Props;
const annee = new Date().getFullYear();
---

<Layout {...props}>
  <div class="carnet">
    <header class="carnet__barre">
      <a href="/" class="carnet__nom">Lilian Sevoumian</a>
      <nav aria-label="Blog" class="carnet__liens">
        <a href="/blog">Blog</a>
        <a href="#inscription">Recevoir par e-mail</a>
      </nav>
    </header>

    <main id="main-content" tabindex="-1" class="carnet__page">
      <slot />
    </main>

    <footer class="carnet__pied">
      <p>
        © {annee} Lilian Sevoumian
        <span aria-hidden="true">·</span>
        <a href="/">Le site</a>
        <span aria-hidden="true">·</span>
        <a href="/blog/rss.xml">RSS</a>
        <span aria-hidden="true">·</span>
        <a href="/mentions-legales">Mentions légales</a>
      </p>
    </footer>
  </div>
</Layout>

<style is:global>
  /* La page entière passe au blanc, y compris sous la barre de défilement et
     au-delà du bas de page : la nuit du site ne doit pas réapparaître. */
  html:has(.carnet),
  html:has(.carnet) body {
    background-color: #ffffff;
    color-scheme: light;
  }

  html:has(.carnet) ::selection {
    background: #ffd9c4;
    color: #111827;
  }

  html:has(.carnet) .skip-link:focus-visible {
    background: #111827;
    color: #ffffff;
  }

  .carnet {
    /* Les teintes du blog. L'encre est la nuit du site (17,7:1 sur le blanc),
       le gris tient 7,6:1, le trait ne sert qu'aux filets. La pêche du site
       souligne et marque ; elle ne porte jamais de texte sur le blanc, où
       elle ne tient pas 2:1. */
    --carnet-papier: #ffffff;
    --carnet-encre: #111827;
    --carnet-gris: #4b5563;
    --carnet-trait: #e5e7eb;
    --carnet-peche: #ffb38a;
    --carnet-colonne: 40rem;

    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 0 1.25rem;
    color: var(--carnet-encre);
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.7;
    font-feature-settings: 'ss01';
  }

  /* `html` en tête : la tenue commune pose sa graisse et son interlettrage
     sur `:root :is(h1, h2…)`, il faut la dépasser d'un cran. */
  html .carnet :is(h1, h2, h3, h4) {
    color: var(--carnet-encre);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .carnet :where(p, li, blockquote) {
    max-width: none;
  }

  /* Un lien se souligne en pêche : un trait épais, qui passe à l'encre quand
     on le survole. */
  .carnet a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--carnet-peche);
    text-underline-offset: 0.22em;
    transition: text-decoration-color 150ms ease;
  }

  .carnet a:hover {
    text-decoration-color: var(--carnet-encre);
  }

  .carnet :focus-visible {
    outline: 2px solid var(--carnet-encre);
    outline-offset: 3px;
    border-radius: var(--radius-xs, 4px);
  }

  .carnet__barre,
  .carnet__page,
  .carnet__pied {
    width: 100%;
    max-width: var(--carnet-colonne);
    margin-inline: auto;
  }

  .carnet__barre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding: 1.5rem 0 1.25rem;
    border-bottom: 1px solid var(--carnet-trait);
    font-size: 0.9375rem;
  }

  .carnet__nom {
    font-weight: 600;
  }

  .carnet .carnet__nom,
  .carnet .carnet__liens a {
    text-decoration-color: transparent;
  }

  .carnet .carnet__nom:hover,
  .carnet .carnet__liens a:hover {
    text-decoration-color: var(--carnet-peche);
  }

  .carnet__liens {
    display: flex;
    gap: 1.25rem;
    color: var(--carnet-gris);
  }

  .carnet__page {
    flex: 1;
    padding: 4rem 0 3rem;
    outline: none;
  }

  .carnet__pied {
    padding: 2rem 0 3rem;
    color: var(--carnet-gris);
    font-size: 0.875rem;
  }

  .carnet__pied p {
    margin: 0;
  }

  .carnet__pied span {
    margin: 0 0.4em;
  }

  .carnet hr,
  .carnet__pied::before {
    display: block;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--carnet-trait);
  }

  .carnet__pied::before {
    content: '';
    margin-bottom: 1.25rem;
  }

  @media (max-width: 30rem) {
    .carnet {
      font-size: 1.0625rem;
    }

    .carnet__page {
      padding-top: 2.75rem;
    }
  }
</style>
