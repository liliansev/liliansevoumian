---
interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedDate?: string;
  modifiedDate?: string;
  articleSchema?: object;
  breadcrumbs?: Array<{ name: string; url: string }>;
  noindex?: boolean;
}

const {
  title = "Lilian Sevoumian | Expert Automatisation Make & n8n - Freelance",
  description = "Freelance expert en automatisation Make & n8n. +5\u00A0ans d'expérience, certification Make niveau\u00A05 (1er français). Formations, audits et projets sur-mesure.",
  ogType = 'website',
  ogImage: customOgImage,
  publishedDate,
  modifiedDate,
  articleSchema,
  breadcrumbs,
  noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = customOgImage ? new URL(customOgImage, Astro.site) : new URL('/og-image.svg', Astro.site);

const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem", "position": index + 1, "name": item.name,
    "item": new URL(item.url, Astro.site).toString()
  }))
} : null;

const personSchema = {
  "@context": "https://schema.org", "@type": "Person",
  "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr",
  "image": ogImage.toString(),
  "jobTitle": ["Expert Automatisation", "Freelance Make & n8n", "Consultant No-Code"],
  "description": "Expert Make, n8n et Airtable avec 5\u00A0ans d'expérience.",
  "knowsAbout": ["Make", "n8n", "Airtable", "Automatisation", "No-Code", "IA"],
  "sameAs": ["https://www.linkedin.com/in/liliansevoumian/", "https://github.com/liliansev", "https://www.youtube.com/@lilian.sevoumian"]
};

const serviceSchema = {
  "@context": "https://schema.org", "@type": "ProfessionalService",
  "name": "Lilian Sevoumian - Automatisation No-Code",
  "description": "Services d'automatisation et de conseil No-Code.",
  "url": "https://liliansevoumian.fr", "image": ogImage.toString(),
  "priceRange": "€€", "areaServed": "France",
  "serviceType": ["Automatisation", "Conseil No-Code", "Formation Make", "Formation n8n"],
  "provider": { "@type": "Person", "name": "Lilian Sevoumian" }
};

const websiteSchema = {
  "@context": "https://schema.org", "@type": "WebSite",
  "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr",
  "description": description, "inLanguage": "fr-FR",
  "author": { "@type": "Person", "name": "Lilian Sevoumian" }
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-K46TZ5RV');</script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="author" content="Lilian Sevoumian" />
    <meta name="theme-color" content="#0F1117" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Lilian Sevoumian" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === 'article' && publishedDate && <meta property="article:published_time" content={publishedDate} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    <link rel="icon" type="image/svg+xml" href="/favicon_liliansevoumian.svg" />
    <link rel="apple-touch-icon" href="/favicon_liliansevoumian.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body class="bg-[#0F1117] text-[#E2E8F0] font-sans antialiased overflow-x-hidden">
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K46TZ5RV" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--accent)] focus:text-white focus:outline-none">
      Aller au contenu principal
    </a>
    <slot />

    <div data-tf-live="01KH8WV0A616HRRTJ3BGB81W0Q"></div>
    <script is:inline src="//embed.typeform.com/next/embed.js"></script>

    <script src="../scripts/text-reveal.ts"></script>
    <script>
      function initAnimations(): void {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        document.querySelectorAll<HTMLElement>('.fade-in-section').forEach((el) => {
          if (prefersReducedMotion) { el.classList.add('is-visible'); return; }
          const obs = new IntersectionObserver((entries) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
          }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
          obs.observe(el);
        });

        document.querySelectorAll<HTMLElement>('.mc-stagger').forEach((container) => {
          const cards = container.querySelectorAll<HTMLElement>('.mc-card');
          if (prefersReducedMotion) { cards.forEach(c => c.classList.add('is-visible')); return; }
          const obs = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) { cards.forEach(c => c.classList.add('is-visible')); obs.unobserve(e.target); }
            });
          }, { threshold: 0.1 });
          obs.observe(container);
        });

        document.querySelectorAll<HTMLElement>('.stat-item').forEach((el) => {
          if (prefersReducedMotion) { el.classList.add('is-visible'); return; }
          const obs = new IntersectionObserver((entries) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
          }, { threshold: 0.3 });
          obs.observe(el);
        });

        const toolsWall = document.getElementById('tools-wall');
        if (toolsWall) {
          if (prefersReducedMotion) { toolsWall.classList.add('is-visible'); }
          else {
            const wallObs = new IntersectionObserver((entries) => {
              entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); wallObs.unobserve(e.target); } });
            }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
            wallObs.observe(toolsWall);
          }
        }

        const nav = document.getElementById('main-nav');
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              nav?.classList.toggle('scrolled', window.scrollY > 50);
              ticking = false;
            });
            ticking = true;
          }
        });
      }

      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initAnimations); }
      else { initAnimations(); }
      document.addEventListener('astro:page-load', initAnimations);
    </script>
  </body>
</html>
