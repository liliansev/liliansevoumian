---
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedDate?: string;
  modifiedDate?: string;
  articleSchema?: object;
  breadcrumbs?: Array<{ name: string; url: string }>;
  noindex?: boolean;
  faqSchema?: Array<{ question: string; answer: string }>;
}

const {
  title = "Lilian Sevoumian | Expert Automatisation Make & n8n - Freelance",
  description = "Freelance expert en automatisation Make & n8n. +5 ans d'expérience, certification Make niveau 5 (1er français). Formations, diagnostics et projets sur-mesure.",
  ogType = 'website',
  ogImage: customOgImage,
  ogImageAlt = "Lilian Sevoumian — Expert Automatisation Make & n8n",
  publishedDate,
  modifiedDate,
  articleSchema,
  breadcrumbs,
  noindex = false,
  faqSchema
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = customOgImage ? new URL(customOgImage, Astro.site) : new URL('/og-image.jpg', Astro.site);

const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem", "position": index + 1, "name": item.name,
    "item": new URL(item.url, Astro.site).toString()
  }))
} : null;

const personSchema = {
  "@context": "https://schema.org", "@type": "Person",
  "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr",
  "image": ogImage.toString(),
  "jobTitle": ["Expert Automatisation", "Freelance Make & n8n", "Consultant No-Code"],
  "description": "Expert Make, n8n et Airtable avec 5 ans d'expérience.",
  "knowsAbout": ["Make", "n8n", "Airtable", "Automatisation", "No-Code", "IA"],
  "sameAs": ["https://www.linkedin.com/in/liliansevoumian/", "https://github.com/liliansev", "https://www.youtube.com/@lilian.sevoumian", "https://liliansevoumian.substack.com/"]
};

const serviceSchema = {
  "@context": "https://schema.org", "@type": "ProfessionalService",
  "name": "Lilian Sevoumian - Automatisation No-Code",
  "description": "Services d'automatisation et de conseil No-Code.",
  "url": "https://liliansevoumian.fr", "image": ogImage.toString(),
  "priceRange": "€€", "areaServed": "France",
  "serviceType": ["Automatisation", "Conseil No-Code", "Formation Make", "Formation n8n"],
  "provider": { "@type": "Person", "name": "Lilian Sevoumian" }
};

function safeJsonLd(obj: object): string {
  return JSON.stringify(obj).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
}

const websiteSchema = {
  "@context": "https://schema.org", "@type": "WebSite",
  "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr",
  "description": description, "inLanguage": "fr-FR",
  "author": { "@type": "Person", "name": "Lilian Sevoumian" }
};

const faqPageSchema = faqSchema ? {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": faqSchema.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
} : null;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <script is:inline>
      // Anti-FOUC theme : pose .dark / .light AVANT render.
      // Priorité : choix utilisateur (localStorage) > prefers-color-scheme OS.
      // Listener matchMedia : si pas de choix user, suit les changements OS en live.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var mql = window.matchMedia('(prefers-color-scheme: dark)');
          var systemDark = mql.matches;
          var isDark = stored === 'dark' || (!stored && systemDark);
          var root = document.documentElement;
          root.classList.toggle('dark', isDark);
          if (stored === 'light') root.classList.add('light');
          root.classList.add('js-ready');

          // Suit l'OS en live (changements pendant la session) sauf si user override
          mql.addEventListener('change', function (e) {
            if (localStorage.getItem('theme')) return; // override actif → ignore
            root.classList.toggle('dark', e.matches);
            document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
              btn.setAttribute('aria-pressed', String(e.matches));
              btn.setAttribute(
                'aria-label',
                e.matches ? 'Activer le mode clair' : 'Activer le mode sombre'
              );
            });
          });
        } catch (e) {
          document.documentElement.classList.add('js-ready');
        }
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="author" content="Lilian Sevoumian" />
    <meta name="theme-color" content="#FCFCFD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F1E26" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Lilian Sevoumian" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {ogType === 'article' && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.toString()} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={safeJsonLd(personSchema)} />
    <script type="application/ld+json" set:html={safeJsonLd(serviceSchema)} />
    <script type="application/ld+json" set:html={safeJsonLd(websiteSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />}
    {articleSchema && <script type="application/ld+json" set:html={safeJsonLd(articleSchema)} />}
    {faqPageSchema && <script type="application/ld+json" set:html={safeJsonLd(faqPageSchema)} />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon_liliansevoumian.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />
    <link rel="preconnect" href="https://taap.it" crossorigin />

    <style is:global>
      @import "../styles/global.css";
    </style>
    <script is:inline async src="https://taap.it/scripts/tracker.js" data-project="pk_b238afbc093083b15bf02b73e03d494f" data-track-outbound="true" data-track-forms="true"></script>
    <script is:inline defer data-website-id="dfid_Mq8wt9KvIisuofpYWZouo" data-domain="liliansevoumian.fr" data-api-url="/api/dfst-events" src="/js/script.js"></script>
  </head>
  <body class="antialiased overflow-x-hidden m-0 p-0 relative">
    <a href="#main-content" class="skip-link">
      Aller au contenu principal
    </a>
    <div class="technical-grid" aria-hidden="true"></div>
    <slot />

<script>
      function initMotion(): void {
        const body = document.body;
        if (body.dataset.motionInit) return;
        body.dataset.motionInit = 'true';

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Reveal pass — opacity + translateY on viewport entry
        const reveals = document.querySelectorAll<HTMLElement>('.reveal');
        const viewportH = window.innerHeight;

        if (prefersReducedMotion) {
          reveals.forEach((el) => el.classList.add('is-visible'));
        } else {
          // 1. Mark already-visible reveals immediately (avoids cloak above the fold)
          reveals.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.top < viewportH * 0.95) {
              el.classList.add('is-visible');
            }
          });

          // 2. IO for the rest (below the fold)
          const revealObs = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                revealObs.unobserve(e.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
          reveals.forEach((el) => {
            if (!el.classList.contains('is-visible')) revealObs.observe(el);
          });

          // 3. Fail-safe — after 2.5s, force-reveal anything still hidden
          window.setTimeout(() => {
            document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)').forEach((el) => {
              el.classList.add('is-visible');
            });
          }, 2500);
        }

        // Section-active state — section-number vire violet, grid corners virent violet
        const sections = document.querySelectorAll<HTMLElement>('section[data-section]');
        if (sections.length > 0 && !prefersReducedMotion) {
          const sectionObs = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('section-active');
              } else {
                e.target.classList.remove('section-active');
              }
            });
          }, { threshold: [0.4], rootMargin: '-20% 0px -20% 0px' });
          sections.forEach((s) => sectionObs.observe(s));
        }

        // Grid corner pulse — when a corner enters viewport center, it animates
        const corners = document.querySelectorAll<HTMLElement>('.grid-corner');
        if (corners.length > 0 && !prefersReducedMotion) {
          const cornerObs = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('grid-corner-pulse');
                cornerObs.unobserve(e.target);
              }
            });
          }, { threshold: 0.5, rootMargin: '-30% 0px -30% 0px' });
          corners.forEach((c) => cornerObs.observe(c));
        }
      }

      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initMotion); }
      else { initMotion(); }
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
