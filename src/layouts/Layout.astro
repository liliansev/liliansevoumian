---
import '@fontsource-variable/geist';
import '../styles/global.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedDate?: string;
  modifiedDate?: string;
  articleSchema?: object;
  breadcrumbs?: Array<{ name: string; url: string }>;
  noindex?: boolean;
  faqSchema?: Array<{ question: string; answer: string }>;
}

const {
  title = "Freelance automatisation & agents IA · n8n, Make · Lilian Sevoumian",
  description = "Freelance en automatisation et IA. J'automatise vos processus métier avec n8n, Make et des agents IA sur-mesure. Make certifié niveau 5, réponse sous 48 h.",
  ogType = 'website',
  ogImage: customOgImage,
  // L'alt décrit la vignette telle qu'elle est, pas le site : elle porte la phrase
// du hero sur l'aplat lime, c'est ce que lit qui ne voit pas l'image.
ogImageAlt = "« J'automatise ce que vos équipes font encore à la main » — Lilian Sevoumian, freelance automatisation et agents IA",
  publishedDate,
  modifiedDate,
  articleSchema,
  breadcrumbs,
  noindex = false,
  faqSchema
} = Astro.props;

/* Sans slash final, comme les 217 liens internes du site et comme le sitemap.
   `Astro.url.pathname` en porte un, si bien que le canonical déclarait une URL
   que RIEN sur le site ne pointait : les liens, llms.txt et le JSON-LD
   contredisaient tous la seule balise censée trancher la duplication.
   La racine reste « / », elle ne se normalise pas. */
const cheminCanonique = Astro.url.pathname.replace(/(.+)\/$/, '$1');
const canonicalURL = new URL(cheminCanonique, Astro.site);
// PNG palettisé et non JPEG : la vignette est un aplat lime avec de la typo et
// une bande de surlignage — trois couleurs. Le JPEG y posait un halo sur chaque
// bord de lettre pour 51 Ko ; le PNG-8 est net pour 14.
const ogImage = customOgImage ? new URL(customOgImage, Astro.site) : new URL('/og-image.png', Astro.site);

const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem", "position": index + 1, "name": item.name,
    "item": new URL(item.url, Astro.site).toString()
  }))
} : null;

const personSchema = {
  "@context": "https://schema.org", "@type": "Person",
  "@id": "https://liliansevoumian.fr/#person",
  "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr",
  "image": ogImage.toString(),
  "jobTitle": ["Freelance automatisation & IA", "Expert n8n & Make", "Consultant automatisation des processus", "Formateur no-code"],
  "description": "Freelance et formateur en automatisation et IA : automatisation des processus métier avec n8n, Make, Airtable et agents IA sur-mesure.",
  /* Les outils listés ici sont exactement ceux que la section « outils » de la
     home affiche : un moteur de réponse qui compare les deux ne doit pas
     trouver de liste plus courte dans le balisage que sur la page. */
  "knowsAbout": ["Automatisation des processus", "Agents IA", "Make", "n8n", "Airtable", "Workflow", "Intégration API", "No-Code", "Claude", "Claude Code", "Codex", "Mistral AI", "Notion", "IA"],
  "hasCredential": [
    { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification",
      "name": "Make Certified Niveau 5 (premier certifié en France)",
      "recognizedBy": { "@type": "Organization", "name": "Make", "url": "https://www.make.com" } },
    { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification",
      "name": "Airtable Certified",
      "recognizedBy": { "@type": "Organization", "name": "Airtable", "url": "https://airtable.com" } }
  ],
  "address": { "@type": "PostalAddress", "addressRegion": "Ile-de-France", "addressCountry": "FR" },
  "sameAs": ["https://www.linkedin.com/in/liliansevoumian/", "https://github.com/liliansev", "https://www.youtube.com/@lilian.sevoumian", "https://liliansevoumian.substack.com/"]
};

const serviceSchema = {
  "@context": "https://schema.org", "@type": "ProfessionalService",
  "@id": "https://liliansevoumian.fr/#service",
  "name": "Lilian Sevoumian - Automatisation No-Code",
  "description": "Automatisation des processus métier, agents IA, intégration et formation no-code (n8n, Make, Airtable).",
  "url": "https://liliansevoumian.fr", "image": ogImage.toString(),
  "areaServed": [
    { "@type": "Country", "name": "France" },
    { "@type": "Place", "name": "Île-de-France" },
    { "@type": "Place", "name": "Europe" }
  ],
  "serviceType": ["Automatisation des processus", "Agents IA", "Intégration", "Workflow", "Conseil no-code", "Formation Make", "Formation n8n"],
  "provider": { "@id": "https://liliansevoumian.fr/#person" }
};

function safeJsonLd(obj: object): string {
  return JSON.stringify(obj).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
}

const websiteSchema = {
  "@context": "https://schema.org", "@type": "WebSite",
  "@id": "https://liliansevoumian.fr/#website",
  "name": "Lilian Sevoumian", "url": "https://liliansevoumian.fr",
  "description": description, "inLanguage": "fr-FR",
  "author": { "@id": "https://liliansevoumian.fr/#person" }
};

const faqPageSchema = faqSchema ? {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": faqSchema.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
} : null;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <script is:inline>
      // La DA n'a qu'une surface : plus de bascule, donc plus de script de
      // thème. Il ne reste que .js-ready, qui arme le voile des .reveal —
      // sans JS tout reste peint, l'animation n'est jamais un gate.
      (function () {
        document.documentElement.classList.add('js-ready');

        // VERROU DE DÉFILEMENT PARTAGÉ, compté par propriétaire.
        // Deux surfaces bloquent le scroll — le menu mobile (Navigation) et
        // l'overlay cal.com (plus bas) — et chacune écrivait `body.overflow`
        // en direct, dont `''` à la fermeture. Le dernier à fermer relâchait
        // donc le verrou de l'autre. Le chemin visible : menu ouvert, la barre
        // de nav reste au-dessus (z-50 contre z-49) et son CTA « Automatiser
        // mon business » reste tapable ; l'overlay se posait sur le menu, et le
        // refermer laissait le menu plein écran avec la page qui défile
        // derrière. Un compteur rend l'ordre des fermetures sans conséquence :
        // le scroll ne revient qu'une fois le dernier propriétaire parti.
        var verrous = {};
        window.__verrouDefilement = function (proprietaire, actif) {
          if (actif) verrous[proprietaire] = 1;
          else delete verrous[proprietaire];
          if (document.body) {
            document.body.style.overflow = Object.keys(verrous).length ? 'hidden' : '';
          }
        };

        // Failsafe garanti, indépendant du module de reveal (fin de <body>).
        // .js-ready (posé ci-dessus) arme le cloak `opacity:0` des .reveal.
        // Si le module échoue (erreur JS, chunk bloqué, CSP), il ne dé-cloake
        // jamais → page blanche. Ce timer s'exécute depuis le script inline du
        // <head>, qui tourne toujours : le contenu réapparaît quoi qu'il arrive.
        //
        // La condition `motionInit` est ce qui manquait, et son absence coûtait
        // toute la chorégraphie du site. Sans elle, le timer dé-cloakait TOUS
        // les `.reveal` de la page à 2,5 s, où qu'ils soient : mesuré sur la
        // home, trente-cinq des trente-huit se dévoilaient hors écran, avant
        // même que le lecteur ait scrollé. L'observateur ne trouvait plus rien
        // à observer. Le site payait le voile — un `opacity: 0` piloté par JS
        // sur trente-cinq blocs, avec le risque LCP que ça implique — sans
        // jamais rien obtenir en échange.
        // Le module pose `body.dataset.motionInit` dès qu'il démarre : le
        // filet ne se déclenche donc plus que dans le cas qu'il vise, celui où
        // le module n'a pas tourné du tout.
        window.setTimeout(function () {
          if (document.body && document.body.dataset.motionInit) return;
          document.querySelectorAll('.reveal:not(.is-visible)').forEach(function (el) {
            el.classList.add('is-visible');
          });
        }, 2500);
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="author" content="Lilian Sevoumian" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Lilian Sevoumian" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {ogType === 'article' && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.toString()} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={safeJsonLd(personSchema)} />
    <script type="application/ld+json" set:html={safeJsonLd(serviceSchema)} />
    <script type="application/ld+json" set:html={safeJsonLd(websiteSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />}
    {articleSchema && <script type="application/ld+json" set:html={safeJsonLd(articleSchema)} />}
    {faqPageSchema && <script type="application/ld+json" set:html={safeJsonLd(faqPageSchema)} />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon_liliansevoumian.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />
    <link rel="preconnect" href="https://taap.it" crossorigin />

    <script is:inline async src="https://taap.it/scripts/tracker.js" data-project="pk_b238afbc093083b15bf02b73e03d494f" data-track-outbound="true"></script>
    {/* File DataFast : capture les goals déclenchés avant le chargement du script. */}
    <script is:inline>
      window.datafast = window.datafast || function () {
        (window.datafast.q = window.datafast.q || []).push(arguments);
      };
    </script>
    <script is:inline defer data-website-id="dfid_Mq8wt9KvIisuofpYWZouo" data-domain="liliansevoumian.fr" data-api-url="/api/dfst-events" src="/js/script.js"></script>

    <!-- Embed cal.com : la réservation se fait dans une popup ON-SITE (pas un onglet,
         pas de redirection). Le visiteur ne quitte jamais le domaine → DataFast
         attribue le goal "call_booked" via son empreinte (marche en cookieless).
         Funnel complet : visite → lead_call (clic) → call_booked (résa confirmée). -->
    <script is:inline>
      (function () {
        function initCalEmbed() {
          var links = document.querySelectorAll('a[href*="cal.com/lilian-sevoumian"]');
          var overlay = document.getElementById('cal-overlay');
          if (!links.length || !overlay) return;
          var lastSource = 'cal_embed';
          // 3. Loader officiel de l'embed cal.com. Le stub `window.Cal` ne déclenche
          //    AUCUN réseau tant qu'on ne l'appelle pas : embed.js (~80 KB) n'est
          //    fetché qu'au premier clic CTA (bootCal), pas pour 100 % des visiteurs.
          (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");

          var calBooted = false;
          function bootCal() {
            if (calBooted) return;
            calBooted = true;
            window.Cal("init", { origin: "https://cal.com" });
            window.Cal("on", { action: "bookingSuccessful", callback: onBooked });
            window.Cal("on", { action: "bookingSuccessfulV2", callback: onBooked });
          }

          // Overlay plein écran : ouverture / fermeture + scroll lock + focus management
          // (dialog aria-modal : focus le CONTENEUR à l'open — pas le 1er focusable,
          // qui déclenche le cadre de focus noir iOS — trap Tab, restore au close).
          var closeBtn = overlay.querySelector('[data-cal-close]');
          var inited = false;
          var lastFocused = null;
          // Entre "lead_call" au clic et "call_booked" à la confirmation, tout se
          // passe dans un iframe cross-origin : la déperdition y était totalement
          // invisible. `booked` distingue la fermeture qui suit une réservation
          // de celle qui l'abandonne — sans lui, les deux se ressemblent.
          var booked = false;
          function openOverlay() {
            booked = false;
            bootCal();
            if (!inited) {
              // Le site n'a plus qu'une surface : l'embed cal.com est figé en
              // clair, il ne lit plus une classe qui n'existe plus.
              window.Cal("inline", { elementOrSelector: "#cal-embed-target", calLink: "lilian-sevoumian/20min", config: { layout: "month_view", theme: "light" } });
              inited = true;
            }
            lastFocused = document.activeElement;
            overlay.classList.add('is-open');
            overlay.setAttribute('aria-hidden', 'false');
            window.__verrouDefilement('cal', true);
            window.setTimeout(function () { overlay.focus(); }, 50);
          }
          function closeOverlay() {
            var wasOpen = overlay.classList.contains('is-open');
            overlay.classList.remove('is-open');
            overlay.setAttribute('aria-hidden', 'true');
            window.__verrouDefilement('cal', false);
            if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
            lastFocused = null;
            if (wasOpen && !booked && typeof window.datafast === 'function') {
              window.datafast('cal_abandoned', { source: lastSource });
            }
          }

          // Trap Tab dans l'overlay ouvert (même pattern que le menu mobile).
          overlay.addEventListener('keydown', function (e) {
            if (!overlay.classList.contains('is-open') || e.key !== 'Tab') return;
            var focusable = overlay.querySelectorAll('a, button, iframe, [tabindex]:not([tabindex="-1"])');
            if (!focusable.length) return;
            var first = focusable[0];
            var last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) { last.focus(); e.preventDefault(); }
            else if (!e.shiftKey && document.activeElement === last) { first.focus(); e.preventDefault(); }
          });

          // Clic sur un CTA cal.com → ouvre l'overlay (jamais un nouvel onglet ni la popup native).
          document.addEventListener('click', function (ev) {
            var t = ev.target && ev.target.closest ? ev.target.closest('a[href*="cal.com/lilian-sevoumian"]') : null;
            if (!t) return;
            ev.preventDefault();
            lastSource = t.getAttribute('data-fast-goal-source') || 'cal_embed';
            openOverlay();
          });
          if (closeBtn) closeBtn.addEventListener('click', closeOverlay);
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeOverlay();
          });

          // Résa confirmée → goal "call_booked" (dédup par uid) + fermeture après un court instant.
          var seen = {};
          function onBooked(e) {
            var data = (e && e.detail && e.detail.data) || {};
            var uid = data.uid || (data.booking && data.booking.uid) || JSON.stringify(data).slice(0, 80);
            if (seen[uid]) return;
            seen[uid] = 1;
            booked = true;
            if (typeof window.datafast === 'function') {
              window.datafast('call_booked', { source: lastSource });
            }
            window.setTimeout(closeOverlay, 1800);
          }
          // Les Cal("on", …) sont enregistrés dans bootCal() au premier clic,
          // pour ne pas déclencher le fetch d'embed.js au chargement de la page.
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCalEmbed);
        else initCalEmbed();
      })();
    </script>
  </head>
  <body class="antialiased m-0 p-0 relative">
    <a href="#main-content" class="skip-link">
      Aller au contenu principal
    </a>
    <div class="technical-grid" aria-hidden="true"></div>
    <slot />

    <!-- Overlay plein écran de réservation cal.com (barre + croix, scroll lock). -->
    <div id="cal-overlay" class="cal-overlay" role="dialog" aria-modal="true" aria-label="Réserver un appel de 20 min" aria-hidden="true" tabindex="-1">
      <div class="cal-overlay-bar">
        <span class="cal-overlay-title">Appel · 20 min</span>
        <button type="button" class="cal-overlay-close" data-cal-close aria-label="Fermer"></button>
      </div>
      <div class="cal-overlay-body">
        <div id="cal-embed-target"></div>
      </div>
    </div>

<script>
      function initMotion(): void {
        const body = document.body;
        if (body.dataset.motionInit) return;
        body.dataset.motionInit = 'true';

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Reveal pass — opacity + translateY on viewport entry
        const reveals = document.querySelectorAll<HTMLElement>('.reveal');
        const viewportH = window.innerHeight;

        if (prefersReducedMotion) {
          reveals.forEach((el) => el.classList.add('is-visible'));
        } else {
          // 1. Mark already-visible reveals immediately (avoids cloak above the fold)
          reveals.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.top < viewportH * 0.95) {
              el.classList.add('is-visible');
            }
          });

          // 2. IO for the rest (below the fold)
          const revealObs = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                revealObs.unobserve(e.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
          reveals.forEach((el) => {
            if (!el.classList.contains('is-visible')) revealObs.observe(el);
          });

          // 3. Fail-safe — déplacé dans le script inline du <head> (Layout),
          //    qui s'exécute toujours. Garantit le dé-cloak même si ce module
          //    ne tourne pas (erreur JS / chunk bloqué). Ne pas le dupliquer ici.
        }

        // Boucles ambiantes : en pause tant que le conteneur n'est pas à
        // l'écran. Marge d'un demi-écran pour que rien ne démarre sous les yeux
        // du lecteur. Sans observateur, on repasse en lecture continue plutôt
        // que de laisser des maquettes figées.
        const idlers = document.querySelectorAll<HTMLElement>('[data-motion-pause]');
        if (idlers.length && 'IntersectionObserver' in window) {
          idlers.forEach((el) => el.setAttribute('data-motion-idle', ''));
          const idleObs = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              const el = e.target as HTMLElement;
              if (e.isIntersecting) el.removeAttribute('data-motion-idle');
              else el.setAttribute('data-motion-idle', '');
            });
          }, { rootMargin: '50% 0px' });
          idlers.forEach((el) => idleObs.observe(el));
        }
      }

      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initMotion); }
      else { initMotion(); }
      document.addEventListener('astro:page-load', initMotion);
    </script>

    <!-- Goals d'intention. La distinction avec les goals d'engagement, qui
         restent exclus : un scroll ne dit rien de ce que le lecteur veut, il dit
         qu'il descend. Bouger un curseur, ouvrir une objection, aller lire un cas
         entier sont des gestes délibérés, et chacun se rattache à un endroit
         précis de la page — c'est ce qui rend une déperdition lisible.
         Chaque goal continu n'est émis qu'une fois : on mesure « il a essayé »,
         pas combien de fois. -->
    <script>
      (function () {
        function goal(name, props) {
          if (typeof window.datafast === 'function') window.datafast(name, props || {});
        }

        // Le simulateur est la deuxième section et le principal signal d'intérêt
        // de la page. Il n'était pas instrumenté du tout.
        var roiSent = false;
        document.addEventListener('input', function (ev) {
          if (roiSent) return;
          var t = ev.target;
          if (!t || t.type !== 'range' || !t.closest || !t.closest('#roi')) return;
          roiSent = true;
          goal('roi_used');
        }, true);

        // Une question ouverte est une objection nommée : le libellé dit
        // laquelle. `toggle` ne remonte pas — d'où la phase de capture.
        var faqSeen = {};
        document.addEventListener('toggle', function (ev) {
          var d = ev.target;
          if (!d || d.tagName !== 'DETAILS' || !d.open || !d.closest('#faq')) return;
          // Le caret est du chrome : laissé dans le libellé, le goal remonterait
          // « … + ». `.faq-num` est retiré par précaution — les numéros de
          // question ont disparu du markup, mais un libellé de goal ne doit pas
          // dépendre de ce qui décore le résumé.
          var sum = d.querySelector('summary');
          var label = '?';
          if (sum) {
            var clone = sum.cloneNode(true);
            var chrome = clone.querySelectorAll('[aria-hidden="true"], .faq-num');
            for (var i = 0; i < chrome.length; i++) chrome[i].remove();
            label = clone.textContent.trim().replace(/\s+/g, ' ').slice(0, 80);
          }
          if (faqSeen[label]) return;
          faqSeen[label] = 1;
          goal('faq_opened', { question: label });
        }, true);

        // Aller lire un cas entier est le geste de preuve le plus coûteux que la
        // page propose. Aucun de ces liens n'était tagué.
        document.addEventListener('click', function (ev) {
          var a = ev.target && ev.target.closest ? ev.target.closest('a[href^="/cas-clients"]') : null;
          if (!a) return;
          goal('case_opened', { href: a.getAttribute('href') });
        });
      })();
    </script>

    <!-- Tracking DataFast — inventaire des goals émis.
         1) "lead_call"     → clic sur un CTA de réservation, posé en attribut sur
                              chaque lien cal.com, avec sa source (hero, offres…).
         2) "call_booked"   → réservation confirmée, émis par le listener embed.
         3) "cal_abandoned" → overlay fermé sans réservation. Comble le trou entre
                              1 et 2, qui se jouait dans un iframe cross-origin.
         4) "lead_email"    → clic sur l'adresse mail (pied de page, contact).
         5) "roi_used"      → premier mouvement d'un curseur du simulateur.
         6) "faq_opened"    → première ouverture d'une question, libellé en prop.
         7) "case_opened"   → clic vers un cas client, href en prop.
