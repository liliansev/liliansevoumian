---
/*
 * BookingPanel.astro — panneau de réservation du hero (structure « Offre directe »).
 *
 * Le wireframe met l'agenda au-dessus de la ligne de flottaison : ici, un embed
 * Cal.com inline, monté PARESSEUSEMENT (intersection + idle) pour ne pas peser
 * sur le LCP — qui reste le H1 texte du hero.
 *
 * ⚠ Ce composant ne porte AUCUN script : l'intégration cal.com vit entièrement
 * dans Layout.astro, qui possède déjà `window.Cal` (stub + overlay de réservation).
 * Deux amorces concurrentes se neutralisent — le stub officiel ne crée `Cal.ns`
 * qu'à son premier appel, donc un second `if (window.Cal) return` récupère un
 * objet sans `ns` et casse silencieusement. Layout monte ici via [data-booking-*].
 *
 * Trois états (règle CLAUDE.md « Async UI »), pilotés par [data-state] :
 *   · chargement — squelette de créneaux aux dimensions finales (zéro CLS)
 *   · ready      — l'iframe Cal remplace le squelette
 *   · error      — le squelette est retiré et le lien direct cal.com prend le relais
 *
 * Sans JS, le <a> de secours reste la seule chose visible et fonctionnelle.
 */
interface Props {
  /** Étiquette de provenance pour les goals DataFast. */
  source?: string;
  class?: string;
}

const { source = 'hero', class: className = '' } = Astro.props;

const CAL_LINK = 'lilian-sevoumian/20min';
const CAL_URL = `https://cal.com/${CAL_LINK}`;
---

<div
  class:list={['booking-panel card-soft', className]}
  data-booking-panel
  data-cal-link={CAL_LINK}
  data-source={source}
>
  <div class="booking-head">
    <span class="mono-caption text-[var(--color-ink-low)]">RÉSERVER UN CRÉNEAU</span>
    <span class="mono-caption text-[var(--color-ink-low)]">20 MIN · VISIO</span>
  </div>

  <div class="booking-body">
    {/* Squelette — dimensions finales, purement décoratif pour les lecteurs d'écran. */}
    <div class="booking-skeleton" data-booking-skeleton aria-hidden="true">
      <div class="booking-skeleton-rows">
        {Array.from({ length: 9 }).map(() => <span class="booking-pill"></span>)}
      </div>
    </div>

    {/* Cible de montage de l'embed Cal. */}
    <div class="booking-cal" data-booking-cal></div>

    <p class="booking-status mono-caption" data-booking-status role="status" aria-live="polite">
      CHARGEMENT DE L'AGENDA…
    </p>
  </div>

  {/* Double rôle, d'où le fait qu'il reste visible même quand l'agenda est
      monté : sans JS (ou embed en échec) c'est le seul chemin de réservation,
      et sinon Layout.astro intercepte le clic pour ouvrir l'agenda en grand
      dans l'overlay plein écran — utile depuis un panneau de 600 px. */}
  <div class="booking-foot">
    <a
      href={CAL_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary w-full justify-center"
      data-fast-goal="lead_call"
      data-fast-goal-source={source}
    >
      Voir l'agenda en grand
    </a>
    <p class="mono-caption text-[var(--color-ink-low)] text-center m-0">
      SANS ENGAGEMENT · RÉPONSE SOUS 48 H
    </p>
  </div>
</div>

<style>
  .booking-panel {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .booking-head,
  .booking-foot {
    display: flex;
    padding: 14px 18px;
  }

  .booking-head {
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--color-divider);
    background: var(--color-surface-low);
  }

  .booking-foot {
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--color-divider);
  }

  .booking-body {
    position: relative;
    /* Hauteur FIXE, pas min-height : cal.com dimensionne son iframe sur son
       propre contenu (~700 px, variable selon le mois affiché). Une boîte
       élastique ferait sauter toute la page au montage de l'embed. Ici le
       squelette et l'agenda occupent exactement la même boîte → zéro CLS,
       et l'agenda scrolle à l'intérieur si le mois déborde. */
    height: 560px;
  }

  /* Desktop : la colonne fait ~540 px de large, sous le seuil où cal.com place
     les créneaux À CÔTÉ du calendrier — il les empile donc DESSOUS, ce qui
     demande ~656 px. À 600 px le seul créneau réservable tombait derrière le
     scroll interne : la boîte est calée au-dessus de ce besoin. */
  @media (min-width: 1024px) {
    .booking-body {
      height: 664px;
    }
  }

  /* ── Squelette de créneaux ───────────────────────────────────────────── */
  .booking-skeleton {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 18px 44px;
  }

  .booking-skeleton-rows {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
  }

  .booking-pill {
    height: 38px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-divider);
    background: var(--color-surface-low);
    animation: booking-pulse 1600ms var(--ease-out-quint) infinite;
  }

  .booking-pill:nth-child(3n + 2) { animation-delay: 120ms; }
  .booking-pill:nth-child(3n + 3) { animation-delay: 240ms; }

  /* En dark, surface-low et divider sont trop proches du papier : le squelette
     se lisait comme un panneau vide plutôt que comme un chargement. */
  :global(html.dark) .booking-pill {
    background: var(--color-surface-high);
    border-color: var(--color-grid-line-active);
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not(.light)) .booking-pill {
      background: var(--color-surface-high);
      border-color: var(--color-grid-line-active);
    }
  }

  @keyframes booking-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  /* ── Embed Cal ───────────────────────────────────────────────────────── */
  .booking-cal {
    height: 100%;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    /* Le scroll de l'agenda ne doit pas embarquer la page avec lui en fin de
       course (chaînage), sinon un swipe dans le calendrier fait défiler le hero. */
    overscroll-behavior: contain;
  }

  .booking-status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    margin: 0;
    text-align: center;
    color: var(--color-ink-low);
  }

  /* Une fois l'agenda monté, squelette et statut disparaissent. */
  .booking-panel[data-state='ready'] .booking-skeleton,
  .booking-panel[data-state='ready'] .booking-status {
    display: none;
  }

  /* Échec de chargement : on retombe sur le CTA direct, sans agenda fantôme. */
  .booking-panel[data-state='error'] .booking-skeleton,
  .booking-panel[data-state='error'] .booking-cal {
    display: none;
  }

  /* Plus d'agenda à loger : la boîte se rétracte sur son message. */
  .booking-panel[data-state='error'] .booking-body {
    height: auto;
    padding: 20px 18px;
  }

  .booking-panel[data-state='error'] .booking-status {
    position: static;
    color: var(--color-ink-mid);
  }

  @media (prefers-reduced-motion: reduce) {
    .booking-pill { animation: none; }
  }
</style>
