---
/*
 * Stack — les quatre outils de la page, une ligne d'usage chacun, en blocs de
 * texte sur deux colonnes. Dernière section avant l'île claire des offres :
 * elle ne trace donc pas de filet à son pied.
 */
import SectionHeader from './SectionHeader.astro';

const tools = [
  { name: 'n8n', use: 'Relier vos applications, orchestrer vos workflows et intégrer des agents IA.' },
  { name: 'Make', use: 'Connecter vos outils avec des scénarios visuels faciles à suivre.' },
  { name: 'Notion', use: 'Organiser les informations et le suivi dont votre équipe a besoin.' },
  { name: 'Airtable', use: 'Structurer vos données et les présenter selon les usages de chaque équipe.' },
];
---

<section id="stack" data-section class="relative px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]">
  <div class="mx-auto max-w-[1200px]">
    <SectionHeader
      title="Des outils choisis pour votre usage."
      body="Vos logiciels, vos données et les personnes qui les utilisent guident le choix technique."
      titleMaxWidth="24ch"
    />

    {/* Quatre entrées sœurs : elles entrent en cascade, dans l'ordre de lecture. */}
    <div class="reveal-stagger grid grid-cols-1 gap-x-[var(--spacing-gouttiere)] gap-y-[var(--spacing-groupe)] md:grid-cols-2">
      {tools.map((tool) => (
        <div class="reveal">
          <h3 class="m-0">{tool.name}</h3>
          <p class="m-0 mt-[var(--spacing-colle)] leading-[var(--leading-body)] text-[var(--color-ink-mid)]">{tool.use}</p>
        </div>
      ))}
    </div>

    {/* Une note, pas un cinquième outil : elle se détache de la grille. */}
    <p class="reveal m-0 mt-[var(--spacing-bloc)] leading-[var(--leading-body)] text-[var(--color-ink-mid)]">
      Pour développer une interface ou une intégration sur mesure, je m’aide aussi
      de Claude Code et Codex. Je relis le code et teste son fonctionnement avant livraison.
    </p>
  </div>
</section>
