---
/*
 * Stack.astro — section §03
 *
 * Layout 2 colonnes Two-Voice : workflow/ (violet, 3 outils) à gauche,
 * ai/ (ember, 2 outils) à droite. La Two-Voice Rule devient une partition
 * spatiale littérale. Mobile : stacked vertical avec headers catégorie.
 *
 * Chips affichent le vrai logo de l'outil (simple-icons via astro-icon).
 */
import SectionHeader from './SectionHeader.astro';
import { Icon } from 'astro-icon/components';

interface Tool {
  name: string;
  icon: string;
  description: string;
  category: string;
}

const workflowTools: Tool[] = [
  { name: 'n8n',    icon: 'simple-icons:n8n',     description: 'Automatisations et Agents IA (Cloud ou Self Host).',                category: 'WORKFLOW · IA'   },
  { name: 'Make',   icon: 'simple-icons:make',    description: 'Automatisations des processus métiers.',                            category: 'WORKFLOW'        },
  { name: 'Notion', icon: 'simple-icons:notion',  description: "Création d'outils métiers sur Notion, Airtable et plus.",          category: 'OUTIL MÉTIER'    },
];

const aiTools: Tool[] = [
  { name: 'Claude Code',   icon: 'simple-icons:anthropic', description: 'Développement de logiciels internes uniquement.',                                                       category: 'IA · DEV'      },
  { name: 'Claude Cowork', icon: 'simple-icons:anthropic', description: "Skill Claude pour piloter vos workflows par dialogue. J'accompagne l'installation et le mentoring de vos équipes.", category: 'IA · COACHING' },
];
---

<section
  id="stack"
  data-section
  data-fast-scroll="scroll_to_section_stack"
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="03"
      label="STACK"
      title="La meilleure stack IA & automation en 2026"
      body="Cinq outils, choisis pour leur fit avec votre besoin. Pas une checklist exhaustive, ce que j'utilise tous les jours."
      titleMaxWidth="22ch"
      bodyMaxWidth="60ch"
    />

    {/* Card unique englobante — split 2 colonnes Two-Voice via gap-px sur fond divider */}
    <div class="relative reveal bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] overflow-hidden">
      <span class="grid-corner tl" aria-hidden="true"></span>
      <span class="grid-corner tr" aria-hidden="true"></span>
      <span class="grid-corner bl" aria-hidden="true"></span>
      <span class="grid-corner br" aria-hidden="true"></span>

      <div class="grid grid-cols-1 md:grid-cols-[3fr_2fr] gap-px bg-[var(--color-divider)]">

        {/* Colonne WORKFLOW (violet) — 3 tools */}
        <div class="bg-[var(--color-paper)] flex flex-col">
          <div class="flex items-baseline justify-between gap-3 px-6 md:px-8 py-4 border-b border-[var(--color-divider)]">
            <span class="mono-label text-[var(--color-violet-deep)]">WORKFLOW</span>
            <span class="mono-caption text-[var(--color-ink-low)]">3 OUTILS</span>
          </div>
          <div class="flex flex-col gap-px bg-[var(--color-divider)]">
            {workflowTools.map((tool) => (
              <div class="bg-[var(--color-paper)] flex flex-col gap-3 px-6 md:px-8 py-5 md:py-6">
                <div class="flex items-center justify-between gap-3 flex-wrap">
                  <div class="inline-flex items-center gap-2.5">
                    <Icon
                      name={tool.icon}
                      class="stack-logo stack-logo-violet"
                      aria-hidden="true"
                    />
                    <span class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">
                      {tool.name}
                    </span>
                  </div>
                  <span class="mono-caption text-[var(--color-ink-low)] whitespace-nowrap">{tool.category}</span>
                </div>
                <span class="text-[var(--color-ink-mid)] text-[length:var(--text-body)] leading-[1.5] max-w-[58ch]">
                  {tool.description}
                </span>
              </div>
            ))}
          </div>
        </div>

        {/* Colonne IA (ember) — 2 tools */}
        <div class="bg-[var(--color-paper)] flex flex-col">
          <div class="flex items-baseline justify-between gap-3 px-6 md:px-8 py-4 border-b border-[var(--color-divider)]">
            <span class="mono-label text-[var(--color-ember-deep)]">IA</span>
            <span class="mono-caption text-[var(--color-ink-low)]">2 OUTILS</span>
          </div>
          <div class="flex flex-col gap-px bg-[var(--color-divider)]">
            {aiTools.map((tool) => (
              <div class="bg-[var(--color-paper)] flex flex-col gap-3 px-6 md:px-8 py-5 md:py-6">
                <div class="flex items-center justify-between gap-3 flex-wrap">
                  <div class="inline-flex items-center gap-2.5">
                    <Icon
                      name={tool.icon}
                      class="stack-logo stack-logo-ember"
                      aria-hidden="true"
                    />
                    <span class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">
                      {tool.name}
                    </span>
                  </div>
                  <span class="mono-caption text-[var(--color-ink-low)] whitespace-nowrap">{tool.category}</span>
                </div>
                <span class="text-[var(--color-ink-mid)] text-[length:var(--text-body)] leading-[1.5] max-w-[58ch]">
                  {tool.description}
                </span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .stack-logo {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .stack-logo-violet {
    color: var(--color-violet-deep);
  }
  .stack-logo-ember {
    color: var(--color-ember-deep);
  }
</style>
