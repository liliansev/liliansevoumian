---
import SectionHeader from './SectionHeader.astro';

const tools = [
  { name: 'n8n', use: 'Relier vos applications, orchestrer vos workflows et intégrer des agents IA.' },
  { name: 'Make', use: 'Connecter vos outils avec des scénarios visuels faciles à suivre.' },
  { name: 'Notion', use: 'Organiser les informations et le suivi dont votre équipe a besoin.' },
  { name: 'Airtable', use: 'Structurer vos données et les présenter selon les usages de chaque équipe.' },
];
---

<section id="stack" data-section class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]">
  <div class="max-w-[1200px] mx-auto">
    <SectionHeader
      title="Des outils choisis pour <mark>votre usage.</mark>"
      body="Vos logiciels, vos données et les personnes qui les utilisent guident le choix technique."
      titleMaxWidth="24ch"
    />
    <dl class="m-0 grid grid-cols-1 md:grid-cols-2 gap-x-12">
      {tools.map((tool) => (
        <div class="py-6 border-t border-[var(--color-divider)]">
          <dt class="font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">{tool.name}</dt>
          <dd class="m-0 mt-3 max-w-[55ch] text-[length:var(--text-body)] leading-relaxed text-[var(--color-ink-mid)]">{tool.use}</dd>
        </div>
      ))}
    </dl>
    <p class="m-0 mt-7 max-w-[70ch] text-[length:var(--text-body)] leading-relaxed text-[var(--color-ink-mid)]">
      Pour développer une interface ou une intégration sur mesure, je m’aide aussi
      de Claude Code et Codex. Je relis le code et teste son fonctionnement avant livraison.
    </p>
  </div>
</section>
