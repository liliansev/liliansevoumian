---
/*
 * Stack.astro — section §03 (refonte 2026)
 *
 * Stack réelle 2026 : 5 outils, dichotomie Two-Voice :
 *   Workflow (violet) : n8n, Make, NoCode (Notion/Airtable/Zite)
 *   IA (ember)        : Claude Code, Claude Cowork
 *
 * Layout : single card paper-bordée englobant 5 rows séparées par dividers.
 * Pattern visuel inspiré du ROI Calculator (sliders panel) — gap-px avec
 * background divider pour les séparateurs internes propres.
 */
import SectionHeader from './SectionHeader.astro';

interface Tool {
  name: string;
  accent: 'violet' | 'ember';
  description: string;
  category: string;
}

const stack: Tool[] = [
  {
    name: 'n8n',
    accent: 'violet',
    description: 'Automatisations et Agents IA (Cloud ou Self Host).',
    category: 'WORKFLOW · IA',
  },
  {
    name: 'Make',
    accent: 'violet',
    description: 'Automatisations des processus métiers.',
    category: 'WORKFLOW',
  },
  {
    name: 'NoCode',
    accent: 'violet',
    description: "Création d'outils métiers sur Notion, Airtable ou Zite.",
    category: 'OUTIL MÉTIER',
  },
  {
    name: 'Claude Code',
    accent: 'ember',
    description: 'Développement de logiciels internes uniquement.',
    category: 'IA · DEV',
  },
  {
    name: 'Claude Cowork',
    accent: 'ember',
    description: "Mentoring et coaching pour l'utilisation et l'installation des skills.",
    category: 'IA · COACHING',
  },
];
---

<section
  id="stack"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="03"
      label="STACK"
      title="La stack 2026."
      body="Cinq outils, choisis pour leur fit avec votre besoin. Pas une checklist exhaustive, ce que j'utilise tous les jours."
      titleMaxWidth="18ch"
      bodyMaxWidth="60ch"
    />

    {/* Card unique paper-bordée englobant les 5 rows */}
    <div class="relative reveal bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] overflow-hidden">
      <span class="grid-corner tl" aria-hidden="true"></span>
      <span class="grid-corner tr" aria-hidden="true"></span>
      <span class="grid-corner bl" aria-hidden="true"></span>
      <span class="grid-corner br" aria-hidden="true"></span>

      <div class="flex flex-col gap-px bg-[var(--color-divider)]">
        {stack.map((tool) => (
          <div class="bg-[var(--color-paper)] grid grid-cols-[auto_1fr] md:grid-cols-[auto_1fr_auto] gap-x-5 gap-y-2 items-baseline px-6 md:px-8 py-5 md:py-6">
            {/* Chip outil — violet ou ember selon Two-Voice */}
            <span class={`chip ${tool.accent === 'violet' ? 'chip-violet' : 'chip-ember'} self-start whitespace-nowrap`}>
              {tool.name}
            </span>

            {/* Description */}
            <span class="text-[var(--color-ink)] text-[length:var(--text-body)] leading-[1.45] min-w-0">
              {tool.description}
            </span>

            {/* Catégorie label, mono-caption à droite (desktop only) */}
            <span class="hidden md:inline-block mono-caption text-[var(--color-ink-low)] whitespace-nowrap self-center text-right">
              {tool.category}
            </span>

            {/* Sur mobile : catégorie en row dessous, span 2 cols */}
            <span class="md:hidden col-span-2 mono-caption text-[var(--color-ink-low)] -mt-1">
              {tool.category}
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
