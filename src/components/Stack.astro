---
/*
 * Stack.astro — les outils, en quatre familles.
 *
 * Pas de numéro de section dans cet en-tête : il portait « §03 » quand l'ordre
 * de la home en faisait la troisième, et elle y est septième depuis que le
 * calculateur est remonté en deuxième position. L'ordre vit dans index.astro,
 * à un seul endroit ; le répéter ici crée une deuxième vérité qui se périme
 * sans que rien ne le signale.
 *
 * Dix outils en quatre familles (AUTOMATION / PRODUCTIVITÉ / IA / VIBE CODING).
 * Chaque outil porte SA mini-UI signature (mockup produit monochrome) qui montre
 * concrètement ce qu'on en fait, plutôt qu'une définition : n8n → mini-workflow,
 * Make → scénario à modules, Notion → table CRM, Airtable → vues et kanban,
 * Claude Code → console, Codex → file de tâches déléguées, Claude Cowork → chat,
 * Mistral → extraction de document, Zite → outil interne généré, Lovable →
 * conversation qui produit un écran.
 *
 * Les captions disent ce que l'outil fait DE MIEUX, pas ce que j'en fais : c'est
 * ce que promet le chapô de la section.
 *
 * Trois d'entre elles portent un <mark>, plus les dix qu'elles portaient toutes.
 * La raison qui les avait posées est écrite dans la version précédente de ce
 * commentaire — « la section était la seule de la home sans le dispositif de la
 * DA » — et c'est exactement le geste qui produit un tic : le dispositif appliqué
 * parce que l'emplacement était vide, pas parce que la phrase le demandait. Le
 * site comptait vingt-quatre surlignages sur la home, un tous les 486 px, sur
 * neuf titres de premier rang sur dix ; quatorze venaient de ce seul fichier.
 * Un surligneur qui passe sur tout ne souligne plus rien.
 *
 * Les quatre libellés de famille l'ont perdu aussi, et pour une raison de plus :
 * leur mark enveloppait la TOTALITÉ du titre. Une bande qui couvre tout le texte
 * n'est pas un surlignage, c'est une pastille de catégorie.
 *
 * Chaque famille se termine par un lien vers le diagnostic, avec une intention
 * qui lui est propre et un `goalSource` distinct : c'est la seule façon de
 * savoir laquelle des quatre convertit. Le site n'a qu'un point d'arrivée, la
 * réservation ; ces liens n'en ouvrent pas un second, ils y mènent depuis
 * l'endroit où le besoin se formule.
 */
import SectionHeader from './SectionHeader.astro';
import StackLayer from './StackLayer.astro';
import LinkCTA from './LinkCTA.astro';
import { Icon } from 'astro-icon/components';
import { brandColorFor } from '../data/brands';
import MockupWindow from './mockups/MockupWindow.astro';
import StackWorkflow from './mockups/StackWorkflow.astro';
import StackScenario from './mockups/StackScenario.astro';
import StackTable from './mockups/StackTable.astro';
import StackConsole from './mockups/StackConsole.astro';
import StackChat from './mockups/StackChat.astro';
import StackSovereign from './mockups/StackSovereign.astro';
import StackCodex from './mockups/StackCodex.astro';
import StackViews from './mockups/StackViews.astro';
import StackZite from './mockups/StackZite.astro';
import StackLovable from './mockups/StackLovable.astro';

const MOCKS = {
  workflow: StackWorkflow,
  scenario: StackScenario,
  table: StackTable,
  console: StackConsole,
  chat: StackChat,
  sovereign: StackSovereign,
  codex: StackCodex,
  views: StackViews,
  zite: StackZite,
  lovable: StackLovable,
} as const;

interface Tool {
  name: string;
  /* Toujours un vrai logo, jamais un substitut. simple-icons couvre 3 653
     marques et n'a ni Zite ni Lovable : Lovable vient du jeu devicon-plain,
     qui est monochrome, et Zite d'un SVG déposé dans src/icons/ puisque aucun
     jeu du catalogue Iconify ne le référence. Une marque qui manquerait se
     règle de la même façon, par un SVG local ramené à currentColor. */
  icon: string;
  role: string;
  mockup: keyof typeof MOCKS;
  caption: string;
}
interface Layer {
  label: string;
  tools: Tool[];
  /** L'intention propre à la famille, portée par le lien de fin de bloc. */
  cta: string;
  /** Suffixe de `data-fast-goal-source`, pour distinguer les quatre au suivi. */
  ctaSource: string;
}

const layers: Layer[] = [
  {
    label: 'Automatisation',
    cta: 'Faire tourner mon process sur n8n ou Make',
    ctaSource: 'stack-automation',
    tools: [
      /* Le « QUAND » est ce qui tient toute la phrase, quelle que soit la
         formule qui l'ouvre : il borne le jugement à un cas d'usage que n8n
         revendique officiellement. Sans lui, on énonce un classement — et sur
         l'orchestration d'agents, c'est LangGraph qui est documenté en
         production. Si « quand » saute à une relecture, la phrase tombe.

         L'ouverture, elle, a changé : « le meilleur » commençait trois des dix
         cartes et « le plus » cinq autres. Chaque verdict était pesé
         individuellement — les commentaires de ce fichier le montrent — mais
         répétés à l'identique, ils cessaient de se lire comme des avis pour se
         lire comme un gabarit, c'est-à-dire l'inverse de ce que cette section
         revendique. Les jugements sont intacts, seules leurs entrées en
         matière ont été dépareillées. */
      {
        name: 'n8n',
        icon: 'simple-icons:n8n',
        role: 'WORKFLOW · AGENTS IA',
        mockup: 'workflow',
        caption:
          'Celui que je choisis quand l’agent IA doit agir dans vos vrais outils.',
      },
      /* « Le plus utilisé » a été demandé puis écarté : Zapier revendique
         3,4 M d'entreprises contre 400 000 clients Make, et Power Platform
         56 M d'utilisateurs actifs. « Le plus lisible » est un jugement, donc
         tenable — et « où ça casse » raccroche l'outil à ce pour quoi on
         l'appelle vraiment : reprendre des automatisations en panne. */
      {
        name: 'Make',
        icon: 'simple-icons:make',
        role: 'SCÉNARIOS · VISUEL',
        mockup: 'scenario',
        caption:
          'Le plus lisible : chaque module montre ce qui passe, et <mark class="inv">où ça casse</mark>.',
      },
    ],
  },
  {
    label: 'Productivité',
    cta: 'Remettre mes données au propre',
    ctaSource: 'stack-productivite',
    tools: [
      {
        name: 'Notion',
        icon: 'simple-icons:notion',
        role: 'CRM · OPÉRATIONS',
        mockup: 'table',
        caption:
          'Le plus court chemin pour donner à vos équipes une base propre sans lancer un projet informatique.',
      },
      /* Airtable à côté de Notion, pas à sa place : les deux tiennent des
         données, mais Notion agrège (docs, suivi, base au même endroit) là où
         Airtable structure (une base, plusieurs vues). D'où deux maquettes de
         formes différentes — un tableau, un kanban à onglets de vue. */
      {
        name: 'Airtable',
        icon: 'simple-icons:airtable',
        role: 'BASE · CERTIFIÉ',
        mockup: 'views',
        caption:
          'Certifié Airtable : le plus solide quand la même base doit se lire de plusieurs façons.',
      },
    ],
  },
  {
    label: 'IA',
    cta: 'Construire mon agent IA',
    ctaSource: 'stack-ia',
    tools: [
      /* Claude Code et Codex sont voisins parce qu'ils font le même métier
         autrement, et les rôles doivent le dire : deux chips « IA · DEV » côte
         à côte donneraient deux cartes jumelles. Claude Code est un agent local
         qu'on supervise ; Codex un agent auquel on délègue, dont les tâches
         partent tourner ailleurs et reviennent en diff. */
      {
        name: 'Claude Code',
        icon: 'simple-icons:anthropic',
        role: 'IA · DEV',
        mockup: 'console',
        caption:
          'Ce qu’il fait de mieux : fabriquer en direct l’outil que personne ne vend.',
      },
      /* Ne jamais laisser dériver vers « le seul à paralléliser » : ce serait
         faux (Claude Code a ses propres agents parallèles, comme Devin, Cursor
         ou Jules). Et deux pièges de nommage : « le modèle Codex » est déprécié
         depuis 2021, « l'application Codex » a fusionné dans l'app ChatGPT le
         09/07/2026 — seul le CLI reste autonome. */
      {
        name: 'Codex',
        icon: 'simple-icons:openai',
        role: 'IA · DÉLÉGATION',
        mockup: 'codex',
        caption:
          'Le plus doué pour travailler sans personne devant : les tâches reviennent prêtes à relire.',
      },
      {
        name: 'Claude Cowork',
        icon: 'simple-icons:anthropic',
        role: 'IA · ÉQUIPES',
        mockup: 'chat',
        caption:
          'Celui qui rend la main : vos équipes pilotent leurs automatisations en langage courant.',
      },
      /* Critère de choix, pas garantie : « les données ne quittent pas
         l'Europe » n'est vrai que si la plateforme Mistral en zone UE ou un
         déploiement auto-hébergé est effectivement retenu sur la mission, et
         tombe dès qu'un autre maillon appelle un modèle hors UE. */
      {
        name: 'Mistral',
        icon: 'simple-icons:mistralai',
        role: 'IA · SOUVERAINE',
        mockup: 'sovereign',
        caption:
          'Mon premier choix quand vos documents sensibles doivent <mark class="inv">rester en Europe</mark>.',
      },
    ],
  },
  {
    label: 'Vibe coding',
    cta: 'Créer mon outil métier interne',
    ctaSource: 'stack-vibe-coding',
    tools: [
      /* Les deux outils de cette famille décrivent une application en langage
         courant, et c'est bien pour ça qu'il faut que leurs maquettes racontent
         deux choses différentes : Zite montre l'outil une fois EN SERVICE, avec
         ses données et ses accès ; Lovable montre le moment d'AVANT, quand
         l'écran apparaît pendant qu'on parle. */
      {
        name: 'Zite',
        /* Pas de préfixe de jeu : astro-icon expose les SVG déposés dans
           src/icons/ sous leur seul nom de fichier. Zite est la seule marque du
           site dans ce cas, aucun jeu Iconify ne la couvrant. */
        icon: 'zite',
        role: 'APP · OUTILS INTERNES',
        mockup: 'zite',
        caption:
          'Pour une équipe qui a besoin de son propre outil, et qu’il reste modifiable après.',
      },
      {
        name: 'Lovable',
        icon: 'devicon-plain:lovable',
        role: 'APP · PROTOTYPE',
        mockup: 'lovable',
        caption:
          'Le plus rapide pour transformer une idée en écran qu’on peut cliquer, le jour même.',
      },
    ],
  },
];
---

<section
  id="stack"
  data-section
  data-motion-pause
  class="relative pt-[var(--spacing-section-y)]"
>
  <div class="relative max-w-[1200px] mx-auto px-[var(--spacing-section-x)]">

    {/* Le body porte les dix jugements qui suivent : « mon verdict », à la
        première personne, est ce qui en fait des avis d'expert plutôt que des
        affirmations de marché. Le raccourcir rendrait les captions attaquables,
        et ce d'autant plus qu'aucune ne s'accompagne de sa mesure. */}
    {/* Le compte est descendu du sur-titre dans le chapô, où il se lit dans une
        phrase au lieu d'occuper une ligne de petites capitales. C'est la seule
        information que « 10 OUTILS · USAGE QUOTIDIEN » portait et que le titre
        ne portait pas. */}
    <SectionHeader
      title="Les outils IA et automatisations que je maîtrise"
      body="Dix outils, et pour chacun mon verdict sur ce qu'il fait mieux que les autres."
      titleMaxWidth="26ch"
      bodyMaxWidth="60ch"
    />

    <div class="stack-layers reveal">
      {layers.slice(0, 2).map((layer, index) => (
        <StackLayer layer={layer} titreId={`stack-layer-${index}`} />
      ))}
    </div>

  </div>

  {/* Bande grise sous les deux dernières familles. La section faisait 2 648 px
      de papier d'un seul tenant — vingt-trois pour cent de la home, et la seule
      zone de la page sans aucun événement de surface, alors que la DA fait
      porter tout son rythme vertical par le changement de fond. Le lime
      disparaissait par ailleurs pendant 5 890 px d'affilée, dont l'essentiel
      ici. Un div pleine largeur plutôt qu'un `100vw` : la section n'a plus de
      padding horizontal, ses deux enfants le portent, et rien ne peut déborder
      de la largeur du document. */}
  <div class="stack-bande section-band">
    <div class="relative max-w-[1200px] mx-auto">
      <div class="stack-layers reveal">
        {layers.slice(2).map((layer, index) => (
          <StackLayer layer={layer} titreId={`stack-layer-${index + 2}`} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .stack-layers {
    display: grid;
    /* `minmax(0, 1fr)` et non la piste implicite : sans lui, les items héritent
       de `min-width: auto` et c'est leur min-content qui dicte la largeur. Ici
       ce min-content venait du libellé du CTA de la première famille, mesuré à
       316 px, dans une piste de 261 : la section débordait de 41 px à 320 px et
       de 5 px à 360 px — la largeur Android la plus répandue — en décalant toute
       la home. Le débordement ne se voyait pas, `html { overflow-x: hidden }`
       l'absorbait. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.75rem, 5vw, 4.5rem);
  }

  .stack-layer {
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
    border-top: 1px solid var(--color-border-strong);
  }

  .stack-layer-header {
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  /* Casse normale, et libellés en français. Deux des quatre étaient en anglais
     — « AUTOMATION », « VIBE CODING » — sur un site francophone, à côté de
     « PRODUCTIVITÉ » qui, lui, était traduit. Et les capitales portaient un
     `letter-spacing` négatif, alors qu'un mot en capitales demande de l'air
     entre ses lettres, pas moins. */
  .stack-layer-title {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }



  .stack-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(0.75rem, 1.5vw, 1rem);
    align-items: stretch;
  }

  .stack-tools-single {
    grid-template-columns: minmax(0, 520px);
  }

  /* Une couche de quatre outils passe en 2×2 plutôt qu'en une rangée de quatre.
     Mesuré à 1440 px : quatre colonnes donnent des cartes de 288 px, où le chip
     de rôle repasse à la ligne sous le nom de l'outil et où le nom de fichier
     de la maquette Mistral se tronque. En 2×2 les cartes font 592 px — la
     largeur exacte des cartes d'AUTOMATION, donc la section garde une seule
     mesure de carte au lieu d'en introduire une troisième. */
  @media (min-width: 64rem) {
    .stack-tools-quad {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Encre au repos, couleur de marque au survol — la même règle que le
     bandeau de logos. Une marque tierce a droit à sa couleur DANS une
     maquette, où l'on montre l'outil réel ; jamais dans notre propre chrome.
     Sur pointeur grossier il n'y a pas de survol, donc pas de couleur : elle
     n'est pas porteuse de sens, seulement un clin d'œil. */
  .stack-logo {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--color-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .stack-logo { transition: color 0.18s cubic-bezier(0.25, 1, 0.5, 1); }
    .stack-card:hover .stack-logo { color: var(--brand, var(--color-ink)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-logo { transition: none; }
  }


  .stack-bande {
  margin-top: clamp(2.75rem, 5vw, 4.5rem);
  padding: clamp(2.75rem, 5vw, 4.5rem) var(--spacing-section-x) var(--spacing-section-y);
  border-top: 1px solid var(--color-divider);
}

.stack-layer-cta {
    margin-top: clamp(1.1rem, 2vw, 1.5rem);
  }

</style>
