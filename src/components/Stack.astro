---
/*
 * Stack.astro — section §03.
 *
 * Huit outils en trois familles (AUTOMATION / PRODUCTIVITÉ / IA). Chaque outil porte SA mini-UI
 * signature (mockup produit monochrome) qui montre concrètement ce qu'on en
 * fait, plutôt qu'une définition : n8n → mini-workflow, Make → scénario à
 * modules, Notion → table CRM, Airtable → vues et kanban, Claude Code →
 * console, Codex → file de tâches déléguées, Claude Cowork → chat, Mistral →
 * extraction de document.
 *
 * Les captions disent ce que l'outil fait DE MIEUX, pas ce que j'en fais : c'est
 * ce que promet le chapô de la section. Chacune porte un <mark> — la section
 * était la seule de la home sans le dispositif de la DA.
 */
import SectionHeader from './SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import { brandColorFor } from '../data/brands';
import MockupWindow from './mockups/MockupWindow.astro';
import StackWorkflow from './mockups/StackWorkflow.astro';
import StackScenario from './mockups/StackScenario.astro';
import StackTable from './mockups/StackTable.astro';
import StackConsole from './mockups/StackConsole.astro';
import StackChat from './mockups/StackChat.astro';
import StackSovereign from './mockups/StackSovereign.astro';
import StackCodex from './mockups/StackCodex.astro';
import StackViews from './mockups/StackViews.astro';

const MOCKS = {
  workflow: StackWorkflow,
  scenario: StackScenario,
  table: StackTable,
  console: StackConsole,
  chat: StackChat,
  sovereign: StackSovereign,
  codex: StackCodex,
  views: StackViews,
} as const;

interface Tool {
  name: string;
  icon: string;
  role: string;
  mockup: keyof typeof MOCKS;
  caption: string;
}
interface Layer {
  label: string;
  caption: string;
  tools: Tool[];
}

const layers: Layer[] = [
  {
    label: 'AUTOMATION',
    caption: 'Pour les tâches qui suivent toujours la même règle',
    tools: [
      /* « Le meilleur QUAND » et pas « le meilleur » : le mot « quand » borne le
         superlatif à un cas d'usage que n8n revendique officiellement. Énoncé
         nu, il deviendrait un classement, et sur l'orchestration d'agents c'est
         LangGraph qui est documenté en production. Si « quand » saute à une
         relecture, la phrase tombe. */
      {
        name: 'n8n',
        icon: 'simple-icons:n8n',
        role: 'WORKFLOW · AGENTS IA',
        mockup: 'workflow',
        caption:
          'Le meilleur quand l’agent IA doit agir dans <mark>vos vrais outils</mark>, pas seulement répondre.',
      },
      /* « Le plus utilisé » a été demandé puis écarté : Zapier revendique
         3,4 M d'entreprises contre 400 000 clients Make, et Power Platform
         56 M d'utilisateurs actifs. « Le plus lisible » est un jugement, donc
         tenable — et « où ça casse » raccroche l'outil à ce pour quoi on
         l'appelle vraiment : reprendre des automatisations en panne. */
      {
        name: 'Make',
        icon: 'simple-icons:make',
        role: 'SCÉNARIOS · VISUEL',
        mockup: 'scenario',
        caption:
          'Le plus lisible : chaque module montre ce qui passe, et <mark class="inv">où ça casse</mark>.',
      },
    ],
  },
  {
    label: 'PRODUCTIVITÉ',
    caption: 'Pour structurer et piloter les opérations',
    tools: [
      {
        name: 'Notion',
        icon: 'simple-icons:notion',
        role: 'CRM · OPÉRATIONS',
        mockup: 'table',
        caption:
          'Imbattable pour donner à vos équipes <mark>une base propre</mark> sans lancer un projet informatique.',
      },
      /* Airtable à côté de Notion, pas à sa place : les deux tiennent des
         données, mais Notion agrège (docs, suivi, base au même endroit) là où
         Airtable structure (une base, plusieurs vues). D'où deux maquettes de
         formes différentes — un tableau, un kanban à onglets de vue. */
      {
        name: 'Airtable',
        icon: 'simple-icons:airtable',
        role: 'BASE · CERTIFIÉ',
        mockup: 'views',
        caption:
          'Certifié Airtable : le plus solide quand la même base doit se lire <mark class="inv">de plusieurs façons</mark>.',
      },
    ],
  },
  {
    label: 'IA',
    caption: 'Pour tout ce qui demande du jugement, pas une règle',
    tools: [
      /* Claude Code et Codex sont voisins parce qu'ils font le même métier
         autrement, et les rôles doivent le dire : deux chips « IA · DEV » côte
         à côte donneraient deux cartes jumelles. Claude Code est un agent local
         qu'on supervise ; Codex un agent auquel on délègue, dont les tâches
         partent tourner ailleurs et reviennent en diff. */
      {
        name: 'Claude Code',
        icon: 'simple-icons:anthropic',
        role: 'IA · DEV',
        mockup: 'console',
        caption:
          'Ce qu’il fait de mieux : fabriquer <mark>en direct</mark> l’outil que personne ne vend.',
      },
      /* Ne jamais laisser dériver vers « le seul à paralléliser » : ce serait
         faux (Claude Code a ses propres agents parallèles, comme Devin, Cursor
         ou Jules). Et deux pièges de nommage : « le modèle Codex » est déprécié
         depuis 2021, « l'application Codex » a fusionné dans l'app ChatGPT le
         09/07/2026 — seul le CLI reste autonome. */
      {
        name: 'Codex',
        icon: 'simple-icons:openai',
        role: 'IA · DÉLÉGATION',
        mockup: 'codex',
        caption:
          'Le plus doué pour travailler <mark class="inv">sans personne devant</mark> : les tâches reviennent prêtes à relire.',
      },
      {
        name: 'Claude Cowork',
        icon: 'simple-icons:anthropic',
        role: 'IA · ÉQUIPES',
        mockup: 'chat',
        caption:
          'Le meilleur pour <mark>rendre la main</mark> — vos équipes pilotent leurs automatisations en langage courant.',
      },
      /* Critère de choix, pas garantie : « les données ne quittent pas
         l'Europe » n'est vrai que si la plateforme Mistral en zone UE ou un
         déploiement auto-hébergé est effectivement retenu sur la mission, et
         tombe dès qu'un autre maillon appelle un modèle hors UE. */
      {
        name: 'Mistral',
        icon: 'simple-icons:mistralai',
        role: 'IA · SOUVERAINE',
        mockup: 'sovereign',
        caption:
          'Mon premier choix quand vos documents sensibles ne doivent pas <mark class="inv">quitter l’Europe</mark>.',
      },
    ],
  },
];
---

<section
  id="stack"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    {/* Le body porte les huit superlatifs qui suivent : « mon verdict, pas un
        comparatif » est ce qui fait d'« imbattable » ou « le meilleur » des
        jugements d'expert plutôt que des affirmations de marché. Le raccourcir
        rendrait les captions attaquables. */}
    <SectionHeader
      number="03"
      label="8 OUTILS · USAGE QUOTIDIEN"
      title="Les outils IA et automatisations que je maîtrise"
      body="Huit outils que j'utilise tous les jours. Pour chacun, ce qu'il fait mieux que les autres : mon verdict, pas un comparatif."
      titleMaxWidth="26ch"
      bodyMaxWidth="60ch"
    />

    <div class="stack-layers reveal">
      {layers.map((layer, index) => (
        <section class="stack-layer" aria-labelledby={`stack-layer-${index}`}>
          <header class="stack-layer-header">
            <div>
              <h3 id={`stack-layer-${index}`} class="stack-layer-title">{layer.label}</h3>
              <p class="stack-layer-caption">{layer.caption}</p>
            </div>
            <span class="stack-layer-count">{layer.tools.length} {layer.tools.length > 1 ? 'OUTILS' : 'OUTIL'}</span>
          </header>

          <div class:list={['stack-tools', {
            'stack-tools-single': layer.tools.length === 1,
            'stack-tools-quad': layer.tools.length === 4,
          }]}>
            {layer.tools.map((tool) => {
              const Mock = MOCKS[tool.mockup];
              const brand = brandColorFor(tool.icon);
              return (
                <article class="stack-card card-soft bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-lg)] p-5 flex flex-col gap-4" style={brand ? `--brand:${brand}` : undefined}>
                  <div class="flex items-center justify-between gap-3 flex-wrap">
                    <div class="inline-flex items-center gap-2.5 min-w-0">
                      <Icon name={tool.icon} class="stack-logo" aria-hidden="true" />
                      <h4 class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)] m-0">{tool.name}</h4>
                    </div>
                    <span class="chip chip-accent shrink-0">{tool.role}</span>
                  </div>

                  <MockupWindow bare flush>
                    <Mock />
                  </MockupWindow>

                  {/* set:html parce que les captions portent un <mark> : dans une
                      expression JSX, Astro échapperait la balise et afficherait
                      « &lt;mark&gt; » en clair. Les chaînes sont écrites ici même,
                      jamais saisies par un tiers. */}
                  <p
                    class="mt-auto m-0 text-[var(--color-ink-mid)] text-[length:var(--text-body-sm)] leading-[1.5]"
                    set:html={tool.caption}
                  />
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>

  </div>
</section>

<style>
  .stack-layers {
    display: grid;
    gap: clamp(2.75rem, 5vw, 4.5rem);
  }

  .stack-layer {
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
    border-top: 1px solid var(--color-border-strong);
  }

  .stack-layer-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  .stack-layer-title {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .stack-layer-caption {
    max-width: 44ch;
    margin: 0.4rem 0 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .stack-layer-count {
    color: var(--color-ink-low);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .stack-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(0.75rem, 1.5vw, 1rem);
    align-items: stretch;
  }

  .stack-tools-single {
    grid-template-columns: minmax(0, 520px);
  }

  /* Une couche de quatre outils passe en 2×2 plutôt qu'en une rangée de quatre.
     Mesuré à 1440 px : quatre colonnes donnent des cartes de 288 px, où le chip
     de rôle repasse à la ligne sous le nom de l'outil et où le nom de fichier
     de la maquette Mistral se tronque. En 2×2 les cartes font 592 px — la
     largeur exacte des cartes d'AUTOMATION, donc la section garde une seule
     mesure de carte au lieu d'en introduire une troisième. */
  @media (min-width: 64rem) {
    .stack-tools-quad {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Encre au repos, couleur de marque au survol — la même règle que le
     bandeau de logos. Une marque tierce a droit à sa couleur DANS une
     maquette, où l'on montre l'outil réel ; jamais dans notre propre chrome.
     Sur pointeur grossier il n'y a pas de survol, donc pas de couleur : elle
     n'est pas porteuse de sens, seulement un clin d'œil. */
  .stack-logo {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--color-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .stack-logo { transition: color 0.18s cubic-bezier(0.25, 1, 0.5, 1); }
    .stack-card:hover .stack-logo { color: var(--brand, var(--color-ink)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-logo { transition: none; }
  }


  @media (max-width: 639px) {
    .stack-layer-header {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.5rem;
    }
  }
</style>
