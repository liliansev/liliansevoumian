---
/*
 * Stack.astro — section §03.
 *
 * Cinq outils en deux couches (AUTOMATION / IA). Chaque outil porte SA mini-UI
 * signature (mockup produit monochrome) qui montre concrètement ce qu'on en
 * fait, plutôt qu'une définition : n8n → mini-workflow, Make → scénario à
 * modules, Notion → table CRM, Claude Code → console, Claude Cowork → chat.
 */
import SectionHeader from './SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import { brandColorFor } from '../data/brands';
import MockupWindow from './mockups/MockupWindow.astro';
import StackWorkflow from './mockups/StackWorkflow.astro';
import StackScenario from './mockups/StackScenario.astro';
import StackTable from './mockups/StackTable.astro';
import StackConsole from './mockups/StackConsole.astro';
import StackChat from './mockups/StackChat.astro';
import StackSovereign from './mockups/StackSovereign.astro';

const MOCKS = {
  workflow: StackWorkflow,
  scenario: StackScenario,
  table: StackTable,
  console: StackConsole,
  chat: StackChat,
  sovereign: StackSovereign,
} as const;

interface Tool {
  name: string;
  icon: string;
  role: string;
  mockup: keyof typeof MOCKS;
  caption: string;
}
interface Layer {
  label: string;
  caption: string;
  tools: Tool[];
}

const layers: Layer[] = [
  {
    label: 'AUTOMATION',
    caption: 'POUR AUTOMATISER DES PROCESSUS DÉTERMINISTES',
    tools: [
      {
        name: 'n8n',
        icon: 'simple-icons:n8n',
        role: 'WORKFLOW · IA',
        mockup: 'workflow',
        caption: 'Un agent IA lit vos emails entrants et crée la tâche au bon endroit.',
      },
      {
        name: 'Make',
        icon: 'simple-icons:make',
        role: 'WORKFLOW',
        mockup: 'scenario',
        caption: 'Trois outils métiers connectés en une après-midi, sans une ligne de code.',
      },
      {
        name: 'Notion',
        icon: 'simple-icons:notion',
        role: 'PRODUCTIVITÉ',
        mockup: 'table',
        caption: 'Un CRM sur-mesure qui se remplit tout seul depuis vos formulaires.',
      },
    ],
  },
  {
    label: 'IA',
    caption: 'INTELLIGENCE, JUGEMENT ET RÉFLEXION',
    tools: [
      {
        name: 'Claude Code',
        icon: 'simple-icons:anthropic',
        role: 'IA · DEV',
        mockup: 'console',
        caption: 'Un outil interne sur-mesure, livré en quelques jours.',
      },
      {
        name: 'Claude Cowork',
        icon: 'simple-icons:anthropic',
        role: 'IA · COACHING',
        mockup: 'chat',
        caption: 'Vos équipes pilotent leurs automatisations par simple dialogue.',
      },
      {
        name: 'Mistral',
        icon: 'simple-icons:mistralai',
        role: 'IA · SOUVERAINE',
        mockup: 'sovereign',
        caption: 'Vos documents traités en masse par une IA française, sans qu’une donnée quitte l’Europe.',
      },
    ],
  },
];
---

<section
  id="stack"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="03"
      label="6 OUTILS · USAGE QUOTIDIEN"
      title="Les outils IA et automatisations que je maîtrise"
      body="Six outils que j'utilise tous les jours, gardés chacun pour ce qu'il fait de mieux."
      titleMaxWidth="26ch"
      bodyMaxWidth="60ch"
    />

    <div class="reveal flex flex-col gap-10 md:gap-12">
      {layers.map((layer) => (
        <div>
          <div class="flex items-baseline gap-x-3 gap-y-1 flex-wrap mb-4 md:mb-5 pb-3 border-b border-[var(--color-divider)]">
            <span class="mono-label text-[var(--color-accent)]">{layer.label}</span>
            <span class="mono-caption text-[var(--color-ink-low)]">{layer.caption}</span>
            <span class="mono-caption text-[var(--color-ink-low)] ml-auto whitespace-nowrap">{layer.tools.length} OUTILS</span>
          </div>

          <div class={`grid grid-cols-1 ${layer.tools.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2'} gap-3 lg:gap-4 items-stretch`}>
            {layer.tools.map((tool) => {
              const Mock = MOCKS[tool.mockup];
              const brand = brandColorFor(tool.icon);
              return (
                <div class="stack-card card-soft bg-[var(--color-paper)] rounded-[var(--radius-lg)] p-5 flex flex-col gap-4" style={brand ? `--brand:${brand}` : undefined}>
                  <div class="flex items-center justify-between gap-3 flex-wrap">
                    <div class="inline-flex items-center gap-2.5 min-w-0">
                      <Icon name={tool.icon} class="stack-logo" aria-hidden="true" />
                      <span class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">{tool.name}</span>
                    </div>
                    <span class="chip chip-accent shrink-0">{tool.role}</span>
                  </div>

                  <MockupWindow bare flush>
                    <Mock />
                  </MockupWindow>

                  <p class="mt-auto m-0 text-[var(--color-ink-mid)] text-[length:var(--text-body-sm)] leading-[1.5]">
                    {tool.caption}
                  </p>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Logo titre dans la vraie couleur de la marque (--brand posé sur la carte).
     Marque monochrome (Notion) → encre pleine (noir/blanc, DA propre à Notion). */
  .stack-logo {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--brand, var(--color-ink));
  }

  /* Chip de rôle à la couleur de marque de la carte ; fallback encre (noir/blanc)
     pour les marques monochromes — pas d'orange générique sur Notion. */
  .stack-card .chip-accent {
    color: var(--brand, var(--color-ink));
    background: color-mix(in oklab, var(--brand, var(--color-ink)) 12%, transparent);
    border-color: transparent;
  }
</style>
