---
/*
 * Stack.astro — section §03 (overdrive E.2)
 *
 * Refonte complète : la stack devient l'output d'une commande Unix `tree`.
 * Two-Voice Rule devient une hiérarchie spatiale visible (workflow/ vs ai/).
 * Apparition typewriter scroll-driven via IntersectionObserver + clip-path.
 *
 * Layout : CSS grid pour l'alignement des colonnes (prefix · name · dot · desc).
 * On ne s'appuie PAS sur whitespace-pre car HTML collapse les espaces multiples.
 */
import SectionHeader from './SectionHeader.astro';

const workflowFiles = [
  { name: 'n8n',    desc: 'automatisations + agents IA · cloud ou self-host', last: false },
  { name: 'make',   desc: 'process métiers · visuel',                          last: false },
  { name: 'nocode', desc: 'notion · airtable · zite · outils métier',         last: true  },
];

const aiFiles = [
  { name: 'claude-code',   desc: 'dev logiciels internes uniquement', last: false },
  { name: 'claude-cowork', desc: 'mentoring · coaching · skills',     last: true  },
];
---

<section
  id="stack"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="03"
      label="STACK"
      title="La stack 2026."
      body="Cinq outils, choisis pour leur fit avec votre besoin. Pas une checklist exhaustive, ce que j'utilise tous les jours."
      titleMaxWidth="18ch"
      bodyMaxWidth="60ch"
    />

    <div class="reveal max-w-[760px] font-mono text-[length:0.875rem] leading-[1.85] text-[var(--color-ink)]" data-stack-terminal>

      {/* Prompt header */}
      <div class="mono-caption text-[var(--color-ink-low)] mb-4">
        $ tree /lilian/stack/
      </div>

      {/* Root */}
      <div class="typewriter-line stack-tree-name">/lilian/stack/</div>

      {/* workflow/ directory */}
      <div class="typewriter-line">
        <div class="stack-tree-row-dir">
          <span class="stack-tree-char">├──</span>
          <span class="stack-tree-dir-workflow">workflow/</span>
        </div>
      </div>

      {/* workflow/ files */}
      {workflowFiles.map((f) => (
        <div class="typewriter-line">
          <div class="stack-tree-row stack-tree-leaf">
            <span class="stack-tree-char">{f.last ? '│   └──' : '│   ├──'}</span>
            <span class="stack-tree-name">{f.name}</span>
            <span class="stack-tree-dot">·</span>
            <span class="stack-tree-desc">{f.desc}</span>
          </div>
        </div>
      ))}

      {/* ai/ directory */}
      <div class="typewriter-line">
        <div class="stack-tree-row-dir">
          <span class="stack-tree-char">└──</span>
          <span class="stack-tree-dir-ai">ai/</span>
        </div>
      </div>

      {/* ai/ files */}
      {aiFiles.map((f) => (
        <div class="typewriter-line">
          <div class="stack-tree-row stack-tree-leaf">
            <span class="stack-tree-char">{f.last ? '    └──' : '    ├──'}</span>
            <span class="stack-tree-name">{f.name}</span>
            <span class="stack-tree-dot">·</span>
            <span class="stack-tree-desc">{f.desc}</span>
          </div>
        </div>
      ))}

      {/* Footer + cursor */}
      <div class="mt-4 flex items-baseline gap-2 mono-caption text-[var(--color-ink-low)] typewriter-line">
        <span>2 directories scanned · 5 files</span>
        <span class="terminal-cursor text-[var(--color-ink)]" aria-hidden="true">█</span>
      </div>
    </div>

  </div>
</section>

<script>
  function initStackTerminal() {
    const root = document.querySelector<HTMLElement>('[data-stack-terminal]');
    if (!root) return;

    const lines = root.querySelectorAll<HTMLElement>('.typewriter-line');
    if (lines.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      lines.forEach((l) => l.classList.add('is-revealed'));
      return;
    }

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            // Cascade reveal : 130ms par ligne pour un rythme "lu calmement".
            lines.forEach((line, i) => {
              window.setTimeout(() => line.classList.add('is-revealed'), i * 130);
            });
            obs.disconnect();
          }
        });
      },
      { threshold: 0.25 },
    );

    obs.observe(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStackTerminal);
  } else {
    initStackTerminal();
  }
  document.addEventListener('astro:page-load', initStackTerminal);
</script>
