---
/*
 * Stack.astro — section §03.
 *
 * Six outils en trois familles (AUTOMATION / PRODUCTIVITÉ / IA). Chaque outil porte SA mini-UI
 * signature (mockup produit monochrome) qui montre concrètement ce qu'on en
 * fait, plutôt qu'une définition : n8n → mini-workflow, Make → scénario à
 * modules, Notion → table CRM, Claude Code → console, Claude Cowork → chat.
 */
import SectionHeader from './SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import { brandColorFor } from '../data/brands';
import MockupWindow from './mockups/MockupWindow.astro';
import StackWorkflow from './mockups/StackWorkflow.astro';
import StackScenario from './mockups/StackScenario.astro';
import StackTable from './mockups/StackTable.astro';
import StackConsole from './mockups/StackConsole.astro';
import StackChat from './mockups/StackChat.astro';
import StackSovereign from './mockups/StackSovereign.astro';

const MOCKS = {
  workflow: StackWorkflow,
  scenario: StackScenario,
  table: StackTable,
  console: StackConsole,
  chat: StackChat,
  sovereign: StackSovereign,
} as const;

interface Tool {
  name: string;
  icon: string;
  role: string;
  mockup: keyof typeof MOCKS;
  caption: string;
}
interface Layer {
  label: string;
  caption: string;
  tools: Tool[];
}

const layers: Layer[] = [
  {
    label: 'AUTOMATION',
    caption: 'Pour automatiser les processus déterministes',
    tools: [
      {
        name: 'n8n',
        icon: 'simple-icons:n8n',
        role: 'WORKFLOW · IA',
        mockup: 'workflow',
        caption: 'Un agent IA lit vos emails entrants et crée la tâche au bon endroit.',
      },
      {
        name: 'Make',
        icon: 'simple-icons:make',
        role: 'WORKFLOW',
        mockup: 'scenario',
        caption: 'Trois outils métiers connectés en une après-midi, sans une ligne de code.',
      },
    ],
  },
  {
    label: 'PRODUCTIVITÉ',
    caption: 'Pour structurer et piloter les opérations',
    tools: [
      {
        name: 'Notion',
        icon: 'simple-icons:notion',
        role: 'CRM · OPÉRATIONS',
        mockup: 'table',
        caption: 'Un CRM sur-mesure qui se remplit tout seul depuis vos formulaires.',
      },
    ],
  },
  {
    label: 'IA',
    caption: 'Pour l’intelligence, le jugement et la réflexion',
    tools: [
      {
        name: 'Claude Code',
        icon: 'simple-icons:anthropic',
        role: 'IA · DEV',
        mockup: 'console',
        caption: 'Un outil interne sur-mesure, livré en quelques jours.',
      },
      {
        name: 'Claude Cowork',
        icon: 'simple-icons:anthropic',
        role: 'IA · COACHING',
        mockup: 'chat',
        caption: 'Vos équipes pilotent leurs automatisations par simple dialogue.',
      },
      {
        name: 'Mistral',
        icon: 'simple-icons:mistralai',
        role: 'IA · SOUVERAINE',
        mockup: 'sovereign',
        caption: 'Vos documents traités en masse par une IA française, sans qu’une donnée quitte l’Europe.',
      },
    ],
  },
];
---

<section
  id="stack"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="03"
      label="6 OUTILS · USAGE QUOTIDIEN"
      title="Les <mark>outils IA</mark> et automatisations que je maîtrise"
      body="Six outils que j'utilise tous les jours, gardés chacun pour ce qu'il fait de mieux."
      titleMaxWidth="26ch"
      bodyMaxWidth="60ch"
    />

    <div class="stack-layers reveal">
      {layers.map((layer, index) => (
        <section class="stack-layer" aria-labelledby={`stack-layer-${index}`}>
          <header class="stack-layer-header">
            <div>
              <h3 id={`stack-layer-${index}`} class="stack-layer-title">{layer.label}</h3>
              <p class="stack-layer-caption">{layer.caption}</p>
            </div>
            <span class="stack-layer-count">{layer.tools.length} {layer.tools.length > 1 ? 'OUTILS' : 'OUTIL'}</span>
          </header>

          <div class:list={['stack-tools', { 'stack-tools-single': layer.tools.length === 1 }]}>
            {layer.tools.map((tool) => {
              const Mock = MOCKS[tool.mockup];
              const brand = brandColorFor(tool.icon);
              return (
                <article class="stack-card card-soft bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-lg)] p-5 flex flex-col gap-4" style={brand ? `--brand:${brand}` : undefined}>
                  <div class="flex items-center justify-between gap-3 flex-wrap">
                    <div class="inline-flex items-center gap-2.5 min-w-0">
                      <Icon name={tool.icon} class="stack-logo" aria-hidden="true" />
                      <h4 class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)] m-0">{tool.name}</h4>
                    </div>
                    <span class="chip chip-accent shrink-0">{tool.role}</span>
                  </div>

                  <MockupWindow bare flush>
                    <Mock />
                  </MockupWindow>

                  <p class="mt-auto m-0 text-[var(--color-ink-mid)] text-[length:var(--text-body-sm)] leading-[1.5]">
                    {tool.caption}
                  </p>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>

  </div>
</section>

<style>
  .stack-layers {
    display: grid;
    gap: clamp(2.75rem, 5vw, 4.5rem);
  }

  .stack-layer {
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
    border-top: 1px solid var(--color-border-strong);
  }

  .stack-layer-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  .stack-layer-title {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .stack-layer-caption {
    max-width: 44ch;
    margin: 0.4rem 0 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .stack-layer-count {
    color: var(--color-ink-low);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .stack-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(0.75rem, 1.5vw, 1rem);
    align-items: stretch;
  }

  .stack-tools-single {
    grid-template-columns: minmax(0, 520px);
  }

  /* Logo titre dans la vraie couleur de la marque (--brand posé sur la carte).
     Marque monochrome (Notion) → encre pleine (noir/blanc, DA propre à Notion). */
  .stack-logo {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--brand, var(--color-ink));
  }

  /* Chip de rôle à la couleur de marque de la carte ; fallback encre (noir/blanc)
     pour les marques monochromes — pas d'orange générique sur Notion.
     Le texte est mixé vers l'encre : la couleur de marque brute sur son propre
     tint 12% tombait sous 4.5:1 (fail AA sur du 11px uppercase) ; le mix garde
     la teinte de marque tout en repassant AA (et s'éclaircit seul en dark,
     où --color-ink bascule vers le clair). */
  .stack-card .chip-accent {
    color: color-mix(in oklab, var(--brand, var(--color-ink)) 65%, var(--color-ink));
    background: color-mix(in oklab, var(--brand, var(--color-ink)) 12%, transparent);
    border-color: transparent;
  }

  @media (max-width: 639px) {
    .stack-layer-header {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.5rem;
    }
  }
</style>
