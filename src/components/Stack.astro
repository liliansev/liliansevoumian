---
/*
 * Stack.astro — section §03.
 *
 * Cinq outils groupés en deux couches (AUTOMATION / IA). Chaque outil est une
 * carte flottante avec un mini-carrousel de cas d'usage concrets, navigable aux
 * flèches ← → — montre ce qu'on FAIT avec l'outil plutôt qu'une définition.
 */
import SectionHeader from './SectionHeader.astro';
import { Icon } from 'astro-icon/components';

interface Tool {
  name: string;
  icon: string;
  role: string;
  useCases: string[];
}

interface Layer {
  label: string;
  caption: string;
  tools: Tool[];
}

const layers: Layer[] = [
  {
    label: 'AUTOMATION',
    caption: 'LE SOCLE QUI EXÉCUTE',
    tools: [
      {
        name: 'n8n',
        icon: 'simple-icons:n8n',
        role: 'WORKFLOW · IA',
        useCases: [
          "Un agent IA qui lit vos emails entrants et crée la tâche au bon endroit.",
          "HubSpot, Airtable et Slack synchronisés à chaque nouveau lead — zéro copier-coller.",
          "Vos workflows hébergés chez vous quand les données ne doivent pas sortir.",
        ],
      },
      {
        name: 'Make',
        icon: 'simple-icons:make',
        role: 'WORKFLOW',
        useCases: [
          "Connecter trois outils métiers en une après-midi, sans une ligne de code.",
          "Devis signé → facture → relance → compta, en automatique.",
          "Un scénario visuel que votre équipe comprend et maintient sans moi.",
        ],
      },
      {
        name: 'Notion',
        icon: 'simple-icons:notion',
        role: 'OUTIL MÉTIER',
        useCases: [
          "Un CRM sur-mesure qui se remplit tout seul depuis vos formulaires.",
          "Devis, clients et projets dans une base reliée — fini les cinq fichiers Excel.",
          "Un portail interne où chaque équipe voit exactement ce qui la concerne.",
        ],
      },
    ],
  },
  {
    label: 'IA',
    caption: 'LA COUCHE QUI DÉCIDE & CONSTRUIT',
    tools: [
      {
        name: 'Claude Code',
        icon: 'simple-icons:anthropic',
        role: 'IA · DEV',
        useCases: [
          "Un outil interne sur-mesure livré en quelques jours, pas en six mois.",
          "Transformer un script bricolé en vraie petite app que l'équipe adopte.",
          "Brancher vos données sur une interface propre, sans dépendre d'un SaaS.",
        ],
      },
      {
        name: 'Claude Cowork',
        icon: 'simple-icons:anthropic',
        role: 'IA · COACHING',
        useCases: [
          "Vos équipes pilotent leurs automatisations par simple dialogue.",
          "J'installe, je forme, je transmets — vous ne dépendez pas de moi.",
          "Débloquer un point technique en visio, puis vous laisser les clés.",
        ],
      },
    ],
  },
];
---

<section
  id="stack"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="03"
      label="5 OUTILS · USAGE QUOTIDIEN"
      title="Les outils, et ce qu'on en fait."
      body="Cinq outils que j'utilise tous les jours, gardés chacun pour ce qu'il fait de mieux. Parcourez les cas d'usage aux flèches."
      titleMaxWidth="22ch"
      bodyMaxWidth="60ch"
    />

    <div class="reveal flex flex-col gap-10 md:gap-12">
      {layers.map((layer) => (
        <div>
          {/* Étiquette de couche — légère, pas un panneau bordé */}
          <div class="flex items-baseline gap-x-3 gap-y-1 flex-wrap mb-4 md:mb-5 pb-3 border-b border-[var(--color-divider)]">
            <span class="mono-label text-[var(--color-accent)]">{layer.label}</span>
            <span class="mono-caption text-[var(--color-ink-low)]">{layer.caption}</span>
            <span class="mono-caption text-[var(--color-ink-low)] ml-auto whitespace-nowrap">{layer.tools.length} OUTILS</span>
          </div>

          {/* Cartes flottantes — une par outil, avec carrousel de cas d'usage */}
          <div class={`grid grid-cols-1 ${layer.tools.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2'} gap-3 lg:gap-4 items-stretch`}>
            {layer.tools.map((tool) => (
              <div class="card-soft tool-card bg-[var(--color-paper)] rounded-[var(--radius-lg)] p-6 flex flex-col gap-5" data-uc>

                {/* En-tête : icône + nom + rôle */}
                <div class="flex items-center justify-between gap-3 flex-wrap">
                  <div class="inline-flex items-center gap-2.5 min-w-0">
                    <Icon name={tool.icon} class="stack-logo" aria-hidden="true" />
                    <span class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">{tool.name}</span>
                  </div>
                  <span class="chip chip-accent shrink-0">{tool.role}</span>
                </div>

                {/* Carrousel de cas d'usage — défilé horizontal */}
                <div class="usecase-viewport" role="group" aria-label={`Cas d'usage ${tool.name}`}>
                  <div class="usecase-track" data-uc-track>
                    {tool.useCases.map((uc, i) => (
                      <p
                        class="usecase-item m-0 text-[var(--color-ink-mid)] text-[length:var(--text-body-sm)] leading-[1.5]"
                        aria-hidden={i !== 0 ? 'true' : 'false'}
                      >
                        {uc}
                      </p>
                    ))}
                  </div>
                </div>

                {/* Navigation : compteur + flèches, épinglée en bas */}
                <div class="mt-auto flex items-center justify-between gap-3 pt-1">
                  <span class="mono-caption text-[var(--color-ink-low)] tabular-nums" data-uc-counter aria-hidden="true">1 / {tool.useCases.length}</span>
                  <div class="flex items-center gap-1.5">
                    <button type="button" class="uc-arrow" data-uc-prev aria-label={`Cas d'usage précédent — ${tool.name}`}>
                      <span aria-hidden="true">←</span>
                    </button>
                    <button type="button" class="uc-arrow" data-uc-next aria-label={`Cas d'usage suivant — ${tool.name}`}>
                      <span aria-hidden="true">→</span>
                    </button>
                  </div>
                </div>

              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .stack-logo {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  /* Carrousel de cas d'usage — défilé horizontal gauche/droite. La hauteur du
     track = cas d'usage le plus haut (items flex à 100%), donc pas de saut. */
  .usecase-viewport {
    overflow: hidden;
    min-height: 2.8em;
  }
  .usecase-track {
    display: flex;
    transition: transform var(--duration-default) var(--ease-out-quint);
  }
  .usecase-item {
    flex: 0 0 100%;
    min-width: 0;
  }

  .uc-arrow {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-sm);
    color: var(--color-ink-mid);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    cursor: pointer;
    transition: color var(--duration-default) var(--ease-out-quint),
                border-color var(--duration-default) var(--ease-out-quint),
                background-color var(--duration-default) var(--ease-out-quint),
                transform var(--duration-quick) var(--ease-out-quint);
  }
  .uc-arrow:hover {
    color: var(--color-ink);
    border-color: var(--color-ink-faint);
    background: var(--color-surface-low);
  }
  .uc-arrow:active { transform: scale(0.94); }

  /* Cibles tactiles 44px sur pointeur grossier (WCAG 2.5.5). */
  @media (hover: none) and (pointer: coarse) {
    .uc-arrow { width: 44px; height: 44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .usecase-track { transition: none; }
    .uc-arrow:active { transform: none; }
  }
</style>

<script>
  function initStackUseCases(): void {
    document.querySelectorAll<HTMLElement>('[data-uc]').forEach((uc) => {
      if (uc.dataset.ucInit === '1') return;
      uc.dataset.ucInit = '1';

      const track = uc.querySelector<HTMLElement>('[data-uc-track]');
      const counter = uc.querySelector<HTMLElement>('[data-uc-counter]');
      const prev = uc.querySelector<HTMLButtonElement>('[data-uc-prev]');
      const next = uc.querySelector<HTMLButtonElement>('[data-uc-next]');
      if (!track || !counter || !prev || !next) return;

      const items = Array.from(track.children) as HTMLElement[];
      const n = items.length;
      let idx = 0;

      function render(): void {
        track!.style.transform = `translateX(-${idx * 100}%)`;
        counter!.textContent = `${idx + 1} / ${n}`;
        items.forEach((it, i) => it.setAttribute('aria-hidden', String(i !== idx)));
      }

      function go(delta: number): void {
        idx = (idx + delta + n) % n;
        render();
      }

      prev.addEventListener('click', () => go(-1));
      next.addEventListener('click', () => go(1));

      // Flèches clavier quand le focus est dans la carte.
      uc.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { go(-1); }
        else if (e.key === 'ArrowRight') { go(1); }
      });

      render();
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initStackUseCases);
  else initStackUseCases();
  document.addEventListener('astro:page-load', initStackUseCases);
</script>
