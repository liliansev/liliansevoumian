---
/*
 * Stack.astro — section §03 (refonte).
 *
 * Deux couches empilées plutôt qu'un split côte-à-côte : la couche AUTOMATION
 * (violet, 3 outils) puis la couche IA (ember, 2 outils). Chaque outil est
 * décrit par CE QU'IL LIVRE au client (proposition de valeur), pas par une
 * définition. Two-Voice porté par la couleur des chips, plus par les colonnes.
 */
import SectionHeader from './SectionHeader.astro';
import { Icon } from 'astro-icon/components';

interface Tool {
  name: string;
  icon: string;
  role: string;
  value: string;
}

interface Layer {
  label: string;
  accent: 'violet' | 'ember';
  caption: string;
  tools: Tool[];
}

const layers: Layer[] = [
  {
    label: 'AUTOMATION',
    accent: 'violet',
    caption: 'LE SOCLE QUI EXÉCUTE',
    tools: [
      {
        name: 'n8n',
        icon: 'simple-icons:n8n',
        role: 'WORKFLOW · IA',
        value: 'Le moteur de vos workflows et de vos agents IA, cloud ou hébergé chez vous quand les données sont sensibles.',
      },
      {
        name: 'Make',
        icon: 'simple-icons:make',
        role: 'WORKFLOW',
        value: 'Pour connecter vite vos outils métiers et orchestrer les process visuels que votre équipe peut suivre.',
      },
      {
        name: 'Notion',
        icon: 'simple-icons:notion',
        role: 'OUTIL MÉTIER',
        value: 'Vos CRM, ERP et bases sur-mesure (Notion, Airtable…), là où votre équipe travaille déjà.',
      },
    ],
  },
  {
    label: 'IA',
    accent: 'ember',
    caption: 'LA COUCHE QUI DÉCIDE & CONSTRUIT',
    tools: [
      {
        name: 'Claude Code',
        icon: 'simple-icons:anthropic',
        role: 'IA · DEV',
        value: 'Des logiciels internes développés sur-mesure, à la vitesse de l\'IA.',
      },
      {
        name: 'Claude Cowork',
        icon: 'simple-icons:anthropic',
        role: 'IA · COACHING',
        value: 'Vos équipes pilotent leurs workflows par simple dialogue. J\'installe, je forme, je transmets.',
      },
    ],
  },
];
---

<section
  id="stack"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="03"
      label="STACK"
      title="Les outils, et la valeur qu'ils apportent."
      body="Cinq outils que j'utilise tous les jours, gardés chacun pour ce qu'il fait de mieux, du workflow no-code à l'agent IA sur-mesure."
      titleMaxWidth="22ch"
      bodyMaxWidth="60ch"
    />

    <div class="reveal flex flex-col gap-3 lg:gap-4">
      {layers.map((layer) => (
        <div class="relative">
          {/* Layer header — label accent seul (caption + compteur retirés) */}
          <div class="px-6 md:px-8 py-4 border-b border-[var(--color-divider)]">
            <span class={`mono-label ${layer.accent === 'violet' ? 'text-[var(--color-violet-deep)]' : 'text-[var(--color-ember-deep)]'}`}>
              {layer.label}
            </span>
          </div>

          {/* Tools — grid responsive, colonnes = nombre d'outils (pas de cellule vide) */}
          <div class={`grid grid-cols-1 ${layer.tools.length >= 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2'} gap-px bg-[var(--color-divider)]`}>
            {layer.tools.map((tool) => (
              <div class="bg-[var(--color-paper)] flex flex-col gap-3 px-6 md:px-8 py-5 md:py-6">
                <div class="flex items-center justify-between gap-3 flex-wrap">
                  <div class="inline-flex items-center gap-2.5">
                    <Icon
                      name={tool.icon}
                      class={`stack-logo ${layer.accent === 'violet' ? 'stack-logo-violet' : 'stack-logo-ember'}`}
                      aria-hidden="true"
                    />
                    <span class="font-display font-semibold text-[length:var(--text-title)] text-[var(--color-ink)]">
                      {tool.name}
                    </span>
                  </div>
                  <span class={`chip ${layer.accent === 'violet' ? 'chip-violet' : 'chip-ember'}`}>{tool.role}</span>
                </div>
                <span class="text-[var(--color-ink-mid)] text-[length:var(--text-body-sm)] leading-[1.55] max-w-[46ch]">
                  {tool.value}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .stack-logo {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .stack-logo-violet {
    color: var(--color-violet-deep);
  }
  .stack-logo-ember {
    color: var(--color-ember-deep);
  }
</style>
