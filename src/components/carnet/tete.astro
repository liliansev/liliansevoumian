---
/*
 * L'en-tête d'une section du carnet : un module du scénario (rond coloré,
 * griffonnage, numéro), le titre, le chapô. Pas de sur-titre : le titre
 * parle seul.
 *
 * La couleur du module est celle de la section ; le chemin de pointillés
 * (`chemin.astro`) va d'un module au suivant. Le titre peut être remplacé par
 * le slot `titre` (« J'adore… » porte son cœur).
 */
import Griffe from './griffe.astro';
import type { Forme } from '../../lib/carnet/griffonnages';

interface Props {
  numero: number;
  couleur: 'rose' | 'lilas' | 'jaune' | 'bleu' | 'blanc' | 'menthe';
  forme: Forme;
  graine: number;
  titre?: string;
  /** L'id du titre, que la section cite dans `aria-labelledby`. */
  idTitre?: string;
  chapo?: string;
  class?: string;
}

const { numero, couleur, forme, graine, titre, idTitre, chapo, class: classe } = Astro.props;
---

<div class:list={['tete', classe]}>
  <span class="module" aria-hidden="true" style={`--c:var(--${couleur})`}>
    <Griffe forme={forme} graine={graine} />
    <b>{numero}</b>
  </span>
  <slot name="titre">{titre && <h2 class="caps caps--section" id={idTitre}>{titre}</h2>}</slot>
  {chapo && <p class="chapo">{chapo}</p>}
  <slot />
</div>
