---
/*
 * Le symbole du carnet : trois points d'un scénario reliés par un pointillé,
 * dans un rond lilas. Le point du milieu, blanc, est celui où l'on intervient.
 *
 * `fin` donne le tracé du grand symbole du pied de page : à 140 px, le trait
 * de la petite taille paraît gras.
 */
interface Props {
  class?: string;
  fin?: boolean;
}

const { class: classe, fin = false } = Astro.props;
const trait = fin ? 1.2 : 2.5;
const rayon = fin ? 3.2 : 4;
---

<svg class:list={['symbole', classe]} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <circle cx="24" cy="24" r={fin ? 22.6 : 21.5} style={`fill:var(--lilas);stroke:var(--encre);stroke-width:${trait}`} />
  <path
    d="M12 32 C 17 31, 19 25, 24 24 S 31 17, 36 14"
    style={`fill:none;stroke:var(--encre);stroke-width:${fin ? 1.3 : 2.5};stroke-linecap:round;stroke-dasharray:${fin ? '.1 2.6' : '.1 5.5'}`}
  />
  <circle cx="12" cy="32" r={rayon} style="fill:var(--encre)" />
  <circle cx="24" cy="24" r={rayon} style={`fill:var(--blanc);stroke:var(--encre);stroke-width:${trait}`} />
  <circle cx="36" cy="14" r={rayon} style="fill:var(--encre)" />
</svg>
