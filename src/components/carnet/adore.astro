---
/*
 * Module 2, « J'adore… » : ce que Lilian fait, en autocollants, chacun avec
 * l'étiquette de son type de travail (rose agent IA, lilas automatisation,
 * bleu outil métier, jaune formation : le code de couleur de tout le carnet).
 * La liste vient de lui (27 octobre 2026) : tout y a déjà été fait, pour des
 * clients ou pour ses propres entreprises. Ni prix ni délais : la page est
 * une page de marque. Les autocollants sont rangés par type (critique du 27
 * octobre 2026 : mélangés, ils se lisaient comme une liste de huit), et la
 * note mène à l'index des cas clients, la preuve que cherche un décideur
 * (jamais à un cas précis : voir CLAUDE.md).
 */
import { Icon } from 'astro-icon/components';
import Griffe from './griffe.astro';
import Tete from './tete.astro';

type Type = 'agent IA' | 'automatisation' | 'outil métier' | 'formation';

const couleur: Record<Type, string> = {
  'agent IA': 'c-rose',
  automatisation: 'c-lilas',
  'outil métier': 'c-bleu',
  formation: 'c-jaune',
};

const autocollants: { type: Type; texte: string }[] = [
  { type: 'agent IA', texte: 'créer des agents IA qui gèrent votre support' },
  { type: 'agent IA', texte: 'créer des agents qui répondent au téléphone à votre place' },
  { type: 'automatisation', texte: 'automatiser votre facturation' },
  { type: 'automatisation', texte: 'transformer des bons de commande en commandes et en factures' },
  { type: 'automatisation', texte: 'réparer une automatisation qui casse' },
  { type: 'outil métier', texte: 'créer une application pour organiser les sessions de vos intervenants' },
  { type: 'outil métier', texte: 'construire des dashboards pour voir vos chiffres d’un coup d’œil' },
  { type: 'formation', texte: 'former vos équipes à Make, n8n et l’IA' },
];
---

<section class="etape adore" id="adore" aria-labelledby="titre-adore">
  <div class="carnet-enveloppe">
    <Tete numero={2} couleur="lilas" forme="coeur" graine={61}>
      <h2 slot="titre" class="caps adore__titre" id="titre-adore">J’adore…<Griffe forme="coeur" graine={62} /></h2>
      <p class="main adore__aparte">(liste non exhaustive)</p>
    </Tete>
    <ul class="autocollants">
      {autocollants.map((a) => (
        <li class:list={['autocollant', couleur[a.type]]}>
          <span class="tag">{a.type}</span><span>{a.texte}</span>
        </li>
      ))}
    </ul>
    <div class="adore__suite">
      <p class="main adore__note">tout ça, je l’ai déjà fait, pour des clients ou pour mes propres boîtes</p>
      <a class="lien" href="/cas-clients">Voir les cas clients<Icon name="lucide:arrow-right" class="icone" aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .adore__titre {
    position: relative;
    display: inline-block;
    font-size: var(--t-adore);
    line-height: 0.85;
  }

  .adore__titre :global(.griffe) {
    position: absolute;
    right: -56px;
    top: -16px;
    width: 60px;
    height: 54px;
  }

  .adore__titre :global(.griffe path) {
    stroke: var(--coeur);
    stroke-width: 3.2;
  }

  .adore__aparte {
    margin-top: 10px;
    color: var(--encre-doux);
    transform: rotate(-2deg);
    transform-origin: left top;
  }

  .autocollants {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px 18px;
    max-width: none;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .autocollant {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: none;
    padding: 10px 22px 10px 10px;
    border: var(--trait) solid var(--encre);
    border-radius: var(--r-pilule);
    box-shadow: var(--ombre-m);
    font: 700 var(--t-corps) / 1.3 var(--carnet-titre);
    transform: rotate(var(--r, 0deg));
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .autocollant:hover {
    transform: rotate(0) translate(-2px, -3px) scale(1.04);
    box-shadow: var(--ombre-l);
  }

  /* Penchés juste assez pour faire autocollant, pas assez pour se toucher
     quand une ligne en porte trois. */
  .autocollant:nth-child(4n + 1) { --r: -1.4deg; }
  .autocollant:nth-child(4n + 2) { --r: 1.1deg; }
  .autocollant:nth-child(4n + 3) { --r: -0.5deg; }
  .autocollant:nth-child(4n) { --r: 1.6deg; }

  .adore__suite {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 36px;
    text-align: center;
  }

  .adore__note {
    max-width: none;
    font-size: var(--t-note);
  }

  @media (max-width: 560px) {
    /* Sur un téléphone, l'étiquette passe au-dessus de la phrase : la
       phrase garde toute la largeur et une vraie ligne de lecture. */
    .autocollant {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 12px 16px 14px;
      border-radius: var(--r-l);
    }
    .adore__titre :global(.griffe) {
      right: -38px;
      width: 42px;
      height: 38px;
    }
  }
</style>
