---
/*
 * La barre du carnet, collante : le nom, les sections, « Écrire ». Le
 * bandeau de la newsletter qui la précédait est retiré (critique du 27
 * octobre 2026) : il disputait au premier écran son seul geste, « S'abonner
 * sur YouTube » ; la newsletter garde sa carte dans « Où me suivre ». Sous 920 px, les sections passent dans
 * un menu plein écran : une boîte de dialogue native, fermée par Échap, par
 * « Fermer » ou par un lien, qui rend ensuite le focus à la section visée.
 *
 * « Écrire » et « Parlons de votre projet » sont des `BoutonReservation` :
 * ils mènent au formulaire du bas de page avec le goal `contact_opened`.
 */
import BoutonReservation from '../BoutonReservation.astro';

interface Lien {
  href: string;
  label: string;
}

interface Props {
  /** Les liens de la barre : les sections de l'accueil par défaut, les
      ancres d'une page d'offre, ou les pages du site. */
  sections?: Lien[];
  /** Le nom de la barre dans les statistiques (`contact_opened`). */
  source?: string;
  /** Le nom du menu plein écran dans les statistiques. */
  sourceMenu?: string;
  /** Où mène le nom : le haut de la page sur l'accueil, l'accueil ailleurs. */
  marqueHref?: string;
}

const {
  sections = [
    { href: '#suivre', label: 'Me suivre' },
    { href: '#adore', label: 'Ce que je fais' },
    { href: '#methode', label: 'Comment je travaille' },
    { href: '#coulisses', label: 'Coulisses' },
  ],
  source = 'home_nav',
  sourceMenu = 'home_menu',
  marqueHref = '#main-content',
} = Astro.props;
/* La page en cours : un lien sans ancre qui mène ici, ou à la rubrique dont
   la page est une fiche (`/cas-clients/humble-plus` → « Cas clients »). */
const ici = Astro.url.pathname.replace(/\/$/, '') || '/';
const estIci = (href: string) => {
  if (href.includes('#')) return false;
  const cible = href.replace(/\/$/, '') || '/';
  return cible !== '/' && (ici === cible || ici.startsWith(`${cible}/`));
};
const marqueLibelle = marqueHref === '/' ? "Lilian Sevoumian, retour à l'accueil" : 'Lilian Sevoumian, haut de page';
---

<header class="barre carnet-ui">
  <div class="carnet-enveloppe barre__ligne">
    <a class="marque" href={marqueHref} aria-label={marqueLibelle}>
      <span>Lilian</span> <span>Sevoumian</span>
    </a>
    <nav class="barre__sections" aria-label="Sections">
      {sections.map((s) => <a href={s.href} data-barre-section={s.href.startsWith('#') ? '' : undefined} aria-current={estIci(s.href) ? 'page' : undefined}>{s.label}</a>)}
    </nav>
    <BoutonReservation source={source} class="pilule barre__ecrire">
      <span class="point" aria-hidden="true"></span>Écrire
    </BoutonReservation>
    <button class="pilule barre__menu" type="button" aria-haspopup="dialog" aria-controls="menu-carnet" data-menu-ouvrir>Menu</button>
  </div>
</header>

<dialog class="menu carnet-ui" id="menu-carnet" aria-label="Menu">
  <div class="menu__cadre" tabindex="-1">
    <div class="menu__haut">
      <span class="marque">Lilian Sevoumian</span>
      <button class="pilule" type="button" data-menu-fermer>Fermer</button>
    </div>
    {sections.map((s) => <a class="menu__entree" href={s.href} aria-current={estIci(s.href) ? 'page' : undefined}>{s.label}</a>)}
    <BoutonReservation source={sourceMenu} class="pilule pilule-encre menu__appel">
      <span class="point" aria-hidden="true"></span>Parlons de votre projet
    </BoutonReservation>
  </div>
</dialog>

<style>
  .barre {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: color-mix(in srgb, var(--papier) 96%, transparent);
  }

  .barre__ligne {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 78px;
  }

  .marque {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.25em;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--carnet-titre);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--t-note);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--encre);
    text-decoration: none;
  }

  .barre__sections {
    display: flex;
    gap: 6px;
    margin-left: auto;
    font-weight: 600;
    font-size: var(--t-corps);
  }

  .barre__sections a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    border-radius: var(--r-pilule);
    color: var(--encre);
    text-decoration: none;
  }

  .barre__sections a:hover,
  .barre__sections a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    text-decoration-color: var(--violet);
  }

  .barre :global(.pilule) {
    min-height: 46px;
    padding: 0 18px;
    font-size: var(--t-petit);
  }

  .barre__menu {
    display: none;
  }

  @media (max-width: 920px) {
    .barre__sections {
      display: none;
    }
    .barre :global(.barre__ecrire) {
      margin-left: auto;
    }
    .barre__menu {
      display: inline-flex;
    }
  }

  /* Sur un téléphone, le nom passe sur deux lignes : « Écrire » et « Menu »
     gardent leur place à côté. */
  @media (max-width: 560px) {
    .barre .marque {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      font-size: var(--t-citation);
      line-height: 0.9;
    }
  }

  @media (max-width: 380px) {
    .barre__ligne {
      gap: 10px;
    }
    .barre :global(.pilule) {
      padding: 0 14px;
    }
  }

  /* Le menu plein écran */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--papier);
    color: var(--encre);
  }

  .menu::backdrop {
    background: color-mix(in srgb, var(--encre) 40%, transparent);
  }

  .menu__cadre {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 100%;
    padding: calc(env(safe-area-inset-top, 0px) + 18px) var(--droite) calc(env(safe-area-inset-bottom, 0px) + 24px) var(--gauche);
    outline: none;
  }

  .menu__haut {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .menu__entree {
    padding: 12px 0;
    border-bottom: var(--trait) dashed var(--encre-filet);
    color: var(--encre);
    font: 800 clamp(2.2rem, 11vw, 3.2rem) / 1 var(--carnet-titre);
    font-stretch: 75%;
    text-transform: uppercase;
    text-decoration: none;
  }

  .menu__entree[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 8px;
    text-decoration-color: var(--violet);
  }

  .menu .marque {
    white-space: normal;
    line-height: 0.95;
  }

  .menu :global(.menu__appel) {
    align-self: flex-start;
    margin-top: 22px;
  }
</style>

<script>
  /* Le menu : ouvert en boîte de dialogue, il rend le focus à la section
     choisie, ou au bouton Menu s'il est fermé sans choix. Le lien « Parlons de
     votre projet » est pris en charge par Layout (défilement jusqu'au
     formulaire, curseur dans le premier champ) : le menu se ferme sans
     reprendre le focus. */
  const menu = document.querySelector<HTMLDialogElement>('#menu-carnet');
  const ouvrir = document.querySelector<HTMLButtonElement>('[data-menu-ouvrir]');
  const fermer = menu?.querySelector<HTMLButtonElement>('[data-menu-fermer]');
  /* Le verrou de défilement de Layout (`window.__verrouDefilement`), celui du
     menu des autres pages et de l'agenda : sans lui, la page défile derrière
     la boîte de dialogue sur iOS. Il est levé avant que le lien choisi ne
     fasse défiler la page, sinon il la ramènerait à sa position d'avant. */
  const verrou = (actif: boolean) =>
    (window as unknown as { __verrouDefilement?: (proprietaire: string, actif: boolean) => void }).__verrouDefilement?.(
      'menu-carnet',
      actif,
    );
  if (menu && ouvrir && fermer) {
    ouvrir.addEventListener('click', () => {
      menu.showModal();
      verrou(true);
      menu.querySelector<HTMLElement>('.menu__cadre')?.focus();
    });
    fermer.addEventListener('click', () => menu.close());
    let cible: HTMLElement | null = null;
    let lienChoisi = false;
    menu.querySelectorAll<HTMLAnchorElement>('a').forEach((lien) =>
      lien.addEventListener('click', () => {
        const href = lien.getAttribute('href') ?? '';
        cible = href.startsWith('#') ? document.querySelector<HTMLElement>(href) : null;
        lienChoisi = true;
        verrou(false);
        menu.close();
      }),
    );
    menu.addEventListener('close', () => {
      verrou(false);
      if (cible) {
        cible.setAttribute('tabindex', '-1');
        cible.focus({ preventScroll: true });
      } else if (!lienChoisi) {
        ouvrir.focus({ preventScroll: true });
      }
      cible = null;
      lienChoisi = false;
    });
  }

  /* La section en cours, soulignée dans la barre. Toutes les sections sont
     suivies, celles qui n'ont pas de lien comprises (l'ouverture, les avis, le
     contact) : en haut de page comme passé « Coulisses », rien n'est
     souligné. */
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('[data-barre-section]')];
  const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
  const marquer = (id: string) =>
    liens.forEach((lien) =>
      lien.getAttribute('href') === `#${id}` ? lien.setAttribute('aria-current', 'true') : lien.removeAttribute('aria-current'),
    );
  if (sections.length) {
    const observateur = new IntersectionObserver(
      (entrees) => entrees.forEach((e) => e.isIntersecting && marquer(e.target.id)),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observateur.observe(s));
  }
</script>
