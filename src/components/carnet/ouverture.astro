---
/*
 * L'ouverture : « salut, moi c'est » Lilian, en très grand, sa signature à la
 * main, ce qu'il fait en une phrase. Un seul geste principal, s'abonner sur
 * YouTube (demande de Lilian, 27 octobre 2026) ; le contact reste à côté, en
 * lien. Sous les boutons, l'audience, datée, comme preuve sociale (les
 * chiffres viennent de `data/parcours.ts`, jamais le nombre d'abonnés de la
 * newsletter).
 *
 * À droite, la photo du NoCode Summit en polaroïd, et la pastille de la
 * certification Make.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BoutonReservation from '../BoutonReservation.astro';
import Griffe from './griffe.astro';
import { audience, profils } from '../../data/parcours';
import summit from '../../assets/carnet/nocode-summit.jpg';

const chiffres = [audience.linkedin, audience.youtube, audience.vues];
---

<!-- `#a-propos` : la barre et le pied des pages intérieures y mènent (« À propos »). -->
<section class="ouverture" id="a-propos" aria-labelledby="titre-ouverture">
  <div class="carnet-enveloppe ouverture__grille">
    <div>
      <p class="main ouverture__salut">salut, moi c’est</p>
      <h1 class="caps ouverture__nom" id="titre-ouverture">Lilian <br />Sevoumian</h1>
      <p class="main ouverture__signature">l’indé super augmenté<Griffe forme="vague" graine={5} etire /></p>
      <p class="chapo ouverture__chapo">
        J’automatise le travail répétitif des entreprises avec Make, n8n et des agents IA. Et je montre comment je fais sur YouTube.
      </p>
      <div class="ouverture__actions">
        <a
          class="pilule pilule-encre ouverture__abonner"
          href={profils.youtube}
          target="_blank"
          rel="noopener noreferrer"
          data-fast-goal="youtube_opened"
          data-fast-goal-source="home_hero_abonner"
        ><span class="lecture-mini" aria-hidden="true"></span>S’abonner sur YouTube<span class="sr-only"> (nouvel onglet)</span></a>
        <BoutonReservation source="home_hero" class="lien">ou parlons de votre projet<Icon name="lucide:arrow-right" class="icone" aria-hidden="true" /></BoutonReservation>
      </div>
      <ul class="audience" aria-label={`Mon audience, chiffres relevés le ${audience.releveAffiche}`}>
        {chiffres.map((c) => (
          <li class="audience__chiffre">
            <strong>{c.nombre}</strong>
            <span>{c.libelle}</span>
          </li>
        ))}
      </ul>
      <p class="audience__date" aria-hidden="true">chiffres relevés le {audience.releveAffiche}</p>
    </div>
    <div class="ouverture__photo">
      <figure class="polaroid">
        <span class="scotch scotch--g" aria-hidden="true"></span>
        <span class="scotch scotch--d" aria-hidden="true"></span>
        <span class="cadre">
          <Image
            src={summit}
            alt="Lilian, casquette à l’envers, concentré sur son ordinateur au NoCode Summit"
            width={1100}
            widths={[480, 760, 1100]}
            sizes="(max-width: 900px) 330px, 420px"
            loading="eager"
            fetchpriority="high"
            class="ouverture__image"
          />
        </span>
        <figcaption>moi, au NoCode Summit</figcaption>
      </figure>
      <p class="ouverture__pastille"><span><strong>1er</strong> Français certifié Make niveau 5</span></p>
    </div>
  </div>
</section>

<style>
  .ouverture {
    padding-block: clamp(32px, 5vw, 72px) clamp(40px, 5vw, 64px);
    overflow-x: clip;
  }

  .ouverture__grille {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }

  .ouverture__salut {
    margin-bottom: 10px;
  }

  .ouverture__nom {
    font-size: var(--t-nom);
    line-height: 0.84;
    letter-spacing: -0.015em;
  }

  .ouverture__signature {
    position: relative;
    display: inline-block;
    margin-top: 22px;
    font-size: var(--t-signature);
    color: var(--violet);
    transform: rotate(-2deg);
    /* Pivot en haut à gauche : penchée, la signature ne sort pas de la
       gouttière (16 px sur téléphone). */
    transform-origin: left top;
  }

  .ouverture__signature :global(.griffe) {
    position: absolute;
    left: -2%;
    bottom: -12px;
    width: 104%;
    height: 16px;
  }

  .ouverture__signature :global(.griffe path) {
    stroke: var(--violet);
    stroke-width: 3;
  }

  .ouverture__chapo {
    margin: 26px 0 0;
    max-width: 30em;
  }

  .ouverture__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
    margin-top: 30px;
  }

  .ouverture__abonner {
    min-height: 58px;
    padding: 0 28px;
    font-size: var(--t-corps);
  }

  .audience {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
  }

  .audience__chiffre {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: none;
    padding: 10px 16px 11px;
    background: var(--blanc);
    border: var(--trait) solid var(--encre);
    border-radius: var(--r-m);
    box-shadow: var(--ombre-s);
  }

  .audience__chiffre:nth-child(1) { transform: rotate(-1.5deg); }
  .audience__chiffre:nth-child(2) { transform: rotate(1deg); }
  .audience__chiffre:nth-child(3) { transform: rotate(-0.6deg); }

  .audience__chiffre strong {
    font: 800 var(--t-chiffre) / 0.95 var(--carnet-titre);
    font-stretch: 75%;
    letter-spacing: -0.01em;
  }

  .audience__chiffre span {
    margin-top: 4px;
    font: 700 var(--t-code) / 1.25 var(--carnet-code);
    color: var(--encre-doux);
  }

  .audience__date {
    margin: 10px 0 0;
    max-width: none;
    font: 700 var(--t-etiquette) / 1.3 var(--carnet-code);
    color: var(--encre-doux);
  }

  .ouverture__photo {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
  }

  .ouverture__photo .polaroid {
    transform: rotate(2.5deg);
  }

  .ouverture__photo :global(.ouverture__image) {
    object-position: 30% 40%;
    transform: scale(1.35);
    transform-origin: 40% 42%;
  }

  .ouverture__pastille {
    position: absolute;
    left: -52px;
    bottom: 76px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 148px;
    height: 148px;
    max-width: none;
    margin: 0;
    padding: 16px;
    border: var(--trait) solid var(--encre);
    border-radius: 50%;
    background: var(--jaune);
    box-shadow: var(--ombre-m);
    font: 800 var(--t-petit) / 1.02 var(--carnet-titre);
    font-stretch: 80%;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(-7deg);
  }

  .ouverture__pastille strong {
    display: block;
    font-size: var(--t-chiffre);
    line-height: 0.9;
  }

  @media (max-width: 900px) {
    .ouverture__grille {
      grid-template-columns: minmax(0, 1fr);
    }
    .ouverture__photo {
      max-width: 330px;
      margin-top: 22px;
    }
    .ouverture__pastille {
      left: -10px;
      width: 124px;
      height: 124px;
      padding: 13px;
      font-size: var(--t-code);
    }
    .ouverture__pastille strong {
      font-size: var(--t-note);
    }
  }

  @media (max-width: 480px) {
    .audience {
      gap: 10px;
    }
    .audience__chiffre {
      padding: 8px 12px 9px;
    }
    .audience__chiffre strong {
      font-size: var(--t-carte);
    }
  }
</style>
