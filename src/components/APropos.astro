---
/*
 * APropos — le bloc de légitimité, et le seul endroit du site où le nom de
 * l'entité figure dans un titre.
 *
 * Deux fonctions à la fois :
 *  — pour le lecteur : il vient de voir quatre cas et trois recommandations,
 *    « qui est ce type » est exactement sa question suivante, et elle doit
 *    trouver sa réponse avant le calculateur, qui demande un effort ;
 *  — pour les moteurs de réponse : c'est le bloc qu'ils citeront pour
 *    répondre « qui est-il ». D'où la fiche de faits en <dl> sous le texte,
 *    chaque ligne autonome et extractible hors de son contexte.
 *
 * Tous les faits ici sont sourcés dans profile.md et dans les cas publiés :
 * Make niveau 5 premier français (:28), Airtable certifié (:31), 300+ formés
 * (:21, :44), depuis 2020 (:43), et les chiffres Fraich Touch / Humble+ qui
 * viennent des frontmatters. Aucun chiffre nouveau.
 */
import SectionHeader from './SectionHeader.astro';

const faits = [
  { cle: 'Depuis', valeur: '2020' },
  { cle: 'Certifications', valeur: 'Make niveau 5 — premier certifié en France · Airtable' },
  { cle: 'Formation', valeur: '300+ personnes formées' },
  { cle: 'Zone', valeur: 'Région parisienne · France · Europe' },
];
---

<section
  id="a-propos"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">
    <SectionHeader
      label="À PROPOS"
      title="Lilian Sevoumian, freelance automatisation &amp; IA <mark>depuis 2020.</mark>"
      titleMaxWidth="24ch"
    />

    <div class="reveal apropos">
      <div class="apropos-texte">
        <p>
          Je suis freelance en automatisation et en intelligence artificielle,
          basé en région parisienne, et j'interviens partout en France et en
          Europe. J'ai commencé à automatiser des processus métier en 2020,
          avant que l'IA générative n'entre dans les entreprises.
        </p>

        <p>
          Je suis certifié Make niveau&nbsp;5 — le premier en France à
          l'obtenir — et certifié Airtable. J'ai formé plus de 300 personnes à
          ces outils, en formation comme chez mes clients.
        </p>

        <p>
          Le plus souvent, on ne m'appelle pas pour ajouter une automatisation
          de plus&nbsp;: on m'appelle parce que celles qui existent cassent.
          Chez Fraich&nbsp;Touch, 33 scénarios Make imbriqués sont devenus 4,
          et 16 factures bloquées en erreur sont revenues à 0. Chez
          Humble+, un scénario fragile a été remplacé par un workflow n8n qui
          traite les bons de commande PDF et Excel sans une seule ressaisie.
        </p>

        <p>
          Je travaille en direct&nbsp;: la personne qui vous répond est celle
          qui construit. Et quand un projet n'est pas pour moi, je le dis avant
          de commencer.
        </p>
      </div>

      <dl class="apropos-faits">
        {faits.map((f) => (
          <div class="apropos-fait">
            <dt>{f.cle}</dt>
            <dd>{f.valeur}</dd>
          </div>
        ))}
        <div class="apropos-fait">
          <dt>Cas publiés</dt>
          <dd><a href="/cas-clients">4 missions documentées, chiffres à l'appui</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .apropos {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
    margin-top: 2.5rem;
  }

  .apropos-texte p {
    max-width: 62ch;
    color: var(--color-ink-mid);
    line-height: 1.65;
  }
  .apropos-texte p + p { margin-top: 1.25rem; }
  .apropos-texte p:first-child { color: var(--color-ink); }

  .apropos-faits {
    margin: 0;
    border-top: 2px solid var(--color-ink);
  }

  .apropos-fait {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .apropos-fait dt {
    font-size: var(--text-mono-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-low);
  }

  .apropos-fait dd {
    margin: 0;
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-ink);
  }

  .apropos-fait a {
    color: inherit;
    text-decoration: none;
    border-bottom: 2px solid var(--color-lime);
    padding-bottom: 1px;
  }
  .apropos-fait a:hover { border-bottom-color: var(--color-ink); }

  @media (max-width: 52rem) {
    .apropos { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
