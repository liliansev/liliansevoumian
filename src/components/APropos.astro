---
/*
 * APropos — qui construit, en bref : deux paragraphes à la première personne,
 * et à côté ce qu'on retient. Les faits viennent du parcours fourni par Lilian.
 */
import SectionHeader from './SectionHeader.astro';
import LinkCTA from './LinkCTA.astro';

const faits = ['Depuis 2020', '300+ personnes formées'];
---

<section
  id="a-propos"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader title="Moi, c’est Lilian." titleMaxWidth="24ch" />

    <div class="reveal apropos">
      <div class="apropos-texte">
        <p>
          J’aime comprendre comment une équipe travaille et chercher ce qui
          pourrait lui simplifier la journée. C’est ce qui me passionne dans
          l’IA et l’automatisation.
        </p>

        <p>
          Chez Jellysmack, j’ai passé un an à construire et maintenir des
          automatisations. Je partage aussi ce que j’apprends en formant des
          équipes à ces outils.
        </p>
      </div>

      {/* Ce qu'on retient, une ligne par fait, puis la sortie vers les cas :
          ni étiquette en capitales, ni filet. */}
      <div class="apropos-retenir">
        <ul class="apropos-faits">
          {faits.map((fait) => <li>{fait}</li>)}
        </ul>
        <LinkCTA href="/cas-clients">Voir les cas clients</LinkCTA>
      </div>
    </div>
  </div>
</section>

<style>
  .apropos {
    display: grid;
    gap: var(--spacing-groupe);
    align-items: start;
  }

  /* Même partage que les recommandations juste au-dessus : la colonne de
     droite des deux sections tombe sur la même verticale. */
  @media (min-width: 900px) {
    .apropos {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      column-gap: var(--spacing-gouttiere);
    }
  }

  .apropos-texte p {
    margin: 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  .apropos-texte p + p {
    margin-top: var(--spacing-lie);
  }

  .apropos-retenir {
    display: grid;
    justify-items: start;
    gap: var(--spacing-lie);
  }

  .apropos-faits {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Au corps d'un titre de rang 3, à l'encre pleine. */
  .apropos-faits li {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
</style>
