---
import SectionHeader from './SectionHeader.astro';
---

<section
  id="contact"
  data-section
  data-fast-scroll="scroll_to_section_contact"
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="06"
      label="CONTACT"
      title="Parlons de votre projet."
      body="Je lis chaque demande et je réponds sous 48 h, avec un premier regard concret sur ce qu'on peut automatiser chez vous."
      titleMaxWidth="22ch"
      bodyMaxWidth="60ch"
      class="!mb-0"
    />

    <!-- Signature humaine d'abord — confidence-then-action. La preuve doit
         précéder le bouton, sinon un visiteur qui ne scrolle pas jusqu'en bas
         clique sans avoir vu la rassurance. -->
    <div class="relative reveal mt-10 md:mt-12 grid grid-cols-1 md:grid-cols-[auto_1fr] gap-x-8 gap-y-6">
      <span class="grid-corner tl" aria-hidden="true"></span>
      <span class="grid-corner tr" aria-hidden="true"></span>
      <span class="grid-corner bl" aria-hidden="true"></span>
      <span class="grid-corner br" aria-hidden="true"></span>

      <!-- Colonne gauche : signature stamp -->
      <div class="flex flex-col gap-2">
        <div class="mono-caption text-[var(--color-ink-low)]">SIGNÉ</div>
        <div
          class="font-display font-semibold tracking-[-0.025em] leading-[0.95] text-[var(--color-ink)]"
          style="font-size: var(--text-signature);"
        >
          Lilian<br/>Sevoumian.
        </div>
      </div>

      <!-- Colonne droite : credentials + liens -->
      <div class="flex flex-col gap-5 max-w-[55ch]">
        <p class="text-[length:var(--text-body-large)] leading-[1.55] m-0 text-[var(--color-ink-mid)]">
          <span class="text-[var(--color-ink)]">Make certifié Niveau 5 (1<sup>er</sup> certifié en France).</span>
          500+ workflows en production pour des Heads of Ops, fondateurs et PME.
          Paris, remote-first.
        </p>

        <!-- Stamps techniques inline — focus sur ce qui n'est PAS dans
             le hero (incidents, SLA, lieu remote) pour éviter duplication. -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mono-caption pt-4 text-[var(--color-ink-low)]">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1 h-1 rounded-full bg-[var(--color-violet)] inline-block"></span>
            0 INCIDENT NON RÉSOLU /SLA
          </span>
          <span>·</span>
          <span>30 J SLA INCLUS</span>
          <span>·</span>
          <span>REMOTE-FIRST</span>
        </div>

        <!-- Liens externes -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mono-caption text-[var(--color-ink-mid)]">
          <a href="https://www.linkedin.com/in/liliansevoumian/" target="_blank" rel="noopener noreferrer" class="tap-44 inline-flex items-center gap-1 hover:text-[var(--color-ink)] transition-colors">LINKEDIN <span class="text-[var(--color-violet-deep)]" aria-hidden="true">↗</span></a>
          <span class="text-[var(--color-ink-faint)]" aria-hidden="true">·</span>
          <a href="https://www.youtube.com/@lilian.sevoumian" target="_blank" rel="noopener noreferrer" class="tap-44 inline-flex items-center gap-1 hover:text-[var(--color-ink)] transition-colors">YOUTUBE <span class="text-[var(--color-violet-deep)]" aria-hidden="true">↗</span></a>
          <span class="text-[var(--color-ink-faint)]" aria-hidden="true">·</span>
          <a href="https://liliansevoumian.substack.com/" target="_blank" rel="noopener noreferrer" data-fast-goal="newsletter_click" data-fast-goal-source="contact" class="tap-44 inline-flex items-center gap-1 hover:text-[var(--color-ink)] transition-colors">NEWSLETTER <span class="text-[var(--color-violet-deep)]" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>

    <!-- Zone d'action — formulaire on-site (= canal "formulaire rempli").
         Poste sur /api/contact (Resend) avec fallback mailto si l'API échoue,
         pour ne jamais bloquer un lead. -->
    <div class="reveal mt-14 md:mt-16 max-w-[600px]">

      <!-- Formulaire -->
      <form id="contact-form" class="flex flex-col gap-4 scroll-mt-24" novalidate>
        <div class="flex flex-col sm:flex-row gap-4">
          <label class="flex-1 flex flex-col gap-1.5">
            <span class="mono-caption text-[var(--color-ink-low)]">NOM</span>
            <input class="input-text" type="text" name="name" required autocomplete="name" placeholder="Votre nom" />
          </label>
          <label class="flex-1 flex flex-col gap-1.5">
            <span class="mono-caption text-[var(--color-ink-low)]">EMAIL</span>
            <input class="input-text" type="email" name="email" required autocomplete="email" placeholder="vous@entreprise.com" />
          </label>
        </div>
        <label class="flex flex-col gap-1.5">
          <span class="mono-caption text-[var(--color-ink-low)]">VOTRE BESOIN EN UNE PHRASE</span>
          <textarea class="input-text" name="message" required rows="3" placeholder="Ex : automatiser la saisie des leads HubSpot vers nos 3 outils."></textarea>
        </label>
        {/* Anti-spam : honeypot invisible (rempli par les bots, jamais par un humain). */}
        <div class="hp-field" aria-hidden="true">
          <label>Laissez ce champ vide
            <input type="text" name="company" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <button type="submit" class="btn-primary justify-center" data-contact-submit>
          Envoyer ma demande
        </button>
        <p class="mono-caption text-[var(--color-ink-low)] leading-[1.5]" data-form-status role="status" aria-live="polite">
          RÉPONSE SOUS 48 H · SANS ENGAGEMENT · JE LIS CHAQUE DEMANDE
        </p>
      </form>
    </div>

  </div>
</section>

<script>
  function initContactForm(): void {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.init === '1') return;
    form.dataset.init = '1';

    // Anti-spam : instant de rendu, pour mesurer le temps de remplissage (bots = quasi instantané).
    const startTime = Date.now();

    const statusEl = form.querySelector<HTMLElement>('[data-form-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-contact-submit]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const data = {
        name: (form.elements.namedItem('name') as HTMLInputElement).value.trim(),
        email: (form.elements.namedItem('email') as HTMLInputElement).value.trim(),
        message: (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim(),
        // Anti-spam : honeypot (doit rester vide) + temps de remplissage en ms.
        company: (form.elements.namedItem('company') as HTMLInputElement | null)?.value || '',
        elapsed: Date.now() - startTime,
      };

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Envoi…'; }
      if (statusEl) { statusEl.style.color = ''; statusEl.textContent = 'ENVOI EN COURS…'; }

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));

        if (statusEl) { statusEl.style.color = 'var(--color-success)'; statusEl.textContent = '✓ ENVOYÉ — JE RÉPONDS SOUS 48 H.'; }
        form.reset();
        // Conversion réelle (form soumis) → goal DataFast le plus fiable.
        const df = (window as unknown as { datafast?: (g: string, p?: Record<string, string>) => void }).datafast;
        if (typeof df === 'function') df('contact_lead', { type: 'form', source: 'contact' });
      } catch {
        // Fallback : pré-remplir un mailto pour ne jamais bloquer le lead.
        // Construction DOM sûre (textContent + href), pas d'innerHTML.
        const subject = encodeURIComponent(`Demande — ${data.name}`);
        const body = encodeURIComponent(`${data.message}\n\n— ${data.name} (${data.email})`);
        if (statusEl) {
          statusEl.style.color = 'var(--color-error)';
          statusEl.textContent = "L'ENVOI A ÉCHOUÉ. ";
          const link = document.createElement('a');
          link.href = `mailto:bonjour@liliansevoumian.fr?subject=${subject}&body=${body}`;
          link.textContent = 'ÉCRIVEZ-MOI DIRECTEMENT →';
          link.className = 'underline text-[var(--color-violet-deep)]';
          statusEl.appendChild(link);
        }
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Envoyer ma demande'; }
      }
    });

    // Pré-remplissage depuis les CTA d'offres (data-prefill) : le message reflète
    // l'offre cliquée. Délégation sur document, n'écrase jamais une saisie en cours.
    const messageEl = form.elements.namedItem('message') as HTMLTextAreaElement | null;
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('[data-prefill]');
      if (!trigger || !messageEl) return;
      const offer = trigger.getAttribute('data-prefill');
      if (offer && !messageEl.value.trim()) {
        messageEl.value = `Bonjour, je suis intéressé par l'offre « ${offer} ».`;
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initContactForm);
  else initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
