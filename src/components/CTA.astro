---
import SectionHeader from './SectionHeader.astro';
---

<section
  id="contact"
  data-section
  data-fast-scroll="scroll_to_section_contact"
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="06"
      label="CONTACT"
      title="Un diagnostic. Un plan d'action. Pas de pitch."
      body="Je lis chaque demande. Si votre projet ne rentre pas dans ma méthode, je vous le dis en 10 minutes et je vous oriente."
      titleMaxWidth="22ch"
      bodyMaxWidth="60ch"
      class="!mb-0"
    />

    <!-- Signature humaine d'abord — confidence-then-action. La preuve doit
         précéder le bouton, sinon un visiteur qui ne scrolle pas jusqu'en bas
         clique sans avoir vu la rassurance. -->
    <div class="relative reveal mt-10 md:mt-12 grid grid-cols-1 md:grid-cols-[auto_1fr] gap-x-8 gap-y-6">
      <span class="grid-corner tl" aria-hidden="true"></span>
      <span class="grid-corner tr" aria-hidden="true"></span>
      <span class="grid-corner bl" aria-hidden="true"></span>
      <span class="grid-corner br" aria-hidden="true"></span>

      <!-- Colonne gauche : signature stamp -->
      <div class="flex flex-col gap-2">
        <div class="mono-caption text-[var(--color-ink-low)]">SIGNÉ</div>
        <div
          class="font-display font-semibold tracking-[-0.025em] leading-[0.95] text-[var(--color-ink)]"
          style="font-size: var(--text-signature);"
        >
          Lilian<br/>Sevoumian.
        </div>
      </div>

      <!-- Colonne droite : credentials + liens -->
      <div class="flex flex-col gap-5 max-w-[55ch]">
        <p class="text-[length:var(--text-body-large)] leading-[1.55] m-0 text-[var(--color-ink-mid)]">
          <span class="text-[var(--color-ink)]">Make certifié Niveau 5 (1<sup>er</sup> certifié en France).</span>
          500+ workflows en production pour des Heads of Ops, fondateurs et PME.
          Paris, remote-first.
        </p>

        <!-- Stamps techniques inline — focus sur ce qui n'est PAS dans
             le hero (incidents, SLA, lieu remote) pour éviter duplication. -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mono-caption pt-4 border-t border-[var(--color-divider)] text-[var(--color-ink-low)]">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1 h-1 rounded-full bg-[var(--color-violet)] inline-block"></span>
            0 INCIDENT NON RÉSOLU /SLA
          </span>
          <span>·</span>
          <span>30 J SLA INCLUS</span>
          <span>·</span>
          <span>REMOTE-FIRST</span>
        </div>

        <!-- Liens externes -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mono-caption text-[var(--color-ink-mid)]">
          <a href="https://www.linkedin.com/in/liliansevoumian/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-[var(--color-ink)] transition-colors">LINKEDIN <span class="text-[var(--color-violet-deep)]">↗</span></a>
          <span class="text-[var(--color-ink-faint)]">·</span>
          <a href="https://www.youtube.com/@lilian.sevoumian" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-[var(--color-ink)] transition-colors">YOUTUBE <span class="text-[var(--color-violet-deep)]">↗</span></a>
          <span class="text-[var(--color-ink-faint)]">·</span>
          <a href="https://liliansevoumian.substack.com/" target="_blank" rel="noopener noreferrer" data-fast-goal="click_newsletter" class="inline-flex items-center gap-1 hover:text-[var(--color-ink)] transition-colors">NEWSLETTER <span class="text-[var(--color-violet-deep)]">↗</span></a>
        </div>
      </div>
    </div>

    <!-- CTA + meta — l'action finale, séparée du bloc signature par un border. -->
    <div class="reveal mt-12 md:mt-16 pt-10 border-t border-[var(--color-divider)] flex flex-col gap-6">
      <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
        <a
          href="https://cal.com/lilian-sevoumian/20min"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary justify-center"
          data-fast-goal="click_cta_contact"
        >
          Réserver 20 min
        </a>
        <a
          href="mailto:bonjour@liliansevoumian.fr"
          class="btn-ghost justify-center"
          data-fast-goal="click_email"
        >
          ou écrire un mail
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mono-caption text-[var(--color-ink-low)]">
        <span>20 MIN · GRATUIT · SANS ENGAGEMENT</span>
        <span class="hidden md:inline" aria-hidden="true">·</span>
        <span>PLAN D'ACTION SOUS 48 H</span>
      </div>
    </div>

  </div>
</section>
