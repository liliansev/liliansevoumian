---
import SectionHeader from './SectionHeader.astro';
---

<section
  id="contact"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="07"
      label="APPEL"
      title="30 minutes pour décider si on travaille ensemble."
      body="Format identique à chaque fois : 5 min de contexte, 15 min sur vos process, 10 min de plan d'action chiffré que je formalise sous 48 h. Sans engagement."
      titleMaxWidth="22ch"
      bodyMaxWidth="60ch"
      class="!mb-0"
    />

    <!-- CTA + meta -->
    <div class="reveal mt-10 md:mt-12 flex flex-col gap-6">
      <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
        <a
          href="https://cal.com/lilian-sevoumian/20min"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary justify-center"
        >
          Réserver maintenant
        </a>
        <a
          href="mailto:bonjour@liliansevoumian.fr"
          class="btn-ghost justify-center"
        >
          ou écrire un mail
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mono-caption text-[var(--color-ink-low)]">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-violet)] inline-block"></span>
          PROCHAIN CRÉNEAU LIBRE : DEMAIN 14H
        </span>
        <span class="hidden md:inline" aria-hidden="true">·</span>
        <span>30 MIN · GRATUIT · SANS ENGAGEMENT</span>
        <span class="hidden md:inline" aria-hidden="true">·</span>
        <span>PLAN D'ACTION SOUS 48 H</span>
      </div>
    </div>

    <!-- Signature humaine — bloc présent avec poids visuel fort, version light -->
    <div class="reveal mt-16 md:mt-24 grid grid-cols-1 md:grid-cols-[auto_1fr] gap-x-8 gap-y-6 pt-10 border-t border-[var(--color-divider)]">
      <!-- Colonne gauche : signature stamp -->
      <div class="flex flex-col gap-2">
        <div class="mono-caption text-[var(--color-ink-low)]">SIGNÉ</div>
        <div
          class="font-display font-semibold tracking-[-0.025em] leading-[0.95] text-[var(--color-ink)]"
          style="font-size: clamp(2rem, 3vw + 0.5rem, 2.75rem);"
        >
          Lilian<br/>Sevoumian.
        </div>
      </div>

      <!-- Colonne droite : credentials + liens -->
      <div class="flex flex-col gap-5 max-w-[55ch]">
        <p class="text-[length:var(--text-body-large)] leading-[1.55] m-0 text-[var(--color-ink-mid)]">
          <span class="text-[var(--color-ink)]">8 ans à brancher des process</span>
          pour des Heads of Ops, fondateurs et PME. Make certifié niveau 5
          (1<sup>er</sup> français), Paris, remote-first.
        </p>

        <!-- Stamps techniques inline -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mono-caption pt-4 border-t border-[var(--color-divider)] text-[var(--color-ink-low)]">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-1 h-1 rounded-full bg-[var(--color-violet)] inline-block"></span>
            500+ WORKFLOWS
          </span>
          <span>·</span>
          <span>2000H /MOIS</span>
          <span>·</span>
          <span>0 ERREUR /SLA</span>
        </div>

        <!-- Liens externes -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mono-caption text-[var(--color-ink-mid)]">
          <a href="https://www.linkedin.com/in/liliansevoumian/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-[var(--color-ink)] transition-colors">LINKEDIN <span class="text-[var(--color-violet)]">↗</span></a>
          <span class="text-[var(--color-ink-faint)]">·</span>
          <a href="https://www.youtube.com/@lilian.sevoumian" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-[var(--color-ink)] transition-colors">YOUTUBE <span class="text-[var(--color-violet)]">↗</span></a>
          <span class="text-[var(--color-ink-faint)]">·</span>
          <a href="https://liliansevoumian.substack.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-[var(--color-ink)] transition-colors">NEWSLETTER <span class="text-[var(--color-violet)]">↗</span></a>
        </div>
      </div>
    </div>

  </div>
</section>
