---
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import lilianPhoto from '../assets/lilian-photo.jpg';
import BoutonReservation from './BoutonReservation.astro';
import { DUREE_RESERVATION_MINUTES, LIBELLE_CONTACT_RESERVATION } from '../lib/reservation';
---

<section
  id="contact"
  data-section  class="bloc-lime relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    {/* Sans sur-titre : « CONTACT » au-dessus de « Parlons de votre projet »
        annonçait une deuxième fois ce que la phrase dit déjà, et la section
        porte l'ancre `#contact` pour la navigation. */}
    <SectionHeader
      title="Qu’est-ce qui vous prend <mark class='inv'>trop de temps ?</mark>"
      body={`${DUREE_RESERVATION_MINUTES} minutes pour examiner le problème et choisir par quoi commencer.`}
      titleMaxWidth="22ch"
      bodyMaxWidth="60ch"
      class="!mb-0"
    />

    {/* Face-a-face : qui je suis (gauche) + le créneau (droite). Sur mobile la
        confiance passe avant l'action — on lit d'abord la signature, on réserve
        ensuite. */}
    <div class="relative reveal mt-10 md:mt-14 grid grid-cols-1 lg:grid-cols-[0.85fr_1fr] gap-10 lg:gap-16 items-start">

      <!-- Colonne gauche : signature + statement passionne -->
      <div class="flex flex-col gap-6">

      {/* Signature : le portrait accompagne le nom, à toutes les largeurs.
          Il portait `lg:hidden`, et l'avatar de la navigation aussi : au-delà de
          1024 px le site ne montrait donc aucun visage, sur une marque qui est
          un nom propre. Le hero reste volontairement typographique — la décision
          est écrite dans HeroManifesto.astro — donc le seul endroit où le visage
          peut apparaître en desktop est ici, à côté de la signature.
          Il grandit de 72 à 96 px au-dessus de 1024 px : c'est la hauteur exacte
          des deux lignes de « Lilian / Sevoumian. » (48 px de corps, interligne
          0,95), si bien que le portrait s'aligne sur le nom au lieu de former un
          second bloc. À cette taille il pèse un quart de la carte de réservation
          qui lui fait face à droite, et reste une signature plutôt qu'un sujet. */}
      <div class="flex items-center gap-4 md:gap-5">
        <Image
          src={lilianPhoto}
          alt="Lilian Sevoumian"
          width={192}
          height={192}
          class="contact-avatar"
        />
        <div
          class="font-display font-semibold tracking-[-0.025em] leading-[0.95] text-[var(--color-ink)]"
          style="font-size: var(--text-headline);"
        >
          Lilian<br/>Sevoumian.
        </div>
      </div>

      <!-- Statement passionné -->
      <p class="text-[length:var(--text-body-large)] leading-[1.55] m-0 text-[var(--color-ink)] max-w-[58ch]">
        Venez avec un exemple de tâche, de document ou de dossier.
        Cela nous aidera à comprendre ce qui bloque au quotidien.
      </p>

      </div>
      <!-- /colonne gauche -->

      <!-- Colonne droite : la réservation. Le formulaire a été retiré au profit
           d'un canal unique. Un créneau posé vaut un rendez-vous tenu, là où
           un message envoyé attend une réponse. Ce qui remplace les champs,
           c'est la raison de cliquer : ce qu'on construit pendant ces 45
           minutes, et le fait d'en sortir avec un plan. -->
      <div class="w-full">
        <div class="appel-carte">
          <h3 class="appel-titre font-display font-semibold text-[var(--color-ink)]">
            Ce que nous verrons pendant l’appel
          </h3>

          {/* Les trois étapes décrivent ce qu'on va CONSTRUIRE, pas ce dont on
              va parler : un agent, un workflow, quelque chose qui tourne.
              La troisième a porté « même si ce n'est pas avec moi ». La formule
              donnait quelque chose à qui repart sans acheter, mais elle
              envisageait l'échec de la vente à l'instant précis où l'on demande
              le clic, et elle sous-entendait qu'un autre pourrait faire mieux.
              Elle affirme désormais la suite du travail. */}
          <ol class="appel-etapes">
            <li><span>Les tâches qui vous occupent et les outils que vous utilisez.</span></li>
            <li><span>Les automatisations ou agents à prioriser, et ce qui est faisable.</span></li>
            <li><span>Le périmètre à chiffrer et la suite à donner au projet.</span></li>
          </ol>

          <BoutonReservation source="contact" class="btn-primary justify-center w-full">
            {LIBELLE_CONTACT_RESERVATION}
          </BoutonReservation>
          <p class="m-0 text-[length:var(--text-body-sm)] leading-relaxed text-[var(--color-ink-mid)]">Le bouton ouvre mon agenda. Vous choisissez la date et l’heure de notre échange, sans engagement.</p>

        </div>
      </div>
      <!-- /colonne droite -->
    </div>
    <!-- /face-a-face -->

  </div>
</section>

<style>
  .appel-carte {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    /* Sur l'aplat lime, la carte se détache en papier : c'est la seule surface
       de la section où l'on agit, elle ne peut pas être du même ton que le fond. */
    background: var(--color-paper);
    border: 1px solid var(--color-ink);
  }

  .appel-titre {
    margin: 0;
    font-size: var(--text-title-lg);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }

  .appel-etapes {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: etape;
  }

  .appel-etapes li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--text-body-sm);
    line-height: 1.5;
    color: var(--color-ink-mid);
  }

  /* Numéros en compteur plutôt qu'en texte : la liste reste une <ol>
     sémantique, et le chiffre ne se sélectionne pas avec la phrase. */
  .appel-etapes li::before {
    counter-increment: etape;
    content: counter(etape);
    flex: none;
    width: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    font-weight: 600;
    color: var(--color-ink);
  }

</style>

<style>
  /* Portrait à côté de la signature — la photo n'apparaissant plus dans le hero.
     Le rayon passe par le jeton : le système n'a que deux valeurs, 0 et
     --radius-full, et un `50%` écrit sur place en introduisait une troisième
     qu'aucune reprise globale n'aurait touchée. Sur un carré, le rendu est
     identique. */
  .contact-avatar {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-divider);
  }

  /* Même point de rupture que la bascule en deux colonnes du bloc contact
     (lg, 1024 px) : le portrait grandit au moment où la carte de réservation
     part à droite et libère la colonne de gauche. */
  @media (min-width: 1024px) {
    .contact-avatar {
      width: 96px;
      height: 96px;
    }
  }

</style>
