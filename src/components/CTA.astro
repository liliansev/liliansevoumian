---
---

<!-- CTA — dark section -->
<section id="contact" class="relative overflow-hidden py-[var(--spacing-section)] px-[var(--spacing-section-x)] bg-[var(--color-bg-dark)]">
  <!-- Dot grid overlay -->
  <div class="absolute inset-0 dot-grid-dark opacity-40" aria-hidden="true"></div>

  <div class="relative z-[1] max-w-[1200px] mx-auto flex flex-col items-center gap-8 text-center">
    <!-- Badge -->
    <span class="inline-block font-mono text-[12px] font-semibold tracking-[2px] uppercase text-[#22D3EE]">
      PASSEZ À L'ACTION
    </span>

    <!-- Headline -->
    <h2 class="font-display text-[40px] font-bold tracking-[-0.02em] text-white leading-[1.15] text-center max-w-[900px]">
      Chaque semaine sans automatisation vous coûte des dizaines d'heures
    </h2>

    <!-- Subtitle -->
    <p class="font-body text-[18px] text-[#AAAAAA] leading-[1.6] text-center max-w-[700px]">
      Réservez un appel de 30&nbsp;minutes. Je vous montre exactement quels process automatiser et combien de temps vous allez gagner.
    </p>

    <!-- Button -->
    <div class="flex items-center justify-center w-full md:w-auto">
      <a
        href="https://cal.com/lilian-sevoumian/20min"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-3d-lg w-full md:w-auto inline-flex items-center justify-center group"
      >
        Parlons automatisations <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">→</span>
      </a>
    </div>

    <!-- Trust pills -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <span class="font-body text-[13px] font-medium text-[#666666]">Gratuit</span>
      <span class="text-[#444444]">·</span>
      <span class="font-body text-[13px] font-medium text-[#666666]">30&nbsp;min</span>
      <span class="text-[#444444]">·</span>
      <span class="font-body text-[13px] font-medium text-[#666666]">Sans engagement</span>
      <span class="text-[#444444]">·</span>
      <span class="font-body text-[13px] font-medium text-[#666666]">Plan d'action sous 48&nbsp;h</span>
    </div>
  </div>
</section>
