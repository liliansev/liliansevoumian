---
---

<!-- CTA — cream section -->
<section data-bg="cream" id="contact" class="relative overflow-hidden py-[var(--spacing-section)] px-[var(--spacing-section-x)] bg-[var(--color-bg-dark)]">
  <!-- Dot grid overlay -->
  <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>

  <div class="relative z-[1] max-w-[1200px] mx-auto flex flex-col items-center gap-12 text-center">
    <!-- Header group -->
    <div class="flex flex-col items-center gap-5">
      <!-- Badge -->
      <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-orange)]">
        PASSEZ À L'ACTION
      </span>

      <!-- Headline -->
      <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[#1A1A1A] leading-[1.15] text-center max-w-[900px]">
        Chaque semaine sans automatisation vous coûte des dizaines d'heures
      </h2>

      <!-- Subtitle -->
      <p class="font-body text-[length:var(--text-body-lg)] text-[#666666] leading-[1.6] text-center max-w-[700px]">
        Réservez un appel de 30&nbsp;minutes. Je vous montre exactement quels process automatiser et combien de temps vous allez gagner.
      </p>
    </div>

    <!-- CTA group -->
    <div class="flex flex-col items-center gap-4">
      <!-- Button -->
      <div class="flex items-center justify-center w-full md:w-auto">
        <a
          href="https://cal.com/lilian-sevoumian/20min"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-3d text-[length:var(--text-body-lg)] px-10 py-[18px] w-full md:w-auto inline-flex items-center justify-center group"
        >
          Discutons de votre projet <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">→</span>
        </a>
      </div>

      <!-- Trust pills -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <span class="font-body text-[length:var(--text-body-sm)] font-medium text-[#666666]">Gratuit</span>
        <span class="text-[#666666]">·</span>
        <span class="font-body text-[length:var(--text-body-sm)] font-medium text-[#666666]">30&nbsp;min</span>
        <span class="text-[#666666]">·</span>
        <span class="font-body text-[length:var(--text-body-sm)] font-medium text-[#666666]">Sans engagement</span>
        <span class="text-[#666666]">·</span>
        <span class="font-body text-[length:var(--text-body-sm)] font-medium text-[#666666]">Plan d'action sous 48&nbsp;h</span>
      </div>

      <!-- Newsletter link -->
      <p class="font-body text-[length:var(--text-body)] text-[var(--color-text-muted)] mt-2">
        Pas encore prêt&nbsp;?
        <a href="https://liliansevoumian.substack.com/" target="_blank" rel="noopener noreferrer"
           class="font-semibold text-[var(--color-text-secondary)] underline underline-offset-2 hover:text-[var(--color-text-primary)] transition-colors duration-200">
          Recevez mes analyses chaque semaine →
        </a>
      </p>
    </div>
  </div>
</section>
