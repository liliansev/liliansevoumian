---
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import lilianPhoto from '../assets/lilian-photo.jpg';
---

<section
  id="contact"
  data-section  class="bloc-lime relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="06"
      label="CONTACT"
      title="Parlons de votre <mark class='inv'>projet d’automatisation.</mark>"
      body="Vingt minutes pour poser votre process à plat et savoir ce qui s’automatise."
      titleMaxWidth="22ch"
      bodyMaxWidth="60ch"
      class="!mb-0"
    />

    {/* Face-a-face : qui je suis (gauche) + le créneau (droite). Sur mobile la
        confiance passe avant l'action — on lit d'abord la signature, on réserve
        ensuite. */}
    <div class="relative reveal mt-10 md:mt-14 grid grid-cols-1 lg:grid-cols-[0.85fr_1fr] gap-10 lg:gap-16 items-start">

      <!-- Colonne gauche : signature + statement passionne -->
      <div class="flex flex-col gap-6">

      <!-- Signature — sur mobile, accompagnée d'un avatar (la photo n'apparaît plus dans le Hero). -->
      <div class="flex items-center gap-4 md:gap-5">
        <Image
          src={lilianPhoto}
          alt="Lilian Sevoumian"
          width={144}
          height={144}
          class="contact-avatar lg:hidden"
        />
        <div
          class="font-display font-semibold tracking-[-0.025em] leading-[0.95] text-[var(--color-ink)]"
          style="font-size: var(--text-signature);"
        >
          Lilian<br/>Sevoumian.
        </div>
      </div>

      <!-- Statement passionné -->
      <p class="text-[length:var(--text-body-large)] leading-[1.55] m-0 text-[var(--color-ink-mid)] max-w-[58ch]">
        <span class="text-[var(--color-ink)]">Montrez-moi votre tâche la plus pénible&nbsp;: c’est celle que je préfère.</span>
      </p>
      </div>
      <!-- /colonne gauche -->

      <!-- Colonne droite : la réservation. Le formulaire a été retiré au profit
           d'un canal unique. Un créneau posé vaut un rendez-vous tenu, là où
           un message envoyé attend une réponse. Ce qui remplace les champs,
           c'est la raison de cliquer : ce qu'on construit pendant ces 20
           minutes, et le fait d'en sortir avec un plan. -->
      <div class="w-full">
        <div class="appel-carte">
          <span class="mono-caption text-[var(--color-ink-low)]">DIAGNOSTIC · 20 MIN · SANS ENGAGEMENT</span>

          <h3 class="appel-titre font-display font-semibold text-[var(--color-ink)]">
            On dessine votre automatisation ensemble.
          </h3>

          {/* Les trois étapes décrivent ce qu'on va CONSTRUIRE, pas ce dont on
              va parler : un agent, un workflow, quelque chose qui tourne.
              La troisième a porté « même si ce n'est pas avec moi ». La formule
              donnait quelque chose à qui repart sans acheter, mais elle
              envisageait l'échec de la vente à l'instant précis où l'on demande
              le clic, et elle sous-entendait qu'un autre pourrait faire mieux.
              Elle affirme désormais la suite du travail. */}
          <ol class="appel-etapes">
            <li><span>Vous me décrivez le process qui vous coûte le plus de temps.</span></li>
            <li><span>On dessine l’agent IA ou le workflow qui va le prendre en charge.</span></li>
            <li><span>Vous repartez en sachant ce qu’on construit et par quoi on commence.</span></li>
          </ol>

          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary justify-center w-full"
            data-fast-goal="lead_call"
            data-fast-goal-source="contact"
          >
            Réserver mon diagnostic
          </a>

        </div>
      </div>
      <!-- /colonne droite -->
    </div>
    <!-- /face-a-face -->

  </div>
</section>

<style>
  .appel-carte {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    /* Sur l'aplat lime, la carte se détache en papier : c'est la seule surface
       de la section où l'on agit, elle ne peut pas être du même ton que le fond. */
    background: var(--color-paper);
    border: 1px solid var(--color-ink);
  }

  .appel-titre {
    margin: 0;
    font-size: var(--text-title-lg);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }

  .appel-etapes {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: etape;
  }

  .appel-etapes li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--text-body-sm);
    line-height: 1.5;
    color: var(--color-ink-mid);
  }

  /* Numéros en compteur plutôt qu'en texte : la liste reste une <ol>
     sémantique, et le chiffre ne se sélectionne pas avec la phrase. */
  .appel-etapes li::before {
    counter-increment: etape;
    content: counter(etape);
    flex: none;
    width: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    font-weight: 600;
    color: var(--color-ink);
  }

</style>

<style>
  /* Avatar mobile à côté de la signature — la photo n'apparaissant plus dans le Hero. */
  .contact-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-divider);
  }
</style>
