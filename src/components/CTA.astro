---
---

<!-- CTA -->
<section id="contact" class="bg-[#000000] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
  <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-10 text-center">
    <!-- Accent line -->
    <div class="w-[120px] h-[2px] bg-gradient-to-r from-[rgba(139,92,246,0)] via-[#8B5CF6] to-[rgba(139,92,246,0)]" aria-hidden="true"></div>

    <!-- Badge -->
    <span class="inline-block bg-[#1A1028] border border-[rgba(139,92,246,0.19)] rounded-full px-4 py-1.5 font-[var(--font-mono)] text-[11px] font-medium text-[#8B5CF6] tracking-[2px] uppercase">
      PASSEZ À L'ACTION
    </span>

    <!-- Headline -->
    <h2 class="font-[var(--font-display)] text-[length:var(--text-cta-heading)] font-bold text-[#EDEDED] leading-[1.15] text-center max-w-[700px]">
      Chaque semaine sans automatisation<br/>vous coûte des dizaines d'heures
    </h2>

    <!-- Subtitle -->
    <p class="font-[var(--font-body)] text-[15px] md:text-lg text-[#888888] leading-[1.6] text-center max-w-[600px]">
      Réservez un appel de 30 minutes. Je vous montre exactement<br class="hidden md:block"/>quels process automatiser et combien de temps vous allez gagner.
    </p>

    <!-- Button -->
    <div class="flex items-center justify-center">
      <a
        href="https://cal.com/liliansevoumian/diagnostic"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center bg-[#8B5CF6] text-white font-[var(--font-body)] text-[15px] font-medium rounded-lg px-7 py-3.5 hover:bg-[#7C3AED] hover:translate-y-[-1px] hover:shadow-[0_4px_16px_rgba(139,92,246,0.3)] transition-all duration-200"
      >
        Parlons automatisations →
      </a>
    </div>

    <!-- Trust line -->
    <p class="font-[var(--font-body)] text-[13px] text-[#777777]">
      Gratuit · 30 min · Sans engagement · Plan d'action sous 48h
    </p>
  </div>
</section>
