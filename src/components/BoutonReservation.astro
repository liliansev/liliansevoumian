---
/*
 * BoutonReservation — le lien vers l'agenda, partout où il apparaît.
 *
 * Dix-sept boutons écrivaient à la main la même séquence de six attributs :
 * l'URL, `target`, `rel`, la classe, le goal et sa source. Quatre variantes
 * d'attributs circulaient déjà, et l'inventaire du tracking ne tenait que par
 * recopie attentive — `data-fast-goal` posé sur chaque lien est la SEULE chose
 * qui distingue un CTA mesuré d'un CTA muet, et rien ne signalait un oubli : le
 * bouton ouvrait l'agenda dans les deux cas.
 *
 * Ici `source` est requis par le typage. Un bouton sans source ne compile pas ;
 * le goal, lui, n'est plus à écrire du tout.
 *
 * `class` remplace la classe par défaut plutôt que de s'y ajouter : le CTA
 * central de la nav n'est pas un bouton plein mais un lien de barre, et le
 * composant n'a pas à trancher entre les deux registres. Il garantit le lien,
 * pas l'apparence.
 *
 * Le libellé passe par le slot, et il est aujourd'hui le même partout :
 * « Automatiser mon business » (LIBELLE_RESERVATION). Il a existé quatre
 * variantes selon la place disponible — « diagnostic · 20 min » dans les zones
 * étroites, la forme longue ailleurs — c'est-à-dire quatre noms pour un seul
 * clic. Le libellé actuel tient sur une ligne dans la plus étroite des zones,
 * donc il n'y a plus rien à arbitrer par emplacement.
 */
import { URL_RESERVATION, LIBELLE_RESERVATION } from '../lib/reservation';

interface Props {
  /** D'où vient le clic, en clair dans le funnel DataFast. Requis. */
  source: string;
  /** Remplace `btn-primary`. Passer la chaîne complète. */
  class?: string;
  /**
   * L'objectif DataFast posé sur le lien. `lead_call` par défaut : le lien
   * ouvre l'agenda. Sur l'accueil, les « Parlons de votre projet » ouvrent la
   * conversation (`data-causerie-ouvrir`) et passent `causerie_opened`. Une
   * prop, et non un attribut passé en plus : deux `data-fast-goal` sur une
   * balise, c'est le premier qui compte, donc `lead_call`.
   */
  goal?: string;
  /** Attributs libres : `data-mobile-link`, `id`… */
  [attribut: string]: unknown;
}

const { source, class: classe = 'btn-primary', goal = 'lead_call', ...reste } = Astro.props;
---

<a
  href={URL_RESERVATION}
  target="_blank"
  rel="noopener noreferrer"
  class={classe}
  data-fast-goal={goal}
  data-fast-goal-source={source}
  {...reste}
><slot>{LIBELLE_RESERVATION}</slot></a>
