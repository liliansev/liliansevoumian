---
/*
 * BoutonReservation — le bouton d'appel du site, partout où il apparaît.
 *
 * Depuis le 3 octobre 2026 il n'y a qu'un geste sur tout le site : « Parlons de
 * votre projet » ouvre la conversation de `home-invite`, où le visiteur choisit
 * WhatsApp, l'e-mail ou un appel. Ce composant pose donc par défaut
 * `data-causerie-ouvrir` et le goal `causerie_opened`. C'est toujours un vrai
 * lien vers l'agenda : sans script, ou si la barre d'écriture n'a pas démarré,
 * il y mène (voir l'embed, dans Layout).
 *
 * `direct` garde l'ancien comportement : le lien ouvre l'agenda, goal
 * `lead_call`. Un seul endroit s'en sert, le moyen « Réserver un appel » de la
 * conversation elle-même.
 *
 * `source` est requis par le typage : un bouton sans source ne compile pas, et
 * c'est ce qui tient l'inventaire du suivi. `class` remplace la classe par
 * défaut plutôt que de s'y ajouter. Le libellé passe par le slot ; sans slot,
 * c'est `LIBELLE_CONTACT_RESERVATION`.
 */
import { URL_RESERVATION, LIBELLE_CONTACT_RESERVATION } from '../lib/reservation';

interface Props {
  /** D'où vient le clic, en clair dans le funnel DataFast. Requis. */
  source: string;
  /** Remplace `btn-primary`. Passer la chaîne complète. */
  class?: string;
  /** Le lien ouvre l'agenda sans passer par la conversation. */
  direct?: boolean;
  /**
   * L'objectif DataFast posé sur le lien : `causerie_opened` par défaut,
   * `lead_call` quand `direct`. Une prop, et non un attribut passé en plus :
   * deux `data-fast-goal` sur une balise, c'est le premier qui compte.
   */
  goal?: string;
  /** Attributs libres : `data-mobile-link`, `id`… */
  [attribut: string]: unknown;
}

const { source, class: classe = 'btn-primary', direct = false, goal = direct ? 'lead_call' : 'causerie_opened', ...reste } = Astro.props;
/* Un seul objet d'attributs : passé deux fois, `data-causerie-ouvrir` serait
   écrit en double sur la balise. */
const attributs = direct ? reste : { 'data-causerie-ouvrir': '', ...reste };
---

<a
  href={URL_RESERVATION}
  target="_blank"
  rel="noopener noreferrer"
  class={classe}
  data-fast-goal={goal}
  data-fast-goal-source={source}
  {...attributs}
><slot>{LIBELLE_CONTACT_RESERVATION}</slot></a>
