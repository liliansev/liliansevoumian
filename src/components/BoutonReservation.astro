---
/*
 * BoutonReservation — le bouton d'appel du site, partout où il apparaît.
 *
 * Il n'y a qu'un geste sur tout le site : « Parlons de votre projet » mène au
 * formulaire de contact (`formulaire-contact.astro`). Depuis le 14 octobre 2026
 * c'est un lien vers `/contact`, avec `data-contact-ouvrir` et le goal
 * `contact_opened` : quand la page porte déjà le formulaire (dans sa
 * `fin-de-page`), Layout intercepte le clic et y fait défiler au lieu de
 * changer de page. Sans script, le lien mène à `/contact`.
 *
 * `direct` ouvre l'agenda (goal `lead_call`) : c'est le lien « Réservez un
 * appel » sous le formulaire.
 *
 * `source` est requis par le typage : un bouton sans source ne compile pas, et
 * c'est ce qui tient l'inventaire du suivi. `class` remplace la classe par
 * défaut plutôt que de s'y ajouter. Le libellé passe par le slot ; sans slot,
 * c'est `LIBELLE_CONTACT_RESERVATION`.
 */
import { URL_RESERVATION, LIBELLE_CONTACT_RESERVATION } from '../lib/reservation';

interface Props {
  /** D'où vient le clic, en clair dans le funnel DataFast. Requis. */
  source: string;
  /** Remplace `btn-primary`. Passer la chaîne complète. */
  class?: string;
  /** Le lien ouvre l'agenda au lieu du formulaire. */
  direct?: boolean;
  /**
   * L'objectif DataFast posé sur le lien : `contact_opened` par défaut,
   * `lead_call` quand `direct`. Une prop, et non un attribut passé en plus :
   * deux `data-fast-goal` sur une balise, c'est le premier qui compte.
   */
  goal?: string;
  /** Attributs libres : `data-mobile-link`, `id`… */
  [attribut: string]: unknown;
}

const { source, class: classe = 'btn-primary', direct = false, goal = direct ? 'lead_call' : 'contact_opened', ...reste } = Astro.props;
/* Un seul objet d'attributs : passé deux fois, un attribut serait écrit en
   double sur la balise. */
const attributs = direct
  ? { href: URL_RESERVATION, target: '_blank', rel: 'noopener noreferrer', ...reste }
  : { href: '/contact', 'data-contact-ouvrir': '', ...reste };
---

<a
  class={classe}
  data-fast-goal={goal}
  data-fast-goal-source={source}
  {...attributs}
><slot>{LIBELLE_CONTACT_RESERVATION}</slot></a>
