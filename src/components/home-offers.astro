---
/*
 * home-offers — la fin de la page : un appel, et ce que ça coûte.
 *
 * La page s'ouvre sur un titre seul posé sur une grille ; elle se ferme de la
 * même façon. Une phrase, centrée, qui dit ce qu'on fait ensuite, puis le
 * bouton. La grille du premier écran revient derrière, immobile : on est
 * revenu au point de départ, avec une réponse.
 *
 * Les prix tiennent en une ligne sous le bouton. Ils étaient deux rangées à
 * filets qui redisaient ce que les blocs des métiers annoncent déjà ; ils
 * restent là pour qui est descendu jusqu'ici en cherchant un ordre de
 * grandeur, et chacun mène à sa page d'offre.
 *
 * Tout lien vers l'agenda passe par `BoutonReservation`.
 */
import { Icon } from 'astro-icon/components';
import BoutonReservation from './BoutonReservation.astro';
import { automationStartingPrice, webStartingPrice } from '../data/service-pricing';
import { DUREE_RESERVATION_MINUTES } from '../lib/reservation';

/* Mêmes noms que dans les blocs des métiers : une offre n'a qu'un nom sur la
   page. */
const offres = [
  {
    href: '/automatisations-ia',
    nom: 'Automatisation et agents IA',
    prix: automationStartingPrice,
    source: 'home_services_automation',
  },
  {
    href: '/sites-web-abonnement',
    nom: 'Sites web et dashboards',
    prix: webStartingPrice,
    source: 'home_services_web',
  },
] as const;
---

<section id="offres" data-section class="fin relative px-[var(--spacing-section-x)]">
  <div class="fin__grille" aria-hidden="true"></div>

  <div class="fin__centre reveal">
    <h2 class="fin__titre">
      {DUREE_RESERVATION_MINUTES} minutes pour voir si je suis <mark>la bonne personne.</mark>
    </h2>
    <p class="fin__suite">
      On regarde votre besoin, et on voit si c’est un projet pour moi.
    </p>
    <BoutonReservation source="home_offres" class="btn-primary fin__bouton">
      Parlons de votre projet <Icon name="lucide:arrow-right" size={18} aria-hidden="true" />
    </BoutonReservation>

    <p class="fin__prix">
      {offres.map((offre, i) => (
        <>
          {i > 0 && <span class="fin__sep" aria-hidden="true"> · </span>}
          <a href={offre.href} data-fast-goal="service_path_opened" data-fast-goal-source={offre.source}>
            {offre.nom}, à partir de <strong>{offre.prix.toLocaleString('fr-FR')}&nbsp;€&nbsp;HT</strong>
          </a>
        </>
      ))}
    </p>
  </div>
</section>

<style>
  .fin {
    --maille: clamp(3.5rem, 5.6vw, 5.5rem);
    --trait: color-mix(in srgb, var(--color-ink) 10%, transparent);
    display: grid;
    place-items: center;
    min-height: min(46rem, 88svh);
    padding-block: var(--spacing-section-y);
    overflow: clip;
    isolation: isolate;
  }

  /* La maille du premier écran, comptée depuis le centre, qui s'efface vers
     les bords. Immobile : le mouvement était au début, ici la page se pose. */
  .fin__grille {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(var(--trait) 1px, transparent 1px) 50% 50% / var(--maille) var(--maille),
      linear-gradient(90deg, var(--trait) 1px, transparent 1px) 50% 50% / var(--maille) var(--maille);
    -webkit-mask-image: radial-gradient(ellipse 62% 70% at 50% 50%, var(--color-night) 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 62% 70% at 50% 50%, var(--color-night) 0%, transparent 100%);
  }

  .fin__centre {
    display: grid;
    justify-items: center;
    gap: clamp(1.25rem, 2.4vw, 1.75rem);
    max-width: 62rem;
    text-align: center;
  }

  .fin__titre {
    max-width: 17ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-story);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .fin__titre mark {
    margin-top: 0.14em;
  }

  .fin__suite {
    max-width: 44ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.5;
    text-wrap: balance;
  }

  /* Le même bouton que dans la barre de navigation : même libellé, même casse,
     même flèche. Une action n'a qu'un seul traitement sur la page. */
  .fin :global(.fin__bouton) {
    margin-top: 0.5rem;
    text-transform: none;
    letter-spacing: normal;
    font-size: var(--text-body-sm);
  }

  .fin__prix {
    max-width: none;
    margin: clamp(0.75rem, 2vw, 1.5rem) 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .fin__prix a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink-mid);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-ink) 28%, transparent);
    text-underline-offset: 0.28em;
    transition:
      color var(--duration-default) var(--ease-out-quint),
      text-decoration-color var(--duration-default) var(--ease-out-quint);
  }

  .fin__prix strong {
    margin-left: 0.3em;
    color: var(--color-ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .fin__prix a:hover {
      color: var(--color-ink);
      text-decoration-color: var(--color-peche);
    }
  }

  @media (max-width: 640px) {
    .fin {
      --maille: 3rem;
    }

    /* Une offre par ligne : côte à côte, les deux prix se coupaient au milieu. */
    .fin__prix {
      display: grid;
      justify-items: center;
    }

    .fin__sep {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fin__prix a {
      transition: none;
    }
  }
</style>
