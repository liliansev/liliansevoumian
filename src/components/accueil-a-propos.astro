---
/*
 * accueil-a-propos : qui est Lilian, en quelques lignes et en photos de
 * travail.
 *
 * Remplace la frise du parcours le 14 octobre 2026 : « c'est pas un CV,
 * retire les dates ; fais plutôt une section à propos de moi avec quelques
 * photos en condition de travail » (Lilian). Le même jour, la section prend la
 * DA des métiers : une rangée (`rangee.astro`), la photo dans le cadre à
 * repères d'angle.
 *
 * Il doit envoyer d'autres photos : elles s'ajoutent à `photos`. La première
 * remplit le cadre ; les suivantes se posent en vignettes sous le texte.
 */
import { Image } from 'astro:assets';
import Rangee from './rangee.astro';
import auBureau from '../assets/lilian-au-bureau.jpg';

const photos = [
  { src: auBureau, alt: 'Lilian Sevoumian à son bureau, devant ses écrans, un workflow ouvert' },
];
const [premiere, ...suivantes] = photos;
---

<section id="a-propos" data-section class="accueil-section px-[var(--spacing-section-x)]">
  <div class="relative mx-auto max-w-[1200px]">
    <header class="accueil-tete reveal">
      <h2>À propos.</h2>
    </header>

    <Rangee miroir>
      <h3>Lilian Sevoumian</h3>
      <p class="rangee-phrase">J’automatise d’abord mon propre travail.</p>
      <p class="rangee-corps">
        Un studio de podcast, une activité de formation, puis une agence&nbsp;: les journées mangées par des
        tâches qui n’avancent rien, je les connais de l’intérieur.
      </p>
      <p class="rangee-corps">
        Je pars des processus réels, je construis avec les outils que l’équipe utilise déjà, et je laisse un
        humain garder la main sur les cas douteux. Ce que j’apprends en chemin, je le montre en vidéo et je
        l’écris chaque semaine.
      </p>
      {suivantes.length > 0 && (
        <div class="apropos__vignettes">
          {suivantes.map((photo) => (
            <Image src={photo.src} alt={photo.alt} widths={[240, 480]} sizes="160px" class="apropos__vignette" loading="lazy" />
          ))}
        </div>
      )}

      <Image
        slot="visuel"
        src={premiere.src}
        alt={premiere.alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 700px, 100vw"
        class="apropos__photo"
        loading="lazy"
      />
    </Rangee>
  </div>
</section>

<style>
  .apropos__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apropos__vignettes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--spacing-lie);
  }

  .apropos__vignette {
    width: 9rem;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-md);
  }
</style>
