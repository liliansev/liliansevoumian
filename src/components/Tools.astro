---
const tools = [
  { name: "Make", textColor: "#E86A33", bgColor: "#E86A3320", borderColor: "#E86A33" },
  { name: "n8n", textColor: "#9333EA", bgColor: "#9333EA20", borderColor: "#9333EA" },
  { name: "Zapier", textColor: "#22D3EE", bgColor: "#22D3EE20", borderColor: "#22D3EE" },
  { name: "Claude", textColor: "#E86A33", bgColor: "#E86A3320", borderColor: "#E86A33" },
  { name: "Notion", textColor: "#FFFFFF", bgColor: "#FFFFFF10", borderColor: "#FFFFFF40" },
  { name: "Airtable", textColor: "#22D3EE", bgColor: "#22D3EE20", borderColor: "#22D3EE" },
];
---

<div id="expertise" class="flex flex-col items-center gap-5">
  <!-- Badge -->
  <span class="inline-block rounded-full px-4 py-1.5 text-[12px] font-semibold tracking-[2px] uppercase font-mono" style="color: #22D3EE;">
    STACK TECHNIQUE
  </span>

  <!-- Heading -->
  <h2 class="text-[36px] text-center font-display font-bold text-white">
    Les outils que je maîtrise
  </h2>

  <!-- Tool pills -->
  <div class="flex flex-wrap justify-center gap-3">
    {tools.map((tool) => (
      <span
        class="font-mono text-[14px] font-semibold rounded-[12px] px-5 py-3"
        style={`color: ${tool.textColor}; background: ${tool.bgColor}; border: 2px solid ${tool.borderColor};`}
      >
        {tool.name}
      </span>
    ))}
  </div>
</div>
