---
/*
 * questions — la foire aux questions, la même sur toutes les pages.
 *
 * Une FAQ classique : la liste des questions, une ligne chacune, et la réponse
 * qui s'ouvre dessous. Lilian a écarté le 8 octobre 2026 la présentation en
 * bulles de conversation (« j'aime pas du tout ce layout, restons sur une FAQ
 * classique »).
 *
 * Ce sont des `details` qui portent le même `name` : en ouvrir une referme la
 * précédente, sans script. La première est ouverte à l'arrivée, pour que la
 * section ne soit pas une liste de titres. Toutes les réponses sont dans le
 * HTML, ouvertes ou non : un moteur les lit dans tous les cas.
 *
 * Sans `items`, le texte vient de `data/home-faq`. Le balisage `FAQPage` reste
 * posé par la page, à partir de la même liste : il lit `a`, le texte brut.
 * Quand une réponse porte un lien (`lien-prose`), elle l'écrit dans `html`.
 */
import SectionHeader from './SectionHeader.astro';
import { homeFaqs } from '../data/home-faq';

interface Props {
  id?: string;
  titre?: string;
  /** Largeur du titre, en `ch`. */
  titreLargeur?: string;
  /** `a` en texte brut ; `html`, la même réponse quand elle porte un lien. */
  items?: readonly { q: string; a: string; html?: string }[];
}

const {
  id = 'questions',
  titre = 'Vos questions.',
  titreLargeur = '12ch',
  items = homeFaqs,
} = Astro.props;
---

<section
  id={id}
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="questions relative mx-auto max-w-[1200px]">
    <SectionHeader
      class="lg:sticky lg:top-28"
      title={titre}
      titleMaxWidth={titreLargeur}
      spacing="none"
    />

    <div class="questions__liste reveal">
      {items.map((item, rang) => (
        <details class="question" name={`questions-${id}`} open={rang === 0}>
          <summary class="question__tete">
            <h3 class="question__titre">{item.q}</h3>
            <span class="question__signe" aria-hidden="true"></span>
          </summary>
          <p class="question__reponse" set:html={item.html ?? item.a} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .questions {
    display: grid;
    gap: var(--spacing-groupe);
  }

  .questions__liste {
    max-width: 44rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .question {
    border-top: 1px solid var(--color-divider);
  }

  /* La ligne entière se clique : la question à gauche, le signe à droite. */
  .question__tete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 44px;
    padding-block: 1.25rem;
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .question__tete::-webkit-details-marker {
    display: none;
  }

  .question__titre {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-body-large);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0;
    text-wrap: pretty;
  }

  /* Un « plus » qui devient « moins » : le trait vertical se couche. */
  .question__signe {
    position: relative;
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-ink-low);
    transition: color 160ms var(--ease-out-quint);
  }

  .question__signe::before,
  .question__signe::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: transform 260ms var(--ease-out-quint);
  }

  .question__signe::after {
    transform: rotate(90deg);
  }

  .question[open] .question__signe::after {
    transform: rotate(0deg);
  }

  .question__tete:hover .question__signe,
  .question[open] .question__signe {
    color: var(--color-ink);
  }

  .question__reponse {
    margin: 0;
    padding: 0 2.375rem 1.5rem 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .question__signe,
    .question__signe::before,
    .question__signe::after {
      transition: none;
    }
  }

  /* Grand écran : le titre à gauche, qui accompagne la liste, plus haute que
     lui. */
  @media (min-width: 1024px) {
    .questions {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      column-gap: var(--spacing-gouttiere);
      align-items: start;
    }
  }
</style>
