---
import { Image } from 'astro:assets';
import heroImage from '../assets/cube-3d-automatisation-ia-make.png';

const stats = [
  { number: "500+", label: "automatisations déployées" },
  { number: "2\u00A0000\u00A0h+", label: "économisées chaque mois" },
  { number: "3\u00A0sem.", label: "pour un ROI mesurable" },
];
---

<!-- Hero -->
<section class="relative w-full bg-[var(--color-bg-page)] overflow-hidden pt-[56px]">
  <!-- Dot grid background -->
  <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>

  <!-- Content — 2 columns on desktop, stacked on mobile -->
  <div class="relative z-[1] max-w-[1440px] mx-auto w-full py-[60px] md:py-[80px] px-6 md:px-[120px]">
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">

      <!-- Left column: text -->
      <div class="flex flex-col items-start text-left gap-8 flex-1 min-w-0 w-full lg:w-auto">

        <!-- Badge -->
        <div class="inline-flex items-center rounded-full px-4 py-2" style="background: #9333EA20; border: 2px solid #9333EA;">
          <span class="font-body text-[13px] font-semibold text-[#9333EA]">
            Expert Automatisation & IA
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-display font-bold text-[32px] md:text-[48px] lg:text-[56px] text-[var(--color-text-primary)] leading-[1.08] tracking-[-0.02em]">
          Vos process manuels vous coûtent des heures. <span class="text-[#9333EA]">Je les automatise.</span>
        </h1>

        <!-- Subtitle -->
        <p class="font-body text-[16px] md:text-[18px] text-[#666666] leading-[1.6] tracking-[-0.01em] max-w-[600px]">
          Automatisations Make, n8n et intégrations IA sur mesure. Vos équipes se concentrent sur ce qui compte.
        </p>

        <!-- CTA Button -->
        <div class="flex items-start">
          <a
            href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
            class="btn-3d inline-flex items-center justify-center font-body text-[16px] font-semibold px-8 py-4 group"
          >
            Parlons automatisations <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">→</span>
          </a>
        </div>

        <!-- Cube image — MOBILE ONLY (between buttons and stats) -->
        <div class="lg:hidden flex justify-center w-full">
          <Image
            src={heroImage}
            alt="Cube 3D automatisation IA Make n8n — expert freelance"
            width={480}
            height={480}
            format="png"
            class="w-[220px] h-auto drop-shadow-2xl"
            loading="eager"
          />
        </div>

        <!-- Stats Row — always 3 in a row -->
        <div class="grid grid-cols-3 gap-3 md:gap-6 w-full lg:w-auto lg:flex">
          {stats.map((stat) => (
            <div class="stat-item flex flex-col items-center gap-1 rounded-[12px] px-4 py-4 md:px-6 md:py-5 flex-1 md:flex-none" style="background: #F2F2F2; border: 3px solid rgba(255,255,255,0.5); box-shadow: 2px 4px 12px rgba(147,51,234,0.30);">
              <span class="font-display text-[20px] md:text-[32px] font-bold text-[#9333EA] whitespace-nowrap">
                {stat.number}
              </span>
              <span class="font-body text-[11px] md:text-[13px] text-[#666666] text-center">
                {stat.label}
              </span>
            </div>
          ))}
        </div>

      </div>

      <!-- Right column: 3D cube image — DESKTOP ONLY -->
      <div class="hidden lg:block flex-shrink-0 w-[480px]">
        <Image
          src={heroImage}
          alt="Cube 3D automatisation IA Make n8n — expert freelance"
          width={960}
          height={960}
          format="png"
          class="w-full h-auto drop-shadow-2xl"
          loading="eager"
        />
      </div>

    </div>
  </div>
</section>
