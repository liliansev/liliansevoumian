---
const stats = [
  { number: "50+", label: "automatisations déployées" },
  { number: "200h+", label: "économisées chaque mois" },
  { number: "3 sem.", label: "pour un ROI mesurable" },
];
---

<!-- Hero -->
<section class="relative w-full bg-black overflow-hidden min-h-screen flex items-center justify-center pt-[56px]">
  <!-- Grid background -->
  <div class="absolute inset-0 grid-pattern grid-fade-center" aria-hidden="true"></div>

  <!-- Content -->
  <div class="relative z-[1] max-w-[1200px] mx-auto px-[var(--spacing-section-x)] w-full py-16 md:py-20">
    <div class="flex flex-col items-center text-center gap-8">

      <!-- Badge -->
      <div class="inline-flex items-center rounded-full bg-[#1A1A1A] border border-[#222222] px-4 py-1.5">
        <span class="font-[var(--font-mono)] text-[11px] font-medium tracking-[2px] uppercase text-[#777777]">
          Expert Automatisation & IA pour PME
        </span>
      </div>

      <!-- Headline -->
      <h1 class="font-[var(--font-display)] font-bold text-[length:var(--text-display)] text-[#EDEDED] leading-[1.15] tracking-tight max-w-[800px]">
        Vos process manuels<br class="hidden md:block" />
        vous coûtent des heures.<br class="hidden md:block" />
        Je les automatise.
      </h1>

      <!-- Subtitle -->
      <p class="font-[var(--font-body)] text-base md:text-xl text-[#888888] leading-[1.6] max-w-[600px] mt-[-8px]">
        Automatisations Make, n8n, Zapier et intégrations IA sur mesure. Vos équipes arrêtent de saisir, copier-coller et relancer — et se concentrent sur ce qui compte.
      </p>

      <!-- CTA Button -->
      <div class="flex items-center justify-center mt-4">
        <a
          href="#contact"
          class="inline-flex items-center justify-center font-[var(--font-body)] text-[15px] font-medium text-white bg-[#8B5CF6] hover:bg-[#7C3AED] rounded-lg px-7 py-3.5 transition-colors"
        >
          Parlons automatisations &rarr;
        </a>
      </div>

      <!-- Trust Metrics -->
      <div class="flex flex-row items-center justify-center gap-8 md:gap-12 mt-10 w-full">
        {stats.map((stat) => (
          <div class="flex flex-col items-center gap-1">
            <span class="font-[var(--font-mono)] text-xl md:text-2xl font-bold text-[#8B5CF6]">
              {stat.number}
            </span>
            <span class="font-[var(--font-body)] text-[11px] md:text-[13px] text-[#777777]">
              {stat.label}
            </span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
