---
const stats = [
  { value: "500+", label: "WORKFLOWS LIVRÉS" },
  { value: "2 000H", label: "ÉCONOMISÉES /MOIS" },
  { value: "<3 SEM.", label: "ROI POSITIF MOYEN" },
];
---

<section
  id="hero"
  data-section
  class="relative pt-[80px] md:pt-[88px]"
>
  <div class="relative max-w-[1200px] mx-auto px-[var(--spacing-section-x)] pt-12 md:pt-20 pb-[var(--spacing-section-y)]">

    <!-- Eyebrow positioning chip — bg-paper sans border, la grille s'arrête au fond -->
    <div class="reveal mb-6 md:mb-8 inline-block bg-[var(--color-paper)] py-1.5 pr-2">
      <span class="mono-caption text-[var(--color-ink-low)]">
        EX-LEAD OPS · 8 ANS NO-CODE · MAKE CERTIFIÉ NIVEAU 5
      </span>
    </div>

    <!-- Hero block — H1 + metric + lead, paper opaque sans border avec corner markers -->
    <div class="relative reveal mb-10 md:mb-12 bg-[var(--color-paper)] max-w-[64ch] py-2 pr-2">
      <span class="grid-corner tl" aria-hidden="true"></span>
      <span class="grid-corner tr" aria-hidden="true"></span>
      <span class="grid-corner bl" aria-hidden="true"></span>
      <span class="grid-corner br" aria-hidden="true"></span>

      <h1 class="font-display font-semibold text-[length:var(--text-display)] leading-[0.98] tracking-[-0.045em] text-[var(--color-ink)] m-0 max-w-[18ch]">
        Vos process ne devraient pas vivre dans Excel.
      </h1>

      <div class="flex items-baseline gap-3 pt-5 md:pt-6 pb-2 border-t border-[var(--color-divider)] mt-5 md:mt-6">
        <span
          class="font-display font-semibold tabular-nums tracking-[-0.035em] text-[var(--color-violet)]"
          style="font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem); line-height: 0.95;"
        >
          15 h
        </span>
        <span class="mono-caption text-[var(--color-ink-low)]">
          ÉCONOMISÉES / SEMAINE / CLIENT EN MOYENNE
        </span>
      </div>

      <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 pt-3">
        Je conçois des automatisations Make et n8n qui font tourner vos opérations sans intervention humaine.
      </p>
    </div>

    <!-- CTAs — primary ink + ghost neutral -->
    <div class="reveal flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-16 md:mb-20">
      <a
        href="https://cal.com/lilian-sevoumian/20min"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary justify-center"
      >
        Réserver un appel · 30 min
      </a>
      <a href="#methode" class="btn-ghost justify-center">
        Voir la méthode ↓
      </a>
    </div>

    <!-- Stats row — divider grid sur paper -->
    <div class="reveal grid grid-cols-1 sm:grid-cols-3 gap-px bg-[var(--color-divider)] border border-[var(--color-divider)] rounded-[var(--radius-md)] overflow-hidden max-w-3xl">
      {stats.map((stat) => (
        <div class="bg-[var(--color-paper)] p-5 md:p-6 flex flex-col gap-1.5">
          <div class="font-display font-semibold text-3xl md:text-4xl tracking-[-0.035em] text-[var(--color-ink)] leading-none">
            {stat.value}
          </div>
          <div class="mono-caption text-[var(--color-ink-low)]">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Microdata strip -->
    <div class="reveal mt-10 md:mt-12 flex flex-wrap items-center gap-x-6 gap-y-2 mono-caption text-[var(--color-ink-low)]">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-violet)] inline-block"></span>
        DISPONIBLE MAI 2026
      </span>
      <span>·</span>
      <span>BASÉ À PARIS · REMOTE-FIRST</span>
      <span>·</span>
      <span>FR / EN</span>
    </div>

  </div>
</section>
