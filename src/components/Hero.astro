---
const stats = [
  { number: "500+", label: "automatisations déployées" },
  { number: "2\u00A0000\u00A0h+", label: "économisées chaque mois" },
  { number: "3\u00A0sem.", label: "pour un ROI mesurable" },
];
---

<!-- Hero -->
<section class="relative w-full bg-black overflow-hidden min-h-[100dvh] flex items-center justify-center pt-[56px] pb-[env(safe-area-inset-bottom)]">
  <!-- Grid background -->
  <div class="absolute inset-0 grid-pattern grid-fade-center" aria-hidden="true"></div>

  <!-- Content -->
  <div class="relative z-[1] max-w-[1200px] mx-auto px-[var(--spacing-section-x)] w-full py-16 md:py-20">
    <div class="flex flex-col items-center text-center gap-8">

      <!-- Badge -->
      <div class="inline-flex items-center rounded-full bg-[#1A1A1A] border border-[#222222] px-4 py-1.5">
        <span class="font-[var(--font-mono)] text-[11px] font-medium tracking-[2px] uppercase text-[#777777]">
          Expert Automatisation & IA pour la productivité
        </span>
      </div>

      <!-- Headline -->
      <h1 class="font-[var(--font-display)] font-bold text-[length:var(--text-display)] text-[#EDEDED] leading-[1.15] tracking-tight max-w-[800px]">
        Vos process manuels<br class="hidden md:block" />
        vous coûtent des heures.<br class="hidden md:block" />
        Je les automatise.
      </h1>

      <!-- Subtitle -->
      <p class="font-[var(--font-body)] text-base md:text-xl text-[#888888] leading-[1.6] max-w-[600px] mt-[-8px]">
        Automatisations Make, n8n, Zapier et intégrations IA sur mesure. Vos équipes arrêtent de saisir, copier-coller et relancer — elles se concentrent sur ce qui compte.
      </p>

      <!-- CTA Button -->
      <div class="flex items-center justify-center mt-4 w-full md:w-auto">
        <a
          href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
          class="w-full md:w-auto inline-flex items-center justify-center font-[var(--font-body)] text-[15px] font-medium text-white bg-[#8B5CF6] hover:bg-[#7C3AED] rounded-lg px-7 py-3.5 transition-colors min-h-[48px]"
        >
          Parlons automatisations &rarr;
        </a>
      </div>

      <!-- Video placeholder (hidden until video is ready) -->
      <!--
      <div class="relative w-full max-w-[600px] mt-4 rounded-2xl overflow-hidden" style="border: 1px solid rgba(139,92,246,0.2);">
        <div class="relative aspect-video bg-[#0A0A0A] flex items-center justify-center cursor-pointer group" id="video-placeholder">
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition-colors duration-300"></div>
          <div class="relative z-[1] flex flex-col items-center gap-3">
            <div class="w-16 h-16 md:w-20 md:h-20 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110" style="background: rgba(139,92,246,0.9); box-shadow: 0 0 30px rgba(139,92,246,0.3);">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white" class="ml-1"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </div>
            <span class="font-[var(--font-body)] text-[13px] md:text-sm text-[#BBBBBB] group-hover:text-white transition-colors duration-300">
              Voir comment ça marche
            </span>
          </div>
        </div>
      </div>
      -->

      <!-- Trust Metrics -->
      <div class="flex flex-row items-center justify-center gap-4 md:gap-12 mt-10 w-full">
        {stats.map((stat) => (
          <div class="flex flex-col items-center gap-1 min-w-0">
            <span class="font-[var(--font-mono)] text-lg md:text-2xl font-bold text-[#8B5CF6]">
              {stat.number}
            </span>
            <span class="font-[var(--font-body)] text-[11px] md:text-[13px] text-[#777777] text-center">
              {stat.label}
            </span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const placeholder = document.getElementById('video-placeholder');
    if (!placeholder) return;
    placeholder.addEventListener('click', () => {
      const overlay = document.createElement('div');
      overlay.className = 'absolute inset-0 flex items-center justify-center z-10';
      overlay.style.background = 'rgba(0,0,0,0.8)';
      const msg = document.createElement('p');
      msg.textContent = 'Vidéo bientôt disponible';
      msg.style.cssText = 'color: #BBBBBB; font-family: var(--font-body); font-size: 15px;';
      overlay.appendChild(msg);
      placeholder.style.position = 'relative';
      placeholder.appendChild(overlay);
      setTimeout(() => overlay.remove(), 2500);
    });
  });
</script>
