---
const clients = [
  "Qonto",
  "Jellysmack",
  "Digital Campus",
  "Edumiam",
  "Rocket School",
  "Contournement",
];

const stats = [
  { number: "+300", label: "personnes formées" },
  { number: "+50", label: "entreprises accompagnées" },
  { number: "+10 000", label: "heures économisées" },
];
---

<section class="bg-white">
  <!-- Hero Content -->
  <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20 px-6 lg:px-[120px] pt-[172px] pb-[100px]">
    <!-- Left Column -->
    <div class="flex-1 flex flex-col gap-7">
      <!-- Badge -->
      <div class="inline-flex self-start">
        <span class="bg-[#F4F4F5] text-black font-mono text-[13px] font-medium px-4 py-2 rounded-lg">
          &gt; Expert IA & Automations
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-[48px] lg:text-[64px] font-extrabold text-black leading-[1.05] tracking-[-2px]">
        Expert IA &<br />Automations<br />Make & n8n
      </h1>

      <!-- Subheadline -->
      <p class="text-[18px] text-[#71717A] font-normal leading-[1.5] max-w-xl">
        Freelance & formateur spécialisé en automatisations intelligentes. Je fais gagner +10h par semaine aux entreprises ambitieuses.
      </p>

      <!-- CTA Row -->
      <div class="flex flex-wrap items-center gap-4">
        <a href="https://lilian.yt/contact" class="inline-flex items-center justify-center bg-black text-white text-base font-semibold px-7 py-3.5 rounded-lg hover:bg-zinc-800 transition-colors">
          Réserver un appel
        </a>
        <a href="#tarifs" class="inline-flex items-center justify-center bg-white text-black text-base font-medium px-7 py-3.5 rounded-lg border border-black hover:bg-zinc-50 transition-colors">
          Voir les services
        </a>
      </div>
    </div>

    <!-- Right Column — Stat Cards -->
    <div class="w-full lg:w-[380px] flex flex-col gap-4">
      {stats.map((stat) => (
        <div class="bg-[#F4F4F5] rounded-xl px-7 py-6 flex flex-col gap-1.5">
          <span class="font-mono text-[40px] font-black text-black leading-none">{stat.number}</span>
          <span class="text-sm text-[#71717A] font-normal">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Trust Logos -->
  <div class="bg-[#F4F4F5] py-12 px-6 lg:px-[120px]">
    <div class="flex flex-col items-center gap-6">
      <p class="font-mono text-[11px] font-semibold text-[#A1A1AA] uppercase tracking-[2px] text-center">
        ILS ME FONT CONFIANCE
      </p>
      <div class="flex flex-wrap items-center justify-center gap-8 lg:gap-12">
        {clients.map((name) => (
          <span class="text-sm font-medium text-[#A1A1AA]">{name}</span>
        ))}
      </div>
    </div>
  </div>
</section>
