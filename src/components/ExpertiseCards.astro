---
import { Icon } from 'astro-icon/components';

const expertises = [
  {
    icon: "lucide:zap",
    title: "Automatisations",
    description: "Workflows sur-mesure connectant +1500 apps pour éliminer les tâches répétitives et gagner en efficacité."
  },
  {
    icon: "lucide:graduation-cap",
    title: "Formation",
    description: "De débutant à expert, +300 personnes formées aux outils no-code et à l'automatisation."
  },
  {
    icon: "lucide:target",
    title: "Conseil",
    description: "Optimisation de votre stack technologique pour des résultats mesurables et durables."
  }
];

const tools = [
  {
    icon: "lucide:layers",
    name: "Make",
    description: "Plateforme d'automatisation no-code pour orchestrer des workflows complexes et connecter des centaines d'apps.",
    badge: "Automation"
  },
  {
    icon: "lucide:git-branch",
    name: "n8n",
    description: "Outil d'automatisation open-source pour des intégrations avancées et un contrôle total sur les données.",
    badge: "Open Source"
  },
  {
    icon: "lucide:database",
    name: "Airtable",
    description: "Base de données no-code flexible pour structurer, relier et visualiser les données métier.",
    badge: "Database"
  },
  {
    icon: "lucide:code",
    name: "API",
    description: "Intégration et consommation d'APIs REST, webhooks et connecteurs personnalisés pour tout relier.",
    badge: "Intégration"
  },
  {
    icon: "lucide:brain",
    name: "Claude AI",
    description: "Intelligence artificielle pour générer, analyser et automatiser des tâches complexes avec précision.",
    badge: "Intelligence"
  }
];
---

<!-- Expertise Section -->
<section id="expertise" class="bg-white py-20 px-6 lg:px-[120px]">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-12 flex flex-col gap-4">
      <span class="font-mono text-[13px] font-semibold text-[#A1A1AA] tracking-[2px]">// Expertise</span>
      <h2 class="text-[32px] lg:text-[40px] font-extrabold text-black leading-[1.1] tracking-[-1px] max-w-[900px]">
        Des compétences au service de votre productivité
      </h2>
      <p class="text-[18px] text-[#71717A] font-normal leading-[1.5] max-w-[800px]">
        Une approche transversale mêlant automatisation, formation et conseil pour transformer vos processus métier.
      </p>
    </div>

    <!-- Expertise Cards -->
    <div class="grid md:grid-cols-3 gap-6 mb-20">
      {expertises.map((item) => (
        <div class="bg-[#F4F4F5] rounded-xl p-8 flex flex-col gap-4 border-t-[3px] border-black">
          <div class="w-12 h-12 rounded-lg bg-white flex items-center justify-center">
            <Icon name={item.icon} class="w-6 h-6 text-black" />
          </div>
          <h3 class="text-xl font-extrabold text-black">{item.title}</h3>
          <p class="text-sm text-[#71717A] font-normal leading-[1.5]">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Tech Stack Section -->
<section class="bg-white py-20 px-6 lg:px-[120px]">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-12 flex flex-col gap-4">
      <span class="font-mono text-[13px] font-semibold text-[#A1A1AA] tracking-[2px]">// Stack technique</span>
      <h2 class="text-[32px] lg:text-[40px] font-extrabold text-black leading-[0.95] tracking-[-1px]">
        Les outils que je maîtrise
      </h2>
      <p class="text-[18px] text-[#71717A] font-normal leading-[1.5] max-w-[600px]">
        De Make à Claude AI, une stack pensée pour automatiser, connecter et déployer des solutions sur mesure.
      </p>
    </div>

    <!-- Tool Cards -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
      {tools.map((tool) => (
        <div class="bg-[#F4F4F5] rounded-xl p-6 flex flex-col gap-3">
          <div class="w-11 h-11 rounded-lg bg-white flex items-center justify-center">
            <Icon name={tool.icon} class="w-[22px] h-[22px] text-black" />
          </div>
          <h3 class="text-base font-semibold text-black">{tool.name}</h3>
          <p class="text-[13px] text-[#71717A] font-normal leading-[1.4]">{tool.description}</p>
          <span class="inline-flex self-start bg-[#F4F4F5] border border-[#E4E4E7] text-[11px] text-[#A1A1AA] font-mono px-2.5 py-1 rounded-full">
            {tool.badge}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
