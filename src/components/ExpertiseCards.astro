---
import { Icon } from 'astro-icon/components';

const logosBar = ["MAKE", "N8N", "ZAPIER", "AIRTABLE", "NOTION", "OPENAI", "SLACK"];

const expertises = [
  {
    icon: "lucide:zap",
    label: "// AUTOMATISATION",
    title: "Automatisations",
    description: "Mise en place de workflows automatisés pour éliminer les tâches répétitives et gagner en productivité.",
    stat: "+200 workflows déployés",
  },
  {
    icon: "lucide:graduation-cap",
    label: "// FORMATION",
    title: "Formation",
    description: "Accompagnement personnalisé pour rendre vos équipes autonomes sur les outils d'automatisation.",
    stat: "+300 personnes formées",
  },
  {
    icon: "lucide:lightbulb",
    label: "// CONSEIL",
    title: "Conseil",
    description: "Audit et recommandations stratégiques pour optimiser vos processus et votre stack technique.",
    stat: "+50 entreprises auditées",
  }
];
---

<!-- Expertise: bg-darkest -->
<section id="expertise" class="fade-in-section bg-[var(--bg-darkest)] py-16 lg:py-20">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-[60px]">
    <!-- Header centered -->
    <div class="flex flex-col items-center gap-4 mb-10">
      <span class="font-mono text-xs font-semibold text-[var(--accent)] tracking-[3px]">// EXPERTISE</span>
      <h2 class="font-heading text-[28px] lg:text-[40px] font-extrabold text-[var(--text-primary)] text-center tracking-[-1px]">
        Des compétences qui font la différence
      </h2>
      <p class="font-mono text-sm text-[var(--text-secondary)] text-center leading-[1.6] max-w-[700px]">
        Une approche pluridisciplinaire pour automatiser, former et conseiller les entreprises dans leur transformation digitale.
      </p>
    </div>

    <!-- Logos bar -->
    <div class="flex flex-wrap items-center justify-center gap-6 mb-10 px-4 py-3 bg-[var(--bg-card)] border border-[var(--border)]">
      {logosBar.map((name) => (
        <span class="font-mono text-xs font-semibold text-[var(--text-muted)] tracking-[2px]">{name}</span>
      ))}
    </div>

    <!-- 3 Cards -->
    <div class="grid md:grid-cols-3 gap-6 mc-stagger">
      {expertises.map((item) => (
        <div class="mc-card bg-[var(--bg-card)] border border-[var(--border)] p-8 flex flex-col gap-5">
          <!-- Icon in frame -->
          <div class="w-14 h-14 flex items-center justify-center bg-[var(--accent-surface)] border border-[var(--accent)]/20">
            <Icon name={item.icon} class="w-7 h-7 text-[var(--accent)]" />
          </div>

          <!-- Label -->
          <span class="font-mono text-[11px] font-semibold text-[var(--gold)] tracking-[2px]">{item.label}</span>

          <!-- Title -->
          <h3 class="font-heading text-[22px] font-extrabold text-[var(--text-primary)]">{item.title}</h3>

          <!-- Description -->
          <p class="font-mono text-[13px] text-[var(--text-secondary)] leading-[1.6] flex-1">{item.description}</p>

          <!-- Stat bottom line -->
          <div class="flex items-center gap-2 pt-4 border-t border-[var(--border)]">
            <Icon name="lucide:check" class="w-4 h-4 text-[var(--accent)]" />
            <span class="font-mono text-xs font-medium text-[var(--text-secondary)]">{item.stat}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
