---
/*
 * home-hero — le premier écran de l'accueil : Lilian se présente, sur une
 * grille.
 *
 * Il l'a voulu ainsi : le titre, centré, et au bas de l'écran la liste des
 * entreprises avec lesquelles il a travaillé. Pas de portrait, pas de chapô,
 * et pas de sculpture non plus : il l'a essayée sous le titre et l'a jugée de
 * trop. Sous le titre, le premier écran porte la barre où l'on écrit à Lilian :
 * `home-invite`, rendu juste après cette section dans `index.astro`, la pose
 * sur l'emplacement réservé ici. Une ligne dit ce qu'elle fait, une flèche
 * annonce la suite. Le titre est la phrase qu'il a dictée : « Salut, je
 * m'appelle Lilian Sevoumian et je suis expert en Automatisations & Agents
 * IA ». L'esperluette est la sienne. Le récit qui suit (`home-story`) porte
 * le propos : vous perdez votre temps, voilà pourquoi.
 *
 * La direction est « tech moderne, propre » : une grille fine tient tout
 * l'écran, centrée sur le titre. Deux choses s'y passent, discrètes. Au
 * chargement, une fois le titre posé, quelques cellules s'allument l'une après
 * l'autre, une seule fois. Et la grille s'éclaire sous le pointeur. Des
 * faisceaux de lumière couraient aussi le long des lignes : Lilian les a fait
 * retirer le 2 octobre 2026 (« il y a déjà assez d'animation avec les carrés
 * qui s'illuminent »). Des croix marquent quelques intersections, comme sur un
 * plan.
 *
 * Lilian a demandé le 8 octobre 2026 de réduire les animations de la page.
 * Les cellules repassaient toutes les neuf secondes, elles ne font plus qu'un
 * passage. Les logos des clients, eux, défilent toujours : je les avais posés
 * en liste fixe le même jour, il a préféré le défilé (« c'était mieux quand ça
 * déroulait »). C'est la seule boucle du premier écran ; elle s'arrête au
 * survol, par son bouton, et quand le premier écran sort de la fenêtre
 * (`data-motion-pause`).
 *
 * Le métier est souligné du trait pêche du site (`mark`), et arrive après le
 * reste de la phrase. La pastille pleine qui le portait jusqu'au 8 octobre
 * 2026 est réservée au bouton d'appel. Sur un écran étroit il passe sur deux
 * lignes, et le trait le suit.
 *
 * Sans script, la phrase et la grille sont là ; il manque l'éclairage sous le
 * pointeur, la barre d'écriture et sa ligne. En mouvement réduit, rien ne
 * bouge.
 *
 */
import { clients } from '../data/clients';

/* Le nom ne se coupe pas : son espace est insécable, et le découpage en mots
   ne coupe que sur l'espace ordinaire. Il passait à la ligne entre le prénom
   et le nom à 1440, 1024 et 320 px. */
const question = 'Salut, je m’appelle Lilian\u00a0Sevoumian et je suis expert en'.split(' ');
const reponse = 'Automatisations & Agents IA';

/* Tout se place en mailles, comptées depuis le centre de l'écran : `x` et `y`
   désignent une ligne de la grille (les lignes passent à une demi-maille du
   centre, le titre est donc au milieu d'une cellule). */
const croix = [
  { x: -5, y: -3 }, { x: 4, y: -3 }, { x: -5, y: 2 }, { x: 4, y: 2 },
  { x: -8, y: 0 }, { x: 7, y: -1 },
];

/* Les cellules qui s'allument, dans l'ordre : un trajet qui traverse l'écran
   de gauche à droite en contournant le titre par le bas. Il se joue une fois,
   au chargement. */
const cellules = [
  { x: -7, y: 1 }, { x: -6, y: 1 }, { x: -6, y: 2 }, { x: -5, y: 2 }, { x: -4, y: 2 },
  { x: 3, y: 2 }, { x: 4, y: 2 }, { x: 5, y: 2 }, { x: 5, y: 1 }, { x: 6, y: 1 },
];
---

<section id="hero" data-section data-affiche data-motion-pause class="affiche relative px-[var(--spacing-section-x)]">
  <div class="affiche__grille" aria-hidden="true">
    <div class="affiche__eclairage"></div>
    {/* La case sous le pointeur, et la traînée des cases qu'il vient de
        quitter (voir le script). */}
    <span class="viseur" data-viseur></span>
    {Array.from({ length: 6 }, () => <span class="trace" data-trace></span>)}
    {cellules.map((c, i) => (
      <span class="cellule" style={`--x: ${c.x}; --y: ${c.y}; --i: ${i}`}></span>
    ))}
    {croix.map((c) => (
      <span class="croix" style={`--x: ${c.x}; --y: ${c.y}`}></span>
    ))}
  </div>

  <div class="affiche__centre">
    <h1 class="affiche__titre" style={`--mots: ${question.length}`}>
      <span class="affiche__question">
        {question.map((mot, i) => (
          <>
            <span class="mot" style={`--i: ${i}`}>{mot}</span>{' '}
          </>
        ))}
      </span>
      <mark class="affiche__reponse">{reponse}</mark>
    </h1>
    {/* La place de la barre où l'on écrit à Lilian (`home-invite.astro`). La
        barre elle-même est rendue juste après cette section (voir
        `index.astro`), hors du flux : elle se pose ici tant qu'on est sur le
        premier écran, puis glisse en bas à droite au défilement. Sans script,
        cet emplacement est vide et ne prend aucune hauteur. */}
    <div class="affiche__invite" data-causerie-place></div>
    {/* Ce que fait la barre, en une ligne : une barre de prompt sous « expert
        en agents IA » se lisait comme un robot. Elle n'en est pas un. */}
    <p class="affiche__mode">
      Écrivez votre besoin, puis choisissez comment me l’envoyer&nbsp;: WhatsApp, <span>e-mail</span> ou appel.
    </p>
    {/* L'amorce de défilement : le premier écran ne donnait aucun indice qu'il
        y a une suite (critique du 2 octobre 2026). Une flèche, pas un mot de
        plus : le titre reste seul. */}
    <a class="affiche__suite" href="#histoire">
      <span class="sr-only">Lire la suite</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M12 5v14" />
        <path d="m6 13 6 6 6-6" />
      </svg>
    </a>
  </div>

  <div
    class="defile"
    role="group"
    aria-label="Entreprises avec lesquelles j’ai travaillé"
    data-defile
  >
    <p class="defile__titre">J’ai travaillé avec</p>
    <div class="defile__fenetre">
      <ul class="defile__piste">
        {[0, 1].map((tour) =>
          clients.map((client) => (
            <li aria-hidden={tour === 1 ? 'true' : undefined}>
              {client.logo ? (
                <img
                  src={client.logo.src}
                  width={client.logo.largeur}
                  height={client.logo.hauteur}
                  alt={client.nom}
                  loading="eager"
                  decoding="async"
                  style={client.logo.echelle ? `--echelle: ${client.logo.echelle}` : undefined}
                />
              ) : (
                <span>{client.nom}</span>
              )}
            </li>
          )),
        )}
      </ul>
    </div>
    {/* Un contenu qui défile sans fin doit pouvoir être arrêté, au clavier et
        au doigt : le survol seul ne servait que la souris. */}
    <button type="button" class="defile__pause" aria-pressed="false" data-defile-pause>
      <span class="sr-only">Mettre le défilé des logos en pause</span>
      <svg class="defile__icone defile__icone--pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <rect x="4" y="3" width="3" height="10" rx="1" />
        <rect x="9" y="3" width="3" height="10" rx="1" />
      </svg>
      <svg class="defile__icone defile__icone--lecture" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M5.5 3.2v9.6l7.6-4.8z" />
      </svg>
    </button>
  </div>
</section>

<style>
  .affiche {
    --maille: var(--spacing-maille);
    --trait: color-mix(in srgb, var(--color-ink) 10%, transparent);
    display: grid;
    /* minmax(0, 1fr) : la colonne ne s'élargit pas au contenu quand le texte
       est agrandi, elle le fait revenir à la ligne. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    padding-top: var(--spacing-barre);
    overflow: clip;
    background: var(--color-night-deep);
    isolation: isolate;
  }

  /* ── La grille ──
     Deux réseaux de lignes centrés sur l'écran, qui s'effacent vers les
     bords. Tout ce qui s'y pose (cellules, croix) se place en
     mailles depuis le centre et s'efface avec elle. */
  .affiche__grille {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(var(--trait) 1px, transparent 1px) 50% 50% / var(--maille) var(--maille),
      linear-gradient(90deg, var(--trait) 1px, transparent 1px) 50% 50% / var(--maille) var(--maille);
    -webkit-mask-image: radial-gradient(ellipse 78% 74% at 50% 46%, var(--color-night) 30%, transparent 82%);
    mask-image: radial-gradient(ellipse 78% 74% at 50% 46%, var(--color-night) 30%, transparent 82%);
  }

  /* La même grille, plus claire et teintée de pêche, visible seulement sous
     le pointeur : on éclaire le plan en le survolant. */
  .affiche__eclairage {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(color-mix(in srgb, var(--color-peche) 46%, transparent) 1px, transparent 1px) 50% 50% / var(--maille) var(--maille),
      linear-gradient(90deg, color-mix(in srgb, var(--color-peche) 46%, transparent) 1px, transparent 1px) 50% 50% / var(--maille) var(--maille),
      radial-gradient(circle at var(--px, 50%) var(--py, 30%), color-mix(in srgb, var(--color-peche) 9%, transparent), transparent 22rem);
    -webkit-mask-image: radial-gradient(circle 17rem at var(--px, 50%) var(--py, 30%), var(--color-night), transparent);
    mask-image: radial-gradient(circle 17rem at var(--px, 50%) var(--py, 30%), var(--color-night), transparent);
  }

  /* Une cellule : la maille (x, y) comptée depuis le centre. Les lignes
     passent à une demi-maille du centre, d'où le décalage. */
  .cellule {
    position: absolute;
    top: calc(50% + (var(--y) - 0.5) * var(--maille));
    left: calc(50% + (var(--x) - 0.5) * var(--maille));
    width: var(--maille);
    height: var(--maille);
    background: color-mix(in srgb, var(--color-peche) 10%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-peche) 34%, transparent);
    opacity: 0;
  }

  /* La case que vise le pointeur : nettement allumée, elle saute de maille en
     maille avec lui. Les cases quittées s'éteignent derrière, en traînée. */
  .viseur,
  .trace {
    position: absolute;
    top: calc(50% + (var(--y, 0) - 0.5) * var(--maille));
    left: calc(50% + (var(--x, 0) - 0.5) * var(--maille));
    width: var(--maille);
    height: var(--maille);
    opacity: 0;
    pointer-events: none;
  }

  .viseur {
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--color-peche) 58%, transparent), color-mix(in srgb, var(--color-peche) 26%, transparent));
    box-shadow:
      inset 0 0 0 1px var(--color-peche),
      0 0 3rem 0 color-mix(in srgb, var(--color-peche) 50%, transparent);
    transition: opacity 220ms var(--ease-out-quint);
  }

  .viseur.est-la {
    opacity: 1;
  }

  .trace {
    background: color-mix(in srgb, var(--color-peche) 24%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-peche) 55%, transparent);
  }

  .croix {
    position: absolute;
    top: calc(50% + (var(--y) - 0.5) * var(--maille) - 5px);
    left: calc(50% + (var(--x) - 0.5) * var(--maille) - 5px);
    width: 11px;
    height: 11px;
    background:
      linear-gradient(var(--color-ink-faint), var(--color-ink-faint)) 50% 50% / 100% 1px no-repeat,
      linear-gradient(var(--color-ink-faint), var(--color-ink-faint)) 50% 50% / 1px 100% no-repeat;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Un seul passage, à la suite de l'entrée du titre : deux secondes après
       le chargement la première cellule s'allume, les autres suivent, et
       chacune s'éteint pour de bon. Elles repassaient toutes les neuf
       secondes jusqu'au 8 octobre 2026. */
    .cellule {
      animation: cellule-passe 1200ms var(--ease-out-quint);
      animation-delay: calc(var(--i) * 420ms + 2s);
    }

    .affiche__grille {
      animation: grille-leve 1800ms var(--ease-out-expo) backwards;
    }
  }

  /* Allumée en un tiers de seconde, éteinte en un peu moins d'une. */
  @keyframes cellule-passe {
    0%, 100% { opacity: 0; }
    30% { opacity: 1; }
  }

  @keyframes grille-leve {
    from { opacity: 0; }
  }

  /* ── La phrase ── */
  .affiche__centre {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    gap: var(--spacing-groupe);
    padding-block: var(--spacing-home-hero-y);
  }

  /* L'emplacement de la barre d'écriture, sous le titre. Sa hauteur est
     donnée par le script, qui y pose la barre. */
  .affiche__invite {
    width: min(100%, 34rem);
  }

  .affiche__invite:empty:not([style]) {
    display: none;
  }

  /* Collée à la barre : elle parle d'elle. Sans script il n'y a pas de barre,
     donc pas de ligne non plus. */
  .affiche__mode {
    max-width: 34rem;
    margin: calc(var(--spacing-colle) - var(--spacing-groupe)) 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
    text-align: center;
    text-wrap: balance;
  }

  .affiche__mode span {
    white-space: nowrap;
  }

  .affiche__invite:empty:not([style]) + .affiche__mode {
    display: none;
  }

  /* Au pied de la zone du titre, juste au-dessus du défilé des clients. */
  .affiche__suite {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-night-deep) 70%, transparent);
    color: var(--color-ink-mid);
    transition:
      border-color var(--duration-default) var(--ease-out-quint),
      background-color var(--duration-default) var(--ease-out-quint),
      color var(--duration-default) var(--ease-out-quint);
  }

  .affiche__suite svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--duration-default) var(--ease-out-quint);
  }

  @media (hover: hover) and (pointer: fine) {
    .affiche__suite:hover {
      border-color: var(--color-peche);
      background: var(--color-peche);
      color: var(--color-night);
    }

    .affiche__suite:hover svg {
      transform: translateY(2px);
    }
  }

  /* Écran bas : le titre et la barre d'écriture ont besoin de la place. Le
     seuil est monté de 720 à 820 px le 8 octobre 2026 : la liste des logos,
     devenue fixe, prend deux à trois lignes là où le défilé n'en prenait
     qu'une, et la flèche touchait la ligne sous la barre à 1024 × 768 et à
     360 × 800. */
  @media (max-height: 820px) {
    .affiche__suite {
      display: none;
    }
  }

  .affiche__titre {
    max-width: 16.5em;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-affiche);
    font-weight: 500;
    /* Desserré : à -0,045em et 1,04 les lettres se touchaient presque et les
       deux lignes se collaient. Retour de Lilian. */
    line-height: 1.12;
    letter-spacing: -0.028em;
    text-align: center;
    /* Un mot plus large que l'écran (texte agrandi) se coupe plutôt que de
       sortir du cadre. Sans effet à la taille normale. */
    overflow-wrap: anywhere;
  }

  .affiche__question {
    display: block;
    text-wrap: balance;
  }

  .mot {
    display: inline-block;
  }

  /* Le métier est souligné : le trait vient de `mark` (global.css). */
  .affiche__question {
    padding-bottom: 0.12em;
  }

  @media (min-width: 900px) {
    .affiche__reponse {
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* L'entrée tient en une seconde et demie. Elle en prenait plus de trois :
       le métier n'était lisible qu'après deux secondes, et les logos après
       trois. */
    .affiche .mot {
      animation: mot-pose 800ms var(--ease-out-expo) backwards;
      animation-delay: calc(var(--i) * 45ms + 120ms);
    }

    /* Un temps, puis le métier se pose. */
    .affiche__reponse {
      animation: reponse-pose 900ms var(--ease-out-expo) backwards;
      animation-delay: calc(var(--mots) * 45ms + 320ms);
    }

    .defile {
      animation: entree-monte 900ms var(--ease-out-expo) backwards;
      animation-delay: 620ms;
    }

    .affiche__suite,
    .affiche__mode {
      animation: entree-monte 900ms var(--ease-out-expo) backwards;
      animation-delay: 900ms;
    }
  }

  @keyframes mot-pose {
    from { opacity: 0.01; transform: translateY(0.4em); filter: blur(12px); }
  }

  @keyframes reponse-pose {
    from { opacity: 0; filter: blur(10px); }
  }

  /* ── Le défilé ── */
  .defile {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    /* Le bandeau va d'un bord à l'autre de l'écran, mais son contenu tient
       dans la colonne de 1200 px, comme la barre et le reste de la page : le
       titre était à 48 px du bord de la colonne à 1440, et à 264 px à 1920.
       Le pourcentage se lit sur la largeur utile de la section. Le bouton de
       pause déborde de sa marge intérieure, pour que son icône tombe sur le
       bord de la colonne. */
    --bord: calc(var(--spacing-section-x) + max(0px, (100% - 1200px) / 2));
    --haut: clamp(1.1rem, 2.4svh, 1.6rem);
    gap: var(--spacing-lie);
    margin-inline: calc(-1 * var(--spacing-section-x));
    padding: var(--haut) calc(var(--bord) - 0.875rem) var(--haut) var(--bord);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    background: var(--color-night-deep);
  }

  .defile__titre {
    margin: 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    white-space: nowrap;
  }

  .defile__fenetre {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, var(--color-night) 6%, var(--color-night) 92%, transparent);
    mask-image: linear-gradient(to right, transparent, var(--color-night) 6%, var(--color-night) 92%, transparent);
  }

  .defile__piste {
    display: flex;
    align-items: center;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .defile__piste li {
    display: flex;
    align-items: center;
    max-width: none;
    padding-inline: clamp(1.25rem, 2.6vw, 2.25rem);
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Un logo est ramené à une silhouette claire et à la hauteur des lettres,
     corrigée à l'œil par `--echelle` (voir `data/clients.ts`). Les attributs
     `width` et `height` donnent le rapport : la piste a sa largeur finale
     avant que les fichiers n'arrivent. */
  .defile__piste img {
    display: block;
    width: auto;
    max-width: none;
    height: calc(1.5em * var(--echelle, 1));
    filter: brightness(0) invert(1);
    opacity: 0.78;
  }

  @media (prefers-reduced-motion: no-preference) {
    .defile__piste {
      animation: defile 46s linear infinite;
    }

    .defile__fenetre:hover .defile__piste,
    .defile[data-pause] .defile__piste {
      animation-play-state: paused;
    }
  }

  @keyframes defile {
    to { transform: translateX(-50%); }
  }

  /* La commande d'arrêt : une cible de 44 px, discrète tant qu'on ne la vise
     pas. Les deux dessins se relaient selon l'état. */
  .defile__pause {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-ink-low);
    cursor: pointer;
    transition: color var(--duration-default) var(--ease-out-quint),
                background-color var(--duration-default) var(--ease-out-quint);
  }

  .defile__icone {
    fill: currentColor;
  }

  .defile__icone--lecture,
  .defile__pause[aria-pressed='true'] .defile__icone--pause {
    display: none;
  }

  .defile__pause[aria-pressed='true'] .defile__icone--lecture {
    display: block;
  }

  @media (hover: hover) and (pointer: fine) {
    .defile__pause:hover {
      background: var(--color-surface-low);
      color: var(--color-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .defile {
      grid-template-columns: 1fr;
      padding-right: var(--bord);
    }

    .defile__fenetre {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .defile__piste {
      flex-wrap: wrap;
      width: auto;
      row-gap: 1rem;
    }

    .defile__piste li {
      padding-inline: 0 1.5rem;
    }

    .defile__piste li[aria-hidden='true'] {
      display: none;
    }

    /* Plus rien ne défile : la commande d'arrêt n'a plus d'objet. */
    .defile__pause {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .affiche {
      --maille: 3rem;
    }

    .defile {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.25rem 0.5rem;
      padding-left: 0;
    }

    .defile__titre {
      padding-left: var(--spacing-section-x);
    }

    .defile__fenetre {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .defile__pause {
      grid-column: 2;
      grid-row: 1;
    }
  }

  /* Sans défilement, sur un écran étroit, la liste reprend la marge du titre :
     le bandeau y a perdu la sienne pour laisser la piste courir d'un bord à
     l'autre. */
  @media (max-width: 640px) and (prefers-reduced-motion: reduce) {
    .defile {
      padding-right: 0;
    }

    .defile__fenetre {
      padding-inline: var(--spacing-section-x);
    }

    /* La liste posée faisait sept lignes sur un téléphone, et le premier écran
       ne tenait plus dans l'écran : plus petits et plus serrés, les logos en
       font cinq. */
    .defile__piste {
      row-gap: 0.625rem;
    }

    .defile__piste li {
      padding-inline: 0 1rem;
      font-size: var(--text-body-sm);
    }
  }
</style>

<script>
  /* La grille répond au pointeur : la lueur le suit au pixel, et la case qu'il
     survole s'allume franchement, en sautant de maille en maille. Les cases
     quittées s'éteignent derrière lui. Deux variables et une classe, mises à
     jour au plus une fois par image. Sans pointeur fin, rien ne bouge. */
  const affiche = document.querySelector<HTMLElement>('[data-affiche]');
  const grille = affiche?.querySelector<HTMLElement>('.affiche__grille');
  const viseur = grille?.querySelector<HTMLElement>('[data-viseur]');
  if (affiche && grille && viseur && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const traces = [...grille.querySelectorAll<HTMLElement>('[data-trace]')];
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let x = 0;
    let y = 0;
    let prevu = false;
    let caseX: number | null = null;
    let caseY = 0;
    let prochaine = 0;

    const eteindre = (cx: number, cy: number) => {
      if (reduit || !traces.length) return;
      const trace = traces[prochaine];
      prochaine = (prochaine + 1) % traces.length;
      trace.style.setProperty('--x', String(cx));
      trace.style.setProperty('--y', String(cy));
      trace.animate([{ opacity: 0.85 }, { opacity: 0 }], { duration: 720, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
    };

    affiche.addEventListener('pointermove', (e) => {
      const r = grille.getBoundingClientRect();
      x = e.clientX - r.left;
      y = e.clientY - r.top;
      if (prevu) return;
      prevu = true;
      requestAnimationFrame(() => {
        prevu = false;
        grille.style.setProperty('--px', `${x}px`);
        grille.style.setProperty('--py', `${y}px`);
        /* La maille est lue sur la case elle-même : c'est un `clamp()`, sa
           valeur en pixels dépend de la largeur de la fenêtre. Les lignes
           passent à une demi-maille du centre, d'où l'arrondi. */
        const maille = viseur.offsetWidth;
        if (!maille) return;
        const nx = Math.round((x - grille.clientWidth / 2) / maille);
        const ny = Math.round((y - grille.clientHeight / 2) / maille);
        if (nx === caseX && ny === caseY) return;
        if (caseX !== null) eteindre(caseX, caseY);
        caseX = nx;
        caseY = ny;
        viseur.style.setProperty('--x', String(nx));
        viseur.style.setProperty('--y', String(ny));
        viseur.classList.add('est-la');
      });
    });
    affiche.addEventListener('pointerleave', () => {
      viseur.classList.remove('est-la');
      caseX = null;
    });
  }

  /* Le défilé s'arrête et repart d'un bouton. `aria-pressed` porte l'état, le
     libellé reste le même : c'est la convention d'un bouton à bascule. */
  const defile = document.querySelector<HTMLElement>('[data-defile]');
  const pause = defile?.querySelector<HTMLButtonElement>('[data-defile-pause]');
  if (defile && pause) {
    pause.addEventListener('click', () => {
      const arrete = pause.getAttribute('aria-pressed') !== 'true';
      pause.setAttribute('aria-pressed', String(arrete));
      defile.toggleAttribute('data-pause', arrete);
    });
  }

</script>
