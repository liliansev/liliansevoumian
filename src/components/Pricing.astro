---
import { Icon } from 'astro-icon/components';

const services = [
  {
    title: "Consultation",
    description: "Appels stratégiques pour structurer vos projets",
  },
  {
    title: "Accompagnement",
    description: "Audit, formation et support continu",
  },
  {
    title: "Mission",
    description: "Déploiement d'automatisations de A à Z",
  },
];
---

<!-- Pricing: bg-dark -->
<section id="tarifs" class="fade-in-section bg-[var(--bg-dark)] py-16 lg:py-20">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-[60px]">
    <!-- Header -->
    <div class="flex flex-col items-center gap-4 mb-10">
      <span class="font-mono text-xs font-semibold text-[var(--accent)] tracking-[3px]">// SERVICES</span>
      <h2 class="font-heading text-[28px] lg:text-[40px] font-extrabold text-[var(--text-primary)] text-center tracking-[-1px]">
        Chaque défi a sa solution automatisée
      </h2>
    </div>

    <!-- Single CTA Card -->
    <div class="max-w-[720px] mx-auto mc-stagger">
      <div class="mc-card bg-[var(--bg-card)] border-2 border-[var(--accent)] p-8 lg:p-10 flex flex-col gap-8">
        <!-- Intro text -->
        <p class="font-mono text-sm text-[var(--text-secondary)] leading-[1.8] text-center">
          Consultation ponctuelle, accompagnement sur la durée ou mission complète — chaque collaboration est sur-mesure.
        </p>

        <!-- 3 Service types -->
        <div class="flex flex-col gap-5">
          {services.map((service) => (
            <div class="flex items-start gap-3">
              <Icon name="lucide:check" class="w-5 h-5 text-[var(--accent)] shrink-0 mt-0.5" />
              <div class="flex flex-col gap-0.5">
                <span class="font-heading text-base font-bold text-[var(--text-primary)]">{service.title}</span>
                <span class="font-mono text-xs text-[var(--text-secondary)] leading-[1.6]">{service.description}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Separator -->
        <div class="w-full h-[2px] bg-[var(--border)]"></div>

        <!-- CTA Button -->
        <div class="flex justify-center">
          <a
            href="https://lilian.yt/contact"
            class="cta-glow bg-[var(--accent)] text-[var(--text-on-accent)] font-mono text-sm font-bold px-10 py-4 tracking-[1px] hover:bg-[var(--accent-dark)] transition-colors"
          >
            Contactez-moi →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
