---
/*
 * Pricing.astro — devenu le bloc « Discutons-en » (id #appel).
 *
 * Décision Q3 du critique : retirer la grille Pricing 1500€/8-25k€,
 * la valley d'indécision entre les deux tiers décourageait plus
 * qu'elle ne convertissait. Remplacé par un CTA call court qui
 * appelle directement à la qualification.
 *
 * Cette section vit en milieu de page (action-oriented, single-CTA),
 * la section CTA finale (#contact) garde son rôle decision-oriented
 * avec signature humaine développée.
 */
import SectionHeader from './SectionHeader.astro';
---

<section
  id="appel"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="05"
      label="APPEL"
      title="Discutons de votre cas en 30 min."
      body="Format identique à chaque fois : 5 min de contexte, 15 min sur vos process, 10 min de plan d'action chiffré que je formalise sous 48 h. Sans engagement."
      titleMaxWidth="22ch"
      bodyMaxWidth="60ch"
    />

    <!-- CTA + microdata + signature -->
    <div class="reveal flex flex-col gap-6 max-w-[720px]">
      <a
        href="https://cal.com/lilian-sevoumian/20min"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary self-start"
      >
        Réserver maintenant
      </a>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mono-caption text-[var(--color-ink-low)]">
        <span>30 MIN</span>
        <span class="hidden md:inline" aria-hidden="true">·</span>
        <span>GRATUIT</span>
        <span class="hidden md:inline" aria-hidden="true">·</span>
        <span>SANS ENGAGEMENT</span>
        <span class="hidden md:inline" aria-hidden="true">·</span>
        <span>PLAN D'ACTION SOUS 48 H</span>
      </div>

      <div class="mono-caption text-[var(--color-ink-low)] pt-4 border-t border-[var(--color-divider)]">
        SIGNÉ <span class="text-[var(--color-ink)]">LILIAN SEVOUMIAN</span>
      </div>
    </div>

  </div>
</section>
