---
/*
 * SubscriptionGrid — une liste de prix : une formule par ligne.
 *
 * Le nom est hérité : c'était une grille de cartes dans un cadre, pour les
 * seuls abonnements. C'est aujourd'hui la façon d'écrire un tarif, pour une
 * création comme pour un suivi : le nom de la formule à gauche, ce qu'elle est
 * et ce qu'elle comprend au milieu, le prix à droite. Ni cadre, ni fond, ni
 * filet : l'espace sépare les lignes. Les trois colonnes sont celles de toute
 * la liste, pour que les prix tombent les uns sous les autres.
 *
 * Aucune couleur propre à un fond : la liste ne lit que des jetons de rôle.
 * Elle se pose donc telle quelle sur la nuit comme dans un panneau clair
 * `.bloc-encre`, qui remappe ces jetons.
 *
 * Sur téléphone, le prix vient juste sous le nom : c'est lui qu'on vient
 * vérifier.
 */
interface Formule {
  name: string;
  schemaPrice: number;
  /** Le prix est un plancher : il s'affiche précédé de « dès ». */
  minimum?: boolean;
  /** À quoi sert la formule, sous son nom. */
  useCase?: string;
  promise: string;
  includes: readonly string[];
}

interface Props {
  offers: readonly Formule[];
  label: string;
  /** Ce qui suit le montant : « HT / mois » pour un suivi, « HT » pour une création. */
  unite?: string;
}

const { offers, label, unite = 'HT / mois' } = Astro.props;
const montant = (valeur: number) => `${valeur.toLocaleString('fr-FR')} €`;
---

<div class="formules" role="group" aria-label={label}>
  {offers.map((offer) => (
    <article class="formule">
      <div class="formule__nom">
        <h3>{offer.name}</h3>
        {offer.useCase && <p>{offer.useCase}</p>}
      </div>
      <p class="formule__prix">
        {offer.minimum && <span class="formule__note">dès</span>}
        <span class="formule__montant">{montant(offer.schemaPrice)}</span>
        <span class="formule__note">{unite}</span>
      </p>
      <div class="formule__texte">
        <p>{offer.promise}</p>
        <ul>{offer.includes.map((item) => <li>{item}</li>)}</ul>
      </div>
    </article>
  ))}
</div>

<style>
  .formules {
    display: grid;
    row-gap: var(--spacing-bloc);
  }

  .formule {
    display: grid;
    row-gap: 0.75rem;
    min-width: 0;
  }

  .formule__nom h3 {
    margin: 0;
  }

  .formule__nom p {
    margin: var(--spacing-colle) 0 0;
    max-width: 32ch;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  /* Le montant en grand, ce qui le précise en petit, sur une même ligne de
     base. Un prix ne se coupe pas. */
  .formule__prix {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4em;
    max-width: none;
    margin: 0;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .formule__montant {
    font-size: var(--text-title-lg);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .formule__note {
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
  }

  .formule__texte p {
    margin: 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  /* Ce que la formule comprend : une ligne qui se lit à la suite, pas une
     liste à puces. Le point médian suit chaque terme, pour ne jamais ouvrir
     une ligne. */
  .formule__texte ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    margin: var(--spacing-colle) 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .formule__texte li {
    max-width: none;
  }

  .formule__texte li:not(:last-child)::after {
    content: '·';
    margin-left: 0.5em;
  }

  @media (min-width: 900px) {
    .formules {
      grid-template-columns: minmax(11rem, 0.7fr) minmax(0, 1.3fr) auto;
      column-gap: var(--spacing-gouttiere);
      row-gap: var(--spacing-groupe);
    }

    /* Le nom, la phrase et le prix d'une formule partent de la même ligne de
       base. */
    .formule {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: baseline;
    }

    .formule__texte {
      order: 2;
    }

    .formule__prix {
      order: 3;
      justify-content: flex-end;
    }
  }
</style>
