---
import SectionHeader from './SectionHeader.astro';
import { getCollection } from 'astro:content';

const publishedCases = await getCollection('cas-clients', ({ data }) => !data.draft);

const facts = [
  { label: 'Freelance depuis', value: '2020' },
  { label: 'Make niveau 5', value: 'Premier certifié en France' },
  { label: 'Formation', value: '300+ personnes formées' },
  { label: 'Preuves publiques', value: `${publishedCases.length} cas clients · 6 sites en ligne` },
] as const;
---

<section
  id="qui-je-suis"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader
      title="Je cadre, construis et <mark>livre.</mark>"
      titleMaxWidth="22ch"
    />

    <div class="home-about">
      <div class="home-about__story">
        <p>
          Deux années chez Jellysmack m’ont appris à maintenir en production
          les automatisations que j’avais construites.
        </p>
        <p>
          Je pars de votre besoin métier, choisis l’architecture et développe
          la solution. Je teste les parcours avant de livrer, puis accompagne
          les évolutions prévues.
        </p>
        <a href="/cas-clients" class="home-about__link text-link-arrow">
          <span>Voir les cas clients</span><span aria-hidden="true">→</span>
        </a>
      </div>

      <dl>
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .home-about {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .home-about__story p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.62;
  }

  .home-about__story p + p {
    margin-top: 1.5rem;
  }

  .home-about__link {
    margin-top: 1.5rem;
  }

  .home-about dl {
    margin: 0;
    border-top: 1px solid var(--color-border-strong);
  }

  .home-about dl > div {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .home-about dt {
    color: var(--color-ink-low);
    font-size: var(--text-mono-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-about dd {
    margin: 0.45rem 0 0;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    font-weight: 550;
    line-height: 1.45;
  }

  @media (max-width: 800px) {
    .home-about {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }
</style>
