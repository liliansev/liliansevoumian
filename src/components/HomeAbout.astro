---
import SectionHeader from './SectionHeader.astro';
import { Picture } from 'astro:assets';
import lilianBureau from '../assets/lilian-au-bureau.jpg';

const facts = [
  { label: 'La Capsule', value: 'COO · Automatisation des processus opérationnels' },
  { label: 'Ex-Jellysmack', value: '2 ans à automatiser le travail des équipes' },
] as const;
---

<section
  id="qui-je-suis"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader
      title="Moi, c’est <mark>Lilian.</mark>"
      titleMaxWidth="22ch"
    />

    <div class="home-about">
      <div class="home-about__story">
        <p>
          Chez La Capsule, en tant que COO, j’ai automatisé les processus
          opérationnels pour simplifier le travail des équipes.
          C’est cette expérience du terrain que j’apporte à vos projets :
          comprendre le travail, puis construire les outils qui le facilitent.
        </p>
        <dl>
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
        <a href="/cas-clients" class="home-about__link text-link-arrow">
          <span>Voir les cas clients</span><span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="m-0 min-w-0">
        <Picture src={lilianBureau} alt="Lilian Sevoumian à son bureau, devant un scénario d’automatisation Make" formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" loading="lazy" class="block h-auto w-full" />
        <figcaption class="mt-3 text-sm text-[var(--color-ink-low)]">Dans mon espace de travail, sur un scénario Make.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .home-about {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .home-about__story p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.62;
  }

  .home-about__link {
    margin-top: 1.5rem;
  }

  .home-about dl {
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--color-border-strong);
  }

  .home-about dl > div {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .home-about dt {
    color: var(--color-ink-low);
    font-size: var(--text-mono-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-about dd {
    margin: 0.45rem 0 0;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    font-weight: 550;
    line-height: 1.45;
  }

  @media (max-width: 800px) {
    .home-about {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }
</style>
