---
import SectionHeader from './SectionHeader.astro';

const facts = [
  { label: 'Freelance depuis', value: '2020' },
  { label: 'Make niveau 5', value: 'Premier certifié en France' },
  { label: 'Formation', value: '300+ personnes formées' },
  { label: 'Preuves publiques', value: '4 cas clients · 6 sites en ligne' },
] as const;
---

<section
  id="qui-je-suis"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader
      title="Je cadre le projet. Je construis aussi <mark>la solution.</mark>"
      body="Vous échangez avec la personne qui choisit l’architecture, écrit, teste et livre. Le projet ne change pas de mains après le rendez-vous."
      titleMaxWidth="22ch"
      bodyMaxWidth="58ch"
    />

    <div class="home-about">
      <div class="home-about__story">
        <p>
          Je travaille en freelance depuis 2020. Deux années chez Jellysmack
          m’ont appris à maintenir en production les automatisations que
          j’avais construites, puis j’ai obtenu la certification Make
          niveau&nbsp;5, la première délivrée en France.
        </p>
        <p>
          Aujourd’hui, la même méthode sert un workflow, un agent IA, un outil
          métier ou un site web&nbsp;: comprendre le besoin, construire vite,
          vérifier sérieusement et laisser un système qui peut évoluer.
        </p>
        <a href="/cas-clients" class="home-about__link">
          Voir les missions documentées <span aria-hidden="true">→</span>
        </a>
      </div>

      <dl>
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .home-about {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .home-about__story p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.62;
  }

  .home-about__story p + p {
    margin-top: 1.5rem;
  }

  .home-about__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.5rem;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-lime);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .home-about__link span {
    transition: transform var(--duration-default) var(--ease-out-quint);
  }

  .home-about dl {
    margin: 0;
    border-top: 1px solid var(--color-border-strong);
  }

  .home-about dl > div {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .home-about dt {
    color: var(--color-ink-low);
    font-size: var(--text-mono-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-about dd {
    margin: 0.45rem 0 0;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    font-weight: 550;
    line-height: 1.45;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-about__link:hover span {
      transform: translateX(0.3rem);
    }
  }

  @media (max-width: 800px) {
    .home-about {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }
</style>
