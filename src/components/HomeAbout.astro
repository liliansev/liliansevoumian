---
import SectionHeader from './SectionHeader.astro';

const facts = [
  { label: 'Freelance depuis', value: '2020' },
  { label: 'Formation', value: '300+ personnes formées' },
] as const;
---

<section
  id="qui-je-suis"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader
      title="Moi, c’est <mark>Lilian.</mark>"
      titleMaxWidth="22ch"
    />

    <div class="home-about">
      <div class="home-about__story">
        <p>
          J’aime comprendre comment les gens travaillent et trouver ce qui
          pourrait leur simplifier la journée. C’est ce qui me passionne dans
          l’IA et l’automatisation. J’ai notamment passé deux ans chez Jellysmack
          à développer des automatisations pour les équipes.
        </p>
        <a href="/cas-clients" class="home-about__link text-link-arrow">
          <span>Voir les cas clients</span><span aria-hidden="true">→</span>
        </a>
      </div>

      <dl>
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .home-about {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .home-about__story p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.62;
  }

  .home-about__link {
    margin-top: 1.5rem;
  }

  .home-about dl {
    margin: 0;
    border-top: 1px solid var(--color-border-strong);
  }

  .home-about dl > div {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .home-about dt {
    color: var(--color-ink-low);
    font-size: var(--text-mono-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-about dd {
    margin: 0.45rem 0 0;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    font-weight: 550;
    line-height: 1.45;
  }

  @media (max-width: 800px) {
    .home-about {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }
</style>
