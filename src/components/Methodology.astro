---
const phases = [
  {
    number: "01",
    title: "AUDIT & STRATÉGIE",
    description: "Analyse approfondie de votre écosystème digital, identification des leviers de croissance et définition d'une feuille de route claire.",
  },
  {
    number: "02",
    title: "BUILD & INTÉGRATION",
    description: "Conception et déploiement de solutions techniques performantes, intégration des outils et automatisation des processus.",
  },
  {
    number: "03",
    title: "OPTIMISATION & SCALE",
    description: "Suivi des performances, itérations continues et mise à l'échelle des stratégies qui fonctionnent pour maximiser le ROI.",
  }
];
---

<!-- Methodology: dark gaming with emerald+gold -->
<section id="process" class="fade-in-section bg-[var(--bg-dark)] py-16 lg:py-20">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-[60px]">
    <!-- Header -->
    <div class="flex flex-col gap-4 mb-4">
      <span class="font-mono text-xs font-semibold text-[var(--accent)] tracking-[3px]">// MÉTHODE</span>
      <h2 class="font-heading text-[28px] lg:text-[40px] font-extrabold text-[var(--text-primary)] tracking-[-1px]">
        Un process clair, des résultats concrets
      </h2>
    </div>

    <!-- Divider -->
    <div class="w-full h-0.5 bg-[var(--border)] mb-10"></div>

    <!-- 3 Cards -->
    <div class="grid md:grid-cols-3 gap-6 mc-stagger">
      {phases.map((phase) => (
        <div class="bg-[var(--bg-card)] border border-[var(--border)] border-t-[3px] border-t-[var(--accent)] p-8 flex flex-col gap-5">
          <!-- Number -->
          <span class="font-mono text-[48px] font-extrabold leading-none text-[var(--gold)]">{phase.number}</span>
          <!-- Title -->
          <h3 class="font-heading text-[22px] font-extrabold text-[var(--text-primary)] tracking-[1px]">{phase.title}</h3>
          <!-- Description -->
          <p class="font-mono text-[13px] text-[var(--text-secondary)] leading-[1.6]">{phase.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
