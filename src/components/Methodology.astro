---
const phases = [
  {
    number: "01",
    title: "Analyser",
    description: "Audit complet de vos process. Identification des tâches répétitives et gains de temps potentiels.",
    duration: "1-2 jours"
  },
  {
    number: "02",
    title: "Développer",
    description: "Développement itératif avec livrables réguliers. Connexion de vos outils via Make, n8n et APIs.",
    duration: "1-3 semaines"
  },
  {
    number: "03",
    title: "Automatiser",
    description: "Validation finale, documentation complète et mise en production. Support continu 30 jours.",
    duration: "30 jours inclus"
  }
];
---

<section id="process" class="bg-black py-20 px-6 lg:px-[120px]">
  <div class="max-w-7xl mx-auto flex flex-col items-center">
    <!-- Header -->
    <div class="text-center mb-12 flex flex-col items-center gap-4">
      <span class="font-mono text-[13px] font-semibold text-[#A1A1AA] tracking-[2px]">// Méthode</span>
      <h2 class="text-[32px] lg:text-[40px] font-extrabold text-white leading-[1.1] tracking-[-1px] max-w-[800px] text-center">
        Un process clair, des résultats concrets
      </h2>
      <p class="text-[18px] text-[#71717A] font-normal leading-[1.5] max-w-[700px] text-center">
        De l'analyse initiale à la mise en production, chaque étape est pensée pour maximiser votre ROI et minimiser les frictions.
      </p>
    </div>

    <!-- Method Cards -->
    <div class="grid md:grid-cols-3 gap-6 w-full">
      {phases.map((phase) => (
        <div class="bg-[#27272A] rounded-xl p-8 flex flex-col gap-5 border-t-[3px] border-white">
          <span class="font-mono text-5xl font-bold text-white opacity-20">{phase.number}</span>
          <h3 class="text-2xl font-extrabold text-white">{phase.title}</h3>
          <p class="text-[15px] text-[#A1A1AA] font-normal leading-[1.6]">{phase.description}</p>
          <span class="inline-flex self-start font-mono text-xs text-[#A1A1AA] bg-white/10 px-3 py-1.5 rounded-full">
            {phase.duration}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
