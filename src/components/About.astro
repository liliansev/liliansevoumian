---
import { Image } from 'astro:assets';
import lilianPortrait from '../assets/profile-linkedin-lilian.jpeg';

const tools = [
  { name: "Make" },
  { name: "n8n" },
  { name: "Claude" },
  { name: "Notion" },
  { name: "Airtable" },
];
---

<div id="expertise" class="flex flex-col items-center gap-12 fade-in-section">
  <!-- Section badge -->
  <div class="flex flex-col items-center">
    <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[#E86A33]">
      QUI SUIS-JE
    </span>
  </div>

  <!-- About card: photo + text -->
  <div id="a-propos" class="flex flex-col md:flex-row items-center gap-8 md:gap-[40px] w-full">
    <!-- Photo -->
    <div class="shrink-0">
      <Image
        src={lilianPortrait}
        alt="Lilian Sevoumian"
        width={280}
        height={280}
        class="w-[180px] h-[180px] md:w-[240px] md:h-[240px] rounded-[var(--radius-lg)] object-cover shadow-lg"
        loading="lazy"
      />
    </div>

    <!-- Text content — dark text for light bg -->
    <div class="flex flex-col text-center md:text-left flex-1">
      <h3 class="font-display font-bold text-[#1A1A1A] text-[length:var(--text-heading)] mb-1">
        Lilian Sevoumian
      </h3>
      <p class="font-body text-[length:var(--text-body-lg)] text-[#666666] mb-3">
        Expert en automatisations & intelligence artificielle
      </p>
      <!-- Social links — monochrome charcoal -->
      <div class="flex items-center justify-center md:justify-start gap-3 mt-1">
        <a href="https://www.linkedin.com/in/liliansevoumian/" target="_blank" rel="noopener noreferrer"
           class="w-9 h-9 rounded-[var(--radius-sm)] flex items-center justify-center pill-hover"
           style="background: rgba(26, 26, 26, 0.06); border: 1.5px solid rgba(26, 26, 26, 0.15);"
           aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D3D3D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="https://www.youtube.com/@lilian.sevoumian" target="_blank" rel="noopener noreferrer"
           class="w-9 h-9 rounded-[var(--radius-sm)] flex items-center justify-center pill-hover"
           style="background: rgba(26, 26, 26, 0.06); border: 1.5px solid rgba(26, 26, 26, 0.15);"
           aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D3D3D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
        </a>
        <a href="https://liliansevoumian.substack.com/" target="_blank" rel="noopener noreferrer"
           class="w-9 h-9 rounded-[var(--radius-sm)] flex items-center justify-center pill-hover"
           style="background: rgba(26, 26, 26, 0.06); border: 1.5px solid rgba(26, 26, 26, 0.15);"
           aria-label="Substack">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D3D3D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16"/><path d="M4 8h16"/><path d="m4 12 8 6 8-6"/></svg>
        </a>
      </div>
      <p class="font-body text-[length:var(--text-body)] leading-[1.6] text-[var(--color-text-secondary)] mb-3">
        Ça fait 5&nbsp;ans que je fais ça. Avant, <strong class="text-[var(--color-text-primary)]">j'étais dans l'opérationnel</strong> — j'ai monté ma boîte, géré des salariés, passé mes soirées sur des tâches qu'un scénario Make règle en 10&nbsp;secondes. Je connais vos enjeux parce que je les ai vécus.
      </p>
      <p class="font-body text-[length:var(--text-body)] leading-[1.6] text-[var(--color-text-secondary)] mb-3">
        Je ne commence jamais par l'outil. <strong class="text-[var(--color-text-primary)]">Je commence par comprendre comment votre boîte tourne</strong>, où ça coince, ce qui vous coûte du temps. Ensuite seulement, je construis.
      </p>
      <p class="font-body text-[length:var(--text-body)] leading-[1.6] text-[var(--color-text-secondary)] mb-5">
        <strong class="text-[var(--color-text-primary)]">Premier Français certifié Make niveau&nbsp;5</strong>, partenaire officiel. 500+&nbsp;automatisations livrées. Je ne suis pas un généraliste qui "fait aussi de l'automatisation" — c'est mon seul métier.
      </p>

      <!-- Certifications — monochrome charcoal -->
      <div class="flex flex-wrap justify-center md:justify-start gap-3 mb-3">
        <span class="inline-block rounded-[var(--radius-sm)] px-4 py-2 font-mono text-[length:var(--text-body-sm)] font-semibold pill-hover" style="color: #2A2520; background: rgba(42, 37, 32, 0.06); border: 2px solid rgba(42, 37, 32, 0.18);">
          Make Partner Officiel
        </span>
        <span class="inline-block rounded-[var(--radius-sm)] px-4 py-2 font-mono text-[length:var(--text-body-sm)] font-semibold pill-hover" style="color: #2A2520; background: rgba(42, 37, 32, 0.06); border: 2px solid rgba(42, 37, 32, 0.18);">
          Certification Make Niveau 5
        </span>
      </div>

      <!-- Tool pills — monochrome charcoal -->
      <div class="flex flex-wrap justify-center md:justify-start gap-2 mt-2">
        {tools.map((tool) => (
          <span
            class="font-mono text-[length:var(--text-caption)] font-semibold rounded-[var(--radius-sm)] px-3 py-1.5 pill-hover"
            style="color: #5A554D; background: rgba(42, 37, 32, 0.04); border: 1.5px solid rgba(42, 37, 32, 0.12);"
          >
            {tool.name}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>
