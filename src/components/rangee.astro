---
/*
 * rangee : une rangée de l'accueil, dans la DA des métiers (`home-services`).
 *
 * Le texte d'un côté, un panneau de l'autre, posé dans un cadre à repères
 * d'angle ; un filet traverse la colonne au-dessus de la rangée, une croix
 * marque son départ. `miroir` inverse les côtés. Le panneau reprend celui des
 * scènes : une lueur braise en bas à gauche, une lueur froide en haut à
 * droite, un quadrillage fin.
 *
 * Lilian a rejeté le 14 octobre 2026 la version en cartes de l'accueil
 * personnel (« le design d'avant on avait une vraie DA ») : les sections de
 * l'accueil personnel reprennent cette charpente.
 */
interface Props {
  id?: string;
  miroir?: boolean;
  /** Proportion du panneau. */
  ratio?: string;
}

const { id, miroir = false, ratio = '4 / 3' } = Astro.props;
---

<article id={id} class:list={['rangee', { 'rangee--miroir': miroir }]}>
  <div class="rangee__texte reveal">
    <slot />
  </div>
  <div class="rangee__visuel reveal">
    <span class="rangee__repere rangee__repere--hg" aria-hidden="true"></span>
    <span class="rangee__repere rangee__repere--hd" aria-hidden="true"></span>
    <span class="rangee__repere rangee__repere--bg" aria-hidden="true"></span>
    <span class="rangee__repere rangee__repere--bd" aria-hidden="true"></span>
    <div class="rangee__cadre panneau" style={`aspect-ratio: ${ratio}`}>
      <slot name="visuel" />
    </div>
  </div>
</article>

<style>
  .rangee {
    --trait: color-mix(in srgb, var(--color-ink) 9%, transparent);
    --marge: var(--spacing-cadre);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: var(--spacing-gouttiere);
    padding-block: var(--spacing-bloc);
  }

  .rangee::before {
    content: '';
    position: absolute;
    top: 0;
    right: calc(-1 * var(--marge));
    left: calc(-1 * var(--marge));
    height: 1px;
    background: var(--trait);
  }

  .rangee::after {
    content: '';
    position: absolute;
    top: -5px;
    left: calc(-1 * var(--marge) - 5px);
    width: 11px;
    height: 11px;
    background:
      linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 100% 1px no-repeat,
      linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 1px 100% no-repeat;
  }

  .rangee--miroir { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
  .rangee--miroir .rangee__texte { order: 2; }
  .rangee--miroir .rangee__visuel { order: 1; }

  .rangee__texte {
    display: grid;
    justify-items: start;
    align-content: start;
    min-width: 0;
  }

  .rangee__visuel {
    position: relative;
    min-width: 0;
  }

  .rangee__cadre {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-md);
  }

  .rangee__repere {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--color-ink-low);
    pointer-events: none;
  }

  .rangee__repere--hg { top: -7px; left: -7px; border-top-width: 1px; border-left-width: 1px; }
  .rangee__repere--hd { top: -7px; right: -7px; border-top-width: 1px; border-right-width: 1px; }
  .rangee__repere--bg { bottom: -7px; left: -7px; border-bottom-width: 1px; border-left-width: 1px; }
  .rangee__repere--bd { right: -7px; bottom: -7px; border-right-width: 1px; border-bottom-width: 1px; }

  @media (max-width: 1023px) {
    .rangee,
    .rangee--miroir {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-groupe);
    }

    .rangee__visuel,
    .rangee--miroir .rangee__visuel { order: 1; }

    .rangee__texte,
    .rangee--miroir .rangee__texte { order: 2; }
  }
</style>
