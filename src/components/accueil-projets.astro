---
/*
 * accueil-projets : ce sur quoi Lilian travaille en ce moment
 * (`data/projets.ts`, `enCours`).
 *
 * Une rangée par projet, dans la DA des métiers (`rangee.astro`) : le texte
 * d'un côté, la page d'accueil du projet de l'autre, posée dans une fenêtre
 * de navigateur sur le panneau des scènes. Les côtés alternent.
 *
 * Deux versions ont été écartées le 14 octobre 2026 : un texte dans un cadre
 * (« trop basique »), puis des cartes à capture (« le design d'avant on avait
 * une vraie DA »).
 */
import { Icon } from 'astro-icon/components';
import Rangee from './rangee.astro';
import type { Projet } from '../data/projets';

interface Props {
  id: string;
  titre: string;
  chapo?: string;
  projets: Projet[];
  /** Source DataFast des clics sortants. */
  source: string;
}

const { id, titre, chapo, projets, source } = Astro.props;

const goals: Record<string, string> = {
  'https://agenceafk.fr': 'outbound_agence',
  'https://augmentes.fr': 'outbound_formations',
};
const domaine = (href: string) => href.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<section id={id} data-section class="accueil-section px-[var(--spacing-section-x)]">
  <div class="relative mx-auto max-w-[1200px]">
    <header class="accueil-tete reveal">
      <h2>{titre}</h2>
      {chapo && <p>{chapo}</p>}
    </header>

    {projets.map((p, i) => (
      <Rangee miroir={i % 2 === 1}>
        <h3>{p.etiquette}</h3>
        <p class="rangee-phrase">{p.nom}</p>
        <p class="rangee-corps">{p.resume}</p>
        {p.tags && (
          <ul class="rangee-tags">
            {p.tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
        {p.href && (
          <a
            class="rangee-suite projet__lien"
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            data-fast-goal={goals[p.href]}
            data-fast-goal-source={goals[p.href] ? source : undefined}
          >
            {domaine(p.href)}
            <Icon name="lucide:arrow-up-right" size={16} aria-hidden="true" />
            <span class="sr-only"> (nouvel onglet)</span>
          </a>
        )}

        {p.image && p.href && (
          <div slot="visuel" class="projet__scene" aria-hidden="true">
            <div class="projet__fenetre">
              <div class="projet__barre">
                <span class="projet__points"><i></i><i></i><i></i></span>
                <span class="projet__adresse">{domaine(p.href)}</span>
              </div>
              <img src={p.image} alt="" width="1280" height="800" loading="lazy" decoding="async" />
            </div>
          </div>
        )}
      </Rangee>
    ))}
  </div>
</section>

<style>
  .projet__lien {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .projet__lien:hover {
    color: var(--color-accent-text);
  }

  /* La fenêtre part du coin haut gauche du panneau et sort par le bas et par
     la droite : on voit une page posée sur le plan, pas une vignette. */
  .projet__scene {
    position: absolute;
    inset: 0;
    padding: 9% 0 0 9%;
  }

  .projet__fenetre {
    height: 100%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-right: 0;
    border-bottom: 0;
    border-radius: var(--radius-md) 0 0 0;
    background: var(--color-night-deep);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
  }

  .projet__barre {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .projet__points {
    display: flex;
    gap: 0.3rem;
  }

  .projet__points i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .projet__adresse {
    padding: 0.1rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    color: var(--color-ink-low);
    font-size: 0.7rem;
  }

  .projet__fenetre img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
