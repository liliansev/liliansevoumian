---
/*
 * accueil-projets : une liste de projets : ce sur quoi Lilian travaille en ce
 * moment, ou ce qu'il a construit pour lui. Les deux sections de l'accueil
 * qui l'utilisent lisent `data/projets.ts`.
 *
 * Des cartes sobres, sans mouvement : un nom, une étiquette, une phrase, et
 * la capture quand il y en a une. Une carte avec un lien est un lien entier.
 * En développement, une entrée `provisoire` porte un liseré pointillé : son
 * texte attend Lilian.
 */
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import type { Projet } from '../data/projets';

interface Props {
  id: string;
  titre: string;
  chapo?: string;
  projets: Projet[];
  /** Source DataFast des clics sortants. */
  source: string;
}

const { id, titre, chapo, projets, source } = Astro.props;
const dev = import.meta.env.DEV;

const goals: Record<string, string> = {
  'https://agenceafk.fr': 'outbound_agence',
  'https://augmentes.fr': 'outbound_formations',
};
---

<section id={id} data-section class="px-[var(--spacing-section-x)] py-[var(--spacing-section-y)] border-b border-[var(--color-divider)]">
  <div class="mx-auto max-w-[1200px]">
    <SectionHeader title={titre} body={chapo} />
    <ul class:list={['projets', { 'projets--pair': projets.length % 2 === 0 }]}>
      {projets.map((p) => {
        const Balise = p.href ? 'a' : 'div';
        const externe = p.href?.startsWith('http');
        return (
          <li class:list={['projet', { 'projet--provisoire': dev && p.provisoire }]}>
            <Balise
              class="projet__carte"
              href={p.href}
              target={externe ? '_blank' : undefined}
              rel={externe ? 'noopener noreferrer' : undefined}
              data-fast-goal={p.href ? goals[p.href] : undefined}
              data-fast-goal-source={p.href && goals[p.href] ? source : undefined}
            >
              {p.image && (
                <img src={p.image} alt="" width="1280" height="800" loading="lazy" decoding="async" class="projet__image" />
              )}
              <div class="projet__texte">
                {p.etiquette && <p class="projet__etiquette">{p.etiquette}</p>}
                <h3 class="projet__nom">
                  {p.nom}
                  {p.href && <Icon name="lucide:arrow-up-right" size={18} aria-hidden="true" class="projet__fleche" />}
                  {externe && <span class="sr-only"> (nouvel onglet)</span>}
                </h3>
                <p class="projet__resume">{p.resume}</p>
              </div>
            </Balise>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .projets {
    display: grid;
    gap: var(--spacing-lie);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .projets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Quatre cartes tiennent en deux rangées de deux, sans orpheline. */
  @media (min-width: 1024px) {
    .projets:not(.projets--pair) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .projet {
    max-width: none;
  }

  .projet__carte {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-service-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-low);
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  a.projet__carte:hover {
    border-color: var(--color-border-strong);
  }

  a.projet__carte:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .projet__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--color-service-border);
  }

  .projet__texte {
    display: grid;
    gap: var(--spacing-colle);
    padding: var(--spacing-panneau);
  }

  .projet__etiquette {
    margin: 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .projet__nom {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    font-size: var(--text-title);
    color: var(--color-ink);
  }

  .projet__fleche {
    color: var(--color-ink-low);
  }

  .projet__resume {
    margin: 0;
    color: var(--color-ink-mid);
  }

  .projet--provisoire .projet__carte {
    border-style: dashed;
  }
</style>
