---
const companies = ["Qonto", "Jellysmack", "Digital Campus", "Edumiam", "Rocket School", "Contournement", "KlaK", "Digilytix", "WeTechCare"];
---

<section class="bg-[var(--bg-dark)] py-8 fade-in-section">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="font-mono text-xs font-semibold text-[var(--text-muted)] tracking-[2px] uppercase mb-6">
      Ils m'ont fait confiance
    </p>
    <div class="flex items-center justify-center flex-wrap gap-y-3">
      {companies.map((name, i) => (
        <span class="flex items-center">
          <span class="font-mono text-sm font-semibold text-[var(--text-muted)] tracking-[1px]">
            {name}
          </span>
          {i < companies.length - 1 && (
            <span class="mx-4 w-1.5 h-1.5 rounded-full bg-[var(--accent)] opacity-60 inline-block shrink-0" />
          )}
        </span>
      ))}
    </div>
  </div>
</section>
