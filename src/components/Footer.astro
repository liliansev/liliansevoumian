---
import { Icon } from 'astro-icon/components';
import BoutonReservation from './BoutonReservation.astro';
import { LIBELLE_CONTACT_RESERVATION } from '../lib/reservation';
import { audience, organisations } from '../data/parcours';

const year = new Date().getFullYear();

interface Props {
  /** Uniquement pour les pages sans bloc de contact final. */
  showContact?: boolean;
}

const { showContact = false } = Astro.props;

interface Channel {
  label: string;
  metric: string;
  href: string;
  icon: string;
  /** Couleur officielle de la plateforme, au survol. Absente pour un canal
      tenu sur le site lui-même : il prend alors l'accent. */
  color?: string;
}

interface NavLink {
  label: string;
  href: string;
  /** Sortie vers un autre site : nouvel onglet, flèche, objectif mesuré. */
  goal?: string;
}

interface NavColumn {
  title: string;
  links: NavLink[];
}

const channels: Channel[] = [
  // Le bleu LinkedIn pour fond sombre (#70B5F9), pas le #0A66C2 des fonds clairs :
  // sur la nuit profonde du footer, le bleu de base tient 3,29:1 et le libellé
  // s'effaçait au survol. La variante sombre est officielle et tient 8,62:1.
  { label: "LinkedIn", metric: audience.linkedin.affiche, href: "https://www.linkedin.com/in/liliansevoumian/", icon: "lucide:linkedin", color: "#70B5F9" },
  { label: "YouTube", metric: "Tutos et cas concrets", href: "https://www.youtube.com/@lilian.sevoumian", icon: "lucide:youtube", color: "#FF0000" },
  // La newsletter de référence est celle du formulaire de la home (Lumail), pas
  // l'ancien Substack : le lien ramène donc à l'inscription, sur le site.
  { label: "Newsletter", metric: "Automatisations · hebdo", href: "/#newsletter", icon: "lucide:mail" },
];

const navColumns: NavColumn[] = [
  {
    title: "Navigation",
    /* Même ordre que la barre de nav et que le défilement de la home. Le pied
       a de la place là où la barre n'en a pas : les deux sections neuves y
       figurent sous leur nom entier, et le calculateur y reste — il a quitté la
       barre parce qu'il n'est plus une destination, pas parce qu'il devrait
       cesser d'être atteignable. */
    links: [
      { label: "Parcours", href: "/#parcours" },
      { label: "Cas clients", href: "/cas-clients" },
      { label: "Automatisation et agents IA", href: "/automatisations-ia" },
      { label: "Sites web et dashboards", href: "/sites-web-abonnement" },
    ],
  },
  {
    /* Les deux structures de Lilian. Le site est le point de référence sur lui :
       ce qu'il a fondé doit s'y retrouver depuis n'importe quelle page. */
    title: "Mes activités",
    links: organisations.map((organisation) => ({
      label: organisation.nom,
      href: organisation.url,
      goal: organisation.goal,
    })),
  },
  {
    title: "Expertise",
    links: [
      { label: "Expert Make", href: "/expert-make" },
      { label: "Expert n8n", href: "/expert-n8n" },
      { label: "Automatisation en panne", href: "/reprendre-une-automatisation-qui-casse" },
    ],
  },
  {
    title: "Lecture",
    links: [
      /* Les trois pages-réponses : elles n'ont pas d'entrée dans la barre,
         c'est ici qu'on les retrouve depuis n'importe quelle page. */
      { label: "Make ou n8n ?", href: "/make-ou-n8n" },
      { label: "Combien coûte une automatisation ?", href: "/combien-coute-une-automatisation" },
      { label: "Agent IA pour PME", href: "/agent-ia-pour-pme" },
      { label: "Principes", href: "/principes" },
      { label: "Mentions légales", href: "/mentions-legales" },
    ],
  },
];

---

<footer class="relative bg-[var(--color-night-deep)] border-t border-[var(--color-divider)] px-[var(--spacing-section-x)]">
  <div class="relative max-w-[1200px] mx-auto py-10 md:py-20">

    <!-- Top: brand + content channels -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 md:gap-16 pb-6 md:pb-12 border-b border-[var(--color-divider)]">
      <div>
        <div class="flex items-center gap-2.5 mb-3 md:mb-5 text-[var(--color-ink)]">
          <span class="mono-label">Lilian Sevoumian</span>
        </div>
        <p class="text-[var(--color-ink-mid)] max-w-md">
          Freelance depuis 2020, fondateur d’agenceafk et d’Augmentés. Je construis, je forme, je publie.
        </p>
        {showContact && (
          <BoutonReservation source="footer" class="btn-primary justify-center mt-6 w-full sm:w-auto">
            {LIBELLE_CONTACT_RESERVATION}
          </BoutonReservation>
        )}
      </div>

      <div>
        <div class="mono-caption text-[var(--color-ink-low)] mb-1 md:mb-4">Contenu</div>
        <ul class="md:space-y-2">
          {channels.map((ch) => {
            const externe = ch.href.startsWith('http');
            return (
            <li>
              <a
                href={ch.href}
                target={externe ? '_blank' : undefined}
                rel={externe ? 'noopener noreferrer' : undefined}
                style={ch.color ? `--chan:${ch.color}` : undefined}
                class="channel-link group inline-flex items-center gap-2.5 text-[var(--color-ink)] transition-colors min-h-[44px] py-2"
              >
                <Icon name={ch.icon} class="channel-ic size-4 text-[var(--color-ink-mid)] shrink-0" aria-hidden="true" />
                <span class="mono-label">{ch.label}</span>
                <span class="mono-caption text-[var(--color-ink-low)]">{ch.metric}</span>
                {externe && <span class="sr-only">(nouvel onglet)</span>}
                <Icon name={externe ? 'lucide:arrow-up-right' : 'lucide:arrow-right'} class="size-3.5 shrink-0 opacity-40 group-hover:opacity-100 transition-opacity" aria-hidden="true" />
              </a>
            </li>
            );
          })}
        </ul>
      </div>
    </div>

    <!-- Middle: nav columns -->
    <!--
      Les liens de ces colonnes faisaient déjà 44 px de haut — la règle
      d'élément `footer a` de global.css les passe en inline-flex avec un
      plancher de hauteur — mais 26 à 40 px de large seulement : « FAQ » 26,
      « Outils » 37, « Calcul » et « Offres » 40. Une cible de 26 × 44 rate le
      plancher de 44 × 44 dans la dimension la plus étroite, et ce sont
      justement les libellés les plus courts, donc les plus difficiles à viser.
      Le plancher de largeur suffit à le corriger : les ancres sont déjà des
      boîtes inline-flex, la zone gagnée se pose à droite du mot, sans fond, sans
      décalage du texte et sans toucher à la grille — mesuré, aucune colonne ne
      descend sous 80 px, même à 375 px de fenêtre.
    -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-5 md:gap-12 py-6 md:py-12">
      {navColumns.map((col) => (
        <div>
          <div class="mono-caption text-[var(--color-ink-low)] mb-1 md:mb-4">{col.title}</div>
          <ul class="md:space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.goal ? '_blank' : undefined}
                  rel={link.goal ? 'noopener noreferrer' : undefined}
                  data-fast-goal={link.goal}
                  data-fast-goal-source={link.goal ? 'footer' : undefined}
                  class="min-w-[44px] gap-1.5 text-[var(--color-ink-mid)] hover:text-[var(--color-ink)] transition-colors text-[length:var(--text-body-sm)] break-words"
                >
                  {link.label}
                  {link.goal && <Icon name="lucide:arrow-up-right" class="size-3.5 shrink-0" aria-hidden="true" />}
                  {link.goal && <span class="sr-only"> (nouvel onglet)</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom: legal -->
    <div class="pt-5 md:pt-8 border-t border-[var(--color-divider)]">
      <p class="mono-caption text-[var(--color-ink-low)]">
        © {year} · Lilian Sevoumian · Tous droits réservés
      </p>
    </div>
  </div>
</footer>

<style>
  /* Canaux : au survol, le lien + son icône prennent la couleur officielle de la
     plateforme (--chan). Focus clavier inclus. */
  .channel-link:hover,
  .channel-link:focus-visible {
    color: var(--chan, var(--color-accent));
  }
  .channel-link:hover .channel-ic,
  .channel-link:focus-visible .channel-ic {
    color: var(--chan, var(--color-accent));
  }
</style>
