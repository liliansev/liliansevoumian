---
const navLinks = [
  { label: "Expertise", href: "/#expertise" },
  { label: "Méthode", href: "/#methode" },
  { label: "Témoignages", href: "/#temoignages" },
  { label: "FAQ", href: "/#faq" },
];

const socialLinks = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/liliansevoumian/", color: "#E86A33" },
  { label: "YouTube", href: "https://www.youtube.com/@lilian.sevoumian", color: "#9333EA" },
  { label: "Substack", href: "https://liliansevoumian.substack.com/", color: "#22D3EE" },
];
---

<!-- Footer — dark -->
<footer class="bg-[var(--color-bg-dark)]">
  <!-- Separator -->
  <div class="h-[3px] bg-[#333333]" aria-hidden="true"></div>

  <!-- Main footer bar — 3-column horizontal -->
  <div class="py-[40px] px-[var(--spacing-section-x)]">
    <div class="max-w-[1200px] mx-auto flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
      <!-- Left column: Name + Desc -->
      <div class="flex flex-col gap-2">
        <span class="font-display text-[18px] font-bold text-white">Lilian Sevoumian</span>
        <p class="font-body text-[13px] text-[#888888] leading-[1.6]">
          J'automatise les opérations des PME avec Make, n8n et l'IA.
        </p>
      </div>

      <!-- Center column: Nav links — horizontal -->
      <div class="flex flex-wrap items-center gap-6">
        {navLinks.map((link) => (
          <a href={link.href} class="font-body text-[13px] font-medium text-[#AAAAAA] hover:text-white transition-colors duration-200 min-h-[44px] flex items-center">{link.label}</a>
        ))}
      </div>

      <!-- Right column: Social links — colored -->
      <div class="flex items-center gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[12px] font-medium hover:opacity-80 transition-opacity duration-200 min-h-[44px] flex items-center"
            style={`color: ${link.color}`}
          >{link.label}</a>
        ))}
      </div>
    </div>
  </div>

  <!-- Copyright bar -->
  <div class="bg-[var(--color-bg-dark-alt)] py-[20px] px-[var(--spacing-section-x)]">
    <div class="max-w-[1200px] mx-auto flex items-center justify-center gap-4">
      <span class="font-body text-[12px] text-[#666666]">&copy; 2026 Lilian Sevoumian. Tous droits r&eacute;serv&eacute;s.</span>
      <a href="/mentions-legales" class="font-body text-[12px] text-[#666666] hover:text-white transition-colors duration-200">Mentions l&eacute;gales</a>
    </div>
  </div>
</footer>
