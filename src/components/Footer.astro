---
import { Icon } from 'astro-icon/components';
import BoutonReservation from './BoutonReservation.astro';
import { LIBELLE_CONTACT_RESERVATION } from '../lib/reservation';

const year = new Date().getFullYear();

interface Props {
  /** Uniquement pour les pages sans bloc de contact final. */
  showContact?: boolean;
}

const { showContact = false } = Astro.props;

interface Channel {
  label: string;
  metric: string;
  href: string;
  icon: string;
  color: string; // couleur officielle de la plateforme (hover)
}

interface NavLink {
  label: string;
  href: string;
}

interface NavColumn {
  title: string;
  links: NavLink[];
}

const channels: Channel[] = [
  // Le bleu LinkedIn pour fond sombre (#70B5F9), pas le #0A66C2 des fonds clairs :
  // sur l'encre du footer, le bleu de base tient 3,32:1 et le libellé s'effaçait
  // au survol. La variante sombre est officielle et tient 8,7:1.
  { label: "LinkedIn", metric: "11 K+ ABONNÉS", href: "https://www.linkedin.com/in/liliansevoumian/", icon: "lucide:linkedin", color: "#70B5F9" },
  { label: "YouTube", metric: "120+ VIDÉOS", href: "https://www.youtube.com/@lilian.sevoumian", icon: "lucide:youtube", color: "#FF0000" },
  { label: "Newsletter", metric: "AUTOMATISATIONS · HEBDO", href: "https://liliansevoumian.substack.com/", icon: "lucide:mail", color: "#FF6719" },
];

const navColumns: NavColumn[] = [
  {
    title: "NAVIGATION",
    /* Même ordre que la barre de nav et que le défilement de la home. Le pied
       a de la place là où la barre n'en a pas : les deux sections neuves y
       figurent sous leur nom entier, et le calculateur y reste — il a quitté la
       barre parce qu'il n'est plus une destination, pas parce qu'il devrait
       cesser d'être atteignable. */
    links: [
      { label: "Automatisation & IA", href: "/automatisations-ia" },
      { label: "Sites & applications web", href: "/sites-web-abonnement" },
      { label: "Cas clients", href: "/cas-clients" },
      { label: "Principes", href: "/principes" },
      { label: "À propos", href: "/#qui-je-suis" },
    ],
  },
  {
    title: "EXPERTISE",
    links: [
      { label: "Expert Make", href: "/expert-make" },
      { label: "Expert n8n", href: "/expert-n8n" },
      { label: "Automatisation en panne", href: "/reprendre-une-automatisation-qui-casse" },
    ],
  },
  {
    title: "LECTURE",
    links: [
      { label: "Principes", href: "/principes" },
      { label: "Mentions légales", href: "/mentions-legales" },
    ],
  },
];

---

<footer class="bloc-encre relative bg-[var(--color-paper)] border-t border-[var(--color-divider)] px-[var(--spacing-section-x)]">
  <div class="relative max-w-[1200px] mx-auto py-16 md:py-20">

    <!-- Top: brand + content channels -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-10 md:gap-16 pb-12 border-b border-[var(--color-divider)]">
      <div>
        <div class="flex items-center gap-2.5 mb-5 text-[var(--color-ink)]">
          <span class="mono-label">LILIAN SEVOUMIAN</span>
        </div>
        <p class="text-[var(--color-ink-mid)] max-w-md">
          Automatisation, agents IA, sites et applications web. Du cadrage au développement, un seul interlocuteur.
        </p>
        {showContact && (
          <BoutonReservation source="footer" class="btn-primary justify-center mt-6 w-full sm:w-auto">
            {LIBELLE_CONTACT_RESERVATION}
          </BoutonReservation>
        )}
      </div>

      <div>
        <div class="mono-caption text-[var(--color-ink-low)] mb-4">CONTENU</div>
        <ul class="space-y-2">
          {channels.map((ch) => (
            <li>
              <a
                href={ch.href}
                target="_blank"
                rel="noopener noreferrer"
                style={`--chan:${ch.color}`}
                class="channel-link group inline-flex items-center gap-2.5 text-[var(--color-ink)] transition-colors min-h-[44px] py-2"
              >
                <Icon name={ch.icon} class="channel-ic size-4 text-[var(--color-ink-mid)] shrink-0" aria-hidden="true" />
                <span class="mono-label">{ch.label}</span>
                <span class="mono-caption text-[var(--color-ink-low)]">{ch.metric}</span>
                <span class="mono-label opacity-40 group-hover:opacity-100 transition-opacity">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Middle: nav columns -->
    <!--
      Les liens de ces colonnes faisaient déjà 44 px de haut — la règle
      d'élément `footer a` de global.css les passe en inline-flex avec un
      plancher de hauteur — mais 26 à 40 px de large seulement : « FAQ » 26,
      « Outils » 37, « Calcul » et « Offres » 40. Une cible de 26 × 44 rate le
      plancher de 44 × 44 dans la dimension la plus étroite, et ce sont
      justement les libellés les plus courts, donc les plus difficiles à viser.
      Le plancher de largeur suffit à le corriger : les ancres sont déjà des
      boîtes inline-flex, la zone gagnée se pose à droite du mot, sans fond, sans
      décalage du texte et sans toucher à la grille — mesuré, aucune colonne ne
      descend sous 80 px, même à 375 px de fenêtre.
    -->
    <div class="grid grid-cols-2 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)] gap-8 md:gap-12 py-12">
      {navColumns.map((col) => (
        <div>
          <div class="mono-caption text-[var(--color-ink-low)] mb-4">{col.title}</div>
          <ul class="space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="min-w-[44px] text-[var(--color-ink-mid)] hover:text-[var(--color-ink)] transition-colors text-[length:var(--text-body-sm)] break-words"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom: legal -->
    <div class="pt-8 border-t border-[var(--color-divider)]">
      <p class="mono-caption text-[var(--color-ink-low)]">
        © {year} · LILIAN SEVOUMIAN · TOUS DROITS RÉSERVÉS
      </p>
    </div>
  </div>
</footer>

<style>
  /* Canaux : au survol, le lien + son icône prennent la couleur officielle de la
     plateforme (--chan). Focus clavier inclus. */
  .channel-link:hover,
  .channel-link:focus-visible {
    color: var(--chan, var(--color-accent));
  }
  .channel-link:hover .channel-ic,
  .channel-link:focus-visible .channel-ic {
    color: var(--chan, var(--color-accent));
  }
</style>
