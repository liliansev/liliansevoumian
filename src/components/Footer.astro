---
import Pied from './carnet/pied.astro';

interface Props {
  /** Uniquement pour les pages sans bloc de contact final. */
  showContact?: boolean;
  /** Hérité du pied « nuit et pêche » : le pied du carnet ne porte aucune date. */
  sansDate?: boolean;
}

/* Le pied des pages intérieures est celui de l'accueil « Le carnet »
   (`carnet/pied.astro`) depuis le 28 octobre 2026 : le nom en très grand,
   puis ce que Lilian publie et les pages du site. */
const { showContact = false } = Astro.props;
---

<Pied surAccueil={false} source="pied" contact={showContact} />
