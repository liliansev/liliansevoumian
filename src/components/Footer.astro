---
const year = new Date().getFullYear();

interface Channel {
  label: string;
  metric: string;
  href: string;
}

interface NavLink {
  label: string;
  href: string;
  external?: boolean;
  goal?: string;
  goalSource?: string;
}

interface NavColumn {
  title: string;
  links: NavLink[];
}

const channels: Channel[] = [
  { label: "LinkedIn", metric: "11 K+ ABONNÉS", href: "https://www.linkedin.com/in/liliansevoumian/" },
  { label: "YouTube", metric: "120+ VIDÉOS", href: "https://www.youtube.com/@lilian.sevoumian" },
  { label: "Newsletter", metric: "AUTOMATISATIONS · HEBDO", href: "https://liliansevoumian.substack.com/" },
];

const navColumns: NavColumn[] = [
  {
    title: "NAVIGATION",
    links: [
      { label: "ROI", href: "#roi" },
      { label: "Cas clients", href: "#cas" },
      { label: "Stack", href: "#stack" },
      { label: "Offres", href: "#offres" },
      { label: "FAQ", href: "#faq" },
    ],
  },
  {
    title: "EXPERTISE",
    links: [
      { label: "Expert Make", href: "/expert-make" },
      { label: "Expert n8n", href: "/expert-n8n" },
    ],
  },
  {
    title: "CONTACT",
    links: [
      { label: "Réserver", href: "https://cal.com/lilian-sevoumian/20min", external: true, goal: "lead_call", goalSource: "footer" },
      { label: "bonjour@liliansevoumian.fr", href: "mailto:bonjour@liliansevoumian.fr" },
    ],
  },
  {
    title: "LECTURE",
    links: [
      { label: "Principes", href: "/principes" },
      { label: "Mentions légales", href: "/mentions-legales" },
    ],
  },
];

// Ancres home-relatives : préfixées par '/' hors de la home.
const prefix = Astro.url.pathname === '/' ? '' : '/';
---

<footer class="relative bg-[var(--color-paper)] border-t border-[var(--color-divider)] px-[var(--spacing-section-x)]">
  <div class="relative max-w-[1200px] mx-auto py-16 md:py-20">

    <!-- Top: brand + content channels -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-10 md:gap-16 pb-12 border-b border-[var(--color-divider)]">
      <div>
        <div class="flex items-center gap-2.5 mb-5 text-[var(--color-ink)]">
          <span class="mono-label">LILIAN SEVOUMIAN</span>
        </div>
        <p class="text-[var(--color-ink-mid)] max-w-md">
          Expert no-code freelance. Automatisations Make, n8n, Airtable + IA pour Heads of Ops, fondateurs et PME.
        </p>
      </div>

      <div>
        <div class="mono-caption text-[var(--color-ink-low)] mb-4">CONTENU</div>
        <ul class="space-y-2">
          {channels.map((ch) => (
            <li>
              <a
                href={ch.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-baseline gap-3 text-[var(--color-ink)] hover:text-[var(--color-violet-deep)] transition-colors min-h-[44px] py-2"
              >
                <span class="mono-label">{ch.label}</span>
                <span class="mono-caption text-[var(--color-ink-low)]">{ch.metric}</span>
                <span class="mono-label opacity-40 group-hover:opacity-100 transition-opacity">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Middle: nav columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 py-12">
      {navColumns.map((col) => (
        <div>
          <div class="mono-caption text-[var(--color-ink-low)] mb-4">{col.title}</div>
          <ul class="space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href.startsWith('#') ? `${prefix}${link.href}` : link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  data-fast-goal={link.goal}
                  data-fast-goal-source={link.goalSource}
                  class="text-[var(--color-ink-mid)] hover:text-[var(--color-ink)] transition-colors text-[length:var(--text-body-sm)] break-all"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom: legal -->
    <div class="pt-8 border-t border-[var(--color-divider)]">
      <p class="mono-caption text-[var(--color-ink-low)]">
        © {year} · LILIAN SEVOUMIAN · TOUS DROITS RÉSERVÉS
      </p>
    </div>
  </div>
</footer>
