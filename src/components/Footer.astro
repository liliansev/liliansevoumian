---
const navLinks = [
  { label: "Expertise", href: "/#expertise" },
  { label: "Méthode", href: "/#methode" },
  { label: "Témoignages", href: "/#temoignages" },
  { label: "FAQ", href: "/#faq" },
];

const socialLinks = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/liliansevoumian/" },
  { label: "YouTube", href: "https://www.youtube.com/@lilian.sevoumian" },
  { label: "Substack", href: "https://liliansevoumian.substack.com/" },
];

const legalLinks = [
  { label: "Mentions légales", href: "/mentions-legales" },
];
---

<!-- Footer -->
<footer class="bg-[#000000]">
  <!-- Gradient divider -->
  <div class="h-px bg-gradient-to-r from-transparent via-[#222222] to-transparent" aria-hidden="true"></div>

  <div class="py-[var(--spacing-section-sm)] px-[var(--spacing-section-x)]">
    <div class="max-w-[1200px] mx-auto">
    <!-- Main content -->
    <div class="flex flex-col lg:flex-row lg:justify-between gap-12">
      <!-- Left column -->
      <div class="flex flex-col gap-4 lg:max-w-[380px]">
        <span class="font-[var(--font-body)] text-base font-semibold text-[#EDEDED]">Lilian Sevoumian</span>
        <p class="font-[var(--font-body)] text-sm text-[#777777] leading-[1.6]">
          J'automatise les opérations des PME avec Make, n8n et l'IA.<br/>Moins de tâches manuelles, plus de croissance.
        </p>
      </div>

      <!-- Right side: 3 columns -->
      <div class="flex flex-col md:flex-row gap-8 md:gap-20">
        <!-- Navigation -->
        <div class="flex flex-col gap-1">
          <span class="font-[var(--font-mono)] text-[11px] font-medium text-[#777777] tracking-[2px] uppercase mb-1">NAVIGATION</span>
          {navLinks.map((link) => (
            <a href={link.href} class="font-[var(--font-body)] text-sm text-[#888888] hover:text-[#EDEDED] transition-colors duration-200 min-h-[44px] flex items-center">{link.label}</a>
          ))}
        </div>

        <!-- Social -->
        <div class="flex flex-col gap-1">
          <span class="font-[var(--font-mono)] text-[11px] font-medium text-[#777777] tracking-[2px] uppercase mb-1">SOCIAL</span>
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="font-[var(--font-body)] text-sm text-[#888888] hover:text-[#EDEDED] transition-colors duration-200 min-h-[44px] flex items-center"
            >{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom divider -->
    <div class="h-px bg-[#1A1A1A] mt-12 mb-6" aria-hidden="true"></div>

    <!-- Bottom bar -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-3 text-center md:text-left">
      <span class="font-[var(--font-body)] text-xs text-[#777777]">&copy; 2026 Lilian Sevoumian. Tous droits réservés.</span>
      <a href="/mentions-legales" class="font-[var(--font-body)] text-xs text-[#777777] hover:text-[#EDEDED] transition-colors duration-200 min-h-[44px] flex items-center">Mentions légales</a>
    </div>
    </div>
  </div>
</footer>
