---
const navigation = [
  { name: "Expertise", href: "#expertise" },
  { name: "Parcours", href: "#parcours" },
  { name: "Méthode", href: "#process" },
  { name: "Services", href: "#tarifs" }
];

const formations = [
  { name: "Apprendre Make", href: "https://apprendre-make.com" },
  { name: "Formation n8n", href: "https://formation-n8n.com" }
];

const social = [
  { name: "LinkedIn", href: "https://www.linkedin.com/in/liliansevoumian/" },
  { name: "YouTube", href: "https://www.youtube.com/@lilian.sevoumian" },
  { name: "Substack", href: "https://liliansevoumian.substack.com/" }
];
---

<footer class="bg-white py-16 px-6 lg:px-[120px]">
  <div class="max-w-7xl mx-auto flex flex-col gap-12">
    <!-- Top -->
    <div class="flex flex-col md:flex-row justify-between gap-12">
      <!-- Brand -->
      <div class="max-w-[300px] flex flex-col gap-3">
        <span class="text-2xl font-black text-black">LS</span>
        <p class="text-sm text-[#71717A] leading-[1.5]">
          J'automatise les entreprises qui veulent scaler.
        </p>
      </div>

      <!-- Links -->
      <div class="flex gap-16 lg:gap-20">
        <!-- Navigation -->
        <div class="flex flex-col gap-4">
          <h4 class="font-mono text-[11px] font-bold text-black tracking-[2px]">NAVIGATION</h4>
          {navigation.map((link) => (
            <a href={link.href} class="text-sm text-[#71717A] hover:text-black transition-colors">{link.name}</a>
          ))}
        </div>

        <!-- Formations -->
        <div class="flex flex-col gap-4">
          <h4 class="font-mono text-[11px] font-bold text-black tracking-[2px]">FORMATIONS</h4>
          {formations.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-[#71717A] hover:text-black transition-colors">{link.name}</a>
          ))}
        </div>

        <!-- Social -->
        <div class="flex flex-col gap-4">
          <h4 class="font-mono text-[11px] font-bold text-black tracking-[2px]">SOCIAL</h4>
          {social.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-[#71717A] hover:text-black transition-colors">{link.name}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px bg-[#E4E4E7]"></div>

    <!-- Bottom -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <span class="text-[13px] text-[#A1A1AA] font-normal">© 2026 Lilian Sevoumian. Tous droits réservés.</span>
      <span class="text-[13px] text-[#A1A1AA] font-mono font-medium">Built with Claude Code</span>
    </div>
  </div>
</footer>
