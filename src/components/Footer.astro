---
import Pied from './robot/pied.astro';

interface Props {
  /** Uniquement pour les pages sans bloc de contact final. */
  showContact?: boolean;
  /** Hérité du pied « nuit et pêche » : le pied ne porte aucune date. */
  sansDate?: boolean;
}

/* Le pied des pages intérieures est celui de l'accueil (`robot/pied.astro`,
   « Citron et lilas », 10 novembre 2026) : le logo, ce que Lilian publie et
   les pages du site. */
const { showContact = false } = Astro.props;
---

<div class="tenue-robot"><Pied surAccueil={false} source="pied" contact={showContact} /></div>
