---
/*
 * accueil-projets-perso : ce que Lilian construit pour lui
 * (`data/projets.ts`, `persos`).
 *
 * Dans la DA des métiers : chaque projet a son panneau (lueurs, quadrillage,
 * repères d'angle), et son texte dessous. Un projet qui a une capture la
 * montre dans une fenêtre de navigateur ; les autres portent un emblème
 * dessiné (une flamme, une rune, un dragon), éclairé de la couleur du projet.
 * Rien ne bouge.
 *
 * Écartées le 14 octobre 2026 : une grille de cartes de texte (« trop basique
 * et nulle »), puis une mosaïque de cartes (« le design d'avant on avait une
 * vraie DA »).
 */
import { Icon } from 'astro-icon/components';
import { persos } from '../data/projets';

const domaine = (href: string) => href.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<section id="projets-perso" data-section class="accueil-section px-[var(--spacing-section-x)] pb-[var(--spacing-section-y)]">
  <div class="relative mx-auto max-w-[1200px]">
    <header class="accueil-tete reveal">
      <h2>Mes projets perso.</h2>
      <p>Ce que je construis pour moi : des outils, et des sites pour les jeux auxquels je joue.</p>
    </header>
    <ul class="mosaique">
      {persos.map((p, i) => {
        const Balise = p.href ? 'a' : 'div';
        return (
          <li class:list={['tuile reveal', p.embleme && `tuile--${p.embleme}`]}>
            <Balise
              class="tuile__carte"
              href={p.href}
              target={p.href ? '_blank' : undefined}
              rel={p.href ? 'noopener noreferrer' : undefined}
            >
              <div class="tuile__visuel" aria-hidden="true">
                <span class="tuile__repere tuile__repere--hg"></span>
                <span class="tuile__repere tuile__repere--hd"></span>
                <span class="tuile__repere tuile__repere--bg"></span>
                <span class="tuile__repere tuile__repere--bd"></span>
                <div class="tuile__cadre panneau">
                {p.image ? (
                  <div class="tuile__fenetre">
                    <div class="tuile__barre"><i></i><i></i><i></i></div>
                    <img src={p.image} alt="" width="1280" height="800" loading="lazy" decoding="async" />
                  </div>
                ) : (
                  <svg class="tuile__embleme" viewBox="0 0 120 120" fill="none">
                    {p.embleme === 'flamme' && (
                      <>
                        <path class="e-fond" d="M60 12c6 18 26 30 26 56a26 26 0 0 1-52 0c0-12 6-20 12-26 0 10 4 16 10 18-4-16 0-34 4-48z" />
                        <path class="e-trait" d="M60 12c6 18 26 30 26 56a26 26 0 0 1-52 0c0-12 6-20 12-26 0 10 4 16 10 18-4-16 0-34 4-48z" />
                        <path class="e-accent" d="M60 60c4 8 12 12 12 22a12 12 0 0 1-24 0c0-6 4-10 6-12 0 4 2 6 4 6-1-6 0-12 2-16z" />
                      </>
                    )}
                    {p.embleme === 'rune' && (
                      <>
                        <path class="e-fond" d="M40 14h40l14 30-6 62H32l-6-62z" />
                        <path class="e-trait" d="M40 14h40l14 30-6 62H32l-6-62z" />
                        <path class="e-accent-trait" d="M60 34v52M60 46l14-10M60 58l-14-10M60 70l14 10" />
                      </>
                    )}
                    {p.embleme === 'dragon' && (
                      <>
                        <path class="e-fond" d="M14 84c14-6 22-22 26-40 6 10 10 14 20 16 4-16 14-28 30-34-4 12-4 22 2 30 6-4 10-10 14-16 2 22-8 42-30 50-16 6-40 6-62-6z" />
                        <path class="e-trait" d="M14 84c14-6 22-22 26-40 6 10 10 14 20 16 4-16 14-28 30-34-4 12-4 22 2 30 6-4 10-10 14-16 2 22-8 42-30 50-16 6-40 6-62-6z" />
                        <circle class="e-accent" cx="84" cy="52" r="4" />
                        <path class="e-accent-trait" d="M30 96c16 4 34 2 48-6" />
                      </>
                    )}
                  </svg>
                )}
                </div>
              </div>
              <div class="tuile__texte">
                <h3 class="tuile__etiquette">{p.etiquette}</h3>
                <p class="tuile__nom">
                  {p.nom}
                  {p.href && <Icon name="lucide:arrow-up-right" size={18} aria-hidden="true" class="tuile__fleche" />}
                  {p.href && <span class="sr-only"> (nouvel onglet)</span>}
                </p>
                <p class="tuile__resume">{p.resume}</p>
                {p.tags && (
                  <ul class="tuile__tags">
                    {p.tags.map((t) => <li>{t}</li>)}
                  </ul>
                )}
                {p.href && <p class="tuile__domaine">{domaine(p.href)}</p>}
              </div>
            </Balise>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .mosaique {
    display: grid;
    gap: var(--spacing-section-y) var(--spacing-gouttiere);
    margin: 0;
    padding: var(--spacing-lie) 0 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .mosaique {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tuile {
    --teinte: var(--color-accent);
    max-width: none;
  }

  .tuile--flamme { --teinte: var(--color-braise); }
  .tuile--rune { --teinte: var(--color-lueur-froide); }
  .tuile--dragon { --teinte: var(--color-peche-clair); }

  .tuile__carte {
    display: grid;
    gap: var(--spacing-panneau);
    color: inherit;
    text-decoration: none;
  }

  a.tuile__carte:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 10px;
    border-radius: var(--radius-md);
  }

  .tuile__visuel {
    position: relative;
  }

  .tuile__cadre {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-md);
    transition: border-color 200ms var(--ease-out-quint, ease);
  }

  a.tuile__carte:hover .tuile__cadre {
    border-color: color-mix(in srgb, var(--color-ink) 28%, transparent);
  }

  /* Le halo de la teinte du projet, sous l'emblème. */
  .tuile--flamme .tuile__cadre,
  .tuile--rune .tuile__cadre,
  .tuile--dragon .tuile__cadre {
    background:
      radial-gradient(55% 60% at 50% 55%, color-mix(in srgb, var(--teinte) 24%, transparent), transparent 75%),
      var(--color-night-deep);
  }

  .tuile__repere {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--color-ink-low);
    pointer-events: none;
  }

  .tuile__repere--hg { top: -7px; left: -7px; border-top-width: 1px; border-left-width: 1px; }
  .tuile__repere--hd { top: -7px; right: -7px; border-top-width: 1px; border-right-width: 1px; }
  .tuile__repere--bg { bottom: -7px; left: -7px; border-bottom-width: 1px; border-left-width: 1px; }
  .tuile__repere--bd { right: -7px; bottom: -7px; border-right-width: 1px; border-bottom-width: 1px; }

  .tuile__fenetre {
    align-self: end;
    justify-self: end;
    width: 88%;
    height: 86%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-right: 0;
    border-bottom: 0;
    border-radius: var(--radius-md) 0 0 0;
    background: var(--color-night-deep);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
  }

  .tuile__barre {
    display: flex;
    gap: 0.3rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .tuile__barre i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .tuile__fenetre img {
    display: block;
    width: 100%;
    height: auto;
  }

  .tuile__embleme {
    width: clamp(6rem, 22%, 8.5rem);
    height: auto;
  }

  .tuile__embleme .e-fond {
    fill: color-mix(in srgb, var(--teinte) 14%, var(--color-surface-high));
  }

  .tuile__embleme .e-trait {
    stroke: color-mix(in srgb, var(--teinte) 70%, var(--color-ink));
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .tuile__embleme .e-accent {
    fill: var(--teinte);
  }

  .tuile__embleme .e-accent-trait {
    stroke: var(--teinte);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tuile__texte {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .tuile__etiquette {
    margin: 0;
    color: var(--color-accent-text);
    font-size: var(--text-body);
    font-weight: 500;
  }

  .tuile__nom {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-title-lg);
    font-weight: 500;
    letter-spacing: var(--tracking-phrase);
  }

  .tuile__fleche {
    color: var(--color-ink-low);
    transition: color 160ms ease;
  }

  a.tuile__carte:hover .tuile__fleche {
    color: var(--color-accent-text);
  }

  .tuile__resume {
    margin: 0;
    color: var(--color-ink-mid);
  }

  .tuile__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tuile__tags li {
    padding: 0.2rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: 999px;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
  }

  .tuile__domaine {
    margin: 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }
</style>
