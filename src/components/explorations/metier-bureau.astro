<style>
  .bureau {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--color-night-deep);
    container-type: size;
    isolation: isolate;
  }

  .bureau__repli,
  .bureau__toile {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* La toile ne paraît qu'une fois sa première image dessinée : jusque-là,
     et pour de bon si la 3D manque, c'est le dessin de repli qu'on voit. */
  .bureau__toile {
    opacity: 0;
    transition: opacity 600ms var(--ease-out-quint);
  }

  .bureau[data-pret] .bureau__toile {
    opacity: 1;
  }

  /* La pénombre du cadre : la lampe n'éclaire que le milieu de la maquette. */
  .bureau::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      115% 95% at 50% 48%,
      transparent 52%,
      color-mix(in srgb, var(--color-night-deep) 62%, transparent) 100%
    );
    pointer-events: none;
  }

  /* ── Les étiquettes des postes ── */
  .bureau__etiquette {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.36em 0.72em 0.38em 0.6em;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-night-deep) 82%, transparent);
    color: var(--color-ink-mid);
    font-family: var(--font-display);
    font-size: clamp(0.6875rem, 2.7cqw, 0.875rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.005em;
    white-space: nowrap;
    transform: translate(-50%, -100%);
    transition:
      color 400ms var(--ease-out-quint),
      border-color 400ms var(--ease-out-quint);
  }

  /* Le point de l'étiquette : gris tant qu'on recopie, pêche une fois relié. */
  .bureau__etiquette::before {
    content: '';
    width: 0.44em;
    height: 0.44em;
    border-radius: 50%;
    background: var(--color-ink-faint);
    transition:
      background-color 400ms var(--ease-out-quint),
      box-shadow 400ms var(--ease-out-quint);
  }

  .bureau[data-temps='relie'] .bureau__etiquette {
    border-color: color-mix(in srgb, var(--color-peche) 38%, transparent);
    color: var(--color-ink);
  }

  .bureau[data-temps='relie'] .bureau__etiquette::before {
    background: var(--color-peche);
    box-shadow: 0 0 0 0.22em color-mix(in srgb, var(--color-peche) 24%, transparent);
  }

  /* Les trois postes s'allument l'un après l'autre, comme le conduit. */
  .bureau__etiquette[data-ancre='boutique'],
  .bureau__etiquette[data-ancre='boutique']::before {
    transition-delay: 220ms;
  }

  .bureau__etiquette[data-ancre='facture'],
  .bureau__etiquette[data-ancre='facture']::before {
    transition-delay: 520ms;
  }

  /* ── Le témoin des deux temps ── */
  .bureau__temps {
    position: absolute;
    z-index: 1;
    right: 4.2cqw;
    bottom: 4.2cqw;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.22em;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-night-deep) 82%, transparent);
    font-family: var(--font-display);
    font-size: clamp(0.6875rem, 2.7cqw, 0.875rem);
    font-weight: 500;
    line-height: 1;
  }

  /* Le curseur glisse d'un mot à l'autre : clair à la main, pêche relié. */
  .bureau__temps::before {
    content: '';
    position: absolute;
    top: 0.22em;
    bottom: 0.22em;
    left: 0.22em;
    width: calc(50% - 0.22em);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 16%, transparent);
    transition:
      transform 520ms var(--ease-out-expo),
      background-color 520ms var(--ease-out-quint);
  }

  .bureau[data-temps='relie'] .bureau__temps::before {
    background: var(--color-peche);
    transform: translateX(100%);
  }

  .bureau__mot {
    position: relative;
    padding: 0.5em 0.9em 0.52em;
    color: var(--color-ink-faint);
    text-align: center;
    white-space: nowrap;
    transition: color 400ms var(--ease-out-quint);
  }

  .bureau[data-temps='main'] .bureau__mot[data-mot='main'] {
    color: var(--color-ink);
  }

  /* Sur la pêche, le texte se lit en nuit, jamais en blanc. */
  .bureau[data-temps='relie'] .bureau__mot[data-mot='relie'] {
    color: var(--color-night);
  }

  @media (prefers-reduced-motion: reduce) {
    .bureau__toile,
    .bureau__etiquette,
    .bureau__etiquette::before,
    .bureau__temps::before,
    .bureau__mot {
      transition: none;
    }
  }
</style>

<script>
  /* Three.js n'est chargé que lorsque la maquette approche de l'écran. Deux
     échecs possibles, qu'on ne traite pas pareil : un module qui ne charge
     pas (réseau, mise en ligne entre-temps) se retente au prochain passage ;
     une 3D indisponible sur la machine est définitive. Dans les deux cas le
     dessin de repli reste en place. */
  const montees = new WeakSet<HTMLElement>();

  const monter = async (racine: HTMLElement) => {
    if (montees.has(racine)) return;
    montees.add(racine);
    let module: typeof import('../../lib/explorations/bureau');
    try {
      module = await import('../../lib/explorations/bureau');
    } catch (erreur) {
      montees.delete(racine);
      console.warn('Bureau : module non chargé, le dessin fixe reste', erreur);
      return;
    }
    try {
      const demonter = module.monterBureau(racine);
      /* Une navigation sans rechargement laisserait le contexte graphique
         ouvert : on le rend dès que la page s'en va. */
      document.addEventListener('astro:before-swap', demonter, { once: true });
    } catch (erreur) {
      console.warn('Bureau : 3D indisponible, le dessin fixe reste', erreur);
    }
  };

  const guetter = () => {
    const racines = [...document.querySelectorAll<HTMLElement>('[data-bureau]')];
    if (!racines.length) return;
    if (!('IntersectionObserver' in window)) {
      racines.forEach((racine) => monter(racine).catch((erreur: unknown) => console.warn('Bureau : montage en échec', erreur)));
      return;
    }
    const approche = new IntersectionObserver(
      (entrees) => {
        for (const entree of entrees) {
          if (!entree.isIntersecting) continue;
          const racine = entree.target as HTMLElement;
          /* Un module en échec se retente : on ne cesse de guetter que
             lorsque la maquette est vraiment montée. */
          monter(racine)
            .then(() => {
              if (montees.has(racine)) approche.unobserve(racine);
            })
            .catch((erreur: unknown) => console.warn('Bureau : montage en échec', erreur));
        }
      },
      { rootMargin: '320px 0px' },
    );
    racines.forEach((racine) => approche.observe(racine));
  };

  guetter();
  document.addEventListener('astro:after-swap', guetter);
</script>
