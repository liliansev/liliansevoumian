---
// metier-terminal — proposition D, « Le terminal », pour le métier Automatisation.
//
// Un écran en mode texte : le schéma du flux est dessiné en caractères de
// bordure, des grains courent le long des fils, un journal défile, et le
// compteur « ressaisies » reste à zéro. Tout le dessin se fait sur une toile,
// dans `src/lib/explorations/terminal.ts` : ici, il n'y a que le cadre.
//
// La racine remplit son parent (un cadre 4:3 aux coins arrondis, qui rogne).
// Pour un lecteur d'écran la scène est une image : une phrase la décrit, et la
// toile est masquée.
---

<div
  class="terminal"
  role="img"
  aria-label="Un écran de terminal : un bon de commande arrive par mail, il est lu, puis la commande et la facture se créent toutes seules. Le compteur de ressaisies reste à zéro."
  data-terminal
>
  <canvas class="terminal__toile" aria-hidden="true"></canvas>
</div>

<style>
  .terminal {
    position: relative;
    width: 100%;
    height: 100%;
    /* Le fond du site, avec une lueur froide qui tombe du haut : un écran
       allumé dans le noir, sans le déguisement d'un tube cathodique. */
    background:
      radial-gradient(
        120% 70% at 50% -10%,
        color-mix(in srgb, var(--color-lueur-froide, #6f7cff) 9%, transparent),
        transparent 72%
      ),
      var(--color-night-deep, #0c121f);
  }

  /* Hors flux : la toile ne pèse pas sur la taille du cadre, c'est le cadre
     qui lui donne la sienne. */
  .terminal__toile {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { monterTerminal } from '../../lib/explorations/terminal';

  document.querySelectorAll<HTMLElement>('[data-terminal]').forEach((racine) => {
    const toile = racine.querySelector('canvas');
    if (!toile) return;
    try {
      monterTerminal(toile);
    } catch (erreur) {
      /* Sans contexte 2D, la scène reste un fond nu : la phrase de
         `aria-label` continue de la décrire. */
      console.error('terminal : montage impossible', erreur);
    }
  });
</script>
