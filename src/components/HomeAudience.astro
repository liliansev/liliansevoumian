---
import SectionHeader from './SectionHeader.astro';

const audiences = [
  {
    title: 'Fondateurs et équipes Ops',
    body: 'Connecter vos outils et automatiser les tâches qui ralentissent l’équipe.',
  },
  {
    title: 'Dirigeants de PME',
    body: 'Un site ou une application fiable, sans équipe technique à recruter.',
  },
  {
    title: 'Agences et studios',
    body: 'Un renfort autonome pour vos missions, du cadrage à la livraison.',
  },
] as const;
---

<section
  id="pour-qui"
  data-section
  class="bloc-encre relative px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader
      title="Un renfort pour <mark>votre équipe.</mark>"
      titleMaxWidth="24ch"
    />

    <ul class="home-audiences">
      {audiences.map((audience) => (
        <li>
          <h3>{audience.title}</h3>
          <p>{audience.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-audiences {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }

  .home-audiences li {
    display: grid;
    grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 7vw, 7rem);
    max-width: none;
    padding: clamp(1.75rem, 4vw, 2.75rem) 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .home-audiences h3 {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-title-lg);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .home-audiences p {
    max-width: 48ch;
    margin: 0;
    color: var(--color-ink-mid);
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .home-audiences li {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
