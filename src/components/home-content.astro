---
/*
 * home-content — ce que Lilian publie : une vidéo, un mail par semaine.
 *
 * Deux objets, pas deux cartes. À gauche la dernière vidéo, cadrée comme les
 * scènes de la page (quatre repères d'angle), avec son vrai titre et ce qu'on
 * y voit. À droite l'inscription à la newsletter, écrite comme le mail qu'on
 * va recevoir : un expéditeur, un objet, et le champ « À » qui attend
 * l'adresse du visiteur. Le formulaire est l'objet lui-même.
 *
 * L'inscription passe par `/api/newsletter` (voir `lib/newsletter-signup.ts`).
 */
import { Icon } from 'astro-icon/components';
import LinkCTA from './LinkCTA.astro';
import SectionHeader from './SectionHeader.astro';

// Dernière vidéo longue, vérifiée le 2 octobre 2026 sur le flux officiel (les
// entrées plus récentes sont des Shorts) :
// https://www.youtube.com/feeds/videos.xml?channel_id=UCGH0eGI6I9EFsaKpuXXIisg
// Le titre et la phrase viennent de la vidéo elle-même. La vignette est copiée
// dans `public/videos/` : appelée chez YouTube, elle laissait un rectangle
// sombre dès qu'un bloqueur ou le réseau la refusait.
const video = {
  title: 'Reflare\u00a0: l’outil qui me manquait pour créer du contenu',
  resume: 'Reflare redonne vie à d’anciennes vidéos avec des miniatures IA et des tests A/B automatisés.',
  url: 'https://www.youtube.com/watch?v=g9NvMEE7NK4',
  thumbnail: '/videos/g9NvMEE7NK4.webp',
};

// La chaîne, pour qui veut voir les autres : la même adresse que dans le pied
// de page.
const chaine = 'https://www.youtube.com/@lilian.sevoumian';
const linkedin = 'https://www.linkedin.com/in/liliansevoumian/';
---

<section id="contenus" aria-label="Vidéos et newsletter" data-section class="px-[var(--spacing-section-x)] py-[var(--spacing-section-y)] border-b border-[var(--color-divider)]">
  <div class="mx-auto max-w-[1200px]">
    <div class="content-columns grid gap-[var(--spacing-bloc)] lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-x-[var(--spacing-gouttiere)] lg:gap-y-[var(--spacing-groupe)]">
      <article class="grid min-w-0 gap-[var(--spacing-groupe)] lg:row-span-2 lg:grid-rows-subgrid">
        <SectionHeader title="Je montre comment je fais." titleMaxWidth="none" spacing="none" rule={false} class="h-full" />
        <div class="video min-w-0">
        <a href={video.url} target="_blank" rel="noopener noreferrer" class="video-link group block" data-fast-goal="youtube_opened" data-fast-goal-source="home_content">
          <div class="video-cadre">
            <span class="repere repere--hg" aria-hidden="true"></span>
            <span class="repere repere--hd" aria-hidden="true"></span>
            <span class="repere repere--bg" aria-hidden="true"></span>
            <span class="repere repere--bd" aria-hidden="true"></span>
            <div class="media-ouvre relative aspect-video bg-[var(--color-surface-low)]">
              <img src={video.thumbnail} alt="" width="1280" height="720" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-200 motion-reduce:transition-none" />
              <span class="video-play absolute bottom-4 left-4 flex min-h-11 items-center gap-2 rounded-cta bg-[var(--color-paper)] px-4 text-[var(--color-ink)] text-[length:var(--text-body-sm)] font-medium">
                <Icon name="lucide:youtube" size={20} aria-hidden="true" /> Voir la vidéo sur YouTube
              </span>
            </div>
          </div>
          <h3 class="video-titre">{video.title}</h3>
          <p class="video-resume">{video.resume}</p>
        </a>
        {/* Une vidéo en montre une : la chaîne est la sortie de cette activité.
            Elle n'était liée que depuis le pied de page. */}
        <p class="video-suite">
          <LinkCTA href={chaine} external goal="youtube_opened" goalSource="home_content_chaine">
            Voir toutes les vidéos sur YouTube
          </LinkCTA>
        </p>
        </div>
      </article>
      <aside id="newsletter" aria-label="La newsletter" class="grid min-w-0 gap-[var(--spacing-groupe)] lg:row-span-2 lg:grid-rows-subgrid">
        <SectionHeader title="Un mail par semaine." titleMaxWidth="none" spacing="none" rule={false} class="h-full" />
        <div class="min-w-0">
        <form id="newsletter-form" action="/api/newsletter" method="post" class="courrier" aria-describedby="newsletter-note newsletter-status">
          {/* L'objet est un exemple, inventé à la demande de Lilian : il donne le
              ton d'un numéro, ce n'est pas le titre d'un numéro paru. */}
          <dl class="courrier__entete">
            <div class="courrier__ligne">
              <dt>De</dt>
              <dd>Lilian Sevoumian</dd>
            </div>
            <div class="courrier__ligne">
              <dt>Objet</dt>
              <dd>L’automatisation de la semaine, et comment la refaire</dd>
            </div>
          </dl>
          <div class="courrier__ligne courrier__ligne--champ">
            <label for="newsletter-email">À<span class="sr-only">&nbsp;: votre adresse e-mail</span></label>
            <input id="newsletter-email" type="email" name="email" required maxlength="254" autocomplete="email" placeholder="vous@entreprise.fr" />
          </div>
          <div hidden aria-hidden="true"><label for="newsletter-website">Votre site</label><input id="newsletter-website" name="website" tabindex="-1" autocomplete="off" /></div>
          <div class="courrier__pied">
            <button type="submit" disabled class="btn-primary newsletter-action w-full">Recevoir la newsletter <Icon name="lucide:arrow-right" size={18} aria-hidden="true" /></button>
            <p id="newsletter-note" class="courrier__note">Vous recevrez un e-mail pour confirmer votre inscription. Désinscription en&nbsp;un&nbsp;clic.</p>
            <p id="newsletter-status" role="status" aria-live="polite" aria-atomic="true" class="newsletter-status courrier__note" hidden></p>
            <noscript><p class="courrier__note">Activez JavaScript pour vous inscrire à la newsletter.</p></noscript>
          </div>
        </form>
        {/* Le troisième endroit où il publie, avec la vidéo et le mail. Il
            n'était lié que depuis le pied de page. */}
        <p class="video-suite">
          <LinkCTA href={linkedin} external>Me suivre sur LinkedIn</LinkCTA>
        </p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* Les deux titres partagent une rangée, et chacun se cale en bas de la
     sienne : quand l'un passe sur deux lignes (à 1024 px), l'autre restait en
     haut, à 73 px de sa vidéo au lieu de 32. */
  .content-columns :global(.section-header-row) {
    display: grid;
    align-content: end;
    height: 100%;
  }

  /* ── La vidéo : cadrée comme une scène, avec les mêmes repères d'angle que
        la scène du récit et les formes des métiers. ── */
  .video-cadre {
    position: relative;
  }

  /* Pas d'`overflow` ni de rayon ici : `.media-ouvre` (global.css) porte les
     siens, réglés pour son ouverture au défilement. */
  .video-cadre .media-ouvre {
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
  }

  .repere {
    position: absolute;
    z-index: 1;
    width: 12px;
    height: 12px;
    border: 0 solid var(--color-ink-low);
    pointer-events: none;
  }

  .repere--hg { top: -7px; left: -7px; border-top-width: 1px; border-left-width: 1px; }
  .repere--hd { top: -7px; right: -7px; border-top-width: 1px; border-right-width: 1px; }
  .repere--bg { bottom: -7px; left: -7px; border-bottom-width: 1px; border-left-width: 1px; }
  .repere--bd { right: -7px; bottom: -7px; border-right-width: 1px; border-bottom-width: 1px; }

  .video-titre {
    max-width: 30ch;
    margin: 1.5rem 0 0;
    font-size: var(--text-title-lg);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .video-resume {
    max-width: 46ch;
    margin: var(--spacing-colle) 0 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  .video-suite {
    margin: var(--spacing-lie) 0 0;
  }

  /* ── Le mail : un expéditeur, un objet, et le champ « À » à remplir. ── */
  .courrier {
    align-self: start;
    min-width: 0;
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-lg);
    background: var(--color-surface-low);
    color: var(--color-ink);
  }

  .courrier__entete {
    margin: 0;
  }

  .courrier__ligne {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    align-items: center;
    min-height: 3.25rem;
    padding-inline: var(--spacing-panneau);
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
  }

  .courrier__ligne dt,
  .courrier__ligne label {
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .courrier__ligne dd {
    margin: 0;
    font-weight: 500;
    line-height: 1.35;
  }

  /* Le champ occupe sa ligne sans cadre : c'est la ligne « À » du mail, pas un
     champ posé dans une carte. Le focus se lit sur toute la ligne. */
  .courrier__ligne--champ {
    transition: background-color var(--duration-default) var(--ease-out-quint);
  }

  .courrier__ligne--champ:focus-within {
    background: color-mix(in srgb, var(--color-peche) 9%, transparent);
  }

  .courrier__ligne--champ input {
    min-width: 0;
    width: 100%;
    min-height: 3.25rem;
    border: 0;
    /* Pour que l'anneau de focus soit arrondi, comme tout le reste. */
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-body);
    font-weight: 500;
  }

  .courrier__ligne--champ input::placeholder {
    color: var(--color-ink-low);
    font-weight: 400;
    opacity: 1;
  }

  .courrier__ligne--champ input[aria-invalid='true'] {
    color: var(--color-error);
  }

  .courrier__pied {
    display: grid;
    gap: 0.75rem;
    padding: var(--spacing-panneau);
  }

  .courrier__note {
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .newsletter-action { min-height: 48px; }
  .newsletter-action:disabled { cursor: wait; }
  .newsletter-status[data-state="error"] { color: var(--color-error); }

  /* En une colonne, le mail garde une largeur de mail : étiré sur 690 px à
     768, son bouton faisait 654 px de large. */
  @media (max-width: 1023px) {
    .courrier {
      max-width: 32rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .video-link:hover img { transform: scale(1.025); }
    .video-link:hover .video-titre { text-decoration: underline; text-underline-offset: 0.18em; }
    .video-link:hover .video-play { background: var(--color-peche); color: var(--color-night); }
  }
  @media (prefers-reduced-motion: reduce) {
    .video-link:hover img { transform: none; }
    .courrier__ligne--champ { transition: none; }
  }
</style>

<script>
  // La réponse de `/api/newsletter` tient en deux champs. Elle est vérifiée ici
  // à la main : importer zod dans le navigateur pour ces deux champs chargeait
  // toute la bibliothèque sur la page d'accueil. La validation qui compte,
  // celle de l'adresse et des réponses de Lumail, reste côté serveur, avec zod
  // (`lib/newsletter-signup.ts`).
  type Resultat = { status: 'pending' | 'subscribed' | 'error'; message: string };
  const STATUTS: readonly string[] = ['pending', 'subscribed', 'error'];
  const lireResultat = (brut: unknown): Resultat | null => {
    if (typeof brut !== 'object' || brut === null) return null;
    const { status, message } = brut as Record<string, unknown>;
    if (typeof status !== 'string' || !STATUTS.includes(status)) return null;
    if (typeof message !== 'string' || message.length === 0) return null;
    return { status: status as Resultat['status'], message };
  };
  const form = document.querySelector<HTMLFormElement>('#newsletter-form');
  const email = form?.querySelector<HTMLInputElement>('#newsletter-email');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const status = form?.querySelector<HTMLParagraphElement>('#newsletter-status');
  if (form && email && button && status) {
    // Le bouton sort désactivé du HTML : si ce script n'a pas tourné, un envoi
    // natif du formulaire afficherait la réponse JSON brute du serveur.
    button.disabled = false;
    const originalButton = button.innerHTML;
    let submitting = false;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (submitting || !form.reportValidity()) return;
      submitting = true;
      button.disabled = true;
      button.textContent = 'Inscription en cours…';
      form.setAttribute('aria-busy', 'true');
      status.hidden = false;
      status.dataset.state = 'loading';
      status.textContent = 'Votre demande est en cours d’envoi.';
      email.removeAttribute('aria-invalid');

      const submit = async () => {
        // `AbortSignal.timeout` manque avant Safari 16 : sur ces iPhone l'appel
        // levait avant même le `fetch`, et aucune inscription ne partait.
        const controleur = new AbortController();
        const minuterie = window.setTimeout(() => controleur.abort(), 25_000);
        try {
          const data = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: data.get('email'), website: data.get('website') }),
            signal: controleur.signal,
          });
          // Une page d'erreur du frontal (502 pendant un redémarrage) n'est pas du JSON.
          const result = lireResultat(await response.json().catch(() => null));
          if (!result) throw new Error(`Réponse d’inscription illisible (HTTP ${response.status})`);
          status.dataset.state = result.status;
          status.textContent = result.message;
          if (response.status === 422) email.setAttribute('aria-invalid', 'true');
          if (response.ok && result.status !== 'error') form.reset();
        } finally {
          window.clearTimeout(minuterie);
          submitting = false;
          button.disabled = false;
          button.innerHTML = originalButton;
          form.removeAttribute('aria-busy');
        }
      };
      submit().catch((erreur: unknown) => {
        console.error('[newsletter] envoi en échec', erreur);
        const nom = erreur instanceof Error ? erreur.name : '';
        status.dataset.state = 'error';
        // Trois causes, trois messages : ne pas envoyer le visiteur vérifier sa
        // connexion quand c'est le serveur qui ne répond pas.
        status.textContent =
          nom === 'AbortError' || nom === 'TimeoutError'
            ? 'Le serveur met trop de temps à répondre. Réessayez dans une minute.'
            : erreur instanceof TypeError && !navigator.onLine
              ? 'Vous semblez hors ligne. Vérifiez votre connexion puis réessayez.'
              : 'L’inscription n’a pas abouti de mon côté. Réessayez dans quelques instants.';
      });
    });
  }
</script>
