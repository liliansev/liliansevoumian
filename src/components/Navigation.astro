---
import Barre from './carnet/barre.astro';
import { serviceNavigation } from '../data/service-navigation';

interface NavigationLink {
  href: string;
  label: string;
}

interface Props {
  /** Liens propres à une page (ses ancres). Sans cette prop, la barre porte les liens du site. */
  links?: NavigationLink[];
  /** Nom de la page dans les statistiques : d'où le formulaire a été ouvert. */
  ctaSource?: string;
  /** Hérité de la barre « nuit et pêche » ; la barre du carnet n'en a plus besoin. */
  trackHero?: boolean;
}

/* La barre des pages intérieures est celle de l'accueil « Le carnet »
   (`carnet/barre.astro`) depuis le 28 octobre 2026 : le nom, qui ramène à
   l'accueil, les liens, et la pilule « Écrire », qui mène au formulaire de
   contact. Seule la liste des liens change : une page d'offre nomme ses
   ancres, les autres pages les liens du site. Le nom de la barre dans les
   statistiques reste celui de la page. */
const defaultNavLinks: NavigationLink[] = [
  ...serviceNavigation,
  { href: '/cas-clients', label: 'Cas clients' },
  { href: '/principes', label: 'Méthode' },
  { href: '/blog', label: 'Blog' },
];

const { links: suppliedLinks, ctaSource = 'nav' } = Astro.props;
/* Le funnel historique filtre explicitement `nav_mobile_cta` ; les pages
   d'offre gardent une source dérivée et lisible. */
const sourceMenu = suppliedLinks ? `${ctaSource}_mobile` : 'nav_mobile_cta';
---

<Barre sections={suppliedLinks ?? defaultNavLinks} source={ctaSource} sourceMenu={sourceMenu} marqueHref="/" />
