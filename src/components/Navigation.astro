---
const ctaUrl = "https://lilian.yt/contact";

const navLinks = [
  { href: "#expertise", label: "Expertise" },
  { href: "#parcours", label: "Parcours" },
  { href: "#process", label: "Méthode" },
  { href: "#tarifs", label: "Services" }
];
---

<nav class="fixed top-0 w-full z-50 bg-white border-b border-[#E4E4E7]">
  <div class="flex h-[72px] max-w-7xl mx-auto px-6 items-center justify-between">
    <!-- Logo -->
    <a href="#" class="text-2xl font-extrabold text-black tracking-tight">
      LS
    </a>

    <!-- Navigation Links (Desktop) -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-[#71717A] hover:text-black transition-colors">{link.label}</a>
      ))}
    </div>

    <!-- CTA Button (Desktop) -->
    <div class="hidden md:block">
      <a href={ctaUrl} class="inline-flex items-center justify-center bg-black text-white text-sm font-semibold px-6 py-3 rounded-lg hover:bg-zinc-800 transition-colors">
        Je veux automatiser
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden min-h-[44px] min-w-[44px] flex items-center justify-center rounded text-zinc-700 hover:text-black transition-colors"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <div class="burger-icon relative w-5 h-3.5">
        <span class="burger-line absolute left-0 top-0 w-full h-0.5 bg-current rounded-sm transition-all duration-300"></span>
        <span class="burger-line absolute left-0 bottom-0 w-full h-0.5 bg-current rounded-sm transition-all duration-300"></span>
      </div>
    </button>
  </div>
</nav>

<!-- Mobile Menu -->
<div id="mobile-menu" class="mobile-menu fixed inset-0 top-[72px] z-[100] bg-white md:hidden">
  <div class="mobile-menu-content h-full flex flex-col px-6 py-8">
    <div class="flex-1 space-y-2">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class="mobile-menu-link block text-2xl font-bold text-black hover:text-zinc-600 transition-colors py-3"
          style={`--i: ${i}`}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div>
      <a href={ctaUrl} class="w-full inline-flex items-center justify-center bg-black text-white text-base font-semibold px-8 py-4 rounded-lg hover:bg-zinc-800 transition-colors">
        Je veux automatiser
      </a>
    </div>
  </div>
</div>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function toggleMenu() {
    const isOpen = mobileMenu?.classList.toggle('open');
    menuBtn?.classList.toggle('open', isOpen);
    menuBtn?.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('menu-open', isOpen);
  }

  menuBtn?.addEventListener('click', toggleMenu);

  mobileMenu?.querySelectorAll('.mobile-menu-link').forEach(link => {
    link.addEventListener('click', toggleMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('open')) {
      toggleMenu();
    }
  });
</script>

<style is:global>
  #mobile-menu-btn.open .burger-line:first-child {
    transform: translateY(7px) rotate(45deg);
  }

  #mobile-menu-btn.open .burger-line:last-child {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    opacity: 0;
    visibility: hidden;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu .mobile-menu-link {
    opacity: 0;
  }

  .mobile-menu.open .mobile-menu-link {
    opacity: 1;
  }

  body.menu-open {
    overflow: hidden;
  }
</style>
