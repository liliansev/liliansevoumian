---
const navLinks = [
  { href: "#expertise", label: "Expertise" },
  { href: "#methode", label: "Méthode" },
  { href: "#temoignages", label: "Témoignages" },
  { href: "#faq", label: "FAQ" },
];
---

<!-- Nav -->
<nav id="main-nav" class="fixed top-0 w-full z-50 bg-black/0 backdrop-blur-sm transition-all duration-300 border-b border-transparent">
  <div class="flex h-[56px] max-w-[1200px] mx-auto px-[var(--spacing-section-x)] items-center justify-between">
    <!-- Logo -->
    <a href="#" class="font-[var(--font-body)] text-sm md:text-base font-semibold text-[#EDEDED]">
      Lilian Sevoumian
    </a>

    <!-- Nav Links (desktop) -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-[var(--font-body)] text-sm text-[#888888] hover:text-[#EDEDED] transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- CTA (desktop) -->
    <div class="hidden md:block">
      <a
        href="#contact"
        class="inline-flex items-center justify-center font-[var(--font-body)] text-sm font-medium text-white bg-[#8B5CF6] hover:bg-[#7C3AED] rounded-lg px-6 py-2.5 transition-colors"
      >
        Parlons automatisations
      </a>
    </div>

    <!-- Hamburger (mobile) -->
    <button
      id="mobile-menu-btn"
      class="md:hidden min-h-[44px] min-w-[44px] flex items-center justify-center text-[#EDEDED]"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <svg class="hamburger-open w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg class="hamburger-close hidden w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="mobile-menu fixed inset-0 top-[56px] z-[100] bg-black md:hidden">
  <div class="mobile-menu-content h-full flex flex-col px-5 py-8">
    <div class="flex-1 space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-menu-link block font-[var(--font-body)] text-lg font-medium text-[#EDEDED] py-3 border-b border-[#222222]"
        >
          {link.label}
        </a>
      ))}
    </div>
    <a
      href="#contact"
      class="w-full inline-flex items-center justify-center font-[var(--font-body)] text-[15px] font-medium text-white bg-[#8B5CF6] hover:bg-[#7C3AED] rounded-lg px-7 py-3.5 transition-colors"
    >
      Parlons automatisations
    </a>
  </div>
</div>

<style>
  nav.scrolled {
    background-color: rgba(0, 0, 0, 0.85) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: #222222 !important;
  }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = menuBtn?.querySelector('.hamburger-open');
  const closeIcon = menuBtn?.querySelector('.hamburger-close');

  function toggleMenu() {
    const isOpen = mobileMenu?.classList.toggle('open');
    menuBtn?.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('menu-open', isOpen ?? false);

    if (isOpen) {
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);

  mobileMenu?.querySelectorAll('.mobile-menu-link').forEach((link) => {
    link.addEventListener('click', toggleMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('open')) {
      toggleMenu();
    }
  });
</script>
