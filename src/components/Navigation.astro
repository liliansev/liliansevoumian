---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import lilianPhoto from '../assets/lilian-photo.jpg';
import BoutonReservation from './BoutonReservation.astro';
import { DUREE_RESERVATION_MINUTES, LIBELLE_CONTACT_RESERVATION } from '../lib/reservation';
import { serviceNavigation } from '../data/service-navigation';

interface NavigationLink {
  href: string;
  label: string;
}

interface Props {
  /** Liens propres à une page (ses ancres). Sans cette prop, la barre porte les liens du site. */
  links?: NavigationLink[];
  /** Nom de la page dans les statistiques : d'où la conversation a été ouverte. */
  ctaSource?: string;
  /** La page porte un élément #hero dont la sortie pilote le repère mobile. */
  trackHero?: boolean;
}

/* La barre est la même sur toutes les pages : le nom, les liens en bas de
   casse, la pastille qui suit le pointeur, et un seul bouton, « Parlons de
   votre projet », qui ouvre la conversation (`home-invite`, rendue par
   `Layout`). Seule la liste des liens change : l'accueil nomme ses quatre
   métiers, une page d'offre ses ancres, les autres pages les liens du site.
   Avant le 3 octobre 2026, chaque page avait son libellé de bouton, et
   l'accueil était la seule à porter cette allure. */

// MENU MOBILE, SANS NUMÉRO : une navigation n'est pas une séquence. Le chiffre
// annonçait un ordre que le lecteur ne suit pas — il clique là où il veut aller —
// et il numérotait cinq entrées dont deux mènent à une autre page.
//
// Ce commentaire vit ici, en commentaires de LIGNE dans le frontmatter, et c'est
// la réparation du bug qu'il décrivait. Il était posé dans le template sous la
// forme `{/* … */}` et citait un `{/*` `*/}` littéral pour l'illustrer : ce `*/`
// interne fermait le commentaire avant sa fin, et Astro rendait le reste du
// texte comme du contenu — deux lignes de prose en haut du menu plein écran, sur
// chaque page du site. Un bloc `/* … */` aurait le même défaut ; seuls des `//`
// permettent d'écrire ces marqueurs sans les déclencher.
/* Les liens du site, pour les pages qui n'ont pas d'ancres à elles : les deux
   offres, les cas clients, la méthode, le parcours. */
const defaultNavLinks: NavigationLink[] = [
  ...serviceNavigation,
  { href: "/cas-clients", label: "Cas clients" },
  { href: "/principes", label: "Méthode" },
  { href: "/#parcours", label: "Parcours" },
];

const {
  links: suppliedLinks,
  ctaSource = 'nav',
  trackHero,
} = Astro.props;
const navLinks = suppliedLinks ?? defaultNavLinks;
/* Le funnel historique de la home filtre explicitement `nav_mobile_cta`.
   Les landings personnalisées gardent, elles, une source dérivée et lisible. */
const mobileCtaSource = suppliedLinks ? `${ctaSource}_mobile` : 'nav_mobile_cta';

// Ancres relatives à la home : sur une sous-page, préfixer par "/" pour y revenir
// (le « Me contacter » du header doit marcher depuis /expert-make, /cas-clients, etc.).
//
// Le préfixe ne vaut QUE pour les ancres, et c'est la réparation de quarante-quatre
// liens morts. Il était appliqué à toute la liste, y compris aux deux entrées qui
// sont déjà des chemins absolus — « Cas clients » (/cas-clients) et « Méthode »
// (/principes). Sur les onze pages qui ne sont pas la home, elles sortaient en
// `//cas-clients` et `//principes` : un navigateur y lit une URL sans schéma et
// résout vers l'hôte `cas-clients`, pas vers une page du site. Quatre liens par
// page — deux dans la barre, deux dans le menu — dont les seuls chemins vers
// /principes depuis une sous-page.
// Footer.astro tenait déjà le bon test ; la nav ne l'avait jamais eu.
const isHome = Astro.url.pathname === '/';
const hasTrackedHero = trackHero ?? isHome;
const prefix = isHome ? '' : '/';
const lienNav = (href: string) => {
  if (!href.startsWith('#')) return href;
  return suppliedLinks ? href : `${prefix}${href}`;
};

const mobileOfferLinks: NavigationLink[] = serviceNavigation;

// Sur l'accueil, le menu mobile mène aussi à ce que la barre ne nomme pas : la
// barre n'a que les quatre métiers, et « Pourquoi moi », la vidéo et la
// newsletter n'avaient aucune entrée avant le pied de page.
const liensAccueil: NavigationLink[] = [
  { href: '#pourquoi-moi', label: 'Pourquoi moi' },
  { href: '#contenus', label: 'Vidéos et newsletter' },
  { href: '/cas-clients', label: 'Cas clients' },
];

// Les offres restent accessibles même quand une page fournit ses propres
// ancres. Leur bloc remplace les entrées équivalentes de la liste mobile.
const mobileNavLinks = navLinks.filter((link) => {
  const target = new URL(lienNav(link.href), Astro.url);
  return !mobileOfferLinks.some((offer) => {
    const offerTarget = new URL(offer.href, Astro.url);
    return target.pathname === offerTarget.pathname
      && (!target.hash || target.hash === offerTarget.hash);
  });
});

// Le menu a la même composition partout : une liste en grand, une suite en
// plus petit, le bouton en bas. Sur l'accueil, la liste en grand est celle des
// quatre métiers ; ailleurs, ce sont les deux offres, et la suite reprend les
// liens de la barre.
const menuEnGrand = isHome ? navLinks : mobileOfferLinks;
const menuSuite = isHome ? liensAccueil : mobileNavLinks;

/* `past-hero` posé DÈS LE RENDU sur toute page qui n'est pas la home, et c'est
   la réparation d'un défaut qui touchait dix pages sur douze. La classe était
   posée uniquement par l'IntersectionObserver du bas de ce fichier, qui observe
   `#hero` — un élément que seul `HeroManifesto` porte, donc que seule la home
   possède. Vérifié en runtime sur /principes à 402 px : `past-hero` absent,
   opacité du « L » à 1, opacité de l'avatar à 0, à n'importe quelle hauteur de
   défilement. Le visage n'apparaissait jamais ailleurs que sur la home.
   Côté serveur plutôt qu'au chargement : poser la classe en JS ferait jouer le
   fondu croisé à l'ouverture de chaque sous-page, soit un « L » qui clignote
   200 ms avant de céder la place. Si une sous-page reçoit un jour un hero,
   l'observateur reprend la main et corrige l'état à sa première mesure. */
---

{/* Le repère « bannière » de la page : sans lui, la barre n'était dans aucun
    en-tête. Il ne porte ni classe ni style, et ne prend aucune place : la
    barre, son seul enfant, est fixe. */}
<header>
<nav
  id="main-nav"
  class:list={['nav-root', 'px-[var(--spacing-section-x)]', { 'past-hero': !hasTrackedHero }]}
  aria-label="Navigation principale"
>
  <div class="max-w-[1200px] mx-auto h-full grid grid-cols-[auto_1fr_auto] items-stretch lg:flex lg:items-center lg:justify-between lg:gap-4">
    <!-- Logo : wordmark en desktop, « L » en mobile (cellule de grille, façon Mistral) -->
    <a
      href="/"
      id="logo-link"
      class="inline-flex items-center gap-2.5 text-[var(--color-ink)] group min-h-[44px] pr-4 border-r border-[var(--color-divider)] lg:pr-0 lg:border-r-0"
      aria-label="Lilian Sevoumian, accueil"
    >
      <span class="nav-wordmark hidden lg:inline">Lilian Sevoumian</span>
      <!-- Mobile : « L » et avatar empilés dans une cellule de taille fixe (pas de saut
           de layout au scroll). Crossfade en opacité dès qu'on a dépassé le Hero.

           POURQUOI LE VISAGE RESTE SOUS 1024 PX, alors qu'un portrait vient
           d'apparaître en desktop dans le bloc contact. Ce n'est pas un portrait
           de plus : c'est le MÊME emplacement que le wordmark, rempli autrement
           selon la place. Au-dessus de 1024 px la marque tient en toutes
           lettres, « LILIAN SEVOUMIAN », en permanence dans la barre ; en
           dessous, seize caractères en capitales ne cohabitent pas avec un CTA
           central et un déclencheur de menu, et la marque tombe donc sur un
           repère de 28 px. Poser le visage à côté du wordmark serait le seul
           endroit du site où l'identité est énoncée deux fois dans le même
           empan.
           Les deux images du mobile ne répondent pas à la même question. Celle
           de 28 px répond à « chez qui suis-je », dans le seul élément qui ne
           quitte jamais l'écran ; celle du bloc contact, à 72 px, répond à « à
           qui vais-je parler », une fois, au moment de réserver, douze mille
           pixels plus bas. À 28 px on ne lit pas un visage, on lit une marque.
           Et le « L » tient tant que le hero est à l'écran parce que le hero y
           écrit déjà le nom entre 40 et 84 px : le repère y serait un doublon. -->
      <span class="nav-logo-mark lg:hidden" aria-hidden="true">
        <span class="nav-logo-l">L</span>
        <Image
          src={lilianPhoto}
          alt=""
          width={56}
          height={56}
          loading="eager"
          class="nav-logo-avatar"
        />
      </span>
    </a>

    <!-- Desktop links -->
    <div class="nav-liens hidden lg:flex items-center gap-1" data-nav-liens>
      {/* Une pastille glisse d'un lien à l'autre sous le pointeur : le survol
          ne changeait que la teinte du texte, et rien ne disait qu'on tenait
          un lien. */}
      <span class="nav-pastille" aria-hidden="true" data-nav-pastille></span>
      {navLinks.map((link) => (
        <a href={lienNav(link.href)} class="nav-link" data-nav-link>
          {link.label}
        </a>
      ))}
    </div>

    {/* Un seul bouton, le même au bureau et sur téléphone, sur toutes les
        pages : il ouvre la conversation de `home-invite`, qui propose
        WhatsApp, l'e-mail ou l'agenda. Sans script, il mène à l'agenda. Sur
        l'accueil il porte l'ancre `#contact` ; ailleurs, c'est la section de
        fin de page qui la porte. */}
    <div id={isHome ? 'contact' : undefined} class="nav-action">
      <BoutonReservation source={ctaSource} aria-describedby="nav-action-aide">
        <span class="nav-action__label">{LIBELLE_CONTACT_RESERVATION}</span>
        <Icon name="lucide:arrow-right" size={16} aria-hidden="true" />
      </BoutonReservation>
    </div>
    <p id="nav-action-aide" class="sr-only">Ouvre la conversation pour écrire à Lilian, par WhatsApp, par e-mail ou en réservant un appel de {DUREE_RESERVATION_MINUTES}&nbsp;minutes en visio.</p>

    <!-- Déclencheur de menu (mobile) : grille de points ⇄ croix -->
    <button
      id="mobile-menu-btn"
      class="menu-trigger lg:hidden inline-flex items-center justify-center min-h-[44px] min-w-[44px] pl-4 border-l border-[var(--color-divider)]"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="mt-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span class="mt-x" aria-hidden="true"></span>
    </button>
  </div>
</nav>
</header>

<!-- Le dialogue natif isole le menu de la page et de ses éléments fixes. -->
<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu">
  <div class="mobile-menu__panel" tabindex="-1" autofocus>
    <header class="mobile-menu__header">
      <a href="/" class="mobile-menu__marque" data-mobile-link>
        Lilian Sevoumian
      </a>
      <button type="button" class="mobile-menu__close" aria-label="Fermer le menu" data-menu-close>
        <span>Fermer</span>
        <Icon name="lucide:x" size={20} aria-hidden="true" />
      </button>
    </header>
    <div class="mobile-menu__content">
      <nav aria-label={isHome ? 'Mes expertises' : 'Services'} class="mobile-menu__links">
        {menuEnGrand.map((link) => (
          <a
            href={lienNav(link.href)}
            class="mobile-link mobile-menu__link"
            data-mobile-link
            data-fast-goal={isHome ? undefined : 'service_path_opened'}
            data-fast-goal-source={isHome ? undefined : 'nav_mobile_offers'}
          >
            {link.label}
          </a>
        ))}
      </nav>
      {menuSuite.length > 0 && <nav aria-label={isHome ? 'Le reste de la page' : 'Explorer le site'} class="mobile-menu__suite">
        {menuSuite.map((link) => (
          <a href={lienNav(link.href)} class="mobile-link" data-mobile-link>
            {link.label}
          </a>
        ))}
      </nav>}
    </div>
    <div class="mobile-menu__footer">
      <BoutonReservation source={mobileCtaSource} class="btn-primary justify-center w-full" data-mobile-link="">
        {LIBELLE_CONTACT_RESERVATION} <Icon name="lucide:arrow-right" size={16} aria-hidden="true" />
      </BoutonReservation>
    </div>
  </div>
</dialog>

<script>
  // Scroll state — borderbottom shifts at scroll > 60px
  const nav = document.getElementById('main-nav');
  function onScroll() {
    if (!nav) return;
    if (window.scrollY > 60) nav.classList.add('scrolled');
    else nav.classList.remove('scrolled');
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Avatar dans la nav : le repère « L » devient le visage dès que le hero est
  // sorti de l'écran. Le hero écrit le nom en 40 à 84 px ; tant qu'il est là, un
  // second énoncé de la marque à 28 px ne dit rien de plus.
  // Uniquement sur la home : ailleurs, la classe est déjà posée au rendu (voir le
  // frontmatter), et il n'y a pas de `#hero` à observer.
  const heroEl = document.getElementById('hero');
  if (nav && heroEl) {
    const heroObs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        nav.classList.toggle('past-hero', !e.isIntersecting);
      });
    }, { rootMargin: '-80px 0px 0px 0px', threshold: 0 });
    heroObs.observe(heroEl);
  }

  // La pastille de survol : elle prend la place et la largeur du lien visé,
  // glisse vers le suivant, et s'efface quand le pointeur ou le focus quitte
  // la barre. À sa première apparition elle se pose sans glisser depuis la
  // gauche.
  const liens = document.querySelector<HTMLElement>('[data-nav-liens]');
  const pastille = liens?.querySelector<HTMLElement>('[data-nav-pastille]');
  if (liens && pastille) {
    const viser = (lien: HTMLElement) => {
      const visible = pastille.classList.contains('est-la');
      if (!visible) pastille.style.transition = 'none';
      pastille.style.setProperty('--x', `${lien.offsetLeft}px`);
      pastille.style.setProperty('--l', `${lien.offsetWidth}px`);
      if (!visible) {
        void pastille.offsetWidth;
        pastille.style.transition = '';
      }
      pastille.classList.add('est-la');
    };
    liens.querySelectorAll<HTMLElement>('[data-nav-link]').forEach((lien) => {
      lien.addEventListener('pointerenter', () => viser(lien));
      lien.addEventListener('focus', () => viser(lien));
    });
    liens.addEventListener('pointerleave', () => pastille.classList.remove('est-la'));
    liens.addEventListener('focusout', (e) => {
      if (!liens.contains(e.relatedTarget as Node | null)) pastille.classList.remove('est-la');
    });
  }

  // Active link tracking via IntersectionObserver
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sections = Array.from(navLinks)
    .map((a) => {
      const id = a.getAttribute('href')?.replace('#', '') ?? '';
      return id ? document.getElementById(id) : null;
    })
    .filter(Boolean) as HTMLElement[];

  if (sections.length > 0) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) {
          navLinks.forEach((a) => {
            if (a.getAttribute('href') === `#${(e.target as HTMLElement).id}`) {
              a.classList.remove('is-active');
              a.removeAttribute('aria-current');
            }
          });
        }
        if (e.isIntersecting) {
          const id = (e.target as HTMLElement).id;
          navLinks.forEach((a) => {
            const isActive = a.getAttribute('href') === `#${id}`;
            a.classList.toggle('is-active', isActive);
            if (isActive) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
        }
      });
    }, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });
    sections.forEach((s) => obs.observe(s));
  }

  // Mobile menu
  const menuBtn = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
  const mobileMenu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const menuPanel = mobileMenu?.querySelector<HTMLElement>('.mobile-menu__panel');
  const desktopViewport = window.matchMedia('(min-width: 1024px)');
  /* Le menu sert tant que les liens de la barre sont masqués : sous 1024 px,
     et au-dessus quand le texte agrandi les fait passer au menu (voir la
     requête de conteneur `barre-nav` dans global.css). */
  const liensDeBarre = document.querySelector<HTMLElement>('[data-nav-liens]');
  const menuInutile = () => (liensDeBarre ? getComputedStyle(liensDeBarre).display !== 'none' : desktopViewport.matches);

  function syncMenuState(open: boolean) {
    menuBtn?.setAttribute('aria-expanded', String(open));
    // Le nom du bouton dit ce qu'il fera, pas ce qu'il a fait.
    menuBtn?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    window.__verrouDefilement?.('menu', open);
  }

  function closeMenu() {
    if (!mobileMenu?.open) return;
    mobileMenu.close();
    // Synchrone : une ancre ou Cal doit récupérer la page avant son clic natif.
    syncMenuState(false);
  }

  function openMenu() {
    if (!mobileMenu || mobileMenu.open || menuInutile()) return;
    syncMenuState(true);
    mobileMenu.showModal();
    const content = mobileMenu.querySelector('.mobile-menu__content');
    if (content) content.scrollTop = 0;
    menuPanel?.focus({ preventScroll: true });
  }

  // Focus trap : Tab cycle uniquement dans le menu ouvert
  mobileMenu?.addEventListener('keydown', (e) => {
    if (!mobileMenu.open || e.key !== 'Tab') return;
    const focusable = mobileMenu.querySelectorAll<HTMLElement>('a, button, [tabindex]:not([tabindex="-1"])');
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (document.activeElement === menuPanel) {
      (e.shiftKey ? last : first).focus();
      e.preventDefault();
    } else if (e.shiftKey && document.activeElement === first) {
      last.focus();
      e.preventDefault();
    } else if (!e.shiftKey && document.activeElement === last) {
      first.focus();
      e.preventDefault();
    }
  });

  menuBtn?.addEventListener('click', openMenu);
  mobileMenu?.querySelector('[data-menu-close]')?.addEventListener('click', closeMenu);
  mobileMenu?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeMenu();
  });
  // Couvre également une fermeture native, sans voler le focus à Cal.
  mobileMenu?.addEventListener('close', () => {
    if (!mobileMenu.open) syncMenuState(false);
  });

  desktopViewport.addEventListener('change', () => {
    if (menuInutile() && mobileMenu?.open) {
      closeMenu();
      document.getElementById('logo-link')?.focus({ preventScroll: true });
    }
  });
  // Un retour via le cache arrière/avant ne doit pas restaurer un menu verrouillé.
  window.addEventListener('pagehide', closeMenu);

  mobileMenu?.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => {
      // Fermer le menu SYNCHRONE (restaure body.overflow) AVANT que le navigateur
      // exécute le scroll d'ancre — sinon body{overflow:hidden} (menu ouvert) bloque
      // le scroll vers la section visée.
      closeMenu();
    });
  });

  // Logo → si on est déjà sur "/", scroll to top sans navigation. Sinon, navigation native.
  document.getElementById('logo-link')?.addEventListener('click', (e) => {
    if (window.location.pathname === '/') {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      history.replaceState(null, '', window.location.pathname);
    }
  });
</script>

<style>
  /* L'habillage de la barre (fond, liens, menu) vit dans `global.css`, avec
     `.nav-root`. Ici, ce qui tient à ce gabarit : la marque, la pastille, le
     bouton. */
  .nav-wordmark {
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* La pastille de survol. Elle vit sous les liens, à leur hauteur, et suit
     le pointeur : une seule forme qui se déplace, pas un fond par lien. */
  .nav-liens {
    position: relative;
    isolation: isolate;
  }

  .nav-pastille {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: -1;
    width: var(--l, 0);
    height: 36px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 9%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 13%, transparent);
    opacity: 0;
    transform: translate(var(--x, 0), -50%) scale(0.92);
    transition:
      transform 420ms var(--ease-out-expo),
      width 420ms var(--ease-out-expo),
      opacity 180ms var(--ease-out-quint);
    pointer-events: none;
  }

  .nav-pastille.est-la {
    opacity: 1;
    transform: translate(var(--x, 0), -50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pastille {
      transition: opacity 120ms linear;
    }
  }

  /* Le bouton : au centre de la barre sur téléphone, à droite au bureau. */
  .nav-action {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    padding-inline: 0.5rem;
  }

  .nav-action :global(.btn-primary) {
    flex-wrap: wrap;
    gap: 0 0.75rem;
    max-width: 100%;
    padding: 6px 10px;
    line-height: 1.35;
    text-align: center;
  }

  /* Le libellé tient sur une ligne jusqu'à 320 px : sur deux lignes, le bouton
     faisait 50 px de haut dans une barre de 64. */
  .nav-action__label {
    white-space: nowrap;
  }

  @media (max-width: 479px) {
    .nav-action :global(svg) { display: none; }
  }

  @media (max-width: 359px) {
    .nav-action { padding-inline: 0.25rem; }
  }

  @media (min-width: 1024px) {
    .nav-action { padding-inline: 0; }
    .nav-action :global(.btn-primary) { padding: 11px 18px; }
  }

  /* Marque mobile — conteneur de taille fixe (28px) qui empile « L » et avatar.
     La taille ne change jamais : la cellule de grille reste stable au scroll. */
  .nav-logo-mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
  }
  /* Le scoped style Astro (classe + [data-astro-cid], spécificité 0-2-0) bat
     l'utilitaire lg:hidden (0-1-0) : le display doit donc être re-coupé ici,
     sinon le « L » et l'avatar fuient dans la nav desktop. */
  @media (min-width: 1024px) {
    .nav-logo-mark { display: none; }
  }

  /* « L » (mobile) — lettre nue, visible par défaut. */
  .nav-logo-l {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-ink);
    opacity: 1;
    transition: opacity var(--duration-default, 300ms) var(--ease-out-quint, ease);
  }

  /* Avatar (mobile) — photo ronde, en fondu une fois le Hero dépassé. */
  .nav-logo-avatar {
    position: absolute;
    inset: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    opacity: 0;
