---
const navLinks = [
  { href: "/#expertise", label: "Expertise" },
  { href: "/#methode", label: "Méthode" },
  { href: "/#temoignages", label: "Résultats" },
  { href: "/#faq", label: "FAQ" },
];
---

<!-- Nav -->
<nav id="main-nav" class="fixed top-0 w-full z-50 bg-[var(--color-bg-page)] transition-all duration-300" style="border-bottom: 3px solid rgba(255,255,255,0.5);">
  <div class="flex max-w-[1440px] mx-auto px-5 md:px-[80px] py-[16px] items-center justify-between">
    <!-- Logo — Bricolage Grotesque 18px bold -->
    <a href="/" class="font-display text-[18px] font-bold text-[#1A1A1A]">
      Lilian Sevoumian
    </a>

    <!-- Nav Links (desktop) — DM Sans 14px medium, gap 32px -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-body text-[14px] font-medium text-[#666666] hover:text-[#1A1A1A] transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- CTA (desktop) — padding [8, 20], DM Sans 14px semibold -->
    <div class="hidden md:block">
      <a
        href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
        class="btn-3d inline-flex items-center justify-center font-body text-[14px] font-semibold px-5 py-2"
      >
        Parlons automatisations →
      </a>
    </div>

    <!-- Hamburger (mobile) -->
    <button
      id="mobile-menu-btn"
      class="md:hidden min-h-[44px] min-w-[44px] flex items-center justify-center text-[var(--color-text-primary)]"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <svg class="hamburger-open w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg class="hamburger-close hidden w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="mobile-menu fixed inset-0 top-[56px] z-[100] bg-white/95 backdrop-blur-lg md:hidden">
  <div class="mobile-menu-content h-full flex flex-col px-5 py-8">
    <div class="flex-1 space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-menu-link block font-body text-lg font-medium text-[var(--color-text-primary)] py-3 border-b border-[#E5E5E5] min-h-[48px] flex items-center"
        >
          {link.label}
        </a>
      ))}
    </div>
    <a
      href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
      class="btn-3d w-full inline-flex items-center justify-center font-body text-[15px] font-semibold px-7 py-3.5 min-h-[48px]"
    >
      Parlons automatisations &rarr;
    </a>
  </div>
</div>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = menuBtn?.querySelector('.hamburger-open');
  const closeIcon = menuBtn?.querySelector('.hamburger-close');

  function toggleMenu() {
    const isOpen = mobileMenu?.classList.toggle('open');
    menuBtn?.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('menu-open', isOpen ?? false);

    if (isOpen) {
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);

  mobileMenu?.querySelectorAll('.mobile-menu-link').forEach((link) => {
    link.addEventListener('click', toggleMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('open')) {
      toggleMenu();
    }
  });
</script>
