---
const navLinks = [
  { href: "/#expertise", label: "Expertise" },
  { href: "/#cas-clients", label: "Résultats" },
  { href: "/#methode", label: "Méthode" },
  { href: "/#faq", label: "FAQ" },
];

const roiLink = { href: "/#calculateur-roi", label: "ROI Calculateur" };
---

<!-- Floating Island Nav -->
<nav
  id="main-nav"
  class="nav-island fixed top-[16px] left-1/2 -translate-x-1/2 z-50 w-[calc(100%-2rem)] max-w-[900px] h-[56px] rounded-full flex items-center justify-between px-3 md:px-4"
  aria-label="Navigation principale"
>
  <!-- Logo -->
  <a href="#" id="logo-link" class="font-display text-[length:var(--text-body)] font-bold text-[#1A1A1A] pl-3 shrink-0">
    <span class="hidden md:inline">Lilian Sevoumian</span>
    <span class="md:hidden">LS</span>
  </a>

  <!-- Nav Links (desktop) -->
  <div class="hidden md:flex items-center gap-1">
    <!-- ROI Calculateur — orange pill -->
    <a
      href={roiLink.href}
      class="font-body text-[length:var(--text-body-sm)] font-semibold text-[#D4550A] px-3 py-1.5 rounded-full bg-[#E86A33]/10 border border-[#E86A33]/15 hover:bg-[#E86A33]/[0.16] hover:border-[#E86A33]/25 transition-all duration-200 mr-1"
    >
      {roiLink.label}
    </a>
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="nav-island-link font-body text-[length:var(--text-body-sm)] font-medium text-[#666666] hover:text-[#1A1A1A] px-3 py-1.5 rounded-full hover:bg-black/[0.04] transition-all duration-200"
      >
        {link.label}
      </a>
    ))}
  </div>

  <!-- CTA (desktop) -->
  <div class="hidden md:block shrink-0 pr-1">
    <a
      href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
      class="inline-flex items-center justify-center font-body text-[length:var(--text-body-sm)] font-semibold text-white px-4 py-2 rounded-full bg-[#2A2520] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.12),3px_3px_6px_rgba(42,37,32,0.25)] hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none active:translate-x-[2px] active:translate-y-[2px] active:shadow-[1px_1px_3px_rgba(42,37,32,0.15)] transition-all duration-250"
    >
      Réservez un appel
    </a>
  </div>

  <!-- Hamburger (mobile) -->
  <button
    id="mobile-menu-btn"
    class="md:hidden min-h-[44px] min-w-[44px] flex items-center justify-center text-[#1A1A1A]"
    aria-label="Ouvrir le menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <svg class="hamburger-open w-5 h-5 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
    </svg>
    <svg class="hamburger-close hidden w-5 h-5 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</nav>

<!-- Mobile Menu — expands from island -->
<div
  id="mobile-menu"
  class="mobile-island-menu fixed top-[16px] left-1/2 -translate-x-1/2 z-[49] w-[calc(100%-2rem)] rounded-[24px] md:hidden overflow-hidden"
>
  <div class="pt-[60px] px-4 pb-4">
    <div class="space-y-0">
      <a
        href={roiLink.href}
        class="mobile-menu-link block font-body text-[length:var(--text-body)] font-semibold text-[#D4550A] py-3 border-b border-black/[0.06] min-h-[48px] flex items-center"
      >
        {roiLink.label}
      </a>
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-menu-link block font-body text-[length:var(--text-body)] font-medium text-[#1A1A1A] py-3 border-b border-black/[0.06] min-h-[48px] flex items-center"
        >
          {link.label}
        </a>
      ))}
    </div>
    <a
      href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
      class="btn-3d w-full inline-flex items-center justify-center font-body text-[length:var(--text-body)] font-semibold px-7 py-3.5 min-h-[44px] mt-4 group"
    >
      Réservez un appel <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">→</span>
    </a>
  </div>
</div>

<script>
  // --- Scroll state ---
  const nav = document.getElementById('main-nav');
  let lastScrollY = 0;

  function updateNavState() {
    const scrollY = window.scrollY;
    if (scrollY > 60) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
    lastScrollY = scrollY;
  }

  window.addEventListener('scroll', updateNavState, { passive: true });
  updateNavState();

  // --- Nav border adapts to section background ---
  function updateNavBorder() {
    if (!nav) return;
    const navCenter = nav.getBoundingClientRect().top + nav.getBoundingClientRect().height / 2;
    const sections = document.querySelectorAll<HTMLElement>('[data-bg]');
    for (const section of sections) {
      const rect = section.getBoundingClientRect();
      if (rect.top <= navCenter && rect.bottom > navCenter) {
        const bg = section.dataset.bg;
        nav.classList.remove('on-white', 'on-cream', 'on-dark');
        if (bg === 'white') nav.classList.add('on-white');
        else if (bg === 'cream') nav.classList.add('on-cream');
        else if (bg === 'dark') nav.classList.add('on-dark');
        break;
      }
    }
  }

  window.addEventListener('scroll', updateNavBorder, { passive: true });
  updateNavBorder();

  // --- Mobile menu ---
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = menuBtn?.querySelector('.hamburger-open');
  const closeIcon = menuBtn?.querySelector('.hamburger-close');

  function toggleMenu() {
    if (!mobileMenu || !menuBtn) return;
    const isOpen = mobileMenu.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(!!isOpen));
    document.body.classList.toggle('menu-open', !!isOpen);

    if (isOpen) {
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);

  mobileMenu?.querySelectorAll('.mobile-menu-link').forEach((link) => {
    link.addEventListener('click', () => {
      setTimeout(toggleMenu, 150);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('open')) {
      toggleMenu();
    }
  });

  // --- Logo scroll-to-top ---
  document.getElementById('logo-link')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
    history.replaceState(null, '', window.location.pathname);
  });
</script>
