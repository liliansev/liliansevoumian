---
interface Props {
  number: string;
  label: string;
  title: string;
  body?: string;
  bodyMaxWidth?: string;
  titleMaxWidth?: string;
  class?: string;
}

const {
  number,
  label,
  title,
  body,
  bodyMaxWidth = '60ch',
  titleMaxWidth = '18ch',
  class: className = '',
} = Astro.props;
---

<div class={`reveal mb-12 md:mb-16 ${className}`}>
  <div class="relative inline-block bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] p-5 md:p-6">
    <span class="grid-corner tl" aria-hidden="true"></span>
    <span class="grid-corner tr" aria-hidden="true"></span>
    <span class="grid-corner bl" aria-hidden="true"></span>
    <span class="grid-corner br" aria-hidden="true"></span>

    <div class="section-number" style="margin-bottom: 0.5rem;">
      {number} — {label}
    </div>
    <h2
      class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] m-0 text-[var(--color-ink)]"
      style={`max-width: ${titleMaxWidth};`}
    >
      {title}
    </h2>
  </div>

  {body && (
    <p
      class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] mt-6 md:mt-7 mb-0"
      style={`max-width: ${bodyMaxWidth};`}
    >
      {body}
    </p>
  )}
</div>
