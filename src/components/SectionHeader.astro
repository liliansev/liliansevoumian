---
/*
 * SectionHeader — le bloc titre d'une section : un titre, un filet, un chapô.
 *
 * Il a longtemps porté une prop `label`, rendue en petites capitales espacées
 * au-dessus du titre. DESIGN.md rangeait déjà ce sur-titre parmi les trois
 * marqueurs les plus universels du site généré, retirés en chemin — mais il
 * coiffait neuf sections de la home et onze autres endroits, et la règle
 * n'avait jamais atteint le code.
 *
 * La prop a été supprimée plutôt que rendue optionnelle. La différence compte :
 * une prop optionnelle laisse le motif à un caractère de distance, et
 * l'historique de ce fichier montre qu'une règle écrite ailleurs ne suffit pas
 * à l'empêcher de revenir. Les informations que quelques-uns de ces sur-titres
 * portaient réellement — le nombre d'outils, le nombre de questions, la durée
 * du diagnostic — sont descendues dans le chapô, où elles se lisent dans une
 * phrase.
 *
 * Deux sections l'ignoraient et refaisaient cet en-tête à la main : Témoignages
 * et FAQ. Le coût était mesurable, et il portait sur le filet plus que sur les
 * pixels : les six sections qui passaient par ici avaient un trait sous leur
 * titre, ces deux-là non. Dans une DA sans ombre, où l'élévation vient
 * uniquement des filets, un titre de section sans son trait annonce un rang
 * inférieur — la preuve sociale et la FAQ se présentaient comme des
 * sous-parties. S'y ajoutaient trois valeurs d'écart au lieu d'une : titre vers
 * chapô à 24 px contre 53, bloc vers contenu à 48 et 0 contre 64.
 * Elles passent toutes les deux par ce composant. Ce qui leur était propre est
 * devenu des props — largeurs de mesure, et `spacing` pour la colonne de la FAQ.
 */
interface Props {
  title: string;
  body?: string;
  bodyMaxWidth?: string;
  titleMaxWidth?: string;
  class?: string;
  /** Niveau de heading rendu. 'h1' pour le header principal d'une sous-page
      (chaque page doit avoir exactement un h1) ; 'h2' par défaut en section. */
  as?: 'h1' | 'h2';
  /**
   * Qui porte l'écart entre l'en-tête et le contenu qu'il annonce.
   *
   * 'section' (défaut) : l'en-tête le porte lui-même, 48 px puis 64 px au-delà
   * de 768. C'est la mesure de six sections de la home, et elle doit rester
   * unique — un écart différent d'une section à l'autre se lit comme un rang
   * différent alors que ce sont les mêmes.
   *
   * 'none' : le parent le porte déjà. Le seul cas est la FAQ, dont l'en-tête est
   * la colonne gauche d'une grille : le `gap` de la grille sépare les deux
   * colonnes en desktop et les deux blocs en mobile, et une marge basse
   * s'ajouterait à ce `gap` au lieu de le remplacer.
   *
   * Une prop et non une classe passée dans `class` : `mb-0` et `mb-12` sont la
   * même famille d'utilitaires, et c'est l'ordre du CSS généré qui tranche, pas
   * l'ordre des classes écrites. `mb-0` perdrait, silencieusement.
   */
  spacing?: 'section' | 'none';
}

const {
  title,
  body,
  bodyMaxWidth = '60ch',
  titleMaxWidth = '18ch',
  class: className = '',
  as: Heading = 'h2',
  spacing = 'section',
} = Astro.props;

const spacingClass = spacing === 'section' ? 'mb-12 md:mb-16' : '';
---

<div class={`reveal ${spacingClass} ${className}`.replace(/\s+/g, ' ').trim()}>
  {/* Header en flow naturel (block, full-width) plutôt qu'une card flottante en
      coin. Le titre respire avec son max-width, le filet du dessous porte la
      structure. Pas de border outer ni corners — la grille technique 1px en
      background suffit. */}
  <div class="section-header-row">
    {/* La TAILLE suit le niveau, elle n'est plus codée en dur.
        `as="h1"` ne changeait que la balise : le titre de /principes rendait
        48 px là où les h1 de toutes les autres pages font 84 px, soit 43 % de
        moins. Le titre de la page y était visuellement un titre de section. */}
    <Heading
      class:list={[
        'font-display font-semibold leading-[1.05] tracking-[-0.035em] m-0 text-[var(--color-ink)]',
        Heading === 'h1'
          ? 'text-[length:var(--text-display)]'
          : 'text-[length:var(--text-headline)]',
      ]}
      style={`max-width: ${titleMaxWidth};`}
    >
      <Fragment set:html={title} />
    </Heading>
  </div>

  {body && (
    <p
      class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] mt-6 md:mt-7 mb-0"
      style={`max-width: ${bodyMaxWidth};`}
    >
      {body}
    </p>
  )}
</div>

<style>
  .section-header-row {
    position: relative;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-divider);
  }
</style>
