---
interface Props {
  number: string;
  label: string;
  title: string;
  body?: string;
  bodyMaxWidth?: string;
  titleMaxWidth?: string;
  class?: string;
}

const {
  number,
  label,
  title,
  body,
  bodyMaxWidth = '60ch',
  titleMaxWidth = '18ch',
  class: className = '',
} = Astro.props;
---

<div class={`reveal mb-12 md:mb-16 ${className}`}>
  {/* Header en flow naturel (block, full-width) plutôt qu'une card flottante
      en coin. Le section-number devient le repère visuel à gauche, le title
      respire avec son max-width. Pas de border outer ni corners — la grille
      technique 1px en background suffit comme structure. */}
  <div class="section-header-row">
    <div class="section-number">
      {number} — {label}
    </div>
    <h2
      class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] m-0 text-[var(--color-ink)] mt-3"
      style={`max-width: ${titleMaxWidth};`}
    >
      {title}
    </h2>
  </div>

  {body && (
    <p
      class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] mt-6 md:mt-7 mb-0"
      style={`max-width: ${bodyMaxWidth};`}
    >
      {body}
    </p>
  )}
</div>

<style>
  .section-header-row {
    position: relative;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-divider);
  }
</style>
