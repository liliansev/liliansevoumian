---
/*
 * inscription : s'abonner à la newsletter depuis le blog.
 *
 * La newsletter s'appelle « Augmentés » et vit sur Substack
 * (`data/newsletter.ts`). Le bloc le dit tel quel : le visiteur sait où il
 * s'inscrit. Le formulaire est un simple GET vers la page d'inscription de
 * Substack, ouverte dans un nouvel onglet avec l'adresse déjà remplie : pas
 * de script, pas de route serveur, pas de clé (9 novembre 2026, Mailcheap
 * retiré). Le goal DataFast `newsletter_opened` part au clic sur le bouton.
 */
import { newsletter } from '../../data/newsletter';

interface Props {
  /** Le titre du bloc. */
  titre?: string;
  /** La provenance du goal `newsletter_opened`. */
  source?: string;
}

const { titre = `Ma newsletter : ${newsletter.nom}.`, source = 'blog' } = Astro.props;
---

<section id="inscription" aria-labelledby="inscription-titre" class="inscription">
  <h2 id="inscription-titre" class="inscription__titre">{titre}</h2>
  <p class="inscription__texte">L’IA et l’automatisation au quotidien : ce que je teste, ce qui marche, ce que j’en garde pour mon travail. Elle est publiée sur Substack, gratuite, désinscription en&nbsp;un&nbsp;clic.</p>
  <form action={newsletter.inscription} method="get" target="_blank" rel="noopener" class="inscription__form">
    <label for="inscription-email" class="sr-only">Votre adresse e-mail</label>
    <input id="inscription-email" type="email" name="email" required maxlength="254" autocomplete="email" placeholder="votre adresse e-mail" class="inscription__champ" />
    <button type="submit" class="inscription__bouton" data-fast-goal="newsletter_opened" data-fast-goal-source={source}>S’abonner sur Substack</button>
  </form>
  <p class="inscription__note">
    Substack s’ouvre dans un nouvel onglet pour confirmer. <a href={newsletter.archive} target="_blank" rel="noopener noreferrer" class="inscription__lien" data-fast-goal="newsletter_opened" data-fast-goal-source={`${source}_archive`}>Lire les anciens numéros</a>
  </p>
</section>

<style>
  .inscription {
    margin-top: 4.5rem;
    padding: 1.75rem;
    border: 1px solid var(--carnet-trait);
    border-radius: 6px;
    background: var(--blanc, #ffffff);
    scroll-margin-top: 2rem;
  }

  .inscription__titre {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .inscription__texte {
    margin: 0.5rem 0 0;
    color: var(--carnet-gris);
    font-size: 1rem;
  }

  .inscription__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .inscription__champ {
    flex: 1 1 15rem;
    min-width: 0;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--champ, #8e8e89);
    border-radius: 4px;
    background: #ffffff;
    color: var(--carnet-encre);
    font: inherit;
    font-size: 1rem;
  }

  .inscription__champ::placeholder {
    color: #8a8a85;
    opacity: 1;
  }

  .inscription__champ:focus-visible,
  .inscription__bouton:focus-visible,
  .inscription__lien:focus-visible {
    outline: 2px solid var(--violet, #2b44f0);
    outline-offset: 2px;
  }

  /* Le bouton bleu : l'action principale du bloc. */
  .inscription__bouton {
    min-height: 44px;
    padding: 0.5rem 1.4rem;
    border: 0;
    border-radius: 4px;
    background: var(--violet, #2b44f0);
    color: #ffffff;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .inscription__bouton:hover {
    background: var(--bleu-fonce, #1c2fc4);
  }

  .inscription__note {
    margin: 0.75rem 0 0;
    color: var(--carnet-gris);
    font-size: 0.875rem;
  }

  .inscription__lien {
    color: var(--violet, #2b44f0);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
