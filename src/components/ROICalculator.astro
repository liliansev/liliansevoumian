---
/*
 * Simulateur de temps — version JavaScript native Astro.
 *
 * Trois choses ont changé par rapport à la version « calculateur ROI » :
 *
 *  1. Le héros est le TEMPS, plus l'euro. L'euro passe en ligne secondaire :
 *     c'est une traduction du temps à un coût chargé posé en hypothèse, pas la
 *     mesure elle-même.
 *  2. Une seule colonne, chiffre en tête. En deux colonnes il fallait un
 *     `order-first` pour remonter le résultat en mobile, ce qui plaçait le CTA
 *     AVANT les curseurs : on lisait le résultat, on descendait régler, il
 *     fallait remonter pour voir le nouveau chiffre et le bouton. Ici l'ordre
 *     du DOM est l'ordre de lecture est l'ordre de tabulation — chiffre,
 *     réglages, action — et il n'y a plus rien à inverser.
 *  3. Deux curseurs au lieu de trois. Le coût horaire est devenu une hypothèse
 *     fixe (cf. HOURLY_COST dans lib/roi.ts) : il n'était pas plafonné alors
 *     que les deux autres l'étaient, et c'était la question la plus intrusive
 *     du formulaire.
 *
 * La ligne « FORMULE : 8H × 3 EMP × 0,55 RÉCUP × 48 SEM × 55€ » a disparu. Elle
 * ne portait qu'une information propre — le plafonnement en action — que
 * l'avertissement dit déjà en français, et les hypothèses sont écrites juste
 * en dessous, en toutes lettres.
 */
import SectionHeader from './SectionHeader.astro';
import BoutonReservation from './BoutonReservation.astro';
import { LIBELLE_RESERVATION } from '../lib/reservation';
import {
  compute, formatFR, inWorkWeeks, HOURLY_COST,
} from '../lib/roi';

const initial = { hours: 8, people: 3 };

const sliders = [
  { id: 'roi-hours',  label: 'HEURES /SEM PERDUES SUR TÂCHES RÉPÉTITIVES', unit: 'H', min: 1, max: 30, step: 1, value: initial.hours },
  { id: 'roi-people', label: 'PERSONNES CONCERNÉES',                        unit: '',  min: 1, max: 15, step: 1, value: initial.people },
];

const { isCapped, manualHours, hoursSaved, moneySaved } = compute(initial.hours, initial.people);
---

<section
  id="roi"
  data-section  class="section-band relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">
    {/* Sans sur-titre : deux curseurs et un résultat chiffré disent d'eux-mêmes
        qu'on est devant un simulateur, et le titre annonce ce qu'il calcule. */}
    <SectionHeader
      title="Et si vous récupériez une partie de <mark class='inv'>ce temps ?</mark>"
      body="Une simulation, pas une promesse de résultat : elle suppose 55 % du temps manuel récupéré sur 48 semaines, avec un plafond à 20 h/semaine et 10 personnes. Le gain réel dépend des tâches retenues."
      titleMaxWidth="24ch"
      bodyMaxWidth="60ch"
    />

    <div
      class="roi-carte card-soft reveal border border-[var(--color-divider)] rounded-[var(--radius-md)] overflow-hidden"
      data-roi-calc
    >
      <!-- Le résultat en tête : il est visible dès l'entrée dans la section, et
           il reste au-dessus des curseurs qu'on manipule juste en dessous. -->
      <div class="bloc-lime roi-sortie">
        <div class="mono-caption text-[var(--color-ink-low)]">HEURES RÉCUPÉRÉES PAR AN</div>

        <div
          class="roi-chiffre font-display font-semibold text-[var(--color-ink)] tabular-nums"
        >
          <span data-roi-output="hoursSaved">{formatFR(hoursSaved)}</span>
          <span> H</span>
        </div>

        <p class="roi-traduction">
          Sur les <span data-roi-output="manualHours">{formatFR(manualHours)}</span>&nbsp;h/an
          passées en tâches répétitives, soit
          <span data-roi-output="weeksSaved">{formatFR(inWorkWeeks(hoursSaved))}</span> semaines
          de travail rendues à l’équipe. Environ
          <span data-roi-output="moneySaved">{formatFR(moneySaved)}</span>&nbsp;€ à {HOURLY_COST}&nbsp;€
          de l’heure chargée.
        </p>

        {/* Casse normale, comme les deux ponts vers les formations : c'est un
            avertissement, donc précisément le texte qu'il ne faut pas rendre
            plus lent à lire. Le crochet « [!] » saute avec les capitales — il
            faisait le travail d'un signe d'alerte dans une ligne qui n'en avait
            pas d'autre, et la couleur d'erreur le porte déjà. */}
        <span data-roi-warning class="block mt-4 text-[length:var(--text-body-sm)] leading-[1.6] text-[var(--color-error)]" hidden={!isCapped}>
          Estimation plafonnée : les besoins réels seront examinés pendant l’appel.
        </span>

        {/* Une seule région live, hors du chiffre animé. L'ancien montage
            posait aria-live SUR le nombre, que l'animation rAF réécrit à chaque
            image : un glissement de curseur empilait une vingtaine d'annonces
            dans la file du lecteur d'écran. Ici le texte n'est écrit qu'une
            fois l'animation finie. */}
        <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-roi-annonce></span>
      </div>

      <fieldset class="roi-reglages border-0 m-0">
        <legend class="sr-only">Paramètres du simulateur</legend>
        {sliders.map((s) => (
          <div class="flex flex-col gap-3">
            <div class="flex items-baseline justify-between">
              <label for={s.id} class="mono-caption text-[var(--color-ink-low)]">
                {s.label}
              </label>
              <span
                class="font-display font-semibold tabular-nums tracking-[-0.02em] text-[var(--color-ink)] whitespace-nowrap"
                style="font-size: var(--text-title-lg);"
              >
                <span data-roi-display={s.id}>{formatFR(s.value)}</span>
                {s.unit && <span class="mono-caption ml-1 text-[var(--color-ink-low)]">{s.unit}</span>}
              </span>
            </div>
            <input
              id={s.id}
              type="range"
              min={s.min}
              max={s.max}
              step={s.step}
              value={s.value}
              aria-valuetext={`${s.value}${s.unit ? ' ' + s.unit : ''}`}
              class="roi-slider"
              data-roi-input={s.id}
            />
            <div class="flex justify-between mono-caption text-[var(--color-ink-low)]">
              <span>{formatFR(s.min)}{s.unit}</span>
              <span>{formatFR(s.max)}{s.unit}</span>
            </div>
          </div>
        ))}

        <div class="roi-actions">
          <BoutonReservation source="roi" class="btn-primary justify-center w-full">
            {LIBELLE_RESERVATION}
          </BoutonReservation>
          <button
            type="button"
            data-roi-share
            class="tap-44 mono-caption text-[var(--color-ink-low)] hover:text-[var(--color-ink)] transition-colors bg-transparent border-0 p-0 cursor-pointer self-start"
          >
            <span data-roi-share-label>COPIER LE LIEN DE CE CALCUL</span>
          </button>
        </div>
      </fieldset>
    </div>
  </div>
</section>

<style>
  .roi-sortie {
    padding: clamp(1.75rem, 4vw, 2.5rem);
  }

  .roi-chiffre {
    font-size: var(--text-roi-primary);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin-top: 0.35rem;
  }

  .roi-traduction {
    max-width: 46ch;
    margin: 1rem 0 0;
    font-size: var(--text-body-sm);
    line-height: 1.55;
    color: var(--color-ink-mid);
    font-variant-numeric: tabular-nums;
  }

  .roi-reglages {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--color-paper);
    border-top: 1px solid var(--color-divider);
  }

  .roi-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.85rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-divider);
  }

  /* Le curseur est la seule commande du site à manipulation continue, et la plus
     difficile à saisir au doigt : il faut attraper une poignée de 16 px puis la
     tenir pendant qu'elle se déplace. Sa zone tactile valait 28 px, soit 16 de
     moins que le plancher de 44 px que le reste du site tient déjà (flèches du
     carrousel, liens du pied de page, barre mobile). Sur pointeur grossier
     uniquement : sur bureau, 28 px suffisent à la souris et 44 px pousseraient
     les deux réglages de 32 px sans rien améliorer.
     La piste PEINTE ne bouge pas — elle est dessinée en `background-image` de
     4 px centrée dans la boîte, et c'est la boîte seule qui grandit. D'où
     l'avertissement de global.css, répété ici parce que c'est de ce côté-ci que
     la tentation revient : ne jamais repasser en raccourci `background`, il
     réinitialiserait `background-size` et la piste s'étalerait sur les 44 px. */
  @media (pointer: coarse) {
    [data-roi-calc] .roi-slider {
      height: 44px;
    }
  }

  /* Aucun accusé de réception à l'appui : la poignée répondait au survol et au
     focus clavier, c'est-à-dire aux deux situations où l'on voit déjà un curseur
     à l'écran, et à rien au doigt — là où le doigt masque justement la poignée.
     L'aplat d'encre est instantané (aucune transition ne le porte, et c'est
     voulu : un appui doit être reconnu à l'image suivante), le grossissement
     suit la transition de 150 ms déjà déclarée sur la poignée. L'encre plutôt
     qu'un lime plus vif : le lime est une surface, il ne signale pas un état.
     Sélecteur préfixé par [data-roi-calc] pour passer devant la règle de survol
     de global.css, de spécificité identique — une égalité qui se serait tranchée
     à l'ordre d'injection des feuilles, c'est-à-dire au hasard du build. */
  [data-roi-calc] .roi-slider:active::-webkit-slider-thumb {
    background: var(--color-ink);
    border-color: var(--color-ink);
    transform: scale(1.25);
  }

  [data-roi-calc] .roi-slider:active::-moz-range-thumb {
    background: var(--color-ink);
    border-color: var(--color-ink);
    transform: scale(1.25);
  }

  /* Deux règles et non une liste séparée par une virgule : un sélecteur invalide
     dans une liste invalide la règle ENTIÈRE, et `::-moz-range-thumb` est
     invalide pour Chrome comme `::-webkit-slider-thumb` l'est pour Firefox.
     Groupées, les deux poignées auraient gardé leur transition dans les deux
     navigateurs — vérifié : Chrome ne conserve aucune des deux. */
  @media (prefers-reduced-motion: reduce) {
    [data-roi-calc] .roi-slider::-webkit-slider-thumb {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-roi-calc] .roi-slider::-moz-range-thumb {
      transition: none;
    }
  }

  /* Au-delà de 60rem le chiffre et les réglages tiennent côte à côte, mais
     l'ordre du DOM reste celui de la lecture : résultat, puis réglages. */
  @media (min-width: 60rem) {
    .roi-carte {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    /* Les deux colonnes d'une grille prennent la hauteur de la plus haute :
       sans ce centrage, le chiffre se collait en haut de l'aplat lime et
       laissait un grand vide sous lui. */
    .roi-sortie {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .roi-reglages {
      border-top: 0;
      border-left: 1px solid var(--color-divider);
      justify-content: center;
    }
  }
</style>

<script>
  import { compute, formatFR, inWorkWeeks } from '../lib/roi';

  // Met à jour la CSS custom property --slider-progress qui pilote
  // le linear-gradient de fill du track (entre min et current value).
  function updateSliderProgress(input: HTMLInputElement) {
    const min = Number(input.min);
    const max = Number(input.max);
    const val = Number(input.value);
    const progress = max > min ? ((val - min) / (max - min)) * 100 : 0;
    input.style.setProperty('--slider-progress', progress + '%');
  }

  // Animated number — easing rAF, identique au comportement précédent.
  // Un seul rAF actif par élément ; setTarget annule l'ancien et repart du current.
  //
  // `onFrame` reçoit la valeur courante à chaque image. Il sert aux nombres qui
  // ne sont pas des grandeurs indépendantes mais des traductions de celle-ci
  // (cf. les semaines, plus bas) : ils suivent alors la même durée et la même
  // courbe sans qu'un second compteur ait à être tenu en parallèle.
  class AnimatedValue {
    private current: number;
    private rafId: number | null = null;
    private duration = 350;
    private element: HTMLElement;
    private onFrame?: (value: number) => void;

    constructor(element: HTMLElement, initial: number, onFrame?: (value: number) => void) {
      this.element = element;
      this.current = initial;
      this.onFrame = onFrame;
    }

    setTarget(value: number, prefersReducedMotion: boolean) {
      if (value === this.current) return;
      if (prefersReducedMotion) {
        this.current = value;
        this.element.textContent = formatFR(value);
        this.onFrame?.(value);
        return;
      }
      const start = this.current;
      const diff = value - start;
      const startTime = performance.now();
      if (this.rafId !== null) cancelAnimationFrame(this.rafId);

      const animate = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / this.duration, 1);
        const eased = 1 - Math.pow(1 - progress, 4);
        this.current = Math.round(start + diff * eased);
        this.element.textContent = formatFR(this.current);
        this.onFrame?.(this.current);
        if (progress < 1) {
          this.rafId = requestAnimationFrame(animate);
        } else {
          this.current = value;
          this.element.textContent = formatFR(value);
          this.onFrame?.(value);
          this.rafId = null;
        }
      };
      this.rafId = requestAnimationFrame(animate);
    }
  }

  // Lit un param URL en l'élageant aux bornes du slider, fallback sur défaut.
  function readParam(name: string, min: number, max: number, fallback: number): number {
    const params = new URLSearchParams(window.location.search);
    const raw = params.get(name);
    if (raw === null) return fallback;
    const n = Number(raw);
    if (!Number.isFinite(n)) return fallback;
    return Math.min(Math.max(n, min), max);
  }

  // Met à jour l'URL sans navigation. On retire les params si on est revenu aux valeurs par défaut.
  function syncUrl(hours: number, people: number, defaults: { hours: number; people: number }) {
    const params = new URLSearchParams(window.location.search);
    if (hours === defaults.hours) params.delete('h'); else params.set('h', String(hours));
    if (people === defaults.people) params.delete('emp'); else params.set('emp', String(people));
    // `rate` a existé tant que le coût horaire était un curseur. On le purge des
    // liens partagés à l'époque, sinon il resterait dans l'URL sans rien piloter.
    params.delete('rate');
    const search = params.toString();
    const url = `${window.location.pathname}${search ? '?' + search : ''}${window.location.hash}`;
    history.replaceState(null, '', url);
  }

  function initROICalc() {
    const root = document.querySelector<HTMLElement>('[data-roi-calc]');
    if (!root || root.dataset.roiInit === '1') return;
    root.dataset.roiInit = '1';

    const inputHours = root.querySelector<HTMLInputElement>('[data-roi-input="roi-hours"]');
    const inputPeople = root.querySelector<HTMLInputElement>('[data-roi-input="roi-people"]');
    if (!inputHours || !inputPeople) return;

    const dispHours = root.querySelector<HTMLElement>('[data-roi-display="roi-hours"]')!;
    const dispPeople = root.querySelector<HTMLElement>('[data-roi-display="roi-people"]')!;

    const outHours = root.querySelector<HTMLElement>('[data-roi-output="hoursSaved"]')!;
    const outManual = root.querySelector<HTMLElement>('[data-roi-output="manualHours"]')!;
    const outWeeks = root.querySelector<HTMLElement>('[data-roi-output="weeksSaved"]')!;
    const outMoney = root.querySelector<HTMLElement>('[data-roi-output="moneySaved"]')!;

    const warningEl = root.querySelector<HTMLElement>('[data-roi-warning]')!;
    const annonceEl = root.querySelector<HTMLElement>('[data-roi-annonce]')!;

    const shareBtn = root.querySelector<HTMLButtonElement>('[data-roi-share]');
    const shareLabel = root.querySelector<HTMLElement>('[data-roi-share-label]');

    const defaults = {
      hours: Number(inputHours.value),
      people: Number(inputPeople.value),
    };

    const initHours = readParam('h', Number(inputHours.min), Number(inputHours.max), defaults.hours);
    const initPeople = readParam('emp', Number(inputPeople.min), Number(inputPeople.max), defaults.people);
    inputHours.value = String(initHours);
    inputPeople.value = String(initPeople);

    // Sync aria-valuetext avec les valeurs effectives (URL params), sinon AT lit la valeur SSR figee
    inputHours.setAttribute('aria-valuetext', `${initHours} H`);
    inputPeople.setAttribute('aria-valuetext', `${initPeople}`);

    updateSliderProgress(inputHours);
    updateSliderProgress(inputPeople);

    const c0 = compute(initHours, initPeople);

    dispHours.textContent = formatFR(initHours);
    dispPeople.textContent = formatFR(initPeople);

    outHours.textContent = formatFR(c0.hoursSaved);
    outManual.textContent = formatFR(c0.manualHours);
    outWeeks.textContent = formatFR(inWorkWeeks(c0.hoursSaved));
    outMoney.textContent = formatFR(c0.moneySaved);
    warningEl.hidden = !c0.isCapped;

    /* Les semaines ne sont pas un quatrième compteur : elles sont les heures
       divisées par 35, et elles sont donc écrites par le compteur des heures, à
       chaque image.
       L'exception qui les faisait sauter est tombée à la mesure. Elle disait
       « petits paliers, l'animer produirait un scintillement » — les paliers ne
       sont pas petits : un cran du curseur des heures vaut 26,4 h par personne,
       soit 0,75 semaine à 1 personne, 2,3 à 3 et 7,5 à 10. Et une variation de
       deux semaines resterait 79 ms sur sa valeur intermédiaire avec la courbe en
       place, c'est-à-dire cinq images : un cran lisible, pas un scintillement.
       Restait le vrai symptôme, celui qu'on voit : quatre nombres dans le même
       bloc, trois qui glissent sur 350 ms et un qui se téléporte.
       Un compteur indépendant aurait suffi à l'aligner, mais pas à le rendre
       juste — `arrondi(sA + (sB−sA)·e)` et `arrondi(arrondi(hA + (hB−hA)·e) / 35)`
       divergent d'une demi-semaine pendant la course, et la phrase aurait pu
       afficher un nombre d'heures et un nombre de semaines qui ne se répondent
       pas. La traduction est donc calculée à partir du nombre réellement
       affiché : même durée, même courbe, et l'égalité tient par construction. */
    const animHours = new AnimatedValue(outHours, c0.hoursSaved, (heures) => {
      outWeeks.textContent = formatFR(inWorkWeeks(heures));
    });
    const animManual = new AnimatedValue(outManual, c0.manualHours);
    const animMoney = new AnimatedValue(outMoney, c0.moneySaved);

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    // L'annonce vocale attend l'arrêt du curseur : sans ce délai, chaque cran
    // d'un glissement produirait une phrase, toutes empilées dans la file.
    let annonceTimer: number | null = null;
    function annoncer(heures: number) {
      if (annonceTimer !== null) window.clearTimeout(annonceTimer);
      annonceTimer = window.setTimeout(() => {
        annonceEl.textContent = `${formatFR(heures)} heures récupérées par an.`;
      }, 600);
    }

    function update() {
      const hours = Number(inputHours!.value);
      const people = Number(inputPeople!.value);

      dispHours.textContent = formatFR(hours);
      dispPeople.textContent = formatFR(people);
      inputHours!.setAttribute('aria-valuetext', `${hours} H`);
      inputPeople!.setAttribute('aria-valuetext', `${people}`);

      updateSliderProgress(inputHours!);
      updateSliderProgress(inputPeople!);

      const c = compute(hours, people);
      const reducedMotion = motionQuery.matches;

      // Les semaines suivent le compteur des heures (cf. sa construction) : rien
      // à écrire ici, sous peine de deux sources pour un même nombre.
      animHours.setTarget(c.hoursSaved, reducedMotion);
      animManual.setTarget(c.manualHours, reducedMotion);
      animMoney.setTarget(c.moneySaved, reducedMotion);

      warningEl.hidden = !c.isCapped;
      annoncer(c.hoursSaved);

      syncUrl(hours, people, defaults);
    }

    inputHours.addEventListener('input', update);
    inputPeople.addEventListener('input', update);

    // Bouton « Copier le lien » — le seul mécanisme par lequel un lecteur
    // transmet son estimation à qui décide.
    if (shareBtn && shareLabel) {
      let resetTimer: number | null = null;
      shareBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          shareLabel.textContent = 'LIEN COPIÉ ✓';
          if (resetTimer !== null) window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            shareLabel.textContent = 'COPIER LE LIEN DE CE CALCUL';
          }, 1500);
        } catch {
          shareLabel.textContent = 'COPIE IMPOSSIBLE · SÉLECTIONNEZ L’URL';
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initROICalc);
  } else {
    initROICalc();
  }
  document.addEventListener('astro:page-load', initROICalc);
</script>
