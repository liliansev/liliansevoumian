---
/*
 * ROI Calculator — version vanilla JS (Astro <script>).
 *
 * Reprend la logique du composant React précédent (sliders, animation
 * rAF des outputs, capping) sans dépendance React. Économise ~55 KB gz
 * post-scroll.
 *
 * Le header passe désormais par <SectionHeader> au lieu d'une copie
 * inline (fin du drift TSX/Astro flaggué dans l'audit).
 */
import SectionHeader from './SectionHeader.astro';

const PROJECT_PRICE_MID = 12000;
const PROJECT_PRICE_LOW = 1500;
const RECOVERY_RATE = 0.55;
const WEEKS_PER_YEAR = 48;
const MAX_REASONABLE_HOURS = 20;
const MAX_REASONABLE_PEOPLE = 10;

const initial = { hours: 8, people: 3, hourlyCost: 55 };

const sliders = [
  { id: 'roi-hours',  label: 'HEURES /SEM PERDUES SUR PROCESS RÉPÉTITIFS', unit: 'H', min: 1,  max: 30,  step: 1, value: initial.hours },
  { id: 'roi-people', label: 'EMPLOYÉS CONCERNÉS',                          unit: '',  min: 1,  max: 15,  step: 1, value: initial.people },
  { id: 'roi-rate',   label: 'COÛT HORAIRE INTERNE',                        unit: '€', min: 25, max: 120, step: 5, value: initial.hourlyCost },
];

const cappedHours = Math.min(initial.hours, MAX_REASONABLE_HOURS);
const cappedPeople = Math.min(initial.people, MAX_REASONABLE_PEOPLE);
const isCapped = initial.hours >= MAX_REASONABLE_HOURS || initial.people >= MAX_REASONABLE_PEOPLE;
const hoursSaved = Math.round(cappedHours * cappedPeople * RECOVERY_RATE * WEEKS_PER_YEAR);
const moneySaved = hoursSaved * initial.hourlyCost;
const projectPrice = moneySaved < 20000 ? PROJECT_PRICE_LOW : PROJECT_PRICE_MID;
const monthsToROI = moneySaved > 0 ? Math.max(1, Math.ceil((projectPrice * 12) / moneySaved)) : 99;

function formatFR(n: number): string {
  // Format français avec NBSP standard (U+00A0) au lieu de narrow NBSP (U+202F)
  // qui se rend cassé en Geist 600 large size.
  return n.toLocaleString('fr-FR').replace(/ /g, ' ');
}
---

<section
  id="roi"
  data-section
  class="relative bg-[var(--color-paper)] py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">
    <SectionHeader
      number="01"
      label="ROI"
      title="Votre temps coûte plus que vous ne pensez."
      body="Estimation conservatrice : 55 % des heures manuelles récupérées via automatisation, 48 semaines effectives par an. Au-delà de 20 h/sem ou 10 employés, l'estimation est plafonnée. L'audit réel descend dans le détail."
      titleMaxWidth="20ch"
      bodyMaxWidth="60ch"
    />

    <!-- Calculator grid : sliders sur paper, output sur surface-low -->
    <div
      class="relative grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-px bg-[var(--color-divider)] border border-[var(--color-divider)] rounded-[var(--radius-md)] overflow-hidden reveal"
      data-roi-calc
    >
      <span class="grid-corner tl" aria-hidden="true"></span>
      <span class="grid-corner tr" aria-hidden="true"></span>
      <span class="grid-corner bl" aria-hidden="true"></span>
      <span class="grid-corner br" aria-hidden="true"></span>

      <!-- Sliders panel -->
      <fieldset class="bg-[var(--color-paper)] p-8 md:p-10 flex flex-col gap-8 border-0 m-0">
        <legend class="sr-only">Paramètres d'estimation ROI</legend>
        {sliders.map((s) => (
          <div class="flex flex-col gap-3">
            <div class="flex items-baseline justify-between">
              <label for={s.id} class="mono-caption text-[var(--color-ink-low)]">
                {s.label}
              </label>
              <span
                class="font-display font-semibold tabular-nums tracking-[-0.02em] text-[var(--color-ink)]"
                style="font-size: var(--text-title-lg);"
              >
                <span data-roi-display={s.id}>{formatFR(s.value)}</span>
                {s.unit && <span class="mono-caption ml-1 text-[var(--color-ink-low)]">{s.unit}</span>}
              </span>
            </div>
            <input
              id={s.id}
              type="range"
              min={s.min}
              max={s.max}
              step={s.step}
              value={s.value}
              aria-valuetext={`${s.value}${s.unit ? ' ' + s.unit : ''}`}
              class="roi-slider"
              data-roi-input={s.id}
            />
            <div class="flex justify-between mono-caption text-[var(--color-ink-low)]">
              <span>{formatFR(s.min)}{s.unit}</span>
              <span>{formatFR(s.max)}{s.unit}</span>
            </div>
          </div>
        ))}
      </fieldset>

      <!-- Output panel — aria-live ciblé sur le montant principal pour eviter de chunker tout le panel -->
      <div class="bg-[var(--color-surface-low)] p-8 md:p-10 flex flex-col">
        <div class="mono-caption mb-2 text-[var(--color-ink-low)]">ÉCONOMIE ESTIMÉE</div>
        <div
          class="font-display font-semibold leading-[0.98] tracking-[-0.045em] mb-6 text-[var(--color-ink)]"
          style="font-size: var(--text-roi-money);"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
          <span data-roi-output="moneySaved">{formatFR(moneySaved)}</span>
          <span> €</span>
          <span class="mono-caption ml-2 align-middle text-[var(--color-ink-low)]">/AN</span>
        </div>

        <div class="grid grid-cols-2 gap-6 pb-6 border-b border-[var(--color-divider)] mb-6">
          <div>
            <div class="mono-caption mb-1 text-[var(--color-ink-low)]">HEURES /AN</div>
            <div
              class="font-display font-semibold tabular-nums tracking-[-0.025em] text-[var(--color-ink)]"
              style="font-size: var(--text-roi-output);"
            >
              <span data-roi-output="hoursSaved">{formatFR(hoursSaved)}</span>
              <span> H</span>
            </div>
          </div>
          <div>
            <div class="mono-caption mb-1 text-[var(--color-ink-low)]">ROI EN</div>
            <div
              class="font-display font-semibold tabular-nums tracking-[-0.025em] text-[var(--color-violet-deep)]"
              style="font-size: var(--text-roi-output);"
            >
              ~<span data-roi-output="monthsToROI">{monthsToROI}</span> MOIS
            </div>
          </div>
        </div>

        <div class="mono-caption mb-6 leading-[1.6] flex flex-col gap-1 text-[var(--color-ink-low)]">
          <span>
            FORMULE : <span data-roi-formula>{cappedHours}H × {cappedPeople} EMP × 0,55 RÉCUP × 48 SEM × {initial.hourlyCost}€</span>
          </span>
          <span>
            COÛT PROJET RÉFÉRENCE : <span data-roi-project-price>{formatFR(projectPrice)}</span> € (<span data-roi-project-label>{moneySaved < 20000 ? 'WORKFLOW' : 'MISSION COMPLÈTE'}</span>)
          </span>
          <span data-roi-warning class="text-[var(--color-error)]" hidden={!isCapped}>
            [!] ESTIMATION PLAFONNÉE. L'AUDIT RÉEL DESCEND DANS LE DÉTAIL
          </span>
        </div>

        <div class="mt-auto flex flex-col gap-3">
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary justify-center w-full"
          >
            Démarrer · diagnostic 20 min
          </a>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <button
              type="button"
              data-roi-share
              class="mono-caption text-[var(--color-ink-low)] hover:text-[var(--color-violet-deep)] transition-colors text-left bg-transparent border-0 p-0 cursor-pointer"
            >
              <span data-roi-share-label>COPIER LE LIEN DE CE CALCUL</span>
            </button>
            <span class="mono-caption text-[var(--color-ink-faint)]" aria-hidden="true">·</span>
            <button
              type="button"
              data-roi-reset
              class="mono-caption text-[var(--color-ink-low)] hover:text-[var(--color-violet-deep)] transition-colors text-left bg-transparent border-0 p-0 cursor-pointer"
            >
              RÉINITIALISER
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const PROJECT_PRICE_MID = 12000;
  const PROJECT_PRICE_LOW = 1500;
  const RECOVERY_RATE = 0.55;
  const WEEKS_PER_YEAR = 48;
  const MAX_REASONABLE_HOURS = 20;
  const MAX_REASONABLE_PEOPLE = 10;

  function formatFR(n: number): string {
    return n.toLocaleString('fr-FR').replace(/ /g, ' ');
  }

  function compute(hours: number, people: number, hourlyCost: number) {
    const cappedHours = Math.min(hours, MAX_REASONABLE_HOURS);
    const cappedPeople = Math.min(people, MAX_REASONABLE_PEOPLE);
    const isCapped = hours >= MAX_REASONABLE_HOURS || people >= MAX_REASONABLE_PEOPLE;
    const hoursSaved = Math.round(cappedHours * cappedPeople * RECOVERY_RATE * WEEKS_PER_YEAR);
    const moneySaved = hoursSaved * hourlyCost;
    const projectPrice = moneySaved < 20000 ? PROJECT_PRICE_LOW : PROJECT_PRICE_MID;
    const monthsToROI = moneySaved > 0 ? Math.max(1, Math.ceil((projectPrice * 12) / moneySaved)) : 99;
    return { cappedHours, cappedPeople, isCapped, hoursSaved, moneySaved, projectPrice, monthsToROI };
  }

  // Met à jour la CSS custom property --slider-progress qui pilote
  // le linear-gradient de fill du track (entre min et current value).
  function updateSliderProgress(input: HTMLInputElement) {
    const min = Number(input.min);
    const max = Number(input.max);
    const val = Number(input.value);
    const progress = max > min ? ((val - min) / (max - min)) * 100 : 0;
    input.style.setProperty('--slider-progress', progress + '%');
  }

  // Animated number — easing rAF, identique au comportement React précédent.
  // Un seul rAF actif par élément ; setTarget annule l'ancien et repart du current.
  class AnimatedValue {
    private current: number;
    private rafId: number | null = null;
    private duration = 350;
    private element: HTMLElement;
    private formatter: (n: number) => string;

    constructor(element: HTMLElement, initial: number, formatter: (n: number) => string = formatFR) {
      this.element = element;
      this.current = initial;
      this.formatter = formatter;
    }

    setTarget(value: number, prefersReducedMotion: boolean) {
      if (value === this.current) return;
      if (prefersReducedMotion) {
        this.current = value;
        this.element.textContent = this.formatter(value);
        return;
      }
      const start = this.current;
      const diff = value - start;
      const startTime = performance.now();
      if (this.rafId !== null) cancelAnimationFrame(this.rafId);

      const animate = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / this.duration, 1);
        const eased = 1 - Math.pow(1 - progress, 4);
        this.current = Math.round(start + diff * eased);
        this.element.textContent = this.formatter(this.current);
        if (progress < 1) {
          this.rafId = requestAnimationFrame(animate);
        } else {
          this.current = value;
          this.element.textContent = this.formatter(value);
          this.rafId = null;
        }
      };
      this.rafId = requestAnimationFrame(animate);
    }
  }

  // Lit un param URL en l'élageant aux bornes du slider, fallback sur défaut.
  function readParam(name: string, min: number, max: number, fallback: number): number {
    const params = new URLSearchParams(window.location.search);
    const raw = params.get(name);
    if (raw === null) return fallback;
    const n = Number(raw);
    if (!Number.isFinite(n)) return fallback;
    return Math.min(Math.max(n, min), max);
  }

  // Met à jour l'URL sans navigation. On retire les params si on est revenu aux valeurs par défaut.
  function syncUrl(hours: number, people: number, hourlyCost: number, defaults: { hours: number; people: number; hourlyCost: number }) {
    const params = new URLSearchParams(window.location.search);
    if (hours === defaults.hours) params.delete('h'); else params.set('h', String(hours));
    if (people === defaults.people) params.delete('emp'); else params.set('emp', String(people));
    if (hourlyCost === defaults.hourlyCost) params.delete('rate'); else params.set('rate', String(hourlyCost));
    const search = params.toString();
    const url = `${window.location.pathname}${search ? '?' + search : ''}${window.location.hash}`;
    history.replaceState(null, '', url);
  }

  function initROICalc() {
    const root = document.querySelector<HTMLElement>('[data-roi-calc]');
    if (!root || root.dataset.roiInit === '1') return;
    root.dataset.roiInit = '1';

    const inputHours = root.querySelector<HTMLInputElement>('[data-roi-input="roi-hours"]');
    const inputPeople = root.querySelector<HTMLInputElement>('[data-roi-input="roi-people"]');
    const inputRate = root.querySelector<HTMLInputElement>('[data-roi-input="roi-rate"]');
    if (!inputHours || !inputPeople || !inputRate) return;

    const dispHours = root.querySelector<HTMLElement>('[data-roi-display="roi-hours"]')!;
    const dispPeople = root.querySelector<HTMLElement>('[data-roi-display="roi-people"]')!;
    const dispRate = root.querySelector<HTMLElement>('[data-roi-display="roi-rate"]')!;

    const outMoney = root.querySelector<HTMLElement>('[data-roi-output="moneySaved"]')!;
    const outHours = root.querySelector<HTMLElement>('[data-roi-output="hoursSaved"]')!;
    const outMonths = root.querySelector<HTMLElement>('[data-roi-output="monthsToROI"]')!;

    const formulaEl = root.querySelector<HTMLElement>('[data-roi-formula]')!;
    const projectPriceEl = root.querySelector<HTMLElement>('[data-roi-project-price]')!;
    const projectLabelEl = root.querySelector<HTMLElement>('[data-roi-project-label]')!;
    const warningEl = root.querySelector<HTMLElement>('[data-roi-warning]')!;

    const shareBtn = root.querySelector<HTMLButtonElement>('[data-roi-share]');
    const shareLabel = root.querySelector<HTMLElement>('[data-roi-share-label]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-roi-reset]');

    const defaults = {
      hours: Number(inputHours.value),
      people: Number(inputPeople.value),
      hourlyCost: Number(inputRate.value),
    };

    // Préinitialise depuis URL si params présents
    const initHours = readParam('h', Number(inputHours.min), Number(inputHours.max), defaults.hours);
    const initPeople = readParam('emp', Number(inputPeople.min), Number(inputPeople.max), defaults.people);
    const initRate = readParam('rate', Number(inputRate.min), Number(inputRate.max), defaults.hourlyCost);
    inputHours.value = String(initHours);
    inputPeople.value = String(initPeople);
    inputRate.value = String(initRate);

    // Sync aria-valuetext avec les valeurs effectives (URL params), sinon AT lit la valeur SSR figee
    inputHours.setAttribute('aria-valuetext', `${initHours} H`);
    inputPeople.setAttribute('aria-valuetext', `${initPeople}`);
    inputRate.setAttribute('aria-valuetext', `${initRate} €`);

    // Initialise le fill violet du track avec les valeurs effectives
    updateSliderProgress(inputHours);
    updateSliderProgress(inputPeople);
    updateSliderProgress(inputRate);

    const initialComputed = compute(initHours, initPeople, initRate);

    // Initialise les displays sliders avec les valeurs effectives
    dispHours.textContent = formatFR(initHours);
    dispPeople.textContent = formatFR(initPeople);
    dispRate.textContent = formatFR(initRate);

    // Initialise les outputs avec les valeurs computed (snap, pas d'animation au load)
    outMoney.textContent = formatFR(initialComputed.moneySaved);
    outHours.textContent = formatFR(initialComputed.hoursSaved);
    outMonths.textContent = String(initialComputed.monthsToROI);
    formulaEl.textContent = `${initialComputed.cappedHours}H × ${initialComputed.cappedPeople} EMP × 0,55 RÉCUP × 48 SEM × ${initRate}€`;
    projectPriceEl.textContent = formatFR(initialComputed.projectPrice);
    projectLabelEl.textContent = initialComputed.moneySaved < 20000 ? 'WORKFLOW' : 'MISSION COMPLÈTE';
    warningEl.hidden = !initialComputed.isCapped;

    const animMoney = new AnimatedValue(outMoney, initialComputed.moneySaved);
    const animHours = new AnimatedValue(outHours, initialComputed.hoursSaved);
    const animMonths = new AnimatedValue(outMonths, initialComputed.monthsToROI, (n) => String(n));

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    function update() {
      const hours = Number(inputHours!.value);
      const people = Number(inputPeople!.value);
      const hourlyCost = Number(inputRate!.value);

      dispHours.textContent = formatFR(hours);
      dispPeople.textContent = formatFR(people);
      dispRate.textContent = formatFR(hourlyCost);
      inputHours!.setAttribute('aria-valuetext', `${hours} H`);
      inputPeople!.setAttribute('aria-valuetext', `${people}`);
      inputRate!.setAttribute('aria-valuetext', `${hourlyCost} €`);

      updateSliderProgress(inputHours!);
      updateSliderProgress(inputPeople!);
      updateSliderProgress(inputRate!);

      const c = compute(hours, people, hourlyCost);
      const reducedMotion = motionQuery.matches;

      animMoney.setTarget(c.moneySaved, reducedMotion);
      animHours.setTarget(c.hoursSaved, reducedMotion);
      animMonths.setTarget(c.monthsToROI, reducedMotion);

      formulaEl.textContent = `${c.cappedHours}H × ${c.cappedPeople} EMP × 0,55 RÉCUP × 48 SEM × ${hourlyCost}€`;
      projectPriceEl.textContent = formatFR(c.projectPrice);
      projectLabelEl.textContent = c.moneySaved < 20000 ? 'WORKFLOW' : 'MISSION COMPLÈTE';
      warningEl.hidden = !c.isCapped;

      syncUrl(hours, people, hourlyCost, defaults);
    }

    inputHours.addEventListener('input', update);
    inputPeople.addEventListener('input', update);
    inputRate.addEventListener('input', update);

    // Bouton « Copier le lien »
    if (shareBtn && shareLabel) {
      let resetTimer: number | null = null;
      shareBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          shareLabel.textContent = 'LIEN COPIÉ ✓';
          if (resetTimer !== null) window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            shareLabel.textContent = 'COPIER LE LIEN DE CE CALCUL';
          }, 1500);
        } catch (err) {
          shareLabel.textContent = 'COPIE IMPOSSIBLE — SÉLECTIONNEZ L\'URL';
        }
      });
    }

    // Bouton « Réinitialiser » : remet les sliders à leurs valeurs par défaut
    // et nettoie l'URL des query params.
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        inputHours.value = String(defaults.hours);
        inputPeople.value = String(defaults.people);
        inputRate.value = String(defaults.hourlyCost);
        update();
        const url = new URL(window.location.href);
        url.search = '';
        window.history.replaceState(null, '', url.toString());
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initROICalc);
  } else {
    initROICalc();
  }
  document.addEventListener('astro:page-load', initROICalc);
</script>
