---
/*
 * HeroManifesto — aplat lime, typographie seule.
 *
 * Le portrait a été retiré : sur le lime il formait la masse la plus contrastée
 * de la page — davantage que le H1 — et sa chemise lilas touchait le lime à
 * l'opposition sur la roue. Il était de toute façon absent en mobile. On fait
 * donc en desktop ce que le site faisait déjà en petit format, et mieux : la
 * couleur et l'échelle du titre portent seules. La photo reste là où elle sert,
 * à côté de la bio dans le bloc contact.
 */
import LinkCTA from './LinkCTA.astro';

---

<section
  id="hero"
  data-section
  class="bloc-lime relative pt-[80px] md:pt-[88px] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto pt-10 md:pt-24 pb-12 md:pb-[var(--spacing-section-y)] flex flex-col justify-center lg:block lg:min-h-0">

    <div class="grid grid-cols-1">

      <!-- Statement — sur papier nu, sans carte -->
      <div data-hero-stagger class="flex flex-col gap-6 md:gap-7">

        <span class="reveal eyebrow-rule mono-caption text-[var(--color-ink-low)]" style="text-transform: none;">
          Freelance et Formateur en IA &amp; Automatisations
        </span>

        <h1 class="reveal hero-manifesto-h1 font-display font-semibold text-[var(--color-ink)] m-0">
          J'automatise ce que vos équipes font encore <mark>à la main.</mark>
        </h1>

        <p class="reveal text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 max-w-[48ch]">
          Workflows n8n &amp; Make, agents IA et outils métiers sur-mesure avec
          Claude Code. En production, et qui tiennent.
        </p>

        <div class="reveal flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full sm:w-auto"
            data-fast-goal="lead_call"
            data-fast-goal-source="hero"
          >
            Réserver un appel · 20 min
          </a>
          <LinkCTA href="#contact-form">M'écrire</LinkCTA>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .hero-manifesto-h1 {
    font-size: var(--text-display-hero);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
    max-width: 19ch;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  @media (min-width: 1024px) {
    .hero-manifesto-h1 {
      font-size: var(--text-display-hero-lg);
    }
  }

  /* Portrait : ratio fixe portrait, hauteur maîtrisée sur mobile et desktop. */

  /* Photo en couleur. Mirror horizontal : Lilian regarde vers le titre à gauche. */

  /* Dark mode : bordure plus visible pour matérialiser le crop de la photo. */
</style>
