---
/*
 * HeroManifesto — alternative au Hero standard
 *
 * Lane A (Manifesto) du shape brief : H1 oversize aphoristique,
 * sous-titre branding + IA, mono-signature proof, un seul CTA.
 * Pas de stats grid, pas de metric inline, pas de chips outils
 * (réservées à la section Stack).
 */
---

<section
  id="hero"
  data-section
  class="relative pt-[80px] md:pt-[88px]"
>
  <div class="relative max-w-[1200px] mx-auto px-[var(--spacing-section-x)] pt-12 md:pt-20 pb-[var(--spacing-section-y)]">

    <!-- Eyebrow chip — version courte mobile, longue desktop -->
    <div class="reveal mb-6 md:mb-8 inline-block bg-[var(--color-paper)] py-1.5 pr-2">
      <span class="mono-caption text-[var(--color-ink-low)]">
        <span class="md:hidden">EX-LEAD OPS · 8 ANS · MAKE LV5</span>
        <span class="hidden md:inline">EX-LEAD OPS · 8 ANS NO-CODE · MAKE CERTIFIÉ NIVEAU 5</span>
      </span>
    </div>

    <!-- Manifesto block — H1 oversize + sous-titre + mono-signature -->
    <div class="hero-manifesto-block relative reveal mb-10 md:mb-12 bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] max-w-[64ch] p-6 md:p-8">
      <span class="grid-corner tl" aria-hidden="true"></span>
      <span class="grid-corner tr" aria-hidden="true"></span>
      <span class="grid-corner bl" aria-hidden="true"></span>
      <span class="grid-corner br" aria-hidden="true"></span>

      <h1
        class="hero-manifesto-h1 font-display font-semibold text-[var(--color-ink)] m-0 max-w-[18ch]"
      >
        Vos opérations tournent toutes seules.
      </h1>

      <div class="border-t border-[var(--color-divider)] mt-6 md:mt-7 pt-5 md:pt-6">
        <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 max-w-[60ch]">
          Lilian Sevoumian conçoit des automatisations Make, n8n et Airtable,
          infusées Claude. 8 ans à brancher des outils ensemble.
        </p>

        <div class="mono-caption text-[var(--color-ink-low)] mt-4 md:mt-5">
          500+ AUTOMATIONS · 8 ANS
        </div>
      </div>
    </div>

    <!-- CTA unique -->
    <div class="reveal mb-16 md:mb-20">
      <a
        href="https://cal.com/lilian-sevoumian/20min"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        Réserver un appel · 30 min
      </a>
    </div>

    <!-- Microdata strip — séparateurs masqués en mobile pour éviter les "·" orphelins en wrap -->
    <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-2 mono-caption text-[var(--color-ink-low)]">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-violet)] inline-block"></span>
        DISPONIBLE MAI 2026
      </span>
      <span class="hidden md:inline" aria-hidden="true">·</span>
      <span>BASÉ À PARIS · REMOTE-FIRST</span>
      <span class="hidden md:inline" aria-hidden="true">·</span>
      <span>FR / EN</span>
    </div>

  </div>
</section>

<style>
  .hero-manifesto-h1 {
    font-size: clamp(2.5rem, 6vw + 0.5rem, 5.75rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
</style>
