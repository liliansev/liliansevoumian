---
/*
 * HeroManifesto — split 2 cards same-height :
 *   gauche  : statement (eyebrow + H1 + sous-titre + microdata + CTA)
 *   droite  : photo de Lilian (no animation, static portrait)
 *
 * Mobile (<lg) : single column, photo stack en dessous.
 * Desktop (lg+) : split 1.5fr/1fr, items-stretch pour hauteur égale.
 *
 * Photo via <Image> d'astro:assets pour optimisation auto (WebP/AVIF +
 * srcset multi-widths). L'asset vit dans src/assets/ (pas public/) pour
 * traverser le pipeline d'optimisation.
 */
import { Picture } from 'astro:assets';
import lilianPhoto from '../assets/lilian-photo.jpg';
---

<section
  id="hero"
  data-section
  data-hero-stagger
  class="relative pt-[80px] md:pt-[88px]"
>
  <div class="relative max-w-[1200px] mx-auto px-[var(--spacing-section-x)] pt-12 md:pt-20 pb-[var(--spacing-section-y)]">

    <!-- Eyebrow chip — version courte mobile, longue desktop -->
    <div class="reveal mb-6 md:mb-8 inline-block bg-[var(--color-paper)] py-1.5 pr-2">
      <span class="mono-caption text-[var(--color-ink-low)]">
        <span class="md:hidden">LEAD OPS FREELANCE · IA & AUTOMATION</span>
        <span class="hidden md:inline">LEAD OPS FREELANCE DEPUIS 2020 · EXPERT IA & AUTOMATION</span>
      </span>
    </div>

    <!-- Split 2 cards même hauteur (lg:items-stretch) -->
    <div class="reveal grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-6 lg:gap-8 lg:items-stretch mb-10 md:mb-16">

      <!-- Hero block — statement autonome : H1 + sous-titre + microdata + CTA -->
      <div class="hero-manifesto-block relative bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] p-6 md:p-8 flex flex-col gap-6 md:gap-7">
        <span class="grid-corner tl" aria-hidden="true"></span>
        <span class="grid-corner tr" aria-hidden="true"></span>
        <span class="grid-corner bl" aria-hidden="true"></span>
        <span class="grid-corner br" aria-hidden="true"></span>

        <h1
          class="hero-manifesto-h1 font-display font-semibold text-[var(--color-ink)] m-0 max-w-[18ch]"
        >
          Automatisez 15&nbsp;h par semaine grâce à l'IA et l'automation.
        </h1>

        <div class="border-t border-[var(--color-divider)] pt-5 md:pt-6">
          <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 max-w-[60ch]">
            Je réalise des workflows n8n, Make et j'utilise Claude Code
            pour créer des applications métiers.
          </p>

          <div class="mono-caption text-[var(--color-ink-low)] mt-4 md:mt-5">
            500+ WORKFLOWS · 2 000 H /MOIS · 8 ANS
          </div>
        </div>

        <div class="border-t border-[var(--color-divider)] pt-5 md:pt-6 mt-auto flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full sm:w-auto"
          >
            Réserver un appel · 20 min
          </a>
          <span class="mono-caption text-[var(--color-ink-low)]">BASÉ À PARIS · REMOTE-FIRST</span>
        </div>
      </div>

      <!-- Portrait Lilian — card paper-bordée même hauteur, photo cover -->
      <div class="hero-portrait relative bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] overflow-hidden">
        <span class="grid-corner tl" aria-hidden="true"></span>
        <span class="grid-corner tr" aria-hidden="true"></span>
        <span class="grid-corner bl" aria-hidden="true"></span>
        <span class="grid-corner br" aria-hidden="true"></span>

        <Picture
          src={lilianPhoto}
          alt="Lilian Sevoumian, expert no-code freelance"
          class="hero-portrait-img block w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          formats={['avif', 'webp']}
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 40vw, 100vw"
        />
      </div>

    </div>

  </div>
</section>

<style>
  .hero-manifesto-h1 {
    font-size: var(--text-display-hero);
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  /* À partir de lg, on resserre légèrement le H1 pour respirer face à la photo */
  @media (min-width: 1024px) {
    .hero-manifesto-h1 {
      font-size: var(--text-display-hero-lg);
    }
  }

  /* Portrait card : la photo couvre toute la card sur desktop, hauteur
     dictée par hero-manifesto-block. Sur mobile, hauteur fixe pour ne
     pas déborder. */
  .hero-portrait {
    min-height: 320px;
  }
  @media (min-width: 1024px) {
    .hero-portrait {
      min-height: 0;
    }
  }

  /* Mirror horizontal pour que Lilian regarde vers le titre à gauche. */
  .hero-portrait-img {
    transform: scaleX(-1);
  }

  /* Dark mode : bordure plus visible pour materialiser le crop de la photo (sinon se fond dans le bg). */
  :global(html.dark) .hero-portrait {
    border-color: var(--color-grid-line-active);
  }
</style>
