---
/*
 * HeroManifesto — refonte "Vercel" (juin 2026).
 *   Dé-boxé : le statement (eyebrow + H1 + sous-titre + CTA + microdata) flotte
 *   directement sur le papier, sans carte bordée. Le portrait est le seul visuel,
 *   traité en noir & blanc (couleur révélée au survol) pour tenir le monochrome.
 *
 * Mobile (<lg) : colonne unique, photo en dessous.
 * Desktop (lg+) : split 1.35fr / 1fr, aligné au centre vertical.
 *
 * Photo via <Picture> d'astro:assets (AVIF/WebP + srcset). Asset dans src/assets/.
 */
import { Picture } from 'astro:assets';
import lilianPhoto from '../assets/lilian-photo.jpg';
---

<section
  id="hero"
  data-section
  class="relative pt-[80px] md:pt-[88px] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto pt-14 md:pt-24 pb-[var(--spacing-section-y)]">

    <div class="grid grid-cols-1 lg:grid-cols-[1.35fr_1fr] gap-10 lg:gap-16 lg:items-center">

      <!-- Statement — sur papier nu, sans carte -->
      <div data-hero-stagger class="flex flex-col gap-6 md:gap-7">

        <span class="reveal mono-caption text-[var(--color-ink-low)]">
          <span class="md:hidden">LEAD OPS FREELANCE · IA &amp; AUTOMATION</span>
          <span class="hidden md:inline">LEAD OPS FREELANCE DEPUIS 2020 · EXPERT IA &amp; AUTOMATION</span>
        </span>

        <h1 class="reveal hero-manifesto-h1 font-display font-semibold text-[var(--color-ink)] m-0">
          Freelance et formateur en IA et automation
        </h1>

        <p class="reveal text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 max-w-[48ch]">
          J'automatise vos processus avec des workflows n8n, Make et des agents IA,
          et je crée vos outils métiers avec Claude Code.
        </p>

        <div class="reveal flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
          <a href="#contact-form" class="btn-primary w-full sm:w-auto">
            Me contacter
          </a>
          <a href="/cas-clients" class="btn-ghost w-full sm:w-auto">
            Voir les cas clients
          </a>
        </div>

        <div class="reveal mono-caption text-[var(--color-ink-low)] pt-1">
          500+ WORKFLOWS · 2&nbsp;000&nbsp;H AUTOMATISÉES /MOIS · MAKE CERTIFIÉ N5
        </div>

      </div>

      <!-- Portrait — seul visuel, noir & blanc, couleur au survol -->
      <div class="reveal hero-portrait relative rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-divider)]">
        <Picture
          src={lilianPhoto}
          alt="Lilian Sevoumian, freelance automatisation et IA (n8n, Make)"
          class="hero-portrait-img block w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          formats={['avif', 'webp']}
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 30vw, 100vw"
        />
      </div>

    </div>

  </div>
</section>

<style>
  .hero-manifesto-h1 {
    font-size: var(--text-display-hero);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
    max-width: 17ch;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  @media (min-width: 1024px) {
    .hero-manifesto-h1 {
      font-size: var(--text-display-hero-lg);
    }
  }

  /* Portrait : ratio fixe portrait, hauteur maîtrisée sur mobile et desktop. */
  .hero-portrait {
    aspect-ratio: 4 / 5;
  }

  /* N&B par défaut, couleur révélée au survol (interaction Vercel/Linear).
     Mirror horizontal : Lilian regarde vers le titre à gauche. */
  .hero-portrait-img {
    transform: scaleX(-1);
    filter: grayscale(1) contrast(1.03);
    transition: filter 600ms var(--ease-out-quint);
  }

  .hero-portrait:hover .hero-portrait-img {
    filter: grayscale(0) contrast(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-portrait-img { transition: none; }
  }

  /* Dark mode : bordure plus visible pour matérialiser le crop de la photo. */
  :global(html.dark) .hero-portrait {
    border-color: var(--color-grid-line-active);
  }
</style>
