---
/*
 * HeroManifesto — Lane A du shape brief, augmentée d'un workflow live à droite.
 *
 * Structure desktop (lg+) :
 *   eyebrow chip
 *   ┌─ grid lg:grid-cols-[1.4fr_1fr] ──────────────┐
 *   │  hero block (paper bordé, H1+divider+        │  workflow block (paper bordé)
 *   │  sous-titre+mono-sig)                        │  → 4 nodes anim en boucle (LEAD→SCORE→ALERTE→LOG)
 *   │  CTA primary                                 │  → mono caption "EXÉCUTION ~ 2.4 S"
 *   └──────────────────────────────────────────────┘
 *   microdata strip
 *
 * Mobile (<lg) : single column, workflow stack en dessous du hero block.
 *
 * Animation workflow : init via [data-workflow] dans le script de CaseStudy.astro,
 * mêmes classes (workflow-flow, workflow-dot, workflow-pulse, workflow-link)
 * définies dans global.css.
 *
 * data-hero-stagger garde son rôle : stagger eyebrow → grid → CTA → microdata.
 */
---

<section
  id="hero"
  data-section
  data-hero-stagger
  class="relative pt-[80px] md:pt-[88px]"
>
  <div class="relative max-w-[1200px] mx-auto px-[var(--spacing-section-x)] pt-12 md:pt-20 pb-[var(--spacing-section-y)]">

    <!-- Eyebrow chip — version courte mobile, longue desktop -->
    <div class="reveal mb-6 md:mb-8 inline-block bg-[var(--color-paper)] py-1.5 pr-2">
      <span class="mono-caption text-[var(--color-ink-low)]">
        <span class="md:hidden">EX-LEAD OPS · 8 ANS · MAKE LV5</span>
        <span class="hidden md:inline">EX-LEAD OPS · 8 ANS NO-CODE · MAKE CERTIFIÉ NIVEAU 5</span>
      </span>
    </div>

    <!-- Split layout : hero block gauche + workflow live droite -->
    <div class="reveal grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-6 lg:gap-8 mb-10 md:mb-12">

      <!-- Hero block — H1 + sous-titre + mono-signature -->
      <div class="hero-manifesto-block relative bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] p-6 md:p-8">
        <span class="grid-corner tl" aria-hidden="true"></span>
        <span class="grid-corner tr" aria-hidden="true"></span>
        <span class="grid-corner bl" aria-hidden="true"></span>
        <span class="grid-corner br" aria-hidden="true"></span>

        <h1
          class="hero-manifesto-h1 font-display font-semibold text-[var(--color-ink)] m-0 max-w-[18ch]"
        >
          Vos opérations tournent toutes seules.
        </h1>

        <div class="border-t border-[var(--color-divider)] mt-6 md:mt-7 pt-5 md:pt-6">
          <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 max-w-[60ch]">
            Lilian Sevoumian conçoit des automatisations Make, n8n et Airtable,
            infusées Claude. 8 ans à brancher des outils ensemble.
          </p>

          <div class="mono-caption text-[var(--color-ink-low)] mt-4 md:mt-5">
            500+ AUTOMATIONS · 8 ANS
          </div>
        </div>
      </div>

      <!-- Workflow live — version hero universelle, 3 nodes (TRIGGER → IA → ACTION),
           cadence rapide via data-step-delay + data-link-fill (~1s par cycle).
           Le case study en bas a sa version 4-nodes spécifique au cas client (~2.4s). -->
      <div
        class="relative bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] p-5 md:p-6 flex flex-col"
        data-workflow
        data-step-delay="200"
        data-link-fill="150"
      >
        <span class="grid-corner tl" aria-hidden="true"></span>
        <span class="grid-corner tr" aria-hidden="true"></span>
        <span class="grid-corner bl" aria-hidden="true"></span>
        <span class="grid-corner br" aria-hidden="true"></span>

        <div class="mono-caption text-[var(--color-ink-low)] mb-4">WORKFLOW LIVE</div>

        <div class="workflow-flow flex items-stretch justify-between gap-1 my-auto">
          <!-- Node 1 — TRIGGER (violet, input/event) -->
          <div class="workflow-node flex flex-col items-center gap-2 flex-1 min-w-0">
            <div class="workflow-dot relative w-9 h-9 rounded-full border border-[var(--color-divider)] bg-[var(--color-paper)] flex items-center justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-ink-mid)]" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
              <span class="workflow-pulse absolute inset-0 rounded-full border border-[var(--color-violet)] opacity-0"></span>
            </div>
            <span class="mono-caption text-[var(--color-ink-low)] text-center leading-tight whitespace-nowrap">TRIGGER</span>
          </div>

          <div class="workflow-link flex-1 self-center h-px bg-[var(--color-divider)] relative overflow-hidden -mt-5">
            <span class="workflow-link-fill absolute inset-y-0 left-0 w-0 bg-[var(--color-violet)] transition-[width] duration-150 ease-out"></span>
          </div>

          <!-- Node 2 — IA (ember, intelligence) -->
          <div class="workflow-node flex flex-col items-center gap-2 flex-1 min-w-0">
            <div class="workflow-dot relative w-9 h-9 rounded-full border border-[var(--color-divider)] bg-[var(--color-ember-soft)] flex items-center justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-ember-deep)]" aria-hidden="true">
                <path d="M12 2 L2 7 L12 12 L22 7 Z"/>
                <path d="M2 17 L12 22 L22 17"/>
                <path d="M2 12 L12 17 L22 12"/>
              </svg>
              <span class="workflow-pulse absolute inset-0 rounded-full border border-[var(--color-ember)] opacity-0"></span>
            </div>
            <span class="mono-caption text-[var(--color-ink-low)] text-center leading-tight whitespace-nowrap">IA</span>
          </div>

          <div class="workflow-link flex-1 self-center h-px bg-[var(--color-divider)] relative overflow-hidden -mt-5">
            <span class="workflow-link-fill absolute inset-y-0 left-0 w-0 bg-[var(--color-violet)] transition-[width] duration-150 ease-out"></span>
          </div>

          <!-- Node 3 — ACTION (violet, output) -->
          <div class="workflow-node flex flex-col items-center gap-2 flex-1 min-w-0">
            <div class="workflow-dot relative w-9 h-9 rounded-full border border-[var(--color-divider)] bg-[var(--color-violet-soft)] flex items-center justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-violet-deep)]" aria-hidden="true">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
              </svg>
              <span class="workflow-pulse absolute inset-0 rounded-full border border-[var(--color-violet)] opacity-0"></span>
            </div>
            <span class="mono-caption text-[var(--color-ink-low)] text-center leading-tight whitespace-nowrap">ACTION</span>
          </div>
        </div>

        <!-- Bottom row — exécution time, plus rapide que le case study -->
        <div class="mt-5 pt-4 border-t border-[var(--color-divider)] flex items-center justify-between">
          <span class="mono-caption text-[var(--color-ink-low)]">EXÉCUTION</span>
          <span class="mono-caption text-[var(--color-violet)]">~ 1 S</span>
        </div>
      </div>

    </div>

    <!-- CTA unique -->
    <div class="reveal mb-16 md:mb-20">
      <a
        href="https://cal.com/lilian-sevoumian/20min"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary w-full sm:w-auto"
      >
        Réserver un appel · 30 min
      </a>
    </div>

    <!-- Microdata strip -->
    <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-2 mono-caption text-[var(--color-ink-low)]">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-violet)] inline-block"></span>
        DISPONIBLE MAI 2026
      </span>
      <span class="hidden md:inline" aria-hidden="true">·</span>
      <span>BASÉ À PARIS · REMOTE-FIRST</span>
      <span class="hidden md:inline" aria-hidden="true">·</span>
      <span>FR / EN</span>
    </div>

  </div>
</section>

<style>
  .hero-manifesto-h1 {
    font-size: clamp(2.5rem, 6vw + 0.5rem, 5.75rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  /* À partir de lg, on resserre légèrement le H1 pour respirer face au workflow */
  @media (min-width: 1024px) {
    .hero-manifesto-h1 {
      font-size: clamp(2.5rem, 5vw + 0.5rem, 4.75rem);
    }
  }
</style>
