---
/*
 * HeroManifesto — refonte "Vercel" (juin 2026).
 *   Dé-boxé : le statement (eyebrow + H1 + sous-titre + CTA + microdata) flotte
 *   directement sur le papier, sans carte bordée. Le portrait couleur est le seul
 *   visuel et le seul point de couleur de la page (choix assumé).
 *
 * Mobile (<lg) : colonne unique, photo en dessous.
 * Desktop (lg+) : split 1.35fr / 1fr, aligné au centre vertical.
 *
 * Photo via <Picture> d'astro:assets (AVIF/WebP + srcset). Asset dans src/assets/.
 */
import { Picture } from 'astro:assets';
import LinkCTA from './LinkCTA.astro';
import lilianPhoto from '../assets/lilian-photo.jpg';
---

<section
  id="hero"
  data-section
  class="relative pt-[80px] md:pt-[88px] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto pt-14 md:pt-24 pb-[var(--spacing-section-y)] flex flex-col justify-center min-h-[calc(100svh-80px)] lg:block lg:min-h-0">

    <div class="grid grid-cols-1 lg:grid-cols-[1.35fr_1fr] gap-10 lg:gap-16 lg:items-center">

      <!-- Statement — sur papier nu, sans carte -->
      <div data-hero-stagger class="flex flex-col gap-6 md:gap-7">

        <span class="reveal eyebrow-rule mono-caption text-[var(--color-ink-low)]" style="text-transform: none;">
          Freelance et Formateur en IA &amp; Automatisations
        </span>

        <h1 class="reveal hero-manifesto-h1 font-display font-semibold text-[var(--color-ink)] m-0">
          J'automatise ce que vos équipes font encore à la main.
        </h1>

        <p class="reveal text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 max-w-[48ch]">
          Workflows n8n &amp; Make, agents IA et outils métiers sur-mesure avec
          Claude Code. En production, et qui tiennent.
        </p>

        <div class="reveal flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full sm:w-auto"
            data-fast-goal="lead_call"
            data-fast-goal-source="hero"
          >
            Réserver un appel · 20 min
          </a>
          <LinkCTA href="#contact-form">M'écrire</LinkCTA>
        </div>

      </div>

      <!-- Portrait couleur — seul visuel et seul point de couleur de la page (assumé).
           Masqué sur mobile : la photo y est reprise en avatar dans la nav (dès qu'on dépasse le Hero). -->
      <div class="reveal hero-portrait relative hidden lg:block rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-divider)]">
        <Picture
          src={lilianPhoto}
          alt="Lilian Sevoumian, freelance automatisation et IA (n8n, Make)"
          class="hero-portrait-img block w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          formats={['avif', 'webp']}
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 30vw, 100vw"
        />
      </div>

    </div>

  </div>
</section>

<style>
  .hero-manifesto-h1 {
    font-size: var(--text-display-hero);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
    max-width: 20ch;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  @media (min-width: 1024px) {
    .hero-manifesto-h1 {
      font-size: var(--text-display-hero-lg);
    }
  }

  /* Portrait : ratio fixe portrait, hauteur maîtrisée sur mobile et desktop. */
  .hero-portrait {
    aspect-ratio: 4 / 5;
  }

  /* Photo en couleur. Mirror horizontal : Lilian regarde vers le titre à gauche. */
  .hero-portrait-img {
    transform: scaleX(-1);
  }

  /* Dark mode : bordure plus visible pour matérialiser le crop de la photo. */
  :global(html.dark) .hero-portrait {
    border-color: var(--color-grid-line-active);
  }
</style>
