---
/*
 * HeroManifesto — version "airy" (réf. nouveau vercel.com).
 *
 * Plus de cards bordées ni de filets : la structure vient de l'échelle et du
 * vide. Statement géant à gauche, portrait qui flotte à droite (sans cadre,
 * posé sur le papier avec une lueur violette douce). Double CTA en pilule.
 *
 * Mobile (<lg) : single column, portrait sous le statement.
 * Desktop (lg+) : split asymétrique 1.15fr / 0.85fr, vertical-center.
 */
import { Picture } from 'astro:assets';
import lilianPhoto from '../assets/lilian-photo.jpg';
---

<section
  id="hero"
  data-section
  class="relative px-[var(--spacing-section-x)] pt-[120px] md:pt-[160px] pb-[var(--spacing-section-y)] overflow-hidden"
>
  <div class="relative max-w-[1200px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-12 lg:gap-20 items-center">

      <!-- Statement — entrée en stagger (eyebrow → titre → texte → CTA → preuve) -->
      <div class="reveal-stagger flex flex-col gap-7 md:gap-9 order-2 lg:order-1">
        <span class="reveal mono-caption text-[var(--color-ink-low)]">
          LEAD OPS FREELANCE · IA &amp; AUTOMATION DEPUIS 2020
        </span>

        <h1 class="reveal hero-manifesto-h1 font-display font-semibold text-[var(--color-ink)] m-0 max-w-[15ch]">
          Freelance et formateur en <span class="hero-h1-accent">IA et automation</span>
        </h1>

        <p class="reveal text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 max-w-[46ch]">
          J'automatise vos processus avec des workflows n8n, Make et des agents IA,
          et je crée vos outils métiers avec Claude Code.
        </p>

        <div class="reveal flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
          <a href="#contact-form" class="btn-primary w-full sm:w-auto">
            Me contacter
          </a>
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost w-full sm:w-auto"
            data-fast-goal="lead_call"
            data-fast-goal-source="hero"
          >
            Réserver un appel · 20 min
          </a>
        </div>

        <div class="reveal mono-caption text-[var(--color-ink-low)] leading-[1.7]">
          <span class="text-[var(--color-violet-deep)]">500+</span> WORKFLOWS ·
          <span class="text-[var(--color-violet-deep)]">2&nbsp;000&nbsp;H</span> AUTOMATISÉES /MOIS ·
          MAKE CERTIFIÉ N5
        </div>
      </div>

      <!-- Portrait — flotte sur le papier, sans cadre, lueur violette douce -->
      <div class="reveal hero-portrait relative order-1 lg:order-2 mx-auto lg:mx-0">
        <div class="hero-portrait-glow" aria-hidden="true"></div>
        <Picture
          src={lilianPhoto}
          alt="Lilian Sevoumian, freelance automatisation et IA (n8n, Make)"
          class="hero-portrait-img"
          loading="eager"
          fetchpriority="high"
          formats={['avif', 'webp']}
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 40vw, 80vw"
        />
      </div>

    </div>
  </div>
</section>

<style>
  .hero-manifesto-h1 {
    font-size: var(--text-display-hero);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  @media (min-width: 1024px) {
    .hero-manifesto-h1 {
      font-size: var(--text-display-hero-lg);
    }
  }

  /* Emphasis par couleur (No-Italic Rule respectée). */
  .hero-manifesto-h1 .hero-h1-accent {
    color: var(--color-violet-deep);
  }

  /* Portrait sans cadre : ratio portrait, coins francs, miroir pour regarder
     vers le statement à gauche. Pas de bordure ni d'ombre (no-shadow rule). */
  .hero-portrait {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 1024px) {
    .hero-portrait {
      max-width: none;
    }
  }

  .hero-portrait-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
  }

  /* Lueur violette diffuse derrière le portrait — présence "hero visual" façon
     Vercel (leur triangle a un halo), sans box-shadow. */
  .hero-portrait-glow {
    position: absolute;
    inset: -22% -26%;
    z-index: 0;
    background: radial-gradient(
      ellipse at 50% 42%,
      var(--color-violet-soft) 0%,
      color-mix(in oklch, var(--color-violet-soft) 55%, transparent) 38%,
      transparent 72%
    );
    filter: blur(48px);
    opacity: 1;
    pointer-events: none;
    animation: hero-glow-breathe 8s ease-in-out infinite;
  }

  /* Respiration lente du halo — présence "hero visual" façon Vercel, très discrète. */
  @keyframes hero-glow-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.06); }
  }

  :global(html.dark) .hero-portrait-glow {
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-portrait-glow {
      animation: none;
    }
  }
</style>
