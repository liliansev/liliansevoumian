---
/*
 * HeroManifesto — l'ouverture de /automatisations-ia, sur la nuit : un titre,
 * ce qui est livré, le bouton. Typographie seule, sans portrait.
 *
 * L'id `hero` est observé par la barre de navigation (`trackHero`) : il reste.
 */
import LinkCTA from './LinkCTA.astro';
import Outil from './Outil.astro';
import BoutonReservation from './BoutonReservation.astro';
import { DUREE_RESERVATION_MINUTES, LIBELLE_CONTACT_RESERVATION } from '../lib/reservation';
---

<section
  id="hero"
  data-section
  class="hero-grille relative overflow-hidden px-[var(--spacing-section-x)] pt-[var(--spacing-barre)]"
>
  {/* Les `.reveal` sont les enfants directs de `data-hero-stagger` : c'est leur
      rang qui règle la cascade d'entrée (voir global.css). */}
  <div data-hero-stagger class="relative mx-auto max-w-[1200px] py-[var(--spacing-section-y)]">
    {/* Le h1 n'est pas un `.reveal`, et c'est voulu : peint à opacité 0 par le
        voile, il ne serait plus candidat au LCP, et le message principal de la
        page dépendrait d'un module JavaScript. Il est là dès la première
        image ; seuls le chapô, les boutons et la note entrent en cascade. */}
    <h1 class="hero-manifesto-h1 m-0">
      J’automatise ce que vos équipes font encore <mark>à la main.</mark>
    </h1>

    {/* Le chapô porte ce que le titre ne dit pas : les tâches, puis ce sur quoi
        l'on est expert. Il ne nomme ni taille d'entreprise ni intitulé de
        poste : il dit à qui l'on parle sans dire à qui l'on ne parle pas. */}
    <p class="reveal m-0 mt-[var(--spacing-lie)] max-w-[43ch] text-[length:var(--text-body-large)] leading-[1.5] text-[var(--color-ink-mid)]">
      Ressaisir des données, trier des demandes, relancer des clients&nbsp;:
      ces tâches prennent de la place quand l’activité grandit.
      Je suis freelance et je les automatise avec <Outil icon="simple-icons:n8n">n8n</Outil>,
      <Outil icon="simple-icons:make">Make</Outil> et des agents IA.
    </p>

    <div class="reveal mt-[var(--spacing-groupe)] flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
      <BoutonReservation source="hero" class="btn-primary w-full sm:w-auto">
        {LIBELLE_CONTACT_RESERVATION}
      </BoutonReservation>
      <LinkCTA href="#cas">Voir les cas clients</LinkCTA>
    </div>

    {/* Ce que le bouton ouvre, dit dans une phrase à côté de lui : une
        conversation, pas l'agenda. Mêmes mots qu'en fin de page. */}
    <p class="reveal m-0 mt-3 text-[length:var(--text-body-sm)] leading-[1.5] text-[var(--color-ink-mid)]">
      Écrivez une phrase, je vous réponds moi-même. Vous choisissez ensuite comment me joindre&nbsp;:
      WhatsApp, e-mail ou un appel de {DUREE_RESERVATION_MINUTES}&nbsp;minutes en visio, sans engagement.
    </p>
  </div>
</section>

<style>
  /* La trame du hero : un quadrillage à la maille de 96 px
     (`--spacing-grid-cell`), posé derrière le premier écran, du côté droit.

     Le masque la garde à droite : elle se dissipe à 24 % depuis le bord, donc
     avant le point où s'arrête la ligne la plus longue du titre (72 % de la
     largeur). Derrière un titre de cette taille, un quadrillage se lit comme
     du bruit. */
  .hero-grille::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    --trait: color-mix(in srgb, var(--color-ink) 5%, transparent);
    background-image:
      linear-gradient(to right, var(--trait) 1px, transparent 1px),
      linear-gradient(to bottom, var(--trait) 1px, transparent 1px);
    background-size: var(--spacing-grid-cell) var(--spacing-grid-cell);
    -webkit-mask-image: linear-gradient(to left, var(--color-night) 0%, transparent 24%);
    mask-image: linear-gradient(to left, var(--color-night) 0%, transparent 24%);
  }

  /* Pas de trame sous 1024 px : le texte y occupe toute la largeur, et aucun
     réglage ne la rendait à la fois visible et inoffensive. */
  @media (max-width: 1023px) {
    .hero-grille::before { display: none; }
  }

  /* La graisse, l'interligne et l'approche viennent de la tenue commune
     (global.css) ; seuls la taille et le plafond de largeur sont d'ici. */
  .hero-manifesto-h1 {
    max-width: 19ch;
    /* Sous 360 px de large, « J’automatise » ne tient plus sur une ligne au
       plancher du jeton (52 px) et se coupait en deux : le titre suit alors la
       largeur de l'écran. Au-delà, c'est le jeton qui décide. */
    font-size: min(var(--text-display-hero), 14.5vw);
    /* Garde-fou : un mot trop long se replie, sans tiret, plutôt que de sortir
       de l'écran. */
    overflow-wrap: break-word;
  }

  /* Le trait sous le titre se tire sans passer par `.reveal` ni par
     `.entree`, puisque le h1 reste peint dès la première image : on rejoue sur
     le seul fragment les `@keyframes mark-trace` de global.css. Sans
     `.js-ready` ou en mouvement réduit, il est simplement souligné.
     420 ms : le chapô et les boutons sont en train d'arriver. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-ready) .hero-manifesto-h1 mark {
      animation: mark-trace var(--duration-trace) var(--ease-out-expo) backwards;
      animation-delay: 420ms;
    }
  }
</style>
