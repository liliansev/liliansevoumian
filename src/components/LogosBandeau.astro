---
const clients = [
  "CasanovaParis",
  "Contournement",
  "Quanteam",
  "MUSIC.AI",
  "Elpis AI",
];
---

<!-- Logos bandeau -->
<section class="py-10 md:py-14 px-[var(--spacing-section-x)]" style="background: #000000;">
  <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-8">
    <p class="font-[var(--font-mono)] text-[11px] font-medium tracking-[2px] uppercase text-[#555555]">
      Ils me font confiance
    </p>
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 md:gap-x-14">
      {clients.map((client) => (
        <span
          class="font-[var(--font-mono)] text-sm md:text-base font-medium tracking-wide"
          style="color: #555555;"
        >
          {client}
        </span>
      ))}
    </div>
  </div>
</section>
