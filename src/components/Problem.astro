---
import { Icon } from 'astro-icon/components';

const cards = [
  {
    icon: "lucide:timer",
    title: "Des heures englouties chaque semaine",
    description: "Copier-coller entre outils, relances manuelles, saisie en double... Vos équipes passent 40\u00A0% de leur temps sur des tâches à faible valeur ajoutée.",
  },
  {
    icon: "lucide:triangle-alert",
    title: "Des erreurs qui coûtent cher",
    description: "Un champ oublié, un email non envoyé, un fichier mal nommé. Les erreurs de saisie manuelle sont obligatoires et coûtent cher.",
  },
  {
    icon: "lucide:trending-down",
    title: "Une croissance qui stagne",
    description: "Impossible de scaler quand chaque nouveau client ajoute du travail manuel. Votre équipe court après l'opérationnel au lieu de développer le business.",
  },
];
---

<section id="probleme" class="fade-in-section bg-[#FFFFFF] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
  <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-12">
    <!-- Header -->
    <div class="flex flex-col items-center gap-5 text-center">
      <!-- Badge -->
      <span class="inline-block rounded-full bg-[#F3F0FF] border border-[rgba(139,92,246,0.19)] px-4 py-1.5 font-[var(--font-mono)] text-[11px] font-medium text-[#777777] tracking-[2px] uppercase">
        LE PROBLÈME
      </span>

      <!-- Title -->
      <h2 class="font-[var(--font-display)] text-[length:var(--text-heading)] font-bold text-[#0A0A0A] text-center">
        Pendant que vous lisez ceci...
      </h2>

      <!-- Subtitle -->
      <p class="font-[var(--font-body)] text-[15px] md:text-[18px] font-normal text-[var(--color-text-dark-secondary)] leading-[1.6] max-w-[600px]">
        ...quelqu'un dans votre équipe est en train de faire manuellement ce qu'un workflow automatisé ferait en 10&nbsp;secondes.
      </p>
    </div>

    <!-- Cards -->
    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 reveal-stagger">
      {cards.map((card) => (
        <div class="reveal-card rounded-xl border border-[#E5E5E5] bg-white p-6 md:p-8 flex flex-col gap-4 md:gap-5">
          <!-- Icon — mobile: circle background, desktop: plain -->
          <div class="md:hidden w-12 h-12 rounded-full bg-[#F3F0FF] flex items-center justify-center shrink-0">
            <Icon name={card.icon} class="w-6 h-6 text-[var(--color-accent)]" />
          </div>
          <div class="hidden md:block">
            <Icon name={card.icon} class="w-6 h-6 text-[var(--color-accent)]" />
          </div>

          <!-- Title -->
          <h3 class="font-[var(--font-display)] text-base md:text-lg font-semibold text-[#0A0A0A]">
            {card.title}
          </h3>

          <!-- Description -->
          <p class="font-[var(--font-body)] text-[15px] font-normal text-[var(--color-text-dark-secondary)] leading-[1.6]">
            {card.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Closing text -->
    <p class="font-[var(--font-display)] text-lg md:text-2xl font-semibold text-[var(--color-accent)] text-center">
      Et si ces heures revenaient dans votre semaine&nbsp;?
    </p>

    <!-- Separator -->
    <div class="w-full h-px bg-[#E5E5E5]" aria-hidden="true"></div>
  </div>
</section>
