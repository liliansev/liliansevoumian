---
import { Icon } from 'astro-icon/components';

const cards = [
  {
    icon: "lucide:timer",
    title: "40\u00A0% du temps perdu",
    description: "Copier-coller entre outils, relances manuelles, saisie en double... Vos équipes passent 40\u00A0% de leur temps sur des tâches à faible valeur ajoutée.",
  },
  {
    icon: "lucide:triangle-alert",
    title: "Des erreurs qui coûtent cher",
    description: "Un champ oublié, un email non envoyé, un fichier mal nommé. Les erreurs de saisie manuelle sont inévitables et coûtent cher.",
  },
  {
    icon: "lucide:trending-down",
    title: "Une croissance bloquée",
    description: "Impossible de scaler quand chaque nouveau client ajoute du travail manuel. Votre équipe court après l'opérationnel au lieu de développer le business.",
  },
];
---

<section id="probleme" class="fade-in-section relative bg-[var(--color-bg-dark)] py-[80px] px-[clamp(1.5rem,5vw,120px)] overflow-hidden">
  <!-- Dot grid dark background -->
  <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>

  <div class="relative z-[1] max-w-[1200px] mx-auto flex flex-col items-center gap-12">
    <!-- Header -->
    <div class="flex flex-col items-center gap-5 text-center">
      <!-- Badge -->
      <span class="inline-block font-mono text-[12px] font-semibold text-[#22D3EE] tracking-[2px] uppercase">
        LE PROBLÈME
      </span>

      <!-- Title -->
      <h2 class="font-display text-[40px] font-bold tracking-[-0.02em] text-[var(--color-text-light)] text-center">
        Pendant que vous lisez ceci...
      </h2>

      <!-- Subtitle -->
      <p class="font-body text-[18px] font-normal text-[var(--color-text-light-secondary)] text-center w-full">
        ...quelqu'un dans votre équipe est en train de faire manuellement ce qu'un workflow automatisé ferait en 10&nbsp;secondes.
      </p>
    </div>

    <!-- Cards -->
    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 reveal-stagger">
      {cards.map((card) => (
        <div class="reveal-card card-3d-orange p-[28px_24px] flex flex-col gap-4">
          <!-- Icon -->
          <Icon name={card.icon} class="w-7 h-7 text-[#E86A33]" />

          <!-- Title -->
          <h3 class="font-body text-[18px] font-bold text-[#1A1A1A]">
            {card.title}
          </h3>

          <!-- Description -->
          <p class="font-body text-[14px] font-normal text-[#666666] leading-[1.5]">
            {card.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Closing text -->
    <p class="font-body text-[20px] font-semibold text-[#22D3EE] text-center">
      Et si ces heures revenaient dans votre semaine&nbsp;?
    </p>
  </div>
</section>
