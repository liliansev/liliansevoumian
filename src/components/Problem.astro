---
import { Icon } from 'astro-icon/components';

const cards = [
  {
    icon: "lucide:timer",
    title: "40\u00A0% du temps perdu",
    description: "<strong>Copier-coller entre outils</strong>, relances manuelles, saisie en double... Vos équipes passent <strong>40\u00A0% de leur temps</strong> sur des tâches à faible valeur ajoutée.",
    color: "#E86A33",
    cardClass: "card-3d-white-orange",
  },
  {
    icon: "lucide:triangle-alert",
    title: "Des erreurs qui coûtent cher",
    description: "Un champ oublié, un email non envoyé, un fichier mal nommé. Les <strong>erreurs de saisie manuelle</strong> sont inévitables et coûtent cher.",
    color: "#0D9488",
    cardClass: "card-3d-white-cyan",
  },
  {
    icon: "lucide:trending-down",
    title: "Une croissance bloquée",
    description: "Impossible de <strong>scaler</strong> quand chaque nouveau client ajoute du travail manuel. Votre équipe court après <strong>l'opérationnel</strong> au lieu de développer le business.",
    color: "#9333EA",
    cardClass: "card-3d-white-purple",
  },
];
---

<section data-bg="cream" id="probleme" class="fade-in-section relative bg-[var(--color-bg-dark)] py-[var(--spacing-section)] px-[var(--spacing-section-x)] overflow-hidden">
  <!-- Dot grid dark background -->
  <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>

  <div class="relative z-[1] max-w-[1200px] mx-auto flex flex-col items-center gap-12">
    <!-- Header -->
    <div class="flex flex-col items-center text-center">
      <!-- Badge — tight to title -->
      <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold text-[var(--color-purple-dark)] tracking-[2px] uppercase mb-3">
        LE PROBLÈME
      </span>

      <!-- Title — medium to subtitle -->
      <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[var(--color-text-light)] text-center mb-4">
        Pendant que vous lisez ceci...
      </h2>

      <!-- Subtitle -->
      <p class="font-body text-[length:var(--text-body-lg)] font-normal text-[var(--color-text-light-secondary)] text-center w-full">
        ...quelqu'un dans votre équipe est en train de faire manuellement ce qu'un workflow automatisé ferait en 10&nbsp;secondes.
      </p>
    </div>

    <!-- Cards -->
    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 reveal-stagger">
      {cards.map((card) => (
        <div class:list={["reveal-card card-3d-hover p-[28px_24px] flex flex-col", card.cardClass]}>
          <!-- Icon — tight with title -->
          <Icon name={card.icon} class="w-7 h-7 mb-2" style={`color: ${card.color};`} />

          <!-- Title — medium to description -->
          <h3 class="font-body text-[length:var(--text-body-lg)] font-bold text-[#1A1A1A] mb-3">
            {card.title}
          </h3>

          <!-- Description -->
          <p class="font-body text-[length:var(--text-body)] font-normal text-[#666666] leading-[1.5]" set:html={card.description} />
        </div>
      ))}
    </div>

    <!-- Closing text -->
    <p class="font-body text-[length:var(--text-body-lg)] font-semibold text-[var(--color-purple)] text-center">
      Ces heures perdues ne reviendront pas. Mais les prochaines, oui.
    </p>
  </div>
</section>
