---
import { Icon } from 'astro-icon/components';

interface Props {
  scene: 'delegation' | 'flux' | 'structure';
  description: string;
  startLabel: string;
  endLabel: string;
}
const { scene, description, startLabel, endLabel } = Astro.props;
---

<site-scene data-scene={scene} data-state="static">
  <div class="scene-controls" aria-label="Étapes du schéma">
    <div class="scene-states">
      <button type="button" data-step="0" aria-pressed="false">{startLabel}</button>
      <Icon name="lucide:arrow-right" size={16} aria-hidden="true" />
      <button type="button" data-step="1" aria-pressed="true">{endLabel}</button>
    </div>
    <button class="scene-play" type="button" data-play aria-label="Rejouer la transition">
      <Icon class="scene-replay-icon" name="lucide:rotate-ccw" size={16} aria-hidden="true" />
      <Icon class="scene-pause-icon" name="lucide:pause" size={16} aria-hidden="true" />
      <span data-play-label>Rejouer</span>
    </button>
  </div>
  <div class="scene-viewport">
    <div class="scene-fallback"><slot name="fallback" /></div>
    <canvas class="scene-canvas" role="img" aria-label={description}></canvas>
    <div class="scene-labels" aria-hidden="true"></div>
  </div>
  <span class="sr-only" data-scene-status role="status"></span>
</site-scene>

<style>
  site-scene { display: block; min-width: 0; background: var(--color-ink); color: var(--color-paper); }
  .scene-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; min-height: 44px; visibility: hidden; }
  .scene-states { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .scene-states svg { color: var(--color-ink-faint); }
  button { min-height: 44px; padding: 0.5rem 0.875rem; border: 1px solid var(--color-ink-faint); border-radius: var(--radius-cta); background: transparent; color: var(--color-paper); font: inherit; font-size: var(--text-body-sm); line-height: 1.3; cursor: pointer; }
  button[aria-pressed='true'] { border-color: var(--color-lime); color: var(--color-lime); }
  .scene-play { display: inline-flex; align-items: center; gap: 0.5rem; border-color: transparent; color: var(--color-text-on-dark-mid); }
  .scene-play :global(.scene-pause-icon) { display: none; }
  site-scene[data-running='true'] .scene-play :global(.scene-replay-icon) { display: none; }
  site-scene[data-running='true'] .scene-play :global(.scene-pause-icon) { display: block; }
  .scene-play[hidden] { display: none; }
  .scene-viewport { position: relative; height: 420px; isolation: isolate; }
  .scene-canvas, .scene-fallback, .scene-labels { position: absolute; inset: 0; width: 100%; height: 100%; }
  .scene-canvas { display: block; visibility: hidden; touch-action: pan-y pinch-zoom; }
  .scene-labels { pointer-events: none; visibility: hidden; }
  .scene-fallback { display: grid; align-items: center; }
  .scene-fallback :global(svg) { max-height: 100%; }
  site-scene[data-state='ready'] .scene-controls, site-scene[data-state='ready'] .scene-canvas, site-scene[data-state='ready'] .scene-labels { visibility: visible; }
  site-scene[data-state='ready'] .scene-fallback { visibility: hidden; }
  :global(.site-scene-label) { position: absolute; top: 0; left: 0; max-width: 140px; padding: 0.125rem 0.3rem; background: var(--color-ink); color: var(--color-paper); font-size: var(--text-body); line-height: 1.3; text-align: center; white-space: pre-line; }
  :global(.site-scene-label--accent) { color: var(--color-lime); }
  @media (hover: hover) and (pointer: fine) {
    button:hover { background: var(--color-paper); border-color: var(--color-paper); color: var(--color-ink); }
    button:focus-visible { outline: 2px solid var(--color-lime); outline-offset: 4px; }
  }
  @media (max-width: 639px) {
    .scene-viewport { height: 360px; }
    site-scene[data-scene='flux'] .scene-viewport { height: 280px; }
    site-scene[data-scene='structure'] .scene-viewport { height: 300px; }
    site-scene[data-scene='delegation'] .scene-viewport { height: 500px; }
    .scene-controls { justify-content: center; }
    .scene-states { justify-content: center; }
    :global(.site-scene-label) { font-size: var(--text-body-sm); max-width: 112px; }
  }
</style>

<script>
  class SiteScene extends HTMLElement {
    private observer?: IntersectionObserver;
    private disposeScene?: () => void;
    private generation = 0;

    connectedCallback() {
      const generation = ++this.generation;
      this.observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        this.observer?.disconnect();
        this.dataset.state = 'loading';
        import('../lib/site-scenes/runtime').then(({ mountScene }) => {
          if (!this.isConnected || generation !== this.generation) return;
          this.disposeScene = mountScene(this);
        }).catch((error: unknown) => {
          if (generation !== this.generation) return;
          this.dataset.state = 'error';
          const status = this.querySelector('[data-scene-status]');
          if (status) status.textContent = 'Schéma affiché sans animation.';
          console.error('Scene enhancement unavailable:', error);
        });
      }, { rootMargin: '200px' });
      this.observer.observe(this);
    }

    disconnectedCallback() {
      ++this.generation;
      this.observer?.disconnect();
      this.disposeScene?.();
      this.disposeScene = undefined;
      this.dataset.state = 'static';
    }
  }
  if (!customElements.get('site-scene')) customElements.define('site-scene', SiteScene);
</script>
