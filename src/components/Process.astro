---
const steps = [
  {
    number: "01",
    title: "Appel stratégique",
    description: "En 30\u00A0minutes, on identifie vos 3\u00A0process les plus chronophages. Vous repartez avec un plan d'action chiffré et priorisé sous 48\u00A0h — que vous travailliez avec moi ou non.",
    badge: "30 min · Gratuit",
    color: "orange",
  },
  {
    number: "02",
    title: "Construction & déploiement",
    description: "Je développe vos automatisations, les teste en conditions réelles et les déploie. Vous validez chaque étape avant la mise en production.",
    badge: "3 à 8 semaines",
    color: "purple",
  },
  {
    number: "03",
    title: "Suivi & autonomie",
    description: "Après livraison, vous n'êtes pas seul\u00A0: 30\u00A0jours de suivi inclus, formation de vos équipes et documentation complète de chaque workflow.",
    badge: "30j de suivi inclus",
    color: "cyan",
  },
];

const colorMap = {
  orange: { card: 'card-3d-white-orange', number: '#E86A33', badgeBg: 'rgba(232, 106, 51, 0.15)', badgeText: '#E86A33' },
  purple: { card: 'card-3d-white-purple', number: '#9333EA', badgeBg: 'rgba(147, 51, 234, 0.15)', badgeText: 'var(--color-purple-dark)' },
  cyan: { card: 'card-3d-white-cyan', number: '#22D3EE', badgeBg: 'rgba(13, 148, 136, 0.15)', badgeText: '#0891B2' },
};
---

<!-- Process -->
<div id="methode" class="flex flex-col items-center gap-12">
  <!-- Header -->
  <div class="flex flex-col items-center gap-5 fade-in-section">
    <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[#E86A33]">
      MÉTHODE
    </span>
    <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[#1A1A1A] text-center">
      Du premier appel à l'autonomie
    </h2>
    <p class="font-body text-[length:var(--text-body-lg)] font-normal text-[#666666] text-center max-w-[600px]">
      3&nbsp;étapes claires. Pas de surprise.
    </p>
  </div>

  <!-- Step cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full reveal-stagger">
    {steps.map((step) => {
      const colors = colorMap[step.color as keyof typeof colorMap];
      return (
        <div class={`${colors.card} card-3d-hover flex flex-col gap-4 p-[28px_24px] reveal-card`}>
          {/* Step number */}
          <span
            class="font-mono text-[length:var(--text-decorative)] font-bold leading-[1]"
            style={`color: ${colors.number};`}
          >
            {step.number}
          </span>

          {/* Title */}
          <h3 class="font-display text-[length:var(--text-subheading)] font-bold text-[#1A1A1A]">
            {step.title}
          </h3>

          {/* Description */}
          <p class="font-body text-[length:var(--text-body)] font-normal text-[#666666] leading-[1.5] flex-1">
            {step.description}
          </p>

          {/* Badge pill */}
          <span
            class="inline-flex items-center self-start rounded-full px-[12px] py-[6px] font-mono text-[length:var(--text-micro)] font-semibold"
            style={`background: ${colors.badgeBg}; color: ${colors.badgeText};`}
          >
            {step.badge}
          </span>
        </div>
      );
    })}
  </div>

  <!-- CTA intermédiaire -->
  <div class="flex flex-col items-center gap-4 mt-12 fade-in-section">
    <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] text-center">
      L'étape&nbsp;1, c'est un appel de 30&nbsp;min. Sans engagement.
    </p>
    <a
      href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
      class="btn-3d inline-flex items-center justify-center font-body text-[length:var(--text-body)] font-semibold px-7 py-3.5 group"
    >
      Planifier mon appel stratégique <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">→</span>
    </a>
  </div>
</div>
