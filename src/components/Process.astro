---
const steps = [
  {
    number: "01",
    title: "Appel stratégique",
    description: "En 30\u00A0minutes, on identifie vos 3\u00A0process les plus chronophages. Vous repartez avec un plan d'action chiffré et priorisé sous 48\u00A0h — que vous travailliez avec moi ou non.",
    badge: "30 min · Gratuit",
    color: "orange",
  },
  {
    number: "02",
    title: "Construction & déploiement",
    description: "Je développe vos automatisations, les teste en conditions réelles et les déploie. Vous validez chaque étape avant la mise en production.",
    badge: "3 à 8 semaines",
    color: "purple",
  },
  {
    number: "03",
    title: "Suivi & autonomie",
    description: "Après livraison, vous n'êtes pas seul\u00A0: 30\u00A0jours de suivi inclus, formation de vos équipes et documentation complète de chaque workflow.",
    badge: "30j de suivi inclus",
    color: "cyan",
  },
];

const colorMap = {
  orange: { card: 'card-3d-light-orange', number: '#E86A33', badgeBg: 'rgba(232, 106, 51, 0.15)', badgeText: '#E86A33' },
  purple: { card: 'card-3d-light-purple', number: '#9333EA', badgeBg: 'rgba(147, 51, 234, 0.15)', badgeText: '#9333EA' },
  cyan: { card: 'card-3d-light-cyan', number: '#22D3EE', badgeBg: 'rgba(34, 211, 238, 0.15)', badgeText: '#22D3EE' },
};
---

<!-- Process -->
<div id="methode" class="flex flex-col items-center gap-12">
  <!-- Header -->
  <div class="flex flex-col items-center gap-5 fade-in-section">
    <span class="inline-block font-mono text-[12px] font-semibold tracking-[2px] uppercase text-[#E86A33]">
      MÉTHODE
    </span>
    <h2 class="font-display text-[40px] font-bold tracking-[-0.02em] text-[#1A1A1A] text-center">
      Du premier appel à l'autonomie
    </h2>
    <p class="font-body text-[18px] font-normal text-[#666666] text-center max-w-[600px]">
      3&nbsp;étapes claires. Pas de surprise.
    </p>
  </div>

  <!-- Step cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full reveal-stagger">
    {steps.map((step) => {
      const colors = colorMap[step.color as keyof typeof colorMap];
      return (
        <div class={`${colors.card} flex flex-col gap-4 p-[32px_28px] reveal-card`}>
          {/* Step number */}
          <span
            class="font-mono text-[48px] font-bold tracking-[-0.03em] leading-[1]"
            style={`color: ${colors.number};`}
          >
            {step.number}
          </span>

          {/* Title */}
          <h3 class="font-display text-[22px] font-bold text-[#1A1A1A]">
            {step.title}
          </h3>

          {/* Description */}
          <p class="font-body text-[14px] font-normal text-[#666666] leading-[1.5] flex-1">
            {step.description}
          </p>

          {/* Badge pill */}
          <span
            class="inline-flex items-center self-start rounded-full px-[12px] py-[6px] font-mono text-[11px] font-semibold"
            style={`background: ${colors.badgeBg}; color: ${colors.badgeText};`}
          >
            {step.badge}
          </span>
        </div>
      );
    })}
  </div>
</div>
