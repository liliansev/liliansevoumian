---
/* Notion — mini-table CRM qui se remplit toute seule : chaque ligne se crée,
   puis son statut bascule en « terminé » (cross-fade), en cascade. */
const rows = [
  { label: 'Devis #1042', from: 'En cours', to: 'Signé' },
  { label: 'Devis #1043', from: 'En attente', to: 'Payé' },
  { label: 'Lead · formulaire', from: 'Nouveau', to: 'Qualifié' },
];
---
<div class="st">
  <div class="st-head">
    <span>Entrée</span>
    <span>Statut</span>
  </div>
  {rows.map((r) => (
    <div class="st-row">
      <span class="st-l">{r.label}</span>
      <span class="st-status">
        <span class="st-pill st-from">{r.from}</span>
        <span class="st-pill st-to is-ok">{r.to}<span aria-hidden="true"> ✓</span></span>
      </span>
    </div>
  ))}
</div>

<style>
  .st { padding: 10px 4px; }
  .st-head {
    display: grid;
    grid-template-columns: 1fr auto;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-divider);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-low);
  }
  .st-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .st-row:last-child { border-bottom: 0; }
  .st-l { font-size: var(--text-body-sm); color: var(--color-ink); min-width: 0; }

  /* Les deux pastilles (avant / après) se superposent dans la même cellule. */
  .st-status {
    display: grid;
    justify-items: end;
  }
  .st-pill {
    grid-area: 1 / 1;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    color: var(--color-ink-low);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-full);
    padding: 2px 9px;
    white-space: nowrap;
  }
  .st-pill.is-ok {
    color: var(--color-success);
    border-color: color-mix(in oklch, var(--color-success) 32%, transparent);
    background: color-mix(in oklch, var(--color-success) 9%, transparent);
  }

  /* Animation : 1) la ligne se crée, 2) le statut bascule. En cascade ligne par ligne. */
  .st-row:nth-child(2) { --d: 0s; }
  .st-row:nth-child(3) { --d: 0.7s; }
  .st-row:nth-child(4) { --d: 1.4s; }

  .st-row {
    animation: st-create 6s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  .st-from {
    animation: st-from 6s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  .st-to {
    animation: st-to 6s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }

  /* 1) création de la ligne */
  @keyframes st-create {
    0%       { opacity: 0; transform: translateY(7px); }
    7%, 92%  { opacity: 1; transform: translateY(0); }
    98%, 100%{ opacity: 0; transform: translateY(7px); }
  }
  /* 2) statut « avant » visible, puis s'efface */
  @keyframes st-from {
    0%, 40%  { opacity: 1; }
    50%, 100%{ opacity: 0; }
  }
  /* 2) statut « après » (Signé/Payé/Qualifié ✓) qui apparaît */
  @keyframes st-to {
    0%, 42%  { opacity: 0; transform: scale(0.96); }
    52%, 92% { opacity: 1; transform: scale(1); }
    98%, 100%{ opacity: 0; transform: scale(0.96); }
  }

  @media (prefers-reduced-motion: reduce) {
    .st-row, .st-from, .st-to { animation: none; }
    .st-from { opacity: 0; }
    .st-to { opacity: 1; transform: none; }
  }
</style>
