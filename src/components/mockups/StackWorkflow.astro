---
/* n8n — mini-workflow : Email → Agent IA → Tâche (sur fond pointillé). */
import { Icon } from 'astro-icon/components';
import { brandColorFor } from '../../data/brands';
---
<div class="sw" role="img" aria-label="Workflow n8n : un email entrant déclenche un agent IA qui crée la tâche.">
  <div class="sw-node">
    <Icon name="lucide:mail" class="sw-ic" aria-hidden="true" />
    <span class="sw-k">Email</span>
  </div>
  <span class="sw-arr" aria-hidden="true">→</span>
  <div class="sw-node is-accent" style={`--ic:${brandColorFor('simple-icons:anthropic')}`}>
    <Icon name="simple-icons:anthropic" class="sw-ic" aria-hidden="true" />
    <span class="sw-k">Agent IA</span>
  </div>
  <span class="sw-arr" aria-hidden="true">→</span>
  <div class="sw-node">
    <Icon name="simple-icons:notion" class="sw-ic" aria-hidden="true" />
    <span class="sw-k">Tâche</span>
  </div>
</div>

<style>
  .sw {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 22px 16px;
    background-image: radial-gradient(var(--color-grid-line) 1px, transparent 1px);
    background-size: 13px 13px;
  }
  .sw-node {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 10px 6px;
    background: var(--color-surface-high);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
  }
  .sw-node.is-accent { border-color: var(--brand, var(--color-border-strong)); }
  /* Icône dans la couleur de son propre logo (--ic posé sur le nœud), sinon neutre. */
  .sw-ic { width: 16px; height: 16px; color: var(--ic, var(--color-ink-mid)); }
  .sw-k { font-family: var(--font-mono); font-size: var(--text-mono-caption); color: var(--color-ink-low); }
  .sw-arr { flex-shrink: 0; font-family: var(--font-mono); color: var(--color-ink-faint); transition: none; }

  /* Animation : le signal traverse le workflow Email → Agent IA → Tâche, en boucle. */
  .sw-node { animation: sw-step 3.2s ease-in-out infinite; }
  .sw-node:nth-child(3) { animation-delay: 0.5s; }
  .sw-node:nth-child(5) { animation-delay: 1s; }
  @keyframes sw-step {
    0%, 30%, 100% { box-shadow: var(--shadow-card); transform: translateY(0); }
    10% {
      box-shadow: 0 0 0 1.5px var(--brand, var(--color-accent)),
                  0 6px 16px -6px color-mix(in oklch, var(--brand, var(--color-accent)) 45%, transparent);
      transform: translateY(-2px);
    }
  }
  .sw-arr { animation: sw-arr 3.2s ease-in-out infinite; }
  .sw-arr:nth-child(2) { animation-delay: 0.25s; }
  .sw-arr:nth-child(4) { animation-delay: 0.75s; }
  @keyframes sw-arr {
    0%, 30%, 100% { color: var(--color-ink-faint); transform: translateX(0); }
    12% { color: var(--brand, var(--color-accent)); transform: translateX(2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sw-node, .sw-arr { animation: none; }
  }
</style>
