---
/*
 * MockupList.astro — lignes de données dans un MockupWindow.
 *
 * Générique : sert aussi bien une liste de factures (statut payé / relance +
 * montant) qu'un catalogue produit enrichi. Statut "done" = pastille verte
 * fonctionnelle (--color-success), "pending" = neutre, "muted" = en attente
 * pâle. Tout le reste est strictement monochrome.
 */
interface Item {
  label: string;
  sub?: string;
  value?: string;
  status?: 'done' | 'pending' | 'muted';
}
interface Props { items: Item[] }
const { items } = Astro.props;

const glyph = { done: '✓', pending: '↻', muted: '·' } as const;
---

<ul class="mock-list" role="list">
  {items.map((it) => {
    const st = it.status ?? 'done';
    return (
      <li class="mock-row">
        <span class:list={['mock-ic', `is-${st}`]} aria-hidden="true">{glyph[st]}</span>
        <span class="mock-main">
          <span class="mock-label">{it.label}</span>
          {it.sub && <span class="mock-sub">{it.sub}</span>}
        </span>
        {it.value && <span class="mock-val">{it.value}</span>}
      </li>
    );
  })}
</ul>

<style>
  .mock-list { list-style: none; margin: 0; padding: 0; }
  .mock-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .mock-row:last-child { border-bottom: 0; }

  .mock-ic {
    flex-shrink: 0;
    width: 26px; height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-divider);
    background: var(--color-surface-low);
    color: var(--color-ink-low);
  }
  .mock-ic.is-done {
    color: var(--color-success);
    border-color: color-mix(in oklch, var(--color-success) 30%, transparent);
    background: color-mix(in oklch, var(--color-success) 8%, transparent);
  }
  .mock-ic.is-muted { color: var(--color-ink-faint); }

  .mock-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mock-label {
    font-size: var(--text-body-sm);
    color: var(--color-ink);
    font-weight: 500;
    line-height: 1.2;
  }
  .mock-sub {
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    color: var(--color-ink-low);
    letter-spacing: 0.02em;
  }
  .mock-val {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono-body);
    color: var(--color-ink);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
</style>
