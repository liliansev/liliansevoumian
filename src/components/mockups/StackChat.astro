---
/* Claude Cowork — mini-chat : piloter ses automatisations par dialogue. */
---
<div class="sch">
  <div class="bub bub-user">Relance les devis non signés.</div>
  <div class="bub bub-bot"><span class="bub-ok" aria-hidden="true">✓</span> 3 relances programmées dans Make.</div>
</div>

<style>
  .sch {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 16px 14px;
  }
  .bub {
    max-width: 88%;
    padding: 9px 12px;
    border-radius: var(--radius-md);
    font-size: var(--text-body-sm);
    line-height: 1.4;
  }
  .bub-user {
    align-self: flex-end;
    background: var(--color-surface-low);
    border: 1px solid var(--color-divider);
    color: var(--color-ink);
    border-bottom-right-radius: var(--radius-xs);
  }
  .bub-bot {
    align-self: flex-start;
    background: var(--color-surface-high);
    border: 1px solid var(--color-border-strong);
    color: var(--color-ink);
    border-bottom-left-radius: var(--radius-xs);
  }
  .bub-ok { color: var(--color-success); font-weight: 600; display: inline-block; }

  /* Animation : le ✓ de la réponse pulse quand l'action est exécutée. */
  .bub-ok { animation: sch-ok 4s ease-in-out infinite; }
  @keyframes sch-ok {
    0%, 70%, 100% { transform: scale(1); }
    78% { transform: scale(1.35); }
    85% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bub-ok { animation: none; }
  }
</style>
