---
/* Mistral — extraction souveraine animée : le doc est « lu » (spinner + skeletons
   qui réfléchissent), puis les champs extraits se remplissent après un court délai,
   en cascade. Productivité (extraction auto) + souveraineté (hébergé en UE, RGPD).

   Deux champs et non trois : la cascade se lit dès deux valeurs décalées, et le
   troisième coûtait 34 px sur la maquette la plus haute de la section. C'est
   « Échéance » qui part, la donnée la moins caractéristique d'une facture. Le pied
   reste : c'est lui qui porte l'argument de souveraineté, et il est le seul de la
   section à le dire. */
const fields = [
  { k: 'Client', v: 'M. Partners' },
  { k: 'Montant', v: '1 240 €' },
];
---
<div class="sov" role="img" aria-label="Mistral lit une facture PDF et en extrait les champs, traitement hébergé en Europe.">
  <div class="sov-doc">
    <span class="sov-file">facture_2026-04.pdf</span>
    <span class="sov-tag"><span class="sov-spin" aria-hidden="true"></span>extraction</span>
  </div>
  <div class="sov-fields">
    {fields.map((f) => (
      <div class="sov-row">
        <span class="sov-k">{f.k}</span>
        <span class="sov-val">
          <span class="sov-skel" aria-hidden="true"></span>
          <span class="sov-v">{f.v}<span class="sov-ok" aria-hidden="true"> ✓</span></span>
        </span>
      </div>
    ))}
  </div>
  <div class="sov-foot">
    <span class="sov-flag" aria-hidden="true">UE</span>
    <span>Traité en Europe · aucune donnée ne sort</span>
  </div>
</div>

<style>
  .sov {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 14px;
  }
  .sov-doc {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-divider);
  }
  .sov-file {
    font-family: var(--font-mono);
    font-size: var(--text-mono-body);
    color: var(--color-ink);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sov-tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    /* Le libellé passe à l'encre, la couleur de marque reste sur le filet : à
       11 px, le orange tenait 3,35:1 sur papier, et le fallback lime du `var()`
       serait descendu à 1,25:1. La teinte identifie toujours la marque, elle ne
       porte simplement plus le texte. */
    color: var(--color-ink);
    border: 1px solid color-mix(in oklch, var(--brand, var(--color-accent)) 30%, transparent);
    border-radius: var(--radius-full);
    padding: 1px 9px;
    white-space: nowrap;
  }
  /* Spinner « ça réfléchit » — visible pendant la lecture du doc. */
  .sov-spin {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in oklch, var(--brand, var(--color-accent)) 30%, transparent);
    border-top-color: var(--brand, var(--color-accent));
    animation: sov-rot 0.7s linear infinite, sov-spin-show 6s ease-in-out infinite;
  }

  .sov-fields { display: flex; flex-direction: column; }
  .sov-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 10px;
    /* Pas de filet entre les champs : leur propre demi-interligne suffit à les
       séparer, un padding généreux ne faisait qu'allonger la maquette. */
    padding: 2px 0;
  }
  .sov-k {
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-low);
  }
  /* Valeur = skeleton (pendant la lecture) superposé à la vraie donnée (après). */
  .sov-val {
    display: grid;
    justify-items: end;
    align-items: center;
  }
  .sov-skel,
  .sov-v { grid-area: 1 / 1; }
  .sov-skel {
    width: 56px;
    height: 11px;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg,
      var(--color-surface-low) 0%,
      var(--color-divider) 50%,
      var(--color-surface-low) 100%);
    background-size: 220% 100%;
    animation: sov-shimmer 1.3s linear infinite, sov-skel-show 6s ease-in-out infinite;
  }
  .sov-v {
    font-size: var(--text-body-sm);
    color: var(--color-ink);
    white-space: nowrap;
    animation: sov-v-show 6s ease-in-out infinite;
  }
  .sov-ok { color: var(--color-success); font-weight: 600; }

  /* Stagger : les champs se remplissent l'un après l'autre. */
  .sov-row:nth-child(1) { --d: 0s; }
  .sov-row:nth-child(2) { --d: 0.22s; }
  .sov-skel { animation-delay: 0s, var(--d, 0s); }
  .sov-v { animation-delay: var(--d, 0s); }

  .sov-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 6px;
    border-top: 1px solid var(--color-divider);
    font-size: var(--text-mono-caption);
    color: var(--color-ink-low);
  }
  .sov-flag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-mono-caption);
    letter-spacing: 0.04em;
    color: var(--color-ink);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xs);
    padding: 1px 6px;
  }

  @keyframes sov-rot { to { transform: rotate(360deg); } }
  @keyframes sov-spin-show {
    0%, 34% { opacity: 1; }
    42%, 100% { opacity: 0; }
  }
  @keyframes sov-shimmer {
    0% { background-position: 120% 0; }
    100% { background-position: -120% 0; }
  }
  @keyframes sov-skel-show {
    0%, 34% { opacity: 1; }
    44%, 100% { opacity: 0; }
  }
  @keyframes sov-v-show {
    0%, 38% { opacity: 0; transform: translateY(3px); }
    50%, 92% { opacity: 1; transform: translateY(0); }
    98%, 100% { opacity: 0; transform: translateY(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sov-spin { animation: none; opacity: 0; }
    .sov-skel { animation: none; opacity: 0; }
    .sov-v { animation: none; opacity: 1; transform: none; }
  }
</style>
