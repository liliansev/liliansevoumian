---
/*
 * MockupWindow.astro — le châssis d'une fenêtre, autour d'un schéma redessiné.
 *
 * Une barre de titre (trois pastilles, un nom de fichier, la mention « Schéma
 * reconstitué »), puis le corps, passé par le slot. Tout vient des jetons du
 * projet : sur un panneau clair, la fenêtre suit sans variante.
 *
 * `schema` fait porter au châssis la mention qui le démentit. Les écrans
 * clients sont confidentiels : ce qui est montré ici est redessiné. Or trois
 * pastilles et un chemin de fichier forment l'habillage exact d'une vraie
 * capture, et le visuel affirmait donc le contraire de ce que son texte
 * sr-only reconnaissait (« Schéma simplifié du workflow… »). La mention
 * s'écrit dans la barre de titre, à côté du nom de fichier, c'est-à-dire là où
 * naît la confusion.
 */
interface Props {
  file?: string;
  schema?: boolean;
  /** Le corps touche les bords de la fenêtre : il porte son propre fond. */
  flush?: boolean;
}
const { file, schema = false, flush = false } = Astro.props;
---

<div class="mockup-window">
  <div class:list={['mw-bar', schema && 'has-schema']}>
    <span class="mw-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="mw-file">{file}</span>
    {/* Texte visible et non aria-label : le lecteur d'écran le rencontre une
        fois, dans l'ordre de la barre, sans doublon avec la description
        sr-only que le corps de la fenêtre porte déjà. */}
    {schema && <span class="mw-schema">Schéma reconstitué</span>}
  </div>

  <div class:list={['mw-body', flush && 'is-flush']}>
    <slot />
  </div>
</div>

<style>
  .mockup-window {
    width: 100%;
    background: var(--color-surface-high);
    border: 1px solid var(--color-divider);
    /* Fenêtre de maquette : rayon de média. `--mw-radius` laisse l'hôte le
       réduire quand la fenêtre est elle-même logée dans une carte arrondie :
       un rayon intérieur égal au rayon extérieur se lit comme un défaut. */
    border-radius: var(--mw-radius, var(--radius-lg));
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .mw-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--color-surface-low);
    border-bottom: 1px solid var(--color-divider);
  }
  .mw-dots { display: inline-flex; gap: 6px; flex-shrink: 0; }
  .mw-dots i {
    width: 9px; height: 9px;
    border-radius: var(--radius-full);
    background: var(--color-ink-faint);
    opacity: 0.55;
  }
  .mw-file {
    font-size: var(--text-mono-caption);
    color: var(--color-ink-low);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* La mention est à l'encre pleine, le nom de fichier voisin en encre basse :
     des deux, c'est elle qui doit se lire en premier. Ni pastille ni fond : elle
     se lirait comme un état de l'application. Un filet la sépare du chemin. */
  .mw-schema {
    flex-shrink: 0;
    padding-left: 10px;
    border-left: 1px solid var(--color-divider);
    font-size: var(--text-mono-caption);
    font-weight: 500;
    color: var(--color-ink);
  }

  .mw-body { padding: 4px 14px; }
  .mw-body.is-flush { padding: 0; }

  /* Sur téléphone, la barre ne garde que ce qui dit vrai : le chemin de fichier
     est inventé, la mention non. Les pastilles restent, elles portent à elles
     seules l'idée de fenêtre. */
  @media (max-width: 639px) {
    .mw-bar.has-schema .mw-file {
      display: none;
    }

    .mw-bar.has-schema .mw-schema {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
