---
/* Claude Code — mini-console : génère un outil interne. */
---
<div class="sc" role="img" aria-label="Console Claude Code : un outil interne est généré puis lancé en local.">
  <div class="sc-line"><span class="sc-p">›</span><span class="sc-cmd">claude — outil interne</span></div>
  <div class="sc-line"><span class="sc-ok" aria-hidden="true">✓</span><span class="sc-out">app générée · 3 fichiers</span></div>
  <div class="sc-line"><span class="sc-p">›</span><span class="sc-cmd">lancer en local</span><span class="sc-cur" aria-hidden="true"></span></div>
</div>

<style>
  .sc {
    font-family: var(--font-mono);
    font-size: var(--text-mono-body);
    line-height: 1.4;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .sc-line { display: flex; align-items: center; gap: 8px; }
  .sc-p { color: var(--color-ink-faint); }
  .sc-cmd { color: var(--color-ink); }
  .sc-out { color: var(--color-ink-low); }
  .sc-ok { color: var(--color-success); }
  .sc-cur {
    width: 7px;
    height: 15px;
    background: var(--color-ink);
    display: inline-block;
    animation: sc-blink 1.1s steps(1) infinite;
  }
  @keyframes sc-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .sc-cur { animation: none; } }
</style>
