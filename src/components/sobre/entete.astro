---
/*
 * L'en-tête du site, le même partout depuis le 3 novembre 2026 (« Entre les
 * deux ») : le logo (le bloc « ls » d'encre et son curseur bleu qui clignote,
 * puis le nom), les liens, et un seul bouton, « Parlons de votre projet »,
 * qui mène au formulaire de contact (`BoutonReservation`, goal
 * `contact_opened`).
 *
 * Il colle en haut de la page. À plat au chargement, il devient une barre
 * blanche flottante, floutée et arrondie, dès qu'on défile (demande de
 * Lilian, 3 novembre 2026). Sous 760 px, les liens passent dans un menu plein
 * écran : une boîte de dialogue native, fermée par Échap, par « Fermer » ou
 * par un lien, qui rend ensuite le focus à la section visée.
 */
import BoutonReservation from '../BoutonReservation.astro';

interface Lien {
  href: string;
  label: string;
}

interface Props {
  /** Les liens : les sections de l'accueil, les ancres d'une page d'offre, ou les pages du site. */
  liens: Lien[];
  /** Le nom de l'en-tête dans les statistiques (`contact_opened`). */
  source?: string;
  /** Le nom du menu plein écran dans les statistiques. */
  sourceMenu?: string;
  /** Où mène le logo : le haut de la page sur l'accueil, l'accueil ailleurs. */
  marqueHref?: string;
}

const { liens, source = 'nav', sourceMenu = 'nav_mobile_cta', marqueHref = '/' } = Astro.props;

/* La page en cours : un lien sans ancre qui mène ici, ou à la rubrique dont
   la page est une fiche (`/cas-clients/humble-plus` → « Cas clients »). */
const ici = Astro.url.pathname.replace(/\/$/, '') || '/';
const estIci = (href: string) => {
  if (href.includes('#')) return false;
  const cible = href.replace(/\/$/, '') || '/';
  return cible !== '/' && (ici === cible || ici.startsWith(`${cible}/`));
};
const marqueLibelle = marqueHref === '/' ? "Lilian Sevoumian, retour à l'accueil" : 'Lilian Sevoumian, haut de page';
const externe = (href: string) => href.startsWith('http');
---

<header class="entete carnet-ui" data-entete>
  <div class="entete__barre">
    <a class="logo" href={marqueHref} aria-label={marqueLibelle}>
      <span class="logo__bloc" aria-hidden="true">ls<i></i></span>
      <span class="logo__nom" aria-hidden="true">Lilian Sevoumian</span>
    </a>
    <nav class="entete__liens" aria-label="Sections">
      {liens.map((l) => (
        <a
          href={l.href}
          data-entete-section={l.href.startsWith('#') ? '' : undefined}
          aria-current={estIci(l.href) ? 'page' : undefined}
          target={externe(l.href) ? '_blank' : undefined}
          rel={externe(l.href) ? 'noopener noreferrer' : undefined}
        >{l.label}{externe(l.href) && <span class="sr-only"> (nouvel onglet)</span>}</a>
      ))}
    </nav>
    <BoutonReservation source={source} class="pilule pilule-encre entete__appel">Parlons de votre projet</BoutonReservation>
    <button class="pilule entete__menu" type="button" aria-haspopup="dialog" aria-controls="menu-site" data-menu-ouvrir>Menu</button>
  </div>
</header>

<dialog class="menu carnet-ui" id="menu-site" aria-label="Menu">
  <div class="menu__cadre" tabindex="-1">
    <div class="menu__haut">
      <span class="logo" aria-hidden="true"><span class="logo__bloc">ls<i></i></span><span class="logo__nom">Lilian Sevoumian</span></span>
      <button class="pilule" type="button" data-menu-fermer>Fermer</button>
    </div>
    {liens.map((l) => (
      <a
        class="menu__entree"
        href={l.href}
        aria-current={estIci(l.href) ? 'page' : undefined}
        target={externe(l.href) ? '_blank' : undefined}
        rel={externe(l.href) ? 'noopener noreferrer' : undefined}
      >{l.label}</a>
    ))}
    <BoutonReservation source={sourceMenu} class="pilule pilule-encre menu__appel">Parlons de votre projet</BoutonReservation>
  </div>
</dialog>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    pointer-events: none;
  }

  /* La barre déborde de 12 px de chaque côté de la colonne : à plat, son
     contenu reste aligné sur le texte de la page. */
  .entete__barre {
    display: flex;
    align-items: center;
    gap: 24px;
    width: calc(100% - var(--gauche) - var(--droite) + 24px);
    max-width: calc(var(--largeur-site) + 24px);
    margin-inline: auto;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-bottom-color: var(--encre-filet);
    border-radius: 0;
    background: var(--papier);
    pointer-events: auto;
    transition:
      transform 0.3s ease,
      background-color 0.3s ease,
      border-color 0.3s ease,
      border-radius 0.3s ease,
      box-shadow 0.3s ease,
      padding 0.3s ease;
  }

  .entete.colle .entete__barre {
    transform: translateY(10px);
    padding-block: 8px;
    border-color: var(--encre-filet);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.85);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 10px 30px -14px rgb(20 20 30 / 0.25);
  }

  /* Le logo : « ls » en blanc sur un bloc d'encre, le curseur bleu qui
     clignote, puis le nom. */
  .logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--encre);
    text-decoration: none;
  }

  .logo__bloc {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 30px;
    padding: 0 8px 0 9px;
    border-radius: 5px;
    background: var(--encre);
    color: var(--blanc);
    font: 600 0.9375rem / 1 var(--carnet-titre);
    letter-spacing: -0.02em;
    transition: height 0.3s ease;
  }

  .entete.colle .logo__bloc {
    height: 26px;
  }

  .logo__bloc i {
    display: inline-block;
    width: 7px;
    height: 15px;
    margin-left: 1px;
    background: var(--violet);
    animation: curseur 1.1s steps(1) infinite;
  }

  @keyframes curseur {
    50% { opacity: 0; }
  }

  .logo__nom {
    font: 600 var(--t-ui) / 1 var(--carnet-titre);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .entete__liens {
    display: flex;
    gap: 4px;
    margin-left: auto;
    font-size: var(--t-petit);
  }

  .entete__liens a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    color: var(--encre-doux);
    text-decoration: none;
  }

  .entete__liens a:hover,
  .entete__liens a[aria-current] {
    color: var(--encre);
  }

  .entete__liens a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .entete :global(.entete__appel) {
    min-height: 36px;
    padding: 0 13px;
    font-size: var(--t-petit);
  }

  .entete__menu {
    display: none;
  }

  @media (max-width: 860px) {
    .entete__liens {
      display: none;
    }

    .entete :global(.entete__appel) {
      margin-left: auto;
    }

    .entete__menu {
      display: inline-flex;
      min-height: 36px;
      padding: 0 13px;
      font-size: var(--t-petit);
    }
  }

  @media (max-width: 560px) {
    .entete__barre {
      gap: 8px;
    }

    .entete__barre .logo__nom {
      display: none;
    }

    .entete :global(.entete__appel),
    .entete__menu {
      min-height: 40px;
    }
  }

  /* Le menu plein écran */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--papier);
    color: var(--encre);
  }

  .menu::backdrop {
    background: rgb(23 23 26 / 0.4);
  }

  .menu__cadre {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: calc(env(safe-area-inset-top, 0px) + 12px) var(--droite) calc(env(safe-area-inset-bottom, 0px) + 24px) var(--gauche);
    outline: none;
  }

  .menu__haut {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .menu__entree {
    padding: 14px 0;
    border-bottom: 1px solid var(--encre-filet);
    color: var(--encre);
    font: 600 var(--t-carte) / 1.2 var(--carnet-titre);
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .menu__entree[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .menu :global(.menu__appel) {
    align-self: flex-start;
    margin-top: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo__bloc i {
      animation: none;
    }
  }
</style>

<script>
  /* La barre flottante : posée après 60 px de défilement, retirée sous 20 px
     (l'écart évite qu'elle clignote à la limite). */
  const entete = document.querySelector<HTMLElement>('[data-entete]');
  if (entete) {
    const auDefilement = () => {
      /* Menu ouvert, la page est figée (Layout) et `scrollY` vaut 0 : la barre
         garde son état. */
      if (document.documentElement.hasAttribute('data-defilement-verrouille')) return;
      if (window.scrollY > 60) entete.classList.add('colle');
      else if (window.scrollY < 20) entete.classList.remove('colle');
    };
    window.addEventListener('scroll', auDefilement, { passive: true });
    auDefilement();
  }

  /* Le menu : ouvert en boîte de dialogue, il rend le focus à la section
     choisie, ou au bouton Menu s'il est fermé sans choix. Le lien « Parlons de
     votre projet » est pris en charge par Layout (défilement jusqu'au
     formulaire) : le menu se ferme sans reprendre le focus. */
  const menu = document.querySelector<HTMLDialogElement>('#menu-site');
  const ouvrir = document.querySelector<HTMLButtonElement>('[data-menu-ouvrir]');
  const fermer = menu?.querySelector<HTMLButtonElement>('[data-menu-fermer]');
  /* Le verrou de défilement de Layout : sans lui, la page défile derrière la
     boîte de dialogue sur iOS. Il est levé avant que le lien choisi ne fasse
     défiler la page, sinon il la ramènerait à sa position d'avant. */
  const verrou = (actif: boolean) =>
    (window as unknown as { __verrouDefilement?: (proprietaire: string, actif: boolean) => void }).__verrouDefilement?.(
      'menu-site',
      actif,
    );
  if (menu && ouvrir && fermer) {
    ouvrir.addEventListener('click', () => {
      menu.showModal();
      verrou(true);
      menu.querySelector<HTMLElement>('.menu__cadre')?.focus();
    });
    fermer.addEventListener('click', () => menu.close());
    let cible: HTMLElement | null = null;
    let lienChoisi = false;
    menu.querySelectorAll<HTMLAnchorElement>('a').forEach((lien) =>
      lien.addEventListener('click', () => {
        const href = lien.getAttribute('href') ?? '';
        cible = href.startsWith('#') ? document.querySelector<HTMLElement>(href) : null;
        lienChoisi = true;
        verrou(false);
        menu.close();
      }),
    );
    menu.addEventListener('close', () => {
      verrou(false);
      if (cible) {
        cible.setAttribute('tabindex', '-1');
        cible.focus({ preventScroll: true });
      } else if (!lienChoisi) {
        ouvrir.focus({ preventScroll: true });
      }
      cible = null;
      lienChoisi = false;
    });
  }

  /* La section en cours, soulignée dans la barre. */
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('[data-entete-section]')];
  const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
  if (liens.length && sections.length) {
    const marquer = (id: string) =>
      liens.forEach((lien) =>
        lien.getAttribute('href') === `#${id}` ? lien.setAttribute('aria-current', 'true') : lien.removeAttribute('aria-current'),
      );
    const observateur = new IntersectionObserver(
      (entrees) => entrees.forEach((e) => e.isIntersecting && marquer(e.target.id)),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observateur.observe(s));
  }
</script>
