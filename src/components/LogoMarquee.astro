---
/*
 * LogoMarquee — bande d'OUTILS défilante, juste après le hero.
 *
 * Logos des outils les plus connus que Lilian connecte / automatise, via le jeu
 * simple-icons (déjà installé) → monochromes et thème-aware nativement
 * (currentColor). Boucle sans couture (liste doublée), fondu aux bords, pause au
 * survol, statique sous prefers-reduced-motion.
 */
import { Icon } from 'astro-icon/components';

interface Tool { name: string; icon: string }
const tools: Tool[] = [
  { name: 'n8n', icon: 'simple-icons:n8n' },
  { name: 'Make', icon: 'simple-icons:make' },
  { name: 'Zapier', icon: 'simple-icons:zapier' },
  { name: 'Airtable', icon: 'simple-icons:airtable' },
  { name: 'Notion', icon: 'simple-icons:notion' },
  { name: 'Google Sheets', icon: 'simple-icons:googlesheets' },
  { name: 'Slack', icon: 'simple-icons:slack' },
  { name: 'HubSpot', icon: 'simple-icons:hubspot' },
  { name: 'Stripe', icon: 'simple-icons:stripe' },
  { name: 'OpenAI', icon: 'simple-icons:openai' },
  { name: 'Claude', icon: 'simple-icons:anthropic' },
  { name: 'Mistral', icon: 'simple-icons:mistralai' },
  { name: 'Gmail', icon: 'simple-icons:gmail' },
  { name: 'Google Drive', icon: 'simple-icons:googledrive' },
  { name: 'Google Calendar', icon: 'simple-icons:googlecalendar' },
  { name: 'Calendly', icon: 'simple-icons:calendly' },
  { name: 'Typeform', icon: 'simple-icons:typeform' },
  { name: 'Shopify', icon: 'simple-icons:shopify' },
  { name: 'WhatsApp', icon: 'simple-icons:whatsapp' },
  { name: 'Telegram', icon: 'simple-icons:telegram' },
  { name: 'Discord', icon: 'simple-icons:discord' },
  { name: 'Mailchimp', icon: 'simple-icons:mailchimp' },
  { name: 'Brevo', icon: 'simple-icons:brevo' },
  { name: 'Trello', icon: 'simple-icons:trello' },
];
const loop = [...tools, ...tools];
---

<section class="lm" aria-label="Outils que j'automatise et connecte au quotidien">
  <div class="px-[var(--spacing-section-x)]">
    <h2 class="lm-title reveal">Qu'allons-nous automatiser demain&nbsp;?</h2>
  </div>

  <div class="lm-viewport reveal">
    <div class="lm-track">
      {loop.map((t, i) => (
        <span class="lm-tool" aria-hidden={i >= tools.length ? 'true' : 'false'}>
          <Icon name={t.icon} class="lm-tool-ic" aria-hidden="true" />
          <span class="lm-tool-name">{t.name}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .lm { padding-block: clamp(2.5rem, 5vw, 4rem); }

  .lm-title {
    text-align: center;
    max-width: 24ch;
    margin: 0 auto;
    text-wrap: balance;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-title-lg);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-ink);
  }
  /* Desktop : titre forcé sur une seule ligne. */
  @media (min-width: 768px) {
    .lm-title { max-width: none; white-space: nowrap; }
  }

  .lm-viewport {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, var(--color-ink) 10%, var(--color-ink) 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, var(--color-ink) 10%, var(--color-ink) 90%, transparent);
  }
  .lm-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: clamp(2.5rem, 6vw, 5rem);
    animation: lm-scroll 34s linear infinite;
  }
  .lm-viewport:hover .lm-track { animation-play-state: paused; }
  @keyframes lm-scroll {
    to { transform: translateX(-50%); }
  }

  /* Outil = logo (simple-icons, currentColor) + nom, en gris discret. */
  .lm-tool {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    white-space: nowrap;
    color: var(--color-ink-faint);
    transition: color var(--duration-default) var(--ease-out-quint);
  }
  .lm-tool:hover { color: var(--color-ink-mid); }
  .lm-tool-ic { width: 26px; height: 26px; flex-shrink: 0; }
  .lm-tool-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1vw + 0.85rem, 1.45rem);
    letter-spacing: -0.02em;
  }

  @media (prefers-reduced-motion: reduce) {
    .lm-viewport { -webkit-mask-image: none; mask-image: none; }
    .lm-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: clamp(1.5rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem);
    }
    .lm-tool[aria-hidden='true'] { display: none; }
  }
</style>
