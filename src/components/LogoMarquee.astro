---
/*
 * LogoMarquee — bande d'OUTILS défilante, juste après le hero.
 *
 * Logos des outils les plus connus que Lilian connecte / automatise, via le jeu
 * simple-icons (déjà installé) → monochromes et thème-aware nativement
 * (currentColor). Boucle sans couture (liste doublée), fondu aux bords, pause au
 * survol, statique sous prefers-reduced-motion.
 */
import { Icon } from 'astro-icon/components';

/* color = couleur officielle de la marque (DA propre à chaque outil), portée par
   la bordure + l'icône de la tuile. Marques quasi-monochromes (Notion, Typeform)
   laissées sans couleur → fallback neutre theme-aware. */
interface Tool { name: string; icon: string; color?: string }
const tools: Tool[] = [
  { name: 'n8n', icon: 'simple-icons:n8n', color: '#EA4B71' },
  { name: 'Make', icon: 'simple-icons:make', color: '#6D00CC' },
  { name: 'Zapier', icon: 'simple-icons:zapier', color: '#FF4F00' },
  { name: 'Airtable', icon: 'simple-icons:airtable', color: '#FCB400' },
  { name: 'Notion', icon: 'simple-icons:notion' },
  { name: 'Google Sheets', icon: 'simple-icons:googlesheets', color: '#0F9D58' },
  { name: 'Slack', icon: 'simple-icons:slack', color: '#611F69' },
  { name: 'HubSpot', icon: 'simple-icons:hubspot', color: '#FF7A59' },
  { name: 'Stripe', icon: 'simple-icons:stripe', color: '#635BFF' },
  { name: 'OpenAI', icon: 'simple-icons:openai', color: '#10A37F' },
  { name: 'Claude', icon: 'simple-icons:anthropic', color: '#D97757' },
  { name: 'Mistral', icon: 'simple-icons:mistralai', color: '#FA520F' },
  { name: 'Gmail', icon: 'simple-icons:gmail', color: '#EA4335' },
  { name: 'Google Drive', icon: 'simple-icons:googledrive', color: '#1FA463' },
  { name: 'Google Calendar', icon: 'simple-icons:googlecalendar', color: '#4285F4' },
  { name: 'Calendly', icon: 'simple-icons:calendly', color: '#006BFF' },
  { name: 'Typeform', icon: 'simple-icons:typeform' },
  { name: 'Shopify', icon: 'simple-icons:shopify', color: '#95BF47' },
  { name: 'WhatsApp', icon: 'simple-icons:whatsapp', color: '#25D366' },
  { name: 'Telegram', icon: 'simple-icons:telegram', color: '#26A5E4' },
  { name: 'Discord', icon: 'simple-icons:discord', color: '#5865F2' },
  { name: 'Mailchimp', icon: 'simple-icons:mailchimp', color: '#E0A900' },
  { name: 'Brevo', icon: 'simple-icons:brevo', color: '#0B996E' },
  { name: 'Trello', icon: 'simple-icons:trello', color: '#0052CC' },
];
const loop = [...tools, ...tools];
---

<section class="lm" aria-label="Outils que j'automatise et connecte au quotidien">
  <div class="px-[var(--spacing-section-x)]">
    <h2 class="lm-title reveal">Qu'allons-nous automatiser demain&nbsp;?</h2>
  </div>

  <div class="lm-viewport reveal">
    <div class="lm-track">
      {loop.map((t, i) => (
        <span class="lm-tool" aria-hidden={i >= tools.length ? 'true' : 'false'}>
          <span class="lm-chip" style={t.color ? `--brand:${t.color}` : undefined}>
            <Icon name={t.icon} class="lm-tool-ic" aria-hidden="true" />
          </span>
          <span class="lm-tool-name">{t.name}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .lm { padding-block: clamp(2.5rem, 5vw, 4rem); }

  .lm-title {
    text-align: center;
    max-width: 24ch;
    margin: 0 auto;
    text-wrap: balance;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-title-lg);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-ink);
  }
  /* Desktop : titre forcé sur une seule ligne. */
  @media (min-width: 768px) {
    .lm-title { max-width: none; white-space: nowrap; }
  }

  .lm-viewport {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, var(--color-ink) 10%, var(--color-ink) 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, var(--color-ink) 10%, var(--color-ink) 90%, transparent);
  }
  .lm-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: clamp(2.5rem, 6vw, 5rem);
    animation: lm-scroll 34s linear infinite;
  }
  .lm-viewport:hover .lm-track { animation-play-state: paused; }
  @keyframes lm-scroll {
    to { transform: translateX(-50%); }
  }

  /* Outil = tuile à bordure couleur-de-marque (DA propre à l'outil) + nom gris. */
  .lm-tool {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }

  /* Tuile : bordure + icône dans la couleur officielle de la marque (--brand),
     fond très légèrement teinté. Fallback neutre si pas de couleur de marque. */
  .lm-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    color: var(--brand, var(--color-ink-faint));
    border: 1px solid color-mix(in oklab, var(--brand, var(--color-ink-faint)) 48%, transparent);
    background: color-mix(in oklab, var(--brand, var(--color-ink-faint)) 7%, var(--color-surface-high));
    transition: border-color var(--duration-default) var(--ease-out-quint),
                background-color var(--duration-default) var(--ease-out-quint),
                transform var(--duration-default) var(--ease-out-quint);
  }
  .lm-tool:hover .lm-chip {
    border-color: var(--brand, var(--color-ink-mid));
    background: color-mix(in oklab, var(--brand, var(--color-ink-faint)) 14%, var(--color-surface-high));
    transform: translateY(-2px);
  }
  .lm-tool-ic { width: 24px; height: 24px; flex-shrink: 0; }
  .lm-tool-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1vw + 0.85rem, 1.45rem);
    letter-spacing: -0.02em;
    color: var(--color-ink-faint);
    transition: color var(--duration-default) var(--ease-out-quint);
  }
  .lm-tool:hover .lm-tool-name { color: var(--color-ink-mid); }

  @media (prefers-reduced-motion: reduce) {
    .lm-viewport { -webkit-mask-image: none; mask-image: none; }
    .lm-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: clamp(1.5rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem);
    }
    .lm-tool[aria-hidden='true'] { display: none; }
  }
</style>
