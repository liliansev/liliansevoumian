---
/*
 * LogoMarquee — bande d'OUTILS défilante, juste après le hero.
 *
 * Logos de marque EN COULEUR, sans encadrés. Deux sources :
 *  - jeu iconify `logos:` (multicolore) pour les marques qui ont une vraie icône
 *    couleur (Slack, Gmail, Mistral, Drive…) ;
 *  - `simple-icons:` teinté à la couleur officielle de marque (via `color:`) pour
 *    les marques monochromes/absentes du set couleur (n8n, Make, Google Sheets,
 *    HubSpot, Stripe) — rendu identique au vrai logo, footprint homogène.
 *
 * Dark mode : les logos monochromes-foncés (Notion, OpenAI, Typeform) sont
 * inversés en blanc (`invertDark`) → lisibles sur fond sombre sans ajouter de
 * cadre. Boucle sans couture (liste doublée), fondu horizontal aux bords, pause
 * au survol, statique sous prefers-reduced-motion.
 */
import { Icon } from 'astro-icon/components';

interface Tool {
  name: string;
  icon: string;
  /** Teinte de marque (simple-icons monochromes rendus en currentColor). */
  color?: string;
  /** Teinte de marque alternative en dark mode (si la couleur claire manque de contraste). */
  /** Logo monochrome-foncé → inversé en blanc sur fond sombre. */
}

const tools: Tool[] = [
  { name: 'n8n', icon: 'simple-icons:n8n', color: '#EA4B71' },
  { name: 'Make', icon: 'simple-icons:make', color: '#6D00CC' },
  { name: 'Airtable', icon: 'simple-icons:airtable' , color: '#18BFFF' },
  { name: 'Notion', icon: 'simple-icons:notion' , color: '#000000' },
  { name: 'Google Sheets', icon: 'simple-icons:googlesheets', color: '#0F9D58' },
  { name: 'Slack', icon: 'simple-icons:slack' , color: '#4A154B' },
  { name: 'HubSpot', icon: 'simple-icons:hubspot', color: '#FF7A59' },
  { name: 'Stripe', icon: 'simple-icons:stripe', color: '#635BFF' },
  { name: 'OpenAI', icon: 'simple-icons:openai' , color: '#412991' },
  { name: 'Claude', icon: 'simple-icons:claude' , color: '#D97757' },
  { name: 'Mistral', icon: 'simple-icons:mistralai' , color: '#FA520F' },
  { name: 'Gmail', icon: 'simple-icons:gmail' , color: '#EA4335' },
  { name: 'Google Drive', icon: 'simple-icons:googledrive' , color: '#4285F4' },
  { name: 'Google Calendar', icon: 'simple-icons:googlecalendar' , color: '#4285F4' },
  { name: 'Calendly', icon: 'simple-icons:calendly', color: '#006BFF' },
  { name: 'Shopify', icon: 'simple-icons:shopify' , color: '#7AB55C' },
  { name: 'Typeform', icon: 'simple-icons:typeform' , color: '#262627' },
  { name: 'WhatsApp', icon: 'simple-icons:whatsapp' , color: '#25D366' },
  { name: 'Telegram', icon: 'simple-icons:telegram' , color: '#26A5E4' },
  { name: 'Discord', icon: 'simple-icons:discord' , color: '#5865F2' },
  { name: 'Brevo', icon: 'simple-icons:brevo', color: '#0B996E' },
  { name: 'Trello', icon: 'simple-icons:trello' , color: '#0052CC' },
  { name: 'Zapier', icon: 'simple-icons:zapier' , color: '#FF4F00' },
];
const loop = [...tools, ...tools];
---

<section class="lm" aria-label="Outils que j'automatise et connecte au quotidien">
  <div class="px-[var(--spacing-section-x)]">
    <h2 class="lm-title reveal">Votre <mark>Agent IA</mark> s'occupera de ça&nbsp;:</h2>
  </div>

  <div class="lm-viewport reveal">
    <div class="lm-track">
      {loop.map((t, i) => (
        <span
          class="lm-tool"
          aria-hidden={i >= tools.length ? 'true' : 'false'}
          style={t.color ? `--tool-c:${t.color}` : undefined}
        >
          <Icon
            name={t.icon}
            class:list={['lm-tool-ic', { 'is-tinted': !!t.color }]}
            aria-hidden="true"
          />
          <span class="lm-tool-name">{t.name}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  /* Beaucoup d'air autour de la bande → lecture premium. */
  .lm { padding-block: clamp(4rem, 8vw, 7rem); }

  .lm-title {
    text-align: center;
    max-width: 24ch;
    margin: 0 auto;
    text-wrap: balance;
    font-family: var(--font-display);
    font-weight: 600;
    /* --text-headline, comme les huit autres titres de section, et non
       --text-title-lg. Mesuré sur la page : ce H2 rendait 30 px, soit
       exactement la taille des neuf H3 des cartes, et il était le seul de son
       rang à ne pas passer par SectionHeader. Deux niveaux sémantiques pour
       une seule taille n'est pas une hiérarchie. */
    font-size: var(--text-headline);
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--color-ink);
  }
  /* Desktop : titre forcé sur une seule ligne. */
  @media (min-width: 768px) {
    .lm-title { max-width: none; white-space: nowrap; }
  }

  .lm-viewport {
    margin-top: clamp(2.75rem, 5vw, 4rem);
    /* Respiration verticale : headroom pour que le survol (scale) ne soit jamais
       rogné par l'overflow horizontal du marquee. */
    padding-block: 1.5rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, var(--color-ink) 8%, var(--color-ink) 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, var(--color-ink) 8%, var(--color-ink) 92%, transparent);
  }
  .lm-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: clamp(3.5rem, 8vw, 7rem);
    animation: lm-scroll 42s linear infinite;
    will-change: transform;
  }
  /* Pause au hover ET au focus clavier (WCAG 2.2.2 : contrôle du mouvement
     indépendant de la préférence OS reduced-motion). */
  .lm-viewport:hover .lm-track,
  .lm-viewport:focus-within .lm-track { animation-play-state: paused; }
  @keyframes lm-scroll {
    to { transform: translateX(-50%); }
  }

  /* Sur grand écran, davantage de logos sont visibles simultanément : un
     passage plus lent laisse le temps de les identifier sans effet ticker. */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .lm-track { animation-duration: 72s; }
  }

  /* Outil = logo couleur + nom en gris discret. */
  .lm-tool {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    opacity: 0.82;
    transition: opacity var(--duration-default) var(--ease-out-quint);
  }
  .lm-tool:hover { opacity: 1; }

  .lm-tool-ic {
    height: 30px;
    width: auto;
    flex-shrink: 0;
    transform-origin: center;
    transition: transform var(--duration-default) var(--ease-out-quint);
  }
  /* Léger zoom centré au survol — reste dans le headroom vertical, jamais rogné. */
  .lm-tool:hover .lm-tool-ic { transform: scale(1.09); }

  /* Marques monochromes teintées à leur couleur officielle. */
  /* Les logos sont en encre au repos : 23 couleurs de marque à 300 px du hero
   contredisaient la promesse d'un seul accent. La couleur officielle revient
   au survol — le clin d'œil est gardé, mais il devient un geste au lieu d'un
   bruit permanent. Sur pointeur grossier, il n'y a pas de survol : la couleur
   n'y apparaît jamais, et c'est acceptable, elle n'est pas porteuse de sens. */
.lm-tool-ic.is-tinted { color: var(--color-ink); }

@media (hover: hover) and (pointer: fine) {
  .lm-tool-ic.is-tinted { transition: color 0.18s cubic-bezier(0.25, 1, 0.5, 1); }
  .lm-tool:hover .lm-tool-ic.is-tinted { color: var(--tool-c); }
}

@media (prefers-reduced-motion: reduce) {
  .lm-tool-ic.is-tinted { transition: none; }
}

  /* Logos monochromes-foncés → inversés en blanc sur fond sombre. */

  .lm-tool-name {
    font-family: var(--font-display);
    font-weight: 500;
    /* Jeton, et non un clamp() recopié sur place : le bloc @theme est l'unique
       source de l'échelle, et une courbe écrite ici échappait à toute reprise
       globale. --text-title est le rang le plus proche de l'ancienne valeur. */
    font-size: var(--text-title);
    letter-spacing: -0.02em;
    /* ink-low, pas ink-faint : le nom de l'outil est porteur de sens (complément
       du logo) — ink-faint plafonnait à ~2:1 sur paper (fail WCAG 1.4.3). */
    color: var(--color-ink-low);
    transition: color var(--duration-default) var(--ease-out-quint);
  }
  .lm-tool:hover .lm-tool-name { color: var(--color-ink-mid); }

  @media (prefers-reduced-motion: reduce) {
    .lm-viewport { -webkit-mask-image: none; mask-image: none; }
    .lm-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: clamp(1.75rem, 4vw, 3rem) clamp(2.5rem, 5vw, 4.5rem);
    }
    .lm-tool[aria-hidden='true'] { display: none; }
  }
</style>
