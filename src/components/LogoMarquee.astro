---
/*
 * LogoMarquee — la bande d'outils qui défile, juste après le hero.
 *
 * Chaque outil est un logo `simple-icons` suivi de son nom. Les logos sont à
 * l'encre au repos : vingt-deux couleurs de marque sous le hero contrediraient
 * l'accent unique. La couleur officielle (`color`) ne revient qu'au survol,
 * sur un appareil à souris.
 *
 * La liste est doublée pour boucler sans couture, les bords se fondent, le
 * défilement s'arrête au survol et hors de l'écran (`data-motion-pause`). En
 * mouvement réduit, la bande devient une liste à plat dans la colonne.
 */
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';

interface Tool {
  name: string;
  icon: string;
  /** Couleur de marque, montrée au survol. Sans elle, le logo reste à l'encre. */
  color?: string;
}

const tools: Tool[] = [
  { name: 'n8n', icon: 'simple-icons:n8n', color: '#EA4B71' },
  { name: 'Make', icon: 'simple-icons:make', color: '#6D00CC' },
  { name: 'Airtable', icon: 'simple-icons:airtable', color: '#18BFFF' },
  // Sans teinte : la couleur de marque de Notion et de Typeform est un noir,
  // et au survol le logo disparaissait dans la nuit. Ils restent à l'encre.
  { name: 'Notion', icon: 'simple-icons:notion' },
  { name: 'Google Sheets', icon: 'simple-icons:googlesheets', color: '#0F9D58' },
  { name: 'Slack', icon: 'simple-icons:slack', color: '#4A154B' },
  { name: 'HubSpot', icon: 'simple-icons:hubspot', color: '#FF7A59' },
  { name: 'Stripe', icon: 'simple-icons:stripe', color: '#635BFF' },
  { name: 'OpenAI', icon: 'simple-icons:openai', color: '#412991' },
  { name: 'Claude', icon: 'simple-icons:claude', color: '#D97757' },
  { name: 'Mistral', icon: 'simple-icons:mistralai', color: '#FA520F' },
  { name: 'Gmail', icon: 'simple-icons:gmail', color: '#EA4335' },
  { name: 'Google Drive', icon: 'simple-icons:googledrive', color: '#4285F4' },
  { name: 'Google Calendar', icon: 'simple-icons:googlecalendar', color: '#4285F4' },
  { name: 'Calendly', icon: 'simple-icons:calendly', color: '#006BFF' },
  { name: 'Shopify', icon: 'simple-icons:shopify', color: '#7AB55C' },
  { name: 'Typeform', icon: 'simple-icons:typeform' },
  { name: 'WhatsApp', icon: 'simple-icons:whatsapp', color: '#25D366' },
  { name: 'Telegram', icon: 'simple-icons:telegram', color: '#26A5E4' },
  { name: 'Discord', icon: 'simple-icons:discord', color: '#5865F2' },
  { name: 'Brevo', icon: 'simple-icons:brevo', color: '#0B996E' },
  { name: 'Trello', icon: 'simple-icons:trello', color: '#0052CC' },
  // Pas de Zapier : c'est le concurrent direct des deux plateformes vendues
  // sur la page, et il n'apparaît dans aucun cas client.
];
const loop = [...tools, ...tools];
---

<section
  class="lm relative border-b border-[var(--color-divider)] py-[var(--spacing-section-y)]"
  data-motion-pause
  aria-label="Outils que j’automatise et connecte au quotidien"
>
  {/* Le titre est sur la colonne de la page, comme ceux des autres sections ;
      la bande, elle, va d'un bord à l'autre de l'écran. */}
  <div class="px-[var(--spacing-section-x)]">
    <div class="mx-auto max-w-[1200px]">
      <SectionHeader title="Ce que je branche à vos agents&nbsp;IA&nbsp;:" titleMaxWidth="none" spacing="none" />
    </div>
  </div>

  <div class="lm-viewport reveal">
    <div class="lm-track">
      {loop.map((t, i) => (
        <span
          class="lm-tool"
          aria-hidden={i >= tools.length ? 'true' : 'false'}
          style={t.color ? `--tool-c:${t.color}` : undefined}
        >
          <Icon
            name={t.icon}
            class:list={['lm-tool-ic', { 'is-tinted': !!t.color }]}
            aria-hidden="true"
          />
          <span class="lm-tool-name">{t.name}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .lm-viewport {
    margin-top: var(--spacing-groupe);
    /* De la hauteur autour de la piste : le zoom du survol n'est jamais rogné
       par le débordement horizontal masqué. */
    padding-block: 1.5rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, var(--color-ink) 8%, var(--color-ink) 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, var(--color-ink) 8%, var(--color-ink) 92%, transparent);
  }

  .lm-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: var(--spacing-bloc);
    animation: lm-scroll 42s linear infinite;
    will-change: transform;
  }

  /* Arrêt au survol et au focus, indépendant de la préférence de mouvement
     réduit du système (WCAG 2.2.2). */
  .lm-viewport:hover .lm-track,
  .lm-viewport:focus-within .lm-track { animation-play-state: paused; }

  @keyframes lm-scroll {
    to { transform: translateX(-50%); }
  }

  /* Sur grand écran, davantage de logos sont visibles en même temps : un
     passage plus lent laisse le temps de les reconnaître. */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .lm-track { animation-duration: 72s; }
  }

  .lm-tool {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }

  /* L'atténuation porte sur le logo seul : posée sur `.lm-tool`, elle
     prendrait aussi le nom, qui retomberait sous le seuil de contraste. */
  .lm-tool-ic {
    height: 30px;
    width: auto;
    flex-shrink: 0;
    transform-origin: center;
    opacity: 0.82;
    transition: transform var(--duration-default) var(--ease-out-quint),
                opacity var(--duration-default) var(--ease-out-quint);
  }

  .lm-tool:hover .lm-tool-ic {
    opacity: 1;
    transform: scale(1.09);
  }

  .lm-tool-ic.is-tinted { color: var(--color-ink); }

  /* La transition de la teinte reprend aussi `transform` et `opacity` : plus
     spécifique que celle de `.lm-tool-ic`, elle couperait sinon le zoom et
     l'éclaircissement du logo. */
  @media (hover: hover) and (pointer: fine) {
    .lm-tool-ic.is-tinted {
      transition: color var(--duration-default) var(--ease-out-quart),
                  transform var(--duration-default) var(--ease-out-quint),
                  opacity var(--duration-default) var(--ease-out-quint);
    }

    /* La teinte de marque est relevée de 30 % de blanc : plusieurs marques sont
       sombres (l'aubergine de Slack, le violet d'OpenAI) et, posées telles
       quelles sur la nuit, elles éteindraient le logo qu'on vient de viser. */
    .lm-tool:hover .lm-tool-ic.is-tinted { color: color-mix(in oklab, var(--tool-c) 70%, white); }
  }

  /* `ink-low` et non `ink-faint` : le nom complète le logo, il porte du sens
     et doit tenir le contraste. */
  .lm-tool-name {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink-low);
    transition: color var(--duration-default) var(--ease-out-quint);
  }

  .lm-tool:hover .lm-tool-name { color: var(--color-ink-mid); }

  /* Mouvement réduit : plus de défilement ni de zoom. La liste passe à la
     ligne dans la colonne de la page, sous le titre, un exemplaire de chaque
     outil ; la teinte et l'opacité répondent encore. */
  @media (prefers-reduced-motion: reduce) {
    .lm-viewport {
      padding-inline: var(--spacing-section-x);
      -webkit-mask-image: none;
      mask-image: none;
    }

    .lm-track {
      width: auto;
      max-width: 1200px;
      margin-inline: auto;
      flex-wrap: wrap;
      gap: var(--spacing-lie) var(--spacing-gouttiere);
      animation: none;
    }

    .lm-tool[aria-hidden='true'] { display: none; }
    .lm-tool-ic.is-tinted { transition: none; }
    .lm-tool:hover .lm-tool-ic { transform: none; }
  }
</style>
