---
import SectionHeader from './SectionHeader.astro';

const services = [
  {
    kind: 'automation',
    href: '/automatisations-ia',
    title: 'Automatisation & IA',
    signal: 'Vos équipes recopient, classent ou relancent encore à la main.',
    body: 'Workflows n8n et Make, agents IA, intégrations et outils métier construits autour de vos opérations.',
    details: ['Automatiser', 'Connecter', 'Construire un agent'],
    proof: 'Cas publié : 1 à 3 h → 7 à 10 min',
    action: 'Explorer Automatisation & IA',
    source: 'home_services_automation',
  },
  {
    kind: 'web',
    href: '/sites-web-abonnement',
    title: 'Sites web',
    signal: 'Votre site doit être créé, repris ou amélioré dans la durée.',
    body: 'Landing page, site vitrine ou outil web, avec un périmètre clair puis une vraie continuité après la mise en ligne.',
    details: ['Créer', 'Maintenir', 'Améliorer'],
    proof: 'Portfolio : 6 réalisations publiques',
    action: 'Explorer les sites web',
    source: 'home_services_web',
  },
] as const;
---

<section
  id="services"
  data-section
  class="relative border-b border-[var(--color-border-strong)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader
      title="Quel sujet voulez-vous <mark>faire avancer&nbsp;?</mark>"
      body="Choisissez le terrain qui ressemble à votre projet. Chaque page détaille les services, les preuves et la façon de travailler avant de proposer un rendez-vous."
      titleMaxWidth="21ch"
      bodyMaxWidth="58ch"
    />

    <div class="home-services">
      {services.map((service) => (
        <a
          href={service.href}
          class:list={['home-service-card', `home-service-card--${service.kind}`]}
          data-fast-goal="service_path_opened"
          data-fast-goal-source={service.source}
        >
          <p class="home-service-card__signal">{service.signal}</p>
          <h3>{service.title}</h3>
          <p class="home-service-card__body">{service.body}</p>

          <ul aria-label={`Périmètre ${service.title}`}>
            {service.details.map((detail) => <li>{detail}</li>)}
          </ul>

          <div class="home-service-card__foot">
            <span>{service.proof}</span>
            <strong>{service.action} <i aria-hidden="true">→</i></strong>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .home-services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--color-border-strong);
  }

  .home-service-card {
    display: flex;
    min-width: 0;
    min-height: 34rem;
    flex-direction: column;
    padding: clamp(2rem, 4vw, 3.5rem);
    background: var(--color-paper);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      background-color var(--duration-default) var(--ease-out-quint),
      color var(--duration-default) var(--ease-out-quint);
  }

  .home-service-card--automation {
    background: var(--color-lime);
  }

  .home-service-card + .home-service-card {
    border-left: 1px solid var(--color-border-strong);
  }

  .home-service-card__signal {
    max-width: 34ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.55;
  }

  .home-service-card h3 {
    max-width: 10ch;
    margin: 2.5rem 0 0;
    color: var(--color-ink);
    font-size: var(--text-home-service);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.035em;
    transition: transform var(--duration-default) var(--ease-out-quint);
  }

  .home-service-card__body {
    max-width: 38ch;
    margin: 1.5rem 0 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .home-service-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 2rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }

  .home-service-card li {
    color: var(--color-ink);
    font-size: var(--text-mono-label);
    font-weight: 550;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .home-service-card li + li::before {
    content: '·';
    display: inline-block;
    margin: 0 0.65rem;
    color: var(--color-ink-low);
  }

  .home-service-card__foot {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2.5rem;
  }

  .home-service-card__foot > span {
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    font-variant-numeric: tabular-nums;
  }

  .home-service-card__foot strong {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--color-border-strong);
    padding-top: 1rem;
    font-size: var(--text-button);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .home-service-card__foot i {
    font-style: normal;
    transition: transform var(--duration-default) var(--ease-out-quint);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-service-card:hover {
      background: var(--color-ink);
      color: var(--color-paper);
    }

    .home-service-card:hover :is(h3, p, li, .home-service-card__foot > span, .home-service-card__foot strong) {
      color: var(--color-paper);
    }

    .home-service-card:hover :is(ul, .home-service-card__foot strong) {
      border-color: var(--color-paper);
    }

    .home-service-card:hover h3 {
      transform: translateY(-0.2rem);
    }

    .home-service-card:hover .home-service-card__foot i {
      transform: translateX(0.35rem);
    }
  }

  @media (max-width: 767px) {
    .home-services {
      grid-template-columns: 1fr;
    }

    .home-service-card {
      min-height: 30rem;
    }

    .home-service-card + .home-service-card {
      border-top: 1px solid var(--color-border-strong);
      border-left: 0;
    }
  }
</style>
