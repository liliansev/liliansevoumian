---
import SectionHeader from './SectionHeader.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ServiceWorkflowVisual from './service-workflow-visual.astro';
import dashboardVisual from '../assets/home-services/interfaces/commercial-dashboard.png';
import { automationStartingPrice, webStartingPrice } from '../data/service-pricing';

const services = [
  {
    kind: 'automation',
    href: '/automatisations-ia',
    titleLines: ['Automatisation', '& IA'],
    body: 'Workflows n8n et Make, agents IA et intégrations dans vos outils.',
    price: automationStartingPrice,
    source: 'home_services_automation',
  },
  {
    kind: 'web',
    href: '/sites-web-abonnement',
    titleLines: ['Sites &', 'applications web'],
    body: 'Landing pages, dashboards, portails clients et applications métier, de la conception aux évolutions.',
    price: webStartingPrice,
    source: 'home_services_web',
  },
] as const;
---

<section id="services" data-section class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]">
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader title="Des automatisations et des <mark>applications métier.</mark>" titleMaxWidth="none" />
    <div class="home-services">
      {services.map((service) => (
        <a
          href={service.href}
          class:list={['home-service-card', `home-service-card--${service.kind}`]}
          data-fast-goal="service_path_opened"
          data-fast-goal-source={service.source}
        >
          <h3>{service.titleLines.map((line, index) => <span>{line}{index === 0 ? ' ' : ''}</span>)}</h3>
          <p class="home-service-card__body">{service.body}</p>
          <span class="home-service-card__media">
            {service.kind === 'automation' ? <ServiceWorkflowVisual /> : <Image
              src={dashboardVisual}
              alt="Exemple de dashboard commercial : chiffre d’affaires, opportunités, pipeline et prochaines relances. Données de démonstration."
              widths={[384, 640, 960, 1200]}
              sizes="(min-width: 1440px) 585px, (min-width: 900px) 45vw, 90vw"
              format="webp"
              quality={85}
              loading="lazy"
              decoding="async"
              class="home-service-card__visual"
            />}
          </span>
          <span class="home-service-card__footer">
            <span class="home-service-card__price"><span>À partir de</span><strong>{service.price.toLocaleString('fr-FR')} € <small>HT</small></strong></span>
            <span class="home-service-card__action">En savoir plus <Icon name="lucide:arrow-right" aria-hidden="true" /></span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .home-services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto 1fr auto;
    gap: 1.5rem;
  }
  .home-service-card {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    min-width: 0;
    padding-block: var(--spacing-service-card);
    border: 1px solid var(--color-service-border);
    background: var(--color-paper);
    color: var(--color-ink);
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--duration-default) var(--ease-out-quint);
  }
  .home-service-card > :is(h3, p, .home-service-card__footer) {
    margin: 0;
    margin-inline: var(--spacing-service-card);
  }
  .home-service-card h3 {
    container-type: inline-size;
    color: var(--color-ink);
    font-size: inherit;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .home-service-card h3 span {
    display: block;
    font-size: var(--text-home-service);
    white-space: nowrap;
  }
  .home-service-card__body {
    max-width: 48ch;
    color: var(--color-ink-mid);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .home-service-card__media {
    display: block;
    overflow: hidden;
    border-block: 1px solid var(--color-divider);
    background: var(--color-surface-low);
  }
  .home-service-card__media :global(.workflow-visual) { border: 0; }
  .home-service-card :global(.home-service-card__visual) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .home-service-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .home-service-card__price { display: grid; gap: 0.25rem; }
  .home-service-card__price > span { color: var(--color-ink-mid); font-size: var(--text-body-sm); }
  .home-service-card__price strong {
    font-size: var(--text-title-lg);
    font-weight: 600;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .home-service-card__price small { font-size: var(--text-body-sm); font-weight: 400; }
  .home-service-card__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 44px;
    font-size: var(--text-body-sm);
    font-weight: 550;
    white-space: nowrap;
  }
  .home-service-card__action :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform var(--duration-default) var(--ease-out-quint);
  }
  @media (hover: hover) and (pointer: fine) {
    .home-service-card:hover { border-color: var(--color-night); }
    .home-service-card:hover .home-service-card__action { text-decoration: underline; text-underline-offset: 0.3em; }
    .home-service-card:hover .home-service-card__action :global(svg) { transform: translateX(0.2rem); }
  }
  @media (max-width: 899px) {
    .home-services { grid-template-columns: 1fr; grid-template-rows: auto; gap: 2rem; }
    .home-service-card { grid-template-rows: auto auto auto auto; grid-row: auto; gap: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-service-card, .home-service-card__action :global(svg) { transition: none; }
  }
</style>
