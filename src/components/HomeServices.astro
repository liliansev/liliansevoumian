---
import SectionHeader from './SectionHeader.astro';
import BoutonReservation from './BoutonReservation.astro';

const services = [
  {
    kind: 'automation',
    href: '/automatisations-ia',
    title: 'Automatisation & IA',
    titleLines: ['Automatisation', '& IA'],
    signal: 'Trop de ressaisies, de classements ou de relances manuelles.',
    body: 'Workflows n8n et Make, agents IA et intégrations dans vos outils.',
    details: ['Automatiser', 'Connecter', 'Construire un agent'],
    proof: 'Cas publié : 1 à 3 h → 7 à 10 min',
    action: 'Explorer Automatisation & IA',
    source: 'home_services_automation',
  },
  {
    kind: 'web',
    href: '/sites-web-abonnement',
    title: 'Sites & applications web',
    titleLines: ['Sites &', 'applications web'],
    signal: 'Une offre à présenter ou un outil pour votre équipe.',
    body: 'Landing pages, dashboards, portails clients et applications métier, de la conception aux évolutions.',
    details: ['Créer', 'Maintenir', 'Améliorer'],
    proof: 'Portfolio : 6 réalisations publiques',
    action: 'Explorer les projets web',
    source: 'home_services_web',
  },
] as const;
---

<section
  id="services"
  data-section
  class="relative border-b border-[var(--color-border-strong)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader
      title="Deux expertises pour <mark>vos projets.</mark>"
      titleMaxWidth="none"
    />

    <div class="home-services">
      {services.map((service) => (
        <a
          href={service.href}
          class:list={['home-service-card', `home-service-card--${service.kind}`]}
          data-fast-goal="service_path_opened"
          data-fast-goal-source={service.source}
        >
          <p class="home-service-card__signal">{service.signal}</p>
          <h3>{service.titleLines.map((line, index) => <span>{line}{index === 0 ? ' ' : ''}</span>)}</h3>
          <p class="home-service-card__body">{service.body}</p>

          <ul aria-label={`Périmètre ${service.title}`}>
            {service.details.map((detail) => <li>{detail}</li>)}
          </ul>

          <span class="home-service-card__proof">{service.proof}</span>
          <strong class="home-service-card__action">{service.action} <i aria-hidden="true">→</i></strong>
        </a>
      ))}
    </div>

    <div class="mt-8">
      <BoutonReservation source="home_services" class="btn-primary">Parler de mon projet</BoutonReservation>
    </div>
  </div>
</section>

<style>
  .home-services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto auto auto 1fr auto;
    row-gap: 1.5rem;
    border: 1px solid var(--color-border-strong);
  }

  .home-service-card {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 6;
    min-width: 0;
    min-height: 31rem;
    padding: var(--spacing-service-card);
    background: var(--color-paper);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      background-color var(--duration-default) var(--ease-out-quint),
      color var(--duration-default) var(--ease-out-quint);
  }

  .home-service-card--automation {
    background: var(--color-lime);
    --color-ink-mid: #2e2e2e;
    --color-ink-low: #3a3a3a;
  }

  .home-service-card + .home-service-card {
    border-left: 1px solid var(--color-border-strong);
  }

  .home-service-card__signal {
    max-width: 42ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.55;
  }

  .home-service-card h3 {
    container-type: inline-size;
    max-width: none;
    margin: 0;
    color: var(--color-ink);
    font-size: inherit;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    transition: transform var(--duration-default) var(--ease-out-quint);
  }

  .home-service-card h3 span {
    display: block;
    font-size: var(--text-home-service);
    white-space: nowrap;
  }

  .home-service-card__body {
    max-width: 48ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .home-service-card ul {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }

  .home-service-card li {
    color: var(--color-ink);
    font-size: var(--text-mono-label);
    font-weight: 550;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .home-service-card__proof {
    align-self: end;
    padding-top: 1rem;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    font-variant-numeric: tabular-nums;
  }

  .home-service-card__action {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--color-border-strong);
    padding-top: 1rem;
    font-size: var(--text-button);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .home-service-card__action i {
    font-style: normal;
    transition: transform var(--duration-default) var(--ease-out-quint);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-service-card:hover {
      background: var(--color-ink);
      color: var(--color-paper);
    }

    .home-service-card:hover :is(h3, p, li, .home-service-card__proof, .home-service-card__action) {
      color: var(--color-paper);
    }

    .home-service-card:hover :is(ul, .home-service-card__action) {
      border-color: var(--color-paper);
    }

    .home-service-card:hover h3 {
      transform: translateY(-0.2rem);
    }

    .home-service-card:hover .home-service-card__action i {
      transform: translateX(0.35rem);
    }
  }

  @media (max-width: 899px) {
    .home-services {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      row-gap: 0;
    }

    .home-service-card {
      grid-template-rows: auto auto auto auto 1fr auto;
      grid-row: auto;
      gap: 1.5rem;
      min-height: 0;
    }

    .home-service-card + .home-service-card {
      border-top: 1px solid var(--color-border-strong);
      border-left: 0;
    }
  }
</style>
