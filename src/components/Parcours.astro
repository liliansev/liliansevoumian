---
const timeline = [
  {
    year: "2021",
    title: "Découverte du no-code",
    description: "Premiers pas avec Make et les outils d'automatisation. Début de l'aventure freelance et premières missions.",
    isCurrent: false
  },
  {
    year: "2022",
    title: "Premières formations",
    description: "Lancement des formations Make et n8n. +100 personnes formées la première année.",
    isCurrent: false
  },
  {
    year: "2024",
    title: "Passage à l'échelle",
    description: "+50 entreprises automatisées. Formation de +300 personnes aux outils no-code et automatisation.",
    isCurrent: false
  },
  {
    year: "2026",
    title: "IA & Automations avancées",
    description: "Intégration de l'IA avec Claude et workflows complexes. Automatisation de nouvelle génération.",
    isCurrent: true
  }
];
---

<section id="parcours" class="bg-[#F4F4F5] py-20 px-6 lg:px-[120px]">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-12 flex flex-col gap-4">
      <span class="font-mono text-[13px] font-semibold text-[#A1A1AA] tracking-[2px]">// Mon parcours</span>
      <h2 class="text-[32px] lg:text-[40px] font-extrabold text-black leading-[0.95] tracking-[-1px]">
        De gamer à automaticien
      </h2>
      <p class="text-[18px] text-[#71717A] font-normal leading-[1.5] max-w-[600px]">
        Un parcours atypique guidé par la curiosité, l'optimisation et l'envie de construire des systèmes qui tournent tout seuls.
      </p>
    </div>

    <!-- Timeline entries -->
    <div class="flex flex-col">
      {timeline.map((item, index) => (
        <div class={`flex items-start gap-8 py-6 ${index < timeline.length - 1 ? 'border-b border-[#E4E4E7]' : ''}`}>
          <!-- Year badge -->
          <div class={`shrink-0 w-[100px] flex items-center justify-center px-4 py-2 rounded-lg font-mono text-sm font-extrabold ${
            item.isCurrent ? 'bg-black text-white' : 'bg-white text-black'
          }`}>
            {item.year}
          </div>

          <!-- Content -->
          <div class="flex flex-col gap-1.5">
            <h3 class="text-lg font-bold text-black">{item.title}</h3>
            <p class="text-sm text-[#71717A] font-normal leading-[1.5]">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
