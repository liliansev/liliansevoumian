---
import { Icon } from 'astro-icon/components';

interface Tool {
  name: string;
  icon: string;
  desc: string;
}

interface TimelineItem {
  year: string;
  title: string;
  description: string;
  icon: string;
  tags: string[];
  current: boolean;
}

const tools: Tool[] = [
  { name: "Make", icon: "simple-icons:make", desc: "Orchestration de workflows sans code" },
  { name: "n8n", icon: "simple-icons:n8n", desc: "Automatisations open-source avancées" },
  { name: "Airtable", icon: "simple-icons:airtable", desc: "Base de données collaborative" },
  { name: "API", icon: "lucide:plug", desc: "Connexions sur-mesure entre outils" },
  { name: "Claude AI", icon: "simple-icons:anthropic", desc: "Intelligence artificielle intégrée" },
];

const pixelColors = [
  "var(--accent)", "var(--border)",
  "var(--accent)", "var(--border)",
  "var(--accent)", "var(--border)",
  "var(--accent)", "var(--border)",
  "var(--accent)", "var(--border)",
  "var(--accent)", "var(--border)",
  "var(--accent)"
];

const timeline: TimelineItem[] = [
  {
    year: "2025 — now",
    title: "Formation & Outils IA",
    description: "Création de formation-n8n.com et meilleurs.tools. Intégration de l'IA dans les workflows d'automatisation.",
    icon: "lucide:brain",
    tags: ["n8n", "Claude Code", "IA"],
    current: true,
  },
  {
    year: "2023 — 2024",
    title: "Entrepreneuriat & Expertise",
    description: "Lancement d'apprendre-make.com et co-fondation de La Capsule (studio podcast). Certification Make niveau 5 — 1er français, top 5 mondial.",
    icon: "lucide:rocket",
    tags: ["Make", "Airtable", "Podcast"],
    current: false,
  },
  {
    year: "2022",
    title: "No-Code Engineer",
    description: "No-Code Engineer chez Jellysmack. Certification Make niveau 4. +14 000 messages sur le Slack NoCode France pour aider la communauté.",
    icon: "lucide:code",
    tags: ["Make", "Airtable", "Jellysmack"],
    current: false,
  },
  {
    year: "2021",
    title: "Premiers clients freelance",
    description: "Premières missions d'automatisation pour Qonto, KlaK, WeTechCare et Familytrip. Début de l'activité freelance Make & Airtable.",
    icon: "lucide:briefcase",
    tags: ["Make", "Airtable", "Freelance"],
    current: false,
  },
  {
    year: "2020",
    title: "Découverte du NoCode",
    description: "Plongée dans l'univers NoCode et les premiers scénarios d'automatisation. Début d'une passion dévorante pour Make.",
    icon: "lucide:compass",
    tags: ["NoCode", "Make"],
    current: false,
  },
];
---

<!-- Stack Technique: bg-darkest -->
<section id="outils" class="fade-in-section bg-[var(--bg-darkest)] py-16 lg:py-20">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-[60px]">
    <!-- Header -->
    <div class="flex flex-col items-center gap-4 mb-10">
      <span class="font-mono text-xs font-semibold text-[var(--accent)] tracking-[3px]">// STACK TECHNIQUE</span>
      <h2 class="font-heading text-[28px] lg:text-[40px] font-extrabold text-[var(--text-primary)] text-center tracking-[-1px]">
        Les outils que je maîtrise
      </h2>
    </div>

    <!-- Mobile: Pills (icon + name) -->
    <div class="flex flex-wrap items-center justify-center gap-2 md:hidden">
      {tools.map((tool) => (
        <span class="inline-flex items-center gap-1.5 font-mono text-[10px] font-semibold text-[var(--text-muted)] tracking-[1px] px-2.5 py-1.5 bg-[var(--bg-card)] border border-[var(--border)]">
          <Icon name={tool.icon} class="w-3.5 h-3.5 text-[var(--accent)]" />
          {tool.name}
        </span>
      ))}
    </div>

    <!-- Desktop: Full Cards -->
    <div class="hidden md:flex md:flex-wrap md:justify-center md:gap-4 mc-stagger">
      {tools.map((tool) => (
        <div class="mc-card w-[160px] lg:w-[220px] bg-[var(--bg-card)] border border-[var(--border)] p-5 flex flex-col items-center gap-3">
          <div class="w-12 h-12 flex items-center justify-center">
            <Icon name={tool.icon} class="w-8 h-8 text-[var(--accent)]" />
          </div>
          <span class="font-mono text-xs font-bold text-[var(--text-primary)] tracking-[1px]">{tool.name}</span>
          <span class="font-mono text-[10px] text-[var(--text-secondary)] leading-[1.5] text-center">{tool.desc}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Pixel Divider -->
<div class="flex items-center justify-center gap-0 py-2 bg-[var(--bg-darkest)]">
  {pixelColors.map((color) => (
    <div class="w-1 h-1" style={`background: ${color}`}></div>
  ))}
</div>

<!-- Timeline Parcours: bg-darkest -->
<section id="parcours" class="fade-in-section bg-[var(--bg-darkest)] py-16 lg:py-20">
  <div class="max-w-[800px] mx-auto px-6">
    <!-- Header -->
    <div class="flex flex-col items-center gap-4 mb-12">
      <span class="font-mono text-xs font-semibold text-[var(--accent)] tracking-[3px]">// PARCOURS</span>
      <h2 class="font-heading text-[28px] lg:text-[40px] font-extrabold text-[var(--text-primary)] tracking-[-1px] text-center">
        Un parcours d'optimisation continue
      </h2>
    </div>

    <!-- Vertical Timeline -->
    <div class="relative">
      <!-- Vertical line — centered on 12px node dot (left-[5px] = 6px center - 0.5px line) -->
      <div class="absolute left-[5px] md:left-[5px] top-0 bottom-0 w-px bg-[var(--border)]" aria-hidden="true"></div>

      <ol class="flex flex-col gap-8 mc-stagger" aria-label="Parcours professionnel">
        {timeline.map((item) => (
          <li class="relative flex gap-4 md:gap-6">
            <!-- Node dot -->
            <div class={`relative z-10 w-3 h-3 shrink-0 mt-5 ${item.current ? 'bg-[var(--accent)]' : 'border border-[var(--text-muted)] bg-transparent'}`}></div>

            <!-- Card -->
            <div class={`mc-card flex-1 bg-[var(--bg-card)] border ${item.current ? 'border-[var(--accent)]' : 'border-[var(--border)]'} p-5`}>
              <!-- Year -->
              <span class="font-mono text-[10px] font-bold text-[var(--text-secondary)] tracking-[1px] mb-2 block">
                {item.year}
              </span>
              <!-- Title with icon -->
              <div class="flex items-center gap-2 mb-2">
                <Icon name={item.icon} class={`w-5 h-5 shrink-0 ${item.current ? 'text-[var(--accent)]' : 'text-[var(--text-secondary)]'}`} />
                <h3 class="font-heading text-base font-bold text-[var(--text-primary)]">{item.title}</h3>
              </div>
              <!-- Description -->
              <p class="font-mono text-[13px] text-[var(--text-secondary)] leading-[1.6] mb-3">{item.description}</p>
              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class={`font-mono text-[10px] font-semibold tracking-[0.5px] px-2 py-0.5 ${item.current ? 'bg-[var(--accent-surface)] text-[var(--accent-light)]' : 'bg-[rgba(255,255,255,0.04)] text-[var(--text-muted)]'}`}>
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
