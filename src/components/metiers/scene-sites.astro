---
/*
 * scene-sites — la scène du métier Dashboards et outils métiers : « un outil
 * fait pour votre équipe, et le dashboard qui compte ce qu'elle y fait ».
 * Le fichier, sa classe racine et son attribut `data-scene-sites` gardent
 * leur nom d'origine : d'autres composants les importent.
 *
 * L'idée à faire passer en cinq secondes, téléphone en main : un outil métier
 * se monte, l'équipe s'en sert, le dashboard compte.
 *
 * Le fil de la boucle, un seul mouvement à la fois :
 *   1. un cadre de sélection pose l'écran bloc par bloc (titre, bouton,
 *      équipe, champs), comme on le monte dans un éditeur ;
 *   2. l'écran passe en service ;
 *   3. le bouton est cliqué, trois à cinq fois, de plus en plus vite : chaque
 *      clic traverse le fil et devient une unité de plus sur la barre du jour,
 *      le nombre de dossiers monte, l'objectif du mois se remplit avec lui ;
 *   4. l'image est tenue, puis on change de jour : les barres glissent d'une
 *      colonne, l'écran se défait, le suivant se monte.
 *
 * Le panneau, les fenêtres, la feuille, le fil, le temps et les quatre tailles
 * de texte viennent du socle (`scene-metier.css` et `lib/metiers/scene.ts`).
 * Ce composant n'écrit que ce qui lui est propre : l'écran de l'outil et son
 * cadre de sélection, le clic, le dashboard (deux nombres, des barres en
 * unités), et l'ordre de sa boucle.
 *
 * Ce qui se lit est compté : l'adresse, l'état de l'outil, le libellé du
 * bouton, « Dossiers », « Objectif », « Objectif du mois » et leurs nombres.
 * Tout le reste est un trait : les onglets, le titre, les visages de l'équipe,
 * les champs du formulaire. Il n'y a ni échelle, ni lettres de jours, ni
 * cotes : à la taille de la note, ils ne tenaient pas.
 *
 * Sur le plan étroit (téléphone), la scène change de silhouette pour ne pas
 * ressembler à ses voisines : la fenêtre de l'outil prend toute la largeur, en
 * haut, et le dashboard devient une bande en bas (les dossiers, l'objectif,
 * les barres), reliée par un fil vertical et court. Une seule pastille, celle
 * de la promesse.
 *
 * Sans script ou en mouvement réduit, la scène est une image fixe : l'écran
 * monté et en service, le dashboard rempli.
 *
 * Tous les chiffres sont inventés pour la scène, et ils sont justes entre eux
 * à chaque instant : « Objectif » est le nombre de dossiers traités ce mois-ci
 * divisé par l'objectif du mois. Il ne part jamais de zéro (le mois est déjà
 * entamé quand la scène commence) et ne dépasse jamais 100 % : quand
 * l'objectif est atteint, le mois est bouclé et la scène repart sur le
 * suivant, entamé au même point.
 */
import './scene-metier.css';

/* Trois écrans du même outil, qui tournent : d'une boucle à l'autre, ce n'est
   pas le même geste d'équipe qui revient. `titre` et `texte` sont les
   longueurs des barres, `champs` celles des valeurs saisies, en pour cent. */
const ecrans = [
  { chemin: '/interventions', bouton: 'Clôturer l’intervention', titre: [90, 62], texte: [76, 48], champs: [62, 44] },
  { chemin: '/stock', bouton: 'Enregistrer une sortie', titre: [74, 52], texte: [62, 40], champs: [40, 60] },
  { chemin: '/chantiers', bouton: 'Valider le relevé', titre: [70, 86], texte: [80, 54], champs: [72, 34] },
];

/* Le nombre de clics sur le bouton, journée après journée : un dossier traité
   par clic. */
const CLICS = [4, 3, 5];
/* Les six jours d'avant, en dossiers par jour : 23 à eux six. */
const HISTORIQUE = [3, 5, 2, 4, 6, 3];
/* L'objectif du mois, en dossiers, et ceux que l'équipe a déjà traités ce
   mois-ci avant la première journée de la scène : 26 sur 50, soit 52 % au
   matin. Un dossier vaut deux points, tous les pourcentages tombent juste.
   Avec quatre dossiers de plus dans la journée, la première image finale lit
   30 dossiers, 60 %. Les trois écrans en apportent douze à eux trois : en six
   journées (60, 66, 76, 84, 90, puis 100 %), l'objectif est atteint tout
   rond, et le mois suivant repart de 26. */
const OBJECTIF_DU_MOIS = 50;
const DEJA_TRAITES = 26;
/* La hauteur d'une barre, en dossiers : une unité par dossier. */
const UNITES = 6;

const formatEntier = new Intl.NumberFormat('fr-FR');

const recit = {
  ecrans,
  clics: CLICS,
  historique: HISTORIQUE,
  dejaTraites: DEJA_TRAITES,
  objectif: OBJECTIF_DU_MOIS,
};

/* L'image fixe : le premier écran, la première journée, tout est passé. */
const ecran = ecrans[0];
const clics = CLICS[0] ?? 0;
const dossiers = DEJA_TRAITES + clics;
const avancement = `${formatEntier.format(Math.round((dossiers / OBJECTIF_DU_MOIS) * 100))} %`;
const colonnes = [...HISTORIQUE, clics, 0];
const voyageurs = Array.from({ length: Math.max(...CLICS) });
---

<div
  class="sm est-abouti"
  data-scene-sites
  data-recit={JSON.stringify(recit)}
  role="img"
  aria-label="Un outil métier se monte bloc par bloc et passe en service&nbsp;; l’équipe s’en sert, et le dashboard compte chaque dossier traité&nbsp;: l’objectif du mois se remplit."
>
  <div class="sm-plan" aria-hidden="true" data-nosnippet>
    {/* Deux pastilles sur le grand plan, une seule sur l'étroit : celle de la
       promesse, l'objectif qui se remplit. */}
    <div class="sm-puces">
      <span class="sm-puce sm-large">
        <svg viewBox="0 0 16 16"><path d="M2.5 4.5h3.9l1.4 1.5h5.7v6.5h-11z" /></svg>
        <span>Dossiers</span>
        <b data-puce-dossiers>{formatEntier.format(dossiers)}</b>
      </span>
      <span class="sm-puce sm-puce--peche">
        <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.5" /><circle cx="8" cy="8" r="2.2" /></svg>
        <span>Objectif</span>
        <b data-puce-avancement>{avancement}</b>
      </span>
    </div>

    {/* Le fil : du bouton de l'outil au dashboard. Les deux mêmes ports, deux
       tracés : à l'horizontale sur le grand plan, à la verticale sur l'étroit,
       où le dashboard est sous l'outil. Un seul se voit à la fois. Le tracé
       est calculé par le moteur d'après la place des ports. */}
    <svg class="sm-fils" viewBox="0 0 760 570">
      <g class="sm-fil fil--large est-allume" data-sm-fil="dossier" data-de="bouton" data-vers="tableau" data-sens="h">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
      <g class="sm-fil fil--etroit est-allume" data-sm-fil="dossier-bas" data-de="bouton" data-vers="tableau" data-sens="v">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
    </svg>

    {/* L'outil, dans sa fenêtre. Tout ce qui s'y lit : l'adresse, l'état, le
       libellé du bouton. Le reste est en traits. */}
    <div class="sm-poste poste--outil">
      <div class="sm-fenetre">
        <div class="sm-fenetre__barre">
          <span class="adresse">
            <svg viewBox="0 0 12 12"><path d="M3 5.5h6v4.5H3zM4.4 5.5V4a1.6 1.6 0 0 1 3.2 0v1.5" /></svg>
            <span class="adresse__texte">app.votre-societe.fr<span class="adresse__chemin" data-chemin>{ecran.chemin}</span></span>
          </span>
          <span class="sm-etat" data-etat="fait" data-etat-de="outil">
            <span class="sm-etat__avant">Brouillon</span>
            <span class="sm-etat__apres">En service</span>
          </span>
        </div>
        <div class="sm-corps">
          <div
            class="sm-feuille ecran"
            data-ecran
            style={`--t1: ${ecran.titre[0]}%; --t2: ${ecran.titre[1]}%; --p1: ${ecran.texte[0]}%; --p2: ${ecran.texte[1]}%; --c1: ${ecran.champs[0]}%; --c2: ${ecran.champs[1]}%`}
          >
            {/* L'en-tête de l'outil : sa marque, puis un onglet par écran.
               Celui de l'écran du moment est en nuit. */}
            <div class="ecran__entete">
              <i class="ecran__marque"></i>
              <span class="ecran__onglets">
                {ecrans.map((_, n) => <i class:list={{ 'est-actif': n === 0 }} data-onglet />)}
              </span>
            </div>

            <div class="bloc bloc--titre est-pose" data-bloc data-nom="Titre">
              <i class="gros gros--un"></i>
              <i class="gros gros--deux"></i>
              <i class="fin fin--un"></i>
              <i class="fin fin--deux"></i>
            </div>

            <div class="bloc bloc--bouton est-pose" data-bloc data-nom="Bouton">
              <span class="bouton" data-bouton>
                <span data-libelle>{ecran.bouton}</span>
                <svg viewBox="0 0 12 12"><path d="M2.7 6.3l2.2 2.2 4.4-4.8" /></svg>
              </span>
            </div>

            {/* L'équipe : ceux qui se servent de l'écran. Trois visages et,
               sur le grand plan, le trait de leurs noms. */}
            <div class="bloc bloc--equipe est-pose" data-bloc data-nom="Équipe">
              <span class="visages"><i></i><i></i><i></i></span>
              <i class="equipe__noms sm-large"></i>
            </div>

            {/* Les champs : deux lignes de formulaire, en traits. Un nom, une
               saisie ; la seconde est une liste, elle porte un chevron. */}
            <div class="bloc bloc--champs est-pose sm-large" data-bloc data-nom="Champs">
              <span class="champ">
                <i class="champ__nom"></i>
                <span class="champ__saisie"><i class="champ__valeur champ__valeur--un"></i></span>
              </span>
              <span class="champ">
                <i class="champ__nom"></i>
                <span class="champ__saisie">
                  <i class="champ__valeur champ__valeur--deux"></i>
                  <svg viewBox="0 0 12 12"><path d="M3.5 4.8L6 7.3l2.5-2.5" /></svg>
                </span>
              </span>
            </div>
          </div>
        </div>
      </div>
      <span class="sm-port port--bouton est-actif" data-sm-port="bouton"></span>
    </div>

    {/* Le dashboard : les dossiers et l'objectif, qui portent l'action, puis
       les barres, puis l'objectif du mois en nombre de dossiers. */}
    <div class="sm-poste poste--tableau">
      <div class="sm-fenetre">
        <div class="sm-fenetre__barre">
          <span class="sm-fenetre__icone">
            <svg viewBox="0 0 16 16"><path d="M3.5 12.5v-4M8 12.5v-9M12.5 12.5V6" /></svg>
          </span>
          <span class="sm-fenetre__nom">Dashboard</span>
          <span class="sm-fenetre__info">ce mois-ci</span>
          <span class="sm-etat direct" data-etat="cours" data-etat-de="tableau">
            <i class="direct__point"></i>
            <span class="direct__avant">En attente</span>
            <span class="direct__apres">En direct</span>
          </span>
        </div>
        <div class="sm-corps tableau">
          <div class="tuiles">
            <div class="tuile tuile--dossiers">
              <span class="tuile__nom">Dossiers</span>
              <div class="tuile__ligne">
                <b data-dossiers>{formatEntier.format(dossiers)}</b>
                <span class="plus est-visible" data-plus>
                  +<span data-plus-n>{clics}</span><span class="sm-large">&nbsp;aujourd’hui</span>
                </span>
              </div>
            </div>
            <div class="tuile tuile--avancement">
              <span class="tuile__nom">Objectif</span>
              <b data-avancement>{avancement}</b>
            </div>
          </div>

          {/* Les barres : une colonne par jour, une unité par dossier, la
             dernière colonne en pêche pour aujourd'hui. La piste porte une
             colonne de plus que la vue n'en montre : c'est elle qui entre
             quand on change de jour. */}
          <div class="barres" data-barres>
            <div class="barres__vue">
              <div class="barres__piste" data-piste>
                {colonnes.map((valeur) => (
                  <div class="colonne" data-colonne>
                    {Array.from({ length: UNITES }, (_, n) => (
                      <i class:list={['unite', { 'est-pleine': n < valeur }]}></i>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="sm-pied objectif sm-large">
            <span>Objectif du mois</span>
            <b data-objectif>{formatEntier.format(OBJECTIF_DU_MOIS)}</b>
          </div>
        </div>
      </div>
      <span class="sm-port port--tableau est-actif" data-sm-port="tableau"></span>
    </div>

    <span class="sm-noeud est-allume" data-sm-noeud="dossier">
      <svg viewBox="0 0 16 16"><path d="M6.4 6.4l6.4 2.3-2.8 1.3-1.3 2.8zM6 2.2v1.6M2.2 6h1.6M3.3 3.3l1.2 1.2" /></svg>
    </span>

    {/* Le cadre de sélection : il pose chaque bloc de l'écran, l'un après
       l'autre, et le nomme. Hors de la feuille, qui rognerait son étiquette. */}
    <span class="cadre" data-cadre>
      <em data-cadre-nom>Titre</em>
      <i></i><i></i><i></i><i></i>
    </span>

    {/* Ce qui voyage, une série par clic : le pointeur d'un membre de
       l'équipe, l'onde de son appui, la bande qui en part et le grain qui
       traverse le fil. */}
    {voyageurs.map(() => (
      <>
        <span class="onde"></span>
        <svg class="pointeur" viewBox="0 0 16 16"><path d="M3 1.6v11.6l3.1-2.9 2.1 4.6 2-.9-2.1-4.5h4.3z" /></svg>
        <span class="sm-bande"></span>
        <span class="sm-grain"></span>
      </>
    ))}
  </div>
</div>

<style>
  /* Ce que le socle ne sait pas : où sont les deux postes et leurs ports,
     l'écran de l'outil et son cadre de sélection, le clic, et les composants
     du dashboard. Longueurs en pixels du plan ; les tailles de texte sont les
     quatre du socle, jamais une valeur en pixels. */
  .sm {
    --sm-lumiere: 70% 54%;
  }

  /* L'outil est un peu plus large que le dashboard : son adresse est longue,
     et elle doit se lire en entier. */
  .poste--outil {
    top: 88px;
    left: 24px;
    width: 336px;
  }

  .poste--tableau {
    top: 150px;
    left: 422px;
    width: 314px;
  }

  /* Le port de l'outil est à la hauteur de son bouton. */
  .port--bouton { top: 225px; right: -6px; }
  .port--tableau { top: 76px; left: -6px; }

  /* Seule, la pastille de la promesse reste à droite. */
  .sm-puce--peche {
    margin-left: auto;
  }

  /* Des deux fils, celui de l'autre plan est masqué sans quitter le rendu :
     le moteur mesure encore son tracé. */
  .fil--etroit {
    visibility: hidden;
  }

  /* Le socle coupe les transitions en mouvement réduit, mais à spécificité
     plus faible que celles de cette scène : il faut les couper ici aussi. */
  @media (prefers-reduced-motion: reduce) {
    .ecran::before,
    .cadre em,
    .plus,
    .unite {
      transition: none;
    }
  }

  /* ── La barre de l'outil : son adresse en pastille, puis son état ──
     Le cadenas et le sous-domaine `app.` disent un outil à soi, derrière une
     connexion. L'adresse prend toute la barre : rien d'autre à côté d'elle. */
  .adresse {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 5px;
    min-width: 0;
    height: 22px;
    padding: 0 9px 0 7px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
    color: var(--color-ink-mid);
    font-size: var(--sm-note);
    font-weight: 500;
  }

  .adresse svg {
    flex-shrink: 0;
    width: 11px;
    height: 11px;
    stroke: var(--color-ink-low);
    stroke-width: 1.2;
  }

  .adresse__texte {
    white-space: nowrap;
  }

  .adresse__chemin {
    color: var(--color-ink-low);
  }

  /* ── L'écran ──
     Une feuille claire. En chantier, ses deux marges sont tracées en
     pointillé, comme les repères d'un éditeur ; en service, elles s'effacent. */
  .ecran {
    padding: 18px 20px 22px;
  }

  .ecran::before {
    content: '';
    position: absolute;
    inset: 0 20px;
    border-inline: 1px dashed color-mix(in srgb, var(--color-peche) 80%, var(--color-night));
    opacity: 0;
    transition: opacity 420ms;
    pointer-events: none;
  }

  .ecran.est-en-chantier::before {
    opacity: 0.55;
  }

  .ecran__entete {
    position: relative;
    display: flex;
    align-items: center;
    height: 16px;
    margin-bottom: 28px;
  }

  .ecran__marque {
    width: 15px;
    height: 15px;
    border-radius: 4.5px;
    background: var(--color-night);
  }

  /* Les onglets : un trait par écran de l'outil. Celui du moment est en nuit,
     il change avec le chemin de l'adresse. */
  .ecran__onglets {
    display: flex;
    gap: 7px;
    margin-left: auto;
  }

  .ecran__onglets i {
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-feuille-barre);
  }

  .ecran__onglets i.est-actif {
    background: var(--color-night);
  }

  /* Un bloc n'existe pas tant qu'il n'est pas posé. */
  .bloc {
    position: relative;
    opacity: 0;
  }

  .bloc.est-pose {
    opacity: 1;
  }

  .bloc--titre {
    display: grid;
    gap: 9px;
  }

  .gros {
    height: 17px;
    border-radius: 4.5px;
    background: var(--color-night);
  }

  .gros--un { width: var(--t1, 90%); }
  .gros--deux { width: var(--t2, 62%); }

  .fin {
    height: 5px;
    border-radius: 3px;
    background: var(--color-feuille-barre);
  }

  .fin--un { width: var(--p1, 76%); margin-top: 6px; }
  .fin--deux { width: var(--p2, 48%); margin-top: -2px; }

  /* Entre deux blocs, la place de l'étiquette du cadre : elle nomme le bloc
     qu'on pose sans mordre sur celui d'au-dessus. */
  .bloc--bouton {
    display: flex;
    width: fit-content;
    margin-top: 26px;
  }

  /* Le bouton : la seule pêche de l'écran, et ce sur quoi l'équipe clique.
     Son libellé est le texte le plus fort de l'écran ; il est en nuit. La
     coche dit un geste qu'on valide. */
  .bouton {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 16px 0 18px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-feuille) 45%, transparent),
      0 6px 14px -8px color-mix(in srgb, var(--color-night) 60%, transparent);
    color: var(--color-night);
    font-size: var(--sm-fort);
    font-weight: 600;
    white-space: nowrap;
  }

  .bouton svg {
    width: 13px;
    height: 13px;
    stroke: var(--color-night);
    stroke-width: 1.6;
  }

  /* L'équipe : trois visages qui se chevauchent, puis le trait de leurs noms. */
  .bloc--equipe {
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin-top: 26px;
  }

  .visages {
    display: flex;
  }

  .visages i {
    width: 22px;
    height: 22px;
    border: 2px solid var(--color-feuille);
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-peche), var(--color-lueur-froide));
  }

  .visages i + i {
    margin-left: -7px;
    background: linear-gradient(135deg, var(--color-night-soft), var(--color-ink-faint));
  }

  .visages i:last-child {
    background: linear-gradient(135deg, var(--color-feuille-barre), var(--color-peche));
  }

  .equipe__noms {
    width: 64px;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-feuille-barre);
  }

  /* Les champs : deux lignes de formulaire côte à côte, sous un filet. Chacune
     a son nom, un trait court, et sa saisie : un cadre où la valeur est un
     trait plus sombre que le nom, comme un texte tapé. */
  .bloc--champs {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 10px;
    margin-top: 26px;
    padding-top: 16px;
    border-top: 1px solid var(--color-feuille-trait);
  }

  .champ {
    display: grid;
    gap: 6px;
  }

  .champ__nom {
    width: 34%;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-feuille-barre);
  }

  .champ + .champ .champ__nom {
    width: 48%;
  }

  .champ__saisie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    height: 25px;
    padding: 0 8px 0 9px;
    border: 1px solid var(--color-feuille-trait);
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--color-night) 4%, transparent);
  }

  .champ__valeur {
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-feuille-note);
  }

  .champ__valeur--un { width: var(--c1, 62%); }
  .champ__valeur--deux { width: var(--c2, 44%); }

  .champ__saisie svg {
    flex-shrink: 0;
    width: 11px;
    height: 11px;
    stroke: var(--color-feuille-note);
    stroke-width: 1.5;
  }

  /* ── Le cadre de sélection ──
     Un filet, quatre poignées, et le nom du bloc qu'il pose. Placé et
     dimensionné par le script, dans le repère du plan. */
  .cadre {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    border: 1.25px solid var(--color-night);
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-peche) 30%, transparent);
    /* La teinte se multiplie avec la feuille, comme un surligneur : elle
       colore le blanc sans ternir les barres sombres du bloc. */
    mix-blend-mode: multiply;
    opacity: 0;
    pointer-events: none;
  }

  .cadre.est-visible {
    opacity: 1;
  }

  .cadre em {
    position: absolute;
    bottom: calc(100% + 1.25px);
    left: -1.25px;
    padding: 1px 7px 2px;
    border-radius: 4px 4px 4px 0;
    background: var(--color-peche);
    color: var(--color-night);
    font-size: var(--sm-note);
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
    /* En vol entre deux blocs, le cadre se tait : son étiquette passerait sur
       le bloc qu'il vient de poser. */
    transition: opacity 140ms;
  }

  .cadre.est-en-vol em {
    opacity: 0;
  }

  .cadre i {
    position: absolute;
    width: 7px;
    height: 7px;
    border: 1.25px solid var(--color-night);
    border-radius: 2px;
    background: var(--color-feuille);
  }

  .cadre i:nth-of-type(1) { top: -4.5px; right: -4.5px; }
  .cadre i:nth-of-type(2) { right: -4.5px; bottom: -4.5px; }
  .cadre i:nth-of-type(3) { bottom: -4.5px; left: -4.5px; }
  .cadre i:nth-of-type(4) { top: 50%; right: -4.5px; margin-top: -3.5px; }

  /* ── Le clic ── */
  .pointeur,
  .onde {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    opacity: 0;
    pointer-events: none;
  }

  /* La pointe de la flèche est en (3, 1.6) dans son dessin : la marge la
     ramène sur le point visé. */
  .pointeur {
    width: 19px;
    height: 19px;
    margin: -1.9px 0 0 -3.6px;
    fill: var(--color-feuille);
    stroke: var(--color-night);
    stroke-width: 1.2;
    filter: drop-shadow(0 2px 2px color-mix(in srgb, var(--color-night) 40%, transparent));
    transform-origin: 3.6px 1.9px;
  }

  .onde {
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    border: 1.5px solid color-mix(in srgb, var(--color-night) 60%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-night) 10%, transparent);
  }

  /* ── Le dashboard ── */
  .tableau {
    --u: 18px;
    --g: 2px;
    --col: 40px;
    padding: 16px 16px 14px;
  }

  .direct {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .direct__point {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .direct__apres,
  .direct[data-etat='cours'] .direct__avant {
    display: none;
  }

  .direct[data-etat='cours'] .direct__apres {
    display: inline;
  }

  /* Les deux nombres qui portent l'action : un nom à la taille forte, un
     nombre qui se lit de loin. L'objectif qui se remplit est la promesse du
     métier : il est en pêche. */
  .tuiles {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .tuile__nom {
    display: block;
    color: var(--color-ink-mid);
    font-size: var(--sm-fort);
    font-weight: 500;
    white-space: nowrap;
  }

  .tuile b {
    display: inline-block;
    font-size: var(--sm-chiffre);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .tuile__ligne {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  .tuile--avancement {
    padding-left: 16px;
    border-left: 1px solid var(--sm-filet);
  }

  /* Le nombre garde la place de « 100 % » : le jour où l'objectif est
     atteint, le filet de la tuile ne bouge pas. */
  .tuile--avancement b {
    min-width: 64px;
    margin-top: 8px;
    color: var(--color-peche);
  }

  /* Ce que la journée a ajouté : n'existe que s'il y a quelque chose à dire. */
  .plus {
    padding: 3px 8px 4px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-peche) 15%, transparent);
    color: var(--color-peche);
    font-size: var(--sm-note);
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
    opacity: 0;
    translate: 0 3px;
    transition:
      opacity 240ms,
      translate 320ms var(--ease-out-expo);
  }

  .plus.est-visible {
    opacity: 1;
    translate: 0 0;
  }

  /* Les barres. Une unité vaut un dossier : elles se comptent à l'œil, sans
     échelle. Un seul filet, le sol. */
  .barres {
    margin-top: 18px;
  }

  .barres__vue {
    width: calc(7 * var(--col));
    overflow: hidden;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 26%, transparent);
  }

  .barres__piste {
    display: flex;
    width: max-content;
  }

  .colonne {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--g);
    width: var(--col);
    height: calc(6 * (var(--u) + var(--g)));
    padding: 0 7px 2px;
  }

  .unite {
    flex-shrink: 0;
    height: var(--u);
    border: 1px solid transparent;
    border-radius: 3.5px;
    transform-origin: 50% 100%;
    transition:
      background-color 360ms,
      border-color 240ms;
  }

  .unite.est-pleine {
    background: color-mix(in srgb, var(--color-ink) 21%, transparent);
  }

  /* Aujourd'hui, c'est la septième colonne : la seule en pêche. La huitième
     attend hors de la vue et lui ressemble, vide. Dans les deux, la prochaine
     unité est annoncée par un emplacement en pointillé. */
  .colonne:nth-child(7):not(.est-hier) .unite.est-pleine {
    background: var(--color-peche);
  }

  .colonne:nth-child(n + 7):not(.est-hier) .unite:not(.est-pleine):first-child,
  .colonne:nth-child(n + 7):not(.est-hier) .unite.est-pleine + .unite:not(.est-pleine) {
    border: 1px dashed color-mix(in srgb, var(--color-peche) 55%, transparent);
  }

  /* Le raccord entre deux jours se fait d'un coup, sans transition. */
  .barres.sans-transition .unite {
    transition: none;
  }

  /* L'objectif du mois, en dossiers : le pied de la fenêtre, à la manière du
     socle. C'est le diviseur : avec lui, on peut refaire le compte. Le sol
     des barres fait déjà le filet. */
  .objectif {
    margin-top: 0;
    padding-inline: 0;
    border-top: 0;
  }

  /* ── Le plan étroit ──
     Une autre silhouette que le grand plan. La fenêtre de l'outil prend toute
     la largeur, en haut ; le dashboard n'est plus une fenêtre mais une bande
     en bas (les dossiers, l'objectif, les barres) ; le fil descend tout droit
     du bouton à la bande. La hauteur gagnée par le plan (320 au lieu de 270)
     va au texte : le libellé du bouton et les deux nombres. */
  @container sm (max-width: 519.98px) {
    .sm::before {
      --sm-lumiere: 50% 84%;
    }

    .fil--large {
      visibility: hidden;
    }

    .fil--etroit {
      visibility: visible;
    }

    /* Entre l'outil et la bande, il n'y a que la place du fil. */
    .sm-noeud {
      display: none;
    }

    .poste--outil {
      top: 38px;
      left: 10px;
      width: 340px;
    }

    .poste--tableau {
      top: auto;
      bottom: 8px;
      left: 10px;
      width: 340px;
    }

    /* Les deux ports à la même abscisse, sous le bouton : le fil est une
       verticale. */
    .port--bouton { top: auto; right: auto; bottom: -5px; left: 46px; }
    .port--tableau { top: -5px; left: 46px; }

    .adresse {
      gap: 4px;
      height: 19px;
      padding: 0 8px 0 6px;
    }

    .adresse svg {
      width: 10px;
      height: 10px;
    }

    /* L'écran, large et bas : le titre sur toute la largeur, puis le bouton
       et l'équipe sur une même ligne. Le bouton reste au-dessus de son port. */
    .ecran {
      padding: 10px 12px 10px;
    }

    .ecran::before {
      inset: 0 12px;
    }

    /* Sous l'en-tête, la place de l'étiquette du cadre. */
    .ecran__entete {
      height: 9px;
      margin-bottom: 12px;
    }

    .ecran__marque {
      width: 9px;
      height: 9px;
      border-radius: 3px;
    }

    .ecran__onglets {
      gap: 5px;
    }

    .ecran__onglets i {
      width: 13px;
      height: 2.5px;
    }

    .bloc--titre {
      gap: 6px;
    }

    .gros {
      height: 11px;
      border-radius: 3.5px;
    }

    /* Le faux paragraphe sort de l'écran : sa place va à l'étiquette du
       cadre, qui nomme le bouton sans rien recouvrir. */
    .fin {
      display: none;
    }

    .bloc--bouton,
    .bloc--equipe {
      display: inline-flex;
      vertical-align: middle;
      margin-top: 23px;
    }

    .bloc--equipe {
      margin-inline: 14px 0;
    }

    .bouton {
      gap: 6px;
      height: 32px;
      padding: 0 12px 0 14px;
    }

    .bouton svg {
      width: 11px;
      height: 11px;
    }

    .visages i {
      width: 18px;
      height: 18px;
      border-width: 1.5px;
    }

    .visages i + i {
      margin-left: -6px;
    }

    /* L'étiquette se décale : au coin, elle toucherait la marque de l'outil. */
    .cadre em {
      left: 14px;
      padding: 1px 6px 2px;
      border-radius: 4px 4px 0 0;
    }

    /* Sur la rangée du bouton, elle revient au coin : rien à éviter. */
    .cadre.est-sur-rangee em {
      left: -1.25px;
      border-radius: 4px 4px 4px 0;
    }

    .cadre i {
      width: 6px;
      height: 6px;
    }

    .cadre i:nth-of-type(1) { top: -4px; right: -4px; }
    .cadre i:nth-of-type(2) { right: -4px; bottom: -4px; }
    .cadre i:nth-of-type(3) { bottom: -4px; left: -4px; }
    .cadre i:nth-of-type(4) { right: -4px; margin-top: -3px; }

    .pointeur {
      width: 16px;
      height: 16px;
      margin: -1.6px 0 0 -3px;
      transform-origin: 3px 1.6px;
    }

    .onde {
      width: 36px;
      height: 36px;
      margin: -18px 0 0 -18px;
    }

    /* La bande : sans barre de titre, sur une seule ligne. Les dossiers à
       gauche, sous l'arrivée du fil ; l'objectif ; les barres à droite. */
    .poste--tableau .sm-fenetre__barre {
      display: none;
    }

    .tableau {
      --u: 6px;
      --g: 1.5px;
      --col: 18px;
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr);
      align-items: end;
      column-gap: 14px;
      padding: 8px 10px 8px 12px;
    }

    .tuiles {
      display: contents;
    }

    /* Le nombre et son « +n » ne poussent pas l'objectif quand ils
       grandissent. */
    .tuile--dossiers {
      min-width: 74px;
    }

    .tuile__ligne {
      gap: 6px;
      margin-top: 5px;
    }

    .tuile--avancement {
      padding-left: 14px;
    }

    /* Ici « 100 % » s'étend vers les barres, calées à droite : rien à
       réserver. */
    .tuile--avancement b {
      min-width: 0;
      margin-top: 5px;
    }

    .plus {
      padding: 2px 6px 3px;
    }

    .barres {
      justify-self: end;
      margin-top: 0;
    }

    .colonne {
      padding: 0 3px 1.5px;
    }

    .unite {
      border-radius: 2px;
    }

    /* À six pixels de haut, un pointillé ne se lit plus : l'emplacement de la
       prochaine unité est un filet plein. */
    .colonne:nth-child(n + 7):not(.est-hier) .unite:not(.est-pleine):first-child,
    .colonne:nth-child(n + 7):not(.est-hier) .unite.est-pleine + .unite:not(.est-pleine) {
      border-style: solid;
    }
  }

  /* Sur le plan étroit la colonne du jour arrive dans l'angle bas droit, là où
     le socle pose la commande de pause : elle recouvrait trois unités, celles
     qui se remplissent à chaque clic. Ici elle monte dans l'angle haut gauche,
     qui est libre. Le moteur la crée à côté de la scène, dans son cadre : elle
     ne porte pas l'attribut de portée, et c'est le conteneur du cadre
     (`scene`, voir `home-services`) qui donne la largeur. */
  @container scene (max-width: 521.98px) {
    :global(.sm[data-scene-sites] ~ .sm-pause) {
      top: 10px;
      right: auto;
      bottom: auto;
      left: 10px;
    }
  }
</style>

<script>
  /*
   * La partition de la scène : ses états (repos, image fixe) et l'ordre de sa
   * boucle. Le temps, la pause hors écran, l'échelle et l'annulation sont dans
   * le moteur ; ici, aucune attente n'a besoin de vérifier qu'elle a encore
   * cours, une boucle remplacée se défait d'elle-même.
   */
  import { ELAN, EXPO, monterScenes } from '../../lib/metiers/scene';
  import type { Cadre, Pt } from '../../lib/metiers/scene';

  interface EcranRecit {
    chemin: string;
    bouton: string;
    titre: number[];
    texte: number[];
    champs: number[];
  }

  interface Recit {
    ecrans: EcranRecit[];
    clics: number[];
    historique: number[];
    dejaTraites: number;
    objectif: number;
  }

  /* Le récit arrive du balisage en JSON : c'est une frontière, on vérifie sa
     forme avant de s'en servir. */
  const estObjet = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null;
  const estNombres = (v: unknown): v is number[] => Array.isArray(v) && v.every((n) => typeof n === 'number');
  const estPositif = (v: unknown): v is number => typeof v === 'number' && v > 0;

  const estEcran = (v: unknown): v is EcranRecit =>
    estObjet(v) &&
    typeof v.chemin === 'string' &&
    typeof v.bouton === 'string' &&
    estNombres(v.titre) &&
    estNombres(v.texte) &&
    estNombres(v.champs);

  const lireRecit = (brut: string | undefined): Recit => {
    const lu: unknown = JSON.parse(brut ?? 'null');
    /* `dejaTraites` et `objectif` sont strictement positifs, et la plus grosse
       journée tient dans ce qui reste de l'objectif : c'est ce qui garantit
       qu'« Objectif » n'est jamais une division par zéro, ni un zéro, ni plus
       de 100 %. */
    const valide =
      estObjet(lu) &&
      Array.isArray(lu.ecrans) &&
      lu.ecrans.length > 0 &&
      lu.ecrans.every(estEcran) &&
      estNombres(lu.clics) &&
      lu.clics.length > 0 &&
      estNombres(lu.historique) &&
      estPositif(lu.dejaTraites) &&
      estPositif(lu.objectif) &&
      lu.dejaTraites + Math.max(...lu.clics) <= lu.objectif;
    if (!valide) throw new Error('Scène Outils métiers : `data-recit` est illisible');
    return lu as unknown as Recit;
  };

  const formatEntier = new Intl.NumberFormat('fr-FR');
  const entier = (n: number): string => formatEntier.format(Math.round(n));
  /* « 60 % », avec son espace insécable. */
  const pourCent = (part: number): string => `${entier(part * 100)} %`;

  /* Ce que le cadre de sélection laisse autour du bloc qu'il pose, sur le
     grand plan puis sur l'étroit. */
  const MARGE_CADRE = { large: 6, etroit: 4 };
  /* La bande, quand elle entre dans un port ou en sort : un tiret. */
  const TIRET = { w: 16, h: 6 };
  /* Le départ de chaque clic, en ms : de plus en plus rapprochés. */
  const DEPARTS = [0, 1050, 1800, 2350, 2750];
  /* Où chaque membre de l'équipe appuie sur le bouton (en part de sa largeur),
     et d'où arrive son pointeur (en pixels du plan) : ce n'est pas le même
     deux fois. */
  const APPUIS = [0.34, 0.66, 0.48, 0.78, 0.24];
  const ARRIVEES: Pt[] = [
    { x: 26, y: 24 },
    { x: -20, y: 28 },
    { x: 32, y: 10 },
    { x: 6, y: 32 },
    { x: -28, y: 16 },
  ];

  const tiretAu = (p: Pt): Cadre => ({ x: p.x - TIRET.w / 2, y: p.y - TIRET.h / 2, w: TIRET.w, h: TIRET.h });
  const vers = (p: Pt, echelle = 1): string => `translate(${p.x}px, ${p.y}px) scale(${echelle})`;

  monterScenes('[data-scene-sites]', (s) => {
    const recit = lireRecit(s.racine.dataset.recit);

    const elEcran = s.un('[data-ecran]');
    const elChemin = s.un('[data-chemin]');
    const elLibelle = s.un('[data-libelle]');
    const onglets = s.tous('[data-onglet]');
    const bouton = s.un('[data-bouton]');
    const blocs = s.tous('[data-bloc]');
    const cadre = s.un('[data-cadre]');
    const nomCadre = s.un('[data-cadre-nom]');

    const barres = s.un('[data-barres]');
    const piste = s.un('[data-piste]');
    const colonnes = s.tous('[data-colonne]');
    const piles = colonnes.map((colonne) => [...colonne.querySelectorAll<HTMLElement>('.unite')]);
    const elDossiers = s.un('[data-dossiers]');
    const elPlus = s.un('[data-plus]');
    const elPlusN = s.un('[data-plus-n]');
    const elObjectif = s.un('[data-objectif]');
    const elAvancement = s.un('[data-avancement]');
    const elPuceDossiers = s.un('[data-puce-dossiers]');
    const elPuceAvancement = s.un('[data-puce-avancement]');
    /* Les quatre nombres qui bougent avec les dossiers. */
    const nombres = [elDossiers, elPuceDossiers, elAvancement, elPuceAvancement];

    const etats = {
      outil: s.un('[data-etat-de="outil"]'),
      tableau: s.un('[data-etat-de="tableau"]'),
    };
    const noeud = s.un('[data-sm-noeud="dossier"]');
    const pointeurs = s.tous<SVGSVGElement>('.pointeur');
    const ondes = s.tous('.onde');
    const bandes = s.tous('.sm-bande');
    const grains = s.tous('.sm-grain');

    /* Le fil du moment : à l'horizontale sur le grand plan, à la verticale
       sur l'étroit. */
    const filDuPlan = (): string => (s.etroit ? 'dossier-bas' : 'dossier');

    /* L'état de la scène. `rang` choisit l'écran et la journée ; `historique`
       glisse d'un jour à chaque boucle ; `traites` est le total des dossiers
       du mois avant la journée en cours. Il se cumule d'un jour à l'autre et
       repart de `dejaTraites` quand le mois est bouclé (voir le raccord, à la
       fin de `tour`). */
    let rang = 0;
    let historique = [...recit.historique];
    let traites = recit.dejaTraites;

    /* Les listes tournent ; `lireRecit` a vérifié qu'aucune n'est vide. */
    const auRang = <T,>(liste: T[]): T => {
      const element = liste[rang % liste.length];
      if (element === undefined) throw new Error('Scène Outils métiers : le récit est vide');
      return element;
    };
    const ecranCourant = (): EcranRecit => auRang(recit.ecrans);
    /* Jamais plus de clics que la barre n'a d'unités, ni que la scène n'a de
       pointeurs. */
    const clicsDuJour = (): number => Math.min(auRang(recit.clics), pointeurs.length, piles[0]?.length ?? 0);
    /* La colonne d'aujourd'hui : celle qui suit l'historique. */
    const AUJOURDHUI = historique.length;

    /* L'écran du moment, écrit dans le balisage : son chemin, son onglet, le
       libellé de son bouton, les longueurs de ses traits. */
    const charger = () => {
      const ecran = ecranCourant();
      const actif = rang % recit.ecrans.length;
      elChemin.textContent = ecran.chemin;
      elLibelle.textContent = ecran.bouton;
      onglets.forEach((onglet, n) => onglet.classList.toggle('est-actif', n === actif));
      elEcran.style.setProperty('--t1', `${ecran.titre[0] ?? 90}%`);
      elEcran.style.setProperty('--t2', `${ecran.titre[1] ?? 62}%`);
      elEcran.style.setProperty('--p1', `${ecran.texte[0] ?? 76}%`);
      elEcran.style.setProperty('--p2', `${ecran.texte[1] ?? 48}%`);
      elEcran.style.setProperty('--c1', `${ecran.champs[0] ?? 62}%`);
      elEcran.style.setProperty('--c2', `${ecran.champs[1] ?? 44}%`);
    };

    /* Les barres : l'historique, puis aujourd'hui, puis la colonne de réserve. */
    const poserBarres = (aujourdhui: number) => {
      colonnes.forEach((colonne, i) => {
        const valeur = i < AUJOURDHUI ? (historique[i] ?? 0) : i === AUJOURDHUI ? aujourdhui : 0;
        piles[i]?.forEach((unite, n) => unite.classList.toggle('est-pleine', n < valeur));
        colonne.classList.remove('est-hier');
      });
    };

    /* La part de l'objectif atteinte après `n` dossiers dans la journée.
       L'objectif du mois ne bouge pas pendant qu'on clique, si bien que
       dossiers ÷ objectif du mois = « Objectif » à chaque instant. */
    const avancementApres = (n: number): string => pourCent((traites + n) / recit.objectif);

    /* Les nombres, après `n` dossiers dans la journée. */
    const poserNombres = (n: number) => {
      const avancement = avancementApres(n);
      elDossiers.textContent = entier(traites + n);
      elPuceDossiers.textContent = entier(traites + n);
      elPlusN.textContent = String(n);
      elPlus.classList.toggle('est-visible', n > 0);
      elObjectif.textContent = entier(recit.objectif);
      elAvancement.textContent = avancement;
      elPuceAvancement.textContent = avancement;
    };

    /* Ce qu'une boucle interrompue peut laisser derrière elle. */
    const ranger = () => {
      cadre.classList.remove('est-visible', 'est-en-vol', 'est-sur-rangee');
      barres.classList.remove('sans-transition');
    };

    /* Le repos : un écran vide, en chantier, et un dashboard qui attend la
       journée, avec les nombres du mois au matin. */
    const repos = () => {
      s.racine.classList.remove('est-abouti');
      s.eteindre();
      ranger();
      charger();
      blocs.forEach((bloc) => bloc.classList.remove('est-pose'));
      elEcran.classList.add('est-en-chantier');
      etats.outil.dataset.etat = 'attente';
      etats.tableau.dataset.etat = 'attente';
      poserBarres(0);
      poserNombres(0);
    };

    /* L'image fixe : l'outil est en service, la journée est passée. C'est
       aussi ce que le HTML rend sans script. */
    const figer = () => {
      const clics = clicsDuJour();
      ranger();
      charger();
      blocs.forEach((bloc) => bloc.classList.add('est-pose'));
      elEcran.classList.remove('est-en-chantier');
      etats.outil.dataset.etat = 'fait';
      etats.tableau.dataset.etat = 'cours';
      poserBarres(clics);
      poserNombres(clics);
      s.eteindre();
      s.allumer(filDuPlan(), true);
      s.racine.classList.add('est-abouti');
    };

    const placerCadre = (c: Cadre) => {
      Object.assign(cadre.style, { left: `${c.x}px`, top: `${c.y}px`, width: `${c.w}px`, height: `${c.h}px` });
    };

    const autour = (bloc: HTMLElement): Cadre => {
      const c = s.cadreDe(bloc);
      const m = s.etroit ? MARGE_CADRE.etroit : MARGE_CADRE.large;
      return { x: c.x - m, y: c.y - m, w: c.w + m * 2, h: c.h + m * 2 };
    };

    const enPixels = (c: Cadre): Keyframe => ({
      left: `${c.x}px`,
      top: `${c.y}px`,
      width: `${c.w}px`,
      height: `${c.h}px`,
    });

    /* Le cadre de sélection vient se poser, puis le bloc se dessine dedans,
       de gauche à droite. Le premier cadre s'ouvre sur place ; les suivants
       glissent depuis le bloc d'avant et prennent sa nouvelle taille. */
    const poser = async (bloc: HTMLElement, avant: Cadre | null): Promise<Cadre> => {
      const cible = autour(bloc);
      const nom = bloc.dataset.nom ?? '';
      /* Seul le titre partage sa ligne avec la marque de l'outil : pour lui,
         sur le plan étroit, l'étiquette se décale. */
      const surRangee = bloc !== blocs[0];
      placerCadre(cible);
      cadre.classList.add('est-visible');
      if (avant) {
        cadre.classList.add('est-en-vol');
        await s.animer(cadre, [enPixels(avant), enPixels(cible)], {
          duration: 300,
          easing: 'cubic-bezier(0.45, 0, 0.15, 1)',
        });
        /* Le nom change à l'arrivée, quand le cadre reparle. */
        nomCadre.textContent = nom;
        cadre.classList.toggle('est-sur-rangee', surRangee);
        cadre.classList.remove('est-en-vol');
      } else {
        nomCadre.textContent = nom;
        cadre.classList.toggle('est-sur-rangee', surRangee);
        cadre.style.transformOrigin = '0 0';
        await s.animer(
          cadre,
          [
            { transform: 'scale(0.72, 0.4)', opacity: 0 },
            { transform: 'none', opacity: 1 },
          ],
          { duration: 280, easing: EXPO },
        );
      }
      bloc.classList.add('est-pose');
      await s.animer(
        bloc,
        { clipPath: ['inset(-8px 100% -8px -8px)', 'inset(-8px -8px -8px -8px)'] },
        { duration: 320, easing: EXPO },
      );
      await s.attendre(70);
      return cible;
    };

    /* Un clic : le pointeur d'un membre de l'équipe arrive sur le bouton et
       appuie, le dossier part par le fil, et devient une unité de plus sur la
       barre du jour. Les nombres suivent : un dossier de plus, un objectif
       qui se remplit. */
    const cliquer = async (i: number) => {
      const pointeur = pointeurs[i];
      const onde = ondes[i];
      const bande = bandes[i];
      const grain = grains[i];
      const unite = piles[AUJOURDHUI]?.[i];
      const appui = s.lieu(bouton, APPUIS[i] ?? 0.5, 0.56);
      const ecart = ARRIVEES[i] ?? { x: 24, y: 24 };
      if (!pointeur || !onde || !bande || !grain || !unite) return;
      /* Sur le plan étroit, tout est plus près : le pointeur vient de moins
         loin. */
      const k = s.etroit ? 0.6 : 1;
      const loin = { x: appui.x + ecart.x * k, y: appui.y + ecart.y * k };

      await s.animer(
        pointeur,
        [
          { transform: vers(loin), opacity: 0 },
          { opacity: 1, offset: 0.45 },
          { transform: vers(appui), opacity: 1 },
        ],
        { duration: 320, easing: EXPO },
      );

      /* L'appui : le bouton s'enfonce, le pointeur aussi, une onde s'ouvre. */
      s.jouer(bouton, [{ transform: 'none' }, { transform: 'scale(0.95)', offset: 0.35 }, { transform: 'none' }], {
        duration: 320,
        easing: 'ease-out',
      });
      s.jouer(
        pointeur,
        [
          { transform: vers(appui), opacity: 1 },
          { transform: vers(appui, 0.8), opacity: 1, offset: 0.3 },
          { transform: vers(appui), opacity: 1, offset: 0.62 },
          { transform: vers(appui), opacity: 0 },
        ],
        { duration: 520, easing: 'ease-out' },
      );
      s.jouer(
        onde,
        [
          { transform: vers(appui, 0.25), opacity: 0.9 },
          { transform: vers(appui, 1), opacity: 0 },
        ],
        { duration: 620, easing: EXPO },
      );
      await s.attendre(120);

      /* Le passage par le fil, avec les temps du socle (`passer`) : ici la
         bande naît au point d'appui et se pose sur une unité de barre, deux
         rectangles exacts que `passer` ne sait pas recevoir. Sans pose au
         départ, elle n'apparaît qu'en s'éloignant : pêche sur pêche, elle
         masquerait le libellé du bouton. */
      const depuis: Cadre = { x: appui.x - 15, y: appui.y - 5, w: 30, h: 10 };
      s.enMarge(
        s.voler(bande, depuis, tiretAu(s.lieu(s.port('bouton'))), {
          duree: 460,
          arrivee: 0.9,
          easing: ELAN,
          eclot: true,
        }),
      );
      await s.attendre(380);
      if (s.etroit) {
        /* Le fil est court et tombe sur la bande : le grain descend vite, et
           l'unité se pose sans vol, la bande n'a rien à traverser. */
        s.enMarge(s.courir(grain, filDuPlan(), { duree: 300 }));
        await s.attendre(270);
        s.port('tableau').classList.add('est-actif');
      } else {
        s.enMarge(s.courir(grain, filDuPlan()));
        await s.attendre(210);
        s.jouer(noeud, [{ scale: 1 }, { scale: 1.24, offset: 0.35 }, { scale: 1 }], {
          duration: 320,
          easing: 'ease-out',
        });
        await s.attendre(240);
        s.port('tableau').classList.add('est-actif');
        s.enMarge(
          s.voler(bande, tiretAu(s.lieu(s.port('tableau'))), s.cadreDe(unite), {
            duree: 620,
            pose: 0.06,
            arrivee: 0.64,
            easing: EXPO,
            eclot: true,
          }),
        );
        await s.attendre(380);
      }

      unite.classList.add('est-pleine');
      s.jouer(unite, [{ transform: 'scaleY(0.35)' }, { transform: 'none' }], { duration: 380, easing: EXPO });
      /* Les deux nombres changent dans la même image : à aucun instant le
         dashboard n'affiche un objectif qui ne soit pas celui de ses
         dossiers. */
      const n = i + 1;
      const avancement = avancementApres(n);
      s.tictac(elDossiers, entier(traites + n));
      s.tictac(elPuceDossiers, entier(traites + n));
      s.tictac(elAvancement, avancement);
      s.tictac(elPuceAvancement, avancement);
      elPlusN.textContent = String(n);
      elPlus.classList.add('est-visible');
    };

    async function tour() {
      const clics = clicsDuJour();
      const visibles = s.affiches(blocs);

      await s.attendre(320);

      /* 1. L'écran se monte, bloc par bloc. */
      let avant: Cadre | null = null;
      for (const bloc of visibles) avant = await poser(bloc, avant);
      await s.animer(cadre, { opacity: [1, 0] }, { duration: 200 });
      cadre.classList.remove('est-visible');

      /* 2. Il passe en service : les repères s'effacent, le dashboard se met
         à l'écoute. */
      elEcran.classList.remove('est-en-chantier');
      s.basculer(etats.outil);
      await s.attendre(320);
      s.basculer(etats.tableau, 'cours');
      await s.attendre(340);

      /* 3. Les clics de l'équipe, de plus en plus rapprochés. */
      s.allumer(filDuPlan());
      await Promise.all(
        Array.from({ length: clics }, async (_, i) => {
          await s.attendre(DEPARTS[i] ?? i * 700);
          await cliquer(i);
        }),
      );
      s.racine.classList.add('est-abouti');

      /* Le temps de lire l'image : l'outil tourne, le dashboard le dit. */
      await s.attendre(2800);

      /* 4. On change de jour : l'écran se défait, les barres glissent d'une
         colonne (aujourd'hui devient hier). Les dossiers du mois restent. */
      s.racine.classList.remove('est-abouti');
      s.eteindre();
      etats.outil.dataset.etat = 'attente';
      etats.tableau.dataset.etat = 'attente';
      elPlus.classList.remove('est-visible');
      colonnes[AUJOURDHUI]?.classList.add('est-hier');
      const cran = (colonnes[1]?.offsetLeft ?? 0) - (colonnes[0]?.offsetLeft ?? 0);
      const GLISSE = 620;
      const premiere = colonnes[0];
      /* Le jour qui sort s'efface en partant, et reste effacé jusqu'au raccord. */
      if (premiere) {
        s.jouer(premiere, [{ opacity: 1 }, { opacity: 0, offset: 0.4 }, { opacity: 0 }], { duration: GLISSE });
      }
      await Promise.all([
        s.animer(piste, { transform: ['translateX(0)', `translateX(${-cran}px)`] }, { duration: GLISSE, easing: EXPO }),
        ...[...visibles].reverse().map(async (bloc, i) => {
          await s.attendre(i * 55);
          await s.animer(
            bloc,
            [
              { opacity: 1, transform: 'none' },
              { opacity: 0, transform: 'translateY(5px)' },
            ],
            { duration: 240, easing: ELAN },
          );
          bloc.classList.remove('est-pose');
        }),
      ]);

      /* Le raccord, invisible : chaque colonne prend la valeur de sa voisine
         dans l'image même où la piste revient à sa place. Le mois compte une
         journée de plus : ses dossiers sont acquis, et « Objectif » repart
         d'où la journée l'a laissé, jamais de zéro. L'écran suivant est
         chargé, de nouveau en chantier. */
      historique = [...historique.slice(1), clics];
      traites += clics;
      rang += 1;
      /* Le mois est bouclé quand la journée qui vient ne tient plus dans ce
         qui reste de l'objectif : la scène repart alors sur le mois suivant,
         entamé au même point que le premier. C'est ce qui tient « Objectif »
         sous 100 %, aussi longtemps que la scène tourne. */
      const moisBoucle = traites + clicsDuJour() > recit.objectif;
      if (moisBoucle) traites = recit.dejaTraites;
      barres.classList.add('sans-transition');
      charger();
      poserBarres(0);
      poserNombres(0);
      /* Un changement de mois ne se cache pas : les nombres tombent en place,
         comme à chaque dossier. */
      if (moisBoucle) nombres.forEach((nombre) => s.tictac(nombre, nombre.textContent ?? ''));
      /* La lecture force le rendu sans transition avant de les rétablir. */
      void barres.offsetWidth;
      barres.classList.remove('sans-transition');
      elEcran.classList.add('est-en-chantier');
      await s.attendre(160);
    }

    return { figer, repos, tour };
  });
</script>
