---
/*
 * scene-sites — la scène du métier Sites web et dashboards : « Des landing
 * pages qui convertissent, des tableaux de bord qui servent. »
 *
 * L'idée à faire passer en cinq secondes, téléphone en main : une page, des
 * clics, un tableau de bord qui compte.
 *
 * Le fil de la boucle, un seul mouvement à la fois :
 *   1. un cadre de sélection pose la page bloc par bloc (titre, bouton,
 *      preuve, logos), comme on la monte dans un éditeur ;
 *   2. la page passe en ligne ;
 *   3. le bouton est cliqué, trois à cinq fois, de plus en plus vite : chaque
 *      clic traverse le fil et devient une unité de plus sur la barre du jour,
 *      le nombre de demandes monte, le taux de conversion monte avec lui ;
 *   4. l'image est tenue, puis on change de jour : les barres glissent d'une
 *      colonne, la page se défait, la suivante se monte.
 *
 * Le panneau, les fenêtres, la feuille, le fil, le temps et les quatre tailles
 * de texte viennent du socle (`scene-metier.css` et `lib/metiers/scene.ts`).
 * Ce composant n'écrit que ce qui lui est propre : la page et son cadre de
 * sélection, le clic, le tableau de bord (deux nombres, des barres en unités),
 * et l'ordre de sa boucle.
 *
 * Ce qui se lit est compté : l'adresse, l'état de la page, le libellé du
 * bouton, « Demandes », « Conversion », « Visites » et leurs nombres. Tout le
 * reste est un trait. Il n'y a ni échelle, ni lettres de jours, ni cotes :
 * à la taille de la note, ils ne tenaient pas.
 *
 * Sur le plan étroit (téléphone), la scène change de silhouette pour ne pas
 * ressembler à ses voisines : la page claire prend toute la largeur, en haut,
 * et le tableau de bord devient une bande en bas (les demandes, la
 * conversion, les barres), reliée par un fil vertical et court. Une seule
 * pastille, celle de la promesse.
 *
 * Sans script ou en mouvement réduit, la scène est une image fixe : la page
 * montée et en ligne, le tableau de bord rempli.
 *
 * Tous les chiffres sont inventés pour la scène, et ils sont justes entre eux
 * à chaque instant : la conversion est le nombre de demandes divisé par le
 * nombre de visites, sur le mois en cours. Elle ne part donc jamais de zéro :
 * le site a déjà reçu des demandes avant la journée que la scène montre.
 */
import './scene-metier.css';

/* Trois pages qui tournent : d'une boucle à l'autre, ce n'est pas la même qui
   revient. `titre` et `texte` sont les longueurs des barres, en pour cent. */
const pages = [
  { chemin: '/devis', bouton: 'Demander un devis', centre: false, titre: [90, 62], texte: [76, 48] },
  { chemin: '/demo', bouton: 'Réserver une démo', centre: true, titre: [74, 52], texte: [62, 40] },
  { chemin: '/contact', bouton: 'Prendre rendez-vous', centre: false, titre: [70, 86], texte: [80, 54] },
];

/* Le nombre de clics sur le bouton, journée après journée. */
const CLICS = [4, 3, 5];
/* Les six jours d'avant, en demandes par jour. */
const HISTORIQUE = [3, 5, 2, 4, 6, 3];
/* Les demandes déjà reçues ce mois-ci avant la première journée de la scène,
   et ce qu'il a fallu de visites pour chacune : vingt, soit 5 % de
   conversion au matin. Avec quatre demandes de plus dans la journée, la
   première image finale lit 44 demandes, 800 visites, 5,5 %. */
const DEJA = 40;
const VISITES_PAR_DEMANDE = 20;
/* La hauteur d'une barre, en demandes : une unité par demande. */
const UNITES = 6;

const formatTaux = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const formatEntier = new Intl.NumberFormat('fr-FR');

const recit = { pages, clics: CLICS, historique: HISTORIQUE, deja: DEJA, visitesParDemande: VISITES_PAR_DEMANDE };

/* L'image fixe : la première page, la première journée, tout est passé. */
const page = pages[0];
const clics = CLICS[0] ?? 0;
const demandes = DEJA + clics;
const visites = DEJA * VISITES_PAR_DEMANDE;
const taux = `${formatTaux.format((demandes / visites) * 100)} %`;
const colonnes = [...HISTORIQUE, clics, 0];
const voyageurs = Array.from({ length: Math.max(...CLICS) });
---

<div
  class="sm est-abouti"
  data-scene-sites
  data-recit={JSON.stringify(recit)}
  role="img"
  aria-label="Une landing page se monte bloc par bloc et passe en ligne&nbsp;; des visiteurs cliquent sur son bouton, et le dashboard compte chaque demande&nbsp;: le taux de conversion monte avec elles."
>
  <div class="sm-plan" aria-hidden="true">
    {/* Deux pastilles sur le grand plan, une seule sur l'étroit : celle de la
       promesse, la conversion. */}
    <div class="sm-puces">
      <span class="sm-puce sm-large">
        <svg viewBox="0 0 16 16"><path d="M2.5 9.5l1.8-5.5h7.4l1.8 5.5v3h-11v-3zM2.5 9.5h3.2l.8 1.5h3l.8-1.5h3.2" /></svg>
        <span>Demandes</span>
        <b data-puce-demandes>{formatEntier.format(demandes)}</b>
      </span>
      <span class="sm-puce sm-puce--peche">
        <svg viewBox="0 0 16 16"><path d="M2.5 11.5l3.5-3.6 2.5 2.4 5-5.6M10 4.7h3.5v3.5" /></svg>
        <span>Conversion</span>
        <b data-puce-taux>{taux}</b>
      </span>
    </div>

    {/* Le fil : du bouton de la page au tableau de bord. Les deux mêmes ports,
       deux tracés : à l'horizontale sur le grand plan, à la verticale sur
       l'étroit, où le tableau est sous la page. Un seul se voit à la fois.
       Le tracé est calculé par le moteur d'après la place des ports. */}
    <svg class="sm-fils" viewBox="0 0 760 570">
      <g class="sm-fil fil--large est-allume" data-sm-fil="demande" data-de="bouton" data-vers="tableau" data-sens="h">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
      <g class="sm-fil fil--etroit est-allume" data-sm-fil="demande-bas" data-de="bouton" data-vers="tableau" data-sens="v">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
    </svg>

    {/* La page, dans son navigateur. Tout ce qui s'y lit : l'adresse, l'état,
       le libellé du bouton, la note. Le reste est en traits. */}
    <div class="sm-poste poste--page">
      <div class="sm-fenetre">
        <div class="sm-fenetre__barre">
          <svg class="fleches" viewBox="0 0 28 12"><path d="M7.5 2.5L4 6l3.5 3.5M20.5 2.5L24 6l-3.5 3.5" /></svg>
          <span class="adresse">
            <svg viewBox="0 0 12 12"><path d="M3 5.5h6v4.5H3zM4.4 5.5V4a1.6 1.6 0 0 1 3.2 0v1.5" /></svg>
            <span class="adresse__texte">votre-site.fr<span class="adresse__chemin" data-chemin>{page.chemin}</span></span>
          </span>
          <span class="sm-etat" data-etat="fait" data-etat-de="page">
            <span class="sm-etat__avant">Brouillon</span>
            <span class="sm-etat__apres">En ligne</span>
          </span>
        </div>
        <div class="sm-corps">
          <div
            class:list={['sm-feuille', 'page', { 'est-centree': page.centre }]}
            data-page
            style={`--t1: ${page.titre[0]}%; --t2: ${page.titre[1]}%; --p1: ${page.texte[0]}%; --p2: ${page.texte[1]}%`}
          >
            <div class="page__entete">
              <i class="page__marque"></i>
              <span class="page__menu"><i></i><i></i><i></i></span>
            </div>

            <div class="bloc bloc--titre est-pose" data-bloc data-nom="Titre">
              <i class="gros gros--un"></i>
              <i class="gros gros--deux"></i>
              <i class="fin fin--un"></i>
              <i class="fin fin--deux"></i>
            </div>

            <div class="bloc bloc--bouton est-pose" data-bloc data-nom="Bouton">
              <span class="bouton" data-bouton>
                <span data-libelle>{page.bouton}</span>
                <svg viewBox="0 0 12 12"><path d="M2.5 6h7M6.5 3l3 3-3 3" /></svg>
              </span>
            </div>

            <div class="bloc bloc--preuve est-pose" data-bloc data-nom="Preuve">
              <span class="visages"><i></i><i></i><i></i></span>
              <svg class="etoile" viewBox="0 0 12 12"><path d="M6 1.2l1.5 3.1 3.4.4-2.5 2.3.7 3.4L6 8.7l-3.1 1.7.7-3.4L1.1 4.7l3.4-.4z" /></svg>
              <b>4,9</b>
              <i class="preuve__texte sm-large"></i>
            </div>

            <div class="bloc bloc--logos est-pose sm-large" data-bloc data-nom="Logos">
              <span class="logo"><svg viewBox="0 0 12 12"><circle cx="6" cy="6" r="3.6" /></svg><i></i></span>
              <span class="logo"><svg viewBox="0 0 12 12"><path d="M6 2.2l4 7.2H2z" /></svg><i></i></span>
              <span class="logo"><svg viewBox="0 0 12 12"><path d="M2.6 2.6h6.8v6.8H2.6z" /></svg><i></i></span>
              <span class="logo"><svg viewBox="0 0 12 12"><path d="M6 1.8L10.2 6 6 10.2 1.8 6z" /></svg><i></i></span>
            </div>
          </div>
        </div>
      </div>
      <span class="sm-port port--bouton est-actif" data-sm-port="bouton"></span>
    </div>

    {/* Le tableau de bord : les demandes et la conversion, qui portent
       l'action, puis les barres, puis les visites. */}
    <div class="sm-poste poste--tableau">
      <div class="sm-fenetre">
        <div class="sm-fenetre__barre">
          <span class="sm-fenetre__icone">
            <svg viewBox="0 0 16 16"><path d="M3.5 12.5v-4M8 12.5v-9M12.5 12.5V6" /></svg>
          </span>
          <span class="sm-fenetre__nom">Dashboard</span>
          <span class="sm-fenetre__info">ce mois-ci</span>
          <span class="sm-etat direct" data-etat="cours" data-etat-de="tableau">
            <i class="direct__point"></i>
            <span class="direct__avant">En attente</span>
            <span class="direct__apres">En direct</span>
          </span>
        </div>
        <div class="sm-corps tableau">
          <div class="tuiles">
            <div class="tuile tuile--demandes">
              <span class="tuile__nom">Demandes</span>
              <div class="tuile__ligne">
                <b data-demandes>{formatEntier.format(demandes)}</b>
                <span class="plus est-visible" data-plus>
                  +<span data-plus-n>{clics}</span><span class="sm-large">&nbsp;aujourd’hui</span>
                </span>
              </div>
            </div>
            <div class="tuile tuile--taux">
              <span class="tuile__nom">Conversion</span>
              <b data-taux>{taux}</b>
            </div>
          </div>

          {/* Les barres : une colonne par jour, une unité par demande, la
             dernière colonne en pêche pour aujourd'hui. La piste porte une
             colonne de plus que la vue n'en montre : c'est elle qui entre
             quand on change de jour. */}
          <div class="barres" data-barres>
            <div class="barres__vue">
              <div class="barres__piste" data-piste>
                {colonnes.map((valeur) => (
                  <div class="colonne" data-colonne>
                    {Array.from({ length: UNITES }, (_, n) => (
                      <i class:list={['unite', { 'est-pleine': n < valeur }]}></i>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="sm-pied visites sm-large">
            <span>Visites</span>
            <b data-visites>{formatEntier.format(visites)}</b>
          </div>
        </div>
      </div>
      <span class="sm-port port--tableau est-actif" data-sm-port="tableau"></span>
    </div>

    <span class="sm-noeud est-allume" data-sm-noeud="demande">
      <svg viewBox="0 0 16 16"><path d="M6.4 6.4l6.4 2.3-2.8 1.3-1.3 2.8zM6 2.2v1.6M2.2 6h1.6M3.3 3.3l1.2 1.2" /></svg>
    </span>

    {/* Le cadre de sélection : il pose chaque bloc de la page, l'un après
       l'autre, et le nomme. Hors de la feuille, qui rognerait son étiquette. */}
    <span class="cadre" data-cadre>
      <em data-cadre-nom>Titre</em>
      <i></i><i></i><i></i><i></i>
    </span>

    {/* Ce qui voyage, une série par clic : le pointeur d'un visiteur, l'onde
       de son appui, la bande qui en part et le grain qui traverse le fil. */}
    {voyageurs.map(() => (
      <>
        <span class="onde"></span>
        <svg class="pointeur" viewBox="0 0 16 16"><path d="M3 1.6v11.6l3.1-2.9 2.1 4.6 2-.9-2.1-4.5h4.3z" /></svg>
        <span class="sm-bande"></span>
        <span class="sm-grain"></span>
      </>
    ))}
  </div>
</div>

<style>
  /* Ce que le socle ne sait pas : où sont les deux postes et leurs ports, la
     page et son cadre de sélection, le clic, et les composants du tableau de
     bord. Longueurs en pixels du plan ; les tailles de texte sont les quatre
     du socle, jamais une valeur en pixels. */
  .sm {
    --sm-lumiere: 70% 54%;
  }

  .poste--page {
    top: 88px;
    left: 24px;
    width: 322px;
  }

  .poste--tableau {
    top: 150px;
    left: 412px;
    width: 324px;
  }

  /* Le port de la page est à la hauteur de son bouton. */
  .port--bouton { top: 225px; right: -6px; }
  .port--tableau { top: 76px; left: -6px; }

  /* Seule, la pastille de la promesse reste à droite. */
  .sm-puce--peche {
    margin-left: auto;
  }

  /* Des deux fils, celui de l'autre plan est masqué sans quitter le rendu :
     le moteur mesure encore son tracé. */
  .fil--etroit {
    visibility: hidden;
  }

  /* Le socle coupe les transitions en mouvement réduit, mais à spécificité
     plus faible que celles de cette scène : il faut les couper ici aussi. */
  @media (prefers-reduced-motion: reduce) {
    .page::before,
    .cadre em,
    .plus,
    .unite {
      transition: none;
    }
  }

  /* ── Le navigateur : deux flèches, une adresse en pastille, l'état ── */
  .fleches {
    flex-shrink: 0;
    width: 28px;
    height: 12px;
    stroke: var(--color-ink-low);
    stroke-width: 1.4;
  }

  .adresse {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 5px;
    min-width: 0;
    height: 22px;
    padding: 0 9px 0 7px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
    color: var(--color-ink-mid);
    font-size: var(--sm-note);
    font-weight: 500;
  }

  .adresse svg {
    flex-shrink: 0;
    width: 11px;
    height: 11px;
    stroke: var(--color-ink-low);
    stroke-width: 1.2;
  }

  .adresse__texte {
    white-space: nowrap;
  }

  .adresse__chemin {
    color: var(--color-ink-low);
  }

  /* ── La page ──
     Une feuille claire. En chantier, ses deux marges sont tracées en
     pointillé, comme les repères d'un éditeur ; en ligne, elles s'effacent. */
  .page {
    padding: 18px 20px 22px;
  }

  .page::before {
    content: '';
    position: absolute;
    inset: 0 20px;
    border-inline: 1px dashed color-mix(in srgb, var(--color-peche) 80%, var(--color-night));
    opacity: 0;
    transition: opacity 420ms;
    pointer-events: none;
  }

  .page.est-en-chantier::before {
    opacity: 0.55;
  }

  .page__entete {
    position: relative;
    display: flex;
    align-items: center;
    height: 16px;
    margin-bottom: 28px;
  }

  .page__marque {
    width: 15px;
    height: 15px;
    border-radius: 4.5px;
    background: var(--color-night);
  }

  .page__menu {
    display: flex;
    gap: 7px;
    margin-left: auto;
  }

  .page__menu i {
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-feuille-barre);
  }

  /* Un bloc n'existe pas tant qu'il n'est pas posé. */
  .bloc {
    position: relative;
    opacity: 0;
  }

  .bloc.est-pose {
    opacity: 1;
  }

  .page.est-centree .bloc {
    margin-inline: auto;
  }

  .page.est-centree .bloc--titre i {
    margin-inline: auto;
  }

  .page.est-centree .bloc--logos {
    justify-content: center;
  }

  .bloc--titre {
    display: grid;
    gap: 9px;
  }

  .gros {
    height: 17px;
    border-radius: 4.5px;
    background: var(--color-night);
  }

  .gros--un { width: var(--t1, 90%); }
  .gros--deux { width: var(--t2, 62%); }

  .fin {
    height: 5px;
    border-radius: 3px;
    background: var(--color-feuille-barre);
  }

  .fin--un { width: var(--p1, 76%); margin-top: 6px; }
  .fin--deux { width: var(--p2, 48%); margin-top: -2px; }

  /* Entre deux blocs, la place de l'étiquette du cadre : elle nomme le bloc
     qu'on pose sans mordre sur celui d'au-dessus. */
  .bloc--bouton {
    display: flex;
    width: fit-content;
    margin-top: 26px;
  }

  /* Le bouton : la seule pêche de la page, et ce sur quoi on clique. Son
     libellé est le texte le plus fort de la page ; il est en nuit. */
  .bouton {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 16px 0 18px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-feuille) 45%, transparent),
      0 6px 14px -8px color-mix(in srgb, var(--color-night) 60%, transparent);
    color: var(--color-night);
    font-size: var(--sm-fort);
    font-weight: 600;
    white-space: nowrap;
  }

  .bouton svg {
    width: 13px;
    height: 13px;
    stroke: var(--color-night);
    stroke-width: 1.6;
  }

  .bloc--preuve {
    display: flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    margin-top: 26px;
    font-size: var(--sm-texte);
  }

  .visages {
    display: flex;
    margin-right: 3px;
  }

  .visages i {
    width: 22px;
    height: 22px;
    border: 2px solid var(--color-feuille);
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-peche), var(--color-lueur-froide));
  }

  .visages i + i {
    margin-left: -7px;
    background: linear-gradient(135deg, var(--color-night-soft), var(--color-ink-faint));
  }

  .visages i:last-child {
    background: linear-gradient(135deg, var(--color-feuille-barre), var(--color-peche));
  }

  .etoile {
    width: 13px;
    height: 13px;
    fill: var(--color-night);
  }

  .bloc--preuve b {
    font-weight: 600;
  }

  .preuve__texte {
    width: 58px;
    height: 4px;
    border-radius: 2px;
    background: var(--color-feuille-barre);
  }

  .bloc--logos {
    display: flex;
    gap: 6px;
    margin-top: 26px;
    padding-top: 16px;
    border-top: 1px solid var(--color-feuille-trait);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 27px;
    padding: 0 10px 0 8px;
    border: 1px solid var(--color-feuille-trait);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-night) 4%, transparent);
  }

  .logo svg {
    width: 12px;
    height: 12px;
    stroke: var(--color-feuille-note);
    stroke-width: 1.5;
  }

  .logo i {
    width: 19px;
    height: 4px;
    border-radius: 2px;
    background: var(--color-feuille-barre);
  }

  /* ── Le cadre de sélection ──
     Un filet, quatre poignées, et le nom du bloc qu'il pose. Placé et
     dimensionné par le script, dans le repère du plan. */
  .cadre {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    border: 1.25px solid var(--color-night);
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-peche) 30%, transparent);
    /* La teinte se multiplie avec la page, comme un surligneur : elle colore
       le blanc sans ternir les barres sombres du bloc. */
    mix-blend-mode: multiply;
    opacity: 0;
    pointer-events: none;
  }

  .cadre.est-visible {
    opacity: 1;
  }

  .cadre em {
    position: absolute;
    bottom: calc(100% + 1.25px);
    left: -1.25px;
    padding: 1px 7px 2px;
    border-radius: 4px 4px 4px 0;
    background: var(--color-peche);
    color: var(--color-night);
    font-size: var(--sm-note);
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
    /* En vol entre deux blocs, le cadre se tait : son étiquette passerait sur
       le bloc qu'il vient de poser. */
    transition: opacity 140ms;
  }

  .cadre.est-en-vol em {
    opacity: 0;
  }

  .cadre i {
    position: absolute;
    width: 7px;
    height: 7px;
    border: 1.25px solid var(--color-night);
    border-radius: 2px;
    background: var(--color-feuille);
  }

  .cadre i:nth-of-type(1) { top: -4.5px; right: -4.5px; }
  .cadre i:nth-of-type(2) { right: -4.5px; bottom: -4.5px; }
  .cadre i:nth-of-type(3) { bottom: -4.5px; left: -4.5px; }
  .cadre i:nth-of-type(4) { top: 50%; right: -4.5px; margin-top: -3.5px; }

  /* ── Le clic ── */
  .pointeur,
  .onde {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    opacity: 0;
    pointer-events: none;
  }

  /* La pointe de la flèche est en (3, 1.6) dans son dessin : la marge la
     ramène sur le point visé. */
  .pointeur {
    width: 19px;
    height: 19px;
    margin: -1.9px 0 0 -3.6px;
    fill: var(--color-feuille);
    stroke: var(--color-night);
    stroke-width: 1.2;
    filter: drop-shadow(0 2px 2px color-mix(in srgb, var(--color-night) 40%, transparent));
    transform-origin: 3.6px 1.9px;
  }

  .onde {
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    border: 1.5px solid color-mix(in srgb, var(--color-night) 60%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-night) 10%, transparent);
  }

  /* ── Le tableau de bord ── */
  .tableau {
    --u: 18px;
    --g: 2px;
    --col: 41px;
    padding: 16px 16px 14px;
  }

  .direct {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .direct__point {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .direct__apres,
  .direct[data-etat='cours'] .direct__avant {
    display: none;
  }

  .direct[data-etat='cours'] .direct__apres {
    display: inline;
  }

  /* Les deux nombres qui portent l'action : un nom à la taille forte, un
     nombre qui se lit de loin. La conversion est la promesse du métier : elle
     est en pêche. */
  .tuiles {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .tuile__nom {
    display: block;
    color: var(--color-ink-mid);
    font-size: var(--sm-fort);
    font-weight: 500;
    white-space: nowrap;
  }

  .tuile b {
    display: inline-block;
    font-size: var(--sm-chiffre);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .tuile__ligne {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  .tuile--taux {
    padding-left: 16px;
    border-left: 1px solid var(--sm-filet);
  }

  .tuile--taux b {
    margin-top: 8px;
    color: var(--color-peche);
  }

  /* Ce que la journée a ajouté : n'existe que s'il y a quelque chose à dire. */
  .plus {
    padding: 3px 8px 4px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-peche) 15%, transparent);
    color: var(--color-peche);
    font-size: var(--sm-note);
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
    opacity: 0;
    translate: 0 3px;
    transition:
      opacity 240ms,
      translate 320ms var(--ease-out-expo);
  }

  .plus.est-visible {
    opacity: 1;
    translate: 0 0;
  }

  /* Les barres. Une unité vaut une demande : elles se comptent à l'œil, sans
     échelle. Un seul filet, le sol. */
  .barres {
    margin-top: 18px;
  }

  .barres__vue {
    width: calc(7 * var(--col));
    overflow: hidden;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 26%, transparent);
  }

  .barres__piste {
    display: flex;
    width: max-content;
  }

  .colonne {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--g);
    width: var(--col);
    height: calc(6 * (var(--u) + var(--g)));
    padding: 0 7px 2px;
  }

  .unite {
    flex-shrink: 0;
    height: var(--u);
    border: 1px solid transparent;
    border-radius: 3.5px;
    transform-origin: 50% 100%;
    transition:
      background-color 360ms,
      border-color 240ms;
  }

  .unite.est-pleine {
    background: color-mix(in srgb, var(--color-ink) 21%, transparent);
  }

  /* Aujourd'hui, c'est la septième colonne : la seule en pêche. La huitième
     attend hors de la vue et lui ressemble, vide. Dans les deux, la prochaine
     unité est annoncée par un emplacement en pointillé. */
  .colonne:nth-child(7):not(.est-hier) .unite.est-pleine {
    background: var(--color-peche);
  }

  .colonne:nth-child(n + 7):not(.est-hier) .unite:not(.est-pleine):first-child,
  .colonne:nth-child(n + 7):not(.est-hier) .unite.est-pleine + .unite:not(.est-pleine) {
    border: 1px dashed color-mix(in srgb, var(--color-peche) 55%, transparent);
  }

  /* Le raccord entre deux jours se fait d'un coup, sans transition. */
  .barres.sans-transition .unite {
    transition: none;
  }

  /* Les visites : le pied de la fenêtre, à la manière du socle. Le sol des
     barres fait déjà le filet. */
  .visites {
    margin-top: 0;
    padding-inline: 0;
    border-top: 0;
  }

  /* ── Le plan étroit ──
     Une autre silhouette que le grand plan. La page claire prend toute la
     largeur, en haut ; le tableau de bord n'est plus une fenêtre mais une
     bande en bas (les demandes, la conversion, les barres) ; le fil descend
     tout droit du bouton à la bande. La hauteur gagnée par le plan (320 au
     lieu de 270) va au texte : le libellé du bouton et les deux nombres. */
  @container sm (max-width: 519.98px) {
    .sm::before {
      --sm-lumiere: 50% 84%;
    }

    .fil--large {
      visibility: hidden;
    }

    .fil--etroit {
      visibility: visible;
    }

    /* Entre la page et la bande, il n'y a que la place du fil. */
    .sm-noeud {
      display: none;
    }

    .poste--page {
      top: 38px;
      left: 10px;
      width: 340px;
    }

    .poste--tableau {
      top: auto;
      bottom: 8px;
      left: 10px;
      width: 340px;
    }

    /* Les deux ports à la même abscisse, sous le bouton : le fil est une
       verticale. */
    .port--bouton { top: auto; right: auto; bottom: -5px; left: 46px; }
    .port--tableau { top: -5px; left: 46px; }

    .fleches {
      width: 24px;
      height: 10px;
    }

    .adresse {
      gap: 4px;
      height: 19px;
      padding: 0 8px 0 6px;
    }

    .adresse svg {
      width: 10px;
      height: 10px;
    }

    /* La page, large et basse : le titre sur toute la largeur, puis le bouton
       et la preuve sur une même ligne. Toujours calée à gauche, pour que le
       bouton reste au-dessus de son port. */
    .page {
      padding: 10px 12px 10px;
    }

    .page::before {
      inset: 0 12px;
    }

    /* Sous l'en-tête, la place de l'étiquette du cadre. */
    .page__entete {
      height: 9px;
      margin-bottom: 12px;
    }

    .page__marque {
      width: 9px;
      height: 9px;
      border-radius: 3px;
    }

    .page__menu {
      gap: 5px;
    }

    .page__menu i {
      width: 13px;
      height: 2.5px;
    }

    .page.est-centree .bloc--titre,
    .page.est-centree .bloc--titre i,
    .page.est-centree .bloc--bouton {
      margin-inline: 0;
    }

    .bloc--titre {
      gap: 6px;
    }

    .gros {
      height: 11px;
      border-radius: 3.5px;
    }

    /* Le faux paragraphe sort de la page : sa place va à l'étiquette du
       cadre, qui nomme le bouton sans rien recouvrir. */
    .fin {
      display: none;
    }

    .bloc--bouton,
    .bloc--preuve {
      display: inline-flex;
      vertical-align: middle;
      margin-top: 23px;
    }

    /* Un peu d'air à droite de la note : la poignée du cadre ne la touche
       pas. */
    .bloc--preuve,
    .page.est-centree .bloc--preuve {
      gap: 5px;
      margin-inline: 14px 0;
      padding-right: 5px;
    }

    .bouton {
      gap: 6px;
      height: 32px;
      padding: 0 12px 0 14px;
    }

    .bouton svg {
      width: 11px;
      height: 11px;
    }

    .visages i {
      width: 18px;
      height: 18px;
      border-width: 1.5px;
    }

    .visages i + i {
      margin-left: -6px;
    }

    .etoile {
      width: 11px;
      height: 11px;
    }

    /* L'étiquette se décale : au coin, elle toucherait la marque de la page. */
    .cadre em {
      left: 14px;
      padding: 1px 6px 2px;
      border-radius: 4px 4px 0 0;
    }

    /* Sur la rangée du bouton, elle revient au coin : rien à éviter. */
    .cadre.est-en-ligne em {
      left: -1.25px;
      border-radius: 4px 4px 4px 0;
    }

    .cadre i {
      width: 6px;
      height: 6px;
    }

    .cadre i:nth-of-type(1) { top: -4px; right: -4px; }
    .cadre i:nth-of-type(2) { right: -4px; bottom: -4px; }
    .cadre i:nth-of-type(3) { bottom: -4px; left: -4px; }
    .cadre i:nth-of-type(4) { right: -4px; margin-top: -3px; }

    .pointeur {
      width: 16px;
      height: 16px;
      margin: -1.6px 0 0 -3px;
      transform-origin: 3px 1.6px;
    }

    .onde {
      width: 36px;
      height: 36px;
      margin: -18px 0 0 -18px;
    }

    /* La bande : sans barre de titre, sur une seule ligne. Les demandes à
       gauche, sous l'arrivée du fil ; la conversion ; les barres à droite. */
    .poste--tableau .sm-fenetre__barre {
      display: none;
    }

    .tableau {
      --u: 6px;
      --g: 1.5px;
      --col: 18px;
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr);
      align-items: end;
      column-gap: 14px;
      padding: 8px 10px 8px 12px;
    }

    .tuiles {
      display: contents;
    }

    /* Le nombre et son « +n » ne poussent pas la conversion quand ils
       grandissent. */
    .tuile--demandes {
      min-width: 74px;
    }

    .tuile__ligne {
      gap: 6px;
      margin-top: 5px;
    }

    .tuile--taux {
      padding-left: 14px;
    }

    .tuile--taux b {
      margin-top: 5px;
    }

    .plus {
      padding: 2px 6px 3px;
    }

    .barres {
      justify-self: end;
      margin-top: 0;
    }

    .colonne {
      padding: 0 3px 1.5px;
    }

    .unite {
      border-radius: 2px;
    }

    /* À six pixels de haut, un pointillé ne se lit plus : l'emplacement de la
       prochaine unité est un filet plein. */
    .colonne:nth-child(n + 7):not(.est-hier) .unite:not(.est-pleine):first-child,
    .colonne:nth-child(n + 7):not(.est-hier) .unite.est-pleine + .unite:not(.est-pleine) {
      border-style: solid;
    }
  }
</style>

<script>
  /*
   * La partition de la scène : ses états (repos, image fixe) et l'ordre de sa
   * boucle. Le temps, la pause hors écran, l'échelle et l'annulation sont dans
   * le moteur ; ici, aucune attente n'a besoin de vérifier qu'elle a encore
   * cours, une boucle remplacée se défait d'elle-même.
   */
  import { ELAN, EXPO, monterScenes } from '../../lib/metiers/scene';
  import type { Cadre, Pt } from '../../lib/metiers/scene';

  interface PageRecit {
    chemin: string;
    bouton: string;
    centre: boolean;
    titre: number[];
    texte: number[];
  }

  interface Recit {
    pages: PageRecit[];
    clics: number[];
    historique: number[];
    deja: number;
    visitesParDemande: number;
  }

  /* Le récit arrive du balisage en JSON : c'est une frontière, on vérifie sa
     forme avant de s'en servir. */
  const estObjet = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null;
  const estNombres = (v: unknown): v is number[] => Array.isArray(v) && v.every((n) => typeof n === 'number');
  const estPositif = (v: unknown): v is number => typeof v === 'number' && v > 0;

  const estPage = (v: unknown): v is PageRecit =>
    estObjet(v) &&
    typeof v.chemin === 'string' &&
    typeof v.bouton === 'string' &&
    typeof v.centre === 'boolean' &&
    estNombres(v.titre) &&
    estNombres(v.texte);

  const lireRecit = (brut: string | undefined): Recit => {
    const lu: unknown = JSON.parse(brut ?? 'null');
    /* `deja` et `visitesParDemande` sont strictement positifs : c'est ce qui
       garantit qu'un taux n'est jamais une division par zéro, ni un zéro. */
    const valide =
      estObjet(lu) &&
      Array.isArray(lu.pages) &&
      lu.pages.length > 0 &&
      lu.pages.every(estPage) &&
      estNombres(lu.clics) &&
      lu.clics.length > 0 &&
      estNombres(lu.historique) &&
      estPositif(lu.deja) &&
      estPositif(lu.visitesParDemande);
    if (!valide) throw new Error('Scène Sites : `data-recit` est illisible');
    return lu as unknown as Recit;
  };

  const formatEntier = new Intl.NumberFormat('fr-FR');
  const formatTaux = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const entier = (n: number): string => formatEntier.format(Math.round(n));
  /* « 5,5 % », avec son espace insécable. */
  const pourCent = (part: number): string => `${formatTaux.format(part * 100)} %`;

  /* Ce que le cadre de sélection laisse autour du bloc qu'il pose, sur le
     grand plan puis sur l'étroit. */
  const MARGE_CADRE = { large: 6, etroit: 4 };
  /* La bande, quand elle entre dans un port ou en sort : un tiret. */
  const TIRET = { w: 16, h: 6 };
  /* Le départ de chaque clic, en ms : de plus en plus rapprochés. */
  const DEPARTS = [0, 1050, 1800, 2350, 2750];
  /* Où chaque visiteur appuie sur le bouton (en part de sa largeur), et d'où
     arrive son pointeur (en pixels du plan) : ce n'est pas le même deux fois. */
  const APPUIS = [0.34, 0.66, 0.48, 0.78, 0.24];
  const ARRIVEES: Pt[] = [
    { x: 26, y: 24 },
    { x: -20, y: 28 },
    { x: 32, y: 10 },
    { x: 6, y: 32 },
    { x: -28, y: 16 },
  ];

  const tiretAu = (p: Pt): Cadre => ({ x: p.x - TIRET.w / 2, y: p.y - TIRET.h / 2, w: TIRET.w, h: TIRET.h });
  const vers = (p: Pt, echelle = 1): string => `translate(${p.x}px, ${p.y}px) scale(${echelle})`;

  monterScenes('[data-scene-sites]', (s) => {
    const recit = lireRecit(s.racine.dataset.recit);

    const elPage = s.un('[data-page]');
    const elChemin = s.un('[data-chemin]');
    const elLibelle = s.un('[data-libelle]');
    const bouton = s.un('[data-bouton]');
    const blocs = s.tous('[data-bloc]');
    const cadre = s.un('[data-cadre]');
    const nomCadre = s.un('[data-cadre-nom]');

    const barres = s.un('[data-barres]');
    const piste = s.un('[data-piste]');
    const colonnes = s.tous('[data-colonne]');
    const piles = colonnes.map((colonne) => [...colonne.querySelectorAll<HTMLElement>('.unite')]);
    const elDemandes = s.un('[data-demandes]');
    const elPlus = s.un('[data-plus]');
    const elPlusN = s.un('[data-plus-n]');
    const elVisites = s.un('[data-visites]');
    const elTaux = s.un('[data-taux]');
    const elPuceDemandes = s.un('[data-puce-demandes]');
    const elPuceTaux = s.un('[data-puce-taux]');

    const etats = {
      page: s.un('[data-etat-de="page"]'),
      tableau: s.un('[data-etat-de="tableau"]'),
    };
    const noeud = s.un('[data-sm-noeud="demande"]');
    const pointeurs = s.tous<SVGSVGElement>('.pointeur');
    const ondes = s.tous('.onde');
    const bandes = s.tous('.sm-bande');
    const grains = s.tous('.sm-grain');

    /* Le fil du moment : à l'horizontale sur le grand plan, à la verticale
       sur l'étroit. */
    const filDuPlan = (): string => (s.etroit ? 'demande-bas' : 'demande');

    /* L'état de la scène. `rang` choisit la page et la journée ; `historique`
       glisse d'un jour à chaque boucle ; `deja` est le total des demandes du
       mois avant la journée en cours. */
    let rang = 0;
    let historique = [...recit.historique];
    let deja = recit.deja;

    /* Les listes tournent ; `lireRecit` a vérifié qu'aucune n'est vide. */
    const auRang = <T,>(liste: T[]): T => {
      const element = liste[rang % liste.length];
      if (element === undefined) throw new Error('Scène Sites : le récit est vide');
      return element;
    };
    const pageCourante = (): PageRecit => auRang(recit.pages);
    /* Jamais plus de clics que la barre n'a d'unités, ni que la scène n'a de
       pointeurs. */
    const clicsDuJour = (): number => Math.min(auRang(recit.clics), pointeurs.length, piles[0]?.length ?? 0);
    /* Les visites du mois, comptées au matin : la journée part du taux du
       site, pas de zéro. Elles ne bougent pas pendant qu'on clique, si bien
       que demandes ÷ visites = conversion à chaque instant. */
    const visites = (): number => deja * recit.visitesParDemande;
    /* La colonne d'aujourd'hui : celle qui suit l'historique. */
    const AUJOURDHUI = historique.length;

    /* La page du moment, écrite dans le balisage. */
    const charger = () => {
      const page = pageCourante();
      elChemin.textContent = page.chemin;
      elLibelle.textContent = page.bouton;
      elPage.classList.toggle('est-centree', page.centre);
      elPage.style.setProperty('--t1', `${page.titre[0] ?? 90}%`);
      elPage.style.setProperty('--t2', `${page.titre[1] ?? 62}%`);
      elPage.style.setProperty('--p1', `${page.texte[0] ?? 76}%`);
      elPage.style.setProperty('--p2', `${page.texte[1] ?? 48}%`);
    };

    /* Les barres : l'historique, puis aujourd'hui, puis la colonne de réserve. */
    const poserBarres = (aujourdhui: number) => {
      colonnes.forEach((colonne, i) => {
        const valeur = i < AUJOURDHUI ? (historique[i] ?? 0) : i === AUJOURDHUI ? aujourdhui : 0;
        piles[i]?.forEach((unite, n) => unite.classList.toggle('est-pleine', n < valeur));
        colonne.classList.remove('est-hier');
      });
    };

    const tauxApres = (n: number): string => pourCent((deja + n) / visites());

    /* Les nombres, après `n` demandes dans la journée. */
    const poserNombres = (n: number) => {
      const taux = tauxApres(n);
      elDemandes.textContent = entier(deja + n);
      elPuceDemandes.textContent = entier(deja + n);
      elPlusN.textContent = String(n);
      elPlus.classList.toggle('est-visible', n > 0);
      elVisites.textContent = entier(visites());
      elTaux.textContent = taux;
      elPuceTaux.textContent = taux;
    };

    /* Ce qu'une boucle interrompue peut laisser derrière elle. */
    const ranger = () => {
      cadre.classList.remove('est-visible', 'est-en-vol', 'est-en-ligne');
      barres.classList.remove('sans-transition');
    };

    /* Le repos : une page vide, en chantier, et un tableau de bord qui attend
       la journée, avec les nombres du mois au matin. */
    const repos = () => {
      s.racine.classList.remove('est-abouti');
      s.eteindre();
      ranger();
      charger();
      blocs.forEach((bloc) => bloc.classList.remove('est-pose'));
      elPage.classList.add('est-en-chantier');
      etats.page.dataset.etat = 'attente';
      etats.tableau.dataset.etat = 'attente';
      poserBarres(0);
      poserNombres(0);
    };

    /* L'image fixe : la page est en ligne, la journée est passée. C'est aussi
       ce que le HTML rend sans script. */
    const figer = () => {
      const clics = clicsDuJour();
      ranger();
      charger();
      blocs.forEach((bloc) => bloc.classList.add('est-pose'));
      elPage.classList.remove('est-en-chantier');
      etats.page.dataset.etat = 'fait';
      etats.tableau.dataset.etat = 'cours';
      poserBarres(clics);
      poserNombres(clics);
      s.eteindre();
      s.allumer(filDuPlan(), true);
      s.racine.classList.add('est-abouti');
    };

    const placerCadre = (c: Cadre) => {
      Object.assign(cadre.style, { left: `${c.x}px`, top: `${c.y}px`, width: `${c.w}px`, height: `${c.h}px` });
    };

    const autour = (bloc: HTMLElement): Cadre => {
      const c = s.cadreDe(bloc);
      const m = s.etroit ? MARGE_CADRE.etroit : MARGE_CADRE.large;
      return { x: c.x - m, y: c.y - m, w: c.w + m * 2, h: c.h + m * 2 };
    };

    const enPixels = (c: Cadre): Keyframe => ({
      left: `${c.x}px`,
      top: `${c.y}px`,
      width: `${c.w}px`,
      height: `${c.h}px`,
    });

    /* Le cadre de sélection vient se poser, puis le bloc se dessine dedans,
       de gauche à droite. Le premier cadre s'ouvre sur place ; les suivants
       glissent depuis le bloc d'avant et prennent sa nouvelle taille. */
    const poser = async (bloc: HTMLElement, avant: Cadre | null): Promise<Cadre> => {
      const cible = autour(bloc);
      const nom = bloc.dataset.nom ?? '';
      /* Seul le titre partage sa ligne avec la marque de la page : pour lui,
         sur le plan étroit, l'étiquette se décale. */
      const enLigne = bloc !== blocs[0];
      placerCadre(cible);
      cadre.classList.add('est-visible');
      if (avant) {
        cadre.classList.add('est-en-vol');
        await s.animer(cadre, [enPixels(avant), enPixels(cible)], {
          duration: 300,
          easing: 'cubic-bezier(0.45, 0, 0.15, 1)',
        });
        /* Le nom change à l'arrivée, quand le cadre reparle. */
        nomCadre.textContent = nom;
        cadre.classList.toggle('est-en-ligne', enLigne);
        cadre.classList.remove('est-en-vol');
      } else {
        nomCadre.textContent = nom;
        cadre.classList.toggle('est-en-ligne', enLigne);
        cadre.style.transformOrigin = '0 0';
        await s.animer(
          cadre,
          [
            { transform: 'scale(0.72, 0.4)', opacity: 0 },
            { transform: 'none', opacity: 1 },
          ],
          { duration: 280, easing: EXPO },
        );
      }
      bloc.classList.add('est-pose');
      await s.animer(
        bloc,
        { clipPath: ['inset(-8px 100% -8px -8px)', 'inset(-8px -8px -8px -8px)'] },
        { duration: 320, easing: EXPO },
      );
      await s.attendre(70);
      return cible;
    };

    /* Un clic : le pointeur d'un visiteur arrive sur le bouton et appuie, la
       demande part par le fil, et devient une unité de plus sur la barre du
       jour. Les nombres suivent : une demande de plus, un taux qui monte. */
    const cliquer = async (i: number) => {
      const pointeur = pointeurs[i];
      const onde = ondes[i];
      const bande = bandes[i];
      const grain = grains[i];
      const unite = piles[AUJOURDHUI]?.[i];
      const appui = s.lieu(bouton, APPUIS[i] ?? 0.5, 0.56);
      const ecart = ARRIVEES[i] ?? { x: 24, y: 24 };
      if (!pointeur || !onde || !bande || !grain || !unite) return;
      /* Sur le plan étroit, tout est plus près : le pointeur vient de moins
         loin. */
      const k = s.etroit ? 0.6 : 1;
      const loin = { x: appui.x + ecart.x * k, y: appui.y + ecart.y * k };

      await s.animer(
        pointeur,
        [
          { transform: vers(loin), opacity: 0 },
          { opacity: 1, offset: 0.45 },
          { transform: vers(appui), opacity: 1 },
        ],
        { duration: 320, easing: EXPO },
      );

      /* L'appui : le bouton s'enfonce, le pointeur aussi, une onde s'ouvre. */
      s.jouer(bouton, [{ transform: 'none' }, { transform: 'scale(0.95)', offset: 0.35 }, { transform: 'none' }], {
        duration: 320,
        easing: 'ease-out',
      });
      s.jouer(
        pointeur,
        [
          { transform: vers(appui), opacity: 1 },
          { transform: vers(appui, 0.8), opacity: 1, offset: 0.3 },
          { transform: vers(appui), opacity: 1, offset: 0.62 },
          { transform: vers(appui), opacity: 0 },
        ],
        { duration: 520, easing: 'ease-out' },
      );
      s.jouer(
        onde,
        [
          { transform: vers(appui, 0.25), opacity: 0.9 },
          { transform: vers(appui, 1), opacity: 0 },
        ],
        { duration: 620, easing: EXPO },
      );
      await s.attendre(120);

      /* Le passage par le fil, avec les temps du socle (`passer`) : ici la
         bande naît au point d'appui et se pose sur une unité de barre, deux
         rectangles exacts que `passer` ne sait pas recevoir. Sans pose au
         départ, elle n'apparaît qu'en s'éloignant : pêche sur pêche, elle
         masquerait le libellé du bouton. */
      const depuis: Cadre = { x: appui.x - 15, y: appui.y - 5, w: 30, h: 10 };
      s.enMarge(
        s.voler(bande, depuis, tiretAu(s.lieu(s.port('bouton'))), {
          duree: 460,
          arrivee: 0.9,
          easing: ELAN,
          eclot: true,
        }),
      );
      await s.attendre(380);
      if (s.etroit) {
        /* Le fil est court et tombe sur la bande : le grain descend vite, et
           l'unité se pose sans vol, la bande n'a rien à traverser. */
        s.enMarge(s.courir(grain, filDuPlan(), { duree: 300 }));
        await s.attendre(270);
        s.port('tableau').classList.add('est-actif');
      } else {
        s.enMarge(s.courir(grain, filDuPlan()));
        await s.attendre(210);
        s.jouer(noeud, [{ scale: 1 }, { scale: 1.24, offset: 0.35 }, { scale: 1 }], {
          duration: 320,
          easing: 'ease-out',
        });
        await s.attendre(240);
        s.port('tableau').classList.add('est-actif');
        s.enMarge(
          s.voler(bande, tiretAu(s.lieu(s.port('tableau'))), s.cadreDe(unite), {
            duree: 620,
            pose: 0.06,
            arrivee: 0.64,
            easing: EXPO,
            eclot: true,
          }),
        );
        await s.attendre(380);
      }

      unite.classList.add('est-pleine');
      s.jouer(unite, [{ transform: 'scaleY(0.35)' }, { transform: 'none' }], { duration: 380, easing: EXPO });
      /* Les deux nombres changent dans la même image : à aucun instant le
         tableau de bord n'affiche un taux qui ne soit pas celui de ses
         demandes. */
      const n = i + 1;
      const taux = tauxApres(n);
      s.tictac(elDemandes, entier(deja + n));
      s.tictac(elPuceDemandes, entier(deja + n));
      s.tictac(elTaux, taux);
      s.tictac(elPuceTaux, taux);
      elPlusN.textContent = String(n);
      elPlus.classList.add('est-visible');
    };

    async function tour() {
      const clics = clicsDuJour();
      const visibles = s.affiches(blocs);

      await s.attendre(320);

      /* 1. La page se monte, bloc par bloc. */
      let avant: Cadre | null = null;
      for (const bloc of visibles) avant = await poser(bloc, avant);
      await s.animer(cadre, { opacity: [1, 0] }, { duration: 200 });
      cadre.classList.remove('est-visible');

      /* 2. Elle passe en ligne : les repères s'effacent, le tableau de bord
         se met à l'écoute. */
      elPage.classList.remove('est-en-chantier');
      s.basculer(etats.page);
      await s.attendre(320);
      s.basculer(etats.tableau, 'cours');
      await s.attendre(340);

      /* 3. Les clics, de plus en plus rapprochés. */
      s.allumer(filDuPlan());
      await Promise.all(
        Array.from({ length: clics }, async (_, i) => {
          await s.attendre(DEPARTS[i] ?? i * 700);
          await cliquer(i);
        }),
      );
      s.racine.classList.add('est-abouti');

      /* Le temps de lire l'image : la page tourne, le tableau de bord le dit. */
      await s.attendre(2800);

      /* 4. On change de jour : la page se défait, les barres glissent d'une
         colonne (aujourd'hui devient hier). Les demandes du mois restent. */
      s.racine.classList.remove('est-abouti');
      s.eteindre();
      etats.page.dataset.etat = 'attente';
      etats.tableau.dataset.etat = 'attente';
      elPlus.classList.remove('est-visible');
      colonnes[AUJOURDHUI]?.classList.add('est-hier');
      const cran = (colonnes[1]?.offsetLeft ?? 0) - (colonnes[0]?.offsetLeft ?? 0);
      const GLISSE = 620;
      const premiere = colonnes[0];
      /* Le jour qui sort s'efface en partant, et reste effacé jusqu'au raccord. */
      if (premiere) {
        s.jouer(premiere, [{ opacity: 1 }, { opacity: 0, offset: 0.4 }, { opacity: 0 }], { duration: GLISSE });
      }
      await Promise.all([
        s.animer(piste, { transform: ['translateX(0)', `translateX(${-cran}px)`] }, { duration: GLISSE, easing: EXPO }),
        ...[...visibles].reverse().map(async (bloc, i) => {
          await s.attendre(i * 55);
          await s.animer(
            bloc,
            [
              { opacity: 1, transform: 'none' },
              { opacity: 0, transform: 'translateY(5px)' },
            ],
            { duration: 240, easing: ELAN },
          );
          bloc.classList.remove('est-pose');
        }),
      ]);

      /* Le raccord, invisible : chaque colonne prend la valeur de sa voisine
         dans l'image même où la piste revient à sa place. Le mois compte une
         journée de plus : ses demandes sont acquises, ses visites s'ajoutent,
         et le taux repart de celui du matin, jamais de zéro. La page suivante
         est chargée, de nouveau en chantier. */
      historique = [...historique.slice(1), clics];
      deja += clics;
      rang += 1;
      barres.classList.add('sans-transition');
      charger();
      poserBarres(0);
      poserNombres(0);
      /* La lecture force le rendu sans transition avant de les rétablir. */
      void barres.offsetWidth;
      barres.classList.remove('sans-transition');
      elPage.classList.add('est-en-chantier');
      await s.attendre(160);
    }

    return { figer, repos, tour };
  });
</script>
