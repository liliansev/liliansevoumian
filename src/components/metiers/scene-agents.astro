---
/*
 * scene-agents — la scène du métier Agents IA : « Un agent qui lit, trie et
 * qualifie à votre place. »
 *
 * Le cas raconté est celui d'un cabinet de recrutement : des cibles collectées
 * (une entreprise et son dirigeant), un agent qui lit chaque fiche, la note
 * selon trois règles écrites, puis la range. Ce n'est pas la scène du haut de
 * page : ici ni PDF ni facture, seulement des fiches de prospects.
 *
 * Le geste propre à cette scène est la LECTURE puis le TRI. L'agent n'est pas
 * une fenêtre de plus : c'est un bloc à part, sans barre de titre, cerclé de
 * pêche, avec un cœur qui tourne quand il travaille et un aiguillage à sa
 * sortie, dont l'aiguille montre la voie choisie.
 *
 * Le fil de la boucle, un seul mouvement à la fois :
 *   1. une fiche quitte la liste et entre chez l'agent ;
 *   2. le trait de lecture la descend, les trois règles se cochent ;
 *   3. la note monte, l'aiguille tourne, la fiche part par le bon fil ;
 *   4. les suivantes passent en rafale : à approcher, écartées, et une seule
 *      laissée à un humain ;
 *   5. l'image est tenue, puis tout est rangé et un nouveau lot arrive.
 *
 * Le panneau, les fenêtres, la feuille, les fils et les gestes viennent du
 * socle (`scene-metier.css` et `lib/metiers/scene.ts`). Ce composant n'écrit
 * que ce qui lui est propre : ses fiches, son agent, son aiguillage.
 *
 * Sans script ou en mouvement réduit, la scène est une image fixe : le lot est
 * trié, trois fiches à approcher, deux écartées, une qui attend une décision.
 *
 * Secteurs, effectifs et notes sont inventés pour la scène : ce n'est pas une
 * donnée client. Une fiche n'a jamais de nom, seulement une barre dont `l`
 * donne la longueur, en pour cent.
 */
import './scene-metier.css';

type Avis = 'oui' | 'non' | 'doute';
type Verdict = 'approcher' | 'valider' | 'ecarter';

interface Fiche {
  l: number;
  /* Ce que l'agent extrait, dans l'ordre des règles. */
  valeurs: [string, string, string];
  /* Ce que chaque règle en dit. */
  avis: [Avis, Avis, Avis];
  note: number;
  verdict: Verdict;
}

const REGLES = ['Secteur', 'Taille', 'Signal'] as const;

/* Trois lots qui tournent, pour qu'on voie d'une boucle à l'autre que ce ne
   sont pas les mêmes fiches. Tous suivent le même ordre de verdicts : c'est ce
   qui permet au balisage de savoir combien de places chaque destination
   compte, et au plan étroit de s'arrêter après la quatrième fiche en gardant
   les trois issues. */
const lots: Fiche[][] = [
  [
    { l: 72, valeurs: ['SaaS', '120 pers.', 'Levée'], avis: ['oui', 'oui', 'oui'], note: 92, verdict: 'approcher' },
    { l: 54, valeurs: ['Négoce', '8 pers.', 'Aucun'], avis: ['non', 'non', 'non'], note: 18, verdict: 'ecarter' },
    { l: 64, valeurs: ['Fintech', '45 pers.', 'Incertain'], avis: ['oui', 'oui', 'doute'], note: 58, verdict: 'valider' },
    { l: 82, valeurs: ['Logiciel', '60 pers.', 'Recrute'], avis: ['oui', 'oui', 'oui'], note: 88, verdict: 'approcher' },
    { l: 46, valeurs: ['Industrie', '900 pers.', 'Aucun'], avis: ['non', 'non', 'non'], note: 24, verdict: 'ecarter' },
    { l: 68, valeurs: ['Santé', '200 pers.', 'Levée'], avis: ['oui', 'oui', 'oui'], note: 81, verdict: 'approcher' },
  ],
  [
    { l: 60, valeurs: ['Fintech', '80 pers.', 'Recrute'], avis: ['oui', 'oui', 'oui'], note: 90, verdict: 'approcher' },
    { l: 76, valeurs: ['Conseil', '12 pers.', 'Aucun'], avis: ['non', 'non', 'non'], note: 15, verdict: 'ecarter' },
    { l: 50, valeurs: ['SaaS', '30 pers.', 'Incertain'], avis: ['oui', 'oui', 'doute'], note: 61, verdict: 'valider' },
    { l: 70, valeurs: ['SaaS', '250 pers.', 'Levée'], avis: ['oui', 'oui', 'oui'], note: 94, verdict: 'approcher' },
    { l: 58, valeurs: ['Négoce', '40 pers.', 'Aucun'], avis: ['non', 'oui', 'non'], note: 28, verdict: 'ecarter' },
    { l: 84, valeurs: ['Logiciel', '140 pers.', 'Recrute'], avis: ['oui', 'oui', 'oui'], note: 85, verdict: 'approcher' },
  ],
  [
    { l: 78, valeurs: ['Santé', '90 pers.', 'Levée'], avis: ['oui', 'oui', 'oui'], note: 89, verdict: 'approcher' },
    { l: 48, valeurs: ['Industrie', '600 pers.', 'Aucun'], avis: ['non', 'non', 'non'], note: 12, verdict: 'ecarter' },
    { l: 66, valeurs: ['Logiciel', '25 pers.', 'Incertain'], avis: ['oui', 'oui', 'doute'], note: 55, verdict: 'valider' },
    { l: 56, valeurs: ['Fintech', '110 pers.', 'Levée'], avis: ['oui', 'oui', 'oui'], note: 93, verdict: 'approcher' },
    { l: 74, valeurs: ['Conseil', '5 pers.', 'Aucun'], avis: ['non', 'non', 'non'], note: 9, verdict: 'ecarter' },
    { l: 62, valeurs: ['SaaS', '70 pers.', 'Recrute'], avis: ['oui', 'oui', 'oui'], note: 86, verdict: 'approcher' },
  ],
];

const lot = lots[0];
const rangees = (verdict: Verdict) => lot.filter((fiche) => fiche.verdict === verdict);
/* La dernière fiche lue reste sur le plan de travail de l'agent. */
const derniere = lot[lot.length - 1];

/* Le compteur « Cibles lues » au chargement : le chiffre du cas, cinquante
   entreprises par passage. */
const LUES = 50;

/* Plan étroit : quatre fiches au lieu de six, donc deux places à approcher et
   une seule écartée. */
const large = (garde: boolean) => (garde ? '' : 'sm-large');
---

<div
  class="sm est-abouti"
  data-scene-agents
  data-lots={JSON.stringify(lots)}
  role="img"
  aria-label="Un agent lit une à une les fiches de prospects collectées, les note selon trois règles écrites et les range : les bonnes à approcher, les autres écartées, et le cas douteux laissé à la décision d'un humain."
>
  <div class="sm-plan" aria-hidden="true">
    <div class="sm-puces">
      <span class="sm-puce">
        <svg viewBox="0 0 16 16"><path d="M1.6 8s2.4-4.4 6.4-4.4S14.4 8 14.4 8 12 12.4 8 12.4 1.6 8 1.6 8zM8 6.2a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6z" /></svg>
        <span class="sm-puce__nom">Cibles lues</span>
        <b data-lues>{LUES}</b>
      </span>
      <span class="sm-puce sm-puce--peche">
        <svg viewBox="0 0 16 16"><path d="M4 2.6l8.6 4.9-3.7 1.1-1.3 3.8z" /></svg>
        <span class="sm-puce__nom"><span class="sm-large">Triées à la main</span><span class="sm-etroit">À la main</span></span>
        <b data-zero>0</b>
      </span>
    </div>

    {/* Quatre fils : la liste vers l'agent, puis une voie par issue. Le fil
       des écartées ne s'allume jamais : ce qui y passe est éteint. */}
    <svg class="sm-fils" viewBox="0 0 760 570">
      <g class="sm-fil est-allume" data-sm-fil="entree" data-de="cibles" data-vers="agent" data-sens="h">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
      <g class="sm-fil est-allume" data-sm-fil="approcher" data-de="tri" data-vers="approcher" data-sens="h">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
      <g class="sm-fil est-allume" data-sm-fil="valider" data-de="tri" data-vers="valider" data-sens="h">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
      <g class="sm-fil" data-sm-fil="ecarter" data-de="tri" data-vers="ecarter" data-sens="h">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
    </svg>

    {/* Les cibles collectées : une fiche par rangée. */}
    <div class="sm-poste poste--cibles">
      <div class="sm-fenetre">
        <div class="sm-fenetre__barre">
          <span class="sm-fenetre__icone">
            <svg viewBox="0 0 16 16"><path d="M6 7.2a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4zM2.2 13c0-2.2 1.7-3.6 3.8-3.6S9.8 10.8 9.8 13M10.6 3.1a2.2 2.2 0 0 1 0 4M11.6 9.6c1.4.4 2.3 1.6 2.3 3.4" /></svg>
          </span>
          <span class="sm-fenetre__nom">Cibles</span>
          <span class="sm-fenetre__info">Collectées</span>
        </div>
        <div class="sm-corps">
          <div class="sm-rangees">
            {lot.map((fiche, index) => (
              <div
                class:list={['sm-rangee', 'cible', 'est-rempli', 'est-traite', large(index < 4)]}
                data-cible
                data-verdict={fiche.verdict}
                style={`--l: ${fiche.l}%`}
              >
                <i class="visage"></i>
                <i class="sm-barre"></i>
                <b class="cible__note" data-c="note">{fiche.note}</b>
                <div class="cible__tags sm-large">
                  <em data-c="secteur">{fiche.valeurs[0]}</em>
                  <em data-c="taille">{fiche.valeurs[1]}</em>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <span class="sm-port port--cibles est-actif" data-sm-port="cibles"></span>
    </div>

    {/* L'agent : un plan de travail (la fiche lue, les règles, la note) et
       l'aiguillage par où elle repart. */}
    <div class="sm-poste poste--agent">
      <div class="agent" data-agent>
        <div class="agent__tete">
          <span class="coeur">
            <i class="coeur__orbite" data-orbite></i>
            <svg viewBox="0 0 16 16"><path d="M8 2.4l1.4 4.2 4.2 1.4-4.2 1.4L8 13.6 6.6 9.4 2.4 8l4.2-1.4z" /></svg>
          </span>
          <span class="agent__nom">Agent</span>
          <span class="sm-etat" data-etat="fait" data-etat-de="agent">
            <span class="sm-large" data-c="etat-long">Lot trié</span>
            <span class="sm-etroit" data-c="etat-court">Trié</span>
          </span>
        </div>

        <div class="sm-feuille lecteur" data-lecteur>
          <div class="fiche" data-fiche>
            <i class="visage"></i>
            <div class="fiche__barres">
              <i class="sm-barre" data-c="nom" style={`--l: ${derniere.l}%`}></i>
              <i class="sm-barre sm-large"></i>
            </div>
          </div>
          <div class="regles sm-large">Règles écrites</div>
          <div>
            {REGLES.map((regle, index) => (
              <div class="sm-ligne critere est-parti" data-critere data-avis={derniere.avis[index]}>
                <span class="critere__nom">{regle}</span>
                <span class="sm-large" data-c="valeur">{derniere.valeurs[index]}</span>
                <i class="avis">
                  <svg class="avis__oui" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                  <svg class="avis__non" viewBox="0 0 16 16"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" /></svg>
                  <svg class="avis__doute" viewBox="0 0 16 16"><path d="M5.6 6a2.4 2.4 0 1 1 3.7 2c-.8.5-1.3 1-1.3 1.9M8 12.4v.1" /></svg>
                </i>
              </div>
            ))}
          </div>
          <span class="sm-balai" data-balai></span>
        </div>

        <div class="note" data-note data-verdict={derniere.verdict} style={`--n: ${derniere.note / 100}`}>
          <span class="note__nom">Note</span>
          <span class="note__jauge"><i></i></span>
          <b class="note__valeur" data-note-valeur>{derniere.note}</b>
        </div>
      </div>

      <span class="aiguillage" data-aiguillage data-voie={derniere.verdict}>
        <i class="aiguillage__aiguille"></i>
        <i class="aiguillage__pivot"></i>
      </span>
      <span class="sm-port port--agent est-actif" data-sm-port="agent"></span>
      <span class="sm-port port--tri" data-sm-port="tri"></span>
    </div>

    {/* À approcher : les bonnes fiches arrivent avec leur note, en pêche. */}
    <div class="sm-poste poste--approcher">
      <div class="sm-fenetre">
        <div class="sm-fenetre__barre">
          <span class="sm-fenetre__icone">
            <svg viewBox="0 0 16 16"><path d="M13.5 2.5L7 9M13.5 2.5l-4 11L7 9 2.5 6.5z" /></svg>
          </span>
          <span class="sm-fenetre__nom">À approcher</span>
          <span class="sm-etat sm-large" data-etat="fait" data-etat-de="approcher"><b data-compte="approcher">{rangees('approcher').length}</b></span>
        </div>
        <div class="sm-corps">
          <div class="sm-rangees">
            {rangees('approcher').map((fiche, index) => (
              <div class:list={['sm-rangee', 'case', 'est-rempli', 'est-peche', large(index < 2)]} data-case="approcher" style={`--l: ${fiche.l}%`}>
                <i class="visage"></i>
                <i class="sm-barre"></i>
                <span data-c="note">{fiche.note}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <span class="sm-port port--approcher est-actif" data-sm-port="approcher"></span>
    </div>

    {/* À valider : la fiche douteuse attend une décision humaine. */}
    <div class="sm-poste poste--valider est-saisi" data-poste-valider>
      <div class="sm-fenetre">
        <div class="sm-fenetre__barre">
          <span class="sm-fenetre__icone">
            <svg viewBox="0 0 16 16"><path d="M8 7.4a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8zM3.4 13.4c0-2.5 2-4 4.6-4s4.6 1.5 4.6 4" /></svg>
          </span>
          <span class="sm-fenetre__nom">À valider</span>
          <span class="sm-etat sm-large" data-etat="cours" data-etat-de="valider">
            <span class="etat__vide">0</span>
            <span class="etat__plein">À vous</span>
          </span>
        </div>
        <div class="sm-corps">
          <div class="sm-rangees">
            {rangees('valider').map((fiche) => (
              <div class="sm-rangee case est-rempli est-doute" data-case="valider" style={`--l: ${fiche.l}%`}>
                <i class="visage"></i>
                <i class="sm-barre"></i>
                <span data-c="note">{fiche.note}</span>
              </div>
            ))}
          </div>
          <div class="choix sm-large">
            <i>Approcher</i>
            <i>Écarter</i>
          </div>
        </div>
      </div>
      <span class="sm-port port--valider est-actif" data-sm-port="valider"></span>
    </div>

    {/* Écartées : elles arrivent éteintes. */}
    <div class="sm-poste poste--ecartees">
      <div class="sm-fenetre">
        <div class="sm-fenetre__barre">
          <span class="sm-fenetre__icone">
            <svg viewBox="0 0 16 16"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" /></svg>
          </span>
          <span class="sm-fenetre__nom">Écartées</span>
          <span class="sm-etat sm-large" data-etat="attente" data-etat-de="ecarter"><b data-compte="ecarter">{rangees('ecarter').length}</b></span>
        </div>
        <div class="sm-corps">
          <div class="sm-rangees">
            {rangees('ecarter').map((fiche, index) => (
              <div class:list={['sm-rangee', 'case', 'est-rempli', 'est-eteint', large(index < 1)]} data-case="ecarter" style={`--l: ${fiche.l}%`}>
                <i class="visage"></i>
                <i class="sm-barre"></i>
                <span data-c="note">{fiche.note}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <span class="sm-port port--ecarter" data-sm-port="ecarter"></span>
    </div>

    {/* Ce qui voyage : par fiche, une bande et un grain pour entrer chez
       l'agent, une bande et un grain pour en sortir. La rafale fait se
       chevaucher la sortie d'une fiche et l'entrée de la suivante. */}
    {lot.map(() => (
      <>
        <span class="sm-bande" data-bande="entree"></span>
        <span class="sm-grain" data-grain="entree"></span>
        <span class="sm-bande" data-bande="sortie"></span>
        <span class="sm-grain" data-grain="sortie"></span>
      </>
    ))}
  </div>
</div>

<style>
  /* Ce que le socle ne sait pas : où sont les postes et leurs ports, la fiche
     d'une cible, l'agent (son cœur, son plan de travail, sa note) et son
     aiguillage. Longueurs en pixels du plan.

     Tout s'aligne sur un axe, `--axe` : la sortie de la liste, l'entrée de
     l'agent, l'aiguillage et la fiche à valider sont à la même hauteur. Le
     tri s'ouvre donc en éventail autour d'un fil droit. */
  [data-scene-agents] {
    --sm-lumiere: 78% 30%;
  }

  .sm-plan {
    --axe: 310px;
    --h-agent: 246px;
    --h-cible: 40px;
    --aiguillage: 40px;
    --tige: 12px;
  }

  .poste--cibles {
    --haut: 154px;
    top: var(--haut);
    left: 24px;
    width: 186px;
  }

  .poste--agent {
    top: calc(var(--axe) - var(--h-agent) / 2);
    left: 246px;
    width: 172px;
    height: var(--h-agent);
  }

  .poste--approcher,
  .poste--valider,
  .poste--ecartees {
    --sm-cols: 16px minmax(0, 1fr) auto;
    top: var(--haut);
    left: 556px;
    width: 180px;
  }

  .poste--approcher { --haut: 78px; }
  .poste--valider { --haut: 249px; }
  .poste--ecartees { --haut: 387px; }

  .port--cibles { top: calc(var(--axe) - var(--haut) - 5.5px); right: -6px; }
  .port--agent { top: calc(50% - 5.5px); left: -6px; }
  .port--approcher { top: 87px; left: -6px; }
  .port--valider { top: calc(var(--axe) - var(--haut) - 5.5px); left: -6px; }
  .port--ecarter { top: 71px; left: -6px; }

  /* Le départ des trois voies est au centre de l'aiguillage, qui le couvre :
     le port n'est là que pour que le moteur sache d'où tracer. */
  .port--tri {
    top: calc(50% - 5.5px);
    left: calc(100% + var(--tige) + var(--aiguillage) / 2 - 5.5px);
    opacity: 0;
  }

  /* ── Le visage d'une fiche ──
     Une silhouette dans un rond : sans un mot, on lit « une personne ». */
  .visage {
    --visage-fond: color-mix(in srgb, var(--color-ink) 13%, transparent);
    --visage-trait: color-mix(in srgb, var(--color-ink) 44%, transparent);
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background:
      radial-gradient(circle at 50% 37%, var(--visage-trait) 0 20%, transparent 22%),
      radial-gradient(64% 46% at 50% 106%, var(--visage-trait) 0 96%, transparent 100%),
      var(--visage-fond);
    transition: opacity 220ms;
  }

  /* ── Une cible, dans la liste ──
     Sur deux lignes : le nom en barre et sa note, puis ses étiquettes. Visée
     (`est-vise`), elle est cerclée de pêche le temps d'être lue ; traitée
     (`est-traite`), elle s'efface et garde sa note. */
  .cible {
    grid-template-columns: 20px minmax(0, 1fr) auto;
    align-content: center;
    column-gap: 8px;
    row-gap: 5px;
    height: var(--h-cible);
  }

  .cible .visage {
    grid-row: 1 / span 2;
  }

  .cible .sm-barre {
    grid-column: 2;
    transition:
      transform 360ms var(--ease-out-expo),
      opacity 220ms;
  }

  .cible__note {
    grid-column: 3;
    grid-row: 1;
    color: var(--color-ink-faint);
    font-size: 10.5px;
    font-weight: 650;
    line-height: 1;
    opacity: 0;
    transition: opacity 220ms;
  }

  .cible__tags {
    grid-column: 2 / span 2;
    grid-row: 2;
    display: flex;
    gap: 4px;
    transition: opacity 220ms;
  }

  .cible__tags em {
    height: 14px;
    padding: 0 5px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-mid);
    font-size: 9px;
    font-weight: 500;
    line-height: 12px;
    white-space: nowrap;
  }

  .cible.est-vise {
    border-color: var(--color-peche);
    background: color-mix(in srgb, var(--color-peche) 12%, transparent);
  }

  .cible.est-traite {
    border-color: color-mix(in srgb, var(--color-ink) 8%, transparent);
    background: transparent;
  }

  .cible.est-traite :is(.visage, .sm-barre, .cible__tags) {
    opacity: 0.4;
  }

  .cible.est-traite .cible__note {
    opacity: 1;
  }

  .cible:is([data-verdict='approcher'], [data-verdict='valider']) .cible__note {
    color: var(--color-peche);
  }

  /* ── L'agent ──
     Pas une fenêtre : pas de barre de titre, un cerne pêche et un halo, un
     coin plus rond. C'est le seul bloc de la scène qui agit. */
  .agent {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 9px;
    height: 100%;
    padding: 11px 11px 10px;
    border: 1px solid color-mix(in srgb, var(--color-peche) 46%, transparent);
    border-radius: 20px;
    background: color-mix(in srgb, var(--color-peche) 6%, var(--color-night-deep));
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--color-peche) 8%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-ink) 12%, transparent),
      0 30px 60px -28px var(--color-night-deep);
  }

  .agent__tete {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 28px;
    padding-left: 4px;
  }

  /* Le cœur : un disque pêche et son orbite. Le moteur fait tourner l'orbite
     tant que l'agent travaille ; au repos, son satellite reste en haut. */
  .coeur {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
  }

  .coeur svg {
    width: 15px;
    height: 15px;
    fill: var(--color-night);
    stroke: var(--color-night);
    stroke-width: 1;
  }

  .coeur__orbite {
    position: absolute;
    inset: -4px;
    border: 1px solid color-mix(in srgb, var(--color-peche) 36%, transparent);
    border-radius: var(--radius-full);
  }

  .coeur__orbite::after {
    content: '';
    position: absolute;
    top: -3px;
    left: calc(50% - 2.5px);
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-peche) 6%, var(--color-night-deep));
  }

  .agent__nom {
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  /* Le plan de travail : la fiche lue, sur la feuille claire, et les trois
     règles dessous. Vide (`est-vide`), il n'en reste que la trame. */
  .lecteur {
    --sm-cols: minmax(0, 1fr) auto 12px;
    padding: 10px 10px 5px;
    transition: opacity 260ms;
  }

  .fiche {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    height: 28px;
    transition: opacity 200ms;
  }

  .fiche .visage {
    --visage-fond: var(--color-feuille-trait);
    --visage-trait: var(--color-ink-faint);
    width: 22px;
    height: 22px;
  }

  .fiche__barres {
    display: grid;
    gap: 5px;
  }

  .fiche__barres .sm-barre {
    background: color-mix(in srgb, var(--color-night) 62%, transparent);
  }

  .fiche__barres .sm-barre + .sm-barre {
    width: 42%;
    background: var(--color-feuille-barre);
  }

  .regles {
    margin-top: 9px;
    padding: 0 6px 4px;
    border-bottom: 1px solid var(--color-feuille-trait);
    color: var(--color-ink-faint);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .critere__nom {
    color: color-mix(in srgb, var(--color-night) 62%, transparent);
  }

  .critere [data-c='valeur'] {
    font-weight: 600;
    transition: opacity 200ms;
  }

  /* Une règle qui ne passe pas est lue comme les autres, mais en gris : la
     pêche est réservée à ce qui est retenu. Le doute, lui, est rayé. */
  .critere[data-avis='non']::before {
    background: var(--color-feuille-trait);
  }

  .critere[data-avis='doute']::before {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-peche) 0 4px,
      color-mix(in srgb, var(--color-peche) 46%, var(--color-feuille)) 4px 8px
    );
  }

  .critere[data-avis='non'] [data-c='valeur'] {
    color: var(--color-ink-faint);
  }

  .avis {
    display: grid;
    place-items: center;
    width: 12px;
    height: 12px;
  }

  .avis svg {
    grid-area: 1 / 1;
    width: 12px;
    height: 12px;
    stroke: var(--color-night);
    stroke-width: 2;
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 180ms,
      scale 320ms var(--ease-out-expo);
  }

  .avis .avis__non {
    stroke: var(--color-ink-faint);
  }

  .critere:is(.est-lu, .est-parti)[data-avis='oui'] .avis__oui,
  .critere:is(.est-lu, .est-parti)[data-avis='non'] .avis__non,
  .critere:is(.est-lu, .est-parti)[data-avis='doute'] .avis__doute {
    opacity: 1;
    scale: 1;
  }

  /* Une règle remise à zéro l'est d'un coup : dans la rafale, la trace de la
     fiche précédente ne doit pas se retirer lentement sous la suivante. */
  .critere:not(.est-lu, .est-parti)::before {
    transition: none;
  }

  .lecteur.est-vide {
    opacity: 0.74;
  }

  .lecteur.est-vide .fiche {
    opacity: 0.3;
  }

  .lecteur.est-vide [data-c='valeur'] {
    opacity: 0;
  }

  /* La note : une jauge et le nombre, dans la couleur du verdict. */
  .note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    height: 24px;
    margin-top: auto;
    padding-left: 5px;
    border-radius: var(--radius-full);
    color: var(--color-ink-low);
    font-size: 10.5px;
    font-weight: 500;
  }

  .note__jauge {
    height: 4px;
    overflow: hidden;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .note__jauge i {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--color-ink-low);
    transform: scaleX(var(--n, 0));
    transform-origin: 0 50%;
    transition:
      transform 420ms var(--ease-out-expo),
      background-color 220ms;
  }

  .note__valeur {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 22px;
    padding-inline: 7px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-mid);
    font-size: 12px;
    font-weight: 650;
    line-height: 1;
    transition:
      background-color 220ms,
      color 220ms,
      border-color 220ms;
  }

  .note:is([data-verdict='approcher'], [data-verdict='valider']) .note__jauge i {
    background: var(--color-peche);
  }

  .note[data-verdict='approcher'] .note__valeur {
    border-color: var(--color-peche);
    background: var(--color-peche);
    color: var(--color-night);
  }

  .note[data-verdict='valider'] .note__valeur {
    border-style: dashed;
    border-color: var(--color-peche);
    color: var(--color-peche);
  }

  .note[data-verdict='ecarter'] .note__valeur {
    color: var(--color-ink-faint);
  }

  /* ── L'aiguillage ──
     Un disque à la sortie de l'agent, relié par une tige. Son aiguille montre
     la voie de la fiche qui part : en haut, tout droit, en bas. */
  .aiguillage {
    position: absolute;
    top: calc(50% - var(--aiguillage) / 2);
    left: calc(100% + var(--tige));
    z-index: 3;
    width: var(--aiguillage);
    height: var(--aiguillage);
    border: 1px solid color-mix(in srgb, var(--color-ink) 24%, transparent);
    border-radius: var(--radius-full);
    background: var(--color-night-deep);
    color: var(--color-ink-low);
    transition:
      border-color 300ms,
      background-color 300ms,
      color 300ms;
  }

  .aiguillage::before {
    content: '';
    position: absolute;
    top: calc(50% - 0.5px);
    right: 100%;
    width: var(--tige);
    height: 1px;
    background: color-mix(in srgb, var(--color-peche) 46%, transparent);
  }

  .aiguillage__aiguille {
    position: absolute;
    top: calc(50% - 1px);
    left: 50%;
    width: 36%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transform-origin: 0 50%;
    rotate: var(--angle, 0deg);
    transition: rotate 460ms var(--ease-out-expo);
  }

  /* La pointe de l'aiguille. */
  .aiguillage__aiguille::after {
    content: '';
    position: absolute;
    top: -3px;
    right: -1px;
    width: 8px;
    height: 8px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    border-radius: 1px;
    rotate: 45deg;
  }

  .aiguillage__pivot {
    position: absolute;
    top: calc(50% - 3px);
    left: calc(50% - 3px);
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .aiguillage:is([data-voie='approcher'], [data-voie='valider']) {
    border-color: var(--color-peche);
    background: color-mix(in srgb, var(--color-peche) 16%, var(--color-night-deep));
    color: var(--color-peche);
  }

  .aiguillage[data-voie='approcher'] { --angle: -44deg; }
  .aiguillage[data-voie='ecarter'] { --angle: 44deg; }

  /* ── Les places d'arrivée ──
     Une rangée du socle, avec un visage devant. Trois façons d'être remplie :
     en pêche (le socle), éteinte, ou en doute. */
  .case .visage {
    width: 16px;
    height: 16px;
    opacity: 0;
  }

  .case.est-rempli .visage {
    opacity: 1;
  }

  .case [data-c='note'] {
    font-weight: 650;
  }

  .case.est-peche .visage {
    --visage-fond: color-mix(in srgb, var(--color-night) 16%, transparent);
    --visage-trait: color-mix(in srgb, var(--color-night) 58%, transparent);
  }

  .case.est-eteint {
    background: transparent;
    color: var(--color-ink-faint);
  }

  .case.est-eteint :is(.visage, .sm-barre) {
    opacity: 0.45;
  }

  .case.est-doute {
    border-style: dashed;
    border-color: var(--color-peche);
    background: color-mix(in srgb, var(--color-peche) 11%, transparent);
    color: var(--color-peche);
  }

  /* ── À valider ──
     La fenêtre de l'humain : deux boutons que personne d'autre ne presse. Ils
     ne s'éclairent que lorsqu'une fiche attend (`est-saisi`). */
  .poste--valider .sm-fenetre {
    transition: border-color 320ms;
  }

  .poste--valider.est-saisi .sm-fenetre {
    border-color: color-mix(in srgb, var(--color-peche) 50%, transparent);
  }

  .etat__plein,
  .sm-etat[data-etat='cours'] .etat__vide {
    display: none;
  }

  .sm-etat[data-etat='cours'] .etat__plein {
    display: inline;
  }

  .choix {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: 7px;
    opacity: 0.38;
    transition: opacity 320ms;
  }

  .choix i {
    display: grid;
    place-items: center;
    height: 24px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink);
    font-size: 10px;
    font-weight: 600;
  }

  .est-saisi .choix {
    opacity: 1;
  }

  /* L'icône des écartées est éteinte, comme elles. */
  .poste--ecartees .sm-fenetre__icone {
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .poste--ecartees .sm-fenetre__icone svg {
    stroke: var(--color-ink-mid);
  }

  .poste--ecartees .sm-fenetre__nom {
    color: var(--color-ink-mid);
  }

  /* Ce qui part vers les écartées voyage en gris. */
  :is(.sm-bande, .sm-grain).est-eteint {
    background: color-mix(in srgb, var(--color-ink) 42%, var(--color-night-deep));
    box-shadow: none;
  }

  /* ── Le plan étroit ──
     Quatre fiches au lieu de six. Les cibles perdent leurs étiquettes et leur
     note, l'agent garde le nom de ses règles sans leur valeur, les fenêtres
     d'arrivée perdent leur compteur et la validation ses boutons. */
  @container sm (max-width: 519.98px) {
    .sm-plan {
      --axe: 176px;
      --h-agent: 150px;
      --h-cible: 21px;
      --aiguillage: 22px;
      --tige: 6px;
    }

    .poste--cibles {
      --haut: 113px;
      left: 10px;
      width: 68px;
    }

    .poste--agent {
      left: 94px;
      width: 102px;
    }

    .poste--approcher,
    .poste--valider,
    .poste--ecartees {
      --sm-cols: 11px minmax(0, 1fr) auto;
      left: 254px;
      width: 96px;
    }

    .poste--approcher { --haut: 37px; }
    .poste--valider { --haut: 132px; }
    .poste--ecartees { --haut: 201px; }

    .port--cibles { top: calc(var(--axe) - var(--haut) - 4.5px); right: -5px; }
    .port--agent { top: calc(50% - 4.5px); left: -5px; }
    .port--approcher { top: 52px; left: -5px; }
    .port--valider { top: calc(var(--axe) - var(--haut) - 4.5px); left: -5px; }
    .port--ecarter { top: 39px; left: -5px; }

    .port--tri {
      top: calc(50% - 4.5px);
      left: calc(100% + var(--tige) + var(--aiguillage) / 2 - 4.5px);
    }

    .visage,
    .case .visage {
      width: 11px;
      height: 11px;
    }

    .cible {
      grid-template-columns: 11px minmax(0, 1fr);
      column-gap: 5px;
    }

    .cible .visage {
      grid-row: 1;
    }

    .cible__note {
      display: none;
    }

    .agent {
      gap: 5px;
      padding: 6px 6px 6px;
      border-radius: 13px;
      box-shadow:
        0 0 0 3px color-mix(in srgb, var(--color-peche) 8%, transparent),
        inset 0 1px 0 color-mix(in srgb, var(--color-ink) 12%, transparent),
        0 18px 36px -20px var(--color-night-deep);
    }

    .agent__tete {
      gap: 5px;
      height: 20px;
      padding-left: 3px;
    }

    .agent__tete .sm-etat {
      padding-inline: 5px;
    }

    .coeur {
      width: 15px;
      height: 15px;
    }

    .coeur svg {
      width: 10px;
      height: 10px;
    }

    .coeur__orbite {
      inset: -3px;
    }

    .coeur__orbite::after {
      top: -2px;
      left: calc(50% - 1.5px);
      width: 3px;
      height: 3px;
      box-shadow: none;
    }

    .agent__nom {
      font-size: 10px;
    }

    /* La valeur lue ne tient plus : il reste le nom de la règle et sa coche. */
    .lecteur {
      --sm-cols: minmax(0, 1fr) 9px;
      padding: 5px 5px 2px;
    }

    .fiche {
      grid-template-columns: 12px minmax(0, 1fr);
      gap: 5px;
      height: 16px;
      margin-bottom: 2px;
      padding-inline: 3px;
    }

    .fiche .visage {
      width: 12px;
      height: 12px;
    }

    .critere {
      height: 22px;
    }

    .avis,
    .avis svg {
      width: 9px;
      height: 9px;
    }

    .note {
      gap: 5px;
      height: 18px;
      padding-left: 3px;
      font-size: 8.5px;
    }

    .note__jauge {
      height: 3px;
    }

    .note__valeur {
      min-width: 24px;
      height: 17px;
      padding-inline: 5px;
      font-size: 9.5px;
    }

    /* À cette taille, la pointe de l'aiguille ne serait qu'un pâté : il reste
       le pivot et son trait, comme une aiguille d'horloge. */
    .aiguillage__aiguille {
      top: calc(50% - 0.75px);
      width: 40%;
      height: 1.5px;
    }

    .aiguillage__aiguille::after {
      display: none;
    }

    .aiguillage__pivot {
      top: calc(50% - 2.5px);
      left: calc(50% - 2.5px);
      width: 5px;
      height: 5px;
    }
  }
</style>

<script>
  /*
   * La partition de la scène : ses états (repos, image fixe) et l'ordre de sa
   * boucle. Le temps, la pause hors écran, l'échelle et l'annulation sont dans
   * le moteur ; ici, aucune attente n'a besoin de vérifier qu'elle a encore
   * cours, une boucle remplacée se défait d'elle-même.
   */
  import { ELAN, EXPO, monterScenes } from '../../lib/metiers/scene';
  import type { Cadre, Pt } from '../../lib/metiers/scene';

  type Avis = 'oui' | 'non' | 'doute';
  type Verdict = 'approcher' | 'valider' | 'ecarter';

  interface Fiche {
    l: number;
    valeurs: string[];
    avis: Avis[];
    note: number;
    verdict: Verdict;
  }

  /* Un trajet par un fil : d'une zone à l'autre, à une allure donnée (1 pour
     l'allure du socle, moins pour aller plus vite). */
  interface Trajet {
    bande: HTMLElement;
    grain: HTMLElement;
    de: HTMLElement;
    vers: HTMLElement;
    fil: string;
    allure: number;
  }

  const AVIS: readonly string[] = ['oui', 'non', 'doute'];
  const VERDICTS: readonly string[] = ['approcher', 'valider', 'ecarter'];
  const NB_REGLES = 3;

  /* Les lots arrivent du balisage en JSON : c'est une frontière, on vérifie
     leur forme avant de s'en servir. */
  const estFiche = (valeur: unknown): valeur is Fiche => {
    if (typeof valeur !== 'object' || valeur === null) return false;
    const v = valeur as Record<string, unknown>;
    return (
      typeof v.l === 'number' &&
      typeof v.note === 'number' &&
      typeof v.verdict === 'string' &&
      VERDICTS.includes(v.verdict) &&
      Array.isArray(v.valeurs) &&
      v.valeurs.length === NB_REGLES &&
      v.valeurs.every((texte) => typeof texte === 'string') &&
      Array.isArray(v.avis) &&
      v.avis.length === NB_REGLES &&
      v.avis.every((avis) => typeof avis === 'string' && AVIS.includes(avis))
    );
  };

  const lireLots = (brut: string | undefined): Fiche[][] => {
    const lu: unknown = JSON.parse(brut ?? 'null');
    if (!Array.isArray(lu) || lu.length === 0 || !lu.every((lot) => Array.isArray(lot) && lot.every(estFiche))) {
      throw new Error('Scène Agents : `data-lots` est illisible');
    }
    return lu as Fiche[][];
  };

  /* Les deux ports de chaque fil, pour savoir où la bande se resserre et où
     elle se redéploie. */
  const PORTS: Record<string, { de: string; vers: string }> = {
    entree: { de: 'cibles', vers: 'agent' },
    approcher: { de: 'tri', vers: 'approcher' },
    valider: { de: 'tri', vers: 'valider' },
    ecarter: { de: 'tri', vers: 'ecarter' },
  };

  /* L'état de l'agent, en version longue et en version courte (plan étroit). */
  const ETATS = {
    veille: { valeur: 'attente', long: 'En veille', court: 'Veille' },
    lit: { valeur: 'cours', long: 'Lit…', court: 'Lit…' },
    note: { valeur: 'cours', long: 'Note…', court: 'Note…' },
    trie: { valeur: 'cours', long: 'Trie…', court: 'Trie…' },
    fini: { valeur: 'fait', long: 'Lot trié', court: 'Trié' },
  } as const;

  /* La bande, resserrée en tiret à l'entrée d'un port (même taille que celle
     du socle). */
  const tiret = (p: Pt): Cadre => ({ x: p.x - 8, y: p.y - 3, w: 16, h: 6 });
  const entier = (n: number) => String(Math.round(n));

  monterScenes('[data-scene-agents]', (s) => {
    const cibles = s.tous('[data-cible]');
    const lecteur = s.un('[data-lecteur]');
    const fiche = s.un('[data-fiche]');
    const balai = s.un('[data-balai]');
    const criteres = s.tous('[data-critere]');
    const note = s.un('[data-note]');
    const elNote = s.un('[data-note-valeur]');
    const orbite = s.un('[data-orbite]');
    const aiguillage = s.un('[data-aiguillage]');
    const etatAgent = s.un('[data-etat-de="agent"]');
    const posteValider = s.un('[data-poste-valider]');
    const elLues = s.un('[data-lues]');
    const elZero = s.un('[data-zero]');
    const etats = {
      approcher: s.un('[data-etat-de="approcher"]'),
      valider: s.un('[data-etat-de="valider"]'),
    };
    const comptes = {
      approcher: s.un('[data-compte="approcher"]'),
      ecarter: s.un('[data-compte="ecarter"]'),
    };
    const cases: Record<Verdict, HTMLElement[]> = {
      approcher: s.tous('[data-case="approcher"]'),
      valider: s.tous('[data-case="valider"]'),
      ecarter: s.tous('[data-case="ecarter"]'),
    };
    const toutesLesCases = [...cases.approcher, ...cases.valider, ...cases.ecarter];
    const bandes = { entree: s.tous('[data-bande="entree"]'), sortie: s.tous('[data-bande="sortie"]') };
    const grains = { entree: s.tous('[data-grain="entree"]'), sortie: s.tous('[data-grain="sortie"]') };
    const lots = lireLots(s.racine.dataset.lots);

    const champ = (el: HTMLElement, nom: string) => el.querySelector<HTMLElement>(`[data-c="${nom}"]`);
    const ecrireChamp = (el: HTMLElement, nom: string, texte: string) => {
      const cible = champ(el, nom);
      if (cible) cible.textContent = texte;
    };

    /* L'état de la scène. Le compteur part de ce que le balisage a rendu : il
       n'y a qu'un endroit où l'écrire. */
    let rang = 0;
    let lues = Number(elLues.textContent);
    let tourne: Animation | null = null;

    /* Les fiches du lot en cours qui ont une rangée affichée : six sur le
       grand plan, quatre sur l'étroit. Si rien n'est affiché (scène dans un
       bloc masqué), on prend tout plutôt que rien. */
    const visibles = (): HTMLElement[] => {
      const vues = s.affiches(cibles);
      return vues.length > 0 ? vues : cibles;
    };
    const lotCourant = (): Fiche[] => lots[rang % lots.length] ?? [];

    /* ── Les pièces, posées d'un coup ── */

    const direEtat = (nom: keyof typeof ETATS) => {
      const etat = ETATS[nom];
      etatAgent.dataset.etat = etat.valeur;
      ecrireChamp(etatAgent, 'etat-long', etat.long);
      ecrireChamp(etatAgent, 'etat-court', etat.court);
    };

    const noter = (valeur: number, verdict: Verdict | null) => {
      elNote.textContent = entier(valeur);
      note.style.setProperty('--n', String(valeur / 100));
      if (verdict) note.dataset.verdict = verdict;
      else delete note.dataset.verdict;
    };

    /* La liste retrouve un lot neuf : aucune fiche lue. */
    const charger = () => {
      lotCourant().forEach((f, i) => {
        const cible = cibles[i];
        if (!cible) return;
        cible.classList.remove('est-vise', 'est-traite');
        delete cible.dataset.verdict;
        cible.style.setProperty('--l', `${f.l}%`);
        ecrireChamp(cible, 'secteur', f.valeurs[0] ?? '');
        ecrireChamp(cible, 'taille', f.valeurs[1] ?? '');
        ecrireChamp(cible, 'note', entier(f.note));
      });
    };

    const marquer = (cible: HTMLElement, f: Fiche) => {
      cible.classList.remove('est-vise');
      cible.classList.add('est-traite');
      cible.dataset.verdict = f.verdict;
    };

    /* La fiche arrive sur le plan de travail : rien n'est encore lu. */
    const poser = (f: Fiche) => {
      lecteur.classList.remove('est-vide');
      champ(lecteur, 'nom')?.style.setProperty('--l', `${f.l}%`);
      criteres.forEach((critere, i) => {
        critere.classList.remove('est-lu', 'est-parti');
        critere.dataset.avis = f.avis[i] ?? 'non';
        ecrireChamp(critere, 'valeur', f.valeurs[i] ?? '');
      });
      noter(0, null);
    };

    const viderLecteur = () => {
      lecteur.classList.add('est-vide');
      criteres.forEach((critere) => critere.classList.remove('est-lu', 'est-parti'));
      noter(0, null);
      aiguillage.dataset.voie = 'repos';
    };

    const remplir = (place: HTMLElement, f: Fiche) => {
      place.style.setProperty('--l', `${f.l}%`);
      ecrireChamp(place, 'note', entier(f.note));
      place.classList.add('est-rempli');
      if (f.verdict === 'approcher') place.classList.add('est-peche');
      if (f.verdict === 'valider') place.classList.add('est-doute');
      if (f.verdict === 'ecarter') place.classList.add('est-eteint');
    };

    const ecrireComptes = (approcher: number, ecarter: number, valider: number) => {
      comptes.approcher.textContent = String(approcher);
      comptes.ecarter.textContent = String(ecarter);
      etats.approcher.dataset.etat = approcher > 0 ? 'fait' : 'attente';
      etats.valider.dataset.etat = valider > 0 ? 'cours' : 'attente';
      posteValider.classList.toggle('est-saisi', valider > 0);
    };

    const viderArrivees = () => {
      toutesLesCases.forEach((place) => place.classList.remove('est-rempli', 'est-peche', 'est-doute', 'est-eteint'));
      ecrireComptes(0, 0, 0);
    };

    const arreterOrbite = () => {
      tourne?.cancel();
      tourne = null;
    };

    /* Le repos : la liste est pleine, l'agent en veille, rien n'est rangé. */
    const repos = () => {
      arreterOrbite();
      s.racine.classList.remove('est-abouti');
      s.eteindre();
      charger();
      viderLecteur();
      viderArrivees();
      direEtat('veille');
      elLues.textContent = String(lues);
    };

    /* L'image fixe : le lot est trié. C'est aussi ce que le HTML rend sans
       script. */
    const figer = () => {
      arreterOrbite();
      charger();
      viderArrivees();
      const fiches = lotCourant().slice(0, visibles().length);
      const rangs: Record<Verdict, number> = { approcher: 0, valider: 0, ecarter: 0 };
      fiches.forEach((f, i) => {
        const cible = cibles[i];
        const place = cases[f.verdict][rangs[f.verdict]];
        rangs[f.verdict] += 1;
        if (cible) marquer(cible, f);
        if (place) remplir(place, f);
      });
      ecrireComptes(rangs.approcher, rangs.ecarter, rangs.valider);
      const derniere = fiches[fiches.length - 1];
      if (derniere) {
        poser(derniere);
        criteres.forEach((critere) => critere.classList.add('est-parti'));
        noter(derniere.note, derniere.verdict);
        aiguillage.dataset.voie = derniere.verdict;
      }
      direEtat('fini');
      s.racine.classList.add('est-abouti');
      s.eteindre();
      s.allumer('entree', true);
      if (rangs.approcher > 0) s.allumer('approcher', true);
      if (rangs.valider > 0) s.allumer('valider', true);
      elLues.textContent = String(lues);
    };

    /* ── Les gestes ── */

    /* Le passage d'une fiche par un fil : la bande se resserre dans le port
       de départ, un grain traverse, la bande se redéploie sur sa cible. C'est
       le `passer` du socle, à allure réglable : la rafale en a besoin. */
    const acheminer = async ({ bande, grain, de, vers, fil, allure }: Trajet) => {
      const ports = PORTS[fil];
      if (!ports) throw new Error(`Scène Agents : aucun fil « ${fil} »`);
      s.enMarge(
        s.voler(bande, de, tiret(s.lieu(s.port(ports.de))), {
          duree: 460 * allure,
          pose: 0.2,
          arrivee: 0.9,
          easing: ELAN,
          eclot: true,
        }),
      );
      await s.attendre(380 * allure);
      s.enMarge(s.courir(grain, fil, { duree: 520 * allure }));
      await s.attendre(450 * allure);
      s.enMarge(
        s.voler(bande, tiret(s.lieu(s.port(ports.vers))), vers, {
          duree: 680 * allure,
          pose: 0.06,
          arrivee: 0.64,
          easing: EXPO,
          eclot: true,
        }),
      );
      await s.attendre(400 * allure);
    };

    /* La fiche notée quitte l'agent par la voie de son verdict et se pose à
       sa place. Une écartée voyage en gris, et son fil reste éteint. */
    const sortir = async (i: number, f: Fiche, place: HTMLElement, allure: number, arrivees: Record<Verdict, number>) => {
      const bande = bandes.sortie[i];
      const grain = grains.sortie[i];
      if (!bande || !grain) return;
      const eteint = f.verdict === 'ecarter';
      bande.classList.toggle('est-eteint', eteint);
      grain.classList.toggle('est-eteint', eteint);
      if (!eteint) s.allumer(f.verdict);
      s.jouer(aiguillage, [{ scale: 1 }, { scale: 1.16, offset: 0.4 }, { scale: 1 }], { duration: 360 * Math.max(allure, 0.6), easing: 'ease-out' });
      await acheminer({ bande, grain, de: note, vers: place, fil: f.verdict, allure });
      if (!eteint) s.port(f.verdict).classList.add('est-actif');
      remplir(place, f);
      arrivees[f.verdict] += 1;
      ecrireComptes(arrivees.approcher, arrivees.ecarter, arrivees.valider);
      if (f.verdict === 'approcher') s.basculer(etats.approcher);
      if (f.verdict === 'valider') s.basculer(etats.valider, 'cours');
    };

    async function tour() {
      const rangees = visibles();
      const fiches = lotCourant().slice(0, rangees.length);
      /* Les places déjà promises, et celles où une fiche est arrivée. */
      const promises: Record<Verdict, number> = { approcher: 0, valider: 0, ecarter: 0 };
      const arrivees: Record<Verdict, number> = { approcher: 0, valider: 0, ecarter: 0 };
      const sorties: Promise<void>[] = [];
      const zoneLecture = s.affiches([fiche])[0] ?? lecteur;

      await s.attendre(420);

      /* L'agent se met au travail : son orbite tourne jusqu'à la fin du lot. */
      direEtat('lit');
      s.basculer(etatAgent, 'cours');
      tourne = s.jouer(orbite, { rotate: ['0deg', '360deg'] }, { duration: 2400, iterations: Infinity, easing: 'linear' });
      s.allumer('entree');

      for (let i = 0; i < fiches.length; i++) {
        const f = fiches[i];
        const cible = rangees[i];
        const bande = bandes.entree[i];
        const grain = grains.entree[i];
        const place = f ? cases[f.verdict][promises[f.verdict]] : undefined;
        if (!f || !cible || !bande || !grain || !place) continue;
        promises[f.verdict] += 1;
        /* La première fiche lentement, pour qu'on comprenne ; les suivantes
           en rafale. */
        const rafale = i > 0;
        const allure = rafale ? 0.33 : 0.78;

        /* 1. La fiche quitte la liste et entre chez l'agent. */
        cible.classList.add('est-vise');
        if (!rafale) await s.attendre(260);
        await acheminer({ bande, grain, de: cible, vers: zoneLecture, fil: 'entree', allure });
        s.port('agent').classList.add('est-actif');
        poser(f);
        if (!rafale) await s.attendre(180);

        /* 2. La lecture : le trait descend la fiche, chaque règle se coche
           (ou non) quand il la traverse. */
        if (rafale) direEtat('lit');
        await s.lire(balai, criteres, rafale ? 210 : 860);

        /* 3. La note, puis le tri : l'aiguille prend la voie du verdict. */
        if (rafale) {
          noter(f.note, f.verdict);
          s.tictac(elNote, entier(f.note));
        } else {
          await s.attendre(140);
          direEtat('note');
          note.dataset.verdict = f.verdict;
          note.style.setProperty('--n', String(f.note / 100));
          await s.compter(elNote, 0, f.note, { format: entier });
          await s.attendre(220);
          direEtat('trie');
        }
        aiguillage.dataset.voie = f.verdict;
        if (!rafale) await s.attendre(340);

        marquer(cible, f);
        lues += 1;
        s.tictac(elLues, String(lues));
        criteres.forEach((critere) => {
          if (critere.classList.replace('est-lu', 'est-parti')) return;
          critere.classList.add('est-parti');
        });

        /* 4. Le départ. La première fiche est suivie jusqu'au bout ; dans la
           rafale, la suivante entre pendant que celle-ci arrive. */
        const sortie = sortir(i, f, place, allure, arrivees);
        if (rafale) {
          s.enMarge(sortie);
          sorties.push(sortie);
          await s.attendre(60);
        } else {
          await sortie;
          await s.attendre(300);
        }
      }
      await Promise.all(sorties);

      /* Le lot est trié : personne n'a rien trié à la main, et une fiche
         attend quelqu'un. */
      arreterOrbite();
      direEtat('fini');
      s.basculer(etatAgent);
      s.racine.classList.add('est-abouti');
      s.tictac(elZero, '0');
      const enAttente = cases.valider[0];
      if (enAttente && arrivees.valider > 0) {
        s.jouer(
          enAttente,
          [
            { boxShadow: '0 0 0 0 color-mix(in srgb, var(--color-peche) 50%, transparent)' },
            { boxShadow: '0 0 0 9px color-mix(in srgb, var(--color-peche) 0%, transparent)' },
          ],
          { duration: 1100, iterations: 2, delay: 300, easing: 'ease-out' },
        );
      }

      /* Le temps de lire l'image. */
      await s.attendre(2600);

      /* 5. On range : les arrivées se vident, l'agent retourne en veille, et
         la liste laisse la place au lot suivant. */
      s.racine.classList.remove('est-abouti');
      s.eteindre();
      viderArrivees();
      viderLecteur();
      direEtat('veille');
      await Promise.all(
        rangees.map((cible) =>
          s.animer(cible, [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateX(-10px)' }], {
            duration: 220,
            easing: ELAN,
          }),
        ),
      );

      /* Le raccord, invisible : au moment où les anciennes fiches ont fini de
         sortir, les nouvelles sont chargées et entrent une à une. Quand la
         dernière est en place, la scène est exactement à son repos. */
      rang += 1;
      charger();
      await Promise.all(
        rangees.map((cible, i) =>
          s.animer(cible, [{ opacity: 0, transform: 'translateY(-8px)' }, { opacity: 1, transform: 'none' }], {
            duration: 340,
            delay: i * 55,
            easing: EXPO,
            fill: 'backwards',
          }),
        ),
      );
    }

    return { figer, repos, tour };
  });
</script>
