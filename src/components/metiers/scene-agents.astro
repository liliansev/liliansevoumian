---
/*
 * scene-agents — la scène du métier Agents IA : « Un agent qui va chercher la
 * réponse à votre place. »
 *
 * Son propos est l'INTELLIGENCE : on pose une question en langage naturel, et
 * l'agent décide lui-même où aller chercher la réponse. Le cas est celui d'un
 * cabinet de recrutement qui veut savoir quelles entreprises approcher.
 *
 * Sa composition est une ÉTOILE, pour qu'on la distingue d'un coup d'œil des
 * autres scènes de la page (des fenêtres en rang, reliées par un fil) : l'agent
 * est un disque au centre, la question arrive par le haut, les sources sont
 * posées autour, la réponse se compose en bas. Rien ne traverse la scène de
 * gauche à droite : tout part du centre et y revient.
 *
 * Le fil de la boucle, un seul mouvement à la fois :
 *   1. la question se tape et descend jusqu'à l'agent, qui s'éveille ;
 *   2. pour chaque étape de son raisonnement, il envoie une sonde vers une
 *      source, la source est parcourue, et un extrait revient au centre ;
 *   3. une dernière étape se fait sans sortir : il écarte ce qui est déjà
 *      suivi ;
 *   4. la réponse se compose, résultat par résultat, chacun avec la pastille
 *      de sa source, et une ligne reste à valider par un humain ;
 *   5. l'image est tenue, puis tout est rangé et une autre question arrive.
 *
 * D'une boucle à l'autre la question change, et l'ordre des sources avec
 * elle : c'est l'agent qui choisit par où commencer.
 *
 * Le panneau, les fenêtres, les fils, les rangées et les gestes viennent du
 * socle (`scene-metier.css` et `lib/metiers/scene.ts`). Ce composant n'écrit
 * que ce qui lui est propre : sa question, son agent, ses tuiles de source,
 * son fil de pensée, et les allers-retours le long d'un fil.
 *
 * Sans script ou en mouvement réduit, la scène est une image fixe : la
 * question posée, les trois sources consultées, la réponse composée.
 *
 * Questions, étapes et nombres sont inventés pour la scène : ce n'est pas une
 * donnée client. Un résultat n'a jamais de nom, seulement une barre dont `l`
 * donne la longueur, en pour cent.
 */
import './scene-metier.css';

type IdSource = 'web' | 'documents' | 'crm';

interface Source {
  id: IdSource;
  nom: string;
  court: string;
  /* Le tracé de son icône, dans une boîte de 16. */
  trace: string;
}

interface Etape {
  texte: string;
  court: string;
  /* La source où l'agent va chercher ; `null` quand il réfléchit sur place. */
  source: IdSource | null;
  /* Ce que la source a rendu (« 8 résultats »), et combien cela fait. */
  releve: string;
  nombre: number;
}

interface Resultat {
  l: number;
  raison: string;
}

interface Demande {
  question: string;
  courte: string;
  etapes: Etape[];
  /* Trois résultats, dans l'ordre des sources : chacun porte la pastille de
     celle qui l'a fourni. */
  resultats: Resultat[];
}

const sources: Source[] = [
  {
    id: 'web',
    nom: 'Web',
    court: 'Web',
    trace:
      'M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2zM2.2 8h11.6M8 2c1.8 1.7 2.6 3.7 2.6 6s-.8 4.3-2.6 6c-1.8-1.7-2.6-3.7-2.6-6S6.2 3.7 8 2z',
  },
  {
    id: 'documents',
    nom: 'Documents',
    court: 'Docs',
    trace: 'M4.5 2.5h4.6l2.4 2.4v8.6h-7zM9 2.6V5h2.4M6.3 8h3.4M6.3 10.3h3.4',
  },
  {
    id: 'crm',
    nom: 'CRM',
    court: 'CRM',
    trace:
      'M3 4.4c0-1 2.2-1.9 5-1.9s5 .9 5 1.9-2.2 1.9-5 1.9-5-.9-5-1.9zM3 4.4v7.2c0 1 2.2 1.9 5 1.9s5-.9 5-1.9V4.4M3 8c0 1 2.2 1.9 5 1.9s5-.9 5-1.9',
  },
];

/* Trois demandes qui tournent. Chacune a quatre étapes : trois sorties, une
   par source et dans un ordre qui lui est propre, puis une étape faite sur
   place. La première est rendue ici ; le script reçoit les trois. */
const demandes: Demande[] = [
  {
    question: 'Quelles entreprises approcher cette semaine ?',
    courte: 'Qui approcher cette semaine ?',
    etapes: [
      { texte: 'Cherche les levées de fonds récentes', court: 'Cherche les levées', source: 'web', releve: '8 résultats', nombre: 8 },
      { texte: 'Lit 12 pages', court: 'Lit 12 pages', source: 'documents', releve: '12 pages', nombre: 12 },
      { texte: 'Recoupe avec le CRM', court: 'Recoupe avec le CRM', source: 'crm', releve: '3 fiches', nombre: 3 },
      { texte: 'Écarte 2 clients déjà suivis', court: 'Écarte 2 clients', source: null, releve: '', nombre: 0 },
    ],
    resultats: [
      { l: 74, raison: 'Levée récente' },
      { l: 56, raison: 'Recrute' },
      { l: 66, raison: 'Jamais contactée' },
    ],
  },
  {
    question: 'Qui recrute un directeur technique ?',
    courte: 'Qui recrute un directeur ?',
    etapes: [
      { texte: 'Relit vos échanges dans le CRM', court: 'Relit le CRM', source: 'crm', releve: '5 fiches', nombre: 5 },
      { texte: 'Cherche les postes ouverts', court: 'Cherche les postes', source: 'web', releve: '9 résultats', nombre: 9 },
      { texte: 'Lit 7 pages', court: 'Lit 7 pages', source: 'documents', releve: '7 pages', nombre: 7 },
      { texte: 'Écarte 1 poste déjà pourvu', court: 'Écarte 1 poste', source: null, releve: '', nombre: 0 },
    ],
    resultats: [
      { l: 60, raison: 'Poste ouvert' },
      { l: 78, raison: 'Équipe doublée' },
      { l: 52, raison: 'Ancien contact' },
    ],
  },
  {
    question: 'Quels dirigeants ont changé de poste ?',
    courte: 'Qui a changé de poste ?',
    etapes: [
      { texte: 'Relit vos notes d’appel', court: 'Relit vos notes', source: 'documents', releve: '6 pages', nombre: 6 },
      { texte: 'Cherche les nominations récentes', court: 'Cherche les nominations', source: 'web', releve: '11 résultats', nombre: 11 },
      { texte: 'Recoupe avec le CRM', court: 'Recoupe avec le CRM', source: 'crm', releve: '4 fiches', nombre: 4 },
      { texte: 'Écarte 3 doublons', court: 'Écarte 3 doublons', source: null, releve: '', nombre: 0 },
    ],
    resultats: [
      { l: 68, raison: 'Nouveau poste' },
      { l: 50, raison: 'Dans vos notes' },
      { l: 80, raison: 'Déjà en contact' },
    ],
  },
];

const demande = demandes[0];
const releveDe = (id: IdSource) => demande.etapes.find((etape) => etape.source === id)?.releve ?? '';
/* Le compteur « Sources consultées » au chargement : ce que les trois sources
   de la première demande ont rendu. */
const CONSULTEES = demande.etapes.reduce((somme, etape) => somme + etape.nombre, 0);
---

<div
  class="sm est-abouti"
  data-scene-agents
  data-demandes={JSON.stringify(demandes)}
  role="img"
  aria-label="L'équipe pose une question en langage naturel. Un agent décide où chercher : il interroge le web, les documents et le CRM, en ramène des extraits, puis compose une réponse en trois résultats, chacun avec sa source, qu'un humain valide."
>
  <div class="sm-plan" aria-hidden="true">
    <div class="sm-puces">
      <span class="sm-puce">
        <svg viewBox="0 0 16 16"><path d="M7 2.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zM10.4 10.4l3.1 3.1" /></svg>
        <span class="sm-puce__nom"><span class="sm-large">Sources consultées</span><span class="sm-etroit">Sources</span></span>
        <b data-consultees>{CONSULTEES}</b>
      </span>
      <span class="sm-puce sm-puce--peche">
        <svg viewBox="0 0 16 16"><path d="M4 2.6l8.6 4.9-3.7 1.1-1.3 3.8z" /></svg>
        <span class="sm-puce__nom"><span class="sm-large">Recherches à la main</span><span class="sm-etroit">À la main</span></span>
        <b data-zero>0</b>
      </span>
    </div>

    {/* Cinq fils, tous noués au centre : la question qui descend, une branche
       par source, la réponse qui part vers le bas. Le moteur trace de gauche
       à droite et de haut en bas ; le fil du web va donc de sa tuile vers
       l'agent, et la sonde le remonte à l'envers. */}
    <svg class="sm-fils" viewBox="0 0 760 570">
      <g class="sm-fil est-allume" data-sm-fil="question" data-de="question" data-vers="coeur" data-sens="v">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
      <g class="sm-fil est-allume" data-sm-fil="web" data-de="web" data-vers="coeur" data-sens="h">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
      <g class="sm-fil est-allume" data-sm-fil="documents" data-de="coeur" data-vers="documents" data-sens="h">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
      <g class="sm-fil est-allume" data-sm-fil="crm" data-de="coeur" data-vers="crm" data-sens="h">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
      <g class="sm-fil est-allume" data-sm-fil="reponse" data-de="coeur" data-vers="reponse" data-sens="v">
        <path class="sm-fil__trait"></path>
        <path class="sm-fil__flux"></path>
      </g>
    </svg>

    {/* La question de l'équipe : un champ, pas une bulle. */}
    <div class="sm-poste poste--question">
      <div class="question est-envoyee" data-question>
        <i class="question__qui">
          <svg viewBox="0 0 16 16"><path d="M6 7.2a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4zM2.2 13c0-2.2 1.7-3.6 3.8-3.6S9.8 10.8 9.8 13M10.6 3.1a2.2 2.2 0 0 1 0 4M11.6 9.6c1.4.4 2.3 1.6 2.3 3.4" /></svg>
        </i>
        <span class="question__texte" data-question-texte>
          <span class="question__invite">Posez une question…</span>
          <span class="sm-large" data-c="question">{demande.question}</span>
          <span class="sm-etroit" data-c="courte">{demande.courte}</span>
          <i class="question__curseur"></i>
        </span>
        <i class="question__envoi">
          <svg viewBox="0 0 16 16"><path d="M8 12.5v-9M4.5 7L8 3.5 11.5 7" /></svg>
        </i>
      </div>
      <span class="sm-port port--question est-actif" data-sm-port="question"></span>
    </div>

    {/* L'agent : un disque, son orbite, et les extraits qu'il tient. */}
    <div class="sm-poste poste--agent">
      <div class="coeur" data-coeur data-etat="actif">
        <i class="coeur__orbite" data-orbite>
          <i class="satellite" data-satellite></i>
          <i class="satellite" data-satellite></i>
          <i class="satellite" data-satellite></i>
        </i>
        <span class="coeur__disque" data-disque>
          <svg viewBox="0 0 16 16"><path d="M8 2.4l1.4 4.2 4.2 1.4-4.2 1.4L8 13.6 6.6 9.4 2.4 8l4.2-1.4z" /></svg>
          <b class="sm-large">Agent</b>
        </span>
      </div>
      <span class="sm-port port--coeur" data-sm-port="coeur"></span>
    </div>

    {/* Son fil de pensée : les étapes qu'il se donne, une à une. */}
    <div class="pensee" data-pensee>
      <div class="pensee__titre"><span class="sm-large">Raisonnement</span><span class="sm-etroit">Agent</span></div>
      <div class="pensee__etapes">
        {demande.etapes.map((etape) => (
          <div class="etape est-fait" data-etape>
            <i class="etape__marque">
              <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
            </i>
            <span class="sm-large" data-c="texte">{etape.texte}</span>
            <span class="sm-etroit" data-c="court">{etape.court}</span>
          </div>
        ))}
      </div>
    </div>

    {/* Les sources, autour de lui. */}
    {sources.map((source) => (
      <div class:list={['sm-poste', 'source', `source--${source.id}`, 'est-consultee']} data-source={source.id}>
        <div class="sm-fenetre tuile">
          <div class="tuile__tete">
            <span class="sm-fenetre__icone"><svg viewBox="0 0 16 16"><path d={source.trace} /></svg></span>
            <span class="tuile__nom"><span class="sm-large">{source.nom}</span><span class="sm-etroit">{source.court}</span></span>
            <svg class="tuile__coche" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
          </div>
          <div class="tuile__corps">
            <i class="sm-barre tuile__ligne sm-large"></i>
            <i class="sm-barre tuile__ligne tuile__extrait" data-extrait></i>
            <span class="tuile__releve sm-large" data-c="releve">{releveDe(source.id)}</span>
            <i class="tuile__balayage" data-balayage></i>
          </div>
        </div>
        <span class:list={['sm-port', 'port--source', 'est-actif']} data-sm-port={source.id}></span>
      </div>
    ))}

    {/* La réponse : trois résultats sourcés, et la main laissée à l'humain. */}
    <div class="sm-poste poste--reponse">
      <div class="sm-fenetre">
        <div class="sm-fenetre__barre">
          <span class="sm-fenetre__icone">
            <svg viewBox="0 0 16 16"><path d="M3 4h10M3 8h10M3 12h6" /></svg>
          </span>
          <span class="sm-fenetre__nom">Réponse</span>
          <span class="sm-etat" data-etat="fait" data-etat-de="reponse">
            <span class="sm-etat__avant">En attente</span>
            <span class="sm-etat__apres">3 résultats</span>
          </span>
        </div>
        <div class="sm-corps">
          <div class="sm-rangees">
            {demande.resultats.map((resultat, index) => (
              <div class="sm-rangee resultat est-rempli" data-resultat style={`--l: ${resultat.l}%`}>
                <i class="resultat__logo"></i>
                <i class="sm-barre"></i>
                <span class="resultat__raison" data-c="raison">{resultat.raison}</span>
                <i class="pastille"><svg viewBox="0 0 16 16"><path d={sources[index]?.trace} /></svg></i>
              </div>
            ))}
          </div>
          <div class="validation est-attendue" data-validation>
            <svg viewBox="0 0 16 16"><path d="M8 7.4a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8zM3.4 13.4c0-2.5 2-4 4.6-4s4.6 1.5 4.6 4" /></svg>
            <span>À valider par vous</span>
            <i class="validation__bouton">Valider</i>
          </div>
        </div>
      </div>
      <span class="sm-port port--reponse est-actif" data-sm-port="reponse"></span>
    </div>

    {/* Ce qui voyage. Une sonde (un grain creux) part de l'agent ; une bande
       quitte la ligne trouvée dans la source ; un extrait (une petite carte)
       revient au centre. Puis, par résultat, un grain et une bande descendent
       vers la réponse. */}
    <span class="sm-grain" data-grain="question"></span>
    <span class="sm-grain sonde" data-sonde></span>
    <span class="sm-bande" data-bande="extrait"></span>
    <span class="extrait" data-carte><i></i><i></i></span>
    {demande.resultats.map(() => (
      <>
        <span class="sm-grain" data-grain="reponse"></span>
        <span class="sm-bande" data-bande="reponse"></span>
      </>
    ))}
  </div>
</div>

<style>
  /* Ce que le socle ne sait pas : la place de chaque pièce autour du centre,
     le champ de la question, le disque de l'agent, son fil de pensée, les
     tuiles de source et la carte de réponse. Longueurs en pixels du plan.

     Tout se rapporte au centre de l'agent (`--cx`, `--cy`) : c'est le moyeu
     de l'étoile, là où les cinq fils se nouent. */
  [data-scene-agents] {
    --sm-lumiere: 50% 46%;
  }

  .sm-plan {
    --cx: 380px;
    --cy: 212px;
    --coeur: 86px;
    --orbite: 14px;
  }

  .poste--question {
    top: 60px;
    left: 178px;
    width: 404px;
  }

  .poste--agent {
    top: calc(var(--cy) - var(--coeur) / 2);
    left: calc(var(--cx) - var(--coeur) / 2);
    width: var(--coeur);
    height: var(--coeur);
  }

  .source {
    width: 164px;
  }

  .source--web { top: 124px; left: 24px; }
  .source--documents { top: 124px; left: 572px; }
  .source--crm { top: 258px; left: 572px; }

  .pensee {
    top: 250px;
    left: 30px;
    width: 270px;
  }

  .poste--reponse {
    --sm-cols: 16px minmax(0, 1fr) auto 18px;
    top: 368px;
    left: 182px;
    width: 396px;
  }

  .port--question { bottom: -6px; left: calc(50% - 5.5px); }
  .port--reponse { top: -6px; left: calc(50% - 5.5px); }
  .port--source { top: calc(50% - 5.5px); left: -6px; }
  .source--web .port--source { right: -6px; left: auto; }

  /* Le moyeu : le disque le couvre, il n'est là que pour que le moteur sache
     où nouer les fils. */
  .port--coeur {
    top: calc(50% - 5.5px);
    left: calc(50% - 5.5px);
    opacity: 0;
  }

  /* ── La question ──
     Un champ de saisie arrondi : qui demande, ce qui est demandé, et le
     bouton d'envoi qui passe en pêche quand la question est partie. */
  .question {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 7px 0 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-night-deep) 90%, var(--color-ink));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-ink) 12%, transparent),
      0 18px 36px -22px var(--color-night-deep);
    transition: border-color 300ms;
  }

  .question__qui,
  .question__envoi {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-full);
  }

  .question__qui {
    background: color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .question__qui svg {
    width: 14px;
    height: 14px;
    stroke: var(--color-ink-mid);
    stroke-width: 1.4;
  }

  .question__texte {
    display: flex;
    align-items: center;
    min-width: 0;
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }

  .question__invite {
    display: none;
    color: var(--color-ink-faint);
    font-weight: 400;
  }

  /* Le curseur n'existe que pendant la frappe. */
  .question__curseur {
    display: none;
    width: 1.5px;
    height: 16px;
    margin-left: 1px;
    background: var(--color-peche);
  }

  .question.est-en-frappe .question__curseur {
    display: block;
  }

  .question.est-vide .question__invite {
    display: inline;
  }

  .question.est-vide [data-c] {
    display: none;
  }

  .question__envoi {
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    transition:
      background-color 260ms,
      border-color 260ms;
  }

  .question__envoi svg {
    width: 13px;
    height: 13px;
    stroke: var(--color-ink-low);
    stroke-width: 1.7;
    transition: stroke 260ms;
  }

  .question.est-envoyee {
    border-color: color-mix(in srgb, var(--color-peche) 46%, transparent);
  }

  .question.est-envoyee .question__envoi {
    border-color: var(--color-peche);
    background: var(--color-peche);
  }

  .question.est-envoyee .question__envoi svg {
    stroke: var(--color-night);
  }

  /* ── L'agent ──
     Un disque et son orbite, pas une fenêtre. En veille, il est creux ; au
     travail, il se remplit de pêche et son orbite tourne. Les extraits qu'il
     a ramenés sont des satellites sur cette orbite, jusqu'à ce qu'il en fasse
     une réponse. */
  .coeur {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .coeur__disque {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 3px;
    border: 1px solid color-mix(in srgb, var(--color-peche) 52%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-peche) 7%, var(--color-night-deep));
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-peche) 0%, transparent);
    color: var(--color-peche);
    transition:
      background-color 360ms,
      color 360ms,
      box-shadow 520ms var(--ease-out-quint);
  }

  .coeur__disque svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1;
  }

  .coeur__disque b {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1;
  }

  /* Tout texte posé sur la pêche est en nuit. */
  .coeur[data-etat='actif'] .coeur__disque {
    background: var(--color-peche);
    box-shadow:
      0 0 0 7px color-mix(in srgb, var(--color-peche) 13%, transparent),
      0 0 46px 6px color-mix(in srgb, var(--color-peche) 30%, transparent);
    color: var(--color-night);
  }

  .coeur__orbite {
    position: absolute;
    inset: calc(var(--orbite) * -1);
    border: 1px dashed color-mix(in srgb, var(--color-peche) 34%, transparent);
    border-radius: var(--radius-full);
    transition: border-color 360ms;
  }

  .coeur[data-etat='actif'] .coeur__orbite {
    border-color: color-mix(in srgb, var(--color-peche) 62%, transparent);
  }

  /* Trois places sur l'orbite, à égale distance. `--tour` tourne la place
     autour du centre ; le satellite est posé en haut du cercle. */
  .satellite {
    --taille: 11px;
    position: absolute;
    top: calc(var(--taille) / -2);
    left: calc(50% - var(--taille) / 2);
    width: var(--taille);
    height: var(--taille);
    border: 2px solid var(--color-night-deep);
    border-radius: var(--radius-full);
    background: var(--color-peche);
    transform-origin: 50% calc(var(--taille) / 2 + var(--coeur) / 2 + var(--orbite));
    rotate: var(--tour);
    scale: 0;
    transition: scale 420ms var(--ease-out-expo);
  }

  .satellite:nth-child(1) { --tour: 40deg; }
  .satellite:nth-child(2) { --tour: 160deg; }
  .satellite:nth-child(3) { --tour: 280deg; }

  .satellite.est-la {
    scale: 1;
  }

  /* ── Le fil de pensée ──
     Du texte libre à côté de l'agent, sans cadre : ce n'est pas un outil,
     c'est ce qu'il se dit. Une étape apparaît quand il s'y met (`est-en-
     cours`), et garde sa coche quand elle est faite (`est-fait`). */
  .pensee {
    position: absolute;
    z-index: 2;
  }

  .pensee__titre {
    margin-bottom: 7px;
    color: var(--color-ink-faint);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: opacity 260ms;
  }

  /* Tant qu'il n'a rien entrepris, le titre n'a rien à annoncer. */
  .pensee:not(:has(.etape:is(.est-en-cours, .est-fait))) .pensee__titre {
    opacity: 0;
  }

  .pensee__etapes {
    display: grid;
    gap: 6px;
  }

  .etape {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-ink);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 16px;
    white-space: nowrap;
    opacity: 0;
    transition:
      opacity 260ms,
      color 320ms;
  }

  .etape__marque {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--color-peche);
    border-radius: var(--radius-full);
    transition:
      background-color 260ms,
      border-color 260ms;
  }

  .etape__marque svg {
    width: 9px;
    height: 9px;
    stroke: var(--color-night);
    stroke-width: 2.4;
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 180ms,
      scale 320ms var(--ease-out-expo);
  }

  /* Le fil, justement : un trait relie chaque étape à la précédente. */
  .etape + .etape .etape__marque::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 2.5px);
    left: calc(50% - 0.5px);
    width: 1px;
    height: 6px;
    background: color-mix(in srgb, var(--color-peche) 55%, transparent);
  }

  .etape.est-en-cours,
  .etape.est-fait {
    opacity: 1;
  }

  .etape.est-fait {
    color: var(--color-ink-mid);
  }

  .etape.est-fait .etape__marque {
    background: var(--color-peche);
  }

  .etape.est-fait .etape__marque svg {
    opacity: 1;
    scale: 1;
  }

  /* ── Une source ──
     Une petite fenêtre du socle, sans barre : son icône, son nom, deux lignes
     de contenu. Sondée (`est-sondee`), elle s'éclaire et un trait la balaie ;
     consultée (`est-consultee`), sa ligne trouvée reste surlignée, son relevé
     s'affiche et sa coche se dessine. */
  .tuile {
    padding: 9px 10px 10px;
    transition:
      border-color 300ms,
      background-color 300ms;
  }

  .tuile__tete {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 18px;
  }

  .tuile .sm-fenetre__icone {
    background: color-mix(in srgb, var(--color-ink) 14%, transparent);
    transition: background-color 300ms;
  }

  .tuile .sm-fenetre__icone svg {
    stroke: var(--color-ink-mid);
    transition: stroke 300ms;
  }

  .tuile__nom {
    color: var(--color-ink);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .tuile__coche {
    width: 12px;
    height: 12px;
    margin-left: auto;
    stroke: var(--color-peche);
    stroke-width: 2;
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 200ms,
      scale 320ms var(--ease-out-expo);
  }

  .tuile__corps {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 8px;
    row-gap: 7px;
    margin-top: 10px;
  }

  .tuile__ligne {
    grid-column: 1 / -1;
    width: 78%;
    background: color-mix(in srgb, var(--color-ink) 16%, transparent);
    transition: background-color 260ms;
  }

  .tuile__extrait {
    grid-column: 1;
    width: 100%;
  }

  .tuile__releve {
    color: var(--color-ink-low);
    font-size: 9.5px;
    font-weight: 500;
    line-height: 12px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 220ms;
  }

  /* Le trait qui parcourt la source, de gauche à droite. */
  .tuile__balayage {
    position: absolute;
    top: -5px;
    bottom: -5px;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background: var(--color-peche);
    box-shadow: 0 0 10px 1px color-mix(in srgb, var(--color-peche) 70%, transparent);
    opacity: 0;
  }

  .source:is(.est-sondee, .est-consultee) .tuile {
    border-color: color-mix(in srgb, var(--color-peche) 56%, transparent);
  }

  .source.est-sondee .tuile {
    background: color-mix(in srgb, var(--color-peche) 9%, var(--color-night-deep));
  }

  .source:is(.est-sondee, .est-consultee) .sm-fenetre__icone {
    background: var(--color-peche);
  }

  .source:is(.est-sondee, .est-consultee) .sm-fenetre__icone svg {
    stroke: var(--color-night);
  }

  .source.est-consultee .tuile__extrait {
    background: var(--color-peche);
  }

  .source.est-consultee .tuile__releve {
    opacity: 1;
  }

  .source.est-consultee .tuile__coche {
    opacity: 1;
    scale: 1;
  }

  /* ── La réponse ──
     Une rangée du socle par résultat : un logo sans marque, le nom en barre,
     la raison de l'approcher, et la pastille de la source qui l'a donnée. */
  .resultat__logo {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--color-ink) 22%, transparent);
    opacity: 0;
    transition: opacity 220ms;
  }

  .resultat__raison {
    padding: 2px 8px;
    border: 1px solid color-mix(in srgb, var(--color-peche) 55%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-peche);
    font-size: 10.5px;
    font-weight: 600;
    line-height: 13px;
  }

  .pastille {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
    opacity: 0;
    scale: 0.5;
    transition:
      opacity 220ms,
      scale 360ms var(--ease-out-expo);
  }

  .pastille svg {
    width: 11px;
    height: 11px;
    stroke: var(--color-night);
    stroke-width: 1.5;
  }

  .resultat.est-rempli .resultat__logo {
    opacity: 1;
  }

  .resultat.est-rempli .pastille {
    opacity: 1;
    scale: 1;
  }

  /* La ligne laissée à l'humain : rien n'est envoyé tant qu'il n'a pas
     validé. Elle ne s'éclaire qu'une fois la réponse prête. */
  .validation {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    height: 30px;
    margin-top: 7px;
    padding: 0 4px 0 9px;
    border: 1px dashed color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-low);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0.45;
    transition:
      opacity 320ms,
      border-color 320ms,
      color 320ms,
      background-color 320ms;
  }

  .validation svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .validation__bouton {
    display: grid;
    place-items: center;
    height: 22px;
    padding-inline: 11px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-mid);
    font-size: 10px;
    font-weight: 600;
    transition:
      border-color 320ms,
      color 320ms;
  }

  .validation.est-attendue {
    border-color: var(--color-peche);
    background: color-mix(in srgb, var(--color-peche) 9%, transparent);
    color: var(--color-peche);
    opacity: 1;
  }

  .validation.est-attendue .validation__bouton {
    border-color: color-mix(in srgb, var(--color-peche) 70%, transparent);
    color: var(--color-ink);
  }

  /* ── Ce qui voyage ──
     La sonde est un grain creux : elle part vide. L'extrait est une petite
     carte pleine : il revient avec quelque chose. */
  .sonde {
    border: 2px solid var(--color-peche);
    background: var(--color-night-deep);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--color-peche) 45%, transparent);
  }

  .extrait {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    display: grid;
    align-content: center;
    gap: 3px;
    width: 30px;
    height: 20px;
    margin: -10px 0 0 -15px;
    padding-inline: 6px;
    border-radius: 5px;
    background: var(--color-peche);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--color-peche) 22%, transparent),
      0 0 16px 2px color-mix(in srgb, var(--color-peche) 45%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .extrait i {
    height: 2px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--color-night) 60%, transparent);
  }

  .extrait i + i {
    width: 62%;
  }

  /* ── Le plan étroit ──
     La même étoile, resserrée : le disque perd son nom, les tuiles leur
     relevé et une ligne, le fil de pensée ne montre que l'étape du moment
     (en version courte), et la réponse garde ses trois résultats. */
  @container sm (max-width: 519.98px) {
    .sm-plan {
      --cx: 180px;
      --cy: 91px;
      --coeur: 36px;
      --orbite: 6px;
    }

    .poste--question {
      top: 35px;
      left: 68px;
      width: 224px;
    }

    .source {
      width: 82px;
    }

    .source--web { top: 63px; left: 10px; }
    .source--documents { top: 63px; left: 268px; }
    .source--crm { top: 101px; left: 268px; }

    .pensee {
      top: 107px;
      left: 12px;
      width: 150px;
    }

    .poste--reponse {
      --sm-cols: 11px minmax(0, 1fr) auto 12px;
      top: 140px;
      left: 56px;
      width: 248px;
    }

    .port--question { bottom: -5px; left: calc(50% - 4.5px); }
    .port--reponse { top: -5px; left: calc(50% - 4.5px); }
    .port--source { top: calc(50% - 4.5px); left: -5px; }
    .source--web .port--source { right: -5px; left: auto; }
    .port--coeur { top: calc(50% - 4.5px); left: calc(50% - 4.5px); }

    .question {
      gap: 6px;
      height: 22px;
      padding: 0 3px 0 4px;
    }

    .question__qui,
    .question__envoi {
      width: 15px;
      height: 15px;
    }

    .question__qui svg,
    .question__envoi svg {
      width: 9px;
      height: 9px;
    }

    .question__texte {
      font-size: 10px;
    }

    .question__curseur {
      height: 11px;
    }

    .coeur__disque svg {
      width: 17px;
      height: 17px;
    }

    .coeur[data-etat='actif'] .coeur__disque {
      box-shadow:
        0 0 0 4px color-mix(in srgb, var(--color-peche) 13%, transparent),
        0 0 24px 3px color-mix(in srgb, var(--color-peche) 30%, transparent);
    }

    .satellite {
      --taille: 7px;
      border-width: 1.5px;
    }

    .pensee__titre {
      margin-bottom: 3px;
      font-size: 7px;
    }

    /* Une seule ligne : les étapes s'empilent au même endroit, et celle
       qu'une autre a suivie s'efface. */
    .pensee__etapes {
      gap: 0;
    }

    .etape {
      grid-area: 1 / 1;
      gap: 5px;
      font-size: 9.5px;
      line-height: 13px;
    }

    .etape:has(~ .etape:is(.est-en-cours, .est-fait)) {
      opacity: 0;
      transition: none;
    }

    .etape__marque {
      width: 11px;
      height: 11px;
      border-width: 1px;
    }

    .etape__marque svg {
      width: 7px;
      height: 7px;
    }

    .etape + .etape .etape__marque::before {
      display: none;
    }

    .tuile {
      padding: 5px 6px 6px;
    }

    .tuile__tete {
      gap: 5px;
      height: 13px;
    }

    .tuile .sm-fenetre__icone {
      width: 13px;
      height: 13px;
      border-radius: 4px;
    }

    .tuile .sm-fenetre__icone svg {
      width: 9px;
      height: 9px;
    }

    .tuile__nom {
      font-size: 9.5px;
    }

    .tuile__coche {
      width: 9px;
      height: 9px;
    }

    .tuile__corps {
      margin-top: 5px;
    }

    .tuile__balayage {
      top: -3px;
      bottom: -3px;
      width: 1.5px;
    }

    .poste--reponse .sm-corps {
      padding: 4px 5px 5px;
    }

    .resultat {
      height: 19px;
    }

    .resultat__logo {
      width: 11px;
      height: 11px;
      border-radius: 3px;
    }

    .resultat__raison {
      padding: 1px 5px;
      font-size: 8.5px;
      line-height: 11px;
    }

    .pastille {
      width: 12px;
      height: 12px;
    }

    .pastille svg {
      width: 8px;
      height: 8px;
    }

    .validation {
      gap: 5px;
      height: 18px;
      margin-top: 3px;
      padding: 0 2px 0 6px;
      font-size: 8.5px;
    }

    .validation svg {
      width: 10px;
      height: 10px;
    }

    .validation__bouton {
      height: 14px;
      padding-inline: 7px;
      font-size: 7.5px;
    }

    .extrait {
      gap: 2px;
      width: 18px;
      height: 12px;
      margin: -6px 0 0 -9px;
      padding-inline: 4px;
      border-radius: 3px;
    }

    .extrait i {
      height: 1.5px;
    }
  }
</style>

<script>
  /*
   * La partition de la scène : ses états (repos, image fixe) et l'ordre de sa
   * boucle. Le temps, la pause hors écran, l'échelle et l'annulation sont dans
   * le moteur ; ici, aucune attente n'a besoin de vérifier qu'elle a encore
   * cours, une boucle remplacée se défait d'elle-même.
   */
  import { ELAN, EXPO, monterScenes } from '../../lib/metiers/scene';
  import type { Cadre, Pt } from '../../lib/metiers/scene';

  type IdSource = 'web' | 'documents' | 'crm';

  interface Etape {
    texte: string;
    court: string;
    source: IdSource | null;
    releve: string;
    nombre: number;
  }

  interface Resultat {
    l: number;
    raison: string;
  }

  interface Demande {
    question: string;
    courte: string;
    etapes: Etape[];
    resultats: Resultat[];
  }

  /* Un trajet le long d'un fil. `inverse` le remonte, de son arrivée à son
     départ ; `absorbe` fait fondre le voyageur à l'arrivée, comme avalé. */
  interface Trajet {
    inverse?: boolean;
    duree?: number;
    absorbe?: boolean;
  }

  const SOURCES: readonly string[] = ['web', 'documents', 'crm'];
  /* Le fil du web est tracé de sa tuile vers l'agent (le moteur trace de
     gauche à droite) : pour lui, « partir de l'agent » remonte le fil. */
  const TRACE_VERS_AGENT: readonly string[] = ['web'];

  const estObjet = (valeur: unknown): valeur is Record<string, unknown> => typeof valeur === 'object' && valeur !== null;

  const estEtape = (valeur: unknown): valeur is Etape =>
    estObjet(valeur) &&
    typeof valeur.texte === 'string' &&
    typeof valeur.court === 'string' &&
    typeof valeur.releve === 'string' &&
    typeof valeur.nombre === 'number' &&
    (valeur.source === null || (typeof valeur.source === 'string' && SOURCES.includes(valeur.source)));

  const estResultat = (valeur: unknown): valeur is Resultat =>
    estObjet(valeur) && typeof valeur.l === 'number' && typeof valeur.raison === 'string';

  const estDemande = (valeur: unknown): valeur is Demande =>
    estObjet(valeur) &&
    typeof valeur.question === 'string' &&
    typeof valeur.courte === 'string' &&
    Array.isArray(valeur.etapes) &&
    valeur.etapes.every(estEtape) &&
    Array.isArray(valeur.resultats) &&
    valeur.resultats.every(estResultat);

  /* Les demandes arrivent du balisage en JSON : c'est une frontière, on
     vérifie leur forme avant de s'en servir. */
  const lireDemandes = (brut: string | undefined): Demande[] => {
    const lu: unknown = JSON.parse(brut ?? 'null');
    if (!Array.isArray(lu) || lu.length === 0 || !lu.every(estDemande)) {
      throw new Error('Scène Agents : `data-demandes` est illisible');
    }
    return lu;
  };

  /* La bande, resserrée en tiret à l'entrée d'un port (même taille que celle
     du socle). */
  const tiret = (p: Pt): Cadre => ({ x: p.x - 8, y: p.y - 3, w: 16, h: 6 });
  const entier = (n: number) => String(Math.round(n));

  monterScenes('[data-scene-agents]', (s) => {
    const question = s.un('[data-question]');
    const texteQuestion = s.un('[data-question-texte]');
    const coeur = s.un('[data-coeur]');
    const disque = s.un('[data-disque]');
    const orbite = s.un('[data-orbite]');
    const satellites = s.tous('[data-satellite]');
    const etapes = s.tous('[data-etape]');
    const resultats = s.tous('[data-resultat]');
    const validation = s.un('[data-validation]');
    const etatReponse = s.un('[data-etat-de="reponse"]');
    const elConsultees = s.un('[data-consultees]');
    const elZero = s.un('[data-zero]');
    const sonde = s.un('[data-sonde]');
    const carte = s.un('[data-carte]');
    const bandeExtrait = s.un('[data-bande="extrait"]');
    const grainQuestion = s.un('[data-grain="question"]');
    const grainsReponse = s.tous('[data-grain="reponse"]');
    const bandesReponse = s.tous('[data-bande="reponse"]');
    const demandes = lireDemandes(s.racine.dataset.demandes);

    const tuiles = new Map<string, HTMLElement>();
    s.tous('[data-source]').forEach((tuile) => tuiles.set(tuile.dataset.source ?? '', tuile));

    const champ = (el: HTMLElement, nom: string) => el.querySelector<HTMLElement>(`[data-c="${nom}"]`);
    const ecrireChamp = (el: HTMLElement, nom: string, texte: string) => {
      const cible = champ(el, nom);
      if (cible) cible.textContent = texte;
    };

    /* L'état de la scène. Le compteur repart de zéro à chaque question : à la
       fin, il vaut ce que ses trois sources ont rendu. */
    let rang = 0;
    let consultees = 0;
    let tourne: Animation | null = null;

    const demandeCourante = (): Demande => {
      const demande = demandes[rang % demandes.length];
      if (!demande) throw new Error('Scène Agents : aucune demande à jouer');
      return demande;
    };

    /* ── Les pièces, posées d'un coup ── */

    /* La question, vide ou entière, dans ses deux longueurs. */
    const poserQuestion = (demande: Demande | null) => {
      question.classList.remove('est-en-frappe');
      question.classList.toggle('est-vide', demande === null);
      question.classList.toggle('est-envoyee', demande !== null);
      ecrireChamp(question, 'question', demande?.question ?? '');
      ecrireChamp(question, 'courte', demande?.courte ?? '');
    };

    /* Les textes de la demande : ses étapes, le relevé de chaque source, ses
       résultats. Rien n'est encore montré. */
    const charger = (demande: Demande) => {
      demande.etapes.forEach((etape, i) => {
        const ligne = etapes[i];
        if (ligne) {
          ecrireChamp(ligne, 'texte', etape.texte);
          ecrireChamp(ligne, 'court', etape.court);
        }
        const tuile = etape.source ? tuiles.get(etape.source) : undefined;
        if (tuile) ecrireChamp(tuile, 'releve', etape.releve);
      });
      demande.resultats.forEach((resultat, i) => {
        const rangee = resultats[i];
        if (!rangee) return;
        rangee.style.setProperty('--l', `${resultat.l}%`);
        ecrireChamp(rangee, 'raison', resultat.raison);
      });
    };

    const arreterOrbite = () => {
      tourne?.cancel();
      tourne = null;
    };

    /* Tout ce que l'agent a fait est effacé : il est en veille, rien n'est
       consulté, la réponse est vide. */
    const vider = () => {
      arreterOrbite();
      s.racine.classList.remove('est-abouti');
      s.eteindre();
      coeur.dataset.etat = 'veille';
      satellites.forEach((satellite) => satellite.classList.remove('est-la'));
      etapes.forEach((etape) => etape.classList.remove('est-en-cours', 'est-fait'));
      tuiles.forEach((tuile) => tuile.classList.remove('est-sondee', 'est-consultee'));
      resultats.forEach((rangee) => rangee.classList.remove('est-rempli'));
      validation.classList.remove('est-attendue');
      etatReponse.dataset.etat = 'attente';
    };

    /* Le repos : le champ attend une question. */
    const repos = () => {
      vider();
      poserQuestion(null);
      charger(demandeCourante());
      consultees = 0;
      elConsultees.textContent = '0';
    };

    /* L'image fixe : la question posée, les sources consultées, la réponse
       composée. C'est aussi ce que le HTML rend sans script. */
    const figer = () => {
      const demande = demandeCourante();
      vider();
      charger(demande);
      poserQuestion(demande);
      coeur.dataset.etat = 'actif';
      demande.etapes.forEach((etape, i) => {
        etapes[i]?.classList.add('est-fait');
        if (!etape.source) return;
        tuiles.get(etape.source)?.classList.add('est-consultee');
        s.allumer(etape.source, true);
      });
      resultats.forEach((rangee) => rangee.classList.add('est-rempli'));
      validation.classList.add('est-attendue');
      etatReponse.dataset.etat = 'fait';
      s.allumer('question', true);
      s.allumer('reponse', true);
      s.racine.classList.add('est-abouti');
      consultees = demande.etapes.reduce((somme, etape) => somme + etape.nombre, 0);
      elConsultees.textContent = String(consultees);
    };

    /* ── Les gestes ── */

    /* Un voyageur suit un fil, dans un sens ou dans l'autre. C'est le
       `courir` du socle, qui ne sait aller que du départ vers l'arrivée : ici
       tout part du centre et y revient, il faut donc pouvoir remonter. */
    const parcourir = (voyageur: HTMLElement, fil: string, trajet: Trajet = {}): Promise<void> => {
      const { inverse = false, duree = 520, absorbe = false } = trajet;
      const trace = s.un<SVGPathElement>(`[data-sm-fil="${fil}"] path`);
      const longueur = trace.getTotalLength();
      const pas = 22;
      return s.animer(
        voyageur,
        Array.from({ length: pas + 1 }, (_, n) => {
          const p = trace.getPointAtLength((longueur * (inverse ? pas - n : n)) / pas);
          const taille = absorbe && n === pas ? 0.3 : 1;
          return {
            transform: `translate(${p.x}px, ${p.y}px) scale(${taille})`,
            opacity: n === 0 || n === pas ? 0 : 1,
          };
        }),
        { duration: duree, easing: 'cubic-bezier(0.45, 0, 0.25, 1)' },
      );
    };

    /* L'agent tressaille : il vient de recevoir quelque chose, ou d'en tirer
       une conclusion. */
    const tressaillir = () => {
      s.jouer(disque, [{ scale: 1 }, { scale: 1.1, offset: 0.35 }, { scale: 1 }], { duration: 420, easing: 'ease-out' });
    };

    /* La question se tape, trois lettres à la fois, dans la longueur affichée ;
       l'autre longueur est écrite d'un coup, pour un changement de plan. */
    const taper = async (demande: Demande) => {
      question.classList.remove('est-vide');
      question.classList.add('est-en-frappe');
      const [nom, texte, autre, entiere] = s.etroit
        ? (['courte', demande.courte, 'question', demande.question] as const)
        : (['question', demande.question, 'courte', demande.courte] as const);
      ecrireChamp(question, autre, entiere);
      for (let i = 3; i < texte.length; i += 3) {
        ecrireChamp(question, nom, texte.slice(0, i));
        await s.attendre(42);
      }
      ecrireChamp(question, nom, texte);
      await s.attendre(200);
      question.classList.remove('est-en-frappe');
      question.classList.add('est-envoyee');
    };

    /* L'aller-retour vers une source : la sonde part du centre, la source est
       parcourue, la ligne trouvée s'en détache et revient en extrait. */
    const chercher = async (source: IdSource, allure: number) => {
      const tuile = tuiles.get(source);
      if (!tuile) throw new Error(`Scène Agents : aucune source « ${source} »`);
      const versAgent = TRACE_VERS_AGENT.includes(source);
      const ligne = s.un(`[data-source="${source}"] [data-extrait]`);
      const balayage = s.un(`[data-source="${source}"] [data-balayage]`);

      /* 1. La sonde part, le fil s'allume derrière elle. */
      s.allumer(source);
      await parcourir(sonde, source, { inverse: versAgent, duree: 430 * allure });
      s.port(source).classList.add('est-actif');

      /* 2. La source est parcourue d'un trait. */
      tuile.classList.add('est-sondee');
      const corps = balayage.offsetParent instanceof HTMLElement ? balayage.offsetParent.offsetWidth : 0;
      await s.animer(
        balayage,
        [
          { transform: 'translateX(0)', opacity: 0 },
          { opacity: 1, offset: 0.12 },
          { opacity: 1, offset: 0.88 },
          { transform: `translateX(${corps}px)`, opacity: 0 },
        ],
        { duration: 440 * allure, easing: 'ease-in-out' },
      );
      tuile.classList.add('est-consultee');
      tuile.classList.remove('est-sondee');
      await s.attendre(170 * allure);

      /* 3. La ligne trouvée quitte la source et revient au centre. */
      s.enMarge(
        s.voler(bandeExtrait, s.cadreDe(ligne), tiret(s.lieu(s.port(source))), {
          duree: 300 * allure,
          pose: 0.15,
          arrivee: 0.9,
          easing: ELAN,
        }),
      );
      await s.attendre(230 * allure);
      await parcourir(carte, source, { inverse: !versAgent, duree: 520 * allure, absorbe: true });
      tressaillir();
    };

    /* Un extrait devient un résultat : il quitte l'orbite, descend le fil et
       se pose dans la réponse. */
    const composer = async (i: number) => {
      const rangee = resultats[i];
      const grain = grainsReponse[i];
      const bande = bandesReponse[i];
      if (!rangee || !grain || !bande) return;
      satellites[i]?.classList.remove('est-la');
      s.enMarge(s.courir(grain, 'reponse', { duree: 340 }));
      await s.attendre(250);
      s.port('reponse').classList.add('est-actif');
      s.enMarge(
        s.voler(bande, tiret(s.lieu(s.port('reponse'))), rangee, {
          duree: 600,
          pose: 0.06,
          arrivee: 0.64,
          easing: EXPO,
          eclot: true,
        }),
      );
      await s.attendre(340);
      rangee.classList.add('est-rempli');
    };

    async function tour() {
      const demande = demandeCourante();
      const pose: Promise<void>[] = [];

      await s.attendre(300);

      /* 1. La question se tape, puis descend jusqu'à l'agent, qui s'éveille :
         son orbite tourne tant qu'il réfléchit. */
      await taper(demande);
      s.allumer('question');
      await s.courir(grainQuestion, 'question', { duree: 320 });
      coeur.dataset.etat = 'actif';
      tressaillir();
      tourne = s.jouer(orbite, { rotate: ['0deg', '360deg'] }, { duration: 5200, iterations: Infinity, easing: 'linear' });
      await s.attendre(200);

      /* 2. et 3. Le raisonnement, étape par étape. Celles qui nomment une
         source y envoient une sonde ; la dernière se fait sur place. La
         première sortie est lente, pour qu'on comprenne ; les suivantes vont
         plus vite. */
      let sorties = 0;
      for (let i = 0; i < demande.etapes.length; i++) {
        const etape = demande.etapes[i];
        const ligne = etapes[i];
        if (!etape || !ligne) continue;
        ligne.classList.add('est-en-cours');
        s.jouer(ligne, [{ transform: 'translateY(7px)' }, { transform: 'none' }], { duration: 380, easing: EXPO });
        await s.attendre(sorties === 0 ? 300 : 160);

        if (etape.source) {
          await chercher(etape.source, sorties === 0 ? 1 : 0.7);
          satellites[sorties]?.classList.add('est-la');
          sorties += 1;
          const avant = consultees;
          consultees += etape.nombre;
          s.enMarge(s.compter(elConsultees, avant, consultees, { format: entier, pas: 6, intervalle: 32 }));
        } else {
          await s.attendre(340);
          tressaillir();
        }
        ligne.classList.replace('est-en-cours', 'est-fait');
        await s.attendre(140);
      }

      /* 4. La réponse se compose : un résultat par extrait, l'un derrière
         l'autre, puis la ligne laissée à l'humain. */
      s.allumer('reponse');
      for (let i = 0; i < resultats.length; i++) {
        const travail = composer(i);
        s.enMarge(travail);
        pose.push(travail);
        await s.attendre(260);
      }
      await Promise.all(pose);
      arreterOrbite();
      s.basculer(etatReponse);
      await s.attendre(200);
      validation.classList.add('est-attendue');
      s.jouer(
        validation,
        [
          { boxShadow: '0 0 0 0 color-mix(in srgb, var(--color-peche) 50%, transparent)' },
          { boxShadow: '0 0 0 9px color-mix(in srgb, var(--color-peche) 0%, transparent)' },
        ],
        { duration: 1100, iterations: 2, delay: 200, easing: 'ease-out' },
      );
      s.racine.classList.add('est-abouti');
      /* Une réponse de plus, et personne n'a cherché à la main : zéro. */
      s.tictac(elZero, '0');

      /* Le temps de lire l'image. */
      await s.attendre(2600);

      /* 5. On range : tout s'éteint d'un coup, la question s'efface. Le
         raccord est là : la scène vide est exactement son repos, et la
         demande suivante est chargée pendant qu'on ne voit plus rien. */
      vider();
      consultees = 0;
      s.tictac(elConsultees, '0');
      await s.animer(texteQuestion, { opacity: [1, 0] }, { duration: 300, easing: ELAN });
      rang += 1;
      poserQuestion(null);
      charger(demandeCourante());
      await s.animer(texteQuestion, { opacity: [0, 1] }, { duration: 320, easing: EXPO });
      await s.attendre(120);
    }

    return { figer, repos, tour };
  });
</script>
