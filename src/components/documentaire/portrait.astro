---
/*
 * portrait : le chapitre où Lilian se présente, comme l'interview d'un
 * documentaire.
 *
 * À gauche son portrait, cadré comme un plan d'interview, avec son
 * incrustation. À droite ce qu'il dit de sa façon de travailler (PRODUCT.md,
 * « Sa façon de travailler »). Puis deux plans en cinémascope : au micro de
 * Radio Contournement, à La Capsule, et devant une classe en formation (voir
 * `src/assets/documentaire/README.md`). Entre les deux, un carton : les faits
 * qui le résument, en une phrase, sans date (« c'est pas un CV »).
 */
import { Image, getImage } from 'astro:assets';
import Chapitre from './chapitre.astro';
import portraitImg from '../../assets/lilian-photo.jpg';
import PlanLarge from './plan-large.astro';
import studioImg from '../../assets/documentaire/studio-micro.jpg';
import formationImg from '../../assets/documentaire/formation-salle.jpg';
import { faits } from '../../data/parcours';

const lumiere = await getImage({ src: portraitImg, width: 64, format: 'webp', quality: 60 });

/* Les deux chiffres viennent de `parcours.ts`, la seule source des faits. La
   certification y porte sa date ; Lilian ne veut pas de date sur l'accueil. */
const entreprises = faits.find((f) => f.detail === 'accompagnées');
const personnes = faits.find((f) => f.titre.startsWith('Plus de 300'));
---

<Chapitre
  id="a-propos"
  nom="Portrait"
  lueur="lueur-froide peche"
  class="portrait"
>
  <div class="portrait__scene">
    <figure class="portrait__plan plan reveal">
      <div class="plan__lumiere" style={`background-image: url(${lumiere.src})`} aria-hidden="true"></div>
      <div class="portrait__cadre plan__cadre media-ouvre">
        <Image
          src={portraitImg}
          alt="Portrait de Lilian Sevoumian, de trois quarts, sur fond sombre."
          widths={[480, 800, 1024]}
          sizes="(min-width: 1024px) 480px, 100vw"
          loading="lazy"
        />
        <p class="incrustation"><b>Lilian Sevoumian</b><span>freelance en automatisation et agents&nbsp;IA</span></p>
      </div>
    </figure>

    <div class="portrait__parole">
      <header class="carton reveal">
        <h2>Je pars de vos processus, pas d’une liste <mark>d’outils.</mark></h2>
      </header>
      <div class="portrait__texte reveal">
        <p>
          Un studio de podcast, une activité de formation, puis une agence&nbsp;: les journées mangées par des
          tâches qui n’avancent rien, je les connais de l’intérieur.
        </p>
        <p>
          Je construis avec les outils que l’équipe utilise déjà, et je laisse un humain garder la main sur les
          cas douteux. Ce que j’apprends en chemin, je le montre en vidéo et je l’écris chaque semaine.
        </p>
      </div>

    </div>
  </div>

  <PlanLarge
    class="portrait__plan-large"
    image={studioImg}
    alt="Lilian au micro d’un studio de podcast, casquette à l’envers, en train d’expliquer de la main."
    nom="Lilian Sevoumian"
    role="au micro de Radio Contournement, à La Capsule"
    roleCourt="à La Capsule"
    sousTitre="J’ai automatisé le back-office de La Capsule, le studio de podcast que j’ai cofondé."
    credit="Image : Radio Contournement, épisode 125."
    cadrage="50% 30%"
    cadrageEtroit="58% 40%"
  />

  <p class="portrait__faits reveal">
    {entreprises && `${entreprises.titre} ${entreprises.detail}, `}
    {personnes && `${personnes.titre.toLowerCase()} ${personnes.detail}, `}
    et le <mark>premier Français certifié Make niveau&nbsp;5.</mark>
  </p>

  <PlanLarge
    image={formationImg}
    alt="Lilian, en polo bordeaux, explique un écran à une classe ; les participants, vus de dos, suivent sur leurs ordinateurs."
    nom="Lilian Sevoumian"
    role="en formation, devant une classe"
    roleCourt="devant une classe"
    sousTitre="J’accompagne la prise en main, jusqu’à ce que l’équipe s’en serve sans moi."
    cadrage="30% 45%"
    cadrageEtroit="22% 45%"
  />
</Chapitre>

<style>
  .portrait__scene {
    display: grid;
    gap: var(--spacing-bloc);
  }

  .portrait__cadre {
    aspect-ratio: 4 / 5;
  }

  .portrait__cadre :global(img) {
    object-position: 50% 30%;
  }

  .portrait__parole {
    display: grid;
    align-content: start;
  }

  /* Ici le titre est ce que dit l'interviewé, à côté de son portrait : il
     garde la colonne et l'alignement du texte qu'il ouvre. */
  .portrait__parole .carton {
    justify-items: start;
    margin-bottom: var(--spacing-lie);
    padding-top: 0;
    text-align: left;
  }

  .portrait__parole .carton h2 {
    font-size: var(--text-story);
    letter-spacing: -0.035em;
  }

  .portrait__texte {
    display: grid;
    gap: 1rem;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
  }

  .portrait__plan-large {
    margin-top: var(--spacing-section-y);
  }

  /* Le carton des faits, entre les deux plans : une phrase seule, en grand,
     au centre. */
  .portrait__faits {
    max-width: 26ch;
    margin: var(--spacing-section-y) auto;
    color: var(--color-ink);
    font-size: var(--text-headline);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-align: center;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .portrait__scene {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--spacing-gouttiere);
      align-items: start;
    }

    .portrait__parole {
      padding-top: clamp(1rem, 4vw, 4rem);
    }
  }
</style>
