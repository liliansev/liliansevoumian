---
/*
 * expertises : ce que Lilian sait faire, en une séquence de quatre plans.
 *
 * Le chapitre « Expertises » de l'accueil « Le documentaire ». Un seul grand
 * plan, où passent l'une après l'autre les quatre scènes des métiers
 * (`components/metiers/`), comme les plans d'une même séquence. Au-dessus, la
 * liste des plans, comme les chapitres d'un lecteur vidéo : le nom de chaque
 * métier, et un trait pêche sous celui qu'on regarde. Sous le plan, la phrase
 * du métier en sous-titre, ce qui l'étaie, et la sortie.
 *
 * La phrase est le titre du métier ; son nom ne sert qu'à la liste des plans.
 * Pas de prix ici : ils sont sur les pages d'offre (14 octobre 2026). Les
 * textes et les liens viennent de `data/metiers.ts`, avec leurs goals
 * DataFast.
 *
 * Sans script, les quatre plans se suivent, chacun avec son sous-titre. Une
 * scène ne joue que quand on la voit (voir `lib/metiers/scene.ts`) : le plan
 * qu'on choisit joue son tour à ce moment-là, une fois, et s'arrête sur son
 * image finale.
 */
import LinkCTA from '../LinkCTA.astro';
import Chapitre from './chapitre.astro';
import SceneAutomatisation from '../metiers/scene-automatisation.astro';
import SceneAgents from '../metiers/scene-agents.astro';
import SceneFormations from '../metiers/scene-formations.astro';
import SceneSites from '../metiers/scene-sites.astro';
import { metiers } from '../../data/metiers';

const scenes = {
  automatisation: SceneAutomatisation,
  'agents-ia': SceneAgents,
  dashboards: SceneSites,
  formations: SceneFormations,
};
---

<Chapitre id="services" nom="Expertises" lueur="lueur-froide lueur-froide" titre="Mes <mark>expertises.</mark>">
  <div class="expertises" data-expertises>
    <div class="expertises__plans" role="tablist" aria-label="Mes expertises" data-plans hidden>
      {metiers.map((metier, index) => (
        <button
          type="button"
          role="tab"
          id={`plan-${metier.id}`}
          aria-controls={metier.id}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-plan
        >
          {metier.onglet}
        </button>
      ))}
    </div>

    {metiers.map((metier) => {
      const Scene = scenes[metier.id];
      return (
        <article id={metier.id} class="expertise" data-expertise>
          <figure class="expertise__plan plan">
            <div class="expertise__cadre plan__cadre"><Scene /></div>
          </figure>
          <h3 class="sous-titre expertise__phrase">{metier.phrase}</h3>
          <p class="expertise__corps" set:html={metier.texte} />
          <p class="expertise__suite">
            <LinkCTA
              href={metier.lien.href}
              external={'externe' in metier.lien}
              goal={metier.lien.goal}
              goalSource={metier.lien.source}
            >
              {metier.lien.label}
            </LinkCTA>
          </p>
        </article>
      );
    })}
  </div>
</Chapitre>

<style>
  .expertises {
    display: grid;
    gap: var(--spacing-bloc);
  }

  .expertise {
    display: grid;
    justify-items: center;
    gap: var(--spacing-lie);
    text-align: center;
  }

  .expertise[hidden],
  .expertises__plans[hidden] {
    display: none;
  }

  /* ── Le plan ──
     La scène est dessinée sur un plan de 760 × 570, mis à l'échelle de son
     cadre et centré : dans le cinémascope, ses deux marges prennent la lumière
     du panneau. Plus étroit, le cadre se resserre pour que le texte des
     fenêtres reste lisible. */
  .expertise__plan {
    width: 100%;
  }

  .expertise__cadre {
    aspect-ratio: 9 / 8;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    border-radius: var(--radius-xl);
  }

  @media (min-width: 600px) {
    .expertise__cadre { aspect-ratio: 4 / 3; }
  }

  @media (min-width: 1024px) {
    .expertise__cadre { aspect-ratio: 16 / 9; }
  }

  @media (min-width: 1280px) {
    .expertise__cadre { aspect-ratio: 2.39; }
  }

  .expertise__phrase {
    margin: var(--spacing-colle) auto 0;
  }

  .expertise__corps {
    max-width: 46ch;
    margin: 0 auto;
    color: var(--color-ink-mid);
  }

  .expertise__corps :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--duration-quick) var(--ease-out-quint);
  }

  .expertise__corps :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .expertise__suite {
    margin: 0;
  }

  /* ── La liste des plans ──
     Comme les chapitres d'un lecteur : quatre noms sur une ligne, chacun sur
     sa piste, celle du plan qu'on regarde en pêche. */
  .expertises__plans {
    display: flex;
    justify-content: center;
    gap: 0.375rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .expertises__plans::-webkit-scrollbar {
    display: none;
  }

  .expertises__plans button {
    position: relative;
    flex: 0 0 auto;
    min-width: 7.5rem;
    min-height: 44px;
    padding: 0 0.75rem 0.875rem;
    border: 0;
    background: none;
    color: var(--color-ink-low);
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--duration-default) var(--ease-out-quint);
  }

  .expertises__plans button::after {
    content: '';
    position: absolute;
    right: 0.25rem;
    bottom: 0;
    left: 0.25rem;
    height: 3px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
    transition: background-color var(--duration-default) var(--ease-out-quint);
  }

  .expertises__plans button:hover {
    color: var(--color-ink);
  }

  .expertises__plans button[aria-selected='true'] {
    color: var(--color-ink);
  }

  .expertises__plans button[aria-selected='true']::after {
    background: var(--color-peche);
  }

  /* Sur un téléphone les quatre noms ne tiennent pas sur une ligne : ils
     passent sur deux, deux par deux, chacun avec sa piste. Aucun n'est coupé
     ni caché derrière le bord. */
  @media (max-width: 640px) {
    .expertises__plans {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.25rem 0.5rem;
      overflow: visible;
    }

    .expertises__plans button {
      min-width: 0;
      padding-inline: 0.25rem;
    }

    .expertise__plan {
      width: auto;
      margin-inline: calc(0.5rem - var(--spacing-section-x));
      justify-self: stretch;
    }
  }

  /* Le changement de plan : un fondu depuis la nuit, puis le sous-titre. */
  @media (prefers-reduced-motion: no-preference) {
    .expertises[data-en-plans] .expertise:not([hidden]) .expertise__cadre {
      animation: plan-fondu 520ms var(--ease-out-quint) backwards;
    }

    .expertises[data-en-plans] .expertise:not([hidden]) .expertise__phrase {
      animation: phrase-arrive 520ms var(--ease-out-quint) 160ms backwards;
    }
  }

  @keyframes plan-fondu {
    from { opacity: 0; }
  }

  @keyframes phrase-arrive {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
  }
</style>

<script>
  /* Un plan à la fois. Le premier rendu reste celui qu'on lit sans script :
     les quatre plans à la suite. */
  const racine = document.querySelector<HTMLElement>('[data-expertises]');
  const liste = racine?.querySelector<HTMLElement>('[data-plans]');
  const boutons = [...(liste?.querySelectorAll<HTMLButtonElement>('[data-plan]') ?? [])];
  const plans = [...(racine?.querySelectorAll<HTMLElement>('[data-expertise]') ?? [])];

  if (racine && liste && plans.length > 1 && boutons.length === plans.length) {
    const montrer = (rang: number) => {
      boutons.forEach((bouton, i) => {
        bouton.setAttribute('aria-selected', String(i === rang));
        bouton.tabIndex = i === rang ? 0 : -1;
      });
      plans.forEach((plan, i) => {
        plan.hidden = i !== rang;
      });
    };

    liste.hidden = false;
    racine.toggleAttribute('data-en-plans', true);
    plans.forEach((plan, i) => {
      plan.setAttribute('role', 'tabpanel');
      plan.setAttribute('aria-labelledby', boutons[i].id);
    });

    boutons.forEach((bouton, i) => {
      bouton.addEventListener('click', () => montrer(i));
      bouton.addEventListener('keydown', (e) => {
        const pas = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        const cible = e.key === 'Home' ? 0 : e.key === 'End' ? boutons.length - 1 : pas ? (i + pas + boutons.length) % boutons.length : -1;
        if (cible < 0) return;
        e.preventDefault();
        montrer(cible);
        boutons[cible].focus();
      });
    });

    /* Une adresse vers un métier (#agents-ia…) ouvre son plan : masqué, il ne
       pourrait pas être atteint. */
    const rangDe = (ancre: string) => plans.findIndex((plan) => `#${plan.id}` === ancre);
    document.addEventListener('click', (e) => {
      const lien = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('a[href^="#"]') : null;
      const rang = lien ? rangDe(lien.getAttribute('href') ?? '') : -1;
      if (rang >= 0) montrer(rang);
    });
    const suivreLAncre = () => {
      const rang = rangDe(window.location.hash);
      if (rang >= 0) montrer(rang);
    };
    window.addEventListener('hashchange', suivreLAncre);

    montrer(0);
    suivreLAncre();
  }
</script>
