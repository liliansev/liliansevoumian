---
/*
 * voix : ce que disent ceux qui ont travaillé avec Lilian, comme les
 * intervenants d'un documentaire.
 *
 * À gauche, le plan reste : Lilian au micro de La Capsule, qui sourit. À
 * droite, les trois intervenants passent l'un après l'autre, chacun avec son
 * sous-titre et son incrustation. Leurs mots sont en blanc ; la pêche claire
 * reste la voix de Lilian. Dans l'incrustation, le portrait est en rond et en
 * noir et blanc pour que les trois photos (prises n'importe où) se
 * ressemblent, le nom et le rôle sous le trait pêche. Les
 * citations et leurs coupes sont celles de `Testimonials.astro` et de l'ancien
 * `home-voices.astro` : on ne retire que des phrases entières, on ne reformule
 * rien. Aucune ne porte de chiffre : les chiffres sont dans les cas clients,
 * et le lien du bas y mène.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import LinkCTA from '../LinkCTA.astro';
import Chapitre from './chapitre.astro';
import sourireImg from '../../assets/documentaire/capsule-sourire.jpg';
import ismailImg from '../../assets/testimonials/ismail.jpeg';
import alexisImg from '../../assets/testimonials/alexis.jpeg';
import benjaminImg from '../../assets/testimonials/benjamin.png';

const voix = [
  {
    citation:
      'J’ai la chance d’avoir collaboré à de nombreuses reprises avec Lilian. Je peux témoigner de son expertise en automatisation.',
    nom: 'Alexis Kovalenko',
    role: 'Cofondateur, Contournement',
    image: alexisImg,
  },
  {
    citation: 'Un vrai bonheur de travailler avec Lilian sur des sujets de connectivité via Make.',
    nom: 'Ismail Landoulsi',
    role: 'Cofondateur & COO, CasanovaParis',
    image: ismailImg,
  },
  {
    citation: 'Les projets qu’il prend en charge sont un succès.',
    nom: 'Benjamin Potet',
    role: 'Solution Architect Customer Experience, Make',
    image: benjaminImg,
  },
];

/* Le nombre de cas publiés vient de la collection : le lien ne peut pas en
   annoncer un de plus ou de moins que la page d'arrivée. */
const nombres = ['zéro', 'un', 'deux', 'trois', 'quatre', 'cinq', 'six', 'sept', 'huit', 'neuf', 'dix'];
const cas = (await getCollection('cas-clients')).length;
const nombreDeCas = nombres[cas] ?? String(cas);
---

<Chapitre id="temoignages" nom="Ils en parlent" lueur="peche braise" titre="On a travaillé <mark>ensemble.</mark>">
  <div class="voix">
    <figure class="voix__plan plan reveal">
      <div class="voix__cadre plan__cadre media-ouvre">
        <Image
          src={sourireImg}
          alt="Lilian sourit au micro, pendant un enregistrement de podcast."
          widths={[320, 640, 880]}
          sizes="(min-width: 1024px) 26rem, 80vw"
          loading="lazy"
        />
        <p class="incrustation"><b>Lilian Sevoumian</b><span>à La Capsule</span></p>
      </div>
    </figure>

    <ul class="voix__intervenants" role="list">
      {voix.map((v) => (
        <li class="voix__intervenant reveal">
          <figure>
            <blockquote>«&nbsp;{v.citation}&nbsp;»</blockquote>
            <figcaption class="voix__incrustation">
              <span class="voix__rond">
                <Image src={v.image} alt="" width={112} height={112} format="webp" quality={80} class="voix__portrait" loading="lazy" />
              </span>
              <span class="voix__qui">
                <b>{v.nom}</b>
                <span>{v.role}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
  <p class="voix__suite reveal">
    <LinkCTA href="/cas-clients">Lire les {nombreDeCas} cas clients, chiffres à l’appui</LinkCTA>
  </p>
</Chapitre>

<style>
  .voix {
    display: grid;
    gap: var(--spacing-bloc) var(--spacing-gouttiere);
  }

  .voix__plan {
    width: min(100%, 22rem);
    margin-inline: auto;
  }

  .voix__cadre {
    aspect-ratio: 880 / 997;
  }

  .voix__intervenants {
    display: grid;
    gap: var(--spacing-section-y);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Sur un écran large, le plan reste pendant que les intervenants passent. */
  @media (min-width: 1024px) {
    .voix {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }

    .voix__plan {
      position: sticky;
      top: calc(var(--spacing-barre) + 2rem);
      width: 100%;
      max-width: 26rem;
    }

    .voix__intervenants {
      padding-block: clamp(2rem, 10svh, 6rem);
    }
  }

  .voix__intervenant {
    max-width: none;
  }

  .voix__intervenant figure {
    display: grid;
    justify-items: center;
    gap: var(--spacing-groupe);
    margin: 0;
    text-align: center;
  }

  /* Le sous-titre d'un intervenant : centré comme ceux de Lilian, en blanc. */
  .voix blockquote {
    max-width: 30ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-title-lg);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .voix__incrustation {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-night-deep) 74%, transparent);
    text-align: left;
    position: relative;
  }

  /* Le trait pêche de l'incrustation. */
  .voix__incrustation::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0.75rem;
    width: 1.75rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
  }

  /* Le portrait en rond, un peu agrandi dans son cadre : une des photos
     arrive déjà découpée en rond sur fond blanc, et son bord ne doit pas se
     voir. */
  .voix__rond {
    flex: none;
    width: 3rem;
    height: 3rem;
    overflow: clip;
    border-radius: var(--radius-full);
    background: var(--color-surface-low);
  }

  .voix__rond :global(.voix__portrait) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
    filter: grayscale(1) contrast(1.05) brightness(0.92);
  }

  .voix__qui {
    display: grid;
    gap: 0.125rem;
    line-height: 1.3;
  }

  .voix__qui b {
    color: var(--color-ink);
    font-weight: 500;
  }

  .voix__qui span {
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
  }

  .voix__suite {
    margin: var(--spacing-bloc) 0 0;
    text-align: center;
  }
</style>
