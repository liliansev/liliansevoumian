---
/*
 * publications : ce que Lilian publie, une vidéo et un e-mail par semaine.
 *
 * La dernière vidéo en grand plan, avec la lumière de sa vignette sur la nuit :
 * c'est le premier endroit de la page où l'on voit son visage de face. À côté,
 * l'inscription à la newsletter, réduite à une phrase, un champ et un bouton
 * clair : la pastille pêche reste au bouton d'appel.
 *
 * La vidéo est toujours la dernière : voir `data/derniere-video.ts` et le
 * script en bas de ce fichier, repris de `home-content.astro` (l'ancien
 * accueil), comme celui de l'inscription, qui passe par `/api/newsletter`
 * (`lib/newsletter-signup.ts`).
 */
import { Icon } from 'astro-icon/components';
import LinkCTA from '../LinkCTA.astro';
import Chapitre from './chapitre.astro';
import { derniereVideo, urlVideo } from '../../data/derniere-video';

const video = {
  id: derniereVideo.id,
  publiee: derniereVideo.publiee,
  titre: derniereVideo.titre,
  url: urlVideo(derniereVideo.id),
  vignette: `/videos/${derniereVideo.id}.webp`,
};

const chaine = 'https://www.youtube.com/@lilian.sevoumian';
const linkedin = 'https://www.linkedin.com/in/liliansevoumian/';
---

<Chapitre
  id="contenus"
  nom="Vidéos"
  lueur="peche peche"
  titre="Ce que j’apprends, je le montre."
>
  <div class="publications">
    <article class="publications__video reveal">
      <a
        href={video.url}
        target="_blank"
        rel="noopener noreferrer"
        class="video"
        data-derniere-video={video.id}
        data-video-publiee={video.publiee}
        data-fast-goal="youtube_opened"
        data-fast-goal-source="home_content"
      >
        <figure class="plan">
          <div class="plan__lumiere plan__lumiere--douce" style={`background-image: url(${video.vignette})`} aria-hidden="true"></div>
          <div class="video__cadre plan__cadre media-ouvre">
            <img src={video.vignette} alt="" width="1280" height="720" loading="lazy" decoding="async" />
            <span class="video__lecture" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l10.5-6.5z" /></svg>
            </span>
          </div>
        </figure>
        <h3 class="video__titre">
          <span data-video-titre>{video.titre}</span>
          <span class="sr-only"> : voir la vidéo sur YouTube (nouvel onglet)</span>
        </h3>
      </a>
      <p class="video__suite">
        <LinkCTA href={chaine} external goal="youtube_opened" goalSource="home_content_chaine">
          Toutes mes vidéos sur YouTube
        </LinkCTA>
      </p>
    </article>

    <aside id="newsletter" aria-labelledby="newsletter-titre" class="publications__courrier reveal">
      <h3 id="newsletter-titre" class="courrier__titre">Un e-mail par semaine.</h3>
      <p class="courrier__intro">Ce que je construis et ce que je teste, directement dans votre boîte.</p>
      <form id="newsletter-form" action="/api/newsletter" method="post" class="courrier">
        <div class="courrier__champ">
          <label for="newsletter-email" class="sr-only">Votre adresse e-mail</label>
          <input id="newsletter-email" type="email" name="email" required maxlength="254" autocomplete="email" placeholder="vous@entreprise.fr" aria-describedby="newsletter-note newsletter-status" />
          <button type="submit" disabled class="courrier__envoi">S’abonner <Icon name="lucide:arrow-right" size={16} aria-hidden="true" /></button>
        </div>
        <div hidden aria-hidden="true"><label for="newsletter-website">Votre site</label><input id="newsletter-website" name="website" tabindex="-1" autocomplete="off" /></div>
        <p id="newsletter-note" class="courrier__note">Un e-mail de confirmation, puis un par semaine. Désinscription en&nbsp;un&nbsp;clic.</p>
        <p id="newsletter-status" role="status" aria-live="polite" aria-atomic="true" class="newsletter-status courrier__note" hidden></p>
        <noscript><p class="courrier__note">Activez JavaScript pour vous inscrire à la newsletter.</p></noscript>
      </form>
      <p class="courrier__suite">
        <LinkCTA href={linkedin} external>Me suivre sur LinkedIn</LinkCTA>
      </p>
    </aside>
  </div>
</Chapitre>

<style>
  .publications {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-bloc);
  }

  @media (min-width: 1024px) {
    .publications {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      column-gap: var(--spacing-gouttiere);
      align-items: start;
    }
  }

  .publications__video {
    display: grid;
    gap: 1rem;
  }

  .video {
    display: grid;
    gap: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .video__cadre {
    aspect-ratio: 16 / 9;
  }

  .video__cadre img {
    transition: transform 900ms var(--ease-out-expo);
  }

  /* Le bouton de lecture : un rond clair, comme sur un lecteur. Il grandit
     sous le pointeur, l'image recule. */
  .video__lecture {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: clamp(3.5rem, 6vw, 4.75rem);
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--color-ink);
    color: var(--color-night);
    transform: translate(-50%, -50%);
    transition: transform var(--duration-default) var(--ease-out-quint);
  }

  .video__lecture svg {
    fill: currentColor;
    margin-left: 3px;
  }

  .video:hover .video__lecture,
  .video:focus-visible .video__lecture {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .video:hover .video__cadre img {
    transform: scale(1.03);
  }

  .video__titre {
    margin: 0;
    max-width: 28ch;
    font-size: var(--text-title-lg);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .video__suite,
  .courrier__suite {
    margin: 0;
  }

  /* ── La newsletter : une phrase, un champ ── */
  .publications__courrier {
    display: grid;
    gap: 1rem;
    align-content: end;
  }

  .courrier__titre {
    margin: 0;
    font-size: var(--text-title-lg);
    letter-spacing: -0.025em;
  }

  .courrier__intro {
    max-width: 34ch;
    color: var(--color-ink-mid);
  }

  .courrier {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .courrier__champ {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.5rem;
    padding: 0.375rem 0.375rem 0.375rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-night-deep) 70%, transparent);
    transition: border-color var(--duration-default) var(--ease-out-quint);
  }

  .courrier__champ:focus-within {
    border-color: var(--color-peche);
  }

  /* `width: 0` : sans largeur, le champ garde ses 218 px intrinsèques, qui
     élargissaient toute la colonne au-delà de l'écran sur un téléphone. */
  .courrier__champ input {
    flex: 1;
    width: 0;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    outline: none;
  }

  .courrier__champ input::placeholder {
    color: var(--color-ink-faint);
  }

  .courrier__champ input[aria-invalid='true'] {
    color: var(--color-error);
  }

  .courrier__envoi {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding-inline: 1.125rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 28%, transparent);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color var(--duration-default) var(--ease-out-quint),
      color var(--duration-default) var(--ease-out-quint);
  }

  .courrier__envoi:hover:not(:disabled),
  .courrier__envoi:focus-visible {
    border-color: var(--color-peche);
    color: var(--color-peche);
  }

  .courrier__envoi:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .courrier__note {
    color: var(--color-ink-faint);
    font-size: var(--text-body-sm);
  }

  .newsletter-status[data-state='error'] { color: var(--color-error); }
  .newsletter-status[data-state='subscribed'],
  .newsletter-status[data-state='pending'] { color: var(--color-ink); }

  @media (prefers-reduced-motion: reduce) {
    .video__cadre img,
    .video__lecture { transition: none; }
  }
</style>

<script>
  /* La vidéo écrite dans la page est celle qui était la dernière à la mise en
     ligne. Le serveur connaît la dernière de la chaîne (`/api/derniere-video`,
     dans `deploy/server.mjs`) : si une vidéo plus récente est sortie, le lien,
     le titre et la vignette sont remplacés, une fois la nouvelle vignette
     chargée, pour que titre et image changent ensemble. Sans réponse (hors
     ligne, serveur de développement), la page reste telle qu'elle est. */
  const lienVideo = document.querySelector<HTMLAnchorElement>('[data-derniere-video]');
  const imageVideo = lienVideo?.querySelector('img');
  const titreVideo = lienVideo?.querySelector('[data-video-titre]');
  const lumiereVideo = lienVideo?.querySelector<HTMLElement>('.plan__lumiere');
  if (lienVideo && imageVideo && titreVideo) {
    fetch('/api/derniere-video', { headers: { Accept: 'application/json' } })
      .then((reponse) => (reponse.ok ? reponse.json() : null))
      .then((video: unknown) => {
        if (!video || typeof video !== 'object') return;
        const { id, titre, publiee } = video as { id?: unknown; titre?: unknown; publiee?: unknown };
        if (typeof id !== 'string' || typeof titre !== 'string' || !/^[\w-]{11}$/.test(id)) return;
        if (id === lienVideo.dataset.derniereVideo) return;
        /* Une vidéo différente n'est pas forcément plus récente : juste après
           une publication, le flux peut encore annoncer la précédente. Les
           dates sont en AAAA-MM-JJ, elles se comparent telles quelles. */
        const ecrite = lienVideo.dataset.videoPubliee;
        if (typeof publiee === 'string' && ecrite && publiee <= ecrite) return;
        const vignette = new Image();
        vignette.onload = () => {
          imageVideo.src = vignette.src;
          if (lumiereVideo) lumiereVideo.style.backgroundImage = `url(${vignette.src})`;
          titreVideo.textContent = titre;
          lienVideo.href = `https://www.youtube.com/watch?v=${id}`;
          lienVideo.dataset.derniereVideo = id;
          if (typeof publiee === 'string') lienVideo.dataset.videoPubliee = publiee;
        };
        vignette.src = `/api/derniere-video/vignette?v=${id}`;
      })
      .catch((erreur: unknown) => console.error('[vidéo] dernière vidéo non relevée', erreur));
  }

  // La réponse de `/api/newsletter` tient en deux champs. Elle est vérifiée ici
  // à la main : importer zod dans le navigateur pour ces deux champs chargeait
  // toute la bibliothèque sur la page d'accueil. La validation qui compte,
  // celle de l'adresse et des réponses de Mailcheap, reste côté serveur, avec zod
  // (`lib/newsletter-signup.ts`).
  type Resultat = { status: 'pending' | 'subscribed' | 'error'; message: string };
  const STATUTS: readonly string[] = ['pending', 'subscribed', 'error'];
  const lireResultat = (brut: unknown): Resultat | null => {
    if (typeof brut !== 'object' || brut === null) return null;
    const { status, message } = brut as Record<string, unknown>;
    if (typeof status !== 'string' || !STATUTS.includes(status)) return null;
    if (typeof message !== 'string' || message.length === 0) return null;
    return { status: status as Resultat['status'], message };
  };
  const form = document.querySelector<HTMLFormElement>('#newsletter-form');
  const email = form?.querySelector<HTMLInputElement>('#newsletter-email');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const status = form?.querySelector<HTMLParagraphElement>('#newsletter-status');
  if (form && email && button && status) {
    // Le bouton sort désactivé du HTML : si ce script n'a pas tourné, un envoi
    // natif du formulaire afficherait la réponse JSON brute du serveur.
    button.disabled = false;
    const originalButton = button.innerHTML;
    let submitting = false;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (submitting || !form.reportValidity()) return;
      submitting = true;
      button.disabled = true;
      button.textContent = 'Inscription en cours…';
      form.setAttribute('aria-busy', 'true');
      status.hidden = false;
      status.dataset.state = 'loading';
      status.textContent = 'Votre demande est en cours d’envoi.';
      email.removeAttribute('aria-invalid');

      const submit = async () => {
        // `AbortSignal.timeout` manque avant Safari 16 : sur ces iPhone l'appel
        // levait avant même le `fetch`, et aucune inscription ne partait.
        const controleur = new AbortController();
        const minuterie = window.setTimeout(() => controleur.abort(), 25_000);
        try {
          const data = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: data.get('email'), website: data.get('website') }),
            signal: controleur.signal,
          });
          // Une page d'erreur du frontal (502 pendant un redémarrage) n'est pas du JSON.
          const result = lireResultat(await response.json().catch(() => null));
          if (!result) throw new Error(`Réponse d’inscription illisible (HTTP ${response.status})`);
          status.dataset.state = result.status;
          status.textContent = result.message;
          if (response.status === 422) email.setAttribute('aria-invalid', 'true');
          if (response.ok && result.status !== 'error') form.reset();
        } finally {
          window.clearTimeout(minuterie);
          submitting = false;
          button.disabled = false;
          button.innerHTML = originalButton;
          form.removeAttribute('aria-busy');
        }
      };
      submit().catch((erreur: unknown) => {
        console.error('[newsletter] envoi en échec', erreur);
        const nom = erreur instanceof Error ? erreur.name : '';
        status.dataset.state = 'error';
        // Trois causes, trois messages : ne pas envoyer le visiteur vérifier sa
        // connexion quand c'est le serveur qui ne répond pas.
        status.textContent =
          nom === 'AbortError' || nom === 'TimeoutError'
            ? 'Le serveur met trop de temps à répondre. Réessayez dans une minute.'
            : erreur instanceof TypeError && !navigator.onLine
              ? 'Vous semblez hors ligne. Vérifiez votre connexion puis réessayez.'
              : 'L’inscription n’a pas abouti de mon côté. Réessayez dans quelques instants.';
      });
    });
  }
</script>
