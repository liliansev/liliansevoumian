---
/*
 * ouverture : le premier plan de l'accueil « Le documentaire ».
 *
 * Lilian se présente avec la phrase qu'il a dictée (« Salut, je m'appelle
 * Lilian Sevoumian et je suis expert en Automatisations & Agents IA »), mise
 * en scène comme un titre de film : le nom en très grand, le reste à hauteur
 * de phrase. Sous le titre, à droite, la place de la barre où l'on écrit à
 * Lilian (`home-invite`, rendu après cette section dans `index.astro`, la pose
 * sur `[data-causerie-place]`).
 *
 * Dessous, plus large que la colonne du texte, le plan d'ouverture : sa photo
 * au bureau, au format cinémascope (4:5 sur téléphone), avec son incrustation
 * et un sous-titre. Il s'ouvre une fois au chargement, d'une fente horizontale
 * à l'image entière, pendant que le nom prend sa graisse. Rien d'autre ne bouge
 * sur le premier écran que le défilé des logos, qui a son bouton pause.
 *
 * Sans script, tout est là sauf la barre d'écriture. En mouvement réduit, le
 * plan est ouvert d'emblée.
 */
import { Image, getImage } from 'astro:assets';
import auBureau from '../../assets/lilian-au-bureau.jpg';
import DefileClients from './defile-clients.astro';

/* La lumière du plan : l'image en tout petit, que le flou agrandit. */
const lumiere = await getImage({ src: auBureau, width: 96, format: 'webp', quality: 60 });
---

<section id="hero" data-section data-motion-pause data-chapitre="Au bureau" data-lueur="lueur-froide lueur-froide" class="ouverture">
  <div class="ouverture__tete">
    <h1 class="ouverture__titre">
      <span class="ouverture__salut">Salut, je m’appelle</span>
      <span class="ouverture__nom">Lilian Sevoumian</span>
      <span class="ouverture__metier">et je suis expert en <mark>Automatisations&nbsp;&amp; Agents&nbsp;IA</mark></span>
    </h1>
    <div class="ouverture__ecrire">
      <div data-causerie-place></div>
      <p class="ouverture__mode">
        Écrivez votre besoin, puis choisissez comment me l’envoyer&nbsp;: WhatsApp, e-mail ou&nbsp;appel.
      </p>
    </div>
  </div>

  <figure class="ouverture__plan plan">
    <div class="plan__lumiere" style={`background-image: url(${lumiere.src})`} aria-hidden="true"></div>
    <div class="ouverture__cadre plan__cadre">
      <Image
        src={auBureau}
        alt="Lilian Sevoumian à son bureau, de dos, devant ses écrans ; sur le plus grand, un workflow ouvert."
        widths={[640, 1024, 1536, 2048]}
        sizes="(min-width: 1440px) 1376px, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <p class="incrustation"><b>Lilian Sevoumian</b><span>à son bureau, un workflow à l’écran</span></p>
    </div>
    <figcaption class="sous-titre ouverture__sous-titre">J’automatise d’abord mon propre travail.</figcaption>
  </figure>

  <DefileClients />
</section>

<style>
  .ouverture {
    padding-top: calc(var(--spacing-barre) + clamp(1.25rem, 3.5svh, 3rem));
  }

  /* ── Le titre, dans la colonne de 1200 px ── */
  .ouverture__tete {
    display: grid;
    gap: var(--spacing-groupe);
    max-width: calc(1200px + 2 * var(--spacing-section-x));
    margin-inline: auto;
    padding-inline: var(--spacing-section-x);
  }

  .ouverture__titre {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    font-weight: 500;
  }

  .ouverture__salut,
  .ouverture__metier {
    font-size: var(--text-phrase);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .ouverture__salut {
    color: var(--color-ink-mid);
  }

  .ouverture__nom {
    font-size: clamp(3.25rem, 7.2vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .ouverture__metier {
    max-width: 24ch;
    text-wrap: balance;
  }

  .ouverture__ecrire {
    display: grid;
    gap: 0.75rem;
    align-content: end;
  }

  .ouverture__mode {
    max-width: 38ch;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  @media (min-width: 1024px) {
    .ouverture__tete {
      grid-template-columns: minmax(0, 1fr) 24rem;
      align-items: end;
      column-gap: var(--spacing-gouttiere);
    }

    .ouverture__nom {
      white-space: nowrap;
    }
  }

  /* ── Le plan, plus large que la colonne ── */
  .ouverture__plan {
    display: grid;
    gap: clamp(1.25rem, 3svh, 2rem);
    max-width: calc(1376px + 2 * var(--spacing-cadre));
    margin: clamp(1.5rem, 4svh, 3rem) auto 0;
    padding-inline: var(--spacing-cadre);
  }

  .ouverture__plan .plan__lumiere {
    inset: 8% calc(var(--spacing-cadre) + 3%) 12%;
  }

  /* Le plan tient dans le premier écran, incrustation comprise : sur un écran
     bas, il s'étire en largeur plutôt que de passer sous le pli. */
  .ouverture__cadre {
    width: 100%;
    aspect-ratio: 2.39;
    max-height: max(26rem, calc(100svh - 24rem));
    border-radius: var(--radius-xl);
  }

  .ouverture__cadre :global(img) {
    object-position: 30% 38%;
  }

  @media (max-width: 767px) {
    .ouverture__cadre {
      aspect-ratio: 4 / 5;
      max-height: max(18rem, calc(100svh - 31rem));
    }

    .ouverture__cadre :global(img) {
      object-position: 20% 50%;
    }
  }

  /* ── L'ouverture : une fois, au chargement ── */
  @media (prefers-reduced-motion: no-preference) {
    .ouverture__nom {
      animation: nom-pose 1.5s var(--ease-out-expo) 0.1s both;
    }

    .ouverture__cadre {
      animation: plan-ouvre 1.6s var(--ease-out-expo) 0.4s both;
    }

    .ouverture__cadre :global(img) {
      animation: plan-recule 2.4s var(--ease-out-expo) 0.4s both;
    }

    /* La lumière ne s'allume qu'une fois le plan ouvert : derrière une fente,
       elle ne serait qu'un brouillard. */
    .ouverture__plan .plan__lumiere {
      animation: lumiere-allume 1.4s var(--ease-out-quint) 1.1s both;
    }

    .ouverture__cadre .incrustation {
      animation: incrustation-entre 0.9s var(--ease-out-expo) 1.45s both;
    }

    .ouverture__sous-titre {
      animation: sous-titre-entre 0.9s var(--ease-out-quint) 1.75s both;
    }
  }

  @keyframes nom-pose {
    from {
      font-weight: 200;
      opacity: 0.25;
    }
  }

  @keyframes plan-ouvre {
    from { clip-path: inset(46% 0 46% 0 round var(--radius-xl)); }
    to { clip-path: inset(0 round var(--radius-xl)); }
  }

  @keyframes lumiere-allume {
    from { opacity: 0; }
  }

  @keyframes plan-recule {
    from { transform: scale(1.12); }
  }

  @keyframes incrustation-entre {
    from {
      opacity: 0;
      transform: translateX(-0.75rem);
    }
  }

  @keyframes sous-titre-entre {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
  }

  .ouverture :global(.defile) {
    margin-top: clamp(1rem, 3svh, 2rem);
  }
</style>
