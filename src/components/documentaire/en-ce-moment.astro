---
/*
 * en-ce-moment : ce que Lilian construit en ce moment, agenceafk et Augmentés
 * (`data/projets.ts`, `enCours`).
 *
 * Deux plans côte à côte : la page d'accueil du site, telle qu'elle est en
 * ligne, sans fausse fenêtre de navigateur autour, et sa lumière sur la nuit.
 * Pas d'incrustation : elle couvrait le titre du site, et l'incrustation
 * nomme des personnes et des lieux, pas des pages. Les deux sites sont en
 * crème et lime : leurs captures sont à peine étalonnées vers la nuit (elles
 * paraissaient éteintes à 35 % de saturation), leur lumière est douce, et
 * elles retrouvent toutes leurs couleurs quand on les vise.
 */
import { Icon } from 'astro-icon/components';
import Chapitre from './chapitre.astro';
import { enCours } from '../../data/projets';

const goals: Record<string, string> = {
  'https://agenceafk.fr': 'outbound_agence',
  'https://augmentes.fr': 'outbound_formations',
};
const domaine = (href: string) => href.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Chapitre
  id="en-ce-moment"
  nom="En ce moment"
  lueur="peche lueur-froide"
  titre="Ce qui m’occupe en ce moment."
>
  <ul class="maintenant" role="list">
    {enCours.map((p) => (
      <li class="maintenant__projet reveal">
        <a
          class="maintenant__lien"
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          data-fast-goal={p.href ? goals[p.href] : undefined}
          data-fast-goal-source={p.href && goals[p.href] ? 'home_en_cours' : undefined}
        >
          <figure class="plan">
            {p.image && <div class="plan__lumiere plan__lumiere--douce" style={`background-image: url(${p.image})`} aria-hidden="true"></div>}
            <div class="maintenant__cadre plan__cadre media-ouvre">
              {p.image && <img src={p.image} alt="" width="1440" height="900" loading="lazy" decoding="async" />}
            </div>
          </figure>
          <h3 class="maintenant__nom">
            {p.nom}<span class="sr-only">, {p.etiquette?.toLowerCase()} (nouvel onglet)</span>
            <Icon name="lucide:arrow-up-right" size={22} aria-hidden="true" />
          </h3>
          <p class="maintenant__resume">{p.resume}</p>
          {p.href && <p class="maintenant__domaine">{domaine(p.href)}</p>}
        </a>
      </li>
    ))}
  </ul>
</Chapitre>

<style>
  .maintenant {
    display: grid;
    gap: var(--spacing-bloc) var(--spacing-gouttiere);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .maintenant {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Le second plan descend d'un cran : deux plans d'un même montage, pas
       deux cartes d'une grille. */
    .maintenant__projet:nth-child(2) {
      margin-top: clamp(1.5rem, 4vw, 3.5rem);
    }
  }

  .maintenant__projet {
    max-width: none;
  }

  .maintenant__lien {
    display: grid;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .maintenant__cadre {
    aspect-ratio: 16 / 10;
    margin-bottom: 0.75rem;
  }

  .maintenant__cadre img {
    object-position: top;
    filter: saturate(0.8) brightness(0.94);
    transition: filter 600ms var(--ease-out-quint);
  }

  .maintenant__lien:hover .maintenant__cadre img,
  .maintenant__lien:focus-visible .maintenant__cadre img {
    filter: none;
  }

  .maintenant__nom {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--text-title-lg);
    letter-spacing: -0.025em;
  }

  .maintenant__nom :global(svg) {
    color: var(--color-ink-low);
    transition: transform var(--duration-default) var(--ease-out-quint), color var(--duration-default) var(--ease-out-quint);
  }

  .maintenant__lien:hover .maintenant__nom :global(svg) {
    color: var(--color-peche);
    transform: translate(2px, -2px);
  }

  .maintenant__resume {
    max-width: 44ch;
    color: var(--color-ink-mid);
  }

  .maintenant__domaine {
    color: var(--color-ink-faint);
    font-size: var(--text-body-sm);
  }
</style>
