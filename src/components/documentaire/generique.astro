---
/*
 * generique : la fin de l'accueil « Le documentaire ».
 *
 * Le générique de fin, comme au cinéma, sur la nuit seule : un carton
 * centré (« Écrit et construit par », le nom en grand), puis les crédits sur
 * un axe central, à toutes les tailles d'écran : le rôle à gauche de l'axe,
 * aligné sur lui, les noms à droite, un par ligne. Sur un téléphone, les
 * rôles au-dessus de leurs noms, centrés, faisaient un nuage de mots aux
 * lignes inégales (Lilian, 14 octobre 2026 : « horrible le layout »).
 * Tout ce qui y figure est attesté ailleurs
 * sur le site : les entreprises viennent de `data/clients.ts`, les recommandations de
 * `voix.astro`, les outils de la page d'offre, la source des images de
 * `src/assets/documentaire/README.md`. Après le générique, la fin de page
 * commune (`fin-de-page`) : on écrit à Lilian.
 */
import FinDePage from '../fin-de-page.astro';
import { clients } from '../../data/clients';

const roles = [
  { role: 'Avec', noms: clients.map((c) => c.nom) },
  { role: 'Recommandé par', noms: ['Alexis Kovalenko', 'Ismail Landoulsi', 'Benjamin Potet'] },
  { role: 'Outils', noms: ['Make', 'n8n', 'Airtable', 'Notion'] },
  { role: 'Images', noms: ['Radio Contournement, à La Capsule', 'les archives de Lilian'] },
];
---

<div id="generique" data-chapitre="Générique" data-lueur="braise braise" class="generique">
  <section class="generique__rideau chapitre" aria-label="Générique">
    <div class="chapitre__colonne">
      <dl class="generique__liste reveal">
        <div class="generique__ligne generique__ligne--titre">
          <dt>Écrit et construit par</dt>
          <dd>Lilian Sevoumian</dd>
        </div>
        {roles.map((r) => (
          <div class="generique__ligne">
            <dt>{r.role}</dt>
            <dd>
              <ul role="list">
                {r.noms.map((nom) => <li>{nom}</li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <FinDePage id="contact" source="home_offres" titre="Un projet, une idée, une <mark>question&nbsp;?</mark>" />
</div>

<style>
  .generique__rideau {
    padding-bottom: 0;
  }

  .generique__liste {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    max-width: 48rem;
    margin: 0 auto;
  }

  /* L'axe du générique : le rôle s'appuie dessus à gauche, les noms partent
     de lui à droite, un par ligne, et chaque rôle s'aligne sur son premier
     nom. Sur un téléphone, l'axe glisse d'un cran à gauche pour laisser aux
     noms la place de tenir sur une ligne ; il revient au centre à 768 px. */
  .generique__ligne {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    column-gap: clamp(1rem, 3vw, 2.5rem);
    align-items: baseline;
  }

  .generique__ligne dt {
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    text-align: right;
  }

  .generique__ligne dd {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-body);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-align: left;
  }

  .generique__ligne ul {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .generique__ligne li {
    max-width: none;
    text-wrap: balance;
  }

  /* Le carton d'ouverture : centré, au-dessus de l'axe, le nom en grand,
     à la taille d'un carton de chapitre. */
  .generique__ligne--titre {
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0.5rem;
    margin-bottom: clamp(0.5rem, 2vw, 1rem);
    text-align: center;
  }

  .generique__ligne--titre :is(dt, dd) {
    text-align: center;
  }

  .generique__ligne--titre dd {
    font-size: var(--text-headline);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  @media (min-width: 768px) {
    .generique__ligne:not(.generique__ligne--titre) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .generique__ligne:not(.generique__ligne--titre) dd {
      font-size: var(--text-body-large);
    }

    /* Une longue liste de noms se lit sur deux colonnes, comme les seconds
       rôles d'un générique. */
    .generique__ligne ul:has(> li:nth-child(7)) {
      grid-template-columns: repeat(2, max-content);
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
      justify-content: start;
    }
  }

  /* La fin de page commune, sans la maille qu'elle porte sur les autres
     pages : ici la nuit et l'étalonnage suffisent. */
  .generique :global(.fin__grille) {
    display: none;
  }
</style>
