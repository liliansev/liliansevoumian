---
/*
 * generique : la fin de l'accueil « Le documentaire ».
 *
 * Le générique de fin, comme au cinéma, sur la nuit seule : sur un écran
 * large, les rôles à gauche d'un axe central, alignés sur lui, et les noms à
 * droite, un par ligne ; sur un téléphone, le rôle en petit au-dessus de ses
 * noms, centrés. Tout ce qui y figure est attesté ailleurs
 * sur le site : les entreprises viennent de `data/clients.ts`, les recommandations de
 * `voix.astro`, les outils de la page d'offre, la source des images de
 * `src/assets/documentaire/README.md`. Après le générique, la fin de page
 * commune (`fin-de-page`) : on écrit à Lilian.
 */
import FinDePage from '../fin-de-page.astro';
import { clients } from '../../data/clients';

const roles = [
  { role: 'Avec', noms: clients.map((c) => c.nom) },
  { role: 'Recommandé par', noms: ['Alexis Kovalenko', 'Ismail Landoulsi', 'Benjamin Potet'] },
  { role: 'Outils', noms: ['Make', 'n8n', 'Airtable', 'Notion'] },
  { role: 'Images', noms: ['Radio Contournement, à La Capsule', 'les archives de Lilian'] },
];
---

<div id="generique" data-chapitre="Générique" data-lueur="braise braise" class="generique">
  <section class="generique__rideau chapitre" aria-label="Générique">
    <div class="chapitre__colonne">
      <dl class="generique__liste reveal">
        <div class="generique__ligne generique__ligne--titre">
          <dt>Écrit et construit par</dt>
          <dd>Lilian Sevoumian</dd>
        </div>
        {roles.map((r) => (
          <div class="generique__ligne">
            <dt>{r.role}</dt>
            <dd>
              <ul role="list">
                {r.noms.map((nom) => <li>{nom}</li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <FinDePage id="contact" source="home_offres" titre="Un projet, une idée, une <mark>question&nbsp;?</mark>" />
</div>

<style>
  .generique__rideau {
    padding-bottom: 0;
  }

  .generique__liste {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .generique__ligne {
    display: grid;
    gap: 0.625rem;
  }

  .generique__ligne dt {
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .generique__ligne dd {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-body-large);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .generique__ligne ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .generique__ligne li {
    max-width: none;
  }

  .generique__ligne--titre dd {
    font-size: var(--text-title-lg);
    letter-spacing: -0.025em;
  }

  /* L'axe du générique : le rôle s'appuie dessus à gauche, les noms partent
     de lui à droite, et chaque rôle s'aligne sur son premier nom. */
  @media (min-width: 768px) {
    .generique__liste {
      max-width: 48rem;
      gap: clamp(2.5rem, 4vw, 3.5rem);
    }

    .generique__ligne {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
      align-items: baseline;
    }

    .generique__ligne dt {
      text-align: right;
    }

    .generique__ligne dd {
      text-align: left;
    }

    .generique__ligne ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
    }

    /* Une longue liste de noms se lit sur deux colonnes, comme les seconds
       rôles d'un générique. */
    .generique__ligne ul:has(> li:nth-child(7)) {
      display: grid;
      grid-template-columns: repeat(2, max-content);
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
      justify-content: start;
    }
  }

  /* La fin de page commune, sans la maille qu'elle porte sur les autres
     pages : ici la nuit et l'étalonnage suffisent. */
  .generique :global(.fin__grille) {
    display: none;
  }
</style>
