---
/*
 * affiches : ce que Lilian construit pour lui (`data/projets.ts`, `persos`).
 *
 * Chaque projet a son affiche, comme un film à l'affiche : l'image en haut, le
 * titre en grand en bas (c'est le titre du projet, il n'est écrit qu'une fois),
 * et sous le titre une ligne de générique faite de son genre et de ses
 * mots-clés. Un projet qui a une capture la montre ; les sites de jeux portent
 * un emblème dessiné (une flamme, une rune, un dragon) dans la couleur du jeu.
 * Sous l'affiche, une phrase et l'adresse.
 *
 * Sur téléphone, les affiches se suivent sur une bande qui défile au doigt.
 */
import { Icon } from 'astro-icon/components';
import Chapitre from './chapitre.astro';
import { persos } from '../../data/projets';

const domaine = (href: string) => href.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Chapitre
  id="projets-perso"
  nom="Projets perso"
  lueur="lueur-froide braise"
  titre="Ce que je construis <mark>pour moi.</mark>"
  chapo="Des outils, et des sites pour les jeux auxquels je joue."
>
  <ul class="affiches" role="list">
    {persos.map((p) => {
      const Balise = p.href ? 'a' : 'div';
      return (
        <li class:list={['affiches__projet reveal', p.embleme && `affiche--${p.embleme}`]}>
          <Balise
            class="affiches__lien"
            href={p.href}
            target={p.href ? '_blank' : undefined}
            rel={p.href ? 'noopener noreferrer' : undefined}
          >
            <div class="affiche">
              {p.image ? (
                <img class="affiche__capture" src={p.image} alt="" width="1440" height="900" loading="lazy" decoding="async" />
              ) : (
                <svg class="affiche__art" viewBox="0 0 200 220" fill="none" aria-hidden="true">
                  <circle class="a-anneau" cx="100" cy="104" r="92" />
                  <circle class="a-anneau a-anneau--fin" cx="100" cy="104" r="74" stroke-dasharray="2 6" />
                  <circle class="a-anneau" cx="100" cy="104" r="56" />
                  <g transform="translate(40 44)">
                    {p.embleme === 'flamme' && (
                      <>
                        <path class="e-fond" d="M60 12c6 18 26 30 26 56a26 26 0 0 1-52 0c0-12 6-20 12-26 0 10 4 16 10 18-4-16 0-34 4-48z" />
                        <path class="e-trait" d="M60 12c6 18 26 30 26 56a26 26 0 0 1-52 0c0-12 6-20 12-26 0 10 4 16 10 18-4-16 0-34 4-48z" />
                        <path class="e-accent" d="M60 60c4 8 12 12 12 22a12 12 0 0 1-24 0c0-6 4-10 6-12 0 4 2 6 4 6-1-6 0-12 2-16z" />
                        <circle class="e-accent" cx="88" cy="22" r="2" />
                        <circle class="e-accent" cx="30" cy="34" r="1.5" />
                        <circle class="e-accent" cx="96" cy="44" r="1.2" />
                      </>
                    )}
                    {p.embleme === 'rune' && (
                      <>
                        <path class="e-fond" d="M40 14h40l14 30-6 62H32l-6-62z" />
                        <path class="e-trait" d="M40 14h40l14 30-6 62H32l-6-62z" />
                        <path class="e-accent-trait" d="M60 34v52M60 46l14-10M60 58l-14-10M60 70l14 10" />
                      </>
                    )}
                    {p.embleme === 'dragon' && (
                      <>
                        <path class="e-fond" d="M14 84c14-6 22-22 26-40 6 10 10 14 20 16 4-16 14-28 30-34-4 12-4 22 2 30 6-4 10-10 14-16 2 22-8 42-30 50-16 6-40 6-62-6z" />
                        <path class="e-trait" d="M14 84c14-6 22-22 26-40 6 10 10 14 20 16 4-16 14-28 30-34-4 12-4 22 2 30 6-4 10-10 14-16 2 22-8 42-30 50-16 6-40 6-62-6z" />
                        <circle class="e-accent" cx="84" cy="52" r="4" />
                        <path class="e-accent-trait" d="M30 96c16 4 34 2 48-6" />
                      </>
                    )}
                  </g>
                </svg>
              )}
              <h3 class="affiche__titre">{p.nom}</h3>
              <p class="affiche__generique">{[p.etiquette, ...(p.tags ?? [])].filter(Boolean).join(' · ')}</p>
            </div>
            <p class="affiches__resume">{p.resume}</p>
            {p.href && (
              <p class="affiches__domaine">
                {domaine(p.href)}
                <Icon name="lucide:arrow-up-right" size={16} aria-hidden="true" />
                <span class="sr-only"> (nouvel onglet)</span>
              </p>
            )}
          </Balise>
        </li>
      );
    })}
  </ul>
</Chapitre>

<style>
  .affiches {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-lie);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Sur téléphone et tablette : une bande d'affiches, au doigt. */
  @media (max-width: 1023px) {
    .affiches {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(68vw, 18rem);
      margin-inline: calc(-1 * var(--spacing-section-x));
      padding-inline: var(--spacing-section-x);
      padding-bottom: 0.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--spacing-section-x);
      scrollbar-width: none;
    }

    .affiches::-webkit-scrollbar {
      display: none;
    }

    .affiches__projet {
      scroll-snap-align: start;
    }
  }

  .affiches__projet {
    --teinte: var(--color-peche);
    max-width: none;
  }

  .affiche--flamme { --teinte: var(--color-braise); }
  .affiche--rune { --teinte: var(--color-lueur-froide); }
  .affiche--dragon { --teinte: var(--color-peche-clair); }

  .affiches__lien {
    display: grid;
    gap: 0.625rem;
    color: inherit;
    text-decoration: none;
  }

  /* ── L'affiche ── */
  .affiche {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto auto;
    aspect-ratio: 2 / 3;
    margin-bottom: 0.625rem;
    padding: 0 1rem 1.125rem;
    overflow: clip;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(80% 55% at 50% 40%, color-mix(in srgb, var(--teinte) 26%, transparent), transparent 78%),
      linear-gradient(to bottom, color-mix(in srgb, var(--teinte) 8%, var(--color-surface-low)), var(--color-night-deep) 85%);
    isolation: isolate;
  }

  .affiche__capture {
    position: absolute;
    inset: 0 0 34%;
    z-index: -1;
    width: 100%;
    height: 66%;
    object-fit: cover;
    object-position: top left;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
    filter: saturate(0.6) brightness(0.9);
    transition: filter 600ms var(--ease-out-quint);
  }

  .affiche__art {
    align-self: center;
    width: 100%;
    height: auto;
    transition: transform 900ms var(--ease-out-expo);
  }

  /* La capture est posée en absolu : le titre et le générique prennent
     d'eux-mêmes les deux dernières rangées, avec ou sans dessin au-dessus. */
  .affiche__titre {
    grid-row: 2;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  /* Deux lignes réservées : les titres des quatre affiches restent alignés. */
  .affiche__generique {
    grid-row: 3;
    min-height: 2.8em;
    margin: 0.625rem 0 0;
    color: color-mix(in srgb, var(--teinte) 55%, var(--color-ink-mid));
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .a-anneau {
    stroke: color-mix(in srgb, var(--teinte) 30%, transparent);
    stroke-width: 0.75;
  }

  .a-anneau--fin {
    stroke: color-mix(in srgb, var(--teinte) 50%, transparent);
  }

  .affiche__art .e-fond {
    fill: color-mix(in srgb, var(--teinte) 16%, var(--color-surface-high));
  }

  .affiche__art .e-trait {
    stroke: color-mix(in srgb, var(--teinte) 70%, var(--color-ink));
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .affiche__art .e-accent {
    fill: var(--teinte);
  }

  .affiche__art .e-accent-trait {
    stroke: var(--teinte);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    a.affiches__lien:hover .affiche__art {
      transform: scale(1.04);
    }

    a.affiches__lien:hover .affiche__capture {
      filter: none;
    }
  }

  /* ── Sous l'affiche ── */
  .affiches__resume {
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
  }

  .affiches__domaine {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    transition: color var(--duration-quick) var(--ease-out-quint);
  }

  a.affiches__lien:hover .affiches__domaine,
  a.affiches__lien:focus-visible .affiches__domaine {
    color: var(--color-peche);
  }

  @media (prefers-reduced-motion: reduce) {
    .affiche__art,
    .affiche__capture {
      transition: none;
    }
  }
</style>
