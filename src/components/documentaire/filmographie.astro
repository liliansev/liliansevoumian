---
/*
 * filmographie : ce que Lilian construit pour lui (`data/projets.ts`,
 * `persos`).
 *
 * La liste de ses projets perso se lit comme la filmographie d'un générique :
 * un titre par ligne, en grand, son genre et ses mots-clés à côté, une phrase,
 * l'adresse. Pas de vignette : deux des quatre projets n'ont pas encore de
 * page à montrer, et un dessin à leur place n'aurait été qu'un ornement.
 * Un projet en ligne est un lien vers son site ; au survol, son titre glisse
 * et prend la pêche.
 */
import { Icon } from 'astro-icon/components';
import Chapitre from './chapitre.astro';
import { persos } from '../../data/projets';

const domaine = (href: string) => href.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Chapitre
  id="projets-perso"
  nom="Projets perso"
  lueur="braise peche"
  titre="Ce que je construis <mark>pour moi.</mark>"
  chapo="Des outils, et des sites pour les jeux auxquels je joue."
>
  <ul class="filmo" role="list">
    {persos.map((p) => {
      const Balise = p.href ? 'a' : 'div';
      return (
        <li class="filmo__titre reveal">
          <Balise
            class="filmo__ligne"
            href={p.href}
            target={p.href ? '_blank' : undefined}
            rel={p.href ? 'noopener noreferrer' : undefined}
          >
            <h3 class="filmo__nom">{p.nom}</h3>
            <p class="filmo__genre">{[p.etiquette, ...(p.tags ?? [])].filter(Boolean).join(' · ')}</p>
            <p class="filmo__resume">{p.resume}</p>
            {p.href && (
              <p class="filmo__adresse">
                {domaine(p.href)}
                <Icon name="lucide:arrow-up-right" size={16} aria-hidden="true" />
                <span class="sr-only"> (nouvel onglet)</span>
              </p>
            )}
          </Balise>
        </li>
      );
    })}
  </ul>
</Chapitre>

<style>
  .filmo {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  .filmo__titre {
    max-width: none;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  .filmo__ligne {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    color: inherit;
    text-decoration: none;
  }

  .filmo__nom {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-headline);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    transition:
      color var(--duration-default) var(--ease-out-quint),
      transform 600ms var(--ease-out-expo);
  }

  .filmo__genre {
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .filmo__resume {
    max-width: 46ch;
    color: var(--color-ink-mid);
  }

  .filmo__adresse {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    transition: color var(--duration-quick) var(--ease-out-quint);
  }

  /* Sur un écran large, la ligne d'un générique : le titre à gauche, le reste
     en deux colonnes à droite, alignés sur le haut du titre. */
  @media (min-width: 900px) {
    .filmo__ligne {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 2fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--spacing-gouttiere);
      align-items: baseline;
    }

    .filmo__nom { grid-area: 1 / 1 / span 2; }
    .filmo__genre { grid-area: 1 / 2; }
    .filmo__resume { grid-area: 2 / 2; }
    .filmo__adresse { grid-area: 1 / 3; justify-self: end; }
  }

  @media (hover: hover) and (pointer: fine) {
    a.filmo__ligne:hover .filmo__nom {
      color: var(--color-peche);
      transform: translateX(0.5rem);
    }
  }

  a.filmo__ligne:hover .filmo__adresse,
  a.filmo__ligne:focus-visible .filmo__adresse {
    color: var(--color-peche);
  }

  a.filmo__ligne:focus-visible {
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .filmo__nom {
      transition: color var(--duration-default) linear;
    }

    a.filmo__ligne:hover .filmo__nom {
      transform: none;
    }
  }
</style>
