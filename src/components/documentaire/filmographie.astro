---
/*
 * filmographie : ce que Lilian construit pour lui (`data/projets.ts`,
 * `persos`).
 *
 * La liste de ses projets perso se lit comme la filmographie d'un générique :
 * un titre par ligne, en grand, son genre et ses mots-clés à côté, une phrase,
 * l'adresse, et au bout de la ligne un photogramme : la page d'accueil du
 * site, en petit, avec sa lumière douce (demande de Lilian, 14 octobre 2026 :
 * « une mini capture d'écran »). Un projet sans capture n'a pas de
 * photogramme, et sa phrase prend la place ; on ne dessine rien à sa place.
 * Un projet en ligne est un lien vers son site ; au survol, son titre glisse
 * et prend la pêche, et le photogramme retrouve toutes ses couleurs.
 */
import { Icon } from 'astro-icon/components';
import Chapitre from './chapitre.astro';
import { persos } from '../../data/projets';

const domaine = (href: string) => href.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Chapitre
  id="projets-perso"
  nom="Projets perso"
  lueur="braise peche"
  titre="Ce que je construis pour moi."
  chapo="Des outils, et des sites pour les jeux auxquels je joue."
>
  <ul class="filmo" role="list">
    {persos.map((p) => {
      const Balise = p.href ? 'a' : 'div';
      return (
        <li class="filmo__titre reveal">
          <Balise
            class="filmo__ligne"
            href={p.href}
            target={p.href ? '_blank' : undefined}
            rel={p.href ? 'noopener noreferrer' : undefined}
          >
            <h3 class="filmo__nom">{p.nom}</h3>
            <p class="filmo__genre">{[p.etiquette, ...(p.tags ?? [])].filter(Boolean).join(' · ')}</p>
            <p class="filmo__resume">{p.resume}</p>
            {p.href && (
              <p class="filmo__adresse">
                {domaine(p.href)}
                <Icon name="lucide:arrow-up-right" size={16} aria-hidden="true" />
                <span class="sr-only"> (nouvel onglet)</span>
              </p>
            )}
            {p.image && (
              <figure class="filmo__photogramme plan" aria-hidden="true">
                <div class="plan__lumiere plan__lumiere--douce" style={`background-image: url(${p.image})`}></div>
                <div class="filmo__cadre plan__cadre">
                  <img src={p.image} alt="" width="1440" height="900" loading="lazy" decoding="async" />
                </div>
              </figure>
            )}
          </Balise>
        </li>
      );
    })}
  </ul>
</Chapitre>

<style>
  .filmo {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  .filmo__titre {
    max-width: none;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  .filmo__ligne {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    color: inherit;
    text-decoration: none;
  }

  .filmo__nom {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-headline);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    transition:
      color var(--duration-default) var(--ease-out-quint),
      transform 600ms var(--ease-out-expo);
  }

  .filmo__genre {
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .filmo__resume {
    max-width: 46ch;
    color: var(--color-ink-mid);
  }

  .filmo__adresse {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    justify-self: start;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    transition: color var(--duration-quick) var(--ease-out-quint);
  }

  /* Le photogramme : la page d'accueil du site, calée en haut, à peine
     étalonnée comme les captures d'« En ce moment ». Sur téléphone, il ouvre
     la ligne. */
  .filmo__photogramme {
    order: -1;
    margin: 0 0 0.75rem;
  }

  /* Un filet d'encre : une capture sombre (Flameborn) se fondait dans la
     nuit et ne se lisait plus comme un cadre. */
  .filmo__cadre {
    aspect-ratio: 16 / 10;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-radius: var(--radius-md);
  }

  .filmo__cadre img {
    object-position: top;
    filter: saturate(0.8) brightness(0.94);
    transition:
      filter 600ms var(--ease-out-quint),
      transform 900ms var(--ease-out-expo);
  }

  a.filmo__ligne:hover .filmo__cadre img,
  a.filmo__ligne:focus-visible .filmo__cadre img {
    filter: none;
  }

  /* Sur un écran large, la ligne d'un générique : le titre à gauche, le genre,
     la phrase et l'adresse au milieu, alignés sur le haut du titre, et le
     photogramme au bout de la ligne. */
  @media (min-width: 900px) {
    .filmo__ligne {
      grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
      grid-template-rows: auto auto 1fr;
      column-gap: var(--spacing-gouttiere);
      row-gap: 0.75rem;
      align-items: start;
    }

    .filmo__nom { grid-area: 1 / 1 / span 3; }
    .filmo__genre { grid-area: 1 / 2; padding-top: 0.5rem; }
    .filmo__resume { grid-area: 2 / 2; }
    .filmo__adresse { grid-area: 3 / 2; align-self: end; }

    .filmo__photogramme {
      grid-area: 1 / 3 / span 3;
      order: 0;
      margin: 0;
    }

    /* Sans photogramme, la phrase prend la place de la colonne vide. */
    .filmo__ligne:not(:has(.filmo__photogramme)) :is(.filmo__genre, .filmo__resume, .filmo__adresse) {
      grid-column: 2 / span 2;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    a.filmo__ligne:hover .filmo__nom {
      color: var(--color-peche);
      transform: translateX(0.5rem);
    }

    a.filmo__ligne:hover .filmo__cadre img {
      transform: scale(1.03);
    }
  }

  a.filmo__ligne:hover .filmo__adresse,
  a.filmo__ligne:focus-visible .filmo__adresse {
    color: var(--color-peche);
  }

  a.filmo__ligne:focus-visible {
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .filmo__nom {
      transition: color var(--duration-default) linear;
    }

    a.filmo__ligne:hover .filmo__nom,
    a.filmo__ligne:hover .filmo__cadre img {
      transform: none;
    }
  }
</style>
