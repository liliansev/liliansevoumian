---
/*
 * home-voices — trois recommandations, une voix à la fois.
 *
 * Une seule citation occupe la scène, et les trois personnes sont à côté, sur
 * un rail. Le rail se remplit pendant qu'une voix parle, puis passe à la
 * suivante ; on peut aussi choisir qui écouter, et le déroulé s'arrête alors
 * pour de bon.
 *
 * La citation est un rang SOUS le titre de la section (`--text-phrase`). Elle
 * prenait sa taille exacte : « Un vrai bonheur de travailler avec Lilian » se
 * lisait comme la suite du titre, en 48 px. La critique du 2 octobre 2026
 * proposait de mettre à la place les résultats chiffrés des cas clients, en
 * grand. Lilian a refusé : un visiteur qui ne se reconnaît dans aucun des cas
 * montrés peut se dire que ce n'est pas pour lui. Les cas restent donc une
 * sortie discrète, en bas, et ce sont des personnes qui parlent ici.
 *
 * Ce sont des recommandations, pas des rapports de mission : aucune ne porte
 * de chiffre. Les chiffres sont dans les cas clients, et le lien du bas y mène.
 *
 * Les citations et leurs coupes viennent de `Testimonials.astro`, qui reste le
 * composant des pages d'offre : mêmes mots, même règle (on ne retire que des
 * phrases entières, on ne reformule rien).
 *
 * Sans script, les trois citations se lisent à la suite, chacune avec son
 * auteur. En mouvement réduit, rien n'avance seul. Hors écran, le déroulé est
 * suspendu par `data-motion-pause` (voir Layout).
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import LinkCTA from './LinkCTA.astro';
import SectionHeader from './SectionHeader.astro';
import ismailImg from '../assets/testimonials/ismail.jpeg';
import alexisImg from '../assets/testimonials/alexis.jpeg';
import benjaminImg from '../assets/testimonials/benjamin.png';

const voix = [
  /* La première voix est celle qui dit ce pour quoi on vient : l'expertise en
     automatisation. La page s'ouvrait sur la plus générale des trois. */
  {
    citation:
      'J’ai la chance d’avoir collaboré à de nombreuses reprises avec\u00a0Lilian. Je peux témoigner de son expertise en automatisation.',
    nom: 'Alexis Kovalenko',
    role: 'Cofondateur, Contournement',
    image: alexisImg,
  },
  {
    citation: 'Un vrai bonheur de travailler avec Lilian sur des sujets de connectivité via Make.',
    nom: 'Ismail Landoulsi',
    role: 'Cofondateur & COO, CasanovaParis',
    image: ismailImg,
  },
  {
    citation: 'Les projets qu’il prend en\u00a0charge sont un succès.',
    nom: 'Benjamin Potet',
    role: 'Solution Architect Customer Experience, Make',
    image: benjaminImg,
  },
];

/* Le nombre de cas publiés vient de la collection : le lien ne peut pas en
   annoncer un de plus ou de moins que la page d'arrivée. */
const nombres = ['zéro', 'un', 'deux', 'trois', 'quatre', 'cinq', 'six', 'sept', 'huit', 'neuf', 'dix'];
const cas = (await getCollection('cas-clients')).length;
const nombreDeCas = nombres[cas] ?? String(cas);
---

<section
  id="temoignages"
  data-section
  data-motion-pause
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">
    <SectionHeader title="Ils m’ont vu travailler." titleMaxWidth="18ch" rule={false} spacing="none" />

    <div class="voix reveal" data-voix>
      <div class="voix__rail" role="tablist" aria-label="Qui parle">
        {voix.map((v, i) => (
          <button
            type="button"
            class="voix__qui"
            role="tab"
            id={`voix-onglet-${i}`}
            aria-controls={`voix-citation-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <Image
              src={v.image}
              alt=""
              width={88}
              height={88}
              format="webp"
              quality={82}
              class="voix__portrait"
              loading="lazy"
            />
            <span class="voix__nom">{v.nom}</span>
            <span class="voix__role">{v.role}</span>
          </button>
        ))}
      </div>

      {/* `tabindex="0"` : un panneau sans élément focalisable doit pouvoir
          recevoir le focus, pour qu'on y arrive depuis son onglet. Avec le
          script, seul le panneau montré le garde (voir `choisir`). */}
      {voix.map((v, i) => (
        <figure
          class="voix__citation"
          role="tabpanel"
          id={`voix-citation-${i}`}
          aria-labelledby={`voix-onglet-${i}`}
          tabindex="0"
          data-actif={i === 0 ? '' : undefined}
        >
          <blockquote>«&nbsp;{v.citation}&nbsp;»</blockquote>
          <figcaption><b>{v.nom}</b>, {v.role}</figcaption>
        </figure>
      ))}

      {/* La sortie vers les cas, discrète, dans la colonne du rail. */}
      <p class="voix__suite">
        <LinkCTA href="/cas-clients">Lire les {nombreDeCas} cas clients, avec leurs chiffres</LinkCTA>
      </p>
    </div>
  </div>
</section>

<style>
  /* ── Sans script : trois citations à la suite, chacune signée. Le rail, qui
        ne servirait à rien, n'est pas montré. ── */
  .voix {
    --duree: 7s;
    display: grid;
    gap: var(--spacing-groupe);
    margin-top: var(--spacing-groupe);
  }

  .voix:not([data-pret]) .voix__rail {
    display: none;
  }

  /* L'arrondi ne se voit qu'au focus clavier : il arrondit l'anneau. */
  .voix__citation {
    margin: 0;
    border-radius: var(--radius-xs);
  }

  .voix__citation blockquote {
    max-width: 24ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-phrase);
    font-weight: 500;
    line-height: var(--leading-phrase);
    letter-spacing: var(--tracking-phrase);
    text-wrap: balance;
  }

  .voix__citation figcaption {
    margin-top: 0.75rem;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .voix__citation figcaption b {
    color: var(--color-ink-mid);
    font-weight: 500;
  }

  .voix__suite {
    margin: 0;
  }

  /* ── Avec script : une scène à gauche, le rail et la sortie à droite. Les
        trois citations occupent la même case, la scène a donc toujours la
        hauteur de la plus longue et rien ne bouge autour quand la voix
        change. ── */
  .voix[data-pret] {
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: var(--spacing-gouttiere);
    row-gap: var(--spacing-lie);
    align-items: start;
  }

  .voix[data-pret] .voix__citation {
    grid-column: 1;
    grid-row: 1 / span 2;
    visibility: hidden;
    opacity: 0;
    filter: blur(10px);
    transition:
      opacity 420ms var(--ease-out-quint),
      filter 420ms var(--ease-out-quint),
      visibility 0s linear 420ms;
  }

  .voix[data-pret] .voix__citation[data-actif] {
    visibility: visible;
    opacity: 1;
    filter: none;
    transition-delay: 120ms, 120ms, 0s;
  }

  /* Le rail dit déjà qui parle : la signature sous la citation ferait doublon. */
  .voix[data-pret] .voix__citation figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .voix__rail {
    grid-column: 2;
    grid-row: 1;
    display: grid;
  }

  /* Sous le rail, alignée sur les noms : sous la citation, elle flottait à
     150 ou 210 px d'elle quand la citation était courte. */
  .voix[data-pret] .voix__suite {
    grid-column: 2;
    grid-row: 2;
    padding-left: 1.5rem;
  }

  .voix__qui {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1rem;
    align-items: center;
    min-height: 76px;
    padding: 0.75rem 0.75rem 0.75rem 1.5rem;
    border: 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: transparent;
    color: var(--color-ink-mid);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color var(--duration-default) var(--ease-out-quint);
  }

  /* Le rail : un segment par voix. Celui de la voix qui parle se remplit de
     pêche de haut en bas, le temps qu'elle a la parole. */
  .voix__qui::before,
  .voix__qui::after {
    content: '';
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 2px;
    border-radius: var(--radius-full);
  }

  .voix__qui::before {
    background: color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .voix__qui::after {
    background: var(--color-peche);
    transform: scaleY(0);
    transform-origin: 50% 0;
  }

  .voix__qui[aria-selected='true'] {
    color: var(--color-ink);
  }

  .voix__qui[aria-selected='true']::after {
    transform: none;
  }

  .voix__qui :global(.voix__portrait) {
    grid-row: 1 / span 2;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    object-fit: cover;
    opacity: 0.55;
    transition: opacity var(--duration-default) var(--ease-out-quint);
  }

  .voix__qui[aria-selected='true'] :global(.voix__portrait) {
    opacity: 1;
  }

  .voix__nom {
    align-self: end;
    font-weight: 500;
    line-height: 1.35;
  }

  .voix__role {
    align-self: start;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.35;
  }

  @media (hover: hover) and (pointer: fine) {
    .voix__qui:hover {
      color: var(--color-ink);
    }

    .voix__qui:hover :global(.voix__portrait) {
      opacity: 1;
    }
  }

  /* Le déroulé : tant que personne n'a choisi, le segment de la voix active se
     remplit, et sa fin passe la parole (voir le script). Il se suspend quand
     on survole ou qu'on a le focus dans le composant. */
  @media (prefers-reduced-motion: no-preference) {
    .voix[data-pret]:not([data-manuel]) .voix__qui[aria-selected='true']::after {
      animation: voix-temps var(--duree) linear both;
    }

    .voix:hover .voix__qui::after,
    .voix:focus-within .voix__qui::after {
      animation-play-state: paused;
    }
  }

  @keyframes voix-temps {
    from { transform: scaleY(0); }
  }

  @keyframes voix-temps-plat {
    from { transform: scaleX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .voix[data-pret] .voix__citation {
      filter: none;
      transition: none;
    }
  }

  /* ── Une colonne : le rail passe AU-DESSUS de la citation, en trois onglets
        côte à côte (un portrait, un nom), leur segment couché dessous. Posé
        après elle, il se retrouvait à 137 px d'une citation courte : les trois
        partagent la hauteur de la plus longue. Le rôle, qui ne tient plus dans
        l'onglet, revient sous la citation avec la signature. ── */
  @media (max-width: 899px) {
    .voix[data-pret] {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      row-gap: var(--spacing-groupe);
    }

    .voix__rail {
      grid-column: 1;
      grid-row: 1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 0.75rem;
    }

    .voix[data-pret] .voix__citation {
      grid-row: 2;
    }

    .voix[data-pret] .voix__suite {
      grid-column: 1;
      grid-row: 3;
      padding-left: 0;
    }

    .voix[data-pret] .voix__citation figcaption {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }

    .voix__qui {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      justify-items: start;
      row-gap: 0.5rem;
      min-height: 0;
      padding: 0 0 0.75rem;
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    }

    .voix__qui::before,
    .voix__qui::after {
      top: auto;
      right: 0;
      bottom: 0;
      width: auto;
      height: 2px;
    }

    .voix__qui::after {
      transform: scaleX(0);
      transform-origin: 0 50%;
    }

    .voix__qui :global(.voix__portrait) {
      grid-row: auto;
    }

    .voix__nom {
      font-size: var(--text-body-sm);
    }

    .voix__role {
      display: none;
    }
  }

  @media (max-width: 899px) and (prefers-reduced-motion: no-preference) {
    .voix[data-pret]:not([data-manuel]) .voix__qui[aria-selected='true']::after {
      animation-name: voix-temps-plat;
    }
  }
</style>

<script>
  /* Les trois voix sont des onglets : flèches pour passer de l'une à l'autre,
     une seule dans l'ordre de tabulation. Choisir une voix arrête le déroulé. */
  const racine = document.querySelector<HTMLElement>('[data-voix]');
  if (racine) {
    const onglets = [...racine.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const citations = [...racine.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actif = 0;

    const choisir = (rang: number, parLaMain = false) => {
      actif = (rang + onglets.length) % onglets.length;
      onglets.forEach((onglet, i) => {
        onglet.setAttribute('aria-selected', String(i === actif));
        onglet.tabIndex = i === actif ? 0 : -1;
      });
      citations.forEach((citation, i) => {
        citation.toggleAttribute('data-actif', i === actif);
        /* Seul le panneau montré se prend à la tabulation : celui qui s'efface
           reste visible 420 ms, et y entrer faisait perdre le focus. */
        citation.tabIndex = i === actif ? 0 : -1;
      });
      if (parLaMain) {
        racine.dataset.manuel = '';
        onglets[actif].focus({ preventScroll: true });
      }
    };

    const TOUCHES: Record<string, (i: number) => number> = {
      ArrowDown: (i) => i + 1,
      ArrowRight: (i) => i + 1,
      ArrowUp: (i) => i - 1,
      ArrowLeft: (i) => i - 1,
      Home: () => 0,
      End: () => onglets.length - 1,
    };

    onglets.forEach((onglet, i) => {
      onglet.addEventListener('click', () => choisir(i, true));
      onglet.addEventListener('keydown', (e) => {
        const vers = TOUCHES[e.key];
        if (!vers) return;
        e.preventDefault();
        choisir(vers(i), true);
      });
      /* La fin du segment passe la parole. En mouvement réduit le segment ne
         s'anime pas, donc rien n'avance seul ; la garde le dit en clair. */
      onglet.addEventListener('animationend', (e) => {
        if (reduit || !e.animationName.startsWith('voix-temps') || 'manuel' in racine.dataset) return;
        choisir(actif + 1);
      });
    });

    racine.dataset.pret = '';
    choisir(0);
  }
</script>
