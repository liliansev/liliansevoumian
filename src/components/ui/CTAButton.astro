---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  text: string;
  variant?: 'primary' | 'secondary' | 'inverted';
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
  showArrow?: boolean;
}

const {
  href,
  text,
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  showArrow = true
} = Astro.props;

const sizeClasses = {
  sm: 'px-6 py-3 text-sm gap-2',
  md: 'px-7 py-3.5 text-sm gap-2',
  lg: 'px-8 py-4 text-base gap-3'
};

const iconSizes = {
  sm: 'w-3.5 h-3.5',
  md: 'w-4 h-4',
  lg: 'w-4 h-4'
};

const variantClasses = {
  primary: 'bg-black text-white hover:bg-zinc-800 active:bg-zinc-900',
  secondary: 'bg-white text-black border border-black hover:bg-zinc-50 active:bg-zinc-100',
  inverted: 'bg-white text-black hover:bg-zinc-100 active:bg-zinc-200'
};

const baseClasses = 'group inline-flex items-center justify-center font-semibold rounded-lg transition-all duration-200 ease-out';
const widthClass = fullWidth ? 'w-full' : '';

const classes = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${widthClass}`;
---

<a href={href} class={classes}>
  {text}
  {showArrow && (
    <Icon
      name="lucide:arrow-right"
      class={`${iconSizes[size]} transition-transform group-hover:translate-x-1`}
    />
  )}
</a>
