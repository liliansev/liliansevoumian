---
import type { CaseStudy } from '../../types/case-study';

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
---

<a
  href={`/cas-clients/${caseStudy.slug}`}
  class="group block bg-white rounded-2xl border border-zinc-200 p-6 card-interactive"
>
  <!-- Tags -->
  {caseStudy.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {caseStudy.tags.map(tag => (
        <span class="px-2.5 py-1 bg-zinc-100 text-zinc-600 text-xs font-medium rounded-lg">
          {tag}
        </span>
      ))}
    </div>
  )}

  <!-- Title -->
  <h3 class="fluid-h5 font-semibold text-zinc-900 mb-5 group-hover:text-zinc-700 transition-colors">
    {caseStudy.title}
  </h3>

  <!-- KPIs -->
  {caseStudy.kpis.length > 0 && (
    <div class="grid grid-cols-3 gap-3 mb-5">
      {caseStudy.kpis.map(kpi => (
        <div class="text-center p-3 bg-zinc-50 rounded-xl">
          <p class="fluid-h4 font-semibold text-zinc-900 mb-1">
            {kpi.value}
          </p>
          <p class="text-xs text-zinc-500 leading-tight">
            {kpi.label}
          </p>
        </div>
      ))}
    </div>
  )}

  <!-- Tools -->
  {caseStudy.tools.length > 0 && (
    <div class="flex flex-wrap gap-2 pt-4 border-t border-zinc-100">
      {caseStudy.tools.map(tool => (
        <span class="px-2 py-1 text-xs text-zinc-500 bg-zinc-50 rounded-md font-medium">
          {tool}
        </span>
      ))}
    </div>
  )}
</a>
