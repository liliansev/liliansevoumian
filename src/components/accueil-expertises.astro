---
/*
 * accueil-expertises : les quatre expertises, chacune avec son dessin.
 *
 * Lilian a trouvé la liste de texte « très basique » (14 octobre 2026) et a
 * demandé des visuels, des icônes, des SVG. Chaque carte porte un petit
 * schéma dessiné à la main, fixe : un flux de nœuds, une conversation, un
 * tableau de bord, une leçon. Traits en gris de la nuit, un seul accent pêche
 * par dessin. Les données sont dans `data/expertises.ts`.
 */
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import { expertises } from '../data/expertises';

const icones: Record<string, string> = {
  automatisation: 'lucide:workflow',
  'agents-ia': 'lucide:bot',
  dashboards: 'lucide:layout-dashboard',
  formations: 'lucide:graduation-cap',
};
---

<section id="expertises" data-section class="px-[var(--spacing-section-x)] py-[var(--spacing-section-y)] border-b border-[var(--color-divider)]">
  <div class="mx-auto max-w-[1200px]">
    <SectionHeader title="Mes expertises." />
    <ul class="expertises">
      {expertises.map((e) => (
        <li id={e.id} class="expertise">
          <a
            class="expertise__carte"
            href={e.lien.href}
            target={e.lien.externe ? '_blank' : undefined}
            rel={e.lien.externe ? 'noopener noreferrer' : undefined}
            data-fast-goal={e.lien.goal}
            data-fast-goal-source={e.lien.source}
          >
            <div class="expertise__visuel" aria-hidden="true">
              {e.id === 'automatisation' && (
                <svg viewBox="0 0 320 170" fill="none">
                  <path class="trait" d="M86 85 C 120 85, 120 45, 146 45" />
                  <path class="trait" d="M86 85 C 120 85, 120 125, 146 125" />
                  <path class="trait accent-trait" d="M174 45 C 200 45, 200 85, 234 85" />
                  <path class="trait" d="M174 125 C 200 125, 200 85, 234 85" />
                  <rect class="bloc" x="30" y="61" width="56" height="48" rx="12" />
                  <path class="trait" d="M46 79h24M46 87h18M46 95h22" />
                  <rect class="bloc" x="146" y="23" width="44" height="44" rx="12" />
                  <circle class="trait" cx="168" cy="45" r="8" />
                  <rect class="bloc" x="146" y="103" width="44" height="44" rx="12" />
                  <path class="trait" d="M158 125l6 6 12-12" />
                  <rect class="bloc accent-bloc" x="234" y="61" width="56" height="48" rx="12" />
                  <path class="accent-trait" d="M252 85l6 6 14-14" stroke-width="3" />
                  <circle class="accent-plein" cx="210" cy="63" r="3.5" />
                </svg>
              )}
              {e.id === 'agents-ia' && (
                <svg viewBox="0 0 320 170" fill="none">
                  <rect class="bloc" x="150" y="22" width="140" height="34" rx="17" />
                  <path class="trait" d="M168 39h80" />
                  <rect class="bloc accent-bloc" x="30" y="70" width="190" height="56" rx="18" />
                  <path class="trait" d="M70 90h120M70 106h84" />
                  <circle class="accent-plein" cx="50" cy="98" r="9" />
                  <path class="fond" d="M50 92l1.8 4.2L56 98l-4.2 1.8L50 104l-1.8-4.2L44 98l4.2-1.8z" />
                  <rect class="bloc" x="150" y="136" width="96" height="22" rx="11" />
                  <circle class="pastille" cx="170" cy="147" r="3" />
                  <circle class="pastille" cx="182" cy="147" r="3" />
                  <circle class="pastille" cx="194" cy="147" r="3" />
                  <path class="accent-trait" d="M244 74l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" />
                </svg>
              )}
              {e.id === 'dashboards' && (
                <svg viewBox="0 0 320 170" fill="none">
                  <rect class="bloc" x="30" y="18" width="260" height="138" rx="14" />
                  <rect class="bloc" x="46" y="34" width="70" height="40" rx="8" />
                  <path class="trait" d="M56 48h30" />
                  <path class="accent-trait" d="M56 62h44" stroke-width="4" />
                  <rect class="bloc" x="124" y="34" width="70" height="40" rx="8" />
                  <path class="trait" d="M134 48h30M134 62h36" />
                  <rect class="bloc" x="202" y="34" width="72" height="40" rx="8" />
                  <path class="trait" d="M212 48h30M212 62h24" />
                  <path class="trait" d="M46 140h228" />
                  <rect class="pastille" x="56" y="112" width="14" height="28" rx="3" />
                  <rect class="pastille" x="80" y="100" width="14" height="40" rx="3" />
                  <rect class="pastille" x="104" y="106" width="14" height="34" rx="3" />
                  <rect class="accent-plein" x="128" y="90" width="14" height="50" rx="3" />
                  <path class="accent-trait" d="M164 128l26-14 22 8 26-24 30-10" />
                  <circle class="accent-plein" cx="268" cy="88" r="4" />
                </svg>
              )}
              {e.id === 'formations' && (
                <svg viewBox="0 0 320 170" fill="none">
                  <rect class="bloc" x="30" y="20" width="168" height="108" rx="12" />
                  <circle class="accent-bloc" cx="114" cy="70" r="20" />
                  <path class="accent-plein" d="M108 60v20l17-10z" />
                  <path class="trait" d="M46 112h136" />
                  <path class="accent-trait" d="M46 112h82" stroke-width="3" />
                  <path class="trait" d="M90 146h48M114 128v18" />
                  <rect class="bloc" x="214" y="20" width="76" height="30" rx="10" />
                  <path class="accent-trait" d="M224 35l5 5 9-9" />
                  <path class="trait" d="M248 35h30" />
                  <rect class="bloc" x="214" y="60" width="76" height="30" rx="10" />
                  <path class="accent-trait" d="M224 75l5 5 9-9" />
                  <path class="trait" d="M248 75h24" />
                  <rect class="bloc" x="214" y="100" width="76" height="30" rx="10" />
                  <circle class="trait" cx="231" cy="115" r="6" />
                  <path class="trait" d="M248 115h28" />
                </svg>
              )}
            </div>
            <div class="expertise__texte">
              <h3 class="expertise__nom">
                <span class="expertise__icone"><Icon name={icones[e.id]} size={18} aria-hidden="true" /></span>
                {e.nom}
              </h3>
              <p class="expertise__phrase">{e.phrase}</p>
              <p class="expertise__sortie">
                {e.lien.label}
                <Icon name={e.lien.externe ? 'lucide:arrow-up-right' : 'lucide:arrow-right'} size={16} aria-hidden="true" />
                {e.lien.externe && <span class="sr-only"> (nouvel onglet)</span>}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .expertises {
    display: grid;
    gap: var(--spacing-lie);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .expertises {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .expertise {
    max-width: none;
    scroll-margin-top: calc(var(--spacing-barre) + 1rem);
  }

  .expertise__carte {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-service-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface-low);
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .expertise__carte:hover {
    border-color: var(--color-border-strong);
  }

  .expertise__carte:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Le dessin, sur un quadrillage de points : le plan sur lequel on construit. */
  .expertise__visuel {
    padding: var(--spacing-panneau);
    border-bottom: 1px solid var(--color-service-border);
    background-color: var(--color-paper);
    background-image: radial-gradient(circle, color-mix(in srgb, var(--color-ink) 12%, transparent) 1px, transparent 1.2px);
    background-size: 16px 16px;
  }

  .expertise__visuel svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .expertise__visuel .trait {
    stroke: var(--color-ink-faint);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .expertise__visuel .bloc {
    fill: var(--color-surface-high);
    stroke: var(--color-service-border);
    stroke-width: 1.5;
  }

  .expertise__visuel .pastille {
    fill: var(--color-night-soft);
  }

  .expertise__visuel .fond {
    fill: var(--color-night);
  }

  .expertise__visuel .accent-bloc {
    fill: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface-high));
    stroke: color-mix(in srgb, var(--color-accent) 55%, transparent);
    stroke-width: 1.5;
  }

  .expertise__visuel .accent-trait {
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .expertise__visuel .accent-plein {
    fill: var(--color-accent);
  }

  .expertise__texte {
    display: grid;
    gap: 0.75rem;
    padding: var(--spacing-panneau);
  }

  .expertise__nom {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: var(--text-title);
    color: var(--color-ink);
  }

  .expertise__icone {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-service-border);
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--color-paper);
    color: var(--color-accent);
  }

  .expertise__phrase {
    margin: 0;
    color: var(--color-ink-mid);
  }

  .expertise__sortie {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    font-weight: 500;
  }
</style>
