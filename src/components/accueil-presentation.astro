---
/*
 * accueil-presentation : le premier écran de l'accueil depuis le 14 octobre
 * 2026 : Lilian se présente, simplement.
 *
 * Il a trouvé l'accueil d'avant trop vendeur et trop animé (« on n'est pas
 * assez site personnel »). Ici, deux colonnes : à gauche son nom, une phrase
 * courte, trois faits (sans date : « c'est pas un CV ») et ses liens ; à droite son portrait, en carré (il l'a
 * demandé ainsi après la première version, où le portrait était un petit rond
 * au-dessus du nom). Au pied de l'écran, le défilé des logos de ses clients
 * (`defile-clients`), qu'il a redemandé le même jour.
 *
 * L'id `hero` est observé par la barre de navigation (`trackHero`).
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import DefileClients from './defile-clients.astro';
import lilianPhoto from '../assets/lilian-photo.jpg';
import { faits, profils } from '../data/parcours';

const liens = [
  { href: profils.youtube, label: 'YouTube', icon: 'lucide:youtube', externe: true, goal: 'youtube_opened' },
  { href: profils.linkedin, label: 'LinkedIn', icon: 'lucide:linkedin', externe: true, goal: undefined },
  { href: '#newsletter', label: 'Newsletter', icon: 'lucide:mail', externe: false, goal: undefined },
];
---

<section id="hero" class="presentation px-[var(--spacing-section-x)] pt-[calc(var(--spacing-barre)+var(--spacing-home-hero-y))] border-b border-[var(--color-divider)]">
  <div class="presentation__corps mx-auto max-w-[1200px]">
    <div class="presentation__texte entree">
      <h1 class="presentation__nom font-display">Lilian Sevoumian</h1>

      <p class="presentation__phrase">
        J’automatise le travail des entreprises avec <mark>l’IA</mark>, et je raconte ce que j’apprends.
      </p>

      <ul class="presentation__faits">
        {faits.filter((fait) => !fait.titre.startsWith('Depuis')).map((fait) => <li>{fait.titre}</li>)}
      </ul>

      <ul class="presentation__liens">
        {liens.map((lien) => (
          <li>
            <a
              href={lien.href}
              target={lien.externe ? '_blank' : undefined}
              rel={lien.externe ? 'noopener noreferrer me' : undefined}
              data-fast-goal={lien.goal}
              data-fast-goal-source={lien.goal ? 'home_presentation' : undefined}
            >
              <Icon name={lien.icon} size={18} aria-hidden="true" />
              {lien.label}
              {lien.externe && <span class="sr-only"> (nouvel onglet)</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="presentation__photo">
      <Image src={lilianPhoto} alt="Portrait de Lilian Sevoumian" widths={[320, 480, 720]} sizes="(min-width: 1024px) 420px, 80vw" class="presentation__portrait" loading="eager" fetchpriority="high" />
    </div>
  </div>

  <DefileClients />
</section>

<style>
  .presentation__corps {
    display: grid;
    gap: var(--spacing-groupe) var(--spacing-gouttiere);
    align-items: center;
    padding-bottom: var(--spacing-section-y);
  }

  @media (min-width: 1024px) {
    .presentation__corps {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    }
  }

  .presentation__texte {
    display: grid;
    gap: var(--spacing-lie);
  }

  .presentation__photo {
    order: -1;
    max-width: 16rem;
  }

  @media (min-width: 1024px) {
    .presentation__photo {
      order: 0;
      max-width: none;
    }
  }

  .presentation__portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-service-border);
  }

  .presentation__nom {
    margin: 0;
    font-size: var(--text-display);
    line-height: 1.05;
    color: var(--color-ink);
  }

  .presentation__phrase {
    margin: 0;
    max-width: 26ch;
    font-size: var(--text-title-lg);
    line-height: 1.4;
    color: var(--color-ink-mid);
  }

  .presentation__faits {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-colle) 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .presentation__faits li {
    max-width: none;
  }

  .presentation__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: var(--spacing-colle) 0 0;
    padding: 0;
    list-style: none;
  }

  .presentation__liens a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-service-border);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .presentation__liens a:hover {
    border-color: var(--color-border-strong);
  }

  .presentation__liens a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
