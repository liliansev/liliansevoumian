---
/*
 * Methode — « comment ça se passe », en quatre étapes, dans l'île claire de la
 * page (`.bloc-encre`) : c'est ce que le lecteur vient vérifier avant
 * d'écrire, et il le lit posément. Le panneau remappe les jetons de couleur,
 * tout ce qu'il contient suit sans variante ; le schéma des contrôles, lui,
 * reste une fenêtre sombre.
 *
 * Le titre tient la colonne de gauche et accompagne les étapes, qui se lisent
 * à droite, l'une sous l'autre : même grille que les questions de fin de page.
 *
 * Rien n'est inventé, et c'est ce qui borne le texte de chaque étape : le
 * devis vient de la section des offres, les contrôles et les validations
 * humaines des cas clients, l'alerte dans le canal de l'équipe de la FAQ, la
 * documentation des principes, le suivi mensuel de l'offre. Aucune durée
 * n'est annoncée : les cas publiés vont de quatre semaines à plusieurs mois.
 *
 * Les étapes gardent un numéro parce que l'ordre est l'information : l'étape 3
 * ne peut pas précéder l'étape 1.
 */
import SectionHeader from './SectionHeader.astro';
import LinkCTA from './LinkCTA.astro';
import AutomationControlDiagram from './automation-control-diagram.astro';

const etapes = [
  {
    titre: 'Cadrage',
    corps:
      'Nous examinons vos tâches, vos outils et vos contraintes. Je précise ce qui est faisable, les priorités, le périmètre et le devis.',
  },
  {
    titre: 'Conception',
    corps:
      'Je connecte vos outils et construis les workflows. Lorsque l’IA intervient, je prévois les contrôles et les validations humaines nécessaires.',
  },
  {
    titre: 'Mise en production',
    corps:
      'Nous testons sur vos dossiers avant la mise en service. Les erreurs sont signalées dans le canal convenu avec votre équipe.',
  },
  {
    titre: 'Livraison et suivi',
    corps:
      'Je documente la solution et vous forme à son utilisation. Chaque projet s’accompagne d’un abonnement mensuel : hébergement, maintenance et petits ajustements de l’existant. Les nouveaux besoins font l’objet d’un devis.',
  },
];
---

<section
  id="methode"
  data-section
  class="bloc-encre relative px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">

    <div class="methode">
      {/* Sur grand écran le titre accompagne les étapes, plus hautes que lui. */}
      <SectionHeader
        class="lg:sticky lg:top-28"
        title="Du premier échange au suivi mensuel."
        body="Le périmètre et le calendrier sont définis avant de commencer."
        titleMaxWidth="14ch"
        bodyMaxWidth="34ch"
        spacing="none"
      />

      <ol class="reveal-stagger methode-etapes">
        {etapes.map((e) => (
          <li class="reveal methode-etape">
            <h3 class="m-0">{e.titre}</h3>
            <p class="m-0 mt-[var(--spacing-colle)] leading-[var(--leading-body)] text-[var(--color-ink-mid)]">
              {e.corps}
            </p>
          </li>
        ))}
      </ol>
    </div>

    <AutomationControlDiagram />

    <p class="reveal m-0 mt-[var(--spacing-groupe)]">
      <LinkCTA href="/principes">Les 8 principes que je suis sur chaque mission</LinkCTA>
    </p>

  </div>
</section>

<style>
  .methode {
    display: grid;
    gap: var(--spacing-groupe);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .methode {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      column-gap: var(--spacing-gouttiere);
    }
  }

  .methode-etapes {
    display: grid;
    gap: var(--spacing-groupe);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: etape;
  }

  /* Le numéro dans sa colonne, le titre et le texte dans la leur : le texte
     s'aligne sous le titre, pas sous le chiffre. */
  .methode-etape {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
  }

  .methode-etape > :global(*) {
    grid-column: 2;
  }

  /* Le numéro est un compteur CSS : la liste reste une `ol`, qu'un lecteur
     d'écran annonce déjà « 1 sur 4 », et le chiffre ne part pas dans le
     presse-papier avec la phrase. Au corps du titre, en retrait : il donne
     l'ordre sans faire un second titre. */
  .methode-etape::before {
    counter-increment: etape;
    content: counter(etape);
    grid-column: 1;
    grid-row: 1;
    color: var(--color-ink-low);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
</style>
