---
const services = [
  {
    number: "01",
    title: "Automatisation des workflows",
    description: "Vos outils (CRM, facturation, emails, Slack...) communiquent entre eux sans intervention humaine. Fini le copier-coller entre 5\u00A0outils.",
    color: "#E86A33",
    cardClass: "card-3d-light-orange",
  },
  {
    number: "02",
    title: "Intégration d'IA sur mesure",
    description: "Chatbot, tri automatique, extraction de données, génération de rapports — l'IA est branchée directement sur vos datas.",
    color: "#9333EA",
    cardClass: "card-3d-light-purple",
  },
  {
    number: "03",
    title: "Formation de vos équipes",
    description: "Vos collaborateurs apprennent à créer et maintenir leurs propres automatisations. Objectif\u00A0: autonomie totale en 4 à 6\u00A0semaines.",
    color: "#F43F5E",
    cardClass: "card-3d-light-rose",
  },
];
---

<section data-bg="white" id="services" class="relative bg-white overflow-hidden">
  <!-- Dot grid -->
  <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>

  <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
    <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-12 lg:gap-14">
      <!-- Header -->
      <div class="flex flex-col items-center fade-in-section">
        <span class="inline-block text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-purple-dark)] font-mono mb-3">
          CE QUE JE FAIS
        </span>
        <h2 class="text-[length:var(--text-heading)] font-bold text-center text-[#1A1A1A] font-display">
          3 leviers pour transformer vos opérations
        </h2>
      </div>

      <!-- Cards grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[24px] reveal-stagger">
        {services.map((service) => (
          <div class:list={["reveal-card card-3d-hover flex flex-col p-[28px_24px]", service.cardClass]}>
            <!-- Number — tight with title -->
            <span
              class="text-[length:var(--text-decorative)] font-bold leading-none font-mono mb-1"
              style={`color: ${service.color};`}
            >
              {service.number}
            </span>

            <!-- Title — medium gap to description -->
            <h3 class="text-[length:var(--text-subheading)] font-bold text-[#1A1A1A] font-display mb-3">
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-[length:var(--text-body)] leading-[1.5] text-[#666666] font-body">
              {service.description}
            </p>
          </div>
        ))}
      </div>

      <!-- CTA intermédiaire -->
      <div class="flex flex-col items-center fade-in-section">
        <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] text-center mb-5">
          Vous vous demandez quel levier aurait le plus d'impact chez vous&nbsp;?
        </p>
        <a
          href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
          class="btn-3d inline-flex items-center justify-center font-body text-[length:var(--text-body)] font-semibold px-7 py-3.5 group"
        >
          Identifier mes gains <span class="inline-block ml-1 group-hover:translate-x-1.5 transition-transform duration-300">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
