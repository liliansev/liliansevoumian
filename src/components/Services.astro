---
const services = [
  {
    number: "01",
    title: "Automatisation des workflows",
    description: "Vos outils (CRM, facturation, emails, Slack...) communiquent entre eux sans intervention humaine. Fini le copier-coller entre 5\u00A0outils.",
    color: "#E86A33",
    cardClass: "card-3d-light-orange",
  },
  {
    number: "02",
    title: "Intégration d'IA sur mesure",
    description: "Chatbot, tri automatique, extraction de données, génération de rapports — l'IA est branchée directement sur vos datas.",
    color: "#9333EA",
    cardClass: "card-3d-light-purple",
  },
  {
    number: "03",
    title: "Diagnostic & refonte des process",
    description: "Je cartographie vos opérations, identifie ce qui peut être automatisé et propose un plan d'action chiffré avec ROI estimé.",
    color: "#22D3EE",
    cardClass: "card-3d-light-cyan",
  },
  {
    number: "04",
    title: "Formation de vos équipes",
    description: "Vos collaborateurs apprennent à créer et maintenir leurs propres automatisations. Objectif\u00A0: autonomie totale en 4 à 6\u00A0semaines.",
    color: "#F43F5E",
    cardClass: "card-3d-light-rose",
  },
];
---

<section id="services" class="relative bg-white overflow-hidden">
  <!-- Dot grid -->
  <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>

  <div class="relative z-[1] py-[80px] px-[120px] max-md:px-[var(--spacing-section-x)]">
    <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-[48px]">
      <!-- Header -->
      <div class="flex flex-col items-center gap-5 fade-in-section">
        <span class="inline-block text-[12px] font-semibold tracking-[2px] uppercase text-[#7928CA] font-mono">
          CE QUE JE FAIS
        </span>
        <h2 class="text-[40px] font-bold tracking-[-0.02em] text-center text-[#1A1A1A] font-display">
          4 leviers pour transformer vos opérations
        </h2>
      </div>

      <!-- Cards grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[24px] reveal-stagger">
        {services.map((service) => (
          <div class:list={["reveal-card flex flex-col gap-[16px] p-[32px_28px]", service.cardClass]}>
            <!-- Number -->
            <span
              class="text-[48px] font-bold tracking-[-0.03em] leading-none font-mono"
              style={`color: ${service.color};`}
            >
              {service.number}
            </span>

            <!-- Title -->
            <h3 class="text-[22px] font-bold text-[#1A1A1A] font-display">
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-[15px] leading-[1.5] text-[#666666] font-body">
              {service.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
