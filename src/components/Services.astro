---
const services = [
  {
    number: "01",
    code: "// workflows",
    title: "Automatisation des workflows",
    description: "Vos outils (CRM, facturation, emails, Slack...) communiquent entre eux sans intervention humaine. Fini le copier-coller entre 5 onglets.",
  },
  {
    number: "02",
    code: "// intelligence",
    title: "Intégration d'IA sur mesure",
    description: "Chatbot support, tri automatique d'emails, extraction de données, génération de rapports — l'IA branchée directement sur vos outils métier.",
  },
  {
    number: "03",
    code: "// process",
    title: "Audit & refonte des process",
    description: "Je cartographie vos opérations, identifie ce qui peut être automatisé et propose un plan d'action chiffré avec ROI estimé.",
  },
  {
    number: "04",
    code: "// training",
    title: "Formation de vos équipes",
    description: "Vos collaborateurs apprennent à créer et maintenir leurs propres automatisations. Objectif : autonomie totale en 4 à 6 semaines.",
  },
];
---

<section id="services" class="relative" style="background-color: #111111;">
  <!-- Top separator -->
  <div class="h-px w-full" style="background: linear-gradient(90deg, transparent, #222222, transparent);"></div>

  <div class="py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
    <div class="max-w-[1200px] mx-auto">
      <!-- Header -->
      <div class="flex flex-col items-center gap-5 mb-12 fade-in-section">
        <span
          class="inline-block rounded-full px-4 py-1.5 text-[11px] font-medium tracking-[2px] uppercase"
          style="background-color: #1A1A1A; border: 1px solid #222222; color: #777777; font-family: var(--font-mono);"
        >
          CE QUE JE FAIS
        </span>
        <h2
          class="text-[length:var(--text-heading)] font-bold text-center"
          style="color: #EDEDED; font-family: var(--font-display);"
        >
          4 leviers pour transformer vos opérations
        </h2>
        <p
          class="text-center max-w-[640px] text-[15px] md:text-[18px] leading-[1.6]"
          style="color: #888888; font-family: var(--font-body);"
        >
          De l'audit initial au transfert de compétences, je prends en charge toute la chaîne.
        </p>
      </div>

      <!-- Cards grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 reveal-stagger">
        {services.map((service) => (
          <div
            class="reveal-card card-spotlight flex flex-col gap-5 p-6 md:p-9 rounded-2xl"
            style="background: #111111; border: 1px solid rgba(139,92,246,0.35); box-shadow: 0 0 20px rgba(139,92,246,0.05);"
          >
            <!-- Number -->
            <span
              class="text-4xl md:text-[48px] font-bold leading-none"
              style="color: rgba(139, 92, 246, 0.45); font-family: var(--font-mono);"
            >
              {service.number}
            </span>

            <!-- Code tag -->
            <span
              class="text-xs leading-normal"
              style="color: rgba(139, 92, 246, 0.45); font-family: var(--font-mono);"
            >
              {service.code}
            </span>

            <!-- Title -->
            <h3
              class="text-lg md:text-xl font-semibold"
              style="color: #EDEDED; font-family: var(--font-display);"
            >
              {service.title}
            </h3>

            <!-- Description -->
            <p
              class="text-[15px] leading-[1.6]"
              style="color: #AAAAAA; font-family: var(--font-body);"
            >
              {service.description}
            </p>

          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom separator -->
  <div class="h-px w-full" style="background: linear-gradient(90deg, transparent, #222222, transparent);"></div>
</section>
