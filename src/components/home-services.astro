---
/*
 * home-services — ce que fait Lilian, en quatre métiers.
 *
 * Il l'a demandé en clair : en passant sur la page, on doit comprendre ce
 * qu'il fait. Quatre blocs donc, un par métier, et chacun porte sa scène : de
 * petites fenêtres d'interface reliées par des fils, où l'on voit le métier se
 * faire. Depuis le 3 octobre 2026, dans l'ordre qu'il a donné : automatisation,
 * agents IA, dashboards et outils métiers, formations. Les sites web sont
 * sortis de la page d'accueil ce jour-là (le bloc s'appelait « Sites web et
 * dashboards » et montrait trois sites dans une vitrine) ; leur page d'offre
 * reste en ligne.
 *
 * C'est la direction qu'il a retenue le 3 octobre 2026 parmi cinq essais
 * (`/explorations-metiers`), à la place des sculptures de verre : celles-ci
 * étaient belles, mais il fallait lire leur légende pour comprendre.
 *
 *   automatisation   un client réserve un créneau : le paiement est encaissé,
 *                    le créneau se pose dans l'agenda, la confirmation part ;
 *   agents IA        on pose une question, l'agent part chercher la réponse
 *                    dans ses sources, recoupe et répond ; le doute reste à
 *                    un humain ;
 *   dashboards       un outil métier se monte, l'équipe s'en sert, et le
 *                    dashboard compte ;
 *   formations       le formateur monte un scénario, l'équipe le refait, puis
 *                    le lance seule.
 *
 * Sur téléphone, les quatre blocs à la suite faisaient près de cinq écrans. Ils
 * tiennent dans un seul : quatre onglets sous le titre, un bloc à la fois, et
 * au pied de chaque bloc un bouton vers le suivant. Des onglets et non un
 * carrousel à glisser : les quatre noms restent lisibles d'un coup d'œil, rien
 * n'est caché derrière un geste. Au-delà de 719 px, et sans script, les blocs
 * restent l'un sous l'autre.
 *
 * Un sujet par scène, et une silhouette par scène : Lilian l'a demandé en
 * voyant la page sur son téléphone (« quand on scrolle, il faut qu'à chaque
 * fois ce soit une animation différente, et qu'on comprenne que c'est un
 * sujet différent »). Aucune ne rejoue le bon de commande de la scène du
 * récit, ni son agent de support, ni son suivi de projets.
 *
 * Les scènes vivent dans `components/metiers/`, sur un socle commun
 * (`scene-metier.css`, `lib/metiers/scene.ts`). Leur balisage est déjà l'image
 * finale : sans script et en mouvement réduit, on voit une scène fixe et
 * complète. Les sculptures de verre restent visibles sur `/explorations-blocs`.
 *
 * Rien n'est affirmé qui ne soit dans PRODUCT.md : les preuves viennent des
 * cas clients publiés et des faits du parcours ; les prix, de
 * `data/service-pricing`.
 */
import { Icon } from 'astro-icon/components';
import LinkCTA from './LinkCTA.astro';
import SceneAutomatisation from './metiers/scene-automatisation.astro';
import SceneAgents from './metiers/scene-agents.astro';
import SceneFormations from './metiers/scene-formations.astro';
import SceneSites from './metiers/scene-sites.astro';
import { automationStartingPrice } from '../data/service-pricing';

const prix = (montant: number) => `À partir de ${montant.toLocaleString('fr-FR')}\u00a0€\u00a0HT`;

const metiers = [
  {
    id: 'automatisation',
    nom: 'Automatisation',
    onglet: 'Automatisation',
    phrase: 'Je relie vos outils, et les ressaisies disparaissent.',
    /* Seul texte de la liste qui porte du balisage : Make et n8n mènent à leur
       page. Il est rendu par `set:html`, comme les trois autres ; tous sont
       écrits ici, aucun ne vient d'une saisie. */
    texte:
      'Commandes, factures, relances, rapports\u00a0: je construis ces automatisations avec <a href="/expert-make">Make</a> et <a href="/expert-n8n">n8n</a>, deux outils faits pour ça. Je livre un système fiable, que votre équipe utilise au quotidien.',
    /* Humble+ porte déjà le récit, juste au-dessus : ce bloc cite un autre cas. */
    preuve: { chiffre: '~4\u00a0h par semaine', suite: 'récupérées par l’équipe de Fraich Touch sur sa facturation.', href: '/cas-clients/facturation-automatisee-fraich-touch', cas: 'Fraich Touch' },
    note: prix(automationStartingPrice),
    lien: { href: '/automatisations-ia', label: 'Voir l’offre automatisation', goal: 'service_path_opened', source: 'home_metier_automation' },
  },
  {
    id: 'agents-ia',
    nom: 'Agents IA',
    onglet: 'Agents IA',
    phrase: 'Un agent qui va chercher la réponse à votre place.',
    texte:
      'Vous posez une question, il va chercher l’information là où elle est\u00a0: vos documents, vos outils, le web. Il lit, recoupe et répond, sources à l’appui. Les contrôles qui comptent restent des règles écrites, et un humain garde la main.',
    preuve: { chiffre: '~10\u00a0min', suite: 'par passage, contre 1 à 3\u00a0h à la main pour 50 entreprises, chez M\u00a0Partners.', href: '/cas-clients/m-partners', cas: 'M Partners' },
    /* L'offre « Automatisation et agents IA » n'a qu'un prix d'entrée : il
       s'affiche sur ses deux blocs, comme sur la ligne de fin de page. */
    note: prix(automationStartingPrice),
    /* Le bouton sort vers l'agence ; le prix, lui, mène à l'offre du site,
       qui couvre automatisation et agents IA. */
    noteHref: '/automatisations-ia',
    lien: { href: 'https://agenceafk.fr', label: 'Voir mon agence, agenceafk', externe: true, goal: 'outbound_agence', source: 'home_services' },
  },
  {
    /* Le troisième métier, depuis le 3 octobre 2026 : plus de sites web sur
       l'accueil. Ce qui est affirmé vient de /llms.txt (« dashboards, portails
       clients et applications métiers, sur un périmètre chiffré
       séparément ») ; le prix est donc « sur devis », choix de Lilian. Le lien
       mène à la partie « Applications » de la page d'offre, qui reste en
       ligne. La phrase est de moi : à lui de la valider. */
    id: 'dashboards',
    nom: 'Dashboards et outils métiers',
    onglet: 'Dashboards',
    phrase: 'Un dashboard qui dit où vous en êtes, un outil fait pour votre métier.',
    texte:
      'Dashboards, portails clients et applications internes, de la conception aux évolutions. La personne qui cadre le projet est celle qui le construit.',
    note: 'Sur devis',
    lien: { href: '/sites-web-abonnement#applications', label: 'Voir les applications métier', goal: 'service_path_opened', source: 'home_metier_web' },
  },
  {
    id: 'formations',
    nom: 'Formations',
    onglet: 'Formations',
    phrase: 'J’apprends à vos équipes à le faire elles-mêmes.',
    texte:
      'Des formations pratiques à Make, à n8n et à l’IA, en ligne ou directement avec vos équipes. On construit sur vos cas, pas sur des exemples d’école.',
    preuve: { chiffre: 'Plus de 300', suite: 'personnes formées, par le premier Français certifié Make niveau 5.' },
    lien: { href: 'https://augmentes.fr', label: 'Voir les formations Augmentés', externe: true, goal: 'outbound_formations', source: 'home_services' },
  },
] as const;

const scenes = {
  automatisation: SceneAutomatisation,
  'agents-ia': SceneAgents,
  dashboards: SceneSites,
  formations: SceneFormations,
};
---

<section id="services" data-section class="metiers relative px-[var(--spacing-section-x)]">
  <div class="metiers__cadre relative mx-auto max-w-[1200px]">
    {/* Le titre seul : chaque bloc s'ouvre sur son nom. Il disait « Je fais
        quatre choses. » ; Lilian l'a jugé faible et a demandé un mot simple
        (« mes services, mes expertises »), le 3 octobre 2026. « Expertises »
        répond au titre du premier écran, « je suis expert en… ». */}
    <header class="metiers__tete reveal">
      <h2>Mes expertises.</h2>
    </header>

    {/* Téléphone seulement : les quatre noms, pour passer d'un métier à
        l'autre. Le script les montre et leur donne leurs rôles ; sans lui ils
        restent cachés et les quatre blocs se suivent. */}
    <div class="metiers__onglets" role="tablist" aria-label="Mes expertises" data-metiers-onglets hidden>
      {metiers.map((metier, index) => (
        <button
          type="button"
          role="tab"
          id={`onglet-${metier.id}`}
          aria-controls={metier.id}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-metier-onglet
        >
          {metier.onglet}
        </button>
      ))}
    </div>

    {metiers.map((metier, index) => {
      const Scene = scenes[metier.id];
      return (
      <article id={metier.id} class:list={['metier', { 'metier--miroir': index % 2 === 1 }]} data-metier>
        <div class="metier__texte reveal">
          <h3>{metier.nom}</h3>
          <p class="metier__phrase">{metier.phrase}</p>
          <p class="metier__corps" set:html={metier.texte} />

          {'preuve' in metier && (
            <p class="metier__preuve">
              <strong>{metier.preuve.chiffre}</strong>
              <span>
                {metier.preuve.suite}
                {'href' in metier.preuve && (
                  <>
                    {' '}
                    <a href={metier.preuve.href}>
                      Lire le cas<span class="sr-only"> {metier.preuve.cas}</span>
                    </a>
                  </>
                )}
              </span>
            </p>
          )}

          <div class="metier__suite">
            <LinkCTA
              href={metier.lien.href}
              external={'externe' in metier.lien}
              goal={metier.lien.goal}
              goalSource={metier.lien.source}
            >
              {metier.lien.label}
            </LinkCTA>
            {'note' in metier &&
              ('noteHref' in metier ? (
                <a
                  class="metier__note"
                  href={metier.noteHref}
                  data-fast-goal="service_path_opened"
                  data-fast-goal-source="home_metier_agents"
                >
                  {metier.note}
                </a>
              ) : (
                <span class="metier__note">{metier.note}</span>
              ))}
          </div>
        </div>

        <div class="metier__scene reveal">
          <span class="repere repere--hg" aria-hidden="true"></span>
          <span class="repere repere--hd" aria-hidden="true"></span>
          <span class="repere repere--bg" aria-hidden="true"></span>
          <span class="repere repere--bd" aria-hidden="true"></span>
          <div class="metier__cadre"><Scene /></div>
        </div>

        {/* Téléphone : au pied du bloc, le métier suivant, sans remonter aux
            onglets. Le script le montre ; le dernier bloc n'en a pas. */}
        {index < metiers.length - 1 && (
          <button type="button" class="metier__suivant" data-metier-suivant hidden>
            <span>Suivant&nbsp;: {metiers[index + 1].nom}</span>
            <Icon name="lucide:arrow-right" size={18} aria-hidden="true" />
          </button>
        )}
      </article>
      );
    })}
  </div>
</section>

<style>
  .metiers {
    --trait: color-mix(in srgb, var(--color-ink) 9%, transparent);
    --marge: var(--spacing-cadre);
    border-bottom: 1px solid var(--trait);
    background: var(--color-night-deep);
  }

  .metiers__tete {
    padding-block: var(--spacing-section-y) var(--spacing-groupe);
  }

  .metiers__tete h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-story);
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .metier {
    position: relative;
    display: grid;
    /* La scène prend la grande colonne, des deux côtés. Le texte et la scène
       partent de la même ligne : centré, le nom du métier flottait de 12 à
       47 px sous le haut du cadre, selon la longueur de son texte. */
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: var(--spacing-gouttiere);
    padding-block: var(--spacing-bloc);
  }

  .metier::before {
    content: '';
    position: absolute;
    top: 0;
    right: calc(-1 * var(--marge));
    left: calc(-1 * var(--marge));
    height: 1px;
    background: var(--trait);
  }

  .metier::after {
    content: '';
    position: absolute;
    top: -5px;
    left: calc(-1 * var(--marge) - 5px);
    width: 11px;
    height: 11px;
    background:
      linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 100% 1px no-repeat,
      linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 1px 100% no-repeat;
  }

  .metier--miroir { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
  .metier--miroir .metier__texte { order: 2; }
  .metier--miroir .metier__scene { order: 1; }

  /* Les écarts disent qui va avec qui : le nom colle à sa phrase, la phrase
     ouvre sur le corps, la preuve s'en détache, la sortie ferme. Un seul écart
     de 18 px séparait tout, et le nom du métier flottait au lieu de coiffer sa
     phrase. */
  .metier__texte {
    --mesure: 28.25rem;
    display: grid;
    justify-items: start;
    align-content: start;
    min-width: 0;
  }

  .metier h3 {
    margin: 0;
    color: var(--color-accent-text);
    font-size: var(--text-body-large);
    font-weight: 500;
    line-height: 1.3;
  }

  /* Le nom du métier est petit, et c'est la phrase qui parle : elle dit ce
     que le métier change, pas comment il s'appelle. Un rang sous le titre de
     la section, qu'elle égalait jusque-là. */
  .metier__phrase {
    max-width: 18ch;
    margin: var(--spacing-colle) 0 0;
    color: var(--color-ink);
    font-size: var(--text-phrase);
    font-weight: 500;
    line-height: var(--leading-phrase);
    letter-spacing: var(--tracking-phrase);
    text-wrap: balance;
  }

  .metier__corps {
    max-width: var(--mesure);
    margin: var(--spacing-lie) 0 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  /* Le chiffre puis sa phrase, à la suite. Quand la colonne est trop étroite
     pour les deux, la phrase passe sous le chiffre : en grille `auto 1fr`, elle
     restait à côté dans une colonne de 100 px, en six lignes de deux mots. */
  .metier__preuve {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    width: 100%;
    max-width: var(--mesure);
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--trait);
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .metier__preuve > span {
    flex: 1 1 14rem;
    min-width: 0;
  }

  .metier__preuve strong {
    color: var(--color-ink);
    /* Le même traitement que les faits de « Pourquoi moi » : « Plus de 300 »
       existe dans les deux. */
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Souligné : la couleur seule ne suffit pas à dire qu'on peut cliquer. Et
     jamais coupé en deux lignes. */
  .metier__preuve a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-ink) 40%, transparent);
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }

  /* Les liens du texte courant, soulignés comme celui de la preuve. Le texte
     est injecté (`set:html`) : il ne porte pas l'attribut de portée. */
  .metier__corps :global(a),
  a.metier__note {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 160ms var(--ease-out-quint);
  }

  .metier__corps :global(a) {
    color: var(--color-ink);
  }

  /* Le prix cliquable est un contrôle isolé : il prend la hauteur d'une cible
     tactile. */
  a.metier__note {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .metier__corps :global(a:hover),
  a.metier__note:hover {
    text-decoration-color: currentColor;
  }

  .metier__suite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }

  .metier__note {
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  /* Le cadre de la scène : le même que celui de la scène du récit, avec ses
     repères d'angle. La scène remplit le cadre intérieur, qui la rogne. */
  .metier__scene {
    position: relative;
    min-width: 0;
    container: scene / inline-size;
  }

  .metier__cadre {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-md);
    background: var(--color-night-deep);
  }

  .repere {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--color-ink-low);
    pointer-events: none;
  }

  .repere--hg { top: -7px; left: -7px; border-top-width: 1px; border-left-width: 1px; }
  .repere--hd { top: -7px; right: -7px; border-top-width: 1px; border-right-width: 1px; }
  .repere--bg { bottom: -7px; left: -7px; border-bottom-width: 1px; border-left-width: 1px; }
  .repere--bd { right: -7px; bottom: -7px; border-right-width: 1px; border-bottom-width: 1px; }

  /* Sur le plan étroit (voir `scene-metier.css`), la scène est plus haute :
     9:8 au lieu de 4:3. Le seuil est celui du socle, plus les deux pixels de
     bordure du cadre. */
  @container scene (max-width: 521.98px) {
    .metier__cadre {
      aspect-ratio: 9 / 8;
    }
  }

  /* Deux colonnes à partir de 1200 px seulement. En dessous, la scène en
     colonne faisait moins de 600 px et son texte passait sous 8 px à l'écran
     (66 % des libellés à 1024, mesuré le 2 octobre 2026) : elle prend toute la
     largeur, et son texte passe dessous. */
  @media (max-width: 1199px) {
    .metier,
    .metier--miroir {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-groupe);
    }

    /* La scène passe avant son texte, pour tous les métiers : posée après,
       elle se retrouvait collée au titre du métier suivant et se lisait comme
       son illustration. Elle ne dépasse jamais la hauteur de l'écran : sur un
       téléphone tenu en paysage, elle faisait 570 px de haut pour 326 visibles. */
    .metier__scene,
    .metier--miroir .metier__scene {
      order: 1;
      width: 100%;
      max-width: max(18rem, calc((100svh - var(--spacing-barre) - 2rem) * 4 / 3));
    }

    .metier__texte,
    .metier--miroir .metier__texte { order: 2; }

    /* Le seul chemin vers la preuve : une vraie cible pour le doigt. Le
       lien reste dans le fil du texte ; son remplissage vertical agrandit la
       zone d'appui sans écarter les lignes, ce qu'une hauteur minimale
       faisait. */
    .metier__preuve a {
      padding-block: 0.85rem;
    }
  }

  /* Écran bas (téléphone en paysage, zoom fort) : la scène borne sa largeur
     sur son plan étroit, qui est en 9:8. */
  @media (max-width: 1199px) and (max-height: 560px) {
    .metier__scene,
    .metier--miroir .metier__scene {
      max-width: max(18rem, calc((100svh - var(--spacing-barre) - 2rem) * 9 / 8));
    }
  }

  /* Entre la tablette et le petit portable, le texte tient en deux colonnes
     sous la scène : la phrase à gauche, ce qui l'étaie à droite. Sur une seule
     colonne, il laissait le tiers droit de la page vide. */
  @media (min-width: 720px) and (max-width: 1199px) {
    .metier__texte {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr;
      column-gap: var(--spacing-gouttiere);
    }

    .metier h3 { grid-area: 1 / 1; }
    .metier__phrase { grid-area: 2 / 1 / span 3; }
    .metier__corps { grid-area: 1 / 2 / span 2; margin-top: 0; }
    .metier__preuve { grid-area: 3 / 2; }
    .metier__suite { grid-area: 4 / 2; align-self: start; }
  }

  /* Sous 1024 px, les deux filets de cadre de la page ne sont plus là : le
     filet du métier n'a plus rien à rejoindre dans la marge. */
  @media (max-width: 1023px) {
    .metier::before {
      right: 0;
      left: 0;
    }

    .metier::after {
      display: none;
    }
  }

  /* ── Les onglets (téléphone) ──
     Le bloc masqué l'est vraiment : `.metier` est une grille, qui l'emporterait
     sur l'attribut `hidden`. */
  .metier[hidden],
  .metiers__onglets[hidden],
  .metier__suivant[hidden] {
    display: none;
  }

  /* Des onglets au sens propre : quatre noms sur une ligne, un trait pêche sous
     celui qui est ouvert. Sur téléphone ils arrivent juste après les boutons de
     mode du récit, qui sont une piste à pastille : deux commandes voisines aux
     noms presque identiques, donc deux dessins (demande de Lilian, le
     3 octobre 2026). La rangée court jusqu'aux bords de l'écran ; si les
     quatre noms n'y tiennent pas, elle défile, et le nom coupé le dit. */
  .metiers__onglets {
    display: flex;
    gap: 1rem;
    margin: 0 calc(-1 * var(--spacing-section-x)) var(--spacing-lie);
    padding-inline: var(--spacing-section-x);
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .metiers__onglets::-webkit-scrollbar {
    display: none;
  }

  .metiers__onglets button {
    flex: none;
    min-width: 44px;
    min-height: 44px;
    margin-bottom: -1px;
    padding: 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--color-ink-mid);
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color var(--duration-default) var(--ease-out-quint),
      color var(--duration-default);
  }

  .metiers__onglets button[aria-selected='true'] {
    border-bottom-color: var(--color-peche);
    color: var(--color-ink);
  }

  /* En onglets, le bloc n'a plus de voisin au-dessus : son filet et son
     espace du haut s'effacent, les onglets en tiennent lieu. */
  .metiers[data-onglets] .metier {
    padding-top: 0;
  }

  .metiers[data-onglets] .metier::before {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .metiers[data-onglets] .metier:not([hidden]) {
      animation: metier-arrive 420ms var(--ease-out-expo) backwards;
    }
  }

  @keyframes metier-arrive {
    from { opacity: 0; transform: translateY(0.75rem); }
  }

  .metier__suivant {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    order: 3;
    width: 100%;
    min-height: 48px;
    padding: 0 1.125rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Téléphone : la scène prend presque toute la largeur de l'écran, comme
     celle du récit (voir `home-story`) : dessinée à taille fixe puis mise à
     l'échelle, elle y gagne 10 % à 402 px. */
  @media (max-width: 640px) {
    .metier__scene,
    .metier--miroir .metier__scene {
      width: auto;
      margin-inline: calc(0.5rem - var(--spacing-section-x));
    }
  }

  @media (max-width: 640px) {
    /* Le prix passe toujours sous le lien : selon la longueur du libellé il
       tenait tantôt à côté, tantôt dessous, d'un métier à l'autre. */
    .metier__suite {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  /* Téléphone : quatre onglets, un bloc à la fois. Au-delà de 719 px, les blocs
     se suivent et rien de tout cela ne s'applique. Les scènes des blocs
     masqués s'arrêtent d'elles-mêmes (leur moteur ne joue qu'à l'écran). */
  const section = document.querySelector<HTMLElement>('#services');
  const liste = section?.querySelector<HTMLElement>('[data-metiers-onglets]');
  const onglets = [...(liste?.querySelectorAll<HTMLButtonElement>('[data-metier-onglet]') ?? [])];
  const blocs = [...(section?.querySelectorAll<HTMLElement>('[data-metier]') ?? [])];

  if (section && liste && blocs.length > 1 && onglets.length === blocs.length) {
    const etroit = window.matchMedia('(max-width: 719px)');
    let actif = 0;

    const montrer = (rang: number) => {
      actif = rang;
      onglets.forEach((onglet, i) => {
        onglet.setAttribute('aria-selected', String(i === rang));
        onglet.tabIndex = i === rang ? 0 : -1;
      });
      /* Sur un petit téléphone la rangée défile : l'onglet choisi revient en
         vue, sans faire bouger la page. */
      const retrait = Number.parseFloat(getComputedStyle(liste).paddingLeft) || 0;
      const cadre = liste.getBoundingClientRect();
      const choisi = onglets[rang].getBoundingClientRect();
      if (choisi.left < cadre.left + retrait) liste.scrollLeft -= cadre.left + retrait - choisi.left;
      else if (choisi.right > cadre.right - retrait) liste.scrollLeft += choisi.right - (cadre.right - retrait);
      blocs.forEach((bloc, i) => {
        bloc.hidden = etroit.matches && i !== rang;
      });
    };

    /* Ramène les onglets sous la barre : le nouveau bloc se lit depuis le haut. */
    const remonter = () => liste.scrollIntoView({ block: 'start' });

    const regler = () => {
      const enOnglets = etroit.matches;
      liste.hidden = !enOnglets;
      section.toggleAttribute('data-onglets', enOnglets);
      blocs.forEach((bloc, i) => {
        if (enOnglets) {
          bloc.setAttribute('role', 'tabpanel');
          bloc.setAttribute('aria-labelledby', onglets[i].id);
        } else {
          bloc.removeAttribute('role');
          bloc.removeAttribute('aria-labelledby');
        }
        const suivant = bloc.querySelector<HTMLElement>('[data-metier-suivant]');
        if (suivant) suivant.hidden = !enOnglets;
      });
      montrer(actif);
    };

    onglets.forEach((onglet, i) => {
      onglet.addEventListener('click', () => montrer(i));
      onglet.addEventListener('keydown', (e) => {
        const pas = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        const cible = e.key === 'Home' ? 0 : e.key === 'End' ? onglets.length - 1 : pas ? (i + pas + onglets.length) % onglets.length : -1;
        if (cible < 0) return;
        e.preventDefault();
        montrer(cible);
        onglets[cible].focus();
      });
    });

    blocs.forEach((bloc, i) => {
      bloc.querySelector('[data-metier-suivant]')?.addEventListener('click', () => {
        montrer(i + 1);
        remonter();
      });
    });

    /* Un lien vers un métier (la barre, le menu, une adresse partagée) ouvre
       son onglet : masqué, le bloc ne pourrait pas être atteint. Au clic, le
       bloc est montré avant que le navigateur n'y défile. */
    const rangDe = (ancre: string) => blocs.findIndex((bloc) => `#${bloc.id}` === ancre);
    document.addEventListener('click', (e) => {
      const lien = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('a[href^="#"]') : null;
      const rang = lien ? rangDe(lien.getAttribute('href') ?? '') : -1;
      if (rang >= 0 && etroit.matches) montrer(rang);
    });
    const suivreLAncre = () => {
      const rang = rangDe(window.location.hash);
      if (rang < 0 || !etroit.matches) return;
      montrer(rang);
      remonter();
    };
    window.addEventListener('hashchange', suivreLAncre);

    etroit.addEventListener('change', regler);
    regler();
    suivreLAncre();
  }
</script>
