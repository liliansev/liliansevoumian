---
/*
 * Testimonials — trois recommandations de vraies personnes, sur
 * /automatisations-ia. Sur l'accueil, `home-voices` porte les mêmes mots, une
 * voix à la fois ; ici, page de référence, elles se lisent à la suite : la
 * citation à gauche, qui la signe à droite, et l'espace seul entre deux voix.
 *
 * Ce sont des recommandations, pas des rapports de mission : aucune ne porte
 * de chiffre. Les chiffres sont dans les cas clients, plus haut sur la page.
 *
 * Les trois citations sont tronquées, et la règle de coupe est stricte : on ne
 * retire que des phrases entières ou des fins de phrase, jamais un fragment au
 * milieu d'une idée, et aucun mot n'est reformulé. Toutes les coupes retirent
 * un éloge : aucune ne peut faire dire à quelqu'un plus que ce qu'il a écrit,
 * seulement moins. Les versions intégrales sont dans l'historique git de ce
 * fichier. Portraits dans `src/assets/testimonials/`.
 */
import { Image } from 'astro:assets';
import LinkCTA from './LinkCTA.astro';
import SectionHeader from './SectionHeader.astro';
import ismailImg from '../assets/testimonials/ismail.jpeg';
import alexisImg from '../assets/testimonials/alexis.jpeg';
import benjaminImg from '../assets/testimonials/benjamin.png';

interface Testimonial {
  quote: string;
  name: string;
  role: string;
  image: ImageMetadata;
}

const testimonials: Testimonial[] = [
  {
    quote: 'Un vrai bonheur de travailler avec Lilian sur des sujets de connectivité via Make.',
    name: 'Ismail Landoulsi',
    role: 'Cofondateur & COO · CasanovaParis',
    image: ismailImg,
  },
  {
    quote: 'J’ai la chance d’avoir collaboré à de nombreuses reprises avec Lilian. Je peux témoigner de son expertise en automatisation.',
    name: 'Alexis Kovalenko',
    role: 'Cofondateur · Contournement',
    image: alexisImg,
  },
  {
    quote: 'Les projets qu’il prend en charge sont un succès.',
    name: 'Benjamin Potet',
    role: 'Solution Architect Customer Experience · Make',
    image: benjaminImg,
  },
];
---

<section
  id="temoignages"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">

    <SectionHeader title="Ils ont travaillé avec moi." titleMaxWidth="22ch" />

    <div class="reveal-stagger temoins">
      {testimonials.map((t) => (
        <figure class="reveal temoin">
          <blockquote>«&nbsp;{t.quote}&nbsp;»</blockquote>
          <figcaption>
            <Image
              src={t.image}
              alt=""
              width={88}
              height={88}
              format="webp"
              quality={82}
              class="temoin__portrait"
              loading="lazy"
            />
            <span class="temoin__nom">{t.name}</span>
            <span class="temoin__role">{t.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    {/* La sortie de la section, dans la colonne des signatures. */}
    <div class="reveal temoins__suite">
      <LinkCTA href="#offres">Voir les offres et le suivi</LinkCTA>
    </div>

  </div>
</section>

<style>
  .temoins {
    display: grid;
    gap: var(--spacing-bloc);
  }

  .temoin {
    display: grid;
    gap: var(--spacing-lie);
    margin: 0;
  }

  /* Un rang sous le titre de la section, à la graisse des titres. */
  .temoin blockquote {
    max-width: 34ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* Le portrait, puis le nom au-dessus du rôle. */
  .temoin figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1rem;
    align-items: center;
  }

  .temoin :global(.temoin__portrait) {
    grid-row: 1 / span 2;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .temoin__nom {
    align-self: end;
    color: var(--color-ink);
    font-weight: 500;
    line-height: 1.35;
  }

  .temoin__role {
    align-self: start;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.35;
  }

  .temoins__suite {
    margin-top: var(--spacing-groupe);
  }

  /* Deux colonnes : la citation, puis sa signature sur la même ligne. La
     sortie se range sous les signatures. */
  @media (min-width: 900px) {
    .temoin,
    .temoins__suite {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      column-gap: var(--spacing-gouttiere);
      align-items: start;
    }

    .temoins__suite > :global(*) {
      grid-column: 2;
    }
  }
</style>
