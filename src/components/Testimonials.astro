---
import { Image } from 'astro:assets';
import ismailImg from '../assets/testimonials/ismail.jpeg';
import alexisImg from '../assets/testimonials/alexis.jpeg';
import benjaminImg from '../assets/testimonials/benjamin.png';

const testimonials = [
  {
    quote: "Un Champion du no code d'Airtable et de Make avéré\u00A0! Un vrai bonheur de travailler avec Lilian sur des sujets de connectivité via Make.",
    name: "Ismail Landoulsi",
    roleTitle: "Co-Founder & COO",
    company: "CasanovaParis",
    image: ismailImg,
    color: "orange",
  },
  {
    quote: "J'ai la chance d'avoir collaboré à de nombreuses reprises avec Lilian. Je peux témoigner de son expertise en automatisation et de sa volonté infaillible de servir un projet.",
    name: "Alexis Kovalenko",
    roleTitle: "Co-fondateur",
    company: "Contournement",
    image: alexisImg,
    color: "purple",
  },
  {
    quote: "Il a une approche très professionnelle, un large spectre de connaissances, et un bon esprit de synthèse. Les projets qu'il prend en charge sont un succès.",
    name: "Benjamin Potet",
    roleTitle: "Solution Architect",
    company: "Customer Experience",
    image: benjaminImg,
    color: "cyan",
  },
];

const colorMap = {
  orange: { shadow: 'card-3d-light-orange', quote: '#E86A33', separator: '#E86A33' },
  purple: { shadow: 'card-3d-light-purple', quote: '#9333EA', separator: '#9333EA' },
  cyan: { shadow: 'card-3d-light-cyan', quote: '#0D9488', separator: '#0D9488' },
};
---

<!-- Testimonials -->
<div class="flex flex-col items-center gap-12">
  <!-- Header -->
  <div class="flex flex-col items-center gap-5">
    <span class="inline-block font-mono text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[var(--color-purple-dark)]">
      TÉMOIGNAGES
    </span>
    <h2 class="font-display text-[length:var(--text-heading)] font-bold text-[#1A1A1A] text-center">
      Ils ont automatisé. Voici leur verdict.
    </h2>
    <p class="font-body text-[length:var(--text-body-lg)] text-[var(--color-text-secondary)] text-center max-w-[600px]">
      Les chiffres sont dans les études de cas. Ici, ce sont les mots de ceux qui vivent l'automatisation au quotidien.
    </p>
  </div>

  <!-- Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full reveal-stagger">
    {testimonials.map((t) => {
      const colors = colorMap[t.color as keyof typeof colorMap];
      return (
        <div class={`${colors.shadow} card-3d-hover flex flex-col gap-4 p-[28px_24px] reveal-card`}>
          {/* Big colored quote mark with circle bg */}
          <div
            class="w-12 h-12 rounded-full flex items-center justify-center shrink-0"
            style={`background: ${colors.quote}15;`}
            aria-hidden="true"
          >
            <span
              class="font-display text-[36px] font-bold leading-[1] select-none mt-2"
              style={`color: ${colors.quote};`}
            >&ldquo;</span>
          </div>

          {/* Quote text */}
          <blockquote class="font-body text-[length:var(--text-body)] italic text-[var(--color-text-primary)] leading-[1.6] flex-1">
            {t.quote}
          </blockquote>

          {/* Colored separator */}
          <div
            class="h-[3px] w-[40px]"
            style={`background: ${colors.separator};`}
            aria-hidden="true"
          ></div>

          {/* Author */}
          <div class="flex items-center gap-3">
            <Image src={t.image} alt={t.name} width={40} height={40} class="w-10 h-10 rounded-full object-cover shrink-0 ring-2 ring-white" loading="lazy" />
            <div class="flex flex-col gap-1">
              <span class="font-body text-[length:var(--text-body)] font-bold text-[#1A1A1A]">{t.name}</span>
              <span class="font-body text-[length:var(--text-caption)] text-[#666666]">
                {t.roleTitle} <span class="font-mono text-[length:var(--text-micro)] font-semibold" style={`color: ${colors.quote};`}>@ {t.company}</span>
              </span>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>
