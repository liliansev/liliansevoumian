---
/*
 * Testimonials.astro — bande de preuve sociale (3 témoignages clients réels).
 *
 * Placée après CaseStudy, dans la zone de preuve. Volontairement SANS numéro de
 * section (≠ étape numérotée) : c'est une bande de réassurance, pas un chapitre
 * du parcours — ça évite de renuméroter Stack/Offres/FAQ/Contact + la nav.
 *
 * Contenu restauré depuis l'ancien composant (commit 48577f1~1) : vrais clients,
 * pas d'invention. Avatars dans src/assets/testimonials/.
 */
import { Image } from 'astro:assets';
import LinkCTA from './LinkCTA.astro';
import SectionHeader from './SectionHeader.astro';
import ismailImg from '../assets/testimonials/ismail.jpeg';
import alexisImg from '../assets/testimonials/alexis.jpeg';
import benjaminImg from '../assets/testimonials/benjamin.png';

interface Testimonial {
  quote: string;
  name: string;
  role: string;
  image: ImageMetadata;
}

/* Les trois citations sont tronquées, et la règle de coupe est stricte : on ne
 * retire que des phrases entières ou des fins de phrase, jamais un fragment au
 * milieu d'une idée, et aucun mot n'est reformulé. Toutes les coupes retirent
 * un éloge — aucune ne peut donc faire dire à quelqu'un plus que ce qu'il a
 * écrit, seulement moins. Les versions intégrales sont dans l'historique git de
 * ce fichier.
 *
 * Ce qui part, et pourquoi :
 *  · Ismail — « Un Champion du no-code d'Airtable et de Make avéré ! » Le
 *    registre jurait avec la voix du reste du site, et la phrase gardée est la
 *    seule des deux à nommer un sujet de travail.
 *  · Alexis — « et de sa volonté infaillible de servir un projet ». Le fait le
 *    plus probant de toute la section est ailleurs dans sa phrase : quelqu'un
 *    qui revient « à de nombreuses reprises ». Le superlatif le diluait.
 *  · Benjamin — « Il a une approche très professionnelle, un large spectre de
 *    connaissances, et un bon esprit de synthèse. » Trois adjectifs devant la
 *    seule phrase de résultat des trois témoignages. Elle reste seule, et
 *    courte, ce qui la fait entendre.
 */
const testimonials: Testimonial[] = [
  {
    quote: "Un vrai bonheur de travailler avec Lilian sur des sujets de connectivité via Make.",
    name: 'Ismail Landoulsi',
    role: 'Co-fondateur & COO · CasanovaParis',
    image: ismailImg,
  },
  {
    quote: "J'ai la chance d'avoir collaboré à de nombreuses reprises avec Lilian. Je peux témoigner de son expertise en automatisation.",
    name: 'Alexis Kovalenko',
    role: 'Co-fondateur · Contournement',
    image: alexisImg,
  },
  {
    quote: 'Les projets qu\'il prend en charge sont un succès.',
    name: 'Benjamin Potet',
    role: 'Solution Architect · Customer Experience',
    image: benjaminImg,
  },
];
---

<section
  id="temoignages"
  data-section
  class="bloc-lime relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    {/* L'en-tête passe par SectionHeader. Il était réimplémenté à la main, et
        trois écarts en découlaient, tous mesurés sur la page vivante : aucun
        filet sous le titre là où les six autres sections de la home en ont un,
        24 px entre le titre et le chapô contre 53 ailleurs, et 48 px entre le
        bloc et le contenu contre 64. Comme cette DA fait porter l'élévation par
        les filets et non par l'ombre, un titre de section sans son filet annonce
        un rang inférieur : la seule section en aplat lime, celle qui porte la
        preuve sociale, se présentait comme une sous-partie.
        Les deux mesures propres à cette section — 22ch de titre, 52ch de chapô —
        passent en props ; elles ne justifiaient pas un markup à part.

        Le chapô, lui, ne bouge pas. Il dit ce que ces trois voix apportent, et
        surtout ce qu'elles n'apportent pas : aucune ne contient de chiffre, de
        délai ni de nom de projet — ce sont des recommandations, pas des rapports
        de mission, et elles ne le deviendront pas. Le problème n'était pas leur
        contenu mais leur place : posées juste après quatre cas chiffrés, elles
        se lisaient comme une preuve qui faiblit. Nommer les deux registres remet
        chacun à son travail, et évite au lecteur de chercher ici une mesure qui
        est à deux mille pixels au-dessus. */}
    <SectionHeader
      title="Ce qu'en disent ceux qui ont <mark>travaillé avec moi.</mark>"
      titleMaxWidth="22ch"
      body="Les chiffres sont dans les quatre cas, juste au-dessus. Ceux-là parlent de ce que les chiffres ne disent pas."
      bodyMaxWidth="52ch"
    />

    {/* Pull-quotes éditoriaux pleine largeur, séparés par des filets — texture
        volontairement distincte de la grille de cartes des cas clients (le bloc
        de preuve sociale ne doit pas se confondre avec le catalogue). */}
    <div class="reveal-stagger flex flex-col">
      {testimonials.map((t) => (
        <figure class="reveal grid grid-cols-1 md:grid-cols-[1fr_minmax(0,240px)] gap-5 md:gap-12 items-start py-7 md:py-9 border-t border-[var(--color-divider)] m-0">
          <blockquote class="font-display font-medium text-[length:var(--text-title-lg)] leading-[1.4] tracking-[-0.015em] text-[var(--color-ink)] m-0 max-w-[36ch]">
            «&nbsp;{t.quote}&nbsp;»
          </blockquote>
          <figcaption class="flex items-center gap-3 shrink-0 md:pt-2">
            <Image
              src={t.image}
              alt={`Photo de ${t.name}`}
              width={80}
              height={80}
              format="webp"
              quality={82}
              class="testi-avatar"
              loading="lazy"
            />
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="font-display font-semibold text-[var(--color-ink)] leading-tight">{t.name}</span>
              <span class="mono-caption text-[var(--color-ink-low)]">{t.role}</span>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    {/* Le seul lien de réservation de la zone de preuve. Entre le hero et la
        section outils, quatre sections et trois mille cinq cents pixels de cas,
        de recommandations et de parcours n'en portaient aucun : le lecteur
        traversait le moment où il est le plus convaincu sans rien à cliquer.
        Lien secondaire et non bouton plein — l'action primaire de la page reste
        la même, elle n'a pas besoin d'un quatorzième bouton noir. */}
    <div class="reveal mt-10 md:mt-12 pt-7 border-t border-[var(--color-divider)]">
      <LinkCTA
        href="https://cal.com/lilian-sevoumian/20min"
        goal="lead_call"
        goalSource="temoignages"
      >
        Voir ce que ça donnerait chez moi
      </LinkCTA>
    </div>
  </div>
</section>

<style>
  /* `.testi-header-row` est partie avec le markup d'en-tête : elle ne portait
     qu'un `position: relative` dont plus rien ne dépendait. */
  .testi-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-divider);
  }
</style>
