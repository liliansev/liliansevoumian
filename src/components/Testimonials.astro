---
/*
 * Testimonials.astro — bande de preuve sociale (3 témoignages clients réels).
 *
 * Placée après CaseStudy, dans la zone de preuve. Volontairement SANS numéro de
 * section (≠ étape numérotée) : c'est une bande de réassurance, pas un chapitre
 * du parcours — ça évite de renuméroter Stack/Offres/FAQ/Contact + la nav.
 *
 * Contenu restauré depuis l'ancien composant (commit 48577f1~1) : vrais clients,
 * pas d'invention. Avatars dans src/assets/testimonials/.
 */
import { Image } from 'astro:assets';
import LinkCTA from './LinkCTA.astro';
import ismailImg from '../assets/testimonials/ismail.jpeg';
import alexisImg from '../assets/testimonials/alexis.jpeg';
import benjaminImg from '../assets/testimonials/benjamin.png';

interface Testimonial {
  quote: string;
  name: string;
  role: string;
  image: ImageMetadata;
}

const testimonials: Testimonial[] = [
  {
    quote: "Un Champion du no-code d'Airtable et de Make avéré ! Un vrai bonheur de travailler avec Lilian sur des sujets de connectivité via Make.",
    name: 'Ismail Landoulsi',
    role: 'Co-fondateur & COO · CasanovaParis',
    image: ismailImg,
  },
  {
    quote: "J'ai la chance d'avoir collaboré à de nombreuses reprises avec Lilian. Je peux témoigner de son expertise en automatisation et de sa volonté infaillible de servir un projet.",
    name: 'Alexis Kovalenko',
    role: 'Co-fondateur · Contournement',
    image: alexisImg,
  },
  {
    quote: 'Il a une approche très professionnelle, un large spectre de connaissances, et un bon esprit de synthèse. Les projets qu\'il prend en charge sont un succès.',
    name: 'Benjamin Potet',
    role: 'Solution Architect · Customer Experience',
    image: benjaminImg,
  },
];
---

<section
  id="temoignages"
  data-section
  class="bloc-lime relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    {/* Header sans numéro ni sur-titre — bande de preuve, pas une étape. Le
        titre nomme déjà ce que la section montre, et « RECOMMANDATIONS » le
        redisait juste au-dessus en plus petit.

        Le chapô dit ce que ces trois voix apportent, et surtout ce qu'elles
        n'apportent pas. Aucune ne contient de chiffre, de délai ni de nom de
        projet — ce sont des recommandations, pas des rapports de mission, et
        elles ne le deviendront pas. Le problème n'était donc pas leur contenu
        mais leur place : posées juste après quatre cas chiffrés, elles se
        lisaient comme une preuve qui faiblit. Nommer les deux registres remet
        chacun à son travail, et évite au lecteur de chercher ici une mesure qui
        est à deux mille pixels au-dessus. */}
    <div class="reveal mb-10 md:mb-12">
      <div class="testi-header-row">
        <h2
          class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] m-0 text-[var(--color-ink)]"
          style="max-width: 22ch;"
        >
          Ce qu'en disent ceux qui ont <mark>travaillé avec moi.</mark>
        </h2>
        <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] mt-6 mb-0 max-w-[52ch]">
          Les chiffres sont dans les quatre cas, juste au-dessus. Ceux-là parlent
          de ce que les chiffres ne disent pas.
        </p>
      </div>
    </div>

    {/* Pull-quotes éditoriaux pleine largeur, séparés par des filets — texture
        volontairement distincte de la grille de cartes des cas clients (le bloc
        de preuve sociale ne doit pas se confondre avec le catalogue). */}
    <div class="reveal-stagger flex flex-col">
      {testimonials.map((t) => (
        <figure class="reveal grid grid-cols-1 md:grid-cols-[1fr_minmax(0,240px)] gap-5 md:gap-12 items-start py-7 md:py-9 border-t border-[var(--color-divider)] m-0">
          <blockquote class="font-display font-medium text-[length:var(--text-title-lg)] leading-[1.4] tracking-[-0.015em] text-[var(--color-ink)] m-0 max-w-[36ch]">
            «&nbsp;{t.quote}&nbsp;»
          </blockquote>
          <figcaption class="flex items-center gap-3 shrink-0 md:pt-2">
            <Image
              src={t.image}
              alt={`Photo de ${t.name}`}
              width={80}
              height={80}
              format="webp"
              quality={82}
              class="testi-avatar"
              loading="lazy"
            />
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="font-display font-semibold text-[var(--color-ink)] leading-tight">{t.name}</span>
              <span class="mono-caption text-[var(--color-ink-low)]">{t.role}</span>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    {/* Le seul lien de réservation de la zone de preuve. Entre le hero et la
        section outils, quatre sections et trois mille cinq cents pixels de cas,
        de recommandations et de parcours n'en portaient aucun : le lecteur
        traversait le moment où il est le plus convaincu sans rien à cliquer.
        Lien secondaire et non bouton plein — l'action primaire de la page reste
        la même, elle n'a pas besoin d'un quatorzième bouton noir. */}
    <div class="reveal mt-10 md:mt-12 pt-7 border-t border-[var(--color-divider)]">
      <LinkCTA
        href="https://cal.com/lilian-sevoumian/20min"
        goal="lead_call"
        goalSource="temoignages"
      >
        Voir ce que ça donnerait chez moi
      </LinkCTA>
    </div>
  </div>
</section>

<style>
  .testi-header-row {
    position: relative;
  }
  .testi-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-divider);
  }
</style>
