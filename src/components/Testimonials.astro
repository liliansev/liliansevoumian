---
import { Image } from 'astro:assets';
import ismailImg from '../assets/testimonials/ismail.jpeg';
import alexisImg from '../assets/testimonials/alexis.jpeg';
import benjaminImg from '../assets/testimonials/benjamin.png';
import carolineImg from '../assets/testimonials/caroline.jpeg';
import geraldImg from '../assets/testimonials/gerald.jpeg';

const testimonials = [
  {
    quote: "Lilian a transformé nos process internes. Gain de temps immédiat et ROI visible dès le premier mois.",
    author: "Ismail Landoulsi",
    role: "Co-Founder & COO",
    company: "CasanovaParis",
    image: ismailImg
  },
  {
    quote: "La formation était claire, progressive et directement applicable. Je recommande à 100%.",
    author: "Alexis Kovalenko",
    role: "Co-fondateur",
    company: "Contournement",
    image: alexisImg
  },
  {
    quote: "Un vrai expert qui comprend les enjeux business. Les automatisations mises en place nous font gagner un temps considérable.",
    author: "Benjamin Potet",
    role: "Solution Architect",
    company: "Customer Experience",
    image: benjaminImg
  },
  {
    quote: "Grâce à Lilian, nous avons automatisé notre onboarding. Nos équipes se concentrent enfin sur l'essentiel.",
    author: "Caroline Le Viet",
    role: "Co-fondatrice",
    company: "Edumiam",
    image: carolineImg
  },
  {
    quote: "Expert! Professionnel, réactif et surtout très pédagogue. Les formations sont claires et concrètes.",
    author: "Gérald Durand",
    role: "Directeur Général",
    company: "BodyCoaching",
    image: geraldImg
  }
];
---

<section id="temoignages" class="bg-[#F4F4F5] py-20 px-6 lg:px-[120px]">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12 flex flex-col items-center gap-3">
      <span class="font-mono text-[13px] font-semibold text-[#A1A1AA] tracking-[2px]">// TÉMOIGNAGES</span>
      <h2 class="text-[32px] lg:text-[40px] font-extrabold text-black leading-[1.1] tracking-[-1px]">
        Ce qu'ils disent de moi
      </h2>
      <p class="text-[18px] text-[#71717A] font-normal">
        Des retours concrets de clients et partenaires
      </p>
    </div>

    <!-- Testimonials Grid - Row 1 -->
    <div class="grid md:grid-cols-3 gap-6 mb-6">
      {testimonials.slice(0, 3).map((t) => (
        <div class="bg-white rounded-xl p-7 flex flex-col gap-5 border border-[#E4E4E7]">
          <blockquote class="text-[15px] text-[#71717A] italic font-normal leading-[1.6] flex-1">
            "{t.quote}"
          </blockquote>
          <div class="flex items-center gap-3">
            <Image
              src={t.image}
              alt={t.author}
              width={40}
              height={40}
              class="w-10 h-10 rounded-full object-cover"
            />
            <div class="flex flex-col gap-0.5">
              <span class="text-sm font-semibold text-black">{t.author}</span>
              <span class="text-xs text-[#71717A]">{t.role} @ {t.company}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Testimonials Grid - Row 2 -->
    <div class="grid md:grid-cols-3 gap-6">
      {testimonials.slice(3).map((t) => (
        <div class="bg-white rounded-xl p-7 flex flex-col gap-5 border border-[#E4E4E7]">
          <blockquote class="text-[15px] text-[#71717A] italic font-normal leading-[1.6] flex-1">
            "{t.quote}"
          </blockquote>
          <div class="flex items-center gap-3">
            <Image
              src={t.image}
              alt={t.author}
              width={40}
              height={40}
              class="w-10 h-10 rounded-full object-cover"
            />
            <div class="flex flex-col gap-0.5">
              <span class="text-sm font-semibold text-black">{t.author}</span>
              <span class="text-xs text-[#71717A]">{t.role} @ {t.company}</span>
            </div>
          </div>
        </div>
      ))}

      <!-- CTA Card -->
      <a
        href="https://lilian.yt/contact"
        class="bg-white rounded-xl p-7 flex flex-col items-center justify-center gap-5 border border-[#E4E4E7] hover:border-[#A1A1AA] transition-colors group"
      >
        <span class="text-3xl font-light text-[#A1A1AA]">+</span>
        <span class="text-base font-semibold text-black text-center">Votre témoignage ici ?</span>
        <span class="text-sm text-[#A1A1AA] text-center">Commencez votre aventure automatisation</span>
      </a>
    </div>
  </div>
</section>
