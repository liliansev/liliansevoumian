---
import { Image } from 'astro:assets';
import ismailImg from '../assets/testimonials/ismail.jpeg';
import alexisImg from '../assets/testimonials/alexis.jpeg';
import benjaminImg from '../assets/testimonials/benjamin.png';

const testimonials = [
  {
    quote: "Un Champion du no code d'Airtable et de Make avéré ! Un vrai bonheur de travailler avec Lilian sur des sujets de connectivité via Make.",
    name: "Ismail Landoulsi",
    role: "Co-Founder & COO @ CasanovaParis",
    image: ismailImg,
  },
  {
    quote: "J'ai la chance d'avoir collaboré à de nombreuses reprises avec Lilian. Je peux témoigner de son expertise en automatisation et de sa volonté infaillible de servir un projet.",
    name: "Alexis Kovalenko",
    role: "Co-fondateur @ Contournement",
    image: alexisImg,
  },
  {
    quote: "Il a une approche très professionnelle, un large spectre de connaissances, et un bon esprit de synthèse. Les projets qu'il prend en charge sont un succès.",
    name: "Benjamin Potet",
    role: "Solution Architect @ Customer Experience",
    image: benjaminImg,
  },
];
---

<!-- Testimonials -->
<div class="flex flex-col items-center gap-12">
  <!-- Header -->
  <div class="flex flex-col items-center gap-5">
    <span
      class="inline-block rounded-full border px-4 py-1.5 font-[var(--font-mono)] text-[11px] font-medium tracking-[2px] uppercase"
      style="background: #F3F0FF; border-color: rgba(139,92,246,0.19); color: #777777;"
    >
      TÉMOIGNAGES
    </span>
    <h2 class="font-[var(--font-display)] text-[length:var(--text-heading)] font-bold text-[#0A0A0A] text-center">
      Ce qu'ils en disent
    </h2>
  </div>

  <!-- Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 w-full">
    {testimonials.map((t) => (
      <div
        class="flex flex-col gap-5 rounded-xl border p-6 md:p-8 bg-white"
        style="border-color: #E5E5E5;"
      >
        <blockquote class="font-[var(--font-body)] text-sm md:text-base text-[#0A0A0A] leading-[1.6] flex-1">
          &laquo;{t.quote}&raquo;
        </blockquote>
        <div class="h-px w-full" style="background: #E5E5E5;" aria-hidden="true"></div>
        <div class="flex items-center gap-3">
          <Image src={t.image} alt={t.name} width={40} height={40} class="w-10 h-10 rounded-full object-cover shrink-0" loading="lazy" />
          <div class="flex flex-col gap-0.5">
            <span class="font-[var(--font-body)] text-sm font-medium text-[#0A0A0A]">{t.name}</span>
            <span class="font-[var(--font-body)] text-[13px] text-[#777777]">{t.role}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
