---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ismailImg from '../assets/testimonials/ismail.jpeg';
import alexisImg from '../assets/testimonials/alexis.jpeg';
import benjaminImg from '../assets/testimonials/benjamin.png';
import carolineImg from '../assets/testimonials/caroline.jpeg';
import geraldImg from '../assets/testimonials/gerald.jpeg';

const testimonials = [
  {
    quote: "Un Champion du no code d'Airtable et de Make avéré ! Un vrai bonheur de travailler avec Lilian sur des sujets de connectivité via Make. Il est à l'écoute, arrangeant et passionné.",
    name: "Ismail Landoulsi",
    role: "Co-Founder & COO",
    company: "CasanovaParis",
    image: ismailImg,
  },
  {
    quote: "J'ai la chance d'avoir collaboré à de nombreuses reprises avec Lilian et nous avons même conçu une formation à Make ensemble. Je peux témoigner à la fois de son expertise en automatisation et de sa volonté infaillible de servir un projet.",
    name: "Alexis Kovalenko",
    role: "Co-fondateur",
    company: "Contournement",
    image: alexisImg,
  },
  {
    quote: "Il a une approche très professionnelle, un large spectre de connaissances, et un bon esprit de synthèse. Tout cela fait que les projets qu'il prend en charge sont un succès. Je le recommande chaudement !",
    name: "Benjamin Potet",
    role: "Solution Architect",
    company: "Customer Experience",
    image: benjaminImg,
  },
  {
    quote: "Lilian nous a accompagné à migrer nos automatisations de Zapier à Make en améliorant de nombreux scénarios pour plus d'efficacité.",
    name: "Caroline Le Viet",
    role: "Co-fondatrice",
    company: "Edumiam",
    image: carolineImg,
  },
  {
    quote: "Plus qu'une prestation de service, c'est réellement un moment d'échange, de partage, et de formation que Lilian offre à travers ses interventions. On ressort grandit dans notre manière de travailler à chaque fois.",
    name: "Gérald Durand",
    role: "Directeur Général",
    company: "BodyCoaching",
    image: geraldImg,
  },
];

const ctaCard = {
  text: "La prochaine success story, c'est vous ?",
  subtext: "Rejoignez les entreprises qui automatisent avec succès.",
  href: "https://lilian.yt/contact",
};
---

<!-- Testimonials: dark gaming aesthetic with emerald + gold -->
<section id="temoignages" class="fade-in-section bg-[var(--bg-darkest)] py-16 lg:py-20">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-[60px]">
    <!-- Header -->
    <div class="flex flex-col items-center gap-4 mb-10">
      <span class="font-mono text-xs font-semibold text-[var(--gold)] tracking-[3px]">// TÉMOIGNAGES</span>
      <h2 class="font-heading text-[28px] lg:text-[40px] font-extrabold text-[var(--text-primary)] text-center tracking-[-1px]">
        Ils en parlent
      </h2>
    </div>

    <!-- Mobile: horizontal scroll carousel -->
    <div class="flex gap-4 overflow-x-auto scrollbar-hide snap-x snap-mandatory pb-4 md:hidden pl-0 -mx-6 px-6">
      {testimonials.map((t) => (
        <div class="snap-start shrink-0 w-[280px] bg-[var(--bg-card)] border border-[var(--border)] p-5 flex flex-col gap-4">
          <span class="font-heading text-[28px] font-extrabold leading-none text-[var(--gold)]">&#10077;</span>
          <blockquote class="font-mono text-xs text-[var(--text-primary)] leading-[1.7] flex-1">
            {t.quote}
          </blockquote>
          <div class="flex items-center gap-3 pt-4 border-t border-[var(--border)]">
            <Image src={t.image} alt={t.name} width={36} height={36} class="w-9 h-9 rounded-full object-cover shrink-0" />
            <div class="flex flex-col gap-0.5">
              <span class="font-mono text-xs font-bold text-[var(--accent)]">{t.name}</span>
              <span class="font-mono text-[10px] text-[var(--text-secondary)]">{t.role} @ {t.company}</span>
            </div>
          </div>
        </div>
      ))}
      <!-- CTA card in carousel -->
      <a href={ctaCard.href} class="snap-start shrink-0 w-[280px] bg-[var(--bg-card)] border-2 border-dashed border-[var(--accent)] p-5 flex flex-col items-center justify-center gap-4 text-center hover:bg-[var(--accent-surface)] transition-colors group">
        <div class="w-10 h-10 rounded-full bg-[var(--border)] flex items-center justify-center group-hover:bg-[var(--accent)] transition-colors">
          <Icon name="lucide:user-plus" class="w-5 h-5 text-[var(--text-secondary)] group-hover:text-[var(--text-on-accent)] transition-colors" />
        </div>
        <span class="font-heading text-base font-extrabold text-[var(--text-primary)]">{ctaCard.text}</span>
        <p class="font-mono text-[11px] text-[var(--text-secondary)] leading-[1.6]">{ctaCard.subtext}</p>
      </a>
    </div>

    <!-- Desktop: grid layout -->
    <div class="hidden md:grid md:grid-cols-3 gap-6 mb-6 mc-stagger">
      {testimonials.slice(0, 3).map((t) => (
        <div class="mc-card bg-[var(--bg-card)] border border-[var(--border)] p-7 flex flex-col gap-4">
          <span class="font-heading text-[36px] font-extrabold leading-none text-[var(--gold)]">&#10077;</span>
          <blockquote class="font-mono text-sm text-[var(--text-primary)] leading-[1.7] flex-1">
            {t.quote}
          </blockquote>
          <div class="flex items-center gap-3 pt-4 border-t border-[var(--border)]">
            <Image src={t.image} alt={t.name} width={36} height={36} class="w-9 h-9 rounded-full object-cover shrink-0" />
            <div class="flex flex-col gap-0.5">
              <span class="font-mono text-sm font-bold text-[var(--accent)]">{t.name}</span>
              <span class="font-mono text-[11px] text-[var(--text-secondary)]">{t.role} @ {t.company}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="hidden md:grid md:grid-cols-3 gap-6 mc-stagger">
      {testimonials.slice(3, 5).map((t) => (
        <div class="mc-card bg-[var(--bg-card)] border border-[var(--border)] p-7 flex flex-col gap-4">
          <span class="font-heading text-[36px] font-extrabold leading-none text-[var(--gold)]">&#10077;</span>
          <blockquote class="font-mono text-sm text-[var(--text-primary)] leading-[1.7] flex-1">
            {t.quote}
          </blockquote>
          <div class="flex items-center gap-3 pt-4 border-t border-[var(--border)]">
            <Image src={t.image} alt={t.name} width={36} height={36} class="w-9 h-9 rounded-full object-cover shrink-0" />
            <div class="flex flex-col gap-0.5">
              <span class="font-mono text-sm font-bold text-[var(--accent)]">{t.name}</span>
              <span class="font-mono text-[11px] text-[var(--text-secondary)]">{t.role} @ {t.company}</span>
            </div>
          </div>
        </div>
      ))}
      <a href={ctaCard.href} class="mc-card bg-[var(--bg-card)] border-2 border-dashed border-[var(--accent)] p-7 flex flex-col items-center justify-center gap-4 text-center hover:bg-[var(--accent-surface)] transition-colors group">
        <div class="w-10 h-10 rounded-full bg-[var(--border)] flex items-center justify-center group-hover:bg-[var(--accent)] transition-colors">
          <Icon name="lucide:user-plus" class="w-5 h-5 text-[var(--text-secondary)] group-hover:text-[var(--text-on-accent)] transition-colors" />
        </div>
        <span class="font-heading text-lg font-extrabold text-[var(--text-primary)]">{ctaCard.text}</span>
        <p class="font-mono text-xs text-[var(--text-secondary)] leading-[1.6]">{ctaCard.subtext}</p>
      </a>
    </div>
  </div>
</section>
