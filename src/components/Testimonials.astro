---
import { Image } from 'astro:assets';
import ismailImg from '../assets/testimonials/ismail.jpeg';
import alexisImg from '../assets/testimonials/alexis.jpeg';
import benjaminImg from '../assets/testimonials/benjamin.png';

const testimonials = [
  {
    quote: "Un Champion du no code d'Airtable et de Make avéré\u00A0! Un vrai bonheur de travailler avec Lilian sur des sujets de connectivité via Make.",
    name: "Ismail Landoulsi",
    role: "Co-Founder & COO @ CasanovaParis",
    image: ismailImg,
    color: "orange",
  },
  {
    quote: "J'ai la chance d'avoir collaboré à de nombreuses reprises avec Lilian. Je peux témoigner de son expertise en automatisation et de sa volonté infaillible de servir un projet.",
    name: "Alexis Kovalenko",
    role: "Co-fondateur @ Contournement",
    image: alexisImg,
    color: "purple",
  },
  {
    quote: "Il a une approche très professionnelle, un large spectre de connaissances, et un bon esprit de synthèse. Les projets qu'il prend en charge sont un succès.",
    name: "Benjamin Potet",
    role: "Solution Architect @ Customer Experience",
    image: benjaminImg,
    color: "cyan",
  },
];

const colorMap = {
  orange: { shadow: 'card-3d-white-orange', quote: '#E86A33', separator: '#E86A33' },
  purple: { shadow: 'card-3d-white-purple', quote: '#9333EA', separator: '#9333EA' },
  cyan: { shadow: 'card-3d-white-cyan', quote: '#22D3EE', separator: '#22D3EE' },
};
---

<!-- Testimonials -->
<div class="flex flex-col items-center gap-12">
  <!-- Header -->
  <div class="flex flex-col items-center gap-5">
    <span class="inline-block font-mono text-[12px] font-semibold tracking-[2px] uppercase text-[#7928CA]">
      TÉMOIGNAGES
    </span>
    <h2 class="font-display text-[40px] font-bold tracking-[-0.02em] text-[#1A1A1A] text-center">
      Ce qu'ils en disent
    </h2>
  </div>

  <!-- Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full reveal-stagger">
    {testimonials.map((t) => {
      const colors = colorMap[t.color as keyof typeof colorMap];
      return (
        <div class={`${colors.shadow} flex flex-col gap-5 p-[28px_24px] reveal-card`}>
          {/* Big colored quote mark with circle bg */}
          <div
            class="w-12 h-12 rounded-full flex items-center justify-center shrink-0"
            style={`background: ${colors.quote}15;`}
            aria-hidden="true"
          >
            <span
              class="font-display text-[36px] font-bold leading-[1] select-none mt-2"
              style={`color: ${colors.quote};`}
            >&ldquo;</span>
          </div>

          {/* Quote text */}
          <blockquote class="font-body text-[15px] italic text-[var(--color-text-primary)] leading-[1.6] flex-1">
            {t.quote}
          </blockquote>

          {/* Colored separator */}
          <div
            class="h-[3px] w-[40px]"
            style={`background: ${colors.separator};`}
            aria-hidden="true"
          ></div>

          {/* Author */}
          <div class="flex items-center gap-3">
            <Image src={t.image} alt={t.name} width={40} height={40} class="w-10 h-10 rounded-full object-cover shrink-0" loading="lazy" />
            <div class="flex flex-col gap-1">
              <span class="font-body text-[14px] font-bold text-[#1A1A1A]">{t.name}</span>
              <span class="font-body text-[12px] text-[#666666]">{t.role}</span>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>
