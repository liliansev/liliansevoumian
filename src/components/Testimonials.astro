---
/*
 * Testimonials — trois recommandations de vraies personnes, sur
 * /automatisations-ia : les mêmes que sur l'accueil (`data/avis.ts`), en
 * cartes, le passage clé surligné en jaune comme là-bas.
 *
 * Ce sont des recommandations, pas des rapports de mission : aucune ne porte
 * de chiffre. Les chiffres sont dans les cas clients, plus haut sur la page.
 *
 * La règle de coupe des citations est écrite dans `data/avis.ts`.
 */
import { Image } from 'astro:assets';
import LinkCTA from './LinkCTA.astro';
import SectionHeader from './SectionHeader.astro';
import { avis } from '../data/avis';
---

<section
  id="temoignages"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">

    <SectionHeader title="Ils ont travaillé avec moi." titleMaxWidth="22ch" />

    <div class="reveal-stagger temoins">
      {avis.map((t) => (
        <figure class="reveal temoin">
          <blockquote>«&nbsp;{t.citation[0]}<span class="surligne">{t.citation[1]}</span>{t.citation[2]}&nbsp;»</blockquote>
          <figcaption>
            <Image
              src={t.image}
              alt=""
              width={88}
              height={88}
              format="webp"
              quality={82}
              class="temoin__portrait"
              loading="lazy"
            />
            <span class="temoin__nom">{t.nom}</span>
            <span class="temoin__role">{t.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    {/* La sortie de la section, dans la colonne des signatures. */}
    <div class="reveal temoins__suite">
      <LinkCTA href="#offres">Voir les offres et le suivi</LinkCTA>
    </div>

  </div>
</section>

<style>
  /* Trois cartes posées sur le papier, comme les avis de l'accueil : bord
     d'encre, ombre pleine, un léger biais chacune (28 octobre 2026). */
  .temoins {
    display: grid;
    gap: var(--spacing-gouttiere);
  }

  .temoin {
    display: grid;
    align-content: space-between;
    gap: var(--spacing-lie);
    margin: 0;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    border: 2.5px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-low);
    box-shadow: var(--shadow-card);
  }

  .temoin:nth-child(1) { rotate: -0.8deg; }
  .temoin:nth-child(2) { rotate: 0.6deg; }
  .temoin:nth-child(3) { rotate: -0.4deg; }

  /* Le surligneur de l'accueil (`carnet/avis.astro`). */
  .surligne {
    padding: 0 2px;
    background: linear-gradient(transparent 38%, var(--jaune) 38%, var(--jaune) 88%, transparent 88%);
  }

  .temoin blockquote {
    max-width: 34ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-body-large);
    font-weight: 500;
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* Le portrait, puis le nom au-dessus du rôle. */
  .temoin figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: center;
  }

  .temoin :global(.temoin__portrait) {
    grid-row: 1 / span 2;
    width: 44px;
    height: 44px;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .temoin__nom {
    align-self: end;
    color: var(--color-ink);
    font-weight: 700;
    line-height: 1.35;
  }

  .temoin__role {
    align-self: start;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.35;
  }

  .temoins__suite {
    margin-top: var(--spacing-groupe);
  }

  @media (min-width: 900px) {
    .temoins {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .temoin { rotate: none; }
  }
</style>
