---
/*
 * MobileCTABar — barre d'action persistante en thumb-zone (mobile uniquement).
 *
 * Action primaire de conversion (PRODUCT.md : succès = réserver un appel).
 * Cachée par défaut, glisse depuis le bas dès que le hero quitte le viewport
 * (IntersectionObserver sur #hero). md:hidden — phones seulement. safe-area-inset
 * pour les encoches iOS. Discrète (papier + blur + filet) pour tenir le register brand.
 */
---

<div
  id="mobile-cta-bar"
  class="md:hidden fixed inset-x-0 bottom-0 z-40 translate-y-full"
  aria-hidden="true"
>
  <div class="border-t border-[var(--color-divider)] bg-[color-mix(in_oklch,var(--color-paper)_90%,transparent)] backdrop-blur-md px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
    <a
      href="https://cal.com/lilian-sevoumian/20min"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary w-full justify-center"
      data-fast-goal="lead_call"
      data-fast-goal-source="mobile_bar"
      tabindex="-1"
    >
      Réserver un appel · 20 min
    </a>
  </div>
</div>

<style>
  #mobile-cta-bar {
    transition: transform var(--duration-default) var(--ease-out-quint);
  }
  #mobile-cta-bar.is-visible {
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-cta-bar { transition: none; }
  }
</style>

<script>
  function initMobileCtaBar(): void {
    const bar = document.getElementById('mobile-cta-bar');
    const hero = document.getElementById('hero');
    const contact = document.getElementById('contact');
    if (!bar || !hero || bar.dataset.init === '1') return;
    bar.dataset.init = '1';

    const link = bar.querySelector<HTMLAnchorElement>('a');
    let heroVisible = true;
    let contactVisible = false;

    function update(): void {
      // Visible une fois le hero dépassé, MAIS cachée quand le formulaire de
      // contact est à l'écran (sinon la barre le recouvre et duplique le CTA).
      const visible = !heroVisible && !contactVisible;
      bar!.classList.toggle('is-visible', visible);
      bar!.setAttribute('aria-hidden', String(!visible));
      if (link) link.tabIndex = visible ? 0 : -1;
    }

    new IntersectionObserver((entries) => {
      entries.forEach((e) => { heroVisible = e.isIntersecting; });
      update();
    }, { threshold: 0 }).observe(hero);

    if (contact) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => { contactVisible = e.isIntersecting; });
        update();
      }, { threshold: 0 }).observe(contact);
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMobileCtaBar);
  else initMobileCtaBar();
  document.addEventListener('astro:page-load', initMobileCtaBar);
</script>
