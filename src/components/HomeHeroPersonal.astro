---
import { Picture } from 'astro:assets';
import LinkCTA from './LinkCTA.astro';
import lilianPhoto from '../assets/lilian-photo.jpg';
---

<section
  id="hero"
  data-section
  class="home-hero relative px-[var(--spacing-section-x)] pt-[80px] md:pt-[88px]"
>
  <div class="home-hero__inner relative mx-auto grid max-w-[1200px] items-center">
    <div class="home-hero__copy">
      <h1>
        J’automatise vos opérations.<br />
        Je construis votre <mark>site web.</mark>
      </h1>

      <p class="home-hero__intro">
        Workflows n8n et Make, agents IA, outils métier ou site web&nbsp;:
        vous travaillez avec la même personne, du cadrage à la mise en ligne.
      </p>

      <div class="home-hero__actions">
        <a href="#services" class="btn-primary">Trouver le bon service</a>
        <LinkCTA href="#qui-je-suis">Pourquoi me confier le projet</LinkCTA>
      </div>

      <p class="home-hero__signature">
        Lilian Sevoumian · Freelance depuis 2020
      </p>
    </div>

    <div class="home-hero__portrait">
      <Picture
        src={lilianPhoto}
        alt="Lilian Sevoumian, freelance en automatisation, IA et création de sites web"
        class="home-hero__picture"
        formats={['avif', 'webp']}
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 35vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .home-hero {
    border-bottom: 1px solid var(--color-border-strong);
    background: var(--color-paper);
  }

  .home-hero__inner {
    grid-template-columns: minmax(0, 1.18fr) minmax(19rem, 0.82fr);
    gap: clamp(3rem, 7vw, 7rem);
    min-height: min(48rem, calc(100svh - 80px));
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .home-hero__copy {
    min-width: 0;
  }

  .home-hero h1 {
    max-width: 15ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-home-hero);
    line-height: 0.94;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }

  .home-hero__intro {
    max-width: 42ch;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }

  .home-hero__signature {
    margin: 1.75rem 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    font-weight: 550;
  }

  .home-hero__portrait {
    position: relative;
    isolation: isolate;
    margin-right: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .home-hero__portrait::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    z-index: -1;
    background: var(--color-lime);
  }

  .home-hero__picture {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface-low);
  }

  .home-hero__picture :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }

  @media (max-width: 1023px) {
    .home-hero__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
      min-height: 0;
      padding-block: clamp(3rem, 8vw, 5rem);
    }

    .home-hero__portrait {
      margin-right: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .home-hero__portrait::before {
      inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    }

    .home-hero__picture {
      aspect-ratio: 16 / 10;
    }

    .home-hero__picture :global(img) {
      object-position: center 23%;
    }
  }

  @media (max-width: 520px) {
    .home-hero h1 {
      max-width: 13ch;
    }

    .home-hero__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .home-hero__actions :global(.btn-primary) {
      width: 100%;
      justify-content: center;
    }

    .home-hero__picture {
      aspect-ratio: 4 / 3;
    }
  }
</style>
