---
import { Picture } from 'astro:assets';
import LinkCTA from './LinkCTA.astro';
import lilianPhoto from '../assets/lilian-photo.jpg';
---

<section
  id="hero"
  data-section
  class="home-hero relative px-[var(--spacing-section-x)] pt-[80px] md:pt-[88px]"
>
  <div class="home-hero__inner relative mx-auto grid max-w-[1200px] items-center">
    <div class="home-hero__copy">
      <h1>
        Gagnez du temps avec l’IA et <mark>l’automatisation.</mark>
      </h1>

      <p class="home-hero__intro">
        Votre activité grandit, les tâches s’accumulent.
        Je crée des agents IA, des automatisations et des applications métier
        pour alléger le travail de vos équipes.
      </p>

      <div class="home-hero__actions">
        <LinkCTA href="#services">Voir les services</LinkCTA>
      </div>

    </div>

    <figure class="home-hero__portrait">
      <Picture
        src={lilianPhoto}
        alt="Lilian Sevoumian, freelance en automatisation, IA et création de sites web"
        class="home-hero__picture"
        formats={['avif', 'webp']}
        widths={[480, 720, 960]}
        sizes="(min-width: 1440px) 430px, (min-width: 1024px) 35vw, (min-width: 640px) 480px, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span>Lilian Sevoumian</span>
        <span>Freelance depuis 2020</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .home-hero {
    border-bottom: 1px solid var(--color-border-strong);
    background: var(--color-paper);
  }

  .home-hero__inner {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.85fr);
    gap: var(--spacing-home-hero-gap);
    padding-block: var(--spacing-home-hero-y);
  }

  .home-hero__copy {
    min-width: 0;
  }

  .home-hero h1 {
    max-width: 15ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-home-hero);
    line-height: 0.94;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }

  .home-hero__intro {
    max-width: 42ch;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }

  .home-hero__portrait {
    min-width: 0;
    margin: 0;
  }

  .home-hero__picture {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 25%;
    background: var(--color-surface-low);
  }

  .home-hero__portrait figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-top: 1rem;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
  }

  .home-hero__portrait figcaption span:first-child {
    color: var(--color-ink);
    font-weight: 600;
  }

  @media (max-width: 1023px) {
    .home-hero__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .home-hero__portrait {
      width: 100%;
      max-width: 30rem;
    }
  }

  @media (max-width: 520px) {
    .home-hero h1 {
      max-width: 13ch;
    }

    .home-hero__actions {
      align-items: stretch;
      flex-direction: column;
    }

  }
</style>
