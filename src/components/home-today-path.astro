---
/*
 * home-today-path — pourquoi lui, et d'où il vient.
 *
 * C'est le dernier temps du récit de la page : après « vous perdez votre
 * temps » et « voilà ce que je fais », Lilian dit pourquoi lui. Il l'a
 * formulé ainsi : il fait ça depuis six ans, il l'a appliqué dans ses propres
 * activités, et il sait ce que c'est d'avoir une équipe et des clients à
 * livrer en perdant du temps, ou sans les bons outils métier.
 *
 * Deux colonnes qui se lisent ensemble : à gauche, lui (un portrait, quatre
 * faits, puis ce texte), dans le seul panneau clair de la page ; à droite, la
 * frise de 2020 à aujourd'hui. Le panneau reste en place pendant que la
 * frise défile : on garde sous les yeux qui parle pendant qu'on lit par où
 * il est passé.
 *
 * Les quatre faits ouvrent le panneau, en quatre lignes. Ils étaient le plus
 * petit texte de la section, enchaînés en une ligne de 14 px sous le
 * paragraphe : ce sont pourtant les quatre choses les plus fortes qu'il ait à
 * dire de lui (critique du 2 octobre 2026).
 *
 * La frise distingue les jalons (un lancement, un poste, une fondation) des
 * missions, qu'elle donne en une ligne. À douze entrées de même poids, elle
 * faisait plus de deux écrans et mettait un stage au rang d'une fondation.
 *
 * La frise porte le geste de cette section : un rail pêche qui se trace à
 * mesure qu'on la lit. Il avance avec le milieu de la fenêtre, et chaque année
 * s'allume quand il l'atteint. Il est lié au défilement en CSS seul ; là où
 * `animation-timeline` n'existe pas, ou en mouvement réduit, il est tracé en
 * entier. Les années sont des numéros qui portent une information : l'ordre
 * est le sujet.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BoutonReservation from './BoutonReservation.astro';
import SectionHeader from './SectionHeader.astro';
import lilianPhoto from '../assets/lilian-photo.jpg';
import { faits, parcours } from '../data/parcours';
---

<section
  id="pourquoi-moi"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="duo relative mx-auto max-w-[1200px]">
    <div class="duo__auj bloc-encre">
      <div class="moi__tete">
        <Image src={lilianPhoto} alt="Portrait de Lilian Sevoumian" width={160} class="moi__portrait" loading="lazy" />
        <SectionHeader title="Pourquoi moi." titleMaxWidth="none" rule={false} spacing="none" />
      </div>

      <ul class="moi__faits">
        {faits.map((fait) => (
          <li><strong>{fait.titre}</strong><span>{fait.detail}</span></li>
        ))}
      </ul>

      <p class="moi__texte">
        Six ans que j’automatise le travail des entreprises, et d’abord le mien. J’ai cofondé un studio de podcast, lancé
        une activité de formation, puis une agence&nbsp;: à chaque fois avec une équipe, des clients à livrer, et des
        journées mangées par des tâches qui n’avançaient rien. Cette contrainte, je la connais de l’intérieur. C’est pour
        ça que je pars de vos processus réels, pas d’une liste d’outils.
      </p>

      {/* Un appel à mi-page, là où l'on vient de lire pourquoi lui : sur un
          téléphone, le bouton de fin est à treize écrans du premier. Un lien
          fléché, pas un second bouton plein : l'action pleine reste celle de
          la barre et celle de la fin. Comme elles, il ouvre la conversation
          (`home-invite`) ; sans script, l'agenda. */}
      <p class="moi__suite">
        <BoutonReservation source="home_pourquoi_moi" class="link-cta" goal="causerie_opened" data-causerie-ouvrir="">
          <span class="link-cta__label">Parlons de votre projet</span>
          <Icon name="lucide:arrow-right" class="link-cta__arrow" aria-hidden="true" />
        </BoutonReservation>
      </p>
    </div>

    <div id="parcours" class="duo__parcours">
      <SectionHeader title="D’où je viens." titleMaxWidth="14ch" rule={false} spacing="none" />

      <ol class="frise" id="frise" data-frise>
        {parcours.map((periode) => (
          <li class="frise__annee">
            <h3 class="frise__an">{periode.annee}</h3>
            <ul class="frise__etapes">
              {periode.etapes.map((etape) =>
                'mineur' in etape ? (
                  <li class="frise__mission">{etape.titre}</li>
                ) : (
                  <li class="frise__jalon">
                    <p class="frise__titre">
                      <strong>{etape.titre}</strong>
                      {etape.quand && <span class="frise__quand">{etape.quand}</span>}
                    </p>
                    {etape.detail && <p class="frise__detail">{etape.detail}</p>}
                  </li>
                ),
              )}
            </ul>
          </li>
        ))}
      </ol>
      {/* Sur téléphone, la frise s'ouvre sur ses jalons seuls (voir le script).
          Sans script le bouton reste caché et tout est affiché. */}
      <button type="button" class="frise__plus" aria-controls="frise" aria-expanded="true" data-frise-plus hidden>
        Voir tout le parcours
      </button>
    </div>
  </div>
</section>

<script>
  /* Sur téléphone, la frise tenait un écran et quart à elle seule. Elle s'ouvre
     repliée : les jalons (un titre, une date), sans leur détail ni les
     missions, qu'un bouton déplie. Au-delà de 767 px, et sans script, tout est
     affiché. */
  const frise = document.querySelector<HTMLElement>('[data-frise]');
  const bouton = document.querySelector<HTMLButtonElement>('[data-frise-plus]');

  if (frise && bouton) {
    const etroit = window.matchMedia('(max-width: 767px)');
    const regler = (replie: boolean) => {
      frise.toggleAttribute('data-replie', replie);
      bouton.setAttribute('aria-expanded', String(!replie));
      bouton.textContent = replie ? 'Voir tout le parcours' : 'Réduire le parcours';
    };
    const suivre = () => {
      bouton.hidden = !etroit.matches;
      regler(etroit.matches);
    };
    bouton.addEventListener('click', () => {
      const replie = !frise.hasAttribute('data-replie');
      regler(replie);
      /* Repliée, la frise raccourcit au-dessus du bouton : il reste à l'écran. */
      if (replie) bouton.scrollIntoView({ block: 'nearest' });
    });
    etroit.addEventListener('change', suivre);
    suivre();
  }
</script>

<style>
  .duo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--spacing-gouttiere);
    align-items: start;
  }

  /* Le panneau clair, ici une carte et non une île : il n'occupe qu'une
     colonne, donc pas de marge de section. Il ne reste en place que sur un
     écran assez haut pour le montrer en entier (voir plus bas). */
  .duo__auj {
    margin: 0;
    padding: var(--spacing-panneau);
  }

  .duo__parcours {
    padding-top: var(--spacing-panneau);
  }

  /* Sous 366 px le titre ne tient plus à côté du portrait : il passe dessous,
     entier, plutôt que de laisser « moi. » seul sur sa ligne. */
  .moi__tete {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  /* Le titre passe sous le portrait, entier, plutôt que de laisser « moi. »
     seul sur sa ligne : le retour à la ligne de la boîte flexible se décide
     sur sa largeur naturelle. S'il ne tient pas même seul (texte agrandi), il
     se coupe dans sa boîte au lieu de sortir du panneau. */
  .moi__tete > :global(*) {
    max-width: 100%;
  }

  /* Le titre de droite se centre sur la même ligne de 4rem que celui de
     gauche, qui l'est sur le portrait : leurs hauts différaient de 4 à 10 px. */
  .duo__parcours :global(.section-header-row) {
    display: grid;
    align-content: center;
    min-height: 4rem;
  }

  .moi__portrait {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    object-position: center 18%;
  }

  /* Quatre faits, un par ligne : ce qu'on retient en grand, ce qui le précise
     à la suite. Ni grille ni filets. */
  .moi__faits {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: var(--spacing-groupe) 0 0;
    padding: 0;
    list-style: none;
  }

  .moi__faits li {
    display: grid;
    gap: 0.125rem;
    max-width: none;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  /* Un fait ne se coupe pas au milieu de son chiffre. */
  .moi__faits strong {
    color: var(--color-ink);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .moi__texte {
    max-width: 46ch;
    margin: var(--spacing-groupe) 0 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  .moi__suite {
    margin: var(--spacing-lie) 0 0;
  }

  .frise {
    --rail: 0.5rem;
    --retrait: clamp(2rem, 4vw, 3.25rem);
    position: relative;
    margin: var(--spacing-groupe) 0 0;
    padding: 0 0 0 var(--retrait);
    list-style: none;
  }

  /* Le rail au repos, puis son tracé pêche par-dessus. */
  .frise::before,
  .frise::after {
    content: '';
    position: absolute;
    top: 0.9rem;
    bottom: 0.25rem;
    left: var(--rail);
    width: 2px;
    margin-left: -1px;
    border-radius: var(--radius-full);
  }

  .frise::before {
    background: var(--color-divider);
  }

  .frise::after {
    background: var(--color-peche);
    transform-origin: top center;
  }

  .frise__annee {
    position: relative;
    max-width: none;
    padding-bottom: var(--spacing-groupe);
  }

  .frise__annee:last-child {
    padding-bottom: 0;
  }

  /* Le repère de l'année, posé sur le rail. */
  .frise__annee::before {
    content: '';
    position: absolute;
    /* Centré sur la ligne de l'année : la moitié de sa hauteur de ligne,
       moins le demi-repère. */
    top: calc(var(--text-title-lg) * 0.525 - 5.5px);
    left: calc(-1 * var(--retrait) + var(--rail));
    z-index: 1;
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    border: 2px solid var(--color-paper);
    border-radius: var(--radius-full);
    background: var(--color-peche);
  }

  .frise__an {
    margin: 0;
    color: var(--color-ink);
    /* Un repère, pas un titre : au corps et à la graisse du titre de la
       section, les années pesaient plus lourd que lui. */
    font-size: var(--text-title-lg);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .frise__etapes {
    display: grid;
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .frise__etapes li {
    max-width: 52ch;
  }

  /* Repliée (téléphone) : les jalons seuls. Une année qui n'a que des missions
     s'efface avec elles. */
  .frise[data-replie] .frise__detail,
  .frise[data-replie] .frise__mission,
  .frise[data-replie] .frise__annee:not(:has(.frise__jalon)) {
    display: none;
  }

  .frise[data-replie] .frise__annee {
    padding-bottom: var(--spacing-lie);
  }

  .frise__plus {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--spacing-colle);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-ink) 40%, transparent);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .frise__plus[hidden] {
    display: none;
  }

  .frise__titre {
    margin: 0;
    line-height: 1.3;
  }

  .frise__titre strong {
    margin-right: 0.5em;
    color: var(--color-ink);
    font-size: var(--text-body-large);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  /* Le mois, à la suite du titre, en bas de casse : c'était le dernier
     sur-titre en petites capitales pêche de la page. */
  .frise__quand {
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    text-transform: lowercase;
    white-space: nowrap;
  }

  .frise__detail {
    margin: 0.25rem 0 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  /* Une mission : une ligne, sans détail. */
  .frise__mission {
    color: var(--color-ink-low);
    line-height: var(--leading-body);
  }

  /* Le tracé suit le milieu de la fenêtre : `cover 50vh` est l'instant où le
     haut de la frise passe ce milieu, `cover calc(100% - 50vh)` celui où son
     bas le passe. Entre les deux, la part tracée est exactement la part lue. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .frise {
        view-timeline: --frise block;
      }

      .frise::after {
        animation: frise-trace linear both;
        animation-timeline: --frise;
        animation-range: cover 50vh cover calc(100% - 50vh);
      }

      .frise__annee::before {
        animation: frise-repere linear both;
        animation-timeline: view();
        animation-range: cover calc(50vh - 2rem) cover 50vh;
      }
    }
  }

  @keyframes frise-trace {
    from { transform: scaleY(0); }
  }

  @keyframes frise-repere {
    from { background: var(--color-ink-faint); transform: scale(0.7); }
  }

  /* Deux colonnes et un écran d'au moins 740 px de haut : le panneau tient en
     entier sous la barre, il peut rester en place. Sinon il défile avec la
     page, plutôt que de garder sa dernière ligne hors de l'écran. */
  @media (min-width: 1024px) and (min-height: 740px) {
    .duo__auj {
      position: sticky;
      top: calc(var(--spacing-barre) + 1.5rem);
    }
  }

  @media (max-width: 1023px) {
    .duo {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-bloc);
    }

    .duo__parcours {
      padding-top: 0;
    }

    .duo__parcours :global(.section-header-row) {
      min-height: 0;
    }
  }

</style>
