---
import { faqs } from '../data/faq';
---

<section
  id="faq"
  data-section  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16 items-start">

    <!-- Colonne gauche : titre sticky -->
    <div class="reveal lg:sticky lg:top-28">
      <div class="section-number">7 OBJECTIONS · RÉPONSES TRANCHÉES</div>
      <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] m-0 text-[var(--color-ink)] max-w-[20ch]">
        Vos questions sur <mark>l'automatisation</mark>.
      </h2>
    </div>

    {/* Colonne droite : accordion.
        Le conteneur n'est plus un `.reveal` unique — les sept questions
        arrivaient d'un bloc en 700 ms, ce qui ne se lit pas comme une entrée
        mais comme un chargement. Chacune est désormais son propre `.reveal`,
        elles descendent une par une, et un coup de surligneur lime passe sur
        chacune au moment où elle apparaît. Le geste est celui du dispositif de
        la DA, appliqué au temps plutôt qu'à un mot. */}
    <div class="faq-liste flex flex-col gap-3">
      {faqs.map((faq, i) => (
        <div class="faq-item reveal" style={`--rang:${i}`}>

          <details class="faq-details group">
            <summary class="faq-summary">
              <span class="faq-num">Q0{i + 1}</span>
              <span class="faq-question">{faq.q}</span>
              <span class="faq-caret" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        </div>
      ))}

      {/* Pont augmentes.fr — sortie pour l'intention « apprendre soi-même » /
          budget formation, distincte de la demande de mission. Lien secondaire. */}
      <p class="reveal mono-caption text-[var(--color-ink-low)] mt-6 pt-6 border-t border-[var(--color-divider)]" style={`--rang:${faqs.length}`}>
        BUDGET SERRÉ OU ENVIE D'APPRENDRE VOUS-MÊME ?
        <a
          href="https://augmentes.fr"
          target="_blank"
          rel="noopener noreferrer"
          class="tap-44 text-[var(--color-accent-text)] hover:text-[var(--color-ink)] transition-colors ml-1"
        >
          MES FORMATIONS MAKE &amp; N8N <span aria-hidden="true">↗</span>
        </a>
      </p>
    </div>

  </div>
</section>

<script>
  /*
   * Le balayage lime de la FAQ a son propre observateur, séparé de celui des
   * `.reveal`. Deux raisons, et la seconde est celle qui l'imposait :
   *
   *  1. Le failsafe du <head> pose `.is-visible` sur TOUS les `.reveal` de la
   *     page 2,5 s après le chargement, où qu'ils soient — c'est ce qui évite
   *     la page blanche si le module de reveal ne s'exécute jamais. Le
   *     balayage partait donc hors écran et était terminé avant qu'on arrive
   *     dessus. Invisible pour un fondu, fatal pour une animation qui ne joue
   *     qu'une fois.
   *  2. La cascade se déclenche sur la LISTE, pas sur chaque question. En
   *     observant chaque item, un défilement lent ferait attendre près d'une
   *     seconde à la dernière question avant que sa bande parte, alors que
   *     l'échelonnement de `--rang` suppose un départ commun.
   */
  function initFaqSweep(): void {
    const liste = document.querySelector<HTMLElement>('.faq-liste');
    if (!liste || liste.dataset.sweepInit === '1') return;
    liste.dataset.sweepInit = '1';

    const items = Array.from(liste.querySelectorAll<HTMLElement>('.faq-item'));
    if (!items.length) return;

    const lancer = () => items.forEach((el) => el.classList.add('balaye'));

    if (!('IntersectionObserver' in window)) { lancer(); return; }

    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        lancer();
        obs.disconnect();
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });

    obs.observe(liste);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqSweep);
  } else {
    initFaqSweep();
  }
  document.addEventListener('astro:page-load', initFaqSweep);
</script>
