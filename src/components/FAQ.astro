---
import { Icon } from 'astro-icon/components';

const faqs = [
  {
    question: "Comment se déroule une mission type ?",
    answer: "Tout commence par un appel de 30 minutes gratuit où on identifie vos process les plus chronophages. Sous 48h, je vous envoie un plan d'action détaillé avec livrables, délais et budget fixe. Pas de surprise : vous validez chaque étape avant que je passe à la suivante.",
    open: true,
  },
  {
    question: "Combien ça coûte et quel retour sur investissement attendre ?",
    answer: "Un premier workflow d'automatisation démarre à partir de 1 500 €. La plupart de mes clients constatent un ROI dès le premier mois : quand vous économisez 15h par semaine de travail manuel, le budget est amorti en quelques semaines. Je vous fournis une estimation du ROI dès l'audit.",
    open: false,
  },
  {
    question: "Combien de temps faut-il pour voir des résultats ?",
    answer: "Un workflow simple est déployé en 3 à 5 jours. Un projet complet (audit + plusieurs automatisations + formation) prend 4 à 8 semaines. Dans tous les cas, les premiers gains de temps sont visibles dès la première semaine de déploiement.",
    open: false,
  },
  {
    question: "Et si mes outils changent ou si j'ai besoin d'évolutions ?",
    answer: "Les automatisations sont construites de façon modulaire : ajouter un outil ou modifier un flux ne nécessite pas de tout reconstruire. Je forme vos équipes à faire les ajustements courants, et je reste disponible pour les évolutions majeures.",
    open: false,
  },
];
---

<!-- FAQ -->
<section id="faq" class="section-light-alt py-[var(--spacing-section-sm)] px-[var(--spacing-section-x)]">
  <div class="max-w-[1200px] mx-auto">
    <!-- Header -->
    <div class="flex flex-col items-center gap-5 mb-12">
      <span
        class="inline-block rounded-full border px-4 py-1.5 font-[var(--font-mono)] text-[11px] font-medium tracking-[2px] uppercase"
        style="background: #F3F0FF; border-color: rgba(139,92,246,0.19); color: #777777;"
      >
        QUESTIONS FRÉQUENTES
      </span>
      <h2 class="font-[var(--font-display)] text-[length:var(--text-heading)] font-bold text-[#0A0A0A] text-center">
        Questions fréquentes
      </h2>
      <p class="font-[var(--font-body)] text-[15px] md:text-lg text-[#555555] leading-[1.6] text-center max-w-[600px]">
        Tout ce qu'il faut savoir avant de démarrer.
      </p>
    </div>

    <!-- Accordion -->
    <div class="max-w-[800px] mx-auto border-t" style="border-color: #E5E5E5;" id="faq-accordion">
      {faqs.map((faq, index) => (
        <div class="faq-item border-b" style="border-color: #E5E5E5;">
          <button
            type="button"
            class="faq-trigger w-full flex items-center justify-between py-5 md:py-6 text-left cursor-pointer min-h-[56px]"
            aria-expanded={faq.open ? "true" : "false"}
            aria-controls={`faq-answer-${index}`}
            data-faq-index={index}
          >
            <span class="font-[var(--font-display)] text-base md:text-lg font-semibold text-[#0A0A0A] pr-4">
              {faq.question}
            </span>
            <Icon
              name="lucide:plus"
              class:list={["faq-icon-plus w-5 h-5 text-[#8B5CF6] shrink-0 transition-opacity duration-200", faq.open ? "hidden" : ""]}
            />
            <Icon
              name="lucide:minus"
              class:list={["faq-icon-minus w-5 h-5 text-[#8B5CF6] shrink-0 transition-opacity duration-200", faq.open ? "" : "hidden"]}
            />
          </button>
          <div
            id={`faq-answer-${index}`}
            class:list={["faq-answer overflow-hidden transition-all duration-300 ease-in-out", faq.open ? "max-h-96 pb-6" : "max-h-0"]}
          >
            <p class="font-[var(--font-body)] text-[15px] text-[#555555] leading-[1.6]">
              {faq.answer}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const accordion = document.getElementById('faq-accordion');
    if (!accordion) return;

    accordion.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('.faq-trigger') as HTMLButtonElement | null;
      if (!trigger) return;

      const item = trigger.closest('.faq-item');
      if (!item) return;

      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const iconPlus = item.querySelector('.faq-icon-plus') as HTMLElement;
      const iconMinus = item.querySelector('.faq-icon-minus') as HTMLElement;

      if (isExpanded) {
        // Collapse
        trigger.setAttribute('aria-expanded', 'false');
        answer.classList.remove('max-h-96', 'pb-6');
        answer.classList.add('max-h-0');
        iconPlus.classList.remove('hidden');
        iconMinus.classList.add('hidden');
      } else {
        // Expand
        trigger.setAttribute('aria-expanded', 'true');
        answer.classList.remove('max-h-0');
        answer.classList.add('max-h-96', 'pb-6');
        iconPlus.classList.add('hidden');
        iconMinus.classList.remove('hidden');
      }
    });
  });
</script>
