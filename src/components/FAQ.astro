---
import SectionHeader from './SectionHeader.astro';
import { faqs } from '../data/faq';
---

<section
  id="faq"
  data-section
  data-fast-scroll="scroll_to_section_faq"
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="05"
      label="FAQ"
      title="Six questions. Six avis tranchés."
      titleMaxWidth="22ch"
    />

    <!-- Accordion — chaque item est une paper-island bordée qui revendique sa cellule -->
    <div class="reveal max-w-[820px] flex flex-col gap-3">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <span class="grid-corner tl" aria-hidden="true"></span>
          <span class="grid-corner tr" aria-hidden="true"></span>
          <span class="grid-corner bl" aria-hidden="true"></span>
          <span class="grid-corner br" aria-hidden="true"></span>

          <details class="faq-details group">
            <summary class="faq-summary">
              <span class="faq-num">Q0{i + 1}</span>
              <span class="faq-question">{faq.q}</span>
              <span class="faq-caret" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        </div>
      ))}

      <!-- 7e row : sortie de l'accordion, lien direct mailto -->
      <p class="mono-caption text-[var(--color-ink-low)] mt-5 pt-6 border-t border-[var(--color-divider)]">
        UNE QUESTION PAS LISTÉE ?
        <a
          href="mailto:bonjour@liliansevoumian.fr"
          class="text-[var(--color-violet-deep)] hover:text-[var(--color-ink)] transition-colors ml-1"
          data-fast-goal="contact_lead"
          data-fast-goal-type="email"
          data-fast-goal-source="faq"
        >
          BONJOUR@LILIANSEVOUMIAN.FR
        </a>
      </p>

      {/* Pont augmentes.fr — sortie pour l'intention « apprendre soi-même » /
          budget formation, distincte de la demande de mission. Lien secondaire. */}
      <p class="mono-caption text-[var(--color-ink-low)] mt-3">
        BUDGET SERRÉ OU ENVIE D'APPRENDRE VOUS-MÊME ?
        <a
          href="https://augmentes.fr"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-ember-deep)] hover:text-[var(--color-ink)] transition-colors ml-1"
          data-fast-goal="augmentes_click"
          data-fast-goal-source="faq"
        >
          MES FORMATIONS MAKE &amp; N8N <span aria-hidden="true">↗</span>
        </a>
      </p>
    </div>

  </div>
</section>
