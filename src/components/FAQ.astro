---
import SectionHeader from './SectionHeader.astro';
import { faqs } from '../data/faq';
---

<section
  id="faq"
  data-section  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="05"
      label="FAQ"
      title="Vos questions les plus fréquentes."
      titleMaxWidth="22ch"
    />

    <!-- Accordion — chaque item est une paper-island bordée qui revendique sa cellule -->
    <div class="reveal max-w-[820px] flex flex-col">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <details class="faq-details group">
            <summary class="faq-summary">
              <span class="faq-num">Q0{i + 1}</span>
              <span class="faq-question">{faq.q}</span>
              <span class="faq-caret" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        </div>
      ))}

      <!-- Sortie de l'accordion : lien direct mailto -->
      <p class="mono-caption text-[var(--color-ink-low)] mt-8">
        UNE QUESTION PAS LISTÉE ?
        <a
          href="mailto:bonjour@liliansevoumian.fr"
          class="text-[var(--color-violet-deep)] hover:text-[var(--color-ink)] transition-colors ml-1"
        >
          BONJOUR@LILIANSEVOUMIAN.FR
        </a>
      </p>
    </div>

  </div>
</section>
