                        </ul>
                      </div>
                    </div>

                    <div class="fenetre fenetre--outils" data-outils>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone">
                          <svg viewBox="0 0 16 16"><path d="M6.4 9.6l3.2-3.2M5 8L3.9 9.1a2.1 2.1 0 0 0 3 3L8 11M8 5l1.1-1.1a2.1 2.1 0 0 1 3 3L11 8" /></svg>
                        </span>
                        <span class="fenetre__nom">Outils connectés</span>
                      </div>
                      <div class="fenetre__corps">
                        <ul class="outils">
                          {outils.map((outil) => (
                            <li class="outil" data-outil={outil.id} data-trouve={outil.trouve}>
                              <svg viewBox="0 0 16 16"><path d={outil.trace} /></svg>
                              <span>{outil.nom}</span>
                              <span class="outil__etat" data-outil-etat>Connecté</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    <div class="fenetre fenetre--tableau" data-tableau>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone">
                          <svg viewBox="0 0 16 16"><path d="M3 3h2.6v8H3V3zM6.7 3h2.6v10H6.7V3zM10.4 3H13v6h-2.6V3z" /></svg>
                        </span>
                        <span class="fenetre__nom">Suivi des projets</span>
                        <span class="fenetre__info">Cette semaine</span>
                      </div>
                      <div class="fenetre__corps">
                        <div class="indicateurs">
                          <span class="indicateur">
                            <span class="indicateur__nom">En cours</span>
                            <b data-compte="cours" data-indicateur>{compte('cours')}</b>
                          </span>
                          <span class="indicateur">
                            <span class="indicateur__nom">Livrés<span class="mot-long"> cette semaine</span></span>
                            <b data-compte="livre" data-indicateur>{compte('livre')}</b>
                          </span>
                          <span class="indicateur indicateur--zero">
                            <span class="indicateur__nom">En retard</span>
                            <b>0</b>
                          </span>
                        </div>
                        <div class="piles">
                          {piles.map((pile) => (
                            <div class="pile">
                              <span class="pile__tete">{pile.nom}<b data-compte={pile.id}>{compte(pile.id)}</b></span>
                              <ul data-pile={pile.id}>
                                {projets.filter((projet) => projet.etat === pile.id).map((projet) => (
                                  <li class="carte" data-carte data-etat={projet.etat} style={`--p: ${projet.p}`}>
                                    <i class="carte__puce"></i>
                                    <span class="carte__nom">{projet.nom}</span>
                                    <i class="carte__trait"></i>
                                    <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                                    <u class="carte__avance"></u>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>

                    <div class="bandes">
                      {lignes.map(() => <span class="bande"></span>)}
                    </div>

                    <div class="curseur" data-curseur data-etat="cache">
                      <svg viewBox="0 0 24 24"><path d="M5 3l14 8.2-6.2 1.6L9.6 19 5 3z" /></svg>
                      <span class="curseur__valeur" data-porte></span>
                    </div>
                  </div>
                </div>
                </div>
                <i class="scene__sablier" data-sablier aria-hidden="true"></i>
                <button type="button" class="sm-pause scene__pause" aria-pressed="false" hidden data-pause>
                  <span class="sr-only">Mettre l’animation en pause</span>
                  <svg class="sm-pause__arret" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="4" y="3" width="3" height="10" rx="1" /><rect x="9" y="3" width="3" height="10" rx="1" /></svg>
                  <svg class="sm-pause__lecture" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M5.5 3.2v9.6l7.6-4.8z" /></svg>
                </button>
              </div>

              <div class="scene__mode" role="group" aria-label={vue.groupe} hidden data-mode-groupe>
                {vue.boutons.map((bouton) => (
                  <button type="button" data-mode-bouton={bouton.id} aria-pressed={bouton.id === vue.mode ? 'true' : 'false'}>{bouton.nom}</button>
                ))}
              </div>
            </div>
          </div>
        ))}
      </>
    ))}
  </div>
  <p class="sr-only" aria-live="polite" data-annonce></p>
</section>

<style>
  .story {
    --trait: color-mix(in srgb, var(--color-ink) 9%, transparent);
    /* Sur ordinateur, la troisième phrase reste en place pendant que ses trois
       réponses passent : `--recit-course` est ce qu'il faut défiler pour les
       voir toutes (le script la découpe en paliers), `--recit-sortie` ce qui
       reste entre la fin du texte et la fin du récit quand il se décolle. */
    --recit-course: 150svh;
    --recit-sortie: 8.75rem;
    border-bottom: 1px solid var(--trait);
    background: var(--color-night-deep);
  }

  /* Une phrase, un bloc. Le filet qui sépare deux phrases tient dans la
     colonne ; sur ordinateur il rejoint le filet vertical de la page et s'y
     marque d'une croix (voir plus bas). */
  .acte {
    position: relative;
  }

  .acte:not(:first-child)::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--trait);
  }

  .acte__corps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: var(--spacing-lie);
  }

  .acte__titre {
    max-width: 13ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-story);
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    /* Texte agrandi sur un écran étroit : un mot plus large que la colonne se
       coupe plutôt que de sortir. Sans effet à la taille normale. */
    overflow-wrap: anywhere;
  }

  /* Le fragment surligné est une pastille, comme la réponse du premier
     écran : la même bande pêche que partout ailleurs, sans son inclinaison et
     arrondie jusqu'au bout. */
  .acte__titre mark {
    --angle: 0deg;
    --radius-bande: 9999px;
    display: inline-block;
    /* Texte agrandi : la pastille passe sur deux lignes plutôt que de sortir
       de la colonne. Bloc en ligne, elle reste entière tant qu'elle tient sur
       une ligne : `normal` ne change rien à la taille habituelle. */
    max-width: 100%;
    white-space: normal;
    padding: 0.02em 0.36em 0.08em;
    margin: 0.14em 0 0;
  }

  .acte__titre mark::before {
    inset: 0;
  }

  .mot {
    display: inline-block;
  }

  .acte__suite {
    max-width: 40ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: var(--leading-body);
  }

  /* La troisième phrase nomme les trois réponses : celle que la scène montre
     passe en clair, les deux autres attendent. Sans script, aucune n'est
     désignée et la phrase se lit d'une seule teinte. */
  .proposition {
    transition: color 420ms var(--ease-out-quint);
  }

  .acte[data-reponse='auto'] .proposition[data-proposition='auto'],
  .acte[data-reponse='agent'] .proposition[data-proposition='agent'],
  .acte[data-reponse='tableau'] .proposition[data-proposition='tableau'] {
    color: var(--color-ink);
  }

  /* ── Les mots se posent ──
     Chaque phrase attend d'entrer à l'écran (le `.reveal` du site), puis ses
     mots arrivent un par un. Le fragment surligné vient en dernier. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-ready) .acte__corps.reveal .mot {
      transition:
        opacity 620ms var(--ease-out-expo),
        transform 760ms var(--ease-out-expo),
        filter 620ms var(--ease-out-expo);
      transition-delay: calc(var(--i) * 50ms + 80ms);
    }

    :global(.js-ready) .acte__corps.reveal:not(.is-visible) .mot {
      opacity: 0;
      transform: translateY(0.45em);
      filter: blur(8px);
      transition-delay: 0ms;
    }

    :global(.js-ready) .acte__corps.reveal.is-visible mark {
      transition-delay: calc(var(--mots) * 50ms - 60ms);
    }
  }

  /* ── La scène ──
     Sa largeur suit sa colonne, sans jamais faire dépasser le panneau de
     l'écran : `--scene-hors` est ce qu'il faut laisser autour de lui en
     hauteur, `--scene-max` et `--scene-plancher` bornent le résultat.
     `--plan-l` et `--plan-h` sont les cotes du plan dessiné.
     Les quatre tailles du texte sont posées ici, en unités de plan : à
     l'écran le grand plan est rendu entre 0,81 (fenêtre de 1200) et 0,9
     (1440), la note fait donc 9,3 à 10,3 px. */
  .scene {
    --plan-l: 680;
    --plan-h: 560;
    --scene-max: 100%;
    --scene-hors: 8rem;
    --scene-plancher: 0px;
    --sm-note: 11.5px;
    --sm-texte: 12.5px;
    --sm-fort: 14px;
    --sm-titre: 16px;
    --sm-chiffre: 30px;
    /* Le recul d'une fenêtre qui sort (voir `--sortie`). Il vaut 1 là où le
       texte n'a pas de marge au-dessus de 9 px : réduit de 6 %, il passerait
       dessous le temps de la transition. */
    --retrait: 0.94;
    display: grid;
    /* Une colonne à la largeur de la scène : sans cela elle prendrait celle
       de la ligne de boutons quand elle est la plus large, et le panneau
       grandirait avec elle. */
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 1.25rem;
    width: min(
      100%,
      var(--scene-max),
      max(var(--scene-plancher), calc((100svh - var(--spacing-barre) - var(--scene-hors)) * var(--plan-l) / var(--plan-h)))
    );
  }

  /* La boîte porte les repères d'angle, hors du panneau : quatre petites
     équerres, comme les traits de coupe d'un plan. */
  .scene__boite {
    position: relative;
    width: 100%;
  }

  .repere {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--color-ink-low);
    pointer-events: none;
  }

  /* L'élément sans rendu qui porte les attentes du moteur (voir le script). */
  .scene__sablier {
    position: absolute;
    width: 0;
    height: 0;
    visibility: hidden;
  }

  /* La commande d'arrêt : le dessin du socle des métiers (`.sm-pause`, une
     pastille de 28 px et sa cible de 44), posé dans le coin du panneau. Elle
     sort masquée du HTML : le script la montre, sauf en mouvement réduit. */
  .scene__pause[hidden] {
    display: none;
  }

  /* Le temps d'un changement de mode à l'arrêt : la nouvelle image se pose
     d'un coup, sans transition. Le script pose cette classe, puis la retire. */
  .scene.sans-transition *,
  .scene.sans-transition *::before,
  .scene.sans-transition *::after {
    transition: none !important;
  }

  .repere--hg { top: -7px; left: -7px; border-top-width: 1px; border-left-width: 1px; }
  .repere--hd { top: -7px; right: -7px; border-top-width: 1px; border-right-width: 1px; }
  .repere--bg { bottom: -7px; left: -7px; border-bottom-width: 1px; border-left-width: 1px; }
  .repere--bd { right: -7px; bottom: -7px; border-right-width: 1px; border-bottom-width: 1px; }

  /* Le panneau. Une grille fine en fond, une lueur pêche en bas à gauche et
     une lueur froide en haut à droite, juste assez pour donner de la
     profondeur. Dès que la machine travaille, une lumière chaude se lève : le
     panneau s'éclaire. Elle suit ensuite ce qu'on regarde : la facture pour
     l'automatisation, la conversation pour l'agent, tout le plan pour le
     tableau de bord. */
  .scene__cadre {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--plan-l) / var(--plan-h);
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-md);
    background:
      linear-gradient(color-mix(in srgb, var(--color-ink) 5%, transparent) 1px, transparent 1px) 0 0 / 34px 34px,
      linear-gradient(90deg, color-mix(in srgb, var(--color-ink) 5%, transparent) 1px, transparent 1px) 0 0 / 34px 34px,
      radial-gradient(85% 75% at 0% 100%, color-mix(in srgb, var(--color-braise) 24%, transparent), transparent 62%),
      radial-gradient(75% 65% at 100% 0%, color-mix(in srgb, var(--color-lueur-froide) 20%, transparent), transparent 64%),
      var(--color-night-deep);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 9%, transparent);
    isolation: isolate;
    /* Le plan se met à l'échelle de ce panneau : `cqw` en est la largeur. */
    container-type: inline-size;
  }

  /* La lumière déborde du panneau de près d'un tiers de chaque côté, pour
     pouvoir se déplacer sans montrer son bord. Les cotes du dégradé sont
     celles d'avant, rapportées à cette boîte plus grande. */
  .scene__cadre::before {
    content: '';
    position: absolute;
    inset: -30%;
    z-index: -1;
    background: radial-gradient(43.75% 37.5% at 52.5% 58.75%, color-mix(in srgb, var(--color-peche) 30%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 900ms var(--ease-out-quint), transform 1100ms var(--ease-out-quint);
  }

  .scene:not([data-mode='main']) .scene__cadre::before {
    opacity: 1;
  }

  .scene[data-mode='agent'] .scene__cadre::before {
    transform: translate(-14%, -6%);
  }

  .scene[data-mode='tableau'] .scene__cadre::before {
    transform: translate(-3%, -5%) scale(1.3);
  }

  .scene__cadre::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 6;
    background-image: var(--grain);
    opacity: 0.1;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* Le plan est dessiné à taille fixe, 680 × 560, puis mis à l'échelle de sa
     colonne par une seule variable. Toutes les positions de la scène et tous
     les trajets du curseur se calculent dans ce repère. Le script pose `--k` ;
     sans lui, l'échelle se déduit du panneau (`tan(atan2())` rend le rapport
     de deux longueurs), et la scène reste une image juste à toute largeur. */
  .scene__plan {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--plan-l) * 1px);
    height: calc(var(--plan-h) * 1px);
    transform: scale(var(--k, tan(atan2(100cqw, calc(var(--plan-l) * 1px)))));
    transform-origin: 0 0;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .scene__plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scene__plan li {
    max-width: none;
  }

  /* Les pastilles d'état, à plat au-dessus de la scène : l'heure qui file, ce
     qui attend, les gestes déjà refaits. Les deux compteurs ne comptent que
     des commandes : ils sortent quand la scène montre l'agent de support ou
     le suivi de projets, où ils n'auraient rien à dire. */
  .puces {
    position: absolute;
    top: 20px;
    left: 22px;
    z-index: 4;
    display: flex;
    gap: 8px;
  }

  .puce {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 12px 0 9px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-night-deep) 70%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
    color: var(--color-ink-mid);
    font-size: var(--sm-texte);
    font-weight: 500;
    white-space: nowrap;
    transition:
      border-color 400ms,
      color 400ms,
      opacity 420ms var(--ease-out-quint) 260ms,
      translate 520ms var(--ease-out-quint) 260ms,
      visibility 0s;
  }

  .puce b {
    display: inline-block;
    color: var(--color-ink);
    font-size: var(--sm-fort);
    font-weight: 600;
  }

  .scene[data-mode='agent'] .puce--compteur,
  .scene[data-mode='tableau'] .puce--compteur {
    visibility: hidden;
    opacity: 0;
    translate: -8px 0;
    transition:
      opacity 300ms cubic-bezier(0.4, 0, 0.2, 1),
      translate 300ms cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s 300ms;
  }

  .puce svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-ink-low);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .puce__horloge line {
    stroke: var(--color-ink);
    stroke-width: 1.5;
  }

  .puce__horloge .puce__minutes {
    stroke: var(--color-peche);
  }

  /* La nuit de l'agent de support : la pastille de l'heure prend la lueur
     froide et porte une lune. */
  .puce__lune {
    display: none;
  }

  .puce.est-nuit {
    border-color: color-mix(in srgb, var(--color-lueur-froide) 75%, transparent);
  }

  .puce.est-nuit .puce__lune {
    display: block;
    fill: color-mix(in srgb, var(--color-lueur-froide) 40%, transparent);
    stroke: color-mix(in srgb, var(--color-lueur-froide) 45%, var(--color-ink));
  }

  .puce.est-vide {
    border-color: color-mix(in srgb, var(--color-peche) 70%, transparent);
  }

  .puce.est-vide b {
    color: var(--color-peche);
  }

  /* Le monde : les fenêtres, le curseur et ses traces, sur un même plan
     incliné. Tout y est dans le même repère, la perspective vient après.
     L'inclinaison est le point de vue : elle change avec la réponse montrée,
     de trois quarts pour la copie et l'automatisation, presque de face pour
     la conversation de l'agent, de l'autre côté pour le tableau de bord. */
  .monde {
    --recul: 1600px;
    --rx: 8deg;
    --ry: -10deg;
    --rz: 1.5deg;
    --tx: 6px;
    --ty: 12px;
    --zoom: 1;
    position: absolute;
    inset: 0;
    transform: perspective(var(--recul)) rotateX(calc(var(--rx) + var(--iy, 0deg))) rotateY(calc(var(--ry) + var(--ix, 0deg))) rotateZ(var(--rz)) translate(var(--tx), var(--ty)) scale(var(--zoom));
    transform-origin: 50% 46%;
    transition: transform 500ms var(--ease-out-quint);
  }

  .scene[data-mode='agent'] .monde {
    --rx: 5deg;
    --ry: -4deg;
    --rz: 0.4deg;
    --tx: 0px;
    --ty: 22px;
  }

  .scene[data-mode='tableau'] .monde {
    --rx: 9deg;
    --ry: 6deg;
    --rz: -1deg;
    --tx: -4px;
    --ty: 32px;
  }

  /* Le temps d'un changement de réponse, le plan tourne plus lentement que
     lorsqu'il suit le pointeur : c'est un mouvement de caméra. Le script pose
     cette classe, puis la retire. */
  .scene.bascule .monde {
    transition-duration: 1100ms;
    transition-timing-function: cubic-bezier(0.6, 0, 0.2, 1);
  }

  /* Une fenêtre qui n'a pas sa place dans la réponse montrée n'est pas
     coupée : elle recule, se floute et s'efface (`--sortie` dit vers où),
     puis disparaît du rendu. Celle qui arrive attend un instant que l'autre
     ait commencé à partir. */
  .fenetre {
    position: absolute;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 12px;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-ink) 12%, transparent),
      0 30px 60px -28px var(--color-night-deep),
      0 12px 24px -16px var(--color-night-deep);
    transition:
      opacity 520ms var(--ease-out-quint) 200ms,
      filter 520ms var(--ease-out-quint) 200ms,
      transform 940ms cubic-bezier(0.25, 0.8, 0.25, 1) 200ms,
      visibility 0s;
  }

  .scene:not([data-mode='main']):not([data-mode='auto']) .fenetre--pdf,
  .scene:not([data-mode='main']):not([data-mode='auto']) .fenetre--app,
  .scene:not([data-mode='agent']) .fenetre--chat,
  .scene:not([data-mode='agent']) .fenetre--base,
  .scene:not([data-mode='agent']) .fenetre--outils,
  .scene:not([data-mode='tableau']) .fenetre--tableau {
    visibility: hidden;
    opacity: 0;
    filter: blur(10px);
    transform: var(--sortie);
    transition:
      opacity 440ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 440ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 620ms cubic-bezier(0.5, 0, 0.75, 0),
      visibility 0s 620ms;
  }

  /* Les fenêtres d'une réponse n'arrivent pas d'un bloc : la principale
     d'abord, ses voisines ensuite. */
  .fenetre--base {
    transition-delay: 320ms, 320ms, 320ms, 0s;
  }

  .fenetre--outils {
    transition-delay: 440ms, 440ms, 440ms, 0s;
  }

  .fenetre__barre {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding-inline: 11px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    font-size: var(--sm-texte);
    font-weight: 500;
  }

  /* L'icône d'une fenêtre : un pictogramme nuit sur un carré pêche. Celle du
     lecteur de PDF est en braise ; c'est le nom du fichier qui dit « PDF »,
     trois lettres dans un carré de 18 px ne se lisaient pas. */
  .fenetre__icone {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--color-peche);
  }

  .fenetre__icone--pdf {
    background: var(--color-braise);
  }

  .fenetre__icone svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--color-night);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .fenetre__nom {
    min-width: 0;
    overflow: hidden;
    color: var(--color-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fenetre__info {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--color-ink-low);
    font-size: var(--sm-note);
    white-space: nowrap;
  }

  /* Un libellé a parfois deux longueurs : la courte ne sort que sur le plan
     étroit, là où la longue ne tient plus. */
  .mot-court {
    display: none;
  }

  /* ── Le bon de commande : un lecteur de PDF et sa page de papier ──
     Sur la page, seuls le titre et les lignes sont écrits. L'adresse et les
     en-têtes de colonnes sont des traits : à l'échelle du plan ils ne se
     liraient pas, et ils ne racontent rien. */
  .fenetre--pdf {
    --sortie: translate(-44px, -22px) scale(var(--retrait));
    top: 78px;
    left: 26px;
    width: 318px;
    background: color-mix(in srgb, var(--color-surface-high) 82%, transparent);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .fenetre--pdf .fenetre__corps {
    padding: 12px 12px 14px;
  }

  .page {
    padding: 14px 14px 8px;
    border-radius: 6px;
    background: var(--color-feuille);
    box-shadow: 0 8px 18px -10px var(--color-night-deep);
    color: var(--color-night);
  }

  .page__tete {
    font-size: var(--sm-fort);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .page__bloc {
    display: grid;
    gap: 4px;
    margin-top: 9px;
  }

  .page__bloc i {
    width: 44%;
    height: 4px;
    border-radius: 2px;
    background: var(--color-feuille-trait);
  }

  .page__bloc i:nth-child(2) { width: 58%; }
  .page__bloc i:nth-child(3) { width: 31%; }

  .colonnes {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 28px 54px;
    gap: 8px;
    margin-top: 13px;
    padding: 0 6px 6px;
    border-bottom: 1px solid var(--color-feuille-trait);
  }

  .colonnes i {
    width: 62%;
    height: 4px;
    border-radius: 2px;
    background: var(--color-feuille-barre);
  }

  .colonnes i:nth-child(2) { width: 46%; }

  .colonnes i:nth-child(n + 3) {
    justify-self: end;
    width: 72%;
  }

  .doc__ligne {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 28px 54px;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding-inline: 6px;
    border-bottom: 1px solid var(--color-feuille-trait);
    border-radius: 4px;
    font-size: var(--sm-texte);
    font-weight: 500;
    transition: color 260ms var(--ease-out-quint), background-color 160ms;
  }

  .doc__ligne:last-child {
    border-bottom: 0;
  }

  .doc__ligne .ref {
    font-weight: 600;
  }

  /* Une référence ou un montant ne passe jamais à la ligne. « A-2041 » tenait
     dans sa case au pixel près : sur iPhone, où le texte est rendu un cheveu
     plus large, elle se coupait au trait d'union et les rangées se
     chevauchaient (vu par Lilian le 3 octobre 2026). */
  .doc__ligne span,
  .facture__ligne span {
    white-space: nowrap;
  }

  .doc__ligne i {
    height: 5px;
    border-radius: 3px;
    background: var(--color-feuille-barre);
    transition: opacity 260ms var(--ease-out-quint);
  }

  .doc__ligne span:nth-of-type(n + 2) {
    text-align: right;
  }

  /* Lue par la machine : la bande pêche passe sur la ligne. */
  .doc__ligne::before {
    content: '';
    position: absolute;
    inset: 3px 0;
    z-index: -1;
    border-radius: 4px;
    background: var(--color-peche);
    clip-path: inset(0 100% 0 0 round 4px);
    transition: clip-path 340ms var(--ease-out-expo);
  }

  .doc__ligne.est-lu::before {
    clip-path: inset(0 0 0 0 round 4px);
  }

  /* Copiée à la main : la sélection que tout le monde connaît. */
  .doc__ligne.est-copie {
    background: color-mix(in srgb, var(--color-lueur-froide) 18%, var(--color-feuille));
    outline: 1px solid color-mix(in srgb, var(--color-lueur-froide) 70%, transparent);
    outline-offset: -1px;
  }

  /* Déjà recopiée : la ligne passe au gris du papier, qui se lit encore
     (7,1:1 sur la feuille). L'ancienne opacité à 36 % tombait à 2,3:1. */
  .doc__ligne.est-fait {
    color: var(--color-feuille-note);
  }

  .doc__ligne.est-fait i {
    opacity: 0.55;
  }

  /* ── La facture : l'outil dans lequel on recopie, en verre sombre ──
     Elle s'arrête avant le coin bas droit du panneau, où se pose la commande
     d'arrêt : son bouton « Émettre » ne passe pas dessous. */
  .fenetre--app {
    --sortie: translate(46px, 30px) scale(var(--retrait));
    top: 190px;
    left: 346px;
    width: 290px;
    background: color-mix(in srgb, var(--color-night-deep) 74%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--app .fenetre__corps {
    padding: 12px;
  }

  /* « Brouillon », puis « Émise » : c'est le mot que l'automatisation fait
     changer. */
  .facture__etat {
    flex-shrink: 0;
    /* « Brouillon » et « Émise » dans la même largeur : la pastille ne bouge
       pas quand le mot change. */
    min-width: 5.9em;
    margin-left: auto;
    padding: 2px 9px 3px;
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-mid);
    font-size: var(--sm-fort);
    font-weight: 600;
    line-height: 1.2;
    transition: background-color 220ms, color 220ms, border-color 220ms;
  }

  .facture__etat[data-etat='emise'] {
    border-color: var(--color-peche);
    background: var(--color-peche);
    color: var(--color-night);
  }

  .champ {
    display: grid;
    gap: 5px;
  }

  .champ__nom {
    color: var(--color-ink-low);
    font-size: var(--sm-note);
    font-weight: 500;
    line-height: 1.2;
  }

  .champ__valeur {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding-inline: 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  .champ__valeur em {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-peche), var(--color-lueur-froide));
  }

  .champ__valeur i {
    width: 46%;
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 26%, transparent);
  }

  .colonnes--app {
    grid-template-columns: 56px minmax(0, 1fr) 28px 54px 12px;
    margin-top: 12px;
    padding: 0 8px 6px;
    border-bottom: 0;
  }

  .colonnes--app i {
    background: color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  .fenetre--app ul {
    display: grid;
    gap: 5px;
  }

  .facture__ligne {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 28px 54px 12px;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding-inline: 8px;
    border: 1px dashed color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 7px;
    font-size: var(--sm-texte);
    font-weight: 500;
    transition: border-color 220ms, background-color 220ms;
  }

  .facture__ligne .ref {
    font-weight: 600;
  }

  .facture__ligne i {
    width: var(--l);
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 24%, transparent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 360ms var(--ease-out-expo);
  }

  .facture__ligne span {
    opacity: 0;
    transition: opacity 200ms;
  }

  .facture__ligne span:nth-of-type(n + 2) {
    text-align: right;
  }

  .facture__ligne svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--color-peche);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    scale: 0.4;
    transition: opacity 200ms, scale 320ms var(--ease-out-expo);
  }

  .facture__ligne.est-rempli {
    border-style: solid;
    border-color: color-mix(in srgb, var(--color-ink) 12%, transparent);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }

  .facture__ligne.est-rempli i { transform: scaleX(1); }
  .facture__ligne.est-rempli span { opacity: 1; }
  .facture__ligne.est-valide svg { opacity: 1; scale: 1; }

  .pied {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 11px;
    padding-top: 10px;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    color: var(--color-ink-low);
    font-size: var(--sm-note);
  }

  .pied b {
    color: var(--color-ink);
    font-size: var(--sm-titre);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .pied__bouton {
    margin-left: auto;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: var(--color-ink-low);
    font-size: var(--sm-texte);
    font-weight: 600;
    transition: background-color 260ms, color 260ms;
  }

  .fenetre--app:has(.facture__etat[data-etat='emise']) .pied__bouton {
    background: var(--color-peche);
    color: var(--color-night);
  }

  /* ── L'agent de support : une conversation et ses deux sources ──
     Plus de bon de commande ici. À gauche la conversation, à droite ce que
     l'agent consulte pour répondre : une base de connaissances et des outils
     connectés. La source consultée s'allume, et sa réponse rejoint la bulle. */
  .fenetre--chat {
    --sortie: translate(-46px, 22px) scale(var(--retrait));
    top: 66px;
    left: 22px;
    width: 356px;
    background: color-mix(in srgb, var(--color-night-deep) 74%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--chat .fenetre__corps {
    padding: 12px;
  }

  /* « En ligne · 24 h/24 » : c'est ce que cette réponse doit faire lire. */
  .chat__etat {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 7px;
    margin-left: auto;
    padding: 2px 10px 3px 9px;
    border: 1px solid color-mix(in srgb, var(--color-peche) 60%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink);
    font-size: var(--sm-texte);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  .chat__etat i {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-peche) 24%, transparent);
  }

  /* La conversation a une hauteur fixe, comme une vraie fenêtre de
     discussion : la fenêtre ne grandit pas à chaque message. Elle est cotée
     pour deux échanges dont les bulles tiennent sur deux lignes. */
  .conversation {
    display: flex;
    flex-direction: column;
    gap: 13px;
    height: 316px;
  }

  .echange {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .echange__quand {
    align-self: center;
    color: var(--color-ink-low);
    font-size: var(--sm-note);
    font-weight: 500;
    line-height: 1.2;
    opacity: 0;
    transition: opacity 260ms;
  }

  .bulle {
    max-width: 90%;
    padding: 7px 11px 8px;
    border: 1px solid transparent;
    border-radius: 13px;
    font-size: var(--sm-texte);
    font-weight: 500;
    line-height: 1.35;
    opacity: 0;
    translate: 0 8px;
    scale: 0.96;
    transition:
      opacity 240ms,
      translate 420ms var(--ease-out-expo),
      scale 420ms var(--ease-out-expo),
      background-color 260ms,
      border-color 260ms,
      color 260ms;
  }

  .bulle--client {
    border-bottom-left-radius: 4px;
    background: color-mix(in srgb, var(--color-ink) 11%, transparent);
    color: var(--color-ink);
    transform-origin: 0 100%;
  }

  /* La bulle de l'agent a deux temps : en pointillé pêche pendant qu'il
     cherche, pleine quand il répond. */
  .bulle--agent {
    align-self: flex-end;
    border-color: color-mix(in srgb, var(--color-peche) 55%, transparent);
    border-bottom-right-radius: 4px;
    background: color-mix(in srgb, var(--color-peche) 10%, transparent);
    color: var(--color-ink-mid);
    transform-origin: 100% 100%;
  }

  .bulle__cherche {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .bulle__texte {
    display: none;
  }

  .points {
    display: inline-flex;
    gap: 3px;
  }

  .points i {
    width: 4px;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
  }

  .echange.est-cherche .points i {
    animation: recit-point 900ms ease-in-out infinite;
  }

  .echange.est-cherche .points i:nth-child(2) { animation-delay: 150ms; }
  .echange.est-cherche .points i:nth-child(3) { animation-delay: 300ms; }

  @keyframes recit-point {
    0%, 60%, 100% { opacity: 0.35; translate: 0 0; }
    30% { opacity: 1; translate: 0 -2px; }
  }

  .source {
    align-self: flex-end;
    padding: 2px 9px 3px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-low);
    font-size: var(--sm-note);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    /* Elle glisse en place, sans changer d'échelle : réduite, la note
       passerait sous 9 px le temps de la transition. */
    translate: 8px 0;
    transition: opacity 220ms, translate 360ms var(--ease-out-expo);
  }

  .source b {
    color: var(--color-peche);
    font-weight: 600;
  }

  .echange.est-pose .echange__quand {
    opacity: 1;
  }

  .echange.est-pose .bulle--client,
  .echange.est-cherche .bulle--agent {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }

  .echange.est-repondu .bulle--agent {
    border-color: var(--color-peche);
    background: var(--color-peche);
    color: var(--color-night);
  }

  .echange.est-repondu .bulle__cherche { display: none; }
  .echange.est-repondu .bulle__texte { display: inline; }

  .echange.est-source .source {
    opacity: 1;
    translate: 0 0;
  }

  /* Les deux sources. Elles reprennent le dessin des lignes de la facture :
     discrètes au repos, pleines et pêche quand l'agent y a trouvé. */
  .fenetre--base,
  .fenetre--outils {
    background: color-mix(in srgb, var(--color-night-deep) 74%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--base {
    --sortie: translate(48px, -20px) scale(var(--retrait));
    top: 84px;
    left: 390px;
    width: 268px;
  }

  .fenetre--outils {
    --sortie: translate(48px, 26px) scale(var(--retrait));
    top: 304px;
    left: 390px;
    width: 268px;
  }

  .fenetre--base .fenetre__corps,
  .fenetre--outils .fenetre__corps {
    padding: 10px;
  }

  .fenetre--base.est-consulte,
  .fenetre--outils.est-consulte {
    border-color: color-mix(in srgb, var(--color-peche) 60%, transparent);
  }

  .recherche {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 27px;
    margin-bottom: 8px;
    padding-inline: 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    color: var(--color-ink);
    font-size: var(--sm-texte);
    font-weight: 500;
    white-space: nowrap;
  }

  .recherche span:empty::before {
    content: 'Rechercher';
    color: var(--color-ink-low);
  }

  .recherche svg,
  .article svg,
  .outil svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-ink-low);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .articles,
  .outils {
    display: grid;
    gap: 5px;
  }

  .article,
  .outil {
    display: grid;
    grid-template-columns: 13px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding-inline: 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    border-radius: 7px;
    color: var(--color-ink-mid);
    font-size: var(--sm-texte);
    font-weight: 500;
    white-space: nowrap;
    transition: border-color 220ms, background-color 220ms, color 220ms;
  }

  .article .coche {
    width: 12px;
    height: 12px;
    stroke: var(--color-peche);
    stroke-width: 2;
    opacity: 0;
    scale: 0.4;
    transition: opacity 200ms, scale 320ms var(--ease-out-expo);
  }

  .outil__etat {
    color: var(--color-ink-low);
    font-size: var(--sm-note);
    transition: color 220ms;
  }

  /* Parcouru : l'agent passe sur l'article sans s'y arrêter. */
  .article.est-parcouru {
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: var(--color-ink);
  }

  .article.est-trouve,
  .outil.est-interroge {
    border-color: var(--color-peche);
    background: color-mix(in srgb, var(--color-peche) 16%, transparent);
    color: var(--color-ink);
  }

  .article.est-trouve svg,
  .outil.est-interroge svg {
    stroke: var(--color-peche);
  }

  .article.est-trouve .coche {
    opacity: 1;
    scale: 1;
  }

  .outil.est-interroge .outil__etat {
    color: var(--color-peche);
  }

  /* ── Le tableau de bord : le suivi des projets d'une équipe ──
     Une interface métier autant qu'un tableau de bord : trois indicateurs,
     puis trois colonnes où chaque projet est une carte. Ni lignes de facture
     ni montants : rien ici ne rappelle la réponse Automatisation. */
  .fenetre--tableau {
    --sortie: translate(0, 64px) scale(var(--retrait));
    top: 80px;
    left: 26px;
    width: 634px;
    background: color-mix(in srgb, var(--color-night-deep) 86%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--tableau .fenetre__corps {
    display: grid;
    gap: 12px;
    padding: 14px;
  }

  .indicateurs,
  .piles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .indicateur {
    display: grid;
    justify-items: start;
    gap: 5px;
    padding: 9px 12px 11px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  .indicateur__nom {
    color: var(--color-ink-low);
    font-size: var(--sm-texte);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .indicateur b {
    color: var(--color-ink);
    font-size: var(--sm-chiffre);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* « En retard 0 » : le zéro qu'on vient chercher, en pêche. */
  .indicateur--zero {
    border-color: color-mix(in srgb, var(--color-peche) 60%, transparent);
  }

  .indicateur--zero b {
    color: var(--color-peche);
  }

  .pile {
    display: grid;
    align-content: start;
    gap: 7px;
    padding: 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-ink) 3%, transparent);
  }

  .pile__tete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-inline: 2px;
    color: var(--color-ink);
    font-size: var(--sm-fort);
    font-weight: 600;
    line-height: 1.2;
  }

  .pile__tete b {
    color: var(--color-ink-low);
    font-size: var(--sm-texte);
    font-weight: 500;
  }

  /* Cinq cartes de haut : la place qu'il faut à la colonne la plus pleine,
     pour que la fenêtre ne bouge pas quand une carte change de colonne. */
  .pile ul {
    display: grid;
    align-content: start;
    gap: 5px;
    height: calc(5 * 30px + 4 * 5px);
  }

  /* Une carte, un projet. En pointillé tant qu'il attend ; son filet pêche
     dit où il en est ; livré, il reçoit sa coche. */
  .carte {
    position: relative;
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr) 12px;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding-inline: 7px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: 7px;
    background: var(--color-surface-high);
    color: var(--color-ink);
    font-size: var(--sm-note);
    font-weight: 500;
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 280ms,
      translate 520ms var(--ease-out-expo),
      border-color 260ms,
      color 260ms,
      box-shadow 260ms;
  }

  .carte.est-la {
    opacity: 1;
    translate: 0 0;
  }

  .carte__nom {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Le trait qui remplace le nom du projet sur le plan étroit. */
  .carte__trait {
    display: none;
    width: 78%;
    height: 4px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-ink) 24%, transparent);
  }

  .carte__puce {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--color-peche);
    border-radius: var(--radius-full);
    background: var(--color-peche);
    transition: background-color 260ms, border-color 260ms;
  }

  .carte svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--color-peche);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    scale: 0.4;
    transition: opacity 200ms, scale 320ms var(--ease-out-expo);
  }

  /* L'avancement s'allonge par une mise à l'échelle, pas par sa largeur :
     aucune mise en page n'est refaite pendant l'animation. */
  .carte__avance {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-peche);
    text-decoration: none;
    transform: scaleX(calc(var(--p) / 100));
    transform-origin: left;
    transition: transform 640ms var(--ease-out-quint);
  }

  .carte[data-etat='afaire'] {
    border-style: dashed;
    color: var(--color-ink-mid);
  }

  .carte[data-etat='afaire'] .carte__puce {
    border-color: var(--color-ink-low);
    background: transparent;
  }

  .carte[data-etat='livre'] {
    color: var(--color-ink-mid);
  }

  .carte[data-etat='livre'] svg {
    opacity: 1;
    scale: 1;
  }

  /* La carte qui change de colonne passe au-dessus des autres. */
  .carte.en-vol {
    z-index: 2;
    border-color: var(--color-peche);
    box-shadow: 0 14px 24px -12px var(--color-night-deep);
  }

  /* Les trajets du curseur laissent une trace : à force, on voit le geste se
     répéter. */
  .traces {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .traces :global(path) {
    fill: none;
    stroke: color-mix(in srgb, var(--color-ink) 62%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }

  /* Le fil qui relie la source consultée à la conversation. */
  .traces :global(path.fil-source) {
    stroke: var(--color-peche);
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
  }

  /* En automatique, c'est la ligne elle-même qui part : sa bande pêche quitte la
     page et vient se poser dans la facture. Pour l'agent de support, la même
     bande part de la source consultée et vient se poser dans sa bulle. */
  .bande {
    position: absolute;
    z-index: 4;
    border-radius: 5px;
    background: var(--color-peche);
    opacity: 0;
    transform-origin: 0 0;
    pointer-events: none;
  }

  .curseur {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: 0;
    height: 0;
    transition: opacity 260ms;
  }

  .curseur[data-etat='cache'] {
    opacity: 0;
  }

  .curseur svg {
    position: absolute;
    top: -3px;
    left: -5px;
    width: 22px;
    height: 22px;
    filter: drop-shadow(0 3px 4px var(--color-night-deep));
    transition: scale 110ms;
  }

  .curseur path {
    fill: var(--color-ink);
    stroke: var(--color-night);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .curseur.clique svg {
    scale: 0.8;
  }

  /* Ce que le curseur transporte : la ligne copiée, celle qu'on recopie. */
  .curseur__valeur {
    position: absolute;
    top: 19px;
    left: 13px;
    padding: 3px 9px 4px;
    border: 1px solid color-mix(in srgb, var(--color-lueur-froide) 80%, transparent);
    border-radius: 7px;
    background: color-mix(in srgb, var(--color-lueur-froide) 26%, var(--color-night-deep));
    box-shadow: 0 8px 18px -8px var(--color-night-deep);
    color: var(--color-ink);
    font-size: var(--sm-texte);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    /* Elle se pose sous le curseur sans changer d'échelle, pour la même
       raison que la source d'une réponse. */
    translate: 0 -4px;
    transition: opacity 140ms, translate 160ms var(--ease-out-quint);
  }

  .curseur.porte .curseur__valeur {
    opacity: 1;
    translate: 0 0;
  }

  /* La commande de la scène : le travail à la main, puis les trois réponses
     (la vue des réponses n'a que ces trois-là). Le récit la règle tout seul,
     et elle dit toujours où en est la scène ; on peut aussi la pousser à la
     main. Le travail à la main s'allume en blanc, les trois réponses en
     pêche. `--bouton-marge` est la marge de chaque bouton : elle se serre là
     où la ligne manque de place. */
  .scene__mode {
    --bouton-marge: 1.1rem;
    display: inline-flex;
    gap: 2px;
    max-width: 100%;
    padding: 4px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }

  /* Les boutons sortent masqués du HTML et c'est le script qui les montre.
     Avec script, leur place est gardée dès le premier rendu, pour que rien ne
     saute quand ils arrivent ; sans script, ils ne prennent pas de place. */
  .scene__mode[hidden] {
    display: none;
  }

  :global(.js-ready) .scene__mode[hidden] {
    display: inline-flex;
    visibility: hidden;
  }

  .scene__mode button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--bouton-marge);
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-ink-mid);
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--duration-default) var(--ease-out-quint), color var(--duration-default);
  }

  .scene__mode button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-night);
  }

  .scene__mode button:not([data-mode-bouton='main'])[aria-pressed='true'] {
    background: var(--color-peche);
  }

  @media (hover: hover) and (pointer: fine) {
    .scene__mode button[aria-pressed='false']:hover {
      color: var(--color-ink);
    }
  }

  /* ── Ordinateur : la scène collante, pilotée par le défilement ──
     Le texte défile à gauche, un écran par phrase ; la scène reste en place à
     droite sur toute la hauteur du récit. Les deux filets verticaux de la
     page longent la colonne : le filet qui sépare deux phrases va jusqu'à
     eux, et s'y marque d'une croix. */
  @media (min-width: 1024px) and (min-height: 561px) {
    .story__grille {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      column-gap: var(--spacing-gouttiere);
    }

    /* Le titre a la largeur qu'il faut à sa plus longue ligne (« sensation
       de perdre ») : un demi-caractère de moins et la première phrase passe
       de quatre lignes à cinq. */
    .acte__titre {
      max-width: 13.5ch;
    }

    .acte {
      grid-column: 1;
      display: grid;
      align-content: center;
      min-height: 100svh;
      padding-block: var(--spacing-bloc);
    }

    .acte:not(:first-child)::before {
      left: calc(-1 * var(--spacing-cadre));
    }

    .acte:not(:first-child)::after {
      content: '';
      position: absolute;
      top: -5px;
      left: calc(-1 * var(--spacing-cadre) - 5px);
      width: 11px;
      height: 11px;
      background:
        linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 100% 1px no-repeat,
        linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 1px 100% no-repeat;
    }

    /* La troisième phrase est plus haute que les deux autres : son texte se
       fixe au milieu de l'écran, en face de la scène, et la course qui le
       suit laisse passer les trois réponses. `--corps-h` est la hauteur du
       texte, mesurée par le script pour le centrer ; sans elle il se pose à
       peu près au même endroit. Quand la course est finie, le texte se
       décolle avec `--recit-sortie` sous lui : le récit se termine sans
       grand vide à gauche. */
    .acte--long {
      display: block;
      min-height: 0;
      padding-bottom: var(--recit-sortie);
    }

    .acte--long .acte__corps {
      position: sticky;
      top: calc(var(--spacing-barre) + max(1rem, (100svh - var(--spacing-barre) - var(--corps-h, 30rem)) / 2));
    }

    .acte__course {
      height: var(--recit-course);
    }

    .story__scene {
      grid-column: 2;
      grid-row: 1 / span 3;
      position: sticky;
      top: var(--spacing-barre);
      align-self: start;
      display: grid;
      align-content: center;
      justify-items: center;
      height: calc(100svh - var(--spacing-barre));
    }

    /* Les trois réponses ont leur propre vue en une colonne. Ici c'est la
       scène collante qui les montre : la seconde vue n'est pas rendue, et
       son moteur est à l'arrêt. */
    .story__scene--reponses {
      display: none;
    }
  }

  /* Entre 1024 et 1279 px la colonne de la scène est la plus étroite que
     connaisse le grand plan (il y est rendu de 0,68 à 0,85) et le texte ne
     peut rien lui céder : son titre remplit déjà sa colonne. Dans une
     fenêtre large mais basse (680 px et moins), c'est la hauteur qui réduit
     la scène d'autant. Dans les deux cas ce sont les quatre tailles qui
     montent, pour que la note garde de la marge au-dessus de 9 px à l'écran
     (à 1200, sans cela, elle était à 9,01) ; la conversation, dont les
     bulles prennent alors plus de lignes, gagne en hauteur. */
  @media (min-width: 1024px) and (max-width: 1279px) and (min-height: 561px),
    (min-width: 1280px) and (min-height: 561px) and (max-height: 680px) {
    .scene {
      --retrait: 1;
      --sm-note: 13.5px;
      --sm-texte: 14.5px;
      --sm-fort: 16px;
      --sm-titre: 18px;
      --sm-chiffre: 34px;
    }

    .conversation {
      height: 376px;
    }

    /* Deux lignes à qui ce corps plus grand ôtait leurs derniers pixels :
       l'outil interrogé, dont la réponse est longue, et la carte livrée. */
    .outil {
      gap: 6px;
      padding-inline: 6px;
    }

    .carte {
      grid-template-columns: 8px minmax(0, 1fr) 10px;
      gap: 5px;
      padding-inline: 6px;
    }

    .carte svg {
      width: 10px;
      height: 10px;
    }
  }

  /* À partir de 1360 px, la colonne du texte s'élargit d'un cran : avec la
     gouttière du site, la plus longue ligne du premier titre n'y tenait plus
     et il gagnait une ligne. */
  @media (min-width: 1360px) and (min-height: 561px) {
    .story__grille {
      grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);
    }
  }

  /* Sur un écran large mais bas, la scène se règle sur la hauteur et devient
     plus étroite que ses quatre boutons : leurs marges se serrent. */
  @media (min-width: 1024px) and (max-height: 620px) {
    .scene__mode {
      --bouton-marge: 0.65rem;
    }
  }

  /* ── Une colonne ──
     Sur téléphone et tablette (et dans une fenêtre trop basse pour tenir une
     phrase et sa scène côte à côte), rien n'est collé. Une scène fixée en
     haut d'un petit écran ne laissait au texte qu'une bande étroite où
     défiler, et se disputait le défilement avec le doigt. Chaque vue est
     posée dans le fil de la page, sous le texte qu'elle illustre : le
     travail à la main après la première phrase, sans boutons ; les trois
     réponses après la troisième, avec les leurs. Chacune s'aligne sur l'axe
     du texte et ne dépasse jamais la hauteur de l'écran. */
  @media (max-width: 1023px), (max-height: 560px) {
    .story__grille {
      padding-block: var(--spacing-bloc);
    }

    .acte:not(:first-child) {
      margin-top: var(--spacing-bloc);
      padding-top: var(--spacing-bloc);
    }

    .acte__titre {
      max-width: 17ch;
    }

    .acte__course {
      display: none;
    }

    .story__scene {
      margin-top: var(--spacing-groupe);
    }

    .scene {
      --scene-max: 42.5rem;
      --scene-hors: 2rem;
      --scene-plancher: 17rem;
      justify-items: start;
      gap: 1rem;
    }

    /* Les boutons de la vue des réponses comptent dans ce qui doit tenir à
       l'écran avec elle. */
    .scene[data-scene='reponses'] {
      --scene-hors: 6.25rem;
    }

    /* La première vue ne montre que le travail à la main : pas de boutons. */
    .scene[data-scene='recit'] .scene__mode {
      display: none;
    }

    /* Trois boutons sur une seule ligne, au corps de tout ce qui se clique
       sur la page : ce sont les marges qui se serrent avec l'écran. La
       hauteur de 44 px, elle, ne bouge pas. */
    .scene__mode {
      --bouton-marge: clamp(0.3125rem, 1.9vw, 1rem);
    }
  }

  /* Téléphone : le panneau prend presque toute la largeur de l'écran, 8 px de
     chaque côté, au lieu de s'arrêter aux marges de la page. La scène est
     dessinée à taille fixe puis mise à l'échelle : plus large, tout y est plus
     grand (10 % à 402 px). Demandé par Lilian le 3 octobre 2026 ; les boutons
     de mode restent juste dessous, calés sur la colonne du texte. */
  @media (max-width: 640px) {
    .scene__boite {
      justify-self: stretch;
      width: auto;
      margin-inline: calc(0.5rem - var(--spacing-section-x));
    }

    /* Dans une fenêtre basse, la scène se règle sur la hauteur et peut être
       plus étroite que ses trois boutons : la ligne dépasse alors du panneau
       vers la droite, où la page a de la place. */
    @media (max-height: 560px) {
      .scene__mode {
        justify-self: start;
        max-width: none;
      }
    }

    /* Sur ces écrans, le flou d'arrière-plan et le mélange du grain coûtent
       trop cher pendant le défilement : les fenêtres deviennent opaques. */
    .fenetre--pdf,
    .fenetre--app,
    .fenetre--chat,
    .fenetre--base,
    .fenetre--outils,
    .fenetre--tableau,
    .puce {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .fenetre--pdf { background: var(--color-surface-high); }
    .fenetre--app,
    .fenetre--chat,
    .fenetre--base,
    .fenetre--outils,
    .fenetre--tableau { background: color-mix(in srgb, var(--color-night-deep) 94%, var(--color-ink)); }
    .puce { background: var(--color-night-deep); }

    .scene__cadre::after {
      opacity: 0.06;
      mix-blend-mode: normal;
    }
  }

  /* ── Le plan étroit ──
     Sous 640 px (ou dans une fenêtre basse), la scène est redessinée plutôt
     que réduite : trois lignes au lieu de cinq, une seule pastille de
     compteur, une facture sans pied. Les quatre tailles sont celles de ce
     plan-là : rendu entre 0,89 (fenêtre de 320) et 1,13 (402), la note fait
     10,2 à 13 px à l'écran. Au-delà d'un téléphone il ne grossit plus
     (`--scene-max`).
     Il est plus haut que large (340 × 420) : un téléphone a de la place en
     hauteur, et à 356 de haut les deux fenêtres se recouvraient de 23 px
     (retour de Lilian, le 3 octobre 2026). Le bon de commande et la facture
     se suivent maintenant sans se toucher, la conversation et les piles du
     suivi ont gagné en hauteur. */
  @media (max-width: 640px), (max-height: 560px) {
    .scene {
      --plan-l: 340;
      --plan-h: 420;
      --scene-max: 27.5rem;
      --retrait: 1;
      --sm-note: 11.5px;
      --sm-texte: 12px;
      --sm-fort: 13px;
      --sm-titre: 14.5px;
      --sm-chiffre: 22px;
    }

    .doc__ligne:nth-child(n + 4),
    .facture__ligne:nth-child(n + 4),
    .page__bloc,
    .champ,
    .pied,
    .puce--gestes,
    .mot-long {
      display: none;
    }

    .mot-court {
      display: inline;
    }

    .puces {
      top: 12px;
      left: 12px;
      gap: 6px;
    }

    .puce {
      gap: 6px;
      height: 26px;
      padding: 0 9px 0 7px;
    }

    .monde {
      --recul: 1100px;
      --rx: 6deg;
      --ry: -7deg;
      --rz: 1deg;
      --tx: 4px;
      --ty: 6px;
    }

    .scene[data-mode='agent'] .monde {
      --rx: 4deg;
      --ry: -2deg;
      --rz: 0.3deg;
      --tx: 0px;
      --ty: 14px;
    }

    .scene[data-mode='tableau'] .monde {
      --rx: 6deg;
      --ry: 3deg;
      --rz: -0.6deg;
      --tx: 0px;
      --ty: 24px;
    }

    .fenetre { border-radius: 10px; }

    .fenetre__barre {
      height: 28px;
      padding-inline: 9px;
    }

    .fenetre--pdf {
      top: 50px;
      left: 10px;
      width: 212px;
    }

    .fenetre--pdf .fenetre__corps { padding: 8px 8px 10px; }
    .page { padding: 10px 10px 7px; }

    .colonnes {
      grid-template-columns: 48px minmax(0, 1fr) 18px 46px;
      gap: 5px;
      margin-top: 8px;
      padding: 0 4px 5px;
    }

    .doc__ligne {
      grid-template-columns: 48px minmax(0, 1fr) 18px 46px;
      gap: 5px;
      height: 24px;
      padding-inline: 4px;
    }

    .doc__ligne:nth-child(3) { border-bottom: 0; }

    .fenetre--app {
      top: 240px;
      left: 120px;
      width: 206px;
    }

    .fenetre--app .fenetre__corps { padding: 8px; }

    .colonnes--app {
      grid-template-columns: 48px minmax(0, 1fr) 18px 46px 10px;
      margin-top: 0;
      padding: 0 6px 5px;
    }

    .facture__ligne {
      grid-template-columns: 48px minmax(0, 1fr) 18px 46px 10px;
      gap: 5px;
      height: 25px;
      padding-inline: 6px;
    }

    .facture__ligne svg { width: 10px; height: 10px; }

    /* Sur un plan étroit, la valeur transportée passe au-dessus du curseur
       et s'ouvre vers la gauche : dessous, elle recouvrait le titre de la
       facture, que les deux fenêtres rapprochées mettent juste sous la ligne
       copiée ; à droite, elle sortirait du panneau en arrivant sur la
       facture. */
    .curseur__valeur {
      top: -28px;
      right: 6px;
      left: auto;
      font-size: var(--sm-note);
      translate: 0 4px;
    }

    /* L'agent de support. Une seule question à l'écran à la fois, et les
       deux sources ne sont plus des fenêtres mais des pastilles sous la
       conversation : la base de connaissances, puis les outils. */
    .fenetre--chat {
      --sortie: translate(-28px, 14px) scale(var(--retrait));
      top: 46px;
      left: 10px;
      width: 320px;
    }

    .fenetre--chat .fenetre__corps { padding: 9px; }

    .chat__etat {
      gap: 6px;
      padding: 2px 8px 3px 7px;
    }

    .conversation { height: 226px; }

    .echange {
      display: none;
      gap: 5px;
    }

    .echange.est-actif { display: flex; }

    .bulle {
      max-width: 90%;
      padding: 6px 9px 7px;
      border-radius: 11px;
    }

    .fenetre--base {
      --sortie: translate(-18px, 26px) scale(var(--retrait));
      top: 332px;
      left: 10px;
      width: auto;
      border-radius: var(--radius-full);
    }

    .fenetre--base .fenetre__barre {
      height: 28px;
      padding-inline: 6px 11px;
      border-bottom: 0;
    }

    .fenetre--base .fenetre__icone { border-radius: var(--radius-full); }
    .fenetre--base .fenetre__corps { display: none; }

    .fenetre--base.est-trouve {
      border-color: var(--color-peche);
    }

    /* Les outils n'ont plus de fenêtre : il ne reste que leurs pastilles. */
    .fenetre--outils {
      --sortie: translate(22px, 26px) scale(var(--retrait));
      top: 331px;
      left: 196px;
      width: auto;
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }

    .fenetre--outils .fenetre__barre { display: none; }
    .fenetre--outils .fenetre__corps { padding: 0; }

    .outils {
      display: flex;
      gap: 6px;
    }

    .outil {
      grid-template-columns: 12px auto;
      gap: 5px;
      height: 30px;
      padding-inline: 8px 11px;
      border-radius: var(--radius-full);
      background: color-mix(in srgb, var(--color-night-deep) 94%, var(--color-ink));
    }

    .outil.est-interroge {
      background: color-mix(in srgb, var(--color-peche) 18%, var(--color-night-deep));
    }

    .outil svg {
      width: 12px;
      height: 12px;
    }

    /* Un seul outil sur ce plan, celui que l'agent interroge : avec deux, la
       seconde pastille touchait le bord du cadre et s'y rognait. */
    .outil__etat,
    .outil:nth-child(n + 2) {
      display: none;
    }

    /* Le suivi de projets : le même dessin, plus serré. Les noms des projets
       ne tiendraient pas à la taille de la note : chacun devient un trait. */
    .fenetre--tableau {
      --sortie: translate(0, 40px) scale(var(--retrait));
      top: 46px;
      left: 10px;
      width: 320px;
    }

    .fenetre--tableau .fenetre__corps {
      gap: 8px;
      padding: 9px;
    }

    .indicateurs,
    .piles { gap: 6px; }

    .indicateur {
      gap: 3px;
      padding: 6px 8px 8px;
      border-radius: 8px;
    }

    .pile {
      gap: 5px;
      padding: 6px;
      border-radius: 8px;
    }

    .pile ul {
      gap: 6px;
      height: calc(5 * 26px + 4 * 6px);
    }

    .carte {
      grid-template-columns: 6px minmax(0, 1fr) 9px;
      gap: 5px;
      height: 26px;
      padding-inline: 5px;
      border-radius: 5px;
    }

    .carte__puce {
      width: 6px;
      height: 6px;
    }

    .carte__nom { display: none; }
    .carte__trait { display: block; }

    .carte svg {
      width: 9px;
      height: 9px;
    }
  }

  /* Sans mouvement, on passe d'une image fixe à l'autre : ni caméra, ni
     fenêtre qui glisse, ni bulle qui se pose, ni carte qui avance. */
  @media (prefers-reduced-motion: reduce) {
    .proposition,
    .puce,
    .doc__ligne,
    .doc__ligne i,
    .doc__ligne::before,
    .facture__ligne i,
    .facture__ligne svg,
    .curseur__valeur,
    .scene__cadre::before,
    .monde,
    .scene[data-mode] .fenetre[class],
    .scene[data-mode] .puce[class],
    .bulle,
    .echange__quand,
    .source,
    .article,
    .article .coche,
    .outil,
    .indicateur b,
    .carte,
    .carte svg,
    .carte__puce,
    .carte__avance {
      transition: none;
    }

    .scene .echange.est-cherche .points i {
      animation: none;
    }

    /* Rien ne boucle : pas de commande d'arrêt. */
    .scene__pause {
      display: none;
    }
  }
</style>

<script>
  /*
   * Le moteur de la scène. `monter` l'installe sur une vue (une racine
   * `[data-scene]`) : tout son état est local, deux vues ne partagent rien
   * d'autre que la phrase qu'elles éclairent et la ligne d'annonce.
   *
   * Une boucle par façon de faire (à la main, puis les trois réponses) et un
   * jeton qui les annule : à chaque changement de mode le jeton avance, et
   * toute boucle qui se réveille avec un jeton périmé s'arrête sans rien
   * toucher. Ce qui choisit le mode dépend de la vue et de la mise en page :
   *   - `recit`, sur ordinateur : le défilement, par paliers (`situer`) ;
   *   - `recit`, en une colonne : une régie (`derouler`) qui alterne les deux
   *     temps du travail à la main ;
   *   - `reponses`, en une colonne : la même régie, sur les trois réponses ;
   *   - `reponses`, sur ordinateur : rien, la vue est masquée et à l'arrêt.
   */
  const NS = 'http://www.w3.org/2000/svg';
  const JOURS = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi'];
  const ATTENTE_DEPART = 23;

  /* Les quatre états de la scène : la copie à la main, puis les trois
     réponses, dans l'ordre où elle les enchaîne. */
  const MODES = ['main', 'auto', 'agent', 'tableau'] as const;
  type Mode = (typeof MODES)[number];
  const estMode = (v: string | undefined): v is Mode => MODES.some((m) => m === v);

  /* Un temps du récit : ce qu'il montre et combien il dure, en millisecondes
     passées à l'écran. Entre `mini` et `plafond`, la scène passe à la suite
     `tenue` ms après que la réponse a fini de dire ce qu'elle a à dire (voir
     `acheve`) : on ne coupe pas un geste au milieu. */
  type Temps = { acte: number; mode: Mode; mini: number; plafond: number; tenue: number };
  const REPONSES: Temps[] = [
    { acte: 3, mode: 'auto', mini: 5200, plafond: 10500, tenue: 1500 },
    { acte: 3, mode: 'agent', mini: 7000, plafond: 12500, tenue: 1400 },
    { acte: 3, mode: 'tableau', mini: 5600, plafond: 9500, tenue: 1150 },
  ];
  /* En une colonne, la première vue reste sur le travail à la main : la main
     recopie, puis la semaine file, et ainsi de suite. */
  const A_LA_MAIN: Temps[] = [
    { acte: 1, mode: 'main', mini: 7000, plafond: 7000, tenue: 0 },
    { acte: 2, mode: 'main', mini: 4500, plafond: 4500, tenue: 0 },
  ];

  /* Les deux vues de la scène (voir l'en-tête du composant). */
  type Role = 'recit' | 'reponses';

  /* Les deux régimes de mise en page. Les mêmes requêtes sont écrites dans
     les styles : une colonne sous 1024 px ou dans une fenêtre très basse, et
     le plan étroit sous 640 px ou dans cette même fenêtre basse. */
  const EMPILE = '(max-width: 1023px), (max-height: 560px)';
  const ETROIT = '(max-width: 640px), (max-height: 560px)';

  /* Sur ordinateur, le défilement avance par paliers : les deux premières
     phrases (à la main), puis les trois réponses pendant que la troisième
     phrase reste en place. `SEUILS` découpe la course de cette phrase : la
     part parcourue à partir de laquelle la scène passe à l'agent, puis au
     dashboard. L'automatisation a déjà joué pendant que la phrase montait,
     c'est pourquoi sa part de la course est la plus courte. */
  const PALIERS: Mode[] = ['main', 'main', 'auto', 'agent', 'tableau'];
  const SEUILS = { agent: 0.1, tableau: 0.56 };

  const ANNONCES: Record<Mode, string> = {
    main: 'À la main\u00a0: chaque ligne du bon de commande est recopiée dans la facture, et les commandes en attente s’accumulent.',
    auto: 'Automatisation\u00a0: les lignes passent seules du bon de commande à la facture, et il ne reste aucune commande en attente.',
    agent:
      'Agent IA\u00a0: un agent de support répond à un client un dimanche à 23\u00a0h\u00a047, puis à un autre à 3\u00a0h\u00a012. Il trouve la réponse dans la base de connaissances ou dans un outil connecté, le CRM, et cite sa source.',
    tableau:
      'Dashboard\u00a0: le suivi des projets d’une équipe, avec le nombre de projets en cours, livrés cette semaine et en retard, et trois colonnes où chaque projet avance de «\u00a0à faire\u00a0» à «\u00a0livré\u00a0».',
  };

  /* Les colonnes du suivi de projets, et l'ordre dans lequel les projets y
     avancent : un livré, un lancé, et encore une fois. */
  const ETATS = ['afaire', 'cours', 'livre'] as const;
  type Etat = (typeof ETATS)[number];
  const etatDe = (v: string | undefined): Etat => ETATS.find((e) => e === v) ?? 'afaire';
  const MOUVEMENTS: [Etat, Etat][] = [
    ['cours', 'livre'],
    ['afaire', 'cours'],
    ['cours', 'livre'],
    ['afaire', 'cours'],
  ];

  const racine = document.querySelector<HTMLElement>('[data-story]');
  /* Sans ces trois API (navigateurs d'avant 2020), la scène reste l'image
     fixe du HTML : mieux qu'un script qui s'arrête à mi-chemin. */
  const pretAAnimer =
    'animate' in Element.prototype && 'ResizeObserver' in window && 'IntersectionObserver' in window;
  if (racine && pretAAnimer) {
    /* La hauteur du texte de la troisième phrase : les styles s'en servent
       pour le fixer au milieu de l'écran, en face de la scène. */
    const corps = racine.querySelector<HTMLElement>('.acte--long .acte__corps');
    const long = corps?.parentElement;
    if (corps && long) {
      new ResizeObserver(() => long.style.setProperty('--corps-h', `${corps.offsetHeight}px`)).observe(corps);
    }
    racine.querySelectorAll<HTMLElement>('[data-scene]').forEach((scene) => {
      monter(racine, scene, scene.dataset.scene === 'reponses' ? 'reponses' : 'recit');
    });
  }

  function monter(racine: HTMLElement, scene: HTMLElement, role: Role) {
    const un = <T extends Element = HTMLElement>(sel: string) => scene.querySelector<T>(sel)!;
    const tous = (sel: string) => [...scene.querySelectorAll<HTMLElement>(sel)];
    const cadre = un('.scene__cadre');
    const plan = un('.scene__plan');
    const monde = un('[data-monde]');
    const curseur = un('[data-curseur]');
    const valeur = un('[data-porte]');
    const traces = un<SVGSVGElement>('[data-traces]');
    const doc = un('[data-doc]');
    const sablier = un('[data-sablier]');
    const etat = un('.facture__etat');
    const elJour = un('[data-jour]');
    const elHeure = un('[data-heure]');
    const elGestes = un('[data-gestes]');
    const elAttente = un('[data-attente]');
    const elTotal = un('[data-total]');
    const blocAttente = un('[data-attente-bloc]');
    const aigMin = un<SVGLineElement>('[data-aiguille-min]');
    const aigH = un<SVGLineElement>('[data-aiguille-h]');
    const bandes = tous('.bande');
    const puceHorloge = un('[data-horloge]');
    /* L'agent de support : la conversation et ses échanges, la base de
       connaissances (sa recherche, ses articles) et les outils connectés. */
    const fenChat = un('[data-chat]');
    const conversation = un('[data-conversation]');
    const echanges = tous('[data-echange]');
    const fenBase = un('[data-base]');
    const requete = un('[data-recherche]');
    const articles = tous('[data-article]');
    const fenOutils = un('[data-outils]');
    const outils = tous('[data-outil]');
    /* Le suivi de projets : les trois colonnes, les cartes et les deux
       indicateurs qui comptent. Le balisage porte l'état de départ ; le
       script le relit pour savoir où revenir. */
    const piles: Record<Etat, HTMLElement> = {
      afaire: un('[data-pile="afaire"]'),
      cours: un('[data-pile="cours"]'),
      livre: un('[data-pile="livre"]'),
    };
    const cartes = tous('[data-carte]');
    const departCartes = cartes.map((carte) => ({
      carte,
      etat: etatDe(carte.dataset.etat),
      p: carte.style.getPropertyValue('--p'),
    }));
    const indicateurs = tous('[data-indicateur]');
    const boutons = tous('[data-mode-bouton]');
    /* La ligne d'annonce est commune aux deux vues : une seule parle à la
       fois, celle dont on vient d'appuyer un bouton. */
    const annonce = racine.querySelector<HTMLElement>('[data-annonce]');
    const titres = [...racine.querySelectorAll<HTMLElement>('.acte')].map((acte) => ({
      n: Number(acte.dataset.acte),
      el: acte.querySelector<HTMLElement>('.acte__titre')!,
    }));
    /* La troisième phrase : son texte, qui reste en place sur ordinateur, et
       la course qui le suit. */
    const acteLong = racine.querySelector<HTMLElement>('.acte--long');
    const corpsLong = acteLong?.querySelector<HTMLElement>('.acte__corps') ?? null;
    const course = acteLong?.querySelector<HTMLElement>('.acte__course') ?? null;

    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /* En une colonne, la scène n'est plus liée au défilement : elle déroule
       seule ses temps. */
    const colonne = window.matchMedia(EMPILE);
    /* Le plan étroit, celui où la conversation ne montre qu'un échange. */
    const etroit = window.matchMedia(ETROIT);
    const euros = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    /* Le mode que montre le balisage, en image fixe : la boucle qui le joue
       n'est pas encore lancée (`tourne`). */
    const depart = scene.dataset.mode;
    let mode: Mode = estMode(depart) ? depart : 'main';
    let tourne = false;
    let acte = Number(scene.dataset.acte) || 1;
    let jeton = 0;
    let visible = false;
    let gestes = 0;
    let attente = ATTENTE_DEPART;
    let minutes = 9 * 60;
    let jour = 0;
    let vitesse = 5;
    let pos = { x: 0, y: 0 };
    /* L'instant où la réponse en cours a fini de dire ce qu'elle a à dire : la
       file est vide et la facture émise, l'agent a répondu à ses deux
       clients, un projet a été livré et un autre lancé. Zéro tant que ce
       n'est pas le cas. La régie s'en sert pour passer à la suite au bon
       moment. */
    let acheve = 0;
    const conclure = () => {
      if (!acheve) acheve = instant();
    };

    type Pt = { x: number; y: number };

    const lignes = (sel: string) =>
      [...monde.querySelectorAll<HTMLElement>(sel)].filter((el) => el.offsetParent !== null);

    /* Une animation annulée par un changement de mode rejette sa promesse avec
       `AbortError` : c'est attendu, la boucle s'arrête d'elle-même au contrôle
       de jeton suivant. Toute autre erreur remonte. */
    const annulee = (erreur: unknown) => erreur instanceof DOMException && erreur.name === 'AbortError';
    const fini = (animation: Animation) =>
      animation.finished.then(
        () => undefined,
        (erreur: unknown) => {
          if (!annulee(erreur)) throw erreur;
        },
      );

    /* ── Le temps de la scène ──
       Le visiteur peut arrêter la scène (voir la commande d'arrêt, en bas).
       Pour qu'elle se fige net et reprenne où elle en était, rien ici
       n'attend avec une minuterie : une attente est une animation sans effet
       posée sur un élément sans rendu (`sablier`), et l'arrêt suspend d'un
       coup toutes les animations de la scène, attentes comprises. Ce qui
       avance image par image lit `instant()`, qui ne compte pas le temps
       passé à l'arrêt, et passe par `image()`, qui attend la reprise. */
    let arretee = false;
    /* Le mode a changé pendant l'arrêt : il est montré en image fixe, et sa
       boucle partira à la reprise. */
    let fige = false;
    let gel = 0;
    let arretDepuis = 0;
    const instant = () => (arretee ? arretDepuis : performance.now()) - gel;

    /* Les animations lancées par le moteur et pas encore finies. Il les
       tient lui-même : `getAnimations()` ne rend plus une animation suspendue
       sur sa dernière image, et celle-là ne serait jamais relancée. */
    const vivantes = new Set<Animation>();
    const jouer = (el: Element, images: Keyframe[] | PropertyIndexedKeyframes, options: KeyframeAnimationOptions) => {
      const animation = el.animate(images, options);
      vivantes.add(animation);
      const oublier = () => vivantes.delete(animation);
      animation.finished.then(oublier, oublier);
      if (arretee) animation.pause();
      return animation;
    };
    /* Celles du moteur, plus celles que les styles ont créées dans le panneau
       (les transitions, les points de la bulle qui cherche). Le panneau
       seulement : la commande d'arrêt et les boutons de mode gardent leurs
       propres transitions, que l'arrêt ne doit pas suspendre. */
    const toutes = () => new Set<Animation>([...vivantes, ...cadre.getAnimations({ subtree: true })]);

    const pause = (ms: number) => fini(jouer(sablier, { opacity: [0, 0] }, { duration: Math.max(1, ms) }));
    /* Une suite à jouer plus tard, sans retenir la boucle qui la demande. */
    const plusTard = (ms: number, suite: () => void) => {
      pause(ms).then(suite).catch(console.error);
    };

    /* Hors écran, onglet masqué ou scène arrêtée, les boucles s'endorment
       ici : plus rien ne réveille la page tant que la scène n'est pas revenue
       (`reveiller`). */
    const aLEcran = () => visible && !document.hidden && !arretee;
    let endormies: (() => void)[] = [];
    const attendreEcran = () =>
      aLEcran() ? Promise.resolve() : new Promise<void>((ok) => endormies.push(ok));

    /* L'image suivante, datée à l'heure de la scène. À l'arrêt, elle attend
       la reprise. */
    const image = (suite: (t: number) => void) => {
      requestAnimationFrame(() => {
        if (arretee) endormies.push(() => image(suite));
        else suite(instant());
      });
    };

    /* Le rectangle d'un élément dans le repère du monde, lu sur la mise en
       page et non à l'écran : la perspective du monde ne le déforme pas, et
       une fenêtre encore en train d'arriver est déjà lue à sa place. */
    const cadreDe = (el: HTMLElement) => {
      let x = 0;
      let y = 0;
      let n: HTMLElement | null = el;
      while (n && n !== monde) {
        x += n.offsetLeft;
        y += n.offsetTop;
        n = n.offsetParent as HTMLElement | null;
      }
      return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    };

    const lieu = (el: HTMLElement, ax = 0.5, ay = 0.5): Pt => {
      const c = cadreDe(el);
      return { x: c.x + c.w * ax, y: c.y + c.h * ay };
    };

    const ajuster = () => {
      plan.style.setProperty('--k', String(cadre.clientWidth / plan.offsetWidth));
      traces.setAttribute('viewBox', `0 0 ${monde.offsetWidth} ${monde.offsetHeight}`);
    };

    /* Une courbe entre deux points, échantillonnée avec son accélération : les
       images clés portent déjà le départ doux et l'arrivée douce. */
    const courbe = (de: Pt, vers: Pt, bombe: number, pas = 18) => {
      const c = { x: (de.x + vers.x) / 2, y: Math.min(de.y, vers.y) - bombe };
      const liste: Pt[] = [];
      for (let i = 0; i <= pas; i++) {
        const t = i / pas;
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        liste.push({
          x: (1 - e) * (1 - e) * de.x + 2 * (1 - e) * e * c.x + e * e * vers.x,
          y: (1 - e) * (1 - e) * de.y + 2 * (1 - e) * e * c.y + e * e * vers.y,
        });
      }
      return { liste, c };
    };

    const chemin = (de: Pt, c: Pt, vers: Pt) => {
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', `M${de.x} ${de.y} Q${c.x} ${c.y} ${vers.x} ${vers.y}`);
      return p;
    };

    const poser = (p: Pt) => {
      pos = p;
      curseur.style.transform = `translate(${p.x}px, ${p.y}px)`;
    };

    async function deplacer(vers: Pt, duree: number, bombe: number, trace = false) {
      const de = pos;
      const { liste, c } = courbe(de, vers, bombe);
      if (trace) {
        const p = chemin(de, c, vers);
        traces.append(p);
        jouer(p, [{ opacity: 0 }, { opacity: 0.7 }], { duration: duree, fill: 'forwards' });
        const garde = acte === 2 ? 30000 : 4600;
        plusTard(garde, () => {
          fini(jouer(p, [{ opacity: 0.7 }, { opacity: 0 }], { duration: 900, fill: 'forwards' }))
            .then(() => p.remove())
            .catch(console.error);
        });
        while (traces.childElementCount > 48) traces.firstElementChild?.remove();
      }
      const anim = jouer(
        curseur,
        liste.map((p) => ({ transform: `translate(${p.x}px, ${p.y}px)` })),
        { duration: duree, easing: 'linear' },
      );
      try {
        await anim.finished;
        poser(vers);
      } catch (erreur) {
        if (!annulee(erreur)) throw erreur;
      }
    }

    const cliquer = () => {
      curseur.classList.add('clique');
      plusTard(130, () => curseur.classList.remove('clique'));
    };

    /* Un nombre qui change tombe à sa place. `elan` est la hauteur de la
       chute, en pour cent de la sienne : petite pour un grand nombre, qui
       sinon monterait sur ce qu'il a au-dessus de lui. */
    const ecrire = (el: HTMLElement, n: number, elan = 38) => {
      el.textContent = String(n);
      if (!reduit) {
        jouer(
          el,
          [{ transform: `translateY(-${elan}%)`, opacity: 0.2 }, { transform: 'none', opacity: 1 }],
          { duration: 240, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        );
      }
    };

    const compter = (el: HTMLElement, de: number, vers: number, duree: number, j: number) => {
      const debut = instant();
      const pas = (t: number) => {
        /* Interrompu, le compteur écrit sa valeur d'arrivée : la variable la
           porte déjà, et un nombre intermédiaire resterait affiché. */
        if (j !== jeton) {
          el.textContent = String(vers);
          return;
        }
        const a = Math.min(1, (t - debut) / duree);
        el.textContent = String(Math.round(de + (vers - de) * (1 - Math.pow(1 - a, 3))));
        if (a < 1) image(pas);
      };
      image(pas);
    };

    const majAttente = (n: number) => {
      attente = n;
      ecrire(elAttente, n);
      blocAttente.classList.toggle('est-vide', n === 0);
    };

    /* Le total de la facture : la somme des lignes déjà remplies. */
    const majTotal = () => {
      const somme = lignes('[data-ligne-facture]')
        .filter((l) => l.classList.contains('est-rempli'))
        .reduce((t, l) => t + Number(l.dataset.montant ?? 0), 0);
      elTotal.textContent = `${euros.format(somme)}\u00a0€`;
    };

    const etatFacture = (emise: boolean) => {
      etat.dataset.etat = emise ? 'emise' : 'brouillon';
      etat.textContent = emise ? 'Émise' : 'Brouillon';
    };

    /* La page et la facture se vident ensemble, et seulement quand elles
       reviennent : une réponse qui les retire de la scène les laisse partir
       telles qu'elles sont, au lieu de les voir se vider en s'effaçant. */
    const viderLignes = () => {
      monde.querySelectorAll('[data-ligne-doc]').forEach((l) => l.classList.remove('est-lu', 'est-copie', 'est-fait'));
      monde.querySelectorAll('[data-ligne-facture]').forEach((l) => l.classList.remove('est-rempli', 'est-valide'));
      etatFacture(false);
      majTotal();
    };

    /* Une commande de plus arrive : la pastille tressaille. */
    const feuilleTombe = () => {
      if (reduit) return;
      jouer(blocAttente, [{ transform: 'scale(1.09)' }, { transform: 'none' }], {
        duration: 360,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      });
    };

    /* La page traitée part, la suivante remonte, la facture se vide. */
    async function docSuivant(j: number, rapide: boolean) {
      const d = rapide ? 190 : 360;
      await fini(
        jouer(doc, [{ translate: '0 0', opacity: 1 }, { translate: '0 -18px', opacity: 0 }], {
          duration: d,
          easing: 'cubic-bezier(0.5, 0, 0.75, 0)',
        }),
      );
      if (j !== jeton) return;
      viderLignes();
      await fini(
        jouer(doc, [{ translate: '0 22px', opacity: 0 }, { translate: '0 0', opacity: 1 }], {
          duration: d,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        }),
      );
    }

    /* ── À la main ──
       `retard` laisse aux fenêtres le temps de reprendre leur place quand on
       revient d'une réponse qui les avait déplacées. */
    async function boucleMain(j: number, retard: number) {
      curseur.dataset.etat = 'visible';
      if (retard) {
        await pause(retard);
        if (j !== jeton) return;
      }
      while (j === jeton) {
        const docs = lignes('[data-ligne-doc]');
        const facts = lignes('[data-ligne-facture]');
        for (let i = 0; i < docs.length; i++) {
          await attendreEcran();
          if (j !== jeton) return;
          await deplacer(lieu(docs[i], 0.78, 0.58), 480, 12);
          if (j !== jeton) return;
          cliquer();
          docs[i].classList.add('est-copie');
          valeur.textContent = docs[i].dataset.valeur ?? '';
          curseur.classList.add('porte');
          await pause(230);
          if (j !== jeton) return;
          await deplacer(lieu(facts[i], 0.38, 0.58), 720, 40, true);
          if (j !== jeton) return;
          cliquer();
          curseur.classList.remove('porte');
          facts[i].classList.add('est-rempli');
          docs[i].classList.remove('est-copie');
          docs[i].classList.add('est-fait');
          majTotal();
          gestes += 1;
          ecrire(elGestes, gestes);
          await pause(260);
        }
        if (j !== jeton) return;
        etatFacture(true);
        await pause(560);
        if (j !== jeton) return;
        majAttente(Math.max(1, attente - 1));
        await docSuivant(j, false);
      }
    }

    /* Pendant ce temps, les bons de commande continuent d'arriver. */
    async function arrivees(j: number) {
      while (j === jeton) {
        await pause(acte === 2 ? 950 : 3800);
        await attendreEcran();
        if (j !== jeton) return;
        majAttente(attente + 1);
        feuilleTombe();
      }
    }

    /* Une bande pêche quitte son point de départ et va prendre la place et la
       forme de sa cible : d'une ligne du bon de commande à une ligne de la
       facture, ou de la source que l'agent consulte à la bulle où il répond. */
    async function voler(bande: HTMLElement, de: HTMLElement, vers: HTMLElement, delai: number, duree: number) {
      const a = cadreDe(de);
      const z = cadreDe(vers);
      const dx = z.x - a.x;
      const dy = z.y - a.y - 3;
      Object.assign(bande.style, {
        left: `${a.x}px`,
        top: `${a.y + 3}px`,
        width: `${a.w}px`,
        height: `${a.h - 6}px`,
      });
      await fini(
        jouer(
          bande,
          [
            { transform: 'translate(0, 0) scale(1, 1)', opacity: 0.9 },
            {
              transform: `translate(${dx * 0.5 + a.w * 0.22}px, ${dy * 0.42 - 14}px) scale(0.56, 0.72)`,
              opacity: 0.9,
              offset: 0.5,
            },
            { opacity: 0.85, offset: 0.82 },
            { transform: `translate(${dx}px, ${dy}px) scale(${z.w / a.w}, ${z.h / (a.h - 6)})`, opacity: 0 },
          ],
          { duration: duree, delay: delai, easing: 'cubic-bezier(0.45, 0, 0.15, 1)', fill: 'backwards' },
        ),
      );
    }

    /* Un texte qui s'écrit, à pas réguliers. Interrompu, il s'arrête où il
       est : la boucle qui reprendra la scène le remettra d'aplomb. */
    const taper = (el: HTMLElement, texte: string, duree: number, j: number) =>
      new Promise<void>((ok) => {
        const debut = instant();
        const pas = (t: number) => {
          if (j !== jeton) return ok();
          const a = Math.min(1, Math.max(0, (t - debut) / duree));
          el.textContent = texte.slice(0, Math.round(texte.length * a));
          if (a < 1) image(pas);
          else ok();
        };
        image(pas);
      });

    /* Les trois réponses partent du même constat : plus aucun geste refait.
       L'automatisation le montre, compteur à l'appui, et vide la file sous
       les yeux du visiteur : si la file est déjà vide (on revient de l'agent
       ou du dashboard), elle se remplit d'abord. L'agent et le dashboard ne
       parlent pas de commandes : leurs deux compteurs sont sortis de la
       scène (voir les styles), on les remet seulement à zéro. */
    const solder = (j: number, montre: boolean) => {
      if (montre) compter(elGestes, gestes, 0, 900, j);
      else elGestes.textContent = '0';
      gestes = 0;
      if (montre && attente === 0) attente = ATTENTE_DEPART;
      elAttente.textContent = String(attente);
      blocAttente.classList.toggle('est-vide', attente === 0);
    };

    /* ── Automatisation ── */
    async function boucleAuto(j: number, retard: number) {
      curseur.dataset.etat = 'cache';
      viderLignes();
      solder(j, true);
      /* La file se vide en cinq bons, quelle que soit sa longueur : la durée
         de cette réponse ne dépend pas du temps passé sur la phrase d'avant. */
      const lot = Math.max(3, Math.ceil(attente / 5));
      await pause(retard);
      while (j === jeton) {
        await attendreEcran();
        if (j !== jeton) return;
        const docs = lignes('[data-ligne-doc]');
        const facts = lignes('[data-ligne-facture]');
        const presse = attente > 0;
        const cadence = presse ? 32 : 75;
        docs.forEach((d, i) =>
          plusTard(i * cadence, () => {
            if (j === jeton) d.classList.add('est-lu');
          }),
        );
        await pause(docs.length * cadence + (presse ? 110 : 300));
        if (j !== jeton) return;
        await Promise.all(
          docs.map((d, i) =>
            voler(bandes[i], d, facts[i], i * cadence, presse ? 380 : 600).then(() => {
              if (j !== jeton) return;
              facts[i].classList.add('est-rempli', 'est-valide');
              majTotal();
            }),
          ),
        );
        if (j !== jeton) return;
        etatFacture(true);
        if (presse) majAttente(Math.max(0, attente - lot));
        if (attente > 0) {
          await pause(220);
          if (j !== jeton) return;
          await docSuivant(j, true);
        } else {
          /* La file est vide : la facture émise reste à l'écran, c'est
             l'image que cette réponse laisse. */
          conclure();
          await pause(3200);
          if (j !== jeton) return;
          feuilleTombe();
          await docSuivant(j, false);
        }
      }
    }

    /* ── Agent IA : le support client ──
       Ce que l'agent consulte pour répondre : un article de la base de
       connaissances, ou un outil connecté. Sur le plan étroit les articles ne
       sont pas dessinés, c'est la pastille de la base elle-même qui s'allume. */
    const sourceDe = (e: HTMLElement): HTMLElement => {
      if (e.dataset.origine === 'base') return lignes('[data-article][data-trouve]')[0] ?? fenBase;
      return outils.find((o) => o.dataset.outil === e.dataset.origine && o.offsetParent !== null) ?? fenOutils;
    };

    const allumer = (e: HTMLElement, source: HTMLElement) => {
      if (e.dataset.origine === 'base') {
        fenBase.classList.add('est-consulte');
        source.classList.add('est-trouve');
        requete.textContent = e.dataset.requete ?? '';
        return;
      }
      fenOutils.classList.add('est-consulte');
      source.classList.add('est-interroge');
      const etatOutil = source.querySelector('[data-outil-etat]');
      if (etatOutil && source.dataset.trouve) etatOutil.textContent = source.dataset.trouve;
    };

    const eteindre = () => {
      [fenBase, fenOutils].forEach((f) => f.classList.remove('est-consulte', 'est-trouve'));
      articles.forEach((a) => a.classList.remove('est-parcouru', 'est-trouve'));
      outils.forEach((o) => {
        o.classList.remove('est-interroge');
        const etatOutil = o.querySelector('[data-outil-etat]');
        if (etatOutil) etatOutil.textContent = 'Connecté';
      });
      requete.textContent = '';
      traces.replaceChildren();
    };

    /* `actif` est l'échange que le plan étroit montre : il n'en affiche qu'un
       à la fois. Sur le grand plan les deux tiennent l'un sous l'autre. */
    const viderAgent = (actif = 0) => {
      echanges.forEach((e, i) => {
        e.classList.remove('est-pose', 'est-cherche', 'est-repondu', 'est-source');
        e.classList.toggle('est-actif', i === actif);
      });
      eteindre();
    };

    /* La conversation s'ouvre sur un échange : la question du client y est
       déjà. Sans cela la fenêtre arrivait vide, et le restait deux à trois
       secondes. */
    const ouvrirEchange = (rang = 0) => {
      viderAgent(rang);
      echanges[rang]?.classList.add('est-pose');
    };

    /* Un échange terminé, d'un coup : la question, la réponse, sa source. */
    const poserEchange = (e: HTMLElement) => {
      const texte = e.querySelector<HTMLElement>('[data-texte]');
      if (texte) texte.textContent = e.dataset.reponse ?? '';
      e.classList.add('est-pose', 'est-cherche', 'est-repondu', 'est-source');
      allumer(e, sourceDe(e));
    };

    /* Le fil entre la source consultée et la conversation : il arrive sur le
       bord de la fenêtre, à hauteur de la bulle (grand plan), ou monte droit
       de la pastille vers elle (plan étroit). */
    const relier = (source: HTMLElement, bulle: HTMLElement) => {
      const c = cadreDe(fenChat);
      const s = cadreDe(source);
      const b = cadreDe(bulle);
      const aCote = s.x >= c.x + c.w;
      const de = aCote ? { x: s.x, y: s.y + s.h / 2 } : { x: s.x + s.w / 2, y: s.y };
      const vers = aCote ? { x: c.x + c.w, y: b.y + b.h / 2 } : { x: de.x, y: c.y + c.h };
      const milieu = {
        x: (de.x + vers.x) / 2 + (vers.y - de.y) * 0.25,
        y: (de.y + vers.y) / 2 - (vers.x - de.x) * 0.25,
      };
      const p = chemin(de, milieu, vers);
      p.classList.add('fil-source');
      traces.append(p);
      jouer(p, [{ opacity: 0 }, { opacity: 1 }], { duration: 280, fill: 'forwards' });
    };

    /* L'agent consulte sa source : il tape sa recherche et parcourt les
       articles jusqu'au bon, ou interroge l'outil. Rend la source trouvée,
       ou rien si la scène a changé de mode entre-temps. */
    async function consulter(e: HTMLElement, j: number) {
      const source = sourceDe(e);
      if (e.dataset.origine === 'base') {
        fenBase.classList.add('est-consulte');
        const visibles = lignes('[data-article]');
        if (visibles.length) {
          await taper(requete, e.dataset.requete ?? '', 320, j);
          for (const a of visibles) {
            if (j !== jeton) return null;
            if (a === source) break;
            a.classList.add('est-parcouru');
            await pause(100);
            a.classList.remove('est-parcouru');
          }
        } else {
          await pause(420);
        }
      } else {
        fenOutils.classList.add('est-consulte');
        await pause(420);
      }
      if (j !== jeton) return null;
      allumer(e, source);
      return source;
    }

    /* Un échange : l'heure tourne, le client écrit, l'agent cherche, la
       réponse quitte sa source pour la bulle, s'écrit, et cite d'où elle
       vient. */
    async function echanger(e: HTMLElement, j: number) {
      const bulle = e.querySelector<HTMLElement>('[data-bulle]');
      const texte = e.querySelector<HTMLElement>('[data-texte]');
      if (!bulle || !texte) return;
      fixerNuit(e.dataset.jour ?? '', Number(e.dataset.minutes ?? 0));
      await pause(320);
      if (j !== jeton) return;
      e.classList.add('est-pose');
      await pause(540);
      if (j !== jeton) return;
      e.classList.add('est-cherche');
      await pause(260);
      if (j !== jeton) return;
      const source = await consulter(e, j);
      if (!source || j !== jeton) return;
      relier(source, bulle);
      await voler(bandes[0], source, bulle, 0, 480);
      if (j !== jeton) return;
      texte.textContent = '';
      e.classList.add('est-repondu');
      await taper(texte, e.dataset.reponse ?? '', 420, j);
      if (j !== jeton) return;
      e.classList.add('est-source');
    }

    /* La conversation sort, `entre` la change, elle revient : c'est ainsi
       qu'elle se vide, et que le plan étroit passe d'une question à l'autre. */
    async function tournerConversation(j: number, entre: () => void) {
      await fini(
        jouer(conversation, [{ translate: '0 0', opacity: 1 }, { translate: '0 -12px', opacity: 0 }], {
          duration: 280,
          easing: 'cubic-bezier(0.5, 0, 0.75, 0)',
        }),
      );
      if (j !== jeton) return;
      entre();
      await fini(
        jouer(conversation, [{ translate: '0 12px', opacity: 0 }, { translate: '0 0', opacity: 1 }], {
          duration: 280,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        }),
      );
    }

    async function boucleAgent(j: number, retard: number) {
      curseur.dataset.etat = 'cache';
      ouvrirEchange();
      solder(j, false);
      /* La nuit tombe pendant que les fenêtres arrivent. */
      const premier = echanges[0];
      if (premier) fixerNuit(premier.dataset.jour ?? '', Number(premier.dataset.minutes ?? 0));
      await pause(retard);
      while (j === jeton) {
        for (let i = 0; i < echanges.length; i++) {
          await attendreEcran();
          if (j !== jeton) return;
          if (i > 0) {
            await pause(780);
            if (j !== jeton) return;
            if (etroit.matches) {
              await tournerConversation(j, () => ouvrirEchange(i));
              if (j !== jeton) return;
            } else {
              traces.replaceChildren();
            }
          }
          await echanger(echanges[i], j);
          if (j !== jeton) return;
        }
        /* Deux clients, deux heures de la nuit, deux sources : la réponse a
           dit ce qu'elle avait à dire. */
        conclure();
        await pause(2600);
        if (j !== jeton) return;
        await tournerConversation(j, () => ouvrirEchange());
      }
    }

    /* ── Dashboard : le suivi de projets ── */
    const compterPiles = (anime: boolean) => {
      ETATS.forEach((etat) => {
        const n = piles[etat].childElementCount;
        tous(`[data-compte="${etat}"]`).forEach((el) => {
          if (el.textContent === String(n)) return;
          if (anime) ecrire(el, n, 14);
          else el.textContent = String(n);
        });
      });
    };

    /* Chaque carte retrouve la colonne et l'avancement du balisage. */
    const ranger = () => {
      departCartes.forEach(({ carte, etat, p }) => {
        piles[etat].append(carte);
        carte.dataset.etat = etat;
        carte.style.setProperty('--p', p);
        carte.classList.remove('en-vol');
      });
    };

    /* Le tableau vide : les cartes rangées mais pas encore posées, et les
       indicateurs à zéro, puisqu'ils comptent les cartes. */
    const viderTableau = () => {
      ranger();
      cartes.forEach((c) => c.classList.remove('est-la'));
      compterPiles(false);
      indicateurs.forEach((el) => (el.textContent = '0'));
    };

    /* Les cartes se posent l'une après l'autre. */
    const poserCartes = (j: number) => {
      cartes.forEach((c, i) =>
        plusTard(i * 50, () => {
          if (j === jeton) c.classList.add('est-la');
        }),
      );
    };

    /* Les cartes se distribuent, colonne après colonne, et les indicateurs
       comptent jusqu'à ce qu'elles disent. */
    const distribuer = (j: number) => {
      poserCartes(j);
      indicateurs.forEach((el) => compter(el, 0, piles[etatDe(el.dataset.compte)].childElementCount, 800, j));
    };

    /* Un projet avance : sa carte quitte une colonne pour le haut de la
       suivante. Toutes les cartes sont mesurées avant et après, et chacune
       glisse de son ancienne place à la nouvelle ; celle qui change de
       colonne se soulève en passant. */
    const avancer = (de: Etat, vers: Etat) => {
      const carte = de === 'cours' ? piles.cours.lastElementChild : piles.afaire.firstElementChild;
      if (!(carte instanceof HTMLElement)) return;
      const avant = new Map(cartes.map((c) => [c, cadreDe(c)]));
      piles[vers].prepend(carte);
      carte.dataset.etat = vers;
      carte.style.setProperty('--p', vers === 'livre' ? '100' : '15');
      cartes.forEach((c) => {
        const a = avant.get(c);
        const z = cadreDe(c);
        if (!a || (a.x === z.x && a.y === z.y)) return;
        const dx = a.x - z.x;
        const dy = a.y - z.y;
        jouer(
          c,
          c === carte
            ? [
                { translate: `${dx}px ${dy}px`, scale: 1 },
                { translate: `${dx * 0.5}px ${dy * 0.5 - 12}px`, scale: 1.06, offset: 0.5 },
                { translate: '0 0', scale: 1 },
              ]
            : [{ translate: `${dx}px ${dy}px` }, { translate: '0 0' }],
          { duration: c === carte ? 780 : 520, easing: 'cubic-bezier(0.3, 0, 0.2, 1)' },
        );
      });
      carte.classList.add('en-vol');
      plusTard(780, () => carte.classList.remove('en-vol'));
      compterPiles(true);
    };

    async function boucleTableau(j: number, retard: number) {
      curseur.dataset.etat = 'cache';
      viderTableau();
      solder(j, false);
      /* La fenêtre se lève d'abord ; ses cartes arrivent sur elle. */
      await pause(retard);
      await attendreEcran();
      if (j !== jeton) return;
      distribuer(j);
      await pause(cartes.length * 50 + 700);
      while (j === jeton) {
        for (let i = 0; i < MOUVEMENTS.length; i++) {
          await pause(1650);
          await attendreEcran();
          if (j !== jeton) return;
          avancer(MOUVEMENTS[i][0], MOUVEMENTS[i][1]);
          /* Un projet livré, un autre lancé : on a vu le tableau vivre. */
          if (i >= 1) conclure();
        }
        /* La semaine suivante : le tableau repart de son état de départ. */
        await pause(2200);
        if (j !== jeton) return;
        cartes.forEach((c) => c.classList.remove('est-la'));
        await pause(360);
        if (j !== jeton) return;
        ranger();
        compterPiles(true);
        poserCartes(j);
        await pause(cartes.length * 50 + 500);
      }
    }

    /* ── Sans mouvement : une image fixe par façon de faire ── */
    const figer = () => {
      viderLignes();
      viderAgent();
      viderTableau();
      const docs = lignes('[data-ligne-doc]');
      const facts = lignes('[data-ligne-facture]');
      curseur.dataset.etat = 'cache';
      const regle = mode !== 'main';
      elGestes.textContent = regle ? '0' : '2';
      elAttente.textContent = regle ? '0' : String(ATTENTE_DEPART);
      blocAttente.classList.toggle('est-vide', regle);
      /* L'horloge s'arrête à l'heure de l'image : la nuit pour l'agent, le
         jour pour tout le reste. */
      remontee += 1;
      enRemontee = false;
      const premier = echanges[0];
      nuit =
        mode === 'agent' && premier
          ? { jour: premier.dataset.jour ?? '', minutes: Number(premier.dataset.minutes ?? 0) }
          : null;
      puceHorloge.classList.toggle('est-nuit', nuit !== null);
      if (nuit) afficher(nuit.jour, nuit.minutes);
      else afficher(JOURS[jour], minutes);
      if (mode === 'main') {
        docs.slice(0, 2).forEach((d) => d.classList.add('est-fait'));
        facts.slice(0, 2).forEach((f) => f.classList.add('est-rempli'));
      } else if (mode === 'auto') {
        docs.forEach((d) => d.classList.add('est-lu'));
        facts.forEach((f) => f.classList.add('est-rempli', 'est-valide'));
        etatFacture(true);
      } else if (mode === 'agent') {
        /* Les échanges terminés : les deux sur le grand plan, le premier
           seulement sur le plan étroit. */
        echanges.filter((e) => e.offsetParent !== null).forEach(poserEchange);
      } else {
        cartes.forEach((c) => c.classList.add('est-la'));
        compterPiles(false);
      }
      majTotal();
    };

    /* Une boucle qui lève s'arrêterait sans bruit, scène figée au milieu d'un
       geste. Ici elle laisse une trace, arrête ses sœurs et la scène retombe
       sur son image fixe, celle du mouvement réduit. */
    const veiller = (boucle: Promise<void>, nom: string) => {
      boucle.catch((erreur: unknown) => {
        console.error(`Scène du récit : la boucle « ${nom} » s’est arrêtée`, erreur);
        jeton += 1;
        deroule += 1;
        figer();
      });
    };

    /* Le temps d'un changement de réponse, le plan tourne en mouvement de
       caméra (voir `.bascule` dans les styles) ; ensuite il retrouve la
       vivacité qu'il lui faut pour suivre le pointeur. */
    let bascules = 0;
    const basculer = () => {
      const tour = ++bascules;
      scene.classList.add('bascule');
      plusTard(1200, () => {
        if (tour === bascules) scene.classList.remove('bascule');
      });
    };

    /* La phrase de la troisième partie nomme les trois réponses : celle que
       la scène montre passe en clair (voir `.proposition` dans les styles).
       Une seule vue la règle à la fois, celle que la mise en page affiche. */
    const direReponse = () => {
      if (!acteLong || role !== (colonne.matches ? 'reponses' : 'recit')) return;
      if (mode === 'main') acteLong.removeAttribute('data-reponse');
      else acteLong.dataset.reponse = mode;
    };

    const changerMode = (m: Mode) => {
      /* Déjà sur ce mode, et sa boucle tourne : rien à faire. Sinon (premier
         lancement, vue remise en route) le mode repart de son début. */
      if (m === mode && tourne) return;
      const avant = mode;
      mode = m;
      tourne = true;
      jeton += 1;
      acheve = 0;
      /* À l'arrêt, le mode change quand même (le lecteur a défilé, ou choisi
         au bouton), mais en image fixe et d'un coup : la scène ne se remet
         pas à bouger dans son dos. Sa boucle partira à la reprise. */
      const net = arretee && !reduit;
      if (net) scene.classList.add('sans-transition');
      scene.dataset.mode = m;
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBouton === m)));
      /* Tout ce que le moteur avait lancé s'arrête, attentes comprises : les
         boucles de l'ancien mode se réveillent, voient leur jeton périmé et
         sortent. */
      [...vivantes].forEach((a) => a.cancel());
      curseur.classList.remove('porte');
      traces.replaceChildren();
      direReponse();
      if (reduit) return figer();
      if (net) {
        fige = true;
        figer();
        /* Le rendu est forcé avant de rendre leurs transitions aux styles. */
        void scene.offsetWidth;
        scene.classList.remove('sans-transition');
        return;
      }
      if (avant !== m) basculer();
      /* En quittant l'agent de support, le jour revient : l'horloge se
         remonte jusqu'à l'heure de la semaine de travail. */
      puceHorloge.classList.toggle('est-nuit', m === 'agent');
      if (avant === 'agent' && m !== 'agent') {
        nuit = null;
        remonter(JOURS[jour], minutes, 760);
      }
      /* Les fenêtres arrivent par une transition : une boucle dont les
         trajets partent d'elles attend qu'elles soient en place. Entre la
         copie et l'automatisation rien ne bouge, l'attente est courte. */
      const deplace = avant === 'agent' || avant === 'tableau';
      if (m === 'auto') {
        veiller(boucleAuto(jeton, deplace ? 900 : 360), 'automatisation');
      } else if (m === 'agent') {
        veiller(boucleAgent(jeton, 760), 'agent IA');
      } else if (m === 'tableau') {
        veiller(boucleTableau(jeton, 620), 'dashboard');
      } else {
        viderLignes();
        elGestes.textContent = String(gestes);
        if (attente < ATTENTE_DEPART) {
          compter(elAttente, attente, ATTENTE_DEPART, 700, jeton);
          attente = ATTENTE_DEPART;
        } else {
          elAttente.textContent = String(attente);
        }
        blocAttente.classList.remove('est-vide');
        veiller(boucleMain(jeton, deplace ? 800 : 0), 'à la main');
        veiller(arrivees(jeton), 'arrivées');
      }
    };

    /* L'horloge. Elle a deux régimes. Le jour, c'est la semaine de travail,
       de 9 h à 18 h : à la main la journée file, au deuxième écran c'est la
       semaine, et dès que la machine travaille elle reprend un pas
       tranquille. `nuit` est l'heure de l'agent de support : tant qu'elle
       est posée, c'est elle qu'on lit et la semaine attend. */
    let nuit: { jour: string; minutes: number } | null = null;
    let minuteAffichee = -1;
    let affiche = minutes;
    let dernier = performance.now();
    let horloge = 0;
    const afficher = (nom: string, min: number) => {
      affiche = min;
      if (elJour.textContent !== nom) elJour.textContent = nom;
      aigMin.setAttribute('transform', `rotate(${(min % 60) * 6})`);
      aigH.setAttribute('transform', `rotate(${(min / 60) * 30})`);
      const m = Math.floor(min);
      if (m !== minuteAffichee) {
        minuteAffichee = m;
        elHeure.textContent = `${Math.floor(m / 60) % 24}\u00a0h\u00a0${String(m % 60).padStart(2, '0')}`;
      }
    };

    /* Remonter l'horloge : les aiguilles filent en avant jusqu'à l'heure
       voulue, et le jour change à mi-course. C'est ce qui dit qu'on a changé
       de moment. Tant qu'elle dure, l'affichage ordinaire lui laisse la
       main ; une remontée plus récente la remplace. */
    let remontee = 0;
    let enRemontee = false;
    const remonter = (nom: string, cible: number, duree: number) => {
      const tour = ++remontee;
      enRemontee = true;
      const de = affiche % 1440;
      const ancien = elJour.textContent ?? nom;
      let vers = cible;
      while (vers < de + 180) vers += 1440;
      const debut = instant();
      const pas = (t: number) => {
        if (tour !== remontee) return;
        const a = Math.min(1, Math.max(0, (t - debut) / duree));
        const e = a < 0.5 ? 4 * a * a * a : 1 - Math.pow(-2 * a + 2, 3) / 2;
        if (a < 1) {
          afficher(a < 0.5 ? ancien : nom, de + (vers - de) * e);
          image(pas);
        } else {
          enRemontee = false;
          afficher(nom, cible);
        }
      };
      image(pas);
    };

    /* L'heure de l'agent de support. Déjà à cette heure-là, on n'y touche
       pas : la remonter ferait faire un tour complet aux aiguilles. */
    const fixerNuit = (nom: string, min: number) => {
      if (nuit && nuit.jour === nom && Math.abs(nuit.minutes - min) < 30) return;
      nuit = { jour: nom, minutes: min };
      remonter(nom, min, 760);
    };

    /* L'horloge ne demande une image que si la scène est à l'écran : hors
       champ, plus rien ne réveille la page. `planifier` la relance. */
    const planifier = () => {
      /* En mouvement réduit l'horloge reste à l'heure de son image fixe :
         c'était le seul élément de la scène à bouger encore. */
      if (reduit) return;
      if (!horloge && aLEcran()) horloge = requestAnimationFrame(battre);
    };
    const battre = (t: number) => {
      horloge = 0;
      /* Borné des deux côtés : l'heure d'une image peut précéder celle du
         montage, et un long arrêt ne doit pas faire sauter les aiguilles. */
      const dt = Math.max(0, Math.min(80, t - dernier));
      dernier = t;
      if (aLEcran()) {
        if (nuit) {
          nuit.minutes += (0.15 * dt) / 1000;
          if (!enRemontee) afficher(nuit.jour, nuit.minutes);
        } else {
          const cible = mode !== 'main' ? 0.7 : acte === 2 ? 52 : 5;
          vitesse += (cible - vitesse) * 0.035;
          minutes += (vitesse * dt) / 1000;
          if (minutes >= 18 * 60) {
            minutes = 9 * 60;
            jour = (jour + 1) % JOURS.length;
          }
          if (!enRemontee) afficher(JOURS[jour], minutes);
        }
      }
      planifier();
    };

    /* ── La régie ──
       En une colonne, elle joue une suite de temps, en boucle : les deux
       temps du travail à la main pour la première vue, les trois réponses
       pour la seconde. Seul le temps passé à l'écran compte ; hors champ,
       elle reste sur le temps en cours et s'endort. Un jeton à elle
       (`deroule`) l'arrête, comme `jeton` arrête les boucles. */
    let deroule = 0;
    async function derouler(j: number, temps: Temps[]) {
      let i = 0;
      while (j === deroule) {
        const t = temps[i];
        acte = t.acte;
        scene.dataset.acte = String(t.acte);
        changerMode(t.mode);
        let ecoule = 0;
        let repere = instant();
        for (;;) {
          await pause(150);
          if (j !== deroule) return;
          const maintenant = instant();
          const vu = aLEcran();
          if (vu) ecoule += Math.min(300, maintenant - repere);
          repere = maintenant;
          if (!vu) {
            await attendreEcran();
            if (j !== deroule) return;
            repere = instant();
            continue;
          }
          if (ecoule >= t.plafond) break;
          if (acheve && ecoule >= t.mini && maintenant - acheve >= t.tenue) break;
        }
        i = (i + 1) % temps.length;
      }
    }

    /* Ce que le visiteur a choisi au bouton. Le récit ne le contredit pas
       tant qu'il n'a pas de raison de reprendre la main : un autre palier de
       défilement sur ordinateur, la vue qui sort de l'écran partout. */
    let choix: Mode | null = null;
    /* Cette vue a écrit la ligne d'annonce : c'est à elle de l'effacer. */
    let annoncee = false;
    const taire = () => {
      if (annonce && annoncee) annonce.textContent = '';
      annoncee = false;
    };

    /* ── Sur ordinateur : les paliers du défilement ──
       Le palier est le rang, à partir de 1, de ce que le défilement donne à
       voir dans `PALIERS` : la première phrase, la deuxième, puis les trois
       réponses de la troisième. Zéro tant que la page n'a pas été lue. */
    let palier = 0;
    const fixerPalier = (p: number) => {
      if (p === palier) return;
      palier = p;
      acte = Math.min(p, 3);
      scene.dataset.acte = String(acte);
      /* Le lecteur a défilé jusqu'à un autre palier : son choix au bouton ne
         tient plus, le défilement reprend la main. */
      choix = null;
      taire();
      changerMode(PALIERS[p - 1]);
    };

    /* Quelle phrase est à l'écran : la dernière dont le titre a passé les
       quatre cinquièmes de la fenêtre. La troisième reste en place pendant
       que sa course défile derrière elle : le bas du texte ne bouge plus, le
       haut de la course remonte, et l'écart entre les deux, rapporté à la
       course, dit laquelle des trois réponses montrer. En remontant la page,
       les mêmes seuils rejouent les paliers dans l'ordre inverse. */
    let attenteImage = false;
    const situer = () => {
      attenteImage = false;
      if (role !== 'recit' || colonne.matches) return;
      let n = 1;
      for (const titre of titres) {
        if (titre.el.getBoundingClientRect().top < window.innerHeight * 0.8) n = titre.n;
      }
      let p = Math.min(n, 3);
      if (p === 3 && corpsLong && course && course.offsetHeight) {
        const part =
          (corpsLong.getBoundingClientRect().bottom - course.getBoundingClientRect().top) / course.offsetHeight;
        if (part >= SEUILS.tableau) p = 5;
        else if (part >= SEUILS.agent) p = 4;
      }
      fixerPalier(p);
    };
    const surDefilement = () => {
      if (attenteImage) return;
      attenteImage = true;
      requestAnimationFrame(situer);
    };

    /* Le récit reprend la main sur un choix fait au bouton. */
    const reprendre = () => {
      choix = null;
      taire();
      if (!colonne.matches) {
        if (role === 'recit' && palier) changerMode(PALIERS[palier - 1]);
        return;
      }
      /* En mouvement réduit il n'y a pas de régie : l'image choisie reste. */
      if (reduit) return;
      if (role === 'reponses') veiller(derouler(++deroule, REPONSES), 'réponses');
      else veiller(derouler(++deroule, A_LA_MAIN), 'à la main');
    };

    /* ── La mise en route ──
       Rejouée quand la mise en page change de régime (rotation, fenêtre
       redimensionnée) : on repart du récit. */
    const regler = () => {
      deroule += 1;
      choix = null;
      taire();
      if (role === 'reponses') {
        /* Sur ordinateur cette vue est masquée : son moteur s'arrête, et la
           prochaine mise en route reprendra son mode au début. */
        if (!colonne.matches) {
          jeton += 1;
          tourne = false;
          return;
        }
        if (reduit) changerMode(mode);
        else veiller(derouler(deroule, REPONSES), 'réponses');
        direReponse();
        return;
      }
      /* Zéro : la phrase à l'écran sera relue même si son palier n'a pas
         changé, sans quoi la scène resterait sur le temps où l'autre régime
         l'avait laissée. */
      palier = 0;
      if (!colonne.matches) {
        situer();
        direReponse();
      } else if (reduit) {
        /* Une colonne, sans mouvement : l'image du travail à la main. */
        acte = 1;
        scene.dataset.acte = '1';
        changerMode('main');
      } else {
        veiller(derouler(deroule, A_LA_MAIN), 'à la main');
      }
    };

    boutons.forEach((b) =>
      b.addEventListener('click', () => {
        const voulu = b.dataset.modeBouton;
        if (!estMode(voulu)) return;
        /* Un appui arrête la régie : la scène reste sur ce qu'on a choisi,
           jusqu'à ce que le récit ait une raison de reprendre la main. */
        choix = voulu;
        deroule += 1;
        changerMode(voulu);
        /* La scène est muette pour un lecteur d'écran : le bouton dit ce
           qu'elle montre. Seulement au clic, pas quand le récit avance seul. */
        if (annonce) {
          annonce.textContent = ANNONCES[voulu];
          annoncee = true;
        }
      }),
    );
    /* Les boutons sortent masqués du HTML : sans ce script ils seraient là,
       et inertes. */
    scene.querySelector<HTMLElement>('[data-mode-groupe]')?.removeAttribute('hidden');

    /* Le plan des fenêtres s'incline un peu vers le pointeur. */
    if (!reduit && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      cadre.addEventListener('pointermove', (e) => {
        if (arretee) return;
        const r = cadre.getBoundingClientRect();
        monde.style.setProperty('--ix', `${(((e.clientX - r.left) / r.width) * 2 - 1) * 5}deg`);
        monde.style.setProperty('--iy', `${(((e.clientY - r.top) / r.height) * 2 - 1) * -4}deg`);
      });
      cadre.addEventListener('pointerleave', () => {
        monde.style.removeProperty('--ix');
        monde.style.removeProperty('--iy');
      });
    }

    new ResizeObserver(ajuster).observe(cadre);
    ajuster();
    poser({ x: monde.offsetWidth * 0.55, y: monde.offsetHeight * 0.3 });

    /* La vue est-elle à l'écran ? Hors champ (ou onglet masqué), ses boucles
       s'endorment et son horloge s'arrête ; au retour elles reprennent où
       elles en étaient. Une vue masquée par les styles n'y est jamais. */
    const reveiller = () => {
      if (!aLEcran()) return;
      const liste = endormies;
      endormies = [];
      liste.forEach((ok) => ok());
      planifier();
    };
    new IntersectionObserver((entrees) => {
      visible = entrees[entrees.length - 1].isIntersecting;
      if (visible) reveiller();
      /* La vue est sortie de l'écran : le récit reprend la main, pour la
         retrouver au bon temps quand on y reviendra. */
      else if (choix) reprendre();
    }).observe(cadre);
    document.addEventListener('visibilitychange', reveiller);

    /* ── La commande d'arrêt ──
       Une scène qui boucle sans fin à côté d'un texte doit pouvoir être
       arrêtée, au clavier comme au doigt. Le bouton est dans le balisage,
       hors du plan (qui est `aria-hidden`), et sort masqué : il n'est montré
       que s'il y a quelque chose à arrêter, donc pas en mouvement réduit.
       L'arrêt tient tant que le visiteur ne le relève pas.
       `aria-pressed` porte l'état, le libellé reste le même : c'est la
       convention d'un bouton à bascule (comme le défilé des logos). */
    const suspendre = () => {
      arretDepuis = performance.now();
      arretee = true;
      const geler = () => {
        if (!arretee) return;
        for (const a of toutes()) if (a.playState === 'running') a.pause();
      };
      geler();
      /* Une transition née du dernier geste, juste après l'arrêt, ne serait
         pas dans la liste : deux images de plus pour la rattraper. */
      requestAnimationFrame(() => {
        geler();
        requestAnimationFrame(geler);
      });
    };
    const relancer = () => {
      gel += performance.now() - arretDepuis;
      arretee = false;
      if (fige) {
        /* Le mode a changé pendant l'arrêt : il repart de son début. */
        fige = false;
        tourne = false;
        changerMode(mode);
      } else {
        for (const a of toutes()) {
          if (a.playState !== 'paused') continue;
          /* Suspendue sur sa dernière image, elle se termine : `play()` la
             rejouerait depuis le début. */
          const fin = Number(a.effect?.getComputedTiming().endTime);
          if (Number.isFinite(fin) && Number(a.currentTime) >= fin) a.finish();
          else a.play();
        }
      }
      reveiller();
    };
    const commande = scene.querySelector<HTMLButtonElement>('[data-pause]');
    if (commande && !reduit) {
      commande.hidden = false;
      commande.addEventListener('click', () => {
        if (arretee) relancer();
        else suspendre();
        commande.setAttribute('aria-pressed', String(arretee));
      });
    }

    if (role === 'recit') {
      window.addEventListener('scroll', surDefilement, { passive: true });
      window.addEventListener('resize', surDefilement, { passive: true });
    }
    /* `addEventListener` manque sur cet objet avant Safari 14 : sans lui, la
       scène garde simplement le régime de son chargement. */
    colonne.addEventListener?.('change', regler);

    regler();
  }
</script>
