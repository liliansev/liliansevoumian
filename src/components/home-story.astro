---
/*
 * home-story — le récit qui suit la première phrase de l'accueil.
 *
 * Le premier écran (`home-hero`) présente Lilian. Ici, la page prend
 * position, dans l'ordre qu'il a donné : vous avez la sensation de perdre
 * votre temps, vous avez raison ; voilà pourquoi ; voilà pourquoi automatiser.
 * La suite de la page répond à « pourquoi moi ».
 *
 * À côté du texte, une scène reste en place pendant qu'on défile. C'est un
 * panneau éclairé, dans l'esprit des sites que Lilian a désignés (Novu,
 * Vimcal) : une lueur pêche et une lueur froide, du grain, et deux fenêtres
 * d'interface posées en perspective, dessinées finement. À gauche le bon de
 * commande en PDF, à droite la facture à remplir. Un curseur recopie les
 * lignes une à une pendant que l'horloge file et que les commandes en attente
 * s'accumulent.
 *
 * Au troisième écran, la scène ne donne pas une réponse mais trois, à la
 * suite et en boucle, chacune sur un sujet à elle : elle sert d'ouverture aux
 * métiers détaillés plus bas dans la page, sans les répéter.
 *   1. Automatisation : le bon de commande devient une facture. Le surligneur
 *      lit la page d'un trait, les lignes partent seules, le total se
 *      calcule, la facture est émise, la file d'attente se vide et le panneau
 *      s'éclaire. C'est le seul endroit de la page où il est question de
 *      commande et de facture.
 *   2. Agent IA : le support client. Le bon de commande et la facture sortent,
 *      l'horloge file jusqu'à un dimanche, 23 h 47, et une conversation
 *      s'ouvre. Un client pose sa question, l'agent va chercher la réponse
 *      dans la base de connaissances (l'article trouvé s'allume, une bande
 *      pêche en part et vient se poser dans la bulle), répond et cite sa
 *      source. Puis il est 3 h 12, un autre client écrit, et c'est un outil
 *      connecté, le CRM, que l'agent interroge. Il répond jour et nuit.
 *   3. Dashboard : le suivi de projets d'une équipe. Le jour revient, un
 *      tableau de bord se lève, ses cartes se distribuent dans trois colonnes
 *      (à faire, en cours, livré), les indicateurs comptent, puis une carte
 *      avance d'une colonne à la suivante et les indicateurs suivent.
 * D'une réponse à l'autre, le plan change d'inclinaison, les fenêtres qui
 * partent reculent dans le flou et l'horloge se remonte toute seule : c'est
 * elle qui dit qu'on a changé d'heure, donc de situation.
 *
 * La copie à la main et l'automatisation rejouent un cas réel, celui
 * d'Humble+. Les références, quantités et montants sont une illustration, pas
 * une donnée client ; le seul résultat annoncé, « plus aucune ressaisie »,
 * vient du cas publié. L'agent de support et le suivi de projets sont des
 * exemples : prénoms, questions, articles, outils et noms de projets sont
 * inventés pour la scène, sans marque ni client.
 *
 * Sur téléphone et tablette, la scène n'est pas fixée : elle est posée après
 * la première phrase et déroule seule ses temps (à la main, la semaine qui
 * file, puis les trois réponses), pour que le défilement reste celui d'une
 * page ordinaire.
 *
 * Sans script, le texte est lisible et la scène est une image fixe, sans ses
 * boutons. En mouvement réduit, elle montre des images fixes : celle du
 * travail à la main, puis celle de l'automatisation quand la troisième phrase
 * arrive ; les boutons passent d'une image à l'autre, sans animation. Hors
 * écran ou onglet masqué, les boucles et l'horloge s'arrêtent.
 *
 * Le bouton a le dernier mot : une fois qu'on a choisi une façon de faire, ni
 * le défilement ni la ronde des réponses ne la changent tant que la scène
 * reste à l'écran.
 */
import LinkCTA from './LinkCTA.astro';

interface Segment {
  t: string;
  mark?: boolean;
}

const actes: { id: string; titre: Segment[]; suite: string }[] = [
  {
    id: 'constat',
    titre: [{ t: 'Vous avez la sensation de perdre votre temps\u00a0?' }, { t: 'Vous avez raison.', mark: true }],
    suite:
      'Regardez : une commande recopiée à la main, d’un outil à l’autre, ligne après ligne, pendant que l’horloge tourne. Quelqu’un fait sûrement ça chez vous, en ce moment même.',
  },
  {
    id: 'pourquoi',
    titre: [{ t: 'Personne n’a monté sa boîte pour faire' }, { t: 'du copier-coller.', mark: true }],
    suite:
      'Et pourtant. Copier, coller, vérifier, relancer : le même geste cent fois, fait par des gens payés pour réfléchir. Chaque geste est court, personne ne le compte, et la semaine y passe.',
  },
  {
    id: 'automatiser',
    titre: [{ t: 'Ce qui se répète n’a pas' }, { t: 'besoin de vous.', mark: true }],
    suite:
      'Une automatisation fait passer l’information d’un outil à l’autre, un agent IA répond à vos clients jour et nuit, un tableau de bord montre où en est chaque projet. Chez Humble+, il n’y a plus aucune ressaisie entre le bon de commande et la facture.',
  },
];

/* Chaque mot reçoit son rang dans la phrase : c'est lui qui règle son retard
   d'apparition. Le fragment surligné compte comme les autres, il arrive en
   dernier et c'est la pastille qui l'écrit. */
const actesRendus = actes.map((acte) => {
  let rang = 0;
  const titre = acte.titre.map((segment) => ({
    mark: segment.mark,
    mots: segment.t.split(' ').map((mot) => ({ mot, rang: rang++ })),
  }));
  return { ...acte, titre, total: rang };
});

/* Les lignes du bon de commande. Références, quantités et montants inventés
   pour la scène ; la désignation est une barre, pas un nom de produit. `l`
   est la longueur de cette barre, en pour cent ; `montant` sert au total. */
const lignes = [
  { ref: 'A-2041', qte: '12', prix: '84,00', montant: 84, l: 78 },
  { ref: 'A-2044', qte: '6', prix: '45,60', montant: 45.6, l: 56 },
  { ref: 'B-1180', qte: '24', prix: '132,00', montant: 132, l: 88 },
  { ref: 'B-1192', qte: '3', prix: '27,90', montant: 27.9, l: 48 },
  { ref: 'C-0307', qte: '10', prix: '59,00', montant: 59, l: 66 },
];

/* L'agent de support, deuxième réponse : deux échanges, à deux heures où
   personne ne travaille (`minutes` est l'heure, en minutes depuis minuit).
   `origine` dit où l'agent va chercher : dans la base de connaissances
   (`requete` est ce qu'il y tape, `source` l'article qu'il trouve) ou dans un
   outil connecté (`source` est alors son nom). Prénoms, questions, réponses,
   articles et outils sont inventés pour la scène. */
const echanges = [
  {
    jour: 'Dimanche',
    heure: '23\u00a0h\u00a047',
    minutes: 23 * 60 + 47,
    prenom: 'Camille',
    question: 'Comment exporter mes données\u00a0?',
    cherche: 'Consulte la base de connaissances',
    reponse: 'Dans Réglages\u00a0›\u00a0Export\u00a0: choisissez le format, le fichier arrive par e-mail.',
    source: 'Exporter ses données',
    origine: 'base',
    requete: 'exporter mes données',
  },
  {
    jour: 'Lundi',
    heure: '3\u00a0h\u00a012',
    minutes: 3 * 60 + 12,
    prenom: 'Hugo',
    /* Un outil connecté, et non l'agenda : la réservation et son agenda
       appartiennent à la scène du bloc Automatisation, plus bas. */
    question: 'Où en est ma demande de la semaine dernière\u00a0?',
    cherche: 'Consulte le CRM',
    reponse: 'Elle est en cours de traitement\u00a0: vous serez prévenu dès qu’elle est réglée.',
    source: 'CRM',
    origine: 'crm',
    requete: '',
  },
];
const articles = ['Créer un compte', 'Inviter un collègue', 'Exporter ses données', 'Changer d’offre'];
/* `trouve` est ce que l'outil répond quand l'agent l'interroge. */
const outils = [
  { id: 'crm', nom: 'CRM', trouve: 'Demande n°\u00a0284\u00a0: en cours', trace: 'M8 8.2a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3.4 13.2c.6-2.2 2.3-3.3 4.6-3.3s4 1.1 4.6 3.3' },
  { id: 'messagerie', nom: 'Messagerie', trouve: '', trace: 'M2.8 4.3h10.4v7.6H2.8zM3.1 4.8L8 8.9l4.9-4.1' },
  { id: 'agenda', nom: 'Agenda', trouve: '', trace: 'M3 4.5h10v8.5H3zM3 7.2h10M5.6 3v2.6M10.4 3v2.6' },
];

/* Le suivi de projets, troisième réponse : trois colonnes et leurs cartes.
   `p` est l'avancement du projet, en pour cent. Les noms sont inventés ; sur
   le plan étroit ils deviennent des barres, comme les désignations du bon. */
const piles = [
  { id: 'afaire', nom: 'À faire' },
  { id: 'cours', nom: 'En cours' },
  { id: 'livre', nom: 'Livré' },
];
const projets = [
  { nom: 'Formulaire de devis', etat: 'afaire', p: 0 },
  { nom: 'Espace membres', etat: 'afaire', p: 0 },
  { nom: 'Catalogue en ligne', etat: 'afaire', p: 0 },
  { nom: 'Portail client', etat: 'cours', p: 30 },
  { nom: 'Site vitrine', etat: 'cours', p: 45 },
  { nom: 'Planning d’équipe', etat: 'cours', p: 60 },
  { nom: 'Intranet', etat: 'cours', p: 75 },
  { nom: 'Application terrain', etat: 'cours', p: 90 },
  { nom: 'Annuaire interne', etat: 'livre', p: 100 },
  { nom: 'Page de recrutement', etat: 'livre', p: 100 },
  { nom: 'Demandes d’accès', etat: 'livre', p: 100 },
];
const compte = (etat: string) => projets.filter((projet) => projet.etat === etat).length;
---

<section id="histoire" data-section data-story class="story relative px-[var(--spacing-section-x)]">
  <div class="story__grille relative mx-auto max-w-[1200px]">
    {actesRendus.map((acte, index) => (
      <>
        <div id={acte.id} class="acte reveal" data-acte={index + 1} style={`--mots: ${acte.total}`}>
          <h2 class="acte__titre">
            {acte.titre.map((segment) => {
              const mots = segment.mots.map(({ mot, rang }) => (
                <>
                  <span class="mot" style={`--i: ${rang}`}>{mot}</span>{' '}
                </>
              ));
              return segment.mark ? <mark>{mots}</mark> : mots;
            })}
          </h2>
          <p class="acte__suite">{acte.suite}</p>

          {index === 2 && (
            <div class="acte__preuve">
              <LinkCTA href="/cas-clients/humble-plus">Lire le cas Humble+</LinkCTA>
            </div>
          )}
        </div>

        {index === 0 && (
          <div class="story__scene">
            <div class="scene" data-scene data-mode="main" data-acte="1">
              <div class="scene__boite">
                <span class="repere repere--hg" aria-hidden="true"></span>
                <span class="repere repere--hd" aria-hidden="true"></span>
                <span class="repere repere--bg" aria-hidden="true"></span>
                <span class="repere repere--bd" aria-hidden="true"></span>
                <div class="scene__cadre">
                <div class="scene__plan" aria-hidden="true">
                  <div class="puces">
                    <span class="puce" data-horloge>
                      <svg class="puce__horloge" viewBox="-10 -10 20 20">
                        <circle r="8.2" />
                        <line x1="0" y1="0" x2="0" y2="-4" data-aiguille-h transform="rotate(270)" />
                        <line class="puce__minutes" x1="0" y1="0" x2="0" y2="-6.2" data-aiguille-min />
                      </svg>
                      <span data-jour>Lundi</span>
                      <b data-heure>9 h 00</b>
                      <svg class="puce__lune" viewBox="0 0 16 16"><path d="M12.8 9.6A5.4 5.4 0 0 1 6.4 3.2a5.4 5.4 0 1 0 6.4 6.4z" /></svg>
                    </span>
                    <span class="puce" data-attente-bloc>
                      <svg viewBox="0 0 16 16"><path d="M3 5.5l5-2.5 5 2.5-5 2.5-5-2.5zM3 8l5 2.5L13 8M3 10.5L8 13l5-2.5" /></svg>
                      <span class="puce__nom">En attente</span>
                      <b data-attente>23</b>
                    </span>
                    <span class="puce">
                      <svg viewBox="0 0 16 16"><path d="M4 2.5l8.5 5-3.8 1L7 12.5 4 2.5z" /></svg>
                      <span class="puce__nom">Gestes refaits</span>
                      <b data-gestes>0</b>
                    </span>
                  </div>

                  <div class="monde" data-monde>
                    <svg class="traces" data-traces></svg>

                    <div class="fenetre fenetre--pdf">
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--pdf">PDF</span>
                        <span class="fenetre__nom">bon-de-commande-0412.pdf</span>
                        <span class="fenetre__info">1 / 1</span>
                      </div>
                      <div class="fenetre__corps">
                        <div class="page" data-doc>
                          <div class="page__tete">
                            <b>Bon de commande</b>
                            <span>N° BC-0412</span>
                          </div>
                          <div class="page__bloc"><i></i><i></i><i></i></div>
                          <div class="colonnes">
                            <span>Réf.</span><span>Désignation</span><span>Qté</span><span>Total HT</span>
                          </div>
                          <ul>
                            {lignes.map((ligne) => (
                              <li class="doc__ligne" data-ligne-doc data-valeur={`${ligne.ref} · ${ligne.qte} · ${ligne.prix} €`}>
                                <span class="ref">{ligne.ref}</span>
                                <i style={`width: ${ligne.l}%`}></i>
                                <span>{ligne.qte}</span>
                                <span>{ligne.prix}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>

                    <div class="fenetre fenetre--app" data-facture>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--app">
                          <svg viewBox="0 0 16 16"><path d="M4 2.5h8v11l-2-1.2-2 1.2-2-1.2-2 1.2v-11zM6 6h4M6 8.5h4" /></svg>
                        </span>
                        <span class="fenetre__nom">Nouvelle facture</span>
                        <span class="facture__etat" data-etat="brouillon">Brouillon</span>
                      </div>
                      <div class="fenetre__corps">
                        <div class="champ">
                          <span class="champ__nom">Client</span>
                          <span class="champ__valeur"><em></em><i></i></span>
                        </div>
                        <div class="colonnes colonnes--app">
                          <span>Réf.</span><span>Désignation</span><span>Qté</span><span>Total HT</span><span></span>
                        </div>
                        <ul>
                          {lignes.map((ligne) => (
                            <li class="facture__ligne" data-ligne-facture data-montant={ligne.montant} style={`--l: ${ligne.l}%`}>
                              <span class="ref">{ligne.ref}</span>
                              <i></i>
                              <span>{ligne.qte}</span>
                              <span>{ligne.prix}</span>
                              <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                            </li>
                          ))}
                        </ul>
                        <div class="pied">
                          <span>Total HT</span>
                          <b data-total>0,00 €</b>
                          <span class="pied__bouton">Émettre</span>
                        </div>
                      </div>
                    </div>

                    <div class="fenetre fenetre--chat" data-chat>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--app">
                          <svg viewBox="0 0 16 16"><path d="M3 3.4h10v7H7.4l-3 2.4v-2.4H3v-7z" /></svg>
                        </span>
                        <span class="fenetre__nom">Agent de support</span>
                        <span class="chat__etat"><i></i>En ligne · 24 h/24</span>
                      </div>
                      <div class="fenetre__corps">
                        <div class="conversation" data-conversation>
                          {echanges.map((echange, index) => (
                            <div
                              class:list={['echange', index === 0 && 'est-actif']}
                              data-echange
                              data-jour={echange.jour}
                              data-minutes={echange.minutes}
                              data-origine={echange.origine}
                              data-requete={echange.requete}
                              data-reponse={echange.reponse}
                            >
                              <span class="echange__quand">{echange.prenom} · {echange.jour.toLowerCase()}, {echange.heure}</span>
                              <span class="bulle bulle--client">{echange.question}</span>
                              <span class="bulle bulle--agent" data-bulle>
                                <span class="bulle__cherche"><span class="points"><i></i><i></i><i></i></span>{echange.cherche}</span>
                                <span class="bulle__texte" data-texte>{echange.reponse}</span>
                              </span>
                              <span class="source">Source&nbsp;: <b>{echange.source}</b></span>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>

                    <div class="fenetre fenetre--base" data-base>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--app">
                          <svg viewBox="0 0 16 16"><path d="M3.6 2.8h6.6a2 2 0 0 1 2 2v8.4H5.6a2 2 0 0 1-2-2V2.8zM6 6h3.6M6 8.6h3.6" /></svg>
                        </span>
                        <span class="fenetre__nom">Base de connaissances</span>
                      </div>
                      <div class="fenetre__corps">
                        <div class="recherche">
                          <svg viewBox="0 0 16 16"><path d="M7 11.4a4.4 4.4 0 1 0 0-8.8 4.4 4.4 0 0 0 0 8.8zM10.3 10.3l3 3" /></svg>
                          <span data-recherche></span>
                        </div>
                        <ul class="articles">
                          {articles.map((titre) => (
                            <li class="article" data-article data-trouve={titre === echanges[0].source ? '' : undefined}>
                              <svg viewBox="0 0 16 16"><path d="M4.4 2.6h4.8l2.4 2.4v8.4H4.4V2.6zM9.2 2.6V5h2.4" /></svg>
                              <span>{titre}</span>
                              <svg class="coche" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    <div class="fenetre fenetre--outils" data-outils>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--app">
                          <svg viewBox="0 0 16 16"><path d="M6.4 9.6l3.2-3.2M5 8L3.9 9.1a2.1 2.1 0 0 0 3 3L8 11M8 5l1.1-1.1a2.1 2.1 0 0 1 3 3L11 8" /></svg>
                        </span>
                        <span class="fenetre__nom">Outils connectés</span>
                      </div>
                      <div class="fenetre__corps">
                        <ul class="outils">
                          {outils.map((outil) => (
                            <li class="outil" data-outil={outil.id} data-trouve={outil.trouve}>
                              <svg viewBox="0 0 16 16"><path d={outil.trace} /></svg>
                              <span>{outil.nom}</span>
                              <span class="outil__etat" data-outil-etat>Connecté</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    <div class="fenetre fenetre--tableau" data-tableau>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--app">
                          <svg viewBox="0 0 16 16"><path d="M3 3h2.6v8H3V3zM6.7 3h2.6v10H6.7V3zM10.4 3H13v6h-2.6V3z" /></svg>
                        </span>
                        <span class="fenetre__nom">Suivi des projets</span>
                        <span class="fenetre__info">Cette semaine</span>
                      </div>
                      <div class="fenetre__corps">
                        <div class="indicateurs">
                          <span class="indicateur">
                            <span class="indicateur__nom">En cours</span>
                            <b data-compte="cours" data-indicateur>{compte('cours')}</b>
                          </span>
                          <span class="indicateur">
                            <span class="indicateur__nom">Livrés<span class="mot-long"> cette semaine</span></span>
                            <b data-compte="livre" data-indicateur>{compte('livre')}</b>
                          </span>
                          <span class="indicateur indicateur--zero">
                            <span class="indicateur__nom">En retard</span>
                            <b>0</b>
                          </span>
                        </div>
                        <div class="piles">
                          {piles.map((pile) => (
                            <div class="pile">
                              <span class="pile__tete">{pile.nom}<b data-compte={pile.id}>{compte(pile.id)}</b></span>
                              <ul data-pile={pile.id}>
                                {projets.filter((projet) => projet.etat === pile.id).map((projet) => (
                                  <li class="carte" data-carte data-etat={projet.etat} style={`--p: ${projet.p}`}>
                                    <i class="carte__puce"></i>
                                    <span class="carte__nom">{projet.nom}</span>
                                    <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                                    <u class="carte__avance"></u>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>

                    <div class="bandes">
                      {lignes.map(() => <span class="bande"></span>)}
                    </div>

                    <div class="curseur" data-curseur>
                      <svg viewBox="0 0 24 24"><path d="M5 3l14 8.2-6.2 1.6L9.6 19 5 3z" /></svg>
                      <span class="curseur__valeur" data-porte></span>
                    </div>
                  </div>
                </div>
                </div>
              </div>

              <div class="scene__mode" role="group" aria-label="La scène, en quatre temps" hidden data-mode-groupe>
                <button type="button" data-mode-bouton="main" aria-pressed="true">À la main</button>
                <button type="button" data-mode-bouton="auto" aria-pressed="false" aria-label="Automatisation">
                  <span class="mot-long">Automatisation</span><span class="mot-court">Auto</span>
                </button>
                <button type="button" data-mode-bouton="agent" aria-pressed="false">Agent IA</button>
                <button type="button" data-mode-bouton="tableau" aria-pressed="false">Dashboard</button>
              </div>
              <p class="sr-only" aria-live="polite" data-annonce></p>
            </div>
          </div>
        )}
      </>
    ))}
  </div>
</section>

<style>
  .story {
    --trait: color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-bottom: 1px solid var(--trait);
    background: var(--color-night-deep);
  }

  /* Le texte défile à gauche, un écran par phrase ; la scène reste en place à
     droite sur toute la hauteur du récit. Les deux filets verticaux de la
     page longent la colonne ; ici, un filet horizontal sépare deux phrases,
     marqué d'une croix à son extrémité. */
  .story__grille {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    column-gap: clamp(2.5rem, 4vw, 4rem);
  }

  .acte {
    position: relative;
    grid-column: 1;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: clamp(1.25rem, 2vw, 1.75rem);
    min-height: 100svh;
    padding-block: 6rem;
  }

  .acte + .story__scene + .acte::before,
  .acte + .acte::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: calc(-1 * clamp(1rem, 2.2vw, 2rem));
    height: 1px;
    background: var(--trait);
  }

  .acte + .story__scene + .acte::after,
  .acte + .acte::after {
    content: '';
    position: absolute;
    top: -5px;
    left: calc(-1 * clamp(1rem, 2.2vw, 2rem) - 5px);
    width: 11px;
    height: 11px;
    background:
      linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 100% 1px no-repeat,
      linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 1px 100% no-repeat;
  }

  .acte__titre {
    max-width: 13ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-story);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  /* Le fragment surligné est une pastille, comme la réponse du premier
     écran : la même bande pêche que partout ailleurs, sans son inclinaison et
     arrondie jusqu'au bout. */
  .acte__titre mark {
    --angle: 0deg;
    --radius-bande: 9999px;
    display: inline-block;
    padding: 0.02em 0.36em 0.08em;
    margin: 0.14em 0 0;
  }

  .acte__titre mark::before {
    inset: 0;
  }

  .mot {
    display: inline-block;
  }

  .acte__suite {
    max-width: 40ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.5;
  }

  /* ── Les mots se posent ──
     Chaque phrase attend d'entrer à l'écran (le `.reveal` du site), puis ses
     mots arrivent un par un. Le fragment surligné vient en dernier. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-ready) .acte.reveal .mot {
      transition:
        opacity 620ms var(--ease-out-expo),
        transform 760ms var(--ease-out-expo),
        filter 620ms var(--ease-out-expo);
      transition-delay: calc(var(--i) * 50ms + 80ms);
    }

    :global(.js-ready) .acte.reveal:not(.is-visible) .mot {
      opacity: 0;
      transform: translateY(0.45em);
      filter: blur(8px);
      transition-delay: 0ms;
    }

    :global(.js-ready) .acte.reveal.is-visible mark {
      transition-delay: calc(var(--mots) * 50ms - 60ms);
    }
  }

  /* ── La scène ── */
  .story__scene {
    grid-column: 2;
    grid-row: 1 / span 3;
    position: sticky;
    top: 64px;
    align-self: start;
    display: grid;
    align-content: center;
    justify-items: center;
    height: calc(100svh - 64px);
  }

  .scene {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    width: min(100%, calc((100svh - 64px - 8rem) * 680 / 560));
  }

  /* La boîte porte les repères d'angle, hors du panneau : quatre petites
     équerres, comme les traits de coupe d'un plan. */
  .scene__boite {
    position: relative;
    width: 100%;
  }

  .repere {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--color-ink-low);
    pointer-events: none;
  }

  .repere--hg { top: -7px; left: -7px; border-top-width: 1px; border-left-width: 1px; }
  .repere--hd { top: -7px; right: -7px; border-top-width: 1px; border-right-width: 1px; }
  .repere--bg { bottom: -7px; left: -7px; border-bottom-width: 1px; border-left-width: 1px; }
  .repere--bd { right: -7px; bottom: -7px; border-right-width: 1px; border-bottom-width: 1px; }

  /* Le panneau. Une grille fine en fond, une lueur pêche en bas à gauche et
     une lueur froide en haut à droite, juste assez pour donner de la
     profondeur. Dès que la machine travaille, une lumière chaude se lève : le
     panneau s'éclaire. Elle suit ensuite ce qu'on regarde : la facture pour
     l'automatisation, la conversation pour l'agent, tout le plan pour le
     tableau de bord. */
  .scene__cadre {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 680 / 560;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-md);
    background:
      linear-gradient(color-mix(in srgb, var(--color-ink) 5%, transparent) 1px, transparent 1px) 0 0 / 34px 34px,
      linear-gradient(90deg, color-mix(in srgb, var(--color-ink) 5%, transparent) 1px, transparent 1px) 0 0 / 34px 34px,
      radial-gradient(85% 75% at 0% 100%, color-mix(in srgb, var(--color-braise) 24%, transparent), transparent 62%),
      radial-gradient(75% 65% at 100% 0%, color-mix(in srgb, var(--color-lueur-froide) 20%, transparent), transparent 64%),
      var(--color-night-deep);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 9%, transparent);
    isolation: isolate;
  }

  /* La lumière déborde du panneau de près d'un tiers de chaque côté, pour
     pouvoir se déplacer sans montrer son bord. Les cotes du dégradé sont
     celles d'avant, rapportées à cette boîte plus grande. */
  .scene__cadre::before {
    content: '';
    position: absolute;
    inset: -30%;
    z-index: -1;
    background: radial-gradient(43.75% 37.5% at 52.5% 58.75%, color-mix(in srgb, var(--color-peche) 30%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 900ms var(--ease-out-quint), transform 1100ms var(--ease-out-quint);
  }

  .scene:not([data-mode='main']) .scene__cadre::before {
    opacity: 1;
  }

  .scene[data-mode='agent'] .scene__cadre::before {
    transform: translate(-14%, -6%);
  }

  .scene[data-mode='tableau'] .scene__cadre::before {
    transform: translate(-3%, -5%) scale(1.3);
  }

  .scene__cadre::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 6;
    background-image: var(--grain);
    opacity: 0.1;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* Le plan est dessiné à taille fixe, 680 × 560, puis mis à l'échelle de sa
     colonne par une seule variable. Toutes les positions de la scène et tous
     les trajets du curseur se calculent dans ce repère. */
  .scene__plan {
    position: absolute;
    top: 0;
    left: 0;
    width: 680px;
    height: 560px;
    transform: scale(var(--k, 0.86));
    transform-origin: 0 0;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .scene__plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scene__plan li {
    max-width: none;
  }

  /* Les pastilles d'état, à plat au-dessus de la scène : l'heure qui file, ce
     qui attend, les gestes déjà refaits. */
  .puces {
    position: absolute;
    top: 20px;
    left: 22px;
    z-index: 4;
    display: flex;
    gap: 8px;
  }

  .puce {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 12px 0 9px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-night-deep) 70%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
    color: var(--color-ink-mid);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    transition: border-color 400ms, color 400ms;
  }

  .puce b {
    display: inline-block;
    color: var(--color-ink);
    font-weight: 600;
  }

  .puce svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-ink-low);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .puce__horloge line {
    stroke: var(--color-ink);
    stroke-width: 1.5;
  }

  .puce__horloge .puce__minutes {
    stroke: var(--color-peche);
  }

  /* La nuit de l'agent de support : la pastille de l'heure prend la lueur
     froide et porte une lune. */
  .puce__lune {
    display: none;
  }

  .puce.est-nuit {
    border-color: color-mix(in srgb, var(--color-lueur-froide) 75%, transparent);
  }

  .puce.est-nuit .puce__lune {
    display: block;
    fill: color-mix(in srgb, var(--color-lueur-froide) 40%, transparent);
    stroke: color-mix(in srgb, var(--color-lueur-froide) 45%, var(--color-ink));
  }

  .puce.est-vide {
    border-color: color-mix(in srgb, var(--color-peche) 70%, transparent);
  }

  .puce.est-vide b {
    color: var(--color-peche);
  }

  /* Le monde : les fenêtres, le curseur et ses traces, sur un même plan
     incliné. Tout y est dans le même repère, la perspective vient après.
     L'inclinaison est le point de vue : elle change avec la réponse montrée,
     de trois quarts pour la copie et l'automatisation, presque de face pour
     la conversation de l'agent, de l'autre côté pour le tableau de bord. */
  .monde {
    --recul: 1600px;
    --rx: 8deg;
    --ry: -10deg;
    --rz: 1.5deg;
    --tx: 6px;
    --ty: 12px;
    --zoom: 1;
    position: absolute;
    inset: 0;
    transform: perspective(var(--recul)) rotateX(calc(var(--rx) + var(--iy, 0deg))) rotateY(calc(var(--ry) + var(--ix, 0deg))) rotateZ(var(--rz)) translate(var(--tx), var(--ty)) scale(var(--zoom));
    transform-origin: 50% 46%;
    transition: transform 500ms var(--ease-out-quint);
  }

  .scene[data-mode='agent'] .monde {
    --rx: 5deg;
    --ry: -4deg;
    --rz: 0.4deg;
    --tx: 0px;
    --ty: 30px;
  }

  .scene[data-mode='tableau'] .monde {
    --rx: 9deg;
    --ry: 6deg;
    --rz: -1deg;
    --tx: -4px;
    --ty: 32px;
  }

  /* Le temps d'un changement de réponse, le plan tourne plus lentement que
     lorsqu'il suit le pointeur : c'est un mouvement de caméra. Le script pose
     cette classe, puis la retire. */
  .scene.bascule .monde {
    transition-duration: 1100ms;
    transition-timing-function: cubic-bezier(0.6, 0, 0.2, 1);
  }

  /* Une fenêtre qui n'a pas sa place dans la réponse montrée n'est pas
     coupée : elle recule, se floute et s'efface (`--sortie` dit vers où),
     puis disparaît du rendu. Celle qui arrive attend un instant que l'autre
     ait commencé à partir. */
  .fenetre {
    position: absolute;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 12px;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-ink) 12%, transparent),
      0 30px 60px -28px var(--color-night-deep),
      0 12px 24px -16px var(--color-night-deep);
    transition:
      opacity 520ms var(--ease-out-quint) 200ms,
      filter 520ms var(--ease-out-quint) 200ms,
      transform 940ms cubic-bezier(0.25, 0.8, 0.25, 1) 200ms,
      visibility 0s;
  }

  .scene:not([data-mode='main']):not([data-mode='auto']) .fenetre--pdf,
  .scene:not([data-mode='main']):not([data-mode='auto']) .fenetre--app,
  .scene:not([data-mode='agent']) .fenetre--chat,
  .scene:not([data-mode='agent']) .fenetre--base,
  .scene:not([data-mode='agent']) .fenetre--outils,
  .scene:not([data-mode='tableau']) .fenetre--tableau {
    visibility: hidden;
    opacity: 0;
    filter: blur(10px);
    transform: var(--sortie);
    transition:
      opacity 440ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 440ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 620ms cubic-bezier(0.5, 0, 0.75, 0),
      visibility 0s 620ms;
  }

  /* Les fenêtres d'une réponse n'arrivent pas d'un bloc : la principale
     d'abord, ses voisines ensuite. */
  .fenetre--base {
    transition-delay: 320ms, 320ms, 320ms, 0s;
  }

  .fenetre--outils {
    transition-delay: 440ms, 440ms, 440ms, 0s;
  }

  .fenetre__barre {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding-inline: 11px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    font-size: 11.5px;
    font-weight: 500;
  }

  .fenetre__icone {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 22px;
    height: 16px;
    border-radius: 4px;
    font-size: 7.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .fenetre__icone--pdf {
    background: var(--color-braise);
    color: var(--color-night);
  }

  .fenetre__icone--app {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--color-peche);
  }

  .fenetre__icone--app svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--color-night);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .fenetre__nom {
    min-width: 0;
    overflow: hidden;
    color: var(--color-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fenetre__info {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--color-ink-low);
    font-size: 10.5px;
    white-space: nowrap;
  }

  /* ── Le bon de commande : un lecteur de PDF et sa page de papier ── */
  .fenetre--pdf {
    --sortie: translate(-44px, -22px) scale(0.94);
    top: 78px;
    left: 26px;
    width: 318px;
    background: color-mix(in srgb, var(--color-surface-high) 82%, transparent);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .fenetre--pdf .fenetre__corps {
    padding: 12px 12px 14px;
  }

  .page {
    padding: 14px 14px 8px;
    border-radius: 6px;
    background: var(--color-feuille);
    box-shadow: 0 8px 18px -10px var(--color-night-deep);
    color: var(--color-night);
  }

  .page__tete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .page__tete b {
    font-size: 12.5px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .page__tete span {
    color: var(--color-ink-faint);
    font-size: 9.5px;
    font-weight: 500;
  }

  .page__bloc {
    display: grid;
    gap: 4px;
    margin-top: 9px;
  }

  .page__bloc i {
    width: 44%;
    height: 4px;
    border-radius: 2px;
    background: var(--color-feuille-trait);
  }

  .page__bloc i:nth-child(2) { width: 58%; }
  .page__bloc i:nth-child(3) { width: 31%; }

  .colonnes {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 30px 54px;
    gap: 8px;
    margin-top: 13px;
    padding: 0 6px 5px;
    border-bottom: 1px solid var(--color-feuille-trait);
    color: var(--color-ink-faint);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .colonnes span:nth-child(n + 3) {
    text-align: right;
  }

  .doc__ligne {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 30px 54px;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding-inline: 6px;
    border-bottom: 1px solid var(--color-feuille-trait);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    transition: opacity 260ms var(--ease-out-quint), background-color 160ms;
  }

  .doc__ligne:last-child {
    border-bottom: 0;
  }

  .doc__ligne .ref {
    font-weight: 600;
  }

  .doc__ligne i {
    height: 5px;
    border-radius: 3px;
    background: var(--color-feuille-barre);
  }

  .doc__ligne span:nth-of-type(n + 2) {
    text-align: right;
  }

  /* Lue par la machine : la bande pêche passe sur la ligne. */
  .doc__ligne::before {
    content: '';
    position: absolute;
    inset: 3px 0;
    z-index: -1;
    border-radius: 4px;
    background: var(--color-peche);
    clip-path: inset(0 100% 0 0 round 4px);
    transition: clip-path 340ms var(--ease-out-expo);
  }

  .doc__ligne.est-lu::before {
    clip-path: inset(0 0 0 0 round 4px);
  }

  /* Copiée à la main : la sélection que tout le monde connaît. */
  .doc__ligne.est-copie {
    background: color-mix(in srgb, var(--color-lueur-froide) 18%, var(--color-feuille));
    outline: 1px solid color-mix(in srgb, var(--color-lueur-froide) 70%, transparent);
    outline-offset: -1px;
  }

  .doc__ligne.est-fait {
    opacity: 0.36;
  }

  /* ── La facture : l'outil dans lequel on recopie, en verre sombre ── */
  .fenetre--app {
    --sortie: translate(46px, 30px) scale(0.94);
    top: 190px;
    left: 350px;
    width: 308px;
    background: color-mix(in srgb, var(--color-night-deep) 74%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--app .fenetre__corps {
    padding: 12px;
  }

  .facture__etat {
    margin-left: auto;
    padding: 3px 9px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-mid);
    font-size: 10px;
    font-weight: 600;
    transition: background-color 220ms, color 220ms, border-color 220ms;
  }

  .facture__etat[data-etat='emise'] {
    border-color: var(--color-peche);
    background: var(--color-peche);
    color: var(--color-night);
  }

  .champ {
    display: grid;
    gap: 5px;
  }

  .champ__nom,
  .colonnes--app {
    color: var(--color-ink-faint);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .champ__valeur {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding-inline: 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  .champ__valeur em {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-peche), var(--color-lueur-froide));
  }

  .champ__valeur i {
    width: 46%;
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 26%, transparent);
  }

  .colonnes--app {
    grid-template-columns: 48px minmax(0, 1fr) 28px 52px 12px;
    margin-top: 12px;
    padding: 0 8px 5px;
    border-bottom: 0;
  }

  .fenetre--app ul {
    display: grid;
    gap: 5px;
  }

  .facture__ligne {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 28px 52px 12px;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding-inline: 8px;
    border: 1px dashed color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 7px;
    font-size: 11px;
    font-weight: 500;
    transition: border-color 220ms, background-color 220ms;
  }

  .facture__ligne .ref {
    font-weight: 600;
  }

  .facture__ligne i {
    width: var(--l);
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 24%, transparent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 360ms var(--ease-out-expo);
  }

  .facture__ligne span {
    opacity: 0;
    transition: opacity 200ms;
  }

  .facture__ligne span:nth-of-type(n + 2) {
    text-align: right;
  }

  .facture__ligne svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--color-peche);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    scale: 0.4;
    transition: opacity 200ms, scale 320ms var(--ease-out-expo);
  }

  .facture__ligne.est-rempli {
    border-style: solid;
    border-color: color-mix(in srgb, var(--color-ink) 12%, transparent);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }

  .facture__ligne.est-rempli i { transform: scaleX(1); }
  .facture__ligne.est-rempli span { opacity: 1; }
  .facture__ligne.est-valide svg { opacity: 1; scale: 1; }

  .pied {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 11px;
    padding-top: 10px;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    color: var(--color-ink-low);
    font-size: 10.5px;
  }

  .pied b {
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .pied__bouton {
    margin-left: auto;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: var(--color-ink-low);
    font-size: 10.5px;
    font-weight: 600;
    transition: background-color 260ms, color 260ms;
  }

  .fenetre--app:has(.facture__etat[data-etat='emise']) .pied__bouton {
    background: var(--color-peche);
    color: var(--color-night);
  }

  /* ── L'agent de support : une conversation et ses deux sources ──
     Plus de bon de commande ici. À gauche la conversation, à droite ce que
     l'agent consulte pour répondre : une base de connaissances et des outils
     connectés. La source consultée s'allume, et sa réponse rejoint la bulle. */
  .fenetre--chat {
    --sortie: translate(-46px, 22px) scale(0.95);
    top: 70px;
    left: 22px;
    width: 352px;
    background: color-mix(in srgb, var(--color-night-deep) 74%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--chat .fenetre__corps {
    padding: 12px;
  }

  /* « En ligne · 24 h/24 » : c'est ce que cette réponse doit faire lire. */
  .chat__etat {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 7px;
    margin-left: auto;
    padding: 3px 10px 3px 9px;
    border: 1px solid color-mix(in srgb, var(--color-peche) 60%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink);
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .chat__etat i {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-peche) 24%, transparent);
  }

  /* La conversation a une hauteur fixe, comme une vraie fenêtre de
     discussion : la fenêtre ne grandit pas à chaque message. */
  .conversation {
    display: flex;
    flex-direction: column;
    gap: 13px;
    height: 302px;
  }

  .echange {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .echange__quand {
    align-self: center;
    color: var(--color-ink-low);
    font-size: 11.5px;
    font-weight: 500;
    opacity: 0;
    transition: opacity 260ms;
  }

  .bulle {
    max-width: 88%;
    padding: 7px 11px 8px;
    border: 1px solid transparent;
    border-radius: 13px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.35;
    opacity: 0;
    translate: 0 8px;
    scale: 0.96;
    transition:
      opacity 240ms,
      translate 420ms var(--ease-out-expo),
      scale 420ms var(--ease-out-expo),
      background-color 260ms,
      border-color 260ms,
      color 260ms;
  }

  .bulle--client {
    border-bottom-left-radius: 4px;
    background: color-mix(in srgb, var(--color-ink) 11%, transparent);
    color: var(--color-ink);
    transform-origin: 0 100%;
  }

  /* La bulle de l'agent a deux temps : en pointillé pêche pendant qu'il
     cherche, pleine quand il répond. */
  .bulle--agent {
    align-self: flex-end;
    border-color: color-mix(in srgb, var(--color-peche) 55%, transparent);
    border-bottom-right-radius: 4px;
    background: color-mix(in srgb, var(--color-peche) 10%, transparent);
    color: var(--color-ink-mid);
    transform-origin: 100% 100%;
  }

  .bulle__cherche {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .bulle__texte {
    display: none;
  }

  .points {
    display: inline-flex;
    gap: 3px;
  }

  .points i {
    width: 4px;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
  }

  .echange.est-cherche .points i {
    animation: recit-point 900ms ease-in-out infinite;
  }

  .echange.est-cherche .points i:nth-child(2) { animation-delay: 150ms; }
  .echange.est-cherche .points i:nth-child(3) { animation-delay: 300ms; }

  @keyframes recit-point {
    0%, 60%, 100% { opacity: 0.35; translate: 0 0; }
    30% { opacity: 1; translate: 0 -2px; }
  }

  .source {
    align-self: flex-end;
    padding: 2px 9px 3px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-low);
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    scale: 0.8;
    transform-origin: 100% 50%;
    transition: opacity 220ms, scale 360ms var(--ease-out-expo);
  }

  .source b {
    color: var(--color-peche);
    font-weight: 600;
  }

  .echange.est-pose .echange__quand {
    opacity: 1;
  }

  .echange.est-pose .bulle--client,
  .echange.est-cherche .bulle--agent {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }

  .echange.est-repondu .bulle--agent {
    border-color: var(--color-peche);
    background: var(--color-peche);
    color: var(--color-night);
  }

  .echange.est-repondu .bulle__cherche { display: none; }
  .echange.est-repondu .bulle__texte { display: inline; }

  .echange.est-source .source {
    opacity: 1;
    scale: 1;
  }

  /* Les deux sources. Elles reprennent le dessin des lignes de la facture :
     discrètes au repos, pleines et pêche quand l'agent y a trouvé. */
  .fenetre--base,
  .fenetre--outils {
    background: color-mix(in srgb, var(--color-night-deep) 74%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--base {
    --sortie: translate(48px, -20px) scale(0.95);
    top: 84px;
    left: 388px;
    width: 270px;
  }

  .fenetre--outils {
    --sortie: translate(48px, 26px) scale(0.95);
    top: 302px;
    left: 404px;
    width: 254px;
  }

  .fenetre--base .fenetre__corps,
  .fenetre--outils .fenetre__corps {
    padding: 10px;
  }

  .fenetre--base.est-consulte,
  .fenetre--outils.est-consulte {
    border-color: color-mix(in srgb, var(--color-peche) 60%, transparent);
  }

  .recherche {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 27px;
    margin-bottom: 8px;
    padding-inline: 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    color: var(--color-ink);
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .recherche span:empty::before {
    content: 'Rechercher';
    color: var(--color-ink-faint);
  }

  .recherche svg,
  .article svg,
  .outil svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-ink-low);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .articles,
  .outils {
    display: grid;
    gap: 5px;
  }

  .article,
  .outil {
    display: grid;
    grid-template-columns: 13px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding-inline: 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    border-radius: 7px;
    color: var(--color-ink-mid);
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
    transition: border-color 220ms, background-color 220ms, color 220ms;
  }

  .article .coche {
    width: 12px;
    height: 12px;
    stroke: var(--color-peche);
    stroke-width: 2;
    opacity: 0;
    scale: 0.4;
    transition: opacity 200ms, scale 320ms var(--ease-out-expo);
  }

  .outil__etat {
    color: var(--color-ink-faint);
    transition: color 220ms;
  }

  /* Parcouru : l'agent passe sur l'article sans s'y arrêter. */
  .article.est-parcouru {
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: var(--color-ink);
  }

  .article.est-trouve,
  .outil.est-interroge {
    border-color: var(--color-peche);
    background: color-mix(in srgb, var(--color-peche) 16%, transparent);
    color: var(--color-ink);
  }

  .article.est-trouve svg,
  .outil.est-interroge svg {
    stroke: var(--color-peche);
  }

  .article.est-trouve .coche {
    opacity: 1;
    scale: 1;
  }

  .outil.est-interroge .outil__etat {
    color: var(--color-peche);
  }

  /* ── Le tableau de bord : le suivi des projets d'une équipe ──
     Une interface métier autant qu'un tableau de bord : trois indicateurs,
     puis trois colonnes où chaque projet est une carte. Ni lignes de facture
     ni montants : rien ici ne rappelle la réponse Automatisation. */
  .fenetre--tableau {
    --sortie: translate(0, 64px) scale(0.93);
    top: 74px;
    left: 42px;
    width: 598px;
    background: color-mix(in srgb, var(--color-night-deep) 86%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--tableau .fenetre__info {
    font-size: 11.5px;
  }

  .fenetre--tableau .fenetre__corps {
    display: grid;
    gap: 12px;
    padding: 14px;
  }

  .indicateurs,
  .piles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .indicateur {
    display: grid;
    justify-items: start;
    gap: 5px;
    padding: 9px 12px 11px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  .indicateur__nom {
    color: var(--color-ink-low);
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .indicateur b {
    color: var(--color-ink);
    font-size: 32px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* « En retard 0 » : le zéro qu'on vient chercher, en pêche. */
  .indicateur--zero {
    border-color: color-mix(in srgb, var(--color-peche) 60%, transparent);
  }

  .indicateur--zero b {
    color: var(--color-peche);
  }

  .pile {
    display: grid;
    align-content: start;
    gap: 7px;
    padding: 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-ink) 3%, transparent);
  }

  .pile__tete {
    display: flex;
    justify-content: space-between;
    padding-inline: 2px;
    color: var(--color-ink-mid);
    font-size: 11.5px;
    font-weight: 600;
  }

  .pile__tete b {
    color: var(--color-ink-faint);
    font-weight: 500;
  }

  /* Cinq cartes de haut : la place qu'il faut à la colonne la plus pleine,
     pour que la fenêtre ne bouge pas quand une carte change de colonne. */
  .pile ul {
    display: grid;
    align-content: start;
    gap: 5px;
    height: calc(5 * 30px + 4 * 5px);
  }

  /* Une carte, un projet. En pointillé tant qu'il attend ; son filet pêche
     dit où il en est ; livré, il reçoit sa coche. */
  .carte {
    position: relative;
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr) 12px;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding-inline: 8px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: 7px;
    background: var(--color-surface-high);
    color: var(--color-ink);
    font-size: 11.5px;
    font-weight: 500;
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 280ms,
      translate 520ms var(--ease-out-expo),
      border-color 260ms,
      color 260ms,
      box-shadow 260ms;
  }

  .carte.est-la {
    opacity: 1;
    translate: 0 0;
  }

  .carte__nom {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .carte__puce {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--color-peche);
    border-radius: var(--radius-full);
    background: var(--color-peche);
    transition: background-color 260ms, border-color 260ms;
  }

  .carte svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--color-peche);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    scale: 0.4;
    transition: opacity 200ms, scale 320ms var(--ease-out-expo);
  }

  .carte__avance {
    position: absolute;
    bottom: 0;
    left: 0;
    width: calc(var(--p) * 1%);
    height: 2px;
    background: var(--color-peche);
    text-decoration: none;
    transition: width 640ms var(--ease-out-quint);
  }

  .carte[data-etat='afaire'] {
    border-style: dashed;
    color: var(--color-ink-mid);
  }

  .carte[data-etat='afaire'] .carte__puce {
    border-color: var(--color-ink-faint);
    background: transparent;
  }

  .carte[data-etat='livre'] {
    color: var(--color-ink-mid);
  }

  .carte[data-etat='livre'] svg {
    opacity: 1;
    scale: 1;
  }

  /* La carte qui change de colonne passe au-dessus des autres. */
  .carte.en-vol {
    z-index: 2;
    border-color: var(--color-peche);
    box-shadow: 0 14px 24px -12px var(--color-night-deep);
  }

  /* Les trajets du curseur laissent une trace : à force, on voit le geste se
     répéter. */
  .traces {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .traces :global(path) {
    fill: none;
    stroke: color-mix(in srgb, var(--color-ink) 62%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }

  /* Le fil qui relie la source consultée à la conversation. */
  .traces :global(path.fil-source) {
    stroke: var(--color-peche);
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
  }

  /* En automatique, c'est la ligne elle-même qui part : sa bande pêche quitte la
     page et vient se poser dans la facture. Pour l'agent de support, la même
     bande part de la source consultée et vient se poser dans sa bulle. */
  .bande {
    position: absolute;
    z-index: 4;
    border-radius: 5px;
    background: var(--color-peche);
    opacity: 0;
    transform-origin: 0 0;
    pointer-events: none;
  }

  .curseur {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: 0;
    height: 0;
    transition: opacity 260ms;
  }

  .curseur[data-etat='cache'] {
    opacity: 0;
  }

  .curseur svg {
    position: absolute;
    top: -3px;
    left: -5px;
    width: 22px;
    height: 22px;
    filter: drop-shadow(0 3px 4px var(--color-night-deep));
    transition: scale 110ms;
  }

  .curseur path {
    fill: var(--color-ink);
    stroke: var(--color-night);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .curseur.clique svg {
    scale: 0.8;
  }

  .curseur__valeur {
    position: absolute;
    top: 19px;
    left: 13px;
    padding: 3px 9px 4px;
    border: 1px solid color-mix(in srgb, var(--color-lueur-froide) 80%, transparent);
    border-radius: 7px;
    background: color-mix(in srgb, var(--color-lueur-froide) 26%, var(--color-night-deep));
    box-shadow: 0 8px 18px -8px var(--color-night-deep);
    color: var(--color-ink);
    font-size: 10.5px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    scale: 0.8;
    transform-origin: 0 0;
    transition: opacity 140ms, scale 160ms var(--ease-out-quint);
  }

  .curseur.porte .curseur__valeur {
    opacity: 1;
    scale: 1;
  }

  /* La commande de la scène, en quatre temps : le travail à la main, puis
     les trois réponses. Le récit la règle tout seul, et elle dit toujours
     où en est la scène ; on peut aussi la pousser à la main. Le travail à la
     main s'allume en blanc, les trois réponses en pêche. */
  .scene__mode {
    display: inline-flex;
    gap: 2px;
    max-width: 100%;
    padding: 4px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }

  .scene__mode[hidden] {
    display: none;
  }

  .scene__mode button {
    min-height: 44px;
    padding: 0 1.1rem;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-ink-mid);
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--duration-default) var(--ease-out-quint), color var(--duration-default);
  }

  .scene__mode button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-night);
  }

  .scene__mode button:not([data-mode-bouton='main'])[aria-pressed='true'] {
    background: var(--color-peche);
  }

  /* Un libellé a parfois deux longueurs : la courte ne sort que là où la
     longue ne tient plus. */
  .mot-court {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .scene__mode button[aria-pressed='false']:hover {
      color: var(--color-ink);
    }
  }

  /* Sur un écran large mais bas, la scène se règle sur la hauteur et devient
     plus étroite que ses quatre boutons : leurs marges se serrent. */
  @media (min-width: 1024px) and (max-height: 620px) {
    .scene__mode button {
      padding-inline: 0.65rem;
    }
  }

  /* ── Une colonne ──
     Sur téléphone et tablette, rien n'est collé : la scène est posée dans le
     fil de la page, après la première phrase, et les deux suivantes se lisent
     à la suite. Une scène fixée en haut d'un petit écran ne laissait au texte
     qu'une bande étroite où défiler, et il fallait faire défiler longtemps
     pour peu de texte. Ici c'est la scène qui déroule seule ses temps (voir
     le script), et les boutons permettent de passer de l'un à l'autre. */
  @media (max-width: 1023px) {
    .story__grille {
      display: block;
      padding-bottom: 1.5rem;
    }

    .acte::before,
    .acte::after {
      display: none;
    }

    .acte {
      min-height: 0;
      padding-block: 2.75rem;
      align-content: start;
    }

    .acte:first-child {
      padding-top: 4rem;
      padding-bottom: 1.75rem;
    }

    .acte__titre {
      max-width: 17ch;
    }

    .story__scene {
      position: static;
      height: auto;
      padding-bottom: 0.5rem;
    }

    .scene {
      gap: 1rem;
      width: min(100%, 30rem);
    }

    /* Quatre boutons sur une seule ligne : le corps suit la largeur de
       l'écran (c'est le jeton des boutons du site) et les marges se serrent.
       La hauteur de 44 px, elle, ne bouge pas. */
    .scene__mode button {
      min-height: 44px;
      padding-inline: clamp(0.4rem, 2.3vw, 1rem);
      font-size: var(--text-button);
    }

    /* Sur ces écrans, le flou d'arrière-plan et le mélange du grain coûtent
       trop cher pendant le défilement : les fenêtres deviennent opaques. */
    .fenetre--pdf,
    .fenetre--app,
    .fenetre--chat,
    .fenetre--base,
    .fenetre--outils,
    .fenetre--tableau,
    .puce {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .fenetre--pdf { background: var(--color-surface-high); }
    .fenetre--app,
    .fenetre--chat,
    .fenetre--base,
    .fenetre--outils,
    .fenetre--tableau { background: color-mix(in srgb, var(--color-night-deep) 94%, var(--color-ink)); }
    .puce { background: var(--color-night-deep); }

    .scene__cadre::after {
      opacity: 0.06;
      mix-blend-mode: normal;
    }
  }

  /* ── Le plan étroit ──
     Sous 640 px, la scène est redessinée plutôt que réduite : trois lignes au
     lieu de cinq, des pastilles sans libellé, une facture sans pied. Elle
     doit laisser de la place au texte qui défile dessous. */
  @media (max-width: 640px) {
    .scene__cadre { aspect-ratio: 340 / 356; }

    .scene__plan {
      width: 340px;
      height: 356px;
    }

    .doc__ligne:nth-child(n + 4),
    .facture__ligne:nth-child(n + 4),
    .page__bloc,
    .champ,
    .pied,
    .puce__nom {
