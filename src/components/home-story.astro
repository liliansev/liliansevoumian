    .carte__avance {
      transition: none;
    }

    .scene .echange.est-cherche .points i {
      animation: none;
    }
  }
</style>

<script>
  /*
   * Le moteur de la scène. Une boucle par façon de faire (à la main, puis les
   * trois réponses) et un jeton qui les annule : à chaque changement de mode
   * le jeton avance, et toute boucle qui se réveille avec un jeton périmé
   * s'arrête sans rien toucher. Au-dessus, une régie (`derouler`) règle
   * l'ordre et la durée des temps tant que c'est le récit qui a la main.
   */
  const NS = 'http://www.w3.org/2000/svg';
  const JOURS = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi'];
  const ATTENTE_DEPART = 23;

  /* Les quatre états de la scène : la copie à la main, puis les trois
     réponses, dans l'ordre où elle les enchaîne. */
  const MODES = ['main', 'auto', 'agent', 'tableau'] as const;
  type Mode = (typeof MODES)[number];
  const estMode = (v: string | undefined): v is Mode => MODES.some((m) => m === v);

  /* Un temps du récit : ce qu'il montre et combien il dure, en millisecondes
     passées à l'écran. Entre `mini` et `plafond`, la scène passe à la suite
     `tenue` ms après que la réponse a fini de dire ce qu'elle a à dire (voir
     `acheve`) : on ne coupe pas un geste au milieu. */
  type Temps = { acte: number; mode: Mode; mini: number; plafond: number; tenue: number };
  const REPONSES: Temps[] = [
    { acte: 3, mode: 'auto', mini: 5200, plafond: 10500, tenue: 1500 },
    { acte: 3, mode: 'agent', mini: 7000, plafond: 12500, tenue: 1400 },
    { acte: 3, mode: 'tableau', mini: 5600, plafond: 9500, tenue: 1150 },
  ];
  /* En une colonne : à la main, la semaine qui file, puis les trois réponses. */
  const DEROULE: Temps[] = [
    { acte: 1, mode: 'main', mini: 7000, plafond: 7000, tenue: 0 },
    { acte: 2, mode: 'main', mini: 4500, plafond: 4500, tenue: 0 },
    ...REPONSES,
  ];

  const ANNONCES: Record<Mode, string> = {
    main: 'À la main : chaque ligne du bon de commande est recopiée dans la facture, et les commandes en attente s’accumulent.',
    auto: 'Automatisation : les lignes passent seules du bon de commande à la facture, et il ne reste aucune commande en attente.',
    agent:
      'Agent IA : un agent de support répond à un client un dimanche à 23 h 47, puis à un autre à 3 h 12. Il trouve la réponse dans la base de connaissances ou dans un outil connecté, le CRM, et cite sa source.',
    tableau:
      'Dashboard : le suivi des projets d’une équipe, avec le nombre de projets en cours, livrés cette semaine et en retard, et trois colonnes où chaque projet avance de « à faire » à « livré ».',
  };

  /* Les colonnes du suivi de projets, et l'ordre dans lequel les projets y
     avancent : un livré, un lancé, et encore une fois. */
  const ETATS = ['afaire', 'cours', 'livre'] as const;
  type Etat = (typeof ETATS)[number];
  const etatDe = (v: string | undefined): Etat => ETATS.find((e) => e === v) ?? 'afaire';
  const MOUVEMENTS: [Etat, Etat][] = [
    ['cours', 'livre'],
    ['afaire', 'cours'],
    ['cours', 'livre'],
    ['afaire', 'cours'],
  ];

  const racine = document.querySelector<HTMLElement>('[data-story]');
  const scene = racine?.querySelector<HTMLElement>('[data-scene]');
  /* Sans ces deux API (navigateurs d'avant 2020), la scène reste l'image fixe
     du HTML : mieux qu'un script qui s'arrête à mi-chemin. */
  const pretAAnimer = 'animate' in Element.prototype && 'ResizeObserver' in window;
  if (racine && scene && pretAAnimer) lancer(racine, scene);

  function lancer(racine: HTMLElement, scene: HTMLElement) {
    const un = <T extends Element = HTMLElement>(sel: string) => scene.querySelector<T>(sel)!;
    const tous = (sel: string) => [...scene.querySelectorAll<HTMLElement>(sel)];
    const cadre = un('.scene__cadre');
    const plan = un('.scene__plan');
    const monde = un('[data-monde]');
    const curseur = un('[data-curseur]');
    const valeur = un('[data-porte]');
    const traces = un<SVGSVGElement>('[data-traces]');
    const doc = un('[data-doc]');
    const etat = un('.facture__etat');
    const elJour = un('[data-jour]');
    const elHeure = un('[data-heure]');
    const elGestes = un('[data-gestes]');
    const elAttente = un('[data-attente]');
    const elTotal = un('[data-total]');
    const blocAttente = un('[data-attente-bloc]');
    const aigMin = un<SVGLineElement>('[data-aiguille-min]');
    const aigH = un<SVGLineElement>('[data-aiguille-h]');
    const bandes = tous('.bande');
    const puceHorloge = un('[data-horloge]');
    /* L'agent de support : la conversation et ses échanges, la base de
       connaissances (sa recherche, ses articles) et les outils connectés. */
    const fenChat = un('[data-chat]');
    const conversation = un('[data-conversation]');
    const echanges = tous('[data-echange]');
    const fenBase = un('[data-base]');
    const requete = un('[data-recherche]');
    const articles = tous('[data-article]');
    const fenOutils = un('[data-outils]');
    const outils = tous('[data-outil]');
    /* Le suivi de projets : les trois colonnes, les cartes et les deux
       indicateurs qui comptent. Le balisage porte l'état de départ ; le
       script le relit pour savoir où revenir. */
    const piles: Record<Etat, HTMLElement> = {
      afaire: un('[data-pile="afaire"]'),
      cours: un('[data-pile="cours"]'),
      livre: un('[data-pile="livre"]'),
    };
    const cartes = tous('[data-carte]');
    const departCartes = cartes.map((carte) => ({
      carte,
      etat: etatDe(carte.dataset.etat),
      p: carte.style.getPropertyValue('--p'),
    }));
    const indicateurs = tous('[data-indicateur]');
    const boutons = tous('[data-mode-bouton]');
    const annonce = scene.querySelector<HTMLElement>('[data-annonce]');
    const titres = [...racine.querySelectorAll<HTMLElement>('.acte')].map((acte) => ({
      n: Number(acte.dataset.acte),
      el: acte.querySelector<HTMLElement>('.acte__titre')!,
    }));

    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /* En une colonne, la scène n'est plus liée au défilement : elle déroule
       seule ses temps. */
    const colonne = window.matchMedia('(max-width: 1023px)');
    /* Le plan étroit, celui où la conversation ne montre qu'un échange. */
    const etroit = window.matchMedia('(max-width: 640px)');
    const euros = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    let mode: Mode = 'main';
    let acte = 1;
    let jeton = 0;
    let visible = false;
    let gestes = 0;
    let attente = ATTENTE_DEPART;
    let minutes = 9 * 60;
    let jour = 0;
    let vitesse = 5;
    let pos = { x: 0, y: 0 };
    /* L'instant où la réponse en cours a fini de dire ce qu'elle a à dire : la
       file est vide et la facture émise, l'agent a répondu à ses deux
       clients, un projet a été livré et un autre lancé. Zéro tant que ce
       n'est pas le cas. La régie s'en sert pour passer à la suite au bon
       moment. */
    let acheve = 0;
    const conclure = () => {
      if (!acheve) acheve = performance.now();
    };

    type Pt = { x: number; y: number };

    const lignes = (sel: string) =>
      [...monde.querySelectorAll<HTMLElement>(sel)].filter((el) => el.offsetParent !== null);

    const pause = (ms: number) => new Promise<void>((ok) => window.setTimeout(ok, ms));

    /* Une animation annulée par un changement de mode rejette sa promesse avec
       `AbortError` : c'est attendu, la boucle s'arrête d'elle-même au contrôle
       de jeton suivant. Toute autre erreur remonte. */
    const annulee = (erreur: unknown) => erreur instanceof DOMException && erreur.name === 'AbortError';
    const fini = (animation: Animation) =>
      animation.finished.then(
        () => undefined,
        (erreur: unknown) => {
          if (!annulee(erreur)) throw erreur;
        },
      );

    const aLEcran = () => visible && !document.hidden;
    const attendreEcran = async () => {
      while (!aLEcran()) await pause(240);
    };

    /* Le rectangle d'un élément dans le repère du monde, lu sur la mise en
       page et non à l'écran : la perspective du monde ne le déforme pas, et
       une fenêtre encore en train d'arriver est déjà lue à sa place. */
    const cadreDe = (el: HTMLElement) => {
      let x = 0;
      let y = 0;
      let n: HTMLElement | null = el;
      while (n && n !== monde) {
        x += n.offsetLeft;
        y += n.offsetTop;
        n = n.offsetParent as HTMLElement | null;
      }
      return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    };

    const lieu = (el: HTMLElement, ax = 0.5, ay = 0.5): Pt => {
      const c = cadreDe(el);
      return { x: c.x + c.w * ax, y: c.y + c.h * ay };
    };

    const ajuster = () => {
      plan.style.setProperty('--k', String(cadre.clientWidth / plan.offsetWidth));
      traces.setAttribute('viewBox', `0 0 ${monde.offsetWidth} ${monde.offsetHeight}`);
    };

    /* Une courbe entre deux points, échantillonnée avec son accélération : les
       images clés portent déjà le départ doux et l'arrivée douce. */
    const courbe = (de: Pt, vers: Pt, bombe: number, pas = 18) => {
      const c = { x: (de.x + vers.x) / 2, y: Math.min(de.y, vers.y) - bombe };
      const liste: Pt[] = [];
      for (let i = 0; i <= pas; i++) {
        const t = i / pas;
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        liste.push({
          x: (1 - e) * (1 - e) * de.x + 2 * (1 - e) * e * c.x + e * e * vers.x,
          y: (1 - e) * (1 - e) * de.y + 2 * (1 - e) * e * c.y + e * e * vers.y,
        });
      }
      return { liste, c };
    };

    const chemin = (de: Pt, c: Pt, vers: Pt) => {
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', `M${de.x} ${de.y} Q${c.x} ${c.y} ${vers.x} ${vers.y}`);
      return p;
    };

    const poser = (p: Pt) => {
      pos = p;
      curseur.style.transform = `translate(${p.x}px, ${p.y}px)`;
    };

    async function deplacer(vers: Pt, duree: number, bombe: number, trace = false) {
      const de = pos;
      const { liste, c } = courbe(de, vers, bombe);
      if (trace) {
        const p = chemin(de, c, vers);
        traces.append(p);
        p.animate([{ opacity: 0 }, { opacity: 0.7 }], { duration: duree, fill: 'forwards' });
        const garde = acte === 2 ? 30000 : 4600;
        window.setTimeout(() => {
          p.animate([{ opacity: 0.7 }, { opacity: 0 }], { duration: 900, fill: 'forwards' }).finished.then(
            () => p.remove(),
            () => p.remove(),
          );
        }, garde);
        while (traces.childElementCount > 48) traces.firstElementChild?.remove();
      }
      const anim = curseur.animate(
        liste.map((p) => ({ transform: `translate(${p.x}px, ${p.y}px)` })),
        { duration: duree, easing: 'linear' },
      );
      try {
        await anim.finished;
        poser(vers);
      } catch (erreur) {
        if (!annulee(erreur)) throw erreur;
      }
    }

    const cliquer = () => {
      curseur.classList.add('clique');
      window.setTimeout(() => curseur.classList.remove('clique'), 130);
    };

    /* Un nombre qui change tombe à sa place. `elan` est la hauteur de la
       chute, en pour cent de la sienne : petite pour un grand nombre, qui
       sinon monterait sur ce qu'il a au-dessus de lui. */
    const ecrire = (el: HTMLElement, n: number, elan = 38) => {
      el.textContent = String(n);
      if (!reduit) {
        el.animate(
          [{ transform: `translateY(-${elan}%)`, opacity: 0.2 }, { transform: 'none', opacity: 1 }],
          { duration: 240, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        );
      }
    };

    const compter = (el: HTMLElement, de: number, vers: number, duree: number, j: number) => {
      const debut = performance.now();
      const pas = (t: number) => {
        /* Interrompu, le compteur écrit sa valeur d'arrivée : la variable la
           porte déjà, et un nombre intermédiaire resterait affiché. */
        if (j !== jeton) {
          el.textContent = String(vers);
          return;
        }
        const a = Math.min(1, (t - debut) / duree);
        el.textContent = String(Math.round(de + (vers - de) * (1 - Math.pow(1 - a, 3))));
        if (a < 1) requestAnimationFrame(pas);
      };
      requestAnimationFrame(pas);
    };

    const majAttente = (n: number) => {
      attente = n;
      ecrire(elAttente, n);
      blocAttente.classList.toggle('est-vide', n === 0);
    };

    /* Le total de la facture : la somme des lignes déjà remplies. */
    const majTotal = () => {
      const somme = lignes('[data-ligne-facture]')
        .filter((l) => l.classList.contains('est-rempli'))
        .reduce((t, l) => t + Number(l.dataset.montant ?? 0), 0);
      elTotal.textContent = `${euros.format(somme)} €`;
    };

    const etatFacture = (emise: boolean) => {
      etat.dataset.etat = emise ? 'emise' : 'brouillon';
      etat.textContent = emise ? 'Émise' : 'Brouillon';
    };

    /* La page et la facture se vident ensemble, et seulement quand elles
       reviennent : une réponse qui les retire de la scène les laisse partir
       telles qu'elles sont, au lieu de les voir se vider en s'effaçant. */
    const viderLignes = () => {
      monde.querySelectorAll('[data-ligne-doc]').forEach((l) => l.classList.remove('est-lu', 'est-copie', 'est-fait'));
      monde.querySelectorAll('[data-ligne-facture]').forEach((l) => l.classList.remove('est-rempli', 'est-valide'));
      etatFacture(false);
      majTotal();
    };

    /* Une commande de plus arrive : la pastille tressaille. */
    const feuilleTombe = () => {
      if (reduit) return;
      blocAttente.animate([{ transform: 'scale(1.09)' }, { transform: 'none' }], {
        duration: 360,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      });
    };

    /* La page traitée part, la suivante remonte, la facture se vide. */
    async function docSuivant(j: number, rapide: boolean) {
      const d = rapide ? 190 : 360;
      await fini(
        doc.animate([{ translate: '0 0', opacity: 1 }, { translate: '0 -18px', opacity: 0 }], {
          duration: d,
          easing: 'cubic-bezier(0.5, 0, 0.75, 0)',
        }),
      );
      if (j !== jeton) return;
      viderLignes();
      await fini(
        doc.animate([{ translate: '0 22px', opacity: 0 }, { translate: '0 0', opacity: 1 }], {
          duration: d,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        }),
      );
    }

    /* ── À la main ──
       `retard` laisse aux fenêtres le temps de reprendre leur place quand on
       revient d'une réponse qui les avait déplacées. */
    async function boucleMain(j: number, retard: number) {
      curseur.dataset.etat = 'visible';
      if (retard) {
        await pause(retard);
        if (j !== jeton) return;
      }
      while (j === jeton) {
        const docs = lignes('[data-ligne-doc]');
        const facts = lignes('[data-ligne-facture]');
        for (let i = 0; i < docs.length; i++) {
          await attendreEcran();
          if (j !== jeton) return;
          await deplacer(lieu(docs[i], 0.78, 0.58), 480, 12);
          if (j !== jeton) return;
          cliquer();
          docs[i].classList.add('est-copie');
          valeur.textContent = docs[i].dataset.valeur ?? '';
          curseur.classList.add('porte');
          await pause(230);
          if (j !== jeton) return;
          await deplacer(lieu(facts[i], 0.6, 0.58), 720, 40, true);
          if (j !== jeton) return;
          cliquer();
          curseur.classList.remove('porte');
          facts[i].classList.add('est-rempli');
          docs[i].classList.remove('est-copie');
          docs[i].classList.add('est-fait');
          majTotal();
          gestes += 1;
          ecrire(elGestes, gestes);
          await pause(260);
        }
        if (j !== jeton) return;
        etatFacture(true);
        await pause(560);
        if (j !== jeton) return;
        majAttente(Math.max(1, attente - 1));
        await docSuivant(j, false);
      }
    }

    /* Pendant ce temps, les bons de commande continuent d'arriver. */
    async function arrivees(j: number) {
      while (j === jeton) {
        await pause(acte === 2 ? 950 : 3800);
        await attendreEcran();
        if (j !== jeton) return;
        majAttente(attente + 1);
        feuilleTombe();
      }
    }

    /* Une bande pêche quitte son point de départ et va prendre la place et la
       forme de sa cible : d'une ligne du bon de commande à une ligne de la
       facture, ou de la source que l'agent consulte à la bulle où il répond. */
    async function voler(bande: HTMLElement, de: HTMLElement, vers: HTMLElement, delai: number, duree: number) {
      const a = cadreDe(de);
      const z = cadreDe(vers);
      const dx = z.x - a.x;
      const dy = z.y - a.y - 3;
      Object.assign(bande.style, {
        left: `${a.x}px`,
        top: `${a.y + 3}px`,
        width: `${a.w}px`,
        height: `${a.h - 6}px`,
      });
      await fini(
        bande.animate(
          [
            { transform: 'translate(0, 0) scale(1, 1)', opacity: 0.9 },
            {
              transform: `translate(${dx * 0.5 + a.w * 0.22}px, ${dy * 0.42 - 14}px) scale(0.56, 0.72)`,
              opacity: 0.9,
              offset: 0.5,
            },
            { opacity: 0.85, offset: 0.82 },
            { transform: `translate(${dx}px, ${dy}px) scale(${z.w / a.w}, ${z.h / (a.h - 6)})`, opacity: 0 },
          ],
          { duration: duree, delay: delai, easing: 'cubic-bezier(0.45, 0, 0.15, 1)', fill: 'backwards' },
        ),
      );
    }

    /* Un texte qui s'écrit, à pas réguliers. Interrompu, il s'arrête où il
       est : la boucle qui reprendra la scène le remettra d'aplomb. */
    const taper = (el: HTMLElement, texte: string, duree: number, j: number) =>
      new Promise<void>((ok) => {
        const debut = performance.now();
        const pas = (t: number) => {
          if (j !== jeton) return ok();
          const a = Math.min(1, Math.max(0, (t - debut) / duree));
          el.textContent = texte.slice(0, Math.round(texte.length * a));
          if (a < 1) requestAnimationFrame(pas);
          else ok();
        };
        requestAnimationFrame(pas);
      });

    /* Les trois réponses partent du même constat : plus aucun geste refait.
       L'agent et le tableau de bord montrent en plus une file déjà vide ;
       l'automatisation, elle, la vide sous les yeux du visiteur. */
    const solder = (j: number, file: boolean) => {
      compter(elGestes, gestes, 0, 900, j);
      gestes = 0;
      if (!file || attente === 0) {
        blocAttente.classList.toggle('est-vide', attente === 0);
        return;
      }
      compter(elAttente, attente, 0, 900, j);
      attente = 0;
      window.setTimeout(() => j === jeton && blocAttente.classList.add('est-vide'), 900);
    };

    /* ── Automatisation ── */
    async function boucleAuto(j: number, retard: number) {
      curseur.dataset.etat = 'cache';
      viderLignes();
      solder(j, false);
      /* La file se vide en cinq bons, quelle que soit sa longueur : la durée
         de cette réponse ne dépend pas du temps passé sur la phrase d'avant. */
      const lot = Math.max(3, Math.ceil(attente / 5));
      await pause(retard);
      while (j === jeton) {
        await attendreEcran();
        if (j !== jeton) return;
        const docs = lignes('[data-ligne-doc]');
        const facts = lignes('[data-ligne-facture]');
        const presse = attente > 0;
        const cadence = presse ? 32 : 75;
        docs.forEach((d, i) => window.setTimeout(() => j === jeton && d.classList.add('est-lu'), i * cadence));
        await pause(docs.length * cadence + (presse ? 110 : 300));
        if (j !== jeton) return;
        await Promise.all(
          docs.map((d, i) =>
            voler(bandes[i], d, facts[i], i * cadence, presse ? 380 : 600).then(() => {
              if (j !== jeton) return;
              facts[i].classList.add('est-rempli', 'est-valide');
              majTotal();
            }),
          ),
        );
        if (j !== jeton) return;
        etatFacture(true);
        if (presse) majAttente(Math.max(0, attente - lot));
        if (attente > 0) {
          await pause(220);
          if (j !== jeton) return;
          await docSuivant(j, true);
        } else {
          /* La file est vide : la facture émise reste à l'écran, c'est
             l'image que cette réponse laisse. */
          conclure();
          await pause(3200);
          if (j !== jeton) return;
          feuilleTombe();
          await docSuivant(j, false);
        }
      }
    }

    /* ── Agent IA : le support client ──
       Ce que l'agent consulte pour répondre : un article de la base de
       connaissances, ou un outil connecté. Sur le plan étroit les articles ne
       sont pas dessinés, c'est la pastille de la base elle-même qui s'allume. */
    const sourceDe = (e: HTMLElement): HTMLElement => {
      if (e.dataset.origine === 'base') return lignes('[data-article][data-trouve]')[0] ?? fenBase;
      return outils.find((o) => o.dataset.outil === e.dataset.origine && o.offsetParent !== null) ?? fenOutils;
    };

    const allumer = (e: HTMLElement, source: HTMLElement) => {
      if (e.dataset.origine === 'base') {
        fenBase.classList.add('est-consulte');
        source.classList.add('est-trouve');
        requete.textContent = e.dataset.requete ?? '';
        return;
      }
      fenOutils.classList.add('est-consulte');
      source.classList.add('est-interroge');
      const etatOutil = source.querySelector('[data-outil-etat]');
      if (etatOutil && source.dataset.trouve) etatOutil.textContent = source.dataset.trouve;
    };

    const eteindre = () => {
      [fenBase, fenOutils].forEach((f) => f.classList.remove('est-consulte', 'est-trouve'));
      articles.forEach((a) => a.classList.remove('est-parcouru', 'est-trouve'));
      outils.forEach((o) => {
        o.classList.remove('est-interroge');
        const etatOutil = o.querySelector('[data-outil-etat]');
        if (etatOutil) etatOutil.textContent = 'Connecté';
      });
      requete.textContent = '';
      traces.replaceChildren();
    };

    /* `actif` est l'échange que le plan étroit montre : il n'en affiche qu'un
       à la fois. Sur le grand plan les deux tiennent l'un sous l'autre. */
    const viderAgent = (actif = 0) => {
      echanges.forEach((e, i) => {
        e.classList.remove('est-pose', 'est-cherche', 'est-repondu', 'est-source');
        e.classList.toggle('est-actif', i === actif);
      });
      eteindre();
    };

    /* Un échange terminé, d'un coup : la question, la réponse, sa source. */
    const poserEchange = (e: HTMLElement) => {
      const texte = e.querySelector<HTMLElement>('[data-texte]');
      if (texte) texte.textContent = e.dataset.reponse ?? '';
      e.classList.add('est-pose', 'est-cherche', 'est-repondu', 'est-source');
      allumer(e, sourceDe(e));
    };

    /* Le fil entre la source consultée et la conversation : il arrive sur le
       bord de la fenêtre, à hauteur de la bulle (grand plan), ou monte droit
       de la pastille vers elle (plan étroit). */
    const relier = (source: HTMLElement, bulle: HTMLElement) => {
      const c = cadreDe(fenChat);
      const s = cadreDe(source);
      const b = cadreDe(bulle);
      const aCote = s.x >= c.x + c.w;
      const de = aCote ? { x: s.x, y: s.y + s.h / 2 } : { x: s.x + s.w / 2, y: s.y };
      const vers = aCote ? { x: c.x + c.w, y: b.y + b.h / 2 } : { x: de.x, y: c.y + c.h };
      const milieu = {
        x: (de.x + vers.x) / 2 + (vers.y - de.y) * 0.25,
        y: (de.y + vers.y) / 2 - (vers.x - de.x) * 0.25,
      };
      const p = chemin(de, milieu, vers);
      p.classList.add('fil-source');
      traces.append(p);
      p.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 280, fill: 'forwards' });
    };

    /* L'agent consulte sa source : il tape sa recherche et parcourt les
       articles jusqu'au bon, ou interroge l'outil. Rend la source trouvée,
       ou rien si la scène a changé de mode entre-temps. */
    async function consulter(e: HTMLElement, j: number) {
      const source = sourceDe(e);
      if (e.dataset.origine === 'base') {
        fenBase.classList.add('est-consulte');
        const visibles = lignes('[data-article]');
        if (visibles.length) {
          await taper(requete, e.dataset.requete ?? '', 320, j);
          for (const a of visibles) {
            if (j !== jeton) return null;
            if (a === source) break;
            a.classList.add('est-parcouru');
            await pause(100);
            a.classList.remove('est-parcouru');
          }
        } else {
          await pause(420);
        }
      } else {
        fenOutils.classList.add('est-consulte');
        await pause(420);
      }
      if (j !== jeton) return null;
      allumer(e, source);
      return source;
    }

    /* Un échange : l'heure tourne, le client écrit, l'agent cherche, la
       réponse quitte sa source pour la bulle, s'écrit, et cite d'où elle
       vient. */
    async function echanger(e: HTMLElement, j: number) {
      const bulle = e.querySelector<HTMLElement>('[data-bulle]');
      const texte = e.querySelector<HTMLElement>('[data-texte]');
      if (!bulle || !texte) return;
      fixerNuit(e.dataset.jour ?? '', Number(e.dataset.minutes ?? 0));
      await pause(320);
      if (j !== jeton) return;
      e.classList.add('est-pose');
      await pause(540);
      if (j !== jeton) return;
      e.classList.add('est-cherche');
      await pause(260);
      if (j !== jeton) return;
      const source = await consulter(e, j);
      if (!source || j !== jeton) return;
      relier(source, bulle);
      await voler(bandes[0], source, bulle, 0, 480);
      if (j !== jeton) return;
      texte.textContent = '';
      e.classList.add('est-repondu');
      await taper(texte, e.dataset.reponse ?? '', 420, j);
      if (j !== jeton) return;
      e.classList.add('est-source');
    }

    /* La conversation sort, `entre` la change, elle revient : c'est ainsi
       qu'elle se vide, et que le plan étroit passe d'une question à l'autre. */
    async function tournerConversation(j: number, entre: () => void) {
      await fini(
        conversation.animate([{ translate: '0 0', opacity: 1 }, { translate: '0 -12px', opacity: 0 }], {
          duration: 280,
          easing: 'cubic-bezier(0.5, 0, 0.75, 0)',
        }),
      );
      if (j !== jeton) return;
      entre();
      await fini(
        conversation.animate([{ translate: '0 12px', opacity: 0 }, { translate: '0 0', opacity: 1 }], {
          duration: 280,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        }),
      );
    }

    async function boucleAgent(j: number, retard: number) {
      curseur.dataset.etat = 'cache';
      viderAgent();
      solder(j, true);
      /* La nuit tombe pendant que les fenêtres arrivent. */
      const premier = echanges[0];
      if (premier) fixerNuit(premier.dataset.jour ?? '', Number(premier.dataset.minutes ?? 0));
      await pause(retard);
      while (j === jeton) {
        for (let i = 0; i < echanges.length; i++) {
          await attendreEcran();
          if (j !== jeton) return;
          if (i > 0) {
            await pause(780);
            if (j !== jeton) return;
            if (etroit.matches) {
              await tournerConversation(j, () => viderAgent(i));
              if (j !== jeton) return;
            } else {
              traces.replaceChildren();
            }
          }
          await echanger(echanges[i], j);
          if (j !== jeton) return;
        }
        /* Deux clients, deux heures de la nuit, deux sources : la réponse a
           dit ce qu'elle avait à dire. */
        conclure();
        await pause(2600);
        if (j !== jeton) return;
        await tournerConversation(j, () => viderAgent());
      }
    }

    /* ── Dashboard : le suivi de projets ── */
    const compterPiles = (anime: boolean) => {
      ETATS.forEach((etat) => {
        const n = piles[etat].childElementCount;
        tous(`[data-compte="${etat}"]`).forEach((el) => {
          if (el.textContent === String(n)) return;
          if (anime) ecrire(el, n, 14);
          else el.textContent = String(n);
        });
      });
    };

    /* Chaque carte retrouve la colonne et l'avancement du balisage. */
    const ranger = () => {
      departCartes.forEach(({ carte, etat, p }) => {
        piles[etat].append(carte);
        carte.dataset.etat = etat;
        carte.style.setProperty('--p', p);
        carte.classList.remove('en-vol');
      });
    };

    /* Le tableau vide : les cartes rangées mais pas encore posées, et les
       indicateurs à zéro, puisqu'ils comptent les cartes. */
    const viderTableau = () => {
      ranger();
      cartes.forEach((c) => c.classList.remove('est-la'));
      compterPiles(false);
      indicateurs.forEach((el) => (el.textContent = '0'));
    };

    /* Les cartes se distribuent, colonne après colonne, et les indicateurs
       comptent jusqu'à ce qu'elles disent. */
    const distribuer = (j: number) => {
      cartes.forEach((c, i) => window.setTimeout(() => j === jeton && c.classList.add('est-la'), i * 50));
      indicateurs.forEach((el) => compter(el, 0, piles[etatDe(el.dataset.compte)].childElementCount, 800, j));
    };

    /* Un projet avance : sa carte quitte une colonne pour le haut de la
       suivante. Toutes les cartes sont mesurées avant et après, et chacune
       glisse de son ancienne place à la nouvelle ; celle qui change de
       colonne se soulève en passant. */
    const avancer = (de: Etat, vers: Etat) => {
      const carte = de === 'cours' ? piles.cours.lastElementChild : piles.afaire.firstElementChild;
      if (!(carte instanceof HTMLElement)) return;
      const avant = new Map(cartes.map((c) => [c, cadreDe(c)]));
      piles[vers].prepend(carte);
      carte.dataset.etat = vers;
      carte.style.setProperty('--p', vers === 'livre' ? '100' : '15');
      cartes.forEach((c) => {
        const a = avant.get(c);
        const z = cadreDe(c);
        if (!a || (a.x === z.x && a.y === z.y)) return;
        const dx = a.x - z.x;
        const dy = a.y - z.y;
        c.animate(
          c === carte
            ? [
                { translate: `${dx}px ${dy}px`, scale: 1 },
                { translate: `${dx * 0.5}px ${dy * 0.5 - 12}px`, scale: 1.06, offset: 0.5 },
                { translate: '0 0', scale: 1 },
              ]
            : [{ translate: `${dx}px ${dy}px` }, { translate: '0 0' }],
          { duration: c === carte ? 780 : 520, easing: 'cubic-bezier(0.3, 0, 0.2, 1)' },
        );
      });
      carte.classList.add('en-vol');
      window.setTimeout(() => carte.classList.remove('en-vol'), 780);
      compterPiles(true);
    };

    async function boucleTableau(j: number, retard: number) {
      curseur.dataset.etat = 'cache';
      viderTableau();
      solder(j, true);
      /* La fenêtre se lève d'abord ; ses cartes arrivent sur elle. */
      await pause(retard);
      await attendreEcran();
      if (j !== jeton) return;
      distribuer(j);
      await pause(cartes.length * 50 + 700);
      while (j === jeton) {
        for (let i = 0; i < MOUVEMENTS.length; i++) {
          await pause(1650);
          await attendreEcran();
          if (j !== jeton) return;
          avancer(MOUVEMENTS[i][0], MOUVEMENTS[i][1]);
          /* Un projet livré, un autre lancé : on a vu le tableau vivre. */
          if (i >= 1) conclure();
        }
        /* La semaine suivante : le tableau repart de son état de départ. */
        await pause(2200);
        if (j !== jeton) return;
        cartes.forEach((c) => c.classList.remove('est-la'));
        await pause(360);
        if (j !== jeton) return;
        ranger();
        compterPiles(true);
        cartes.forEach((c, i) => window.setTimeout(() => j === jeton && c.classList.add('est-la'), i * 50));
        await pause(cartes.length * 50 + 500);
      }
    }

    /* ── Sans mouvement : une image fixe par façon de faire ── */
    const figer = () => {
      viderLignes();
      viderAgent();
      viderTableau();
      const docs = lignes('[data-ligne-doc]');
      const facts = lignes('[data-ligne-facture]');
      curseur.dataset.etat = 'cache';
      const regle = mode !== 'main';
      elGestes.textContent = regle ? '0' : '2';
      elAttente.textContent = regle ? '0' : String(ATTENTE_DEPART);
      blocAttente.classList.toggle('est-vide', regle);
      /* L'horloge s'arrête à l'heure de l'image : la nuit pour l'agent, le
         jour pour tout le reste. */
      remontee += 1;
      enRemontee = false;
      const premier = echanges[0];
      nuit =
        mode === 'agent' && premier
          ? { jour: premier.dataset.jour ?? '', minutes: Number(premier.dataset.minutes ?? 0) }
          : null;
      puceHorloge.classList.toggle('est-nuit', nuit !== null);
      if (nuit) afficher(nuit.jour, nuit.minutes);
      else afficher(JOURS[jour], minutes);
      if (mode === 'main') {
        docs.slice(0, 2).forEach((d) => d.classList.add('est-fait'));
        facts.slice(0, 2).forEach((f) => f.classList.add('est-rempli'));
      } else if (mode === 'auto') {
        docs.forEach((d) => d.classList.add('est-lu'));
        facts.forEach((f) => f.classList.add('est-rempli', 'est-valide'));
        etatFacture(true);
      } else if (mode === 'agent') {
        /* Les échanges terminés : les deux sur le grand plan, le premier
           seulement sur le plan étroit. */
        echanges.filter((e) => e.offsetParent !== null).forEach(poserEchange);
      } else {
        cartes.forEach((c) => c.classList.add('est-la'));
        compterPiles(false);
      }
      majTotal();
    };

    /* Une boucle qui lève s'arrêterait sans bruit, scène figée au milieu d'un
       geste. Ici elle laisse une trace, arrête ses sœurs et la scène retombe
       sur son image fixe, celle du mouvement réduit. */
    const veiller = (boucle: Promise<void>, nom: string) => {
      boucle.catch((erreur: unknown) => {
        console.error(`Scène du récit : la boucle « ${nom} » s’est arrêtée`, erreur);
        jeton += 1;
        deroule += 1;
        figer();
      });
    };

    /* Le temps d'un changement de réponse, le plan tourne en mouvement de
       caméra (voir `.bascule` dans les styles) ; ensuite il retrouve la
       vivacité qu'il lui faut pour suivre le pointeur. */
    let finBascule = 0;
    const basculer = () => {
      scene.classList.add('bascule');
      window.clearTimeout(finBascule);
      finBascule = window.setTimeout(() => scene.classList.remove('bascule'), 1200);
    };

    const changerMode = (m: Mode) => {
      if (m === mode) return;
      const avant = mode;
      mode = m;
      jeton += 1;
      acheve = 0;
      scene.dataset.mode = m;
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBouton === m)));
      [curseur, doc, conversation, ...bandes, ...cartes].forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
      curseur.classList.remove('porte');
      traces.replaceChildren();
      if (reduit) return figer();
      basculer();
      /* En quittant l'agent de support, le jour revient : l'horloge se
         remonte jusqu'à l'heure de la semaine de travail. */
      puceHorloge.classList.toggle('est-nuit', m === 'agent');
      if (avant === 'agent') {
        nuit = null;
        remonter(JOURS[jour], minutes, 760);
      }
      /* Les fenêtres arrivent par une transition : une boucle dont les
         trajets partent d'elles attend qu'elles soient en place. Entre la
         copie et l'automatisation rien ne bouge, l'attente est courte. */
      const deplace = avant === 'agent' || avant === 'tableau';
      if (m === 'auto') {
        veiller(boucleAuto(jeton, deplace ? 900 : 360), 'automatisation');
      } else if (m === 'agent') {
        veiller(boucleAgent(jeton, 760), 'agent IA');
      } else if (m === 'tableau') {
        veiller(boucleTableau(jeton, 620), 'dashboard');
      } else {
        viderLignes();
        if (attente < ATTENTE_DEPART) {
          compter(elAttente, attente, ATTENTE_DEPART, 700, jeton);
          attente = ATTENTE_DEPART;
          blocAttente.classList.remove('est-vide');
        }
        veiller(boucleMain(jeton, deplace ? 800 : 0), 'à la main');
        veiller(arrivees(jeton), 'arrivées');
      }
    };

    /* L'horloge. Elle a deux régimes. Le jour, c'est la semaine de travail,
       de 9 h à 18 h : à la main la journée file, au deuxième écran c'est la
       semaine, et dès que la machine travaille elle reprend un pas
       tranquille. `nuit` est l'heure de l'agent de support : tant qu'elle
       est posée, c'est elle qu'on lit et la semaine attend. */
    let nuit: { jour: string; minutes: number } | null = null;
    let minuteAffichee = -1;
    let affiche = minutes;
    let dernier = performance.now();
    let horloge = 0;
    const afficher = (nom: string, min: number) => {
      affiche = min;
      if (elJour.textContent !== nom) elJour.textContent = nom;
      aigMin.setAttribute('transform', `rotate(${(min % 60) * 6})`);
      aigH.setAttribute('transform', `rotate(${(min / 60) * 30})`);
      const m = Math.floor(min);
      if (m !== minuteAffichee) {
        minuteAffichee = m;
        elHeure.textContent = `${Math.floor(m / 60) % 24} h ${String(m % 60).padStart(2, '0')}`;
      }
    };

    /* Remonter l'horloge : les aiguilles filent en avant jusqu'à l'heure
       voulue, et le jour change à mi-course. C'est ce qui dit qu'on a changé
       de moment. Tant qu'elle dure, l'affichage ordinaire lui laisse la
       main ; une remontée plus récente la remplace. */
    let remontee = 0;
    let enRemontee = false;
    const remonter = (nom: string, cible: number, duree: number) => {
      const tour = ++remontee;
      enRemontee = true;
      const de = affiche % 1440;
      const ancien = elJour.textContent ?? nom;
      let vers = cible;
      while (vers < de + 180) vers += 1440;
      const debut = performance.now();
      const pas = (t: number) => {
        if (tour !== remontee) return;
        const a = Math.min(1, Math.max(0, (t - debut) / duree));
        const e = a < 0.5 ? 4 * a * a * a : 1 - Math.pow(-2 * a + 2, 3) / 2;
        if (a < 1) {
          afficher(a < 0.5 ? ancien : nom, de + (vers - de) * e);
          requestAnimationFrame(pas);
        } else {
          enRemontee = false;
          afficher(nom, cible);
        }
      };
      requestAnimationFrame(pas);
    };

    /* L'heure de l'agent de support. Déjà à cette heure-là, on n'y touche
       pas : la remonter ferait faire un tour complet aux aiguilles. */
    const fixerNuit = (nom: string, min: number) => {
      if (nuit && nuit.jour === nom && Math.abs(nuit.minutes - min) < 30) return;
      nuit = { jour: nom, minutes: min };
      remonter(nom, min, 760);
    };

    /* L'horloge ne demande une image que si la scène est à l'écran : hors
       champ, plus rien ne réveille la page. `planifier` la relance. */
    const planifier = () => {
      /* En mouvement réduit l'horloge reste à l'heure de son image fixe :
         c'était le seul élément de la scène à bouger encore. */
      if (reduit) return;
      if (!horloge && aLEcran()) horloge = requestAnimationFrame(battre);
    };
    const battre = (t: number) => {
      horloge = 0;
      /* Borné des deux côtés : l'heure d'une image peut précéder celle du
         montage, et un long arrêt ne doit pas faire sauter les aiguilles. */
      const dt = Math.max(0, Math.min(80, t - dernier));
      dernier = t;
      if (aLEcran()) {
        if (nuit) {
          nuit.minutes += (0.15 * dt) / 1000;
          if (!enRemontee) afficher(nuit.jour, nuit.minutes);
        } else {
          const cible = mode !== 'main' ? 0.7 : acte === 2 ? 52 : 5;
          vitesse += (cible - vitesse) * 0.035;
          minutes += (vitesse * dt) / 1000;
          if (minutes >= 18 * 60) {
            minutes = 9 * 60;
            jour = (jour + 1) % JOURS.length;
          }
          if (!enRemontee) afficher(JOURS[jour], minutes);
        }
      }
      planifier();
    };

    /* ── La régie ──
       Elle joue une suite de temps, en boucle : les trois réponses sur grand
       écran, le déroulé complet en une colonne. Seul le temps passé à l'écran
       compte ; hors champ, elle reste sur le temps en cours. Un jeton à elle
       (`deroule`) l'arrête, comme `jeton` arrête les boucles. */
    let deroule = 0;
    async function derouler(j: number, temps: Temps[]) {
      let i = 0;
      while (j === deroule) {
        const t = temps[i];
        acte = t.acte;
        scene.dataset.acte = String(t.acte);
        changerMode(t.mode);
        let ecoule = 0;
        let repere = performance.now();
        for (;;) {
          await pause(150);
          if (j !== deroule) return;
          const maintenant = performance.now();
          const vu = aLEcran();
          if (vu) ecoule += Math.min(300, maintenant - repere);
          repere = maintenant;
          if (!vu) continue;
          if (ecoule >= t.plafond) break;
          if (acheve && ecoule >= t.mini && maintenant - acheve >= t.tenue) break;
        }
        i = (i + 1) % temps.length;
      }
    }

    /* Ce que le visiteur a choisi au bouton, tant que la scène est à l'écran.
       Le récit ne le contredit pas : il reprend la main quand la scène sort. */
    let choix: Mode | null = null;

    /* Sur grand écran, le récit a la main : le travail à la main pour les deux
       premières phrases, la ronde des trois réponses pour la troisième. En
       mouvement réduit il n'y a pas de ronde, seulement l'image de
       l'automatisation. */
    const suivreRecit = () => {
      deroule += 1;
      if (acte === 3 && !reduit) veiller(derouler(deroule, REPONSES), 'réponses');
      else changerMode(acte === 3 ? 'auto' : 'main');
    };

    const fixerActe = (n: number) => {
      if (n === acte) return;
      acte = n;
      scene.dataset.acte = String(n);
      if (!choix) suivreRecit();
    };

    /* Sur grand écran : quelle phrase est à l'écran, la dernière dont le titre
       a passé les quatre cinquièmes de la fenêtre. La troisième lance les
       réponses. Le même passage dit si la scène est à l'écran : hors champ,
       les boucles attendent. */
    let attenteImage = false;
    const situer = () => {
      attenteImage = false;
      const r = scene.getBoundingClientRect();
      visible = r.bottom > 0 && r.top < window.innerHeight;
      planifier();
      if (!visible && choix) {
        /* La scène est sortie : le récit reprend la main, pour la retrouver
           au bon temps quand on y reviendra. */
        choix = null;
        if (annonce) annonce.textContent = '';
        if (colonne.matches) {
          if (!reduit) veiller(derouler(++deroule, DEROULE), 'déroulé');
        } else {
          suivreRecit();
        }
      }
      if (colonne.matches) return;
      let n = 1;
      for (const titre of titres) {
        if (titre.el.getBoundingClientRect().top < window.innerHeight * 0.8) n = titre.n;
      }
      fixerActe(n);
    };

    /* Le régime change (rotation, fenêtre redimensionnée) : on repart du
       récit. Sur grand écran, la phrase à l'écran est relue même si son
       numéro n'a pas changé, sans quoi la scène resterait sur le temps où la
       colonne l'avait laissée. */
    const regler = () => {
      deroule += 1;
      choix = null;
      if (annonce) annonce.textContent = '';
      if (reduit) return situer();
      if (colonne.matches) {
        veiller(derouler(deroule, DEROULE), 'déroulé');
      } else {
        acte = 0;
        situer();
      }
    };
    const surDefilement = () => {
      if (attenteImage) return;
      attenteImage = true;
      requestAnimationFrame(situer);
    };

    boutons.forEach((b) =>
      b.addEventListener('click', () => {
        const voulu = b.dataset.modeBouton;
        if (!estMode(voulu)) return;
        /* Un appui arrête la régie : la scène reste sur ce qu'on a choisi,
           jusqu'à ce qu'elle sorte de l'écran. */
        choix = voulu;
        deroule += 1;
        changerMode(voulu);
        /* La scène est muette pour un lecteur d'écran : le bouton dit ce
           qu'elle montre. Seulement au clic, pas quand le récit avance seul. */
        if (annonce) annonce.textContent = ANNONCES[voulu];
      }),
    );
    /* Les boutons sortent masqués du HTML : sans ce script ils seraient là,
       et inertes. */
    scene.querySelector<HTMLElement>('[data-mode-groupe]')?.removeAttribute('hidden');

    /* Le plan des fenêtres s'incline un peu vers le pointeur. */
    if (!reduit && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      cadre.addEventListener('pointermove', (e) => {
        const r = cadre.getBoundingClientRect();
        monde.style.setProperty('--ix', `${(((e.clientX - r.left) / r.width) * 2 - 1) * 5}deg`);
        monde.style.setProperty('--iy', `${(((e.clientY - r.top) / r.height) * 2 - 1) * -4}deg`);
      });
      cadre.addEventListener('pointerleave', () => {
        monde.style.removeProperty('--ix');
        monde.style.removeProperty('--iy');
      });
    }

    new ResizeObserver(ajuster).observe(cadre);
    ajuster();
    poser({ x: monde.offsetWidth * 0.55, y: monde.offsetHeight * 0.3 });

    window.addEventListener('scroll', surDefilement, { passive: true });
    window.addEventListener('resize', surDefilement, { passive: true });
    document.addEventListener('visibilitychange', planifier);
    /* `addEventListener` manque sur cet objet avant Safari 14 : sans lui, la
       scène garde simplement le régime de son chargement. */
    colonne.addEventListener?.('change', regler);

    if (reduit) {
      /* Des images fixes, qui suivent le récit : à la main pour les deux
         premières phrases, l'automatisation pour la troisième. */
      figer();
      situer();
      return;
    }

    situer();
    if (mode === 'main') {
      veiller(boucleMain(jeton, 0), 'à la main');
      veiller(arrivees(jeton), 'arrivées');
    }
    if (colonne.matches) veiller(derouler(++deroule, DEROULE), 'déroulé');
  }
</script>
