---
/*
 * home-story — le récit qui suit la première phrase de l'accueil.
 *
 * Le premier écran (`home-hero`) présente Lilian. Ici, la page prend
 * position, dans l'ordre qu'il a donné : vous avez la sensation de perdre
 * votre temps, vous avez raison ; voilà pourquoi ; voilà pourquoi automatiser.
 * La suite de la page répond à « pourquoi moi ».
 *
 * À côté du texte, une scène reste en place pendant qu'on défile. C'est un
 * panneau éclairé, dans l'esprit des sites que Lilian a désignés (Novu,
 * Vimcal) : une lueur pêche et une lueur froide, du grain, et deux fenêtres
 * d'interface posées en perspective, dessinées finement. À gauche le bon de
 * commande en PDF, à droite la facture à remplir. Un curseur recopie les
 * lignes une à une pendant que l'horloge file et que les commandes en attente
 * s'accumulent.
 *
 * Au troisième écran, la scène ne donne pas une réponse mais trois, à la
 * suite et en boucle, sur les MÊMES commandes : elle sert d'ouverture aux
 * métiers détaillés plus bas dans la page, sans les répéter.
 *   1. Automatisation : le surligneur lit la page d'un trait, les lignes
 *      partent seules, le total se calcule, la facture est émise, la file
 *      d'attente se vide et le panneau s'éclaire.
 *   2. Agent IA : la facture se retire, un volet sort de derrière le bon de
 *      commande. Un trait de lecture descend la page, chaque ligne reçoit sa
 *      coche, une seule est signalée, et le curseur revient pour l'unique
 *      geste qui reste : valider le doute.
 *   3. Dashboard : les lignes quittent la page et deviennent les barres d'un
 *      tableau de bord, qui se lève devant le bon de commande rangé derrière
 *      lui. Le nombre de commandes traitées, zéro ressaisie, les dernières
 *      factures émises.
 * D'une réponse à l'autre, le plan change d'inclinaison : c'est un changement
 * de point de vue, pas de décor. Le bon de commande ne quitte jamais la scène.
 *
 * La scène rejoue un cas réel, celui d'Humble+, où un agent extrait les
 * données puis contrôle le client, les références et les montants, et laisse
 * à un humain la validation du cas douteux. Les références, quantités,
 * montants et compteurs sont une illustration, pas une donnée client. Le seul
 * résultat annoncé, « plus aucune ressaisie », vient du cas publié.
 *
 * Sur téléphone et tablette, la scène n'est pas fixée : elle est posée après
 * la première phrase et déroule seule ses temps (à la main, la semaine qui
 * file, puis les trois réponses), pour que le défilement reste celui d'une
 * page ordinaire.
 *
 * Sans script, le texte est lisible et la scène est une image fixe, sans ses
 * boutons. En mouvement réduit, elle montre des images fixes : celle du
 * travail à la main, puis celle de l'automatisation quand la troisième phrase
 * arrive ; les boutons passent d'une image à l'autre, sans animation. Hors
 * écran ou onglet masqué, les boucles et l'horloge s'arrêtent.
 *
 * Le bouton a le dernier mot : une fois qu'on a choisi une façon de faire, ni
 * le défilement ni la ronde des réponses ne la changent tant que la scène
 * reste à l'écran.
 */
import LinkCTA from './LinkCTA.astro';

interface Segment {
  t: string;
  mark?: boolean;
}

const actes: { id: string; titre: Segment[]; suite: string }[] = [
  {
    id: 'constat',
    titre: [{ t: 'Vous avez la sensation de perdre votre temps\u00a0?' }, { t: 'Vous avez raison.', mark: true }],
    suite:
      'Regardez : une commande recopiée à la main, d’un outil à l’autre, ligne après ligne, pendant que l’horloge tourne. Quelqu’un fait sûrement ça chez vous, en ce moment même.',
  },
  {
    id: 'pourquoi',
    titre: [{ t: 'Personne n’a monté sa boîte pour faire' }, { t: 'du copier-coller.', mark: true }],
    suite:
      'Et pourtant. Copier, coller, vérifier, relancer : le même geste cent fois, fait par des gens payés pour réfléchir. Chaque geste est court, personne ne le compte, et la semaine y passe.',
  },
  {
    id: 'automatiser',
    titre: [{ t: 'Ce qui se répète n’a pas' }, { t: 'besoin de vous.', mark: true }],
    suite:
      'Une automatisation fait passer l’information, un agent IA la lit et la contrôle, un tableau de bord la montre. Chez Humble+, il n’y a plus aucune ressaisie entre le bon de commande et la facture.',
  },
];

/* Chaque mot reçoit son rang dans la phrase : c'est lui qui règle son retard
   d'apparition. Le fragment surligné compte comme les autres, il arrive en
   dernier et c'est la pastille qui l'écrit. */
const actesRendus = actes.map((acte) => {
  let rang = 0;
  const titre = acte.titre.map((segment) => ({
    mark: segment.mark,
    mots: segment.t.split(' ').map((mot) => ({ mot, rang: rang++ })),
  }));
  return { ...acte, titre, total: rang };
});

/* Les lignes du bon de commande. Références, quantités et montants inventés
   pour la scène ; la désignation est une barre, pas un nom de produit. `l`
   est la longueur de cette barre, en pour cent ; `montant` sert au total. */
const lignes = [
  { ref: 'A-2041', qte: '12', prix: '84,00', montant: 84, l: 78 },
  { ref: 'A-2044', qte: '6', prix: '45,60', montant: 45.6, l: 56 },
  { ref: 'B-1180', qte: '24', prix: '132,00', montant: 132, l: 88 },
  { ref: 'B-1192', qte: '3', prix: '27,90', montant: 27.9, l: 48 },
  { ref: 'C-0307', qte: '10', prix: '59,00', montant: 59, l: 66 },
];

/* Le tableau de bord, troisième réponse. Cinq jours de commandes (`h` est la
   hauteur de la barre, en pour cent ; le dernier jour est aujourd'hui), le
   nombre de commandes traitées et les dernières factures. Tout est inventé
   pour la scène, comme les lignes ; la première facture reprend seulement le
   total du bon de commande qu'on vient de voir passer. La liste a une ligne
   de plus qu'elle n'en montre : c'est celle qui sort par le bas quand une
   nouvelle facture arrive. */
const montantFr = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const totalBon = lignes.reduce((somme, ligne) => somme + ligne.montant, 0);
const jours = [
  { initiale: 'M', h: 58 },
  { initiale: 'M', h: 74 },
  { initiale: 'J', h: 66 },
  { initiale: 'V', h: 88 },
  { initiale: 'L', h: 46 },
];
const traitees = 214;
const emises = [
  { ref: 'FA-0412', montant: montantFr.format(totalBon), l: 72 },
  { ref: 'FA-0411', montant: '512,80', l: 54 },
  { ref: 'FA-0410', montant: '196,40', l: 84 },
  { ref: 'FA-0409', montant: '274,10', l: 62 },
];
---

<section id="histoire" data-section data-story class="story relative px-[var(--spacing-section-x)]">
  <div class="story__grille relative mx-auto max-w-[1200px]">
    {actesRendus.map((acte, index) => (
      <>
        <div id={acte.id} class="acte reveal" data-acte={index + 1} style={`--mots: ${acte.total}`}>
          <h2 class="acte__titre">
            {acte.titre.map((segment) => {
              const mots = segment.mots.map(({ mot, rang }) => (
                <>
                  <span class="mot" style={`--i: ${rang}`}>{mot}</span>{' '}
                </>
              ));
              return segment.mark ? <mark>{mots}</mark> : mots;
            })}
          </h2>
          <p class="acte__suite">{acte.suite}</p>

          {index === 2 && (
            <div class="acte__preuve">
              <LinkCTA href="/cas-clients/humble-plus">Lire le cas Humble+</LinkCTA>
            </div>
          )}
        </div>

        {index === 0 && (
          <div class="story__scene">
            <div class="scene" data-scene data-mode="main" data-acte="1">
              <div class="scene__boite">
                <span class="repere repere--hg" aria-hidden="true"></span>
                <span class="repere repere--hd" aria-hidden="true"></span>
                <span class="repere repere--bg" aria-hidden="true"></span>
                <span class="repere repere--bd" aria-hidden="true"></span>
                <div class="scene__cadre">
                <div class="scene__plan" aria-hidden="true">
                  <div class="puces">
                    <span class="puce">
                      <svg class="puce__horloge" viewBox="-10 -10 20 20">
                        <circle r="8.2" />
                        <line x1="0" y1="0" x2="0" y2="-4" data-aiguille-h transform="rotate(270)" />
                        <line class="puce__minutes" x1="0" y1="0" x2="0" y2="-6.2" data-aiguille-min />
                      </svg>
                      <span data-jour>Lundi</span>
                      <b data-heure>9 h 00</b>
                    </span>
                    <span class="puce" data-attente-bloc>
                      <svg viewBox="0 0 16 16"><path d="M3 5.5l5-2.5 5 2.5-5 2.5-5-2.5zM3 8l5 2.5L13 8M3 10.5L8 13l5-2.5" /></svg>
                      <span class="puce__nom">En attente</span>
                      <b data-attente>23</b>
                    </span>
                    <span class="puce">
                      <svg viewBox="0 0 16 16"><path d="M4 2.5l8.5 5-3.8 1L7 12.5 4 2.5z" /></svg>
                      <span class="puce__nom">Gestes refaits</span>
                      <b data-gestes>0</b>
                    </span>
                  </div>

                  <div class="monde" data-monde>
                    <svg class="traces" data-traces></svg>

                    <div class="fenetre fenetre--agent" data-agent>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--app">
                          <svg viewBox="0 0 16 16"><path d="M7 2.4l1.4 3.4 3.4 1.4-3.4 1.4L7 12 5.6 8.6 2.2 7.2l3.4-1.4L7 2.4zM12.4 10.6v3M10.9 12.1h3" /></svg>
                        </span>
                        <span class="fenetre__nom">Agent IA</span>
                        <span class="agent__etat" data-agent-pastille data-etat="lecture">Lecture</span>
                      </div>
                      <div class="fenetre__corps">
                        <ul class="controles">
                          <li class="controle" data-controle="client">
                            <span>Client</span>
                            <b></b>
                            <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                          </li>
                          <li class="controle" data-controle="refs">
                            <span><span class="mot-long">Références</span><span class="mot-court">Réf.</span></span>
                            <b></b>
                            <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                          </li>
                          <li class="controle" data-controle="montants">
                            <span>Montants</span>
                            <b></b>
                            <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                          </li>
                        </ul>
                        <div class="doute" data-doute>
                          <div class="doute__fond">
                            <div class="doute__carte" data-doute-carte>
                              <div class="doute__ligne">
                                <span class="ref" data-doute-ref></span>
                                <i></i>
                                <span data-doute-qte></span>
                                <span data-doute-prix></span>
                              </div>
                              <span class="doute__mot" data-doute-mot>À valider par vous</span>
                              <span class="doute__action">
                                <span class="doute__bouton" data-doute-bouton>Valider</span>
                                <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                              </span>
                            </div>
                          </div>
                        </div>
                        <div class="resume" data-resume><span></span><span></span><span></span></div>
                      </div>
                    </div>

                    <div class="fenetre fenetre--pdf">
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--pdf">PDF</span>
                        <span class="fenetre__nom">bon-de-commande-0412.pdf</span>
                        <span class="fenetre__info">1 / 1</span>
                      </div>
                      <div class="fenetre__corps">
                        <div class="page" data-doc>
                          <div class="page__tete">
                            <b>Bon de commande</b>
                            <span>N° BC-0412</span>
                          </div>
                          <div class="page__bloc"><i></i><i></i><i></i></div>
                          <div class="colonnes">
                            <span>Réf.</span><span>Désignation</span><span>Qté</span><span>Total HT</span>
                          </div>
                          <ul>
                            {lignes.map((ligne) => (
                              <li
                                class="doc__ligne"
                                data-ligne-doc
                                data-valeur={`${ligne.ref} · ${ligne.qte} · ${ligne.prix} €`}
                                data-ref={ligne.ref}
                                data-qte={ligne.qte}
                                data-prix={ligne.prix}
                              >
                                <span class="ref">{ligne.ref}</span>
                                <i style={`width: ${ligne.l}%`}></i>
                                <span>{ligne.qte}</span>
                                <span>{ligne.prix}</span>
                                <svg class="avis" viewBox="0 0 16 16">
                                  <path class="avis__ok" d="M4.4 8.4l2.4 2.4 4.8-5.2" />
                                  <path class="avis__doute" d="M8 4.2v4.6M8 11.4v.4" />
                                </svg>
                              </li>
                            ))}
                          </ul>
                          <span class="lecture" data-lecture></span>
                        </div>
                      </div>
                    </div>

                    <div class="fenetre fenetre--app" data-facture>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--app">
                          <svg viewBox="0 0 16 16"><path d="M4 2.5h8v11l-2-1.2-2 1.2-2-1.2-2 1.2v-11zM6 6h4M6 8.5h4" /></svg>
                        </span>
                        <span class="fenetre__nom">Nouvelle facture</span>
                        <span class="facture__etat" data-etat="brouillon">Brouillon</span>
                      </div>
                      <div class="fenetre__corps">
                        <div class="champ">
                          <span class="champ__nom">Client</span>
                          <span class="champ__valeur"><em></em><i></i></span>
                        </div>
                        <div class="colonnes colonnes--app">
                          <span>Réf.</span><span>Désignation</span><span>Qté</span><span>Total HT</span><span></span>
                        </div>
                        <ul>
                          {lignes.map((ligne) => (
                            <li class="facture__ligne" data-ligne-facture data-montant={ligne.montant} style={`--l: ${ligne.l}%`}>
                              <span class="ref">{ligne.ref}</span>
                              <i></i>
                              <span>{ligne.qte}</span>
                              <span>{ligne.prix}</span>
                              <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-6.5" /></svg>
                            </li>
                          ))}
                        </ul>
                        <div class="pied">
                          <span>Total HT</span>
                          <b data-total>0,00 €</b>
                          <span class="pied__bouton">Émettre</span>
                        </div>
                      </div>
                    </div>

                    <div class="fenetre fenetre--tableau" data-tableau>
                      <div class="fenetre__barre">
                        <span class="fenetre__icone fenetre__icone--app">
                          <svg viewBox="0 0 16 16"><path d="M3.2 13V8.6M6.4 13V5.2M9.6 13V7.2M12.8 13V3" /></svg>
                        </span>
                        <span class="fenetre__nom">Tableau de bord</span>
                        <span class="fenetre__info">Cinq derniers jours</span>
                      </div>
                      <div class="fenetre__corps">
                        <div class="chiffre">
                          <span class="chiffre__nom">Commandes traitées</span>
                          <b class="chiffre__valeur" data-traitees data-cible={traitees}>{traitees}</b>
                          <div class="chiffre__suite">
                            <span class="jeton jeton--zero">Ressaisies <b>0</b></span>
                            <span class="jeton jeton--attente">En attente <b>0</b></span>
                          </div>
                        </div>
                        <div class="barres">
                          {jours.map((jour) => (
                            <span class="barre" data-barre style={`--h: ${jour.h}`}>
                              <span class="barre__fut"><i></i><span class="barre__pied" data-pied></span></span>
                              <em>{jour.initiale}</em>
                            </span>
                          ))}
                        </div>
                        <div class="dernieres">
                          <span class="dernieres__nom">Dernières factures</span>
                          <ul>
                            {emises.map((facture) => (
                              <li class="emise" data-emise data-ref={facture.ref} data-montant={facture.montant} data-l={facture.l} style={`--l: ${facture.l}%`}>
                                <span class="ref">{facture.ref}</span>
                                <i></i>
                                <span class="emise__montant">{facture.montant}&nbsp;€</span>
                                <span class="emise__etat">Émise</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>

                    <div class="bandes">
                      {lignes.map(() => <span class="bande"></span>)}
                    </div>

                    <div class="curseur" data-curseur>
                      <svg viewBox="0 0 24 24"><path d="M5 3l14 8.2-6.2 1.6L9.6 19 5 3z" /></svg>
                      <span class="curseur__valeur" data-porte></span>
                    </div>
                  </div>
                </div>
                </div>
              </div>

              <div class="scene__mode" role="group" aria-label="La même commande, de quatre façons" hidden data-mode-groupe>
                <button type="button" data-mode-bouton="main" aria-pressed="true">À la main</button>
                <button type="button" data-mode-bouton="auto" aria-pressed="false" aria-label="Automatisation">
                  <span class="mot-long">Automatisation</span><span class="mot-court">Auto</span>
                </button>
                <button type="button" data-mode-bouton="agent" aria-pressed="false">Agent IA</button>
                <button type="button" data-mode-bouton="tableau" aria-pressed="false">Dashboard</button>
              </div>
              <p class="sr-only" aria-live="polite" data-annonce></p>
            </div>
          </div>
        )}
      </>
    ))}
  </div>
</section>

<style>
  .story {
    --trait: color-mix(in srgb, var(--color-ink) 9%, transparent);
    border-bottom: 1px solid var(--trait);
    background: var(--color-night-deep);
  }

  /* Le texte défile à gauche, un écran par phrase ; la scène reste en place à
     droite sur toute la hauteur du récit. Les deux filets verticaux de la
     page longent la colonne ; ici, un filet horizontal sépare deux phrases,
     marqué d'une croix à son extrémité. */
  .story__grille {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    column-gap: clamp(2.5rem, 4vw, 4rem);
  }

  .acte {
    position: relative;
    grid-column: 1;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: clamp(1.25rem, 2vw, 1.75rem);
    min-height: 100svh;
    padding-block: 6rem;
  }

  .acte + .story__scene + .acte::before,
  .acte + .acte::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: calc(-1 * clamp(1rem, 2.2vw, 2rem));
    height: 1px;
    background: var(--trait);
  }

  .acte + .story__scene + .acte::after,
  .acte + .acte::after {
    content: '';
    position: absolute;
    top: -5px;
    left: calc(-1 * clamp(1rem, 2.2vw, 2rem) - 5px);
    width: 11px;
    height: 11px;
    background:
      linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 100% 1px no-repeat,
      linear-gradient(var(--color-ink-low), var(--color-ink-low)) 50% 50% / 1px 100% no-repeat;
  }

  .acte__titre {
    max-width: 13ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-story);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  /* Le fragment surligné est une pastille, comme la réponse du premier
     écran : la même bande pêche que partout ailleurs, sans son inclinaison et
     arrondie jusqu'au bout. */
  .acte__titre mark {
    --angle: 0deg;
    --radius-bande: 9999px;
    display: inline-block;
    padding: 0.02em 0.36em 0.08em;
    margin: 0.14em 0 0;
  }

  .acte__titre mark::before {
    inset: 0;
  }

  .mot {
    display: inline-block;
  }

  .acte__suite {
    max-width: 40ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.5;
  }

  /* ── Les mots se posent ──
     Chaque phrase attend d'entrer à l'écran (le `.reveal` du site), puis ses
     mots arrivent un par un. Le fragment surligné vient en dernier. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-ready) .acte.reveal .mot {
      transition:
        opacity 620ms var(--ease-out-expo),
        transform 760ms var(--ease-out-expo),
        filter 620ms var(--ease-out-expo);
      transition-delay: calc(var(--i) * 50ms + 80ms);
    }

    :global(.js-ready) .acte.reveal:not(.is-visible) .mot {
      opacity: 0;
      transform: translateY(0.45em);
      filter: blur(8px);
      transition-delay: 0ms;
    }

    :global(.js-ready) .acte.reveal.is-visible mark {
      transition-delay: calc(var(--mots) * 50ms - 60ms);
    }
  }

  /* ── La scène ── */
  .story__scene {
    grid-column: 2;
    grid-row: 1 / span 3;
    position: sticky;
    top: 64px;
    align-self: start;
    display: grid;
    align-content: center;
    justify-items: center;
    height: calc(100svh - 64px);
  }

  .scene {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    width: min(100%, calc((100svh - 64px - 8rem) * 680 / 560));
  }

  /* La boîte porte les repères d'angle, hors du panneau : quatre petites
     équerres, comme les traits de coupe d'un plan. */
  .scene__boite {
    position: relative;
    width: 100%;
  }

  .repere {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--color-ink-low);
    pointer-events: none;
  }

  .repere--hg { top: -7px; left: -7px; border-top-width: 1px; border-left-width: 1px; }
  .repere--hd { top: -7px; right: -7px; border-top-width: 1px; border-right-width: 1px; }
  .repere--bg { bottom: -7px; left: -7px; border-bottom-width: 1px; border-left-width: 1px; }
  .repere--bd { right: -7px; bottom: -7px; border-right-width: 1px; border-bottom-width: 1px; }

  /* Le panneau. Une grille fine en fond, une lueur pêche en bas à gauche et
     une lueur froide en haut à droite, juste assez pour donner de la
     profondeur. Dès que la machine travaille, une lumière chaude se lève : le
     panneau s'éclaire. Elle suit ensuite ce qu'on regarde : la facture pour
     l'automatisation, la page lue pour l'agent, tout le plan pour le tableau
     de bord. */
  .scene__cadre {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 680 / 560;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-md);
    background:
      linear-gradient(color-mix(in srgb, var(--color-ink) 5%, transparent) 1px, transparent 1px) 0 0 / 34px 34px,
      linear-gradient(90deg, color-mix(in srgb, var(--color-ink) 5%, transparent) 1px, transparent 1px) 0 0 / 34px 34px,
      radial-gradient(85% 75% at 0% 100%, color-mix(in srgb, var(--color-braise) 24%, transparent), transparent 62%),
      radial-gradient(75% 65% at 100% 0%, color-mix(in srgb, var(--color-lueur-froide) 20%, transparent), transparent 64%),
      var(--color-night-deep);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 9%, transparent);
    isolation: isolate;
  }

  /* La lumière déborde du panneau de près d'un tiers de chaque côté, pour
     pouvoir se déplacer sans montrer son bord. Les cotes du dégradé sont
     celles d'avant, rapportées à cette boîte plus grande. */
  .scene__cadre::before {
    content: '';
    position: absolute;
    inset: -30%;
    z-index: -1;
    background: radial-gradient(43.75% 37.5% at 52.5% 58.75%, color-mix(in srgb, var(--color-peche) 30%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 900ms var(--ease-out-quint), transform 1100ms var(--ease-out-quint);
  }

  .scene:not([data-mode='main']) .scene__cadre::before {
    opacity: 1;
  }

  .scene[data-mode='agent'] .scene__cadre::before {
    transform: translate(-15%, -11%);
  }

  .scene[data-mode='tableau'] .scene__cadre::before {
    transform: translate(-3%, -5%) scale(1.3);
  }

  .scene__cadre::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 6;
    background-image: var(--grain);
    opacity: 0.1;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* Le plan est dessiné à taille fixe, 680 × 560, puis mis à l'échelle de sa
     colonne par une seule variable. Toutes les positions de la scène et tous
     les trajets du curseur se calculent dans ce repère. */
  .scene__plan {
    position: absolute;
    top: 0;
    left: 0;
    width: 680px;
    height: 560px;
    transform: scale(var(--k, 0.86));
    transform-origin: 0 0;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .scene__plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scene__plan li {
    max-width: none;
  }

  /* Les pastilles d'état, à plat au-dessus de la scène : l'heure qui file, ce
     qui attend, les gestes déjà refaits. */
  .puces {
    position: absolute;
    top: 20px;
    left: 22px;
    z-index: 4;
    display: flex;
    gap: 8px;
  }

  .puce {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 12px 0 9px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-night-deep) 70%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
    color: var(--color-ink-mid);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    transition: border-color 400ms, color 400ms;
  }

  .puce b {
    display: inline-block;
    color: var(--color-ink);
    font-weight: 600;
  }

  .puce svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-ink-low);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .puce__horloge line {
    stroke: var(--color-ink);
    stroke-width: 1.5;
  }

  .puce__horloge .puce__minutes {
    stroke: var(--color-peche);
  }

  .puce.est-vide {
    border-color: color-mix(in srgb, var(--color-peche) 70%, transparent);
  }

  .puce.est-vide b {
    color: var(--color-peche);
  }

  /* Le monde : les fenêtres, le curseur et ses traces, sur un même plan
     incliné. Tout y est dans le même repère, la perspective vient après.
     L'inclinaison est le point de vue : elle change avec la réponse montrée,
     de trois quarts pour la copie et l'automatisation, presque de face pour
     l'agent qui lit, de l'autre côté pour le tableau de bord. */
  .monde {
    --recul: 1600px;
    --rx: 8deg;
    --ry: -10deg;
    --rz: 1.5deg;
    --tx: 6px;
    --ty: 12px;
    --zoom: 1;
    position: absolute;
    inset: 0;
    transform: perspective(var(--recul)) rotateX(calc(var(--rx) + var(--iy, 0deg))) rotateY(calc(var(--ry) + var(--ix, 0deg))) rotateZ(var(--rz)) translate(var(--tx), var(--ty)) scale(var(--zoom));
    transform-origin: 50% 46%;
    transition: transform 500ms var(--ease-out-quint);
  }

  /* Pour l'agent, la caméra s'approche aussi : c'est la page qu'on lit. */
  .scene[data-mode='agent'] .monde {
    --rx: 5deg;
    --ry: -4deg;
    --rz: 0.4deg;
    --tx: 5px;
    --ty: 66px;
    --zoom: 1.08;
  }

  .scene[data-mode='tableau'] .monde {
    --rx: 9deg;
    --ry: 7deg;
    --rz: -1.1deg;
    --tx: -10px;
    --ty: 30px;
  }

  /* Le temps d'un changement de réponse, le plan tourne plus lentement que
     lorsqu'il suit le pointeur : c'est un mouvement de caméra. Le script pose
     cette classe, puis la retire. */
  .scene.bascule .monde {
    transition-duration: 1100ms;
    transition-timing-function: cubic-bezier(0.6, 0, 0.2, 1);
  }

  /* Une fenêtre qui n'a pas sa place dans la réponse montrée n'est pas
     coupée : elle recule, se floute et s'efface (`--sortie` dit vers où),
     puis disparaît du rendu. Celle qui arrive attend un instant que l'autre
     ait commencé à partir. */
  .fenetre {
    position: absolute;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 12px;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-ink) 12%, transparent),
      0 30px 60px -28px var(--color-night-deep),
      0 12px 24px -16px var(--color-night-deep);
    transition:
      opacity 520ms var(--ease-out-quint) 200ms,
      filter 520ms var(--ease-out-quint) 200ms,
      transform 940ms cubic-bezier(0.25, 0.8, 0.25, 1) 200ms,
      visibility 0s;
  }

  .scene:not([data-mode='main']):not([data-mode='auto']) .fenetre--app,
  .scene:not([data-mode='agent']) .fenetre--agent,
  .scene:not([data-mode='tableau']) .fenetre--tableau {
    visibility: hidden;
    opacity: 0;
    filter: blur(10px);
    transform: var(--sortie);
    transition:
      opacity 440ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 440ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 620ms cubic-bezier(0.5, 0, 0.75, 0),
      visibility 0s 620ms;
  }

  /* Derrière le tableau de bord, le bon de commande est rangé : plus petit,
     plus terne, un peu flou. Il attend que ses lignes soient parties. */
  .scene[data-mode='tableau'] .fenetre--pdf {
    opacity: 0.55;
    filter: blur(1.5px);
    transform: translate(-12px, -22px) scale(0.92);
    transition-delay: 520ms, 520ms, 520ms, 0s;
  }

  .fenetre__barre {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding-inline: 11px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    font-size: 11.5px;
    font-weight: 500;
  }

  .fenetre__icone {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 22px;
    height: 16px;
    border-radius: 4px;
    font-size: 7.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .fenetre__icone--pdf {
    background: var(--color-braise);
    color: var(--color-night);
  }

  .fenetre__icone--app {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--color-peche);
  }

  .fenetre__icone--app svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--color-night);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .fenetre__nom {
    min-width: 0;
    overflow: hidden;
    color: var(--color-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fenetre__info {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--color-ink-low);
    font-size: 10.5px;
    white-space: nowrap;
  }

  /* ── Le bon de commande : un lecteur de PDF et sa page de papier ── */
  .fenetre--pdf {
    top: 78px;
    left: 26px;
    width: 318px;
    background: color-mix(in srgb, var(--color-surface-high) 82%, transparent);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .fenetre--pdf .fenetre__corps {
    padding: 12px 12px 14px;
  }

  .page {
    position: relative;
    padding: 14px 14px 8px;
    border-radius: 6px;
    background: var(--color-feuille);
    box-shadow: 0 8px 18px -10px var(--color-night-deep);
    color: var(--color-night);
  }

  /* Le trait de lecture de l'agent : un filet de braise qui descend la page,
     suivi de sa traîne. Le script le fait descendre ; au repos il n'existe
     pas. */
  .lecture {
    position: absolute;
    top: 0;
    right: 5px;
    left: 5px;
    z-index: 2;
    height: 2px;
    border-radius: 2px;
    background: var(--color-braise);
    box-shadow: 0 0 10px 1px color-mix(in srgb, var(--color-braise) 65%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .lecture::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 34px;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-peche) 50%, transparent), transparent);
  }

  .page__tete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .page__tete b {
    font-size: 12.5px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .page__tete span {
    color: var(--color-ink-faint);
    font-size: 9.5px;
    font-weight: 500;
  }

  .page__bloc {
    display: grid;
    gap: 4px;
    margin-top: 9px;
  }

  .page__bloc i {
    width: 44%;
    height: 4px;
    border-radius: 2px;
    background: var(--color-feuille-trait);
  }

  .page__bloc i:nth-child(2) { width: 58%; }
  .page__bloc i:nth-child(3) { width: 31%; }

  .colonnes {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 30px 54px;
    gap: 8px;
    margin-top: 13px;
    padding: 0 6px 5px;
    border-bottom: 1px solid var(--color-feuille-trait);
    color: var(--color-ink-faint);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .colonnes span:nth-child(n + 3) {
    text-align: right;
  }

  .doc__ligne {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 30px 54px;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding-inline: 6px;
    border-bottom: 1px solid var(--color-feuille-trait);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    transition: opacity 260ms var(--ease-out-quint), background-color 160ms;
  }

  .doc__ligne:last-child {
    border-bottom: 0;
  }

  .doc__ligne .ref {
    font-weight: 600;
  }

  .doc__ligne i {
    height: 5px;
    border-radius: 3px;
    background: var(--color-feuille-barre);
  }

  .doc__ligne span:nth-of-type(n + 2) {
    text-align: right;
  }

  /* Lue par la machine : la bande pêche passe sur la ligne. */
  .doc__ligne::before {
    content: '';
    position: absolute;
    inset: 3px 0;
    z-index: -1;
    border-radius: 4px;
    background: var(--color-peche);
    clip-path: inset(0 100% 0 0 round 4px);
    transition: clip-path 340ms var(--ease-out-expo);
  }

  .doc__ligne.est-lu::before {
    clip-path: inset(0 0 0 0 round 4px);
  }

  /* Copiée à la main : la sélection que tout le monde connaît. */
  .doc__ligne.est-copie {
    background: color-mix(in srgb, var(--color-lueur-froide) 18%, var(--color-feuille));
    outline: 1px solid color-mix(in srgb, var(--color-lueur-froide) 70%, transparent);
    outline-offset: -1px;
  }

  .doc__ligne.est-fait {
    opacity: 0.36;
  }

  /* Contrôlée par l'agent : la ligne se teinte et reçoit sa coche, dans la
     marge de la page. La ligne douteuse reprend la sélection froide du
     travail à la main, parce que c'est à une main qu'elle revient. */
  .avis {
    position: absolute;
    top: 50%;
    right: -14px;
    width: 13px;
    height: 13px;
    margin-top: -6.5px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
    fill: none;
    stroke: var(--color-night);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    scale: 0.3;
    transition: opacity 180ms, scale 360ms var(--ease-out-expo), background-color 220ms;
  }

  .avis__doute {
    display: none;
  }

  .doc__ligne.est-conforme {
    background: color-mix(in srgb, var(--color-peche) 24%, var(--color-feuille));
  }

  .doc__ligne.est-doute {
    background: color-mix(in srgb, var(--color-lueur-froide) 18%, var(--color-feuille));
    outline: 1px solid color-mix(in srgb, var(--color-lueur-froide) 70%, transparent);
    outline-offset: -1px;
  }

  .doc__ligne.est-conforme .avis,
  .doc__ligne.est-doute .avis {
    opacity: 1;
    scale: 1;
  }

  .doc__ligne.est-doute .avis {
    background: var(--color-lueur-froide);
    stroke: var(--color-ink);
  }

  .doc__ligne.est-doute .avis__ok { display: none; }
  .doc__ligne.est-doute .avis__doute { display: inline; }

  /* ── La facture : l'outil dans lequel on recopie, en verre sombre ── */
  .fenetre--app {
    --sortie: translate(46px, 30px) scale(0.94);
    top: 190px;
    left: 350px;
    width: 308px;
    background: color-mix(in srgb, var(--color-night-deep) 74%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--app .fenetre__corps {
    padding: 12px;
  }

  .facture__etat {
    margin-left: auto;
    padding: 3px 9px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-mid);
    font-size: 10px;
    font-weight: 600;
    transition: background-color 220ms, color 220ms, border-color 220ms;
  }

  .facture__etat[data-etat='emise'] {
    border-color: var(--color-peche);
    background: var(--color-peche);
    color: var(--color-night);
  }

  .champ {
    display: grid;
    gap: 5px;
  }

  .champ__nom,
  .colonnes--app {
    color: var(--color-ink-faint);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .champ__valeur {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding-inline: 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  .champ__valeur em {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-peche), var(--color-lueur-froide));
  }

  .champ__valeur i {
    width: 46%;
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 26%, transparent);
  }

  .colonnes--app {
    grid-template-columns: 48px minmax(0, 1fr) 28px 52px 12px;
    margin-top: 12px;
    padding: 0 8px 5px;
    border-bottom: 0;
  }

  .fenetre--app ul {
    display: grid;
    gap: 5px;
  }

  .facture__ligne {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 28px 52px 12px;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding-inline: 8px;
    border: 1px dashed color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 7px;
    font-size: 11px;
    font-weight: 500;
    transition: border-color 220ms, background-color 220ms;
  }

  .facture__ligne .ref {
    font-weight: 600;
  }

  .facture__ligne i {
    width: var(--l);
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 24%, transparent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 360ms var(--ease-out-expo);
  }

  .facture__ligne span {
    opacity: 0;
    transition: opacity 200ms;
  }

  .facture__ligne span:nth-of-type(n + 2) {
    text-align: right;
  }

  .facture__ligne svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--color-peche);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    scale: 0.4;
    transition: opacity 200ms, scale 320ms var(--ease-out-expo);
  }

  .facture__ligne.est-rempli {
    border-style: solid;
    border-color: color-mix(in srgb, var(--color-ink) 12%, transparent);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }

  .facture__ligne.est-rempli i { transform: scaleX(1); }
  .facture__ligne.est-rempli span { opacity: 1; }
  .facture__ligne.est-valide svg { opacity: 1; scale: 1; }

  .pied {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 11px;
    padding-top: 10px;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    color: var(--color-ink-low);
    font-size: 10.5px;
  }

  .pied b {
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .pied__bouton {
    margin-left: auto;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: var(--color-ink-low);
    font-size: 10.5px;
    font-weight: 600;
    transition: background-color 260ms, color 260ms;
  }

  .fenetre--app:has(.facture__etat[data-etat='emise']) .pied__bouton {
    background: var(--color-peche);
    color: var(--color-night);
  }

  /* ── L'agent : un volet qui sort de derrière le bon de commande ──
     Il est écrit avant le PDF dans le monde, donc dessous : sa sortie le
     ramène sous la page qu'il lit. Dedans, les contrôles reprennent le dessin
     des lignes de la facture (en pointillé tant que rien n'est su, pleins
     ensuite), et la carte du doute se déplie quand une ligne est signalée. */
  .fenetre--agent {
    --sortie: translate(-150px, 0) scale(0.96);
    top: 132px;
    left: 352px;
    width: 284px;
    background: color-mix(in srgb, var(--color-night-deep) 74%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--agent .fenetre__corps {
    padding: 12px;
  }

  .agent__etat {
    flex-shrink: 0;
    margin-left: auto;
    padding: 3px 10px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-mid);
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 220ms, color 220ms, border-color 220ms;
  }

  .agent__etat[data-etat='doute'] {
    border-color: color-mix(in srgb, var(--color-lueur-froide) 80%, transparent);
    background: color-mix(in srgb, var(--color-lueur-froide) 26%, var(--color-night-deep));
    color: var(--color-ink);
  }

  .agent__etat[data-etat='controle'] {
    border-color: var(--color-peche);
    background: var(--color-peche);
    color: var(--color-night);
  }

  .controles {
    display: grid;
    gap: 5px;
  }

  .controle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 12px;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding-inline: 8px;
    border: 1px dashed color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 7px;
    color: var(--color-ink-mid);
    font-size: 11.5px;
    font-weight: 500;
    transition: border-color 220ms, background-color 220ms;
  }

  .controle b {
    color: var(--color-ink);
    font-weight: 600;
  }

  .controle svg,
  .doute__action svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--color-peche);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    scale: 0.4;
    transition: opacity 200ms, scale 320ms var(--ease-out-expo);
  }

  .controle[data-ton='cours'],
  .controle[data-ton='ok'] {
    border-style: solid;
    border-color: color-mix(in srgb, var(--color-ink) 12%, transparent);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }

  .controle[data-ton='ok'] svg {
    opacity: 1;
    scale: 1;
  }

  .controle[data-ton='doute'] {
    border-style: solid;
    border-color: color-mix(in srgb, var(--color-lueur-froide) 70%, transparent);
    background: color-mix(in srgb, var(--color-lueur-froide) 16%, transparent);
  }

  .mot-court {
    display: none;
  }

  /* La carte du doute : repliée tant que l'agent n'a rien à soumettre. */
  .doute {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 460ms var(--ease-out-expo);
  }

  .doute.est-ouvert {
    grid-template-rows: 1fr;
  }

  .doute__fond {
    min-height: 0;
    overflow: hidden;
  }

  .doute__carte {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    margin-top: 9px;
    padding: 8px;
    border: 1px solid color-mix(in srgb, var(--color-lueur-froide) 70%, transparent);
    border-radius: 9px;
    background: color-mix(in srgb, var(--color-lueur-froide) 16%, transparent);
    font-size: 11.5px;
    font-weight: 500;
    opacity: 0;
    translate: 0 -8px;
    transition:
      opacity 300ms,
      translate 460ms var(--ease-out-expo),
      border-color 260ms,
      background-color 260ms;
  }

  .doute.est-ouvert .doute__carte {
    opacity: 1;
    translate: 0 0;
  }

  .doute__ligne {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 28px 52px;
    align-items: center;
    gap: 8px;
  }

  .doute__ligne .ref {
    font-weight: 600;
  }

  .doute__ligne i {
    width: 62%;
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 24%, transparent);
  }

  .doute__ligne span:nth-of-type(n + 2) {
    text-align: right;
  }

  .doute__mot {
    color: var(--color-ink-mid);
  }

  .doute__action {
    display: grid;
    align-items: center;
    justify-items: end;
  }

  .doute__action > * {
    grid-area: 1 / 1;
  }

  .doute__bouton {
    padding: 4px 13px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
    color: var(--color-night);
    font-weight: 600;
    transition: opacity 200ms, scale 200ms;
  }

  .doute.est-valide .doute__carte {
    border-color: color-mix(in srgb, var(--color-ink) 12%, transparent);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }

  .doute.est-valide .doute__mot {
    color: var(--color-ink);
  }

  .doute.est-valide .doute__bouton {
    opacity: 0;
    scale: 0.8;
  }

  .doute.est-valide .doute__action svg {
    opacity: 1;
    scale: 1;
  }

  /* Le compte rendu de l'agent, en une ligne. */
  .resume {
    display: flex;
    flex-wrap: wrap;
    margin-top: 10px;
    padding-top: 9px;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    color: var(--color-ink-mid);
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 320ms;
  }

  .resume.est-la {
    opacity: 1;
  }

  .resume span:empty {
    display: none;
  }

  .resume span + span::before {
    content: '·';
    margin-inline: 6px;
    color: var(--color-ink-faint);
    font-weight: 500;
  }

  .resume [data-ton='doute'] {
    color: color-mix(in srgb, var(--color-lueur-froide) 45%, var(--color-ink));
    font-weight: 600;
  }

  .resume [data-ton='ok'] {
    color: var(--color-peche);
    font-weight: 600;
  }

  /* ── Le tableau de bord : les mêmes commandes, vues d'en haut ──
     Il se lève devant le bon de commande. Le grand nombre, les barres par
     jour (celle d'aujourd'hui en pêche, la dernière), et les factures émises
     qui arrivent en haut de la liste. */
  .fenetre--tableau {
    --sortie: translate(0, 64px) scale(0.93);
    top: 128px;
    left: 104px;
    width: 544px;
    background: color-mix(in srgb, var(--color-night-deep) 88%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .fenetre--tableau .fenetre__corps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 236px;
    gap: 14px 20px;
    padding: 14px;
  }

  .chiffre {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 7px;
  }

  .chiffre__nom,
  .dernieres__nom {
    color: var(--color-ink-low);
    font-size: 11.5px;
    font-weight: 500;
  }

  .chiffre__valeur {
    color: var(--color-ink);
    font-size: 60px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    transition: color 500ms;
  }

  /* Tant que les lignes ne sont pas arrivées, le compteur est à zéro et
     s'efface : il s'allume en se mettant à compter. */
  .fenetre--tableau.est-vide .chiffre__valeur {
    color: color-mix(in srgb, var(--color-ink) 26%, transparent);
  }

  .chiffre__suite {
    display: flex;
    gap: 6px;
    margin-top: 9px;
  }

  .jeton {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 25px;
    padding-inline: 10px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-ink-mid);
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .jeton b {
    color: var(--color-ink);
    font-weight: 600;
  }

  .jeton--zero {
    border-color: color-mix(in srgb, var(--color-peche) 70%, transparent);
  }

  .jeton--zero b {
    color: var(--color-peche);
  }

  .barres {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    height: 140px;
  }

  .barre {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 6px;
  }

  .barre__fut {
    position: relative;
    display: flex;
    align-items: flex-end;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  .barre__fut i {
    width: 100%;
    height: calc((var(--h) + var(--plus, 0)) * 1%);
    border-radius: 5px 5px 0 0;
    background: color-mix(in srgb, var(--color-ink) 20%, transparent);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 780ms var(--ease-out-expo), height 420ms var(--ease-out-quint);
  }

  .barre.est-monte .barre__fut i {
    transform: scaleY(1);
  }

  .barre:last-child .barre__fut i {
    background: var(--color-peche);
  }

  /* Le pied de la barre : là où se pose la ligne venue du bon de commande. */
  .barre__pied {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 4px;
  }

  .barre em {
    color: var(--color-ink-faint);
    font-size: 11.5px;
    font-style: normal;
    font-weight: 500;
    text-align: center;
  }

  .barre:last-child em {
    color: var(--color-ink);
  }

  .dernieres {
    grid-column: 1 / -1;
    display: grid;
    gap: 7px;
  }

  /* Trois factures visibles ; la quatrième attend sous le bord, coupée. */
  .dernieres ul {
    display: grid;
    gap: 5px;
    height: calc(3 * 27px + 2 * 5px);
    overflow: hidden;
  }

  .emise {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 10px;
    height: 27px;
    padding-inline: 8px 5px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-radius: 7px;
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
    font-size: 11.5px;
    font-weight: 500;
    opacity: 0;
    translate: -12px 0;
    transition: opacity 300ms, translate 480ms var(--ease-out-expo);
  }

  .emise.est-la {
    opacity: 1;
    translate: 0 0;
  }

  .emise .ref {
    font-weight: 600;
  }

  .emise i {
    width: var(--l);
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 24%, transparent);
  }

  .emise__etat {
    padding: 2px 9px;
    border-radius: var(--radius-full);
    background: var(--color-peche);
    color: var(--color-night);
    font-weight: 600;
  }

  /* Les trajets du curseur laissent une trace : à force, on voit le geste se
     répéter. */
  .traces {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .traces :global(path) {
    fill: none;
    stroke: color-mix(in srgb, var(--color-ink) 62%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }

  /* Le fil qui relie la ligne douteuse à la carte qui la soumet. */
  .traces :global(path.fil-doute) {
    stroke: var(--color-lueur-froide);
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
  }

  /* En automatique, c'est la ligne elle-même qui part : sa bande pêche quitte la
     page et vient se poser dans la facture. Pour le tableau de bord, la même
     bande va se poser au pied d'une barre, qui monte. */
  .bande {
    position: absolute;
    z-index: 4;
    border-radius: 5px;
    background: var(--color-peche);
    opacity: 0;
    transform-origin: 0 0;
    pointer-events: none;
  }

  .curseur {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: 0;
    height: 0;
    transition: opacity 260ms;
  }

  .curseur[data-etat='cache'] {
    opacity: 0;
  }

  .curseur svg {
    position: absolute;
    top: -3px;
    left: -5px;
    width: 22px;
    height: 22px;
    filter: drop-shadow(0 3px 4px var(--color-night-deep));
    transition: scale 110ms;
  }

  .curseur path {
    fill: var(--color-ink);
    stroke: var(--color-night);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .curseur.clique svg {
    scale: 0.8;
  }

  .curseur__valeur {
    position: absolute;
    top: 19px;
    left: 13px;
    padding: 3px 9px 4px;
    border: 1px solid color-mix(in srgb, var(--color-lueur-froide) 80%, transparent);
    border-radius: 7px;
    background: color-mix(in srgb, var(--color-lueur-froide) 26%, var(--color-night-deep));
    box-shadow: 0 8px 18px -8px var(--color-night-deep);
    color: var(--color-ink);
    font-size: 10.5px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    scale: 0.8;
    transform-origin: 0 0;
    transition: opacity 140ms, scale 160ms var(--ease-out-quint);
  }

  .curseur.porte .curseur__valeur {
    opacity: 1;
    scale: 1;
  }

  /* La commande : la même commande, de quatre façons. Le travail à la main,
     puis les trois réponses. Le récit la règle tout seul, et elle dit toujours
     où en est la scène ; on peut aussi la pousser à la main. Le travail à la
     main s'allume en blanc, les trois réponses en pêche. */
  .scene__mode {
    display: inline-flex;
    gap: 2px;
    max-width: 100%;
    padding: 4px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }

  .scene__mode[hidden] {
    display: none;
  }

  .scene__mode button {
    min-height: 44px;
    padding: 0 1.1rem;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-ink-mid);
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--duration-default) var(--ease-out-quint), color var(--duration-default);
  }

  .scene__mode button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-night);
  }

  .scene__mode button:not([data-mode-bouton='main'])[aria-pressed='true'] {
    background: var(--color-peche);
  }

  @media (hover: hover) and (pointer: fine) {
    .scene__mode button[aria-pressed='false']:hover {
      color: var(--color-ink);
    }
  }

  /* Sur un écran large mais bas, la scène se règle sur la hauteur et devient
     plus étroite que ses quatre boutons : leurs marges se serrent. */
  @media (min-width: 1024px) and (max-height: 620px) {
    .scene__mode button {
      padding-inline: 0.65rem;
    }
  }

  /* ── Une colonne ──
     Sur téléphone et tablette, rien n'est collé : la scène est posée dans le
     fil de la page, après la première phrase, et les deux suivantes se lisent
     à la suite. Une scène fixée en haut d'un petit écran ne laissait au texte
     qu'une bande étroite où défiler, et il fallait faire défiler longtemps
     pour peu de texte. Ici c'est la scène qui déroule seule ses temps (voir
     le script), et les boutons permettent de passer de l'un à l'autre. */
  @media (max-width: 1023px) {
    .story__grille {
      display: block;
      padding-bottom: 1.5rem;
    }

    .acte::before,
    .acte::after {
      display: none;
    }

    .acte {
      min-height: 0;
      padding-block: 2.75rem;
      align-content: start;
    }

    .acte:first-child {
      padding-top: 4rem;
      padding-bottom: 1.75rem;
    }

    .acte__titre {
      max-width: 17ch;
    }

    .story__scene {
      position: static;
      height: auto;
      padding-bottom: 0.5rem;
    }

    .scene {
      gap: 1rem;
      width: min(100%, 30rem);
    }

    /* Quatre boutons sur une seule ligne : le corps suit la largeur de
       l'écran (c'est le jeton des boutons du site) et les marges se serrent.
       La hauteur de 44 px, elle, ne bouge pas. */
    .scene__mode button {
      min-height: 44px;
      padding-inline: clamp(0.4rem, 2.3vw, 1rem);
      font-size: var(--text-button);
    }

    /* Sur ces écrans, le flou d'arrière-plan et le mélange du grain coûtent
       trop cher pendant le défilement : les fenêtres deviennent opaques. */
    .fenetre--pdf,
    .fenetre--app,
    .fenetre--agent,
    .fenetre--tableau,
    .puce {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .fenetre--pdf { background: var(--color-surface-high); }
    .fenetre--app,
    .fenetre--agent,
    .fenetre--tableau { background: color-mix(in srgb, var(--color-night-deep) 94%, var(--color-ink)); }
    .puce { background: var(--color-night-deep); }

    .scene__cadre::after {
      opacity: 0.06;
      mix-blend-mode: normal;
    }
  }

  /* ── Le plan étroit ──
     Sous 640 px, la scène est redessinée plutôt que réduite : trois lignes au
     lieu de cinq, des pastilles sans libellé, une facture sans pied. Elle
     doit laisser de la place au texte qui défile dessous. */
  @media (max-width: 640px) {
    .scene__cadre { aspect-ratio: 340 / 356; }

    .scene__plan {
      width: 340px;
      height: 356px;
    }

    .doc__ligne:nth-child(n + 4),
    .facture__ligne:nth-child(n + 4),
    .page__bloc,
    .champ,
    .pied,
    .puce__nom {
      display: none;
    }

    .puces {
      top: 12px;
      left: 12px;
      gap: 6px;
    }

    .puce {
      height: 26px;
      padding: 0 9px 0 7px;
      font-size: 11px;
    }

    .monde {
      --recul: 1100px;
      --rx: 6deg;
      --ry: -7deg;
      --rz: 1deg;
      --tx: 4px;
      --ty: 6px;
    }

    /* Le volet de l'agent descend plus bas que la facture : le plan remonte
       d'autant, sans s'approcher (il n'y a pas la place). */
    .scene[data-mode='agent'] .monde {
      --rx: 4deg;
      --ry: -3deg;
      --rz: 0.3deg;
      --tx: 2px;
      --ty: -4px;
      --zoom: 1;
    }

    .scene[data-mode='tableau'] .monde {
      --rx: 7deg;
      --ry: 5deg;
      --rz: -0.8deg;
      --tx: -2px;
      --ty: 12px;
    }

    .fenetre { border-radius: 10px; }

    .fenetre__barre {
      height: 28px;
      padding-inline: 9px;
      font-size: 10.5px;
    }

    .fenetre--pdf {
      top: 50px;
      left: 10px;
      width: 212px;
    }

    .fenetre--pdf .fenetre__corps { padding: 8px 8px 10px; }
    .page { padding: 10px 10px 4px; }
    .page__tete b { font-size: 11px; }
    .page__tete span { display: none; }

    .colonnes {
      grid-template-columns: 40px minmax(0, 1fr) 20px 42px;
      gap: 5px;
      margin-top: 8px;
      padding-inline: 4px;
      font-size: 7.5px;
    }

    .doc__ligne {
      grid-template-columns: 40px minmax(0, 1fr) 20px 42px;
      gap: 5px;
      height: 24px;
      padding-inline: 4px;
      font-size: 10px;
    }

    .doc__ligne:nth-child(3) { border-bottom: 0; }

    .fenetre--app {
      top: 198px;
      left: 118px;
      width: 214px;
    }

    /* L'étiquette portée passe au-dessus du curseur : dessous, elle recouvrait
       le titre de la facture, que les deux fenêtres rapprochées mettent juste
       sous la ligne copiée. */
    .curseur__valeur {
      top: -25px;
    }

    .fenetre--app .fenetre__corps { padding: 8px; }

    .colonnes--app {
      grid-template-columns: 40px minmax(0, 1fr) 20px 42px 10px;
      margin-top: 0;
      padding-inline: 6px;
    }

    .facture__ligne {
      grid-template-columns: 40px minmax(0, 1fr) 20px 42px 10px;
      gap: 5px;
      height: 25px;
      padding-inline: 6px;
      font-size: 10px;
    }

    .facture__ligne svg { width: 10px; height: 10px; }

    /* Sur un plan étroit, la valeur transportée s'ouvre vers la gauche : à
       droite, elle sortirait du panneau en arrivant sur la facture. */
    .curseur__valeur {
      right: 6px;
      left: auto;
      font-size: 9.5px;
      transform-origin: 100% 0;
    }

    /* La marge de la page est trop mince pour la coche : pendant que l'agent
       lit, la page lui fait de la place à droite. */
    .page {
      transition: padding-right 320ms var(--ease-out-quint);
    }

    .scene[data-mode='agent'] .page {
      padding-right: 19px;
    }

    /* La colonne des désignations y perd quelques unités : son intitulé se
       coupe proprement au lieu de monter sur celui d'à côté. */
    .scene[data-mode='agent'] .page .colonnes span:nth-child(2) {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .avis {
      right: -15px;
      width: 11px;
      height: 11px;
      margin-top: -5.5px;
    }

    .lecture::before { height: 26px; }

    .scene[data-mode='tableau'] .fenetre--pdf {
      transform: translate(-4px, -8px) scale(0.94);
    }

    /* L'agent, à la place de la facture. Il passe au-dessus du bon de
       commande, dont il recouvre le coin : ici le volet arrive par la droite.
       Les trois contrôles tiennent sur une ligne, sans leur décompte. */
    .fenetre--agent {
      --sortie: translate(40px, 14px) scale(0.95);
      top: 204px;
      left: 98px;
      z-index: 1;
      width: 234px;
    }

    .fenetre--agent .fenetre__corps { padding: 8px; }

    /* Les corps du volet et du tableau de bord sont à 10,5 unités : à
       320 px de large le plan est réduit d'un cinquième, et 10 passerait
       sous les 8 px à l'écran. */
    .agent__etat {
      padding: 2px 8px;
      font-size: 10.5px;
    }

    .controles {
      display: flex;
    }

    .controle {
      flex: 1 1 auto;
      grid-template-columns: minmax(0, 1fr) 10px;
      gap: 4px;
      height: 23px;
      padding-inline: 6px;
      font-size: 10.5px;
    }

    .controle b { display: none; }
    .controle svg,
    .doute__action svg { width: 10px; height: 10px; }
    .controle .mot-long { display: none; }
    .controle .mot-court { display: inline; }

    .doute__carte {
      gap: 6px;
      margin-top: 6px;
      padding: 5px 5px 5px 7px;
      font-size: 10.5px;
    }

    .doute__ligne {
      grid-column: 1;
      grid-template-columns: 40px minmax(0, 1fr) 18px 40px;
      gap: 5px;
    }

    .doute__mot { display: none; }
    .doute__bouton { padding: 3px 10px; }

    .resume {
      margin-top: 6px;
      padding-top: 5px;
      font-size: 10.5px;
    }

    .resume span + span::before { margin-inline: 4px; }

    /* Le tableau de bord : le même dessin, deux factures au lieu de trois et
       une seule pastille sous le grand nombre. */
    .fenetre--tableau {
      --sortie: translate(0, 40px) scale(0.94);
      top: 86px;
      left: 18px;
      width: 306px;
    }

    .fenetre--tableau .fenetre__corps {
      grid-template-columns: minmax(0, 1fr) 122px;
      gap: 9px 10px;
      padding: 10px;
    }

    .chiffre { gap: 5px; }

    .chiffre__nom,
    .dernieres__nom,
    .jeton,
    .barre em,
    .emise {
      font-size: 10.5px;
    }

    .chiffre__valeur { font-size: 40px; }
    .chiffre__suite { margin-top: 5px; }

    .jeton {
      height: 22px;
      padding-inline: 8px;
    }

    .jeton--attente {
      display: none;
    }

    .dernieres ul {
      height: calc(2 * 24px + 5px);
    }

    .barres {
      gap: 5px;
      height: 92px;
    }

    .barre { gap: 4px; }
    .barre__fut i { border-radius: 4px 4px 0 0; }
    .dernieres { gap: 5px; }

    .emise {
      grid-template-columns: 44px minmax(0, 1fr) auto auto;
      gap: 6px;
      height: 24px;
      padding-inline: 6px 4px;
    }

    .emise__etat { padding: 1px 7px; }
  }

  /* Sous 375 px, « Automatisation » ne tient plus à côté des trois autres :
     le bouton garde son nom complet pour un lecteur d'écran (`aria-label`) et
     n'affiche que son début. */
  @media (max-width: 374px) {
    .scene__mode .mot-long { display: none; }
    .scene__mode .mot-court { display: inline; }
  }

  /* Sans mouvement, on passe d'une image fixe à l'autre : ni caméra, ni
     fenêtre qui glisse, ni barre qui monte. */
  @media (prefers-reduced-motion: reduce) {
    .doc__ligne::before,
    .facture__ligne i,
    .facture__ligne svg,
    .curseur__valeur,
    .scene__cadre::before,
    .monde,
    .scene[data-mode] .fenetre[class],
    .page,
    .avis,
    .controle svg,
    .doute,
    .doute__carte,
    .doute__bouton,
    .doute__action svg,
    .resume,
    .barre__fut i,
    .chiffre__valeur,
    .emise {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Le moteur de la scène. Une boucle par façon de faire (à la main, puis les
   * trois réponses) et un jeton qui les annule : à chaque changement de mode
   * le jeton avance, et toute boucle qui se réveille avec un jeton périmé
   * s'arrête sans rien toucher. Au-dessus, une régie (`derouler`) règle
   * l'ordre et la durée des temps tant que c'est le récit qui a la main.
   */
  const NS = 'http://www.w3.org/2000/svg';
  const JOURS = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi'];
  const INITIALES = ['L', 'M', 'M', 'J', 'V'];
  const ATTENTE_DEPART = 23;

  /* Les quatre façons de traiter la même commande : à la main, puis les trois
     réponses, dans l'ordre où la scène les enchaîne. */
  const MODES = ['main', 'auto', 'agent', 'tableau'] as const;
  type Mode = (typeof MODES)[number];
  const estMode = (v: string | undefined): v is Mode => MODES.some((m) => m === v);

  /* Un temps du récit : ce qu'il montre et combien il dure, en millisecondes
     passées à l'écran. Entre `mini` et `plafond`, la scène passe à la suite
     `tenue` ms après que la réponse a fini de dire ce qu'elle a à dire (voir
     `acheve`) : on ne coupe pas un geste au milieu. */
  type Temps = { acte: number; mode: Mode; mini: number; plafond: number; tenue: number };
  const REPONSES: Temps[] = [
    { acte: 3, mode: 'auto', mini: 5200, plafond: 10500, tenue: 1500 },
    { acte: 3, mode: 'agent', mini: 6000, plafond: 9500, tenue: 1500 },
    { acte: 3, mode: 'tableau', mini: 5600, plafond: 9000, tenue: 1500 },
  ];
  /* En une colonne : à la main, la semaine qui file, puis les trois réponses. */
  const DEROULE: Temps[] = [
    { acte: 1, mode: 'main', mini: 7000, plafond: 7000, tenue: 0 },
    { acte: 2, mode: 'main', mini: 4500, plafond: 4500, tenue: 0 },
    ...REPONSES,
  ];

  const ANNONCES: Record<Mode, string> = {
    main: 'À la main : chaque ligne du bon de commande est recopiée dans la facture, et les commandes en attente s’accumulent.',
    auto: 'Automatisation : les lignes passent seules du bon de commande à la facture, et il ne reste aucune commande en attente.',
    agent:
      'Agent IA : un agent lit le bon de commande, contrôle le client, les références et les montants, coche les lignes conformes et vous laisse valider la seule ligne douteuse.',
    tableau:
      'Dashboard : les mêmes commandes dans un tableau de bord, avec le nombre de commandes traitées, zéro ressaisie et les dernières factures émises.',
  };

  type EtatAgent = 'lecture' | 'doute' | 'controle';
  const ETATS_AGENT: Record<EtatAgent, string> = { lecture: 'Lecture', doute: '1 à valider', controle: 'Contrôlé' };

  /* Les factures qui arrivent ensuite dans le tableau de bord : des montants
     d'illustration, comme ceux du balisage. */
  type Emise = { ref: string; montant: string; l: number };
  const SUIVANTES = [
    { montant: '268,40', l: 62 },
    { montant: '431,00', l: 80 },
    { montant: '189,90', l: 48 },
    { montant: '527,60', l: 70 },
  ];

  const racine = document.querySelector<HTMLElement>('[data-story]');
  const scene = racine?.querySelector<HTMLElement>('[data-scene]');
  /* Sans ces deux API (navigateurs d'avant 2020), la scène reste l'image fixe
     du HTML : mieux qu'un script qui s'arrête à mi-chemin. */
  const pretAAnimer = 'animate' in Element.prototype && 'ResizeObserver' in window;
  if (racine && scene && pretAAnimer) lancer(racine, scene);

  function lancer(racine: HTMLElement, scene: HTMLElement) {
    const un = <T extends Element = HTMLElement>(sel: string) => scene.querySelector<T>(sel)!;
    const tous = (sel: string) => [...scene.querySelectorAll<HTMLElement>(sel)];
    const cadre = un('.scene__cadre');
    const plan = un('.scene__plan');
    const monde = un('[data-monde]');
    const curseur = un('[data-curseur]');
    const valeur = un('[data-porte]');
    const traces = un<SVGSVGElement>('[data-traces]');
    const doc = un('[data-doc]');
    const etat = un('.facture__etat');
    const elJour = un('[data-jour]');
    const elHeure = un('[data-heure]');
    const elGestes = un('[data-gestes]');
    const elAttente = un('[data-attente]');
    const elTotal = un('[data-total]');
    const blocAttente = un('[data-attente-bloc]');
    const aigMin = un<SVGLineElement>('[data-aiguille-min]');
    const aigH = un<SVGLineElement>('[data-aiguille-h]');
    const bandes = tous('.bande');
    /* L'agent : son trait de lecture, sa pastille, ses trois contrôles, la
       carte du doute et le compte rendu. */
    const faisceau = un('[data-lecture]');
    const pastilleAgent = un('[data-agent-pastille]');
    const controles = {
      client: un('[data-controle="client"]'),
      refs: un('[data-controle="refs"]'),
      montants: un('[data-controle="montants"]'),
    };
    const volet = un('[data-agent]');
    const doute = un('[data-doute]');
    const douteCarte = un('[data-doute-carte]');
    const douteRef = un('[data-doute-ref]');
    const douteQte = un('[data-doute-qte]');
    const doutePrix = un('[data-doute-prix]');
    const douteMot = un('[data-doute-mot]');
    const douteBouton = un('[data-doute-bouton]');
    const resume = un('[data-resume]');
    const resumeMots = [...resume.querySelectorAll<HTMLElement>('span')];
    /* Le tableau de bord : le grand nombre, les barres et leurs pieds, les
       dernières factures. Le balisage porte l'état d'arrivée ; le script le
       relit pour savoir où revenir. */
    const tableau = un('[data-tableau]');
    const elTraitees = un('[data-traitees]');
    const TRAITEES = Number(elTraitees.dataset.cible ?? 0);
    const barres = tous('[data-barre]');
    const pieds = barres.map((b) => b.querySelector<HTMLElement>('[data-pied]')!);
    const emises = tous('[data-emise]');
    const departEmises: Emise[] = emises.map((e) => ({
      ref: e.dataset.ref ?? '',
      montant: e.dataset.montant ?? '',
      l: Number(e.dataset.l ?? 60),
    }));
    const premierNumero = Number((departEmises[0]?.ref ?? '').replace(/\D/g, ''));
    const boutons = tous('[data-mode-bouton]');
    const annonce = scene.querySelector<HTMLElement>('[data-annonce]');
    const titres = [...racine.querySelectorAll<HTMLElement>('.acte')].map((acte) => ({
      n: Number(acte.dataset.acte),
      el: acte.querySelector<HTMLElement>('.acte__titre')!,
    }));

    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /* En une colonne, la scène n'est plus liée au défilement : elle déroule
       seule ses temps. */
    const colonne = window.matchMedia('(max-width: 1023px)');
    const euros = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    let mode: Mode = 'main';
    let acte = 1;
    let jeton = 0;
    let visible = false;
    let gestes = 0;
    let attente = ATTENTE_DEPART;
    let minutes = 9 * 60;
    let jour = 0;
    let vitesse = 5;
    let pos = { x: 0, y: 0 };
    /* L'instant où la réponse en cours a fini de dire ce qu'elle a à dire : la
       file est vide et la facture émise, le doute est validé, le tableau de
       bord a reçu sa première facture. Zéro tant que ce n'est pas le cas. La
       régie s'en sert pour passer à la suite au bon moment. */
    let acheve = 0;
    const conclure = () => {
      if (!acheve) acheve = performance.now();
    };
    /* Le tableau de bord vivant : ce qu'il compte et ce qu'il liste. */
    let traitees = 0;
    let arrivee = 0;
    let factures: Emise[] = [...departEmises];

    type Pt = { x: number; y: number };

    const lignes = (sel: string) =>
      [...monde.querySelectorAll<HTMLElement>(sel)].filter((el) => el.offsetParent !== null);

    const pause = (ms: number) => new Promise<void>((ok) => window.setTimeout(ok, ms));

    /* Une animation annulée par un changement de mode rejette sa promesse avec
       `AbortError` : c'est attendu, la boucle s'arrête d'elle-même au contrôle
       de jeton suivant. Toute autre erreur remonte. */
    const annulee = (erreur: unknown) => erreur instanceof DOMException && erreur.name === 'AbortError';
    const fini = (animation: Animation) =>
      animation.finished.then(
        () => undefined,
        (erreur: unknown) => {
          if (!annulee(erreur)) throw erreur;
        },
      );

    const aLEcran = () => visible && !document.hidden;
    const attendreEcran = async () => {
      while (!aLEcran()) await pause(240);
    };

    /* Le rectangle d'un élément dans le repère du monde, lu sur la mise en
       page et non à l'écran : la perspective du monde ne le déforme pas, et
       une fenêtre encore en train d'arriver est déjà lue à sa place. */
    const cadreDe = (el: HTMLElement) => {
      let x = 0;
      let y = 0;
      let n: HTMLElement | null = el;
      while (n && n !== monde) {
        x += n.offsetLeft;
        y += n.offsetTop;
        n = n.offsetParent as HTMLElement | null;
      }
      return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    };

    const lieu = (el: HTMLElement, ax = 0.5, ay = 0.5): Pt => {
      const c = cadreDe(el);
      return { x: c.x + c.w * ax, y: c.y + c.h * ay };
    };

    const ajuster = () => {
      plan.style.setProperty('--k', String(cadre.clientWidth / plan.offsetWidth));
      traces.setAttribute('viewBox', `0 0 ${monde.offsetWidth} ${monde.offsetHeight}`);
    };

    /* Une courbe entre deux points, échantillonnée avec son accélération : les
       images clés portent déjà le départ doux et l'arrivée douce. */
    const courbe = (de: Pt, vers: Pt, bombe: number, pas = 18) => {
      const c = { x: (de.x + vers.x) / 2, y: Math.min(de.y, vers.y) - bombe };
      const liste: Pt[] = [];
      for (let i = 0; i <= pas; i++) {
        const t = i / pas;
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        liste.push({
          x: (1 - e) * (1 - e) * de.x + 2 * (1 - e) * e * c.x + e * e * vers.x,
          y: (1 - e) * (1 - e) * de.y + 2 * (1 - e) * e * c.y + e * e * vers.y,
        });
      }
      return { liste, c };
    };

    const chemin = (de: Pt, c: Pt, vers: Pt) => {
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', `M${de.x} ${de.y} Q${c.x} ${c.y} ${vers.x} ${vers.y}`);
      return p;
    };

    const poser = (p: Pt) => {
      pos = p;
      curseur.style.transform = `translate(${p.x}px, ${p.y}px)`;
    };

    async function deplacer(vers: Pt, duree: number, bombe: number, trace = false) {
      const de = pos;
      const { liste, c } = courbe(de, vers, bombe);
      if (trace) {
        const p = chemin(de, c, vers);
        traces.append(p);
        p.animate([{ opacity: 0 }, { opacity: 0.7 }], { duration: duree, fill: 'forwards' });
        const garde = acte === 2 ? 30000 : 4600;
        window.setTimeout(() => {
          p.animate([{ opacity: 0.7 }, { opacity: 0 }], { duration: 900, fill: 'forwards' }).finished.then(
            () => p.remove(),
            () => p.remove(),
          );
        }, garde);
        while (traces.childElementCount > 48) traces.firstElementChild?.remove();
      }
      const anim = curseur.animate(
        liste.map((p) => ({ transform: `translate(${p.x}px, ${p.y}px)` })),
        { duration: duree, easing: 'linear' },
      );
      try {
        await anim.finished;
        poser(vers);
      } catch (erreur) {
        if (!annulee(erreur)) throw erreur;
      }
    }

    const cliquer = () => {
      curseur.classList.add('clique');
      window.setTimeout(() => curseur.classList.remove('clique'), 130);
    };

    /* Un nombre qui change tombe à sa place. `elan` est la hauteur de la
       chute, en pour cent de la sienne : petite pour un grand nombre, qui
       sinon monterait sur ce qu'il a au-dessus de lui. */
    const ecrire = (el: HTMLElement, n: number, elan = 38) => {
      el.textContent = String(n);
      if (!reduit) {
        el.animate(
          [{ transform: `translateY(-${elan}%)`, opacity: 0.2 }, { transform: 'none', opacity: 1 }],
          { duration: 240, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        );
      }
    };

    const compter = (el: HTMLElement, de: number, vers: number, duree: number, j: number) => {
      const debut = performance.now();
      const pas = (t: number) => {
        /* Interrompu, le compteur écrit sa valeur d'arrivée : la variable la
           porte déjà, et un nombre intermédiaire resterait affiché. */
        if (j !== jeton) {
          el.textContent = String(vers);
          return;
        }
        const a = Math.min(1, (t - debut) / duree);
        el.textContent = String(Math.round(de + (vers - de) * (1 - Math.pow(1 - a, 3))));
        if (a < 1) requestAnimationFrame(pas);
      };
      requestAnimationFrame(pas);
    };

    const majAttente = (n: number) => {
      attente = n;
      ecrire(elAttente, n);
      blocAttente.classList.toggle('est-vide', n === 0);
    };

    /* Le total de la facture : la somme des lignes déjà remplies. */
    const majTotal = () => {
      const somme = lignes('[data-ligne-facture]')
        .filter((l) => l.classList.contains('est-rempli'))
        .reduce((t, l) => t + Number(l.dataset.montant ?? 0), 0);
      elTotal.textContent = `${euros.format(somme)} €`;
    };

    const etatFacture = (emise: boolean) => {
      etat.dataset.etat = emise ? 'emise' : 'brouillon';
      etat.textContent = emise ? 'Émise' : 'Brouillon';
    };

    /* La page et la facture se vident séparément : quand une réponse retire
       la facture de la scène, elle la laisse partir telle qu'elle est, au
       lieu de la voir se vider pendant qu'elle s'efface. */
    const viderPage = () => {
      monde
        .querySelectorAll('[data-ligne-doc]')
        .forEach((l) => l.classList.remove('est-lu', 'est-copie', 'est-fait', 'est-conforme', 'est-doute'));
    };

    const viderLignes = () => {
      viderPage();
      monde.querySelectorAll('[data-ligne-facture]').forEach((l) => l.classList.remove('est-rempli', 'est-valide'));
      etatFacture(false);
      majTotal();
    };

    /* Une commande de plus arrive : la pastille tressaille. */
    const feuilleTombe = () => {
      if (reduit) return;
      blocAttente.animate([{ transform: 'scale(1.09)' }, { transform: 'none' }], {
        duration: 360,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      });
    };

    /* La page traitée part, la suivante remonte, la facture se vide. `aussi`
       remet à zéro ce que la réponse en cours a écrit ailleurs, au moment où
       la page est hors de vue. */
    async function docSuivant(j: number, rapide: boolean, aussi?: () => void) {
      const d = rapide ? 190 : 360;
      await fini(
        doc.animate([{ translate: '0 0', opacity: 1 }, { translate: '0 -18px', opacity: 0 }], {
          duration: d,
          easing: 'cubic-bezier(0.5, 0, 0.75, 0)',
        }),
      );
      if (j !== jeton) return;
      viderLignes();
      aussi?.();
      await fini(
        doc.animate([{ translate: '0 22px', opacity: 0 }, { translate: '0 0', opacity: 1 }], {
          duration: d,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        }),
      );
    }

    /* ── À la main ──
       `retard` laisse aux fenêtres le temps de reprendre leur place quand on
       revient d'une réponse qui les avait déplacées. */
    async function boucleMain(j: number, retard: number) {
      curseur.dataset.etat = 'visible';
      if (retard) {
        await pause(retard);
        if (j !== jeton) return;
      }
      while (j === jeton) {
        const docs = lignes('[data-ligne-doc]');
        const facts = lignes('[data-ligne-facture]');
        for (let i = 0; i < docs.length; i++) {
          await attendreEcran();
          if (j !== jeton) return;
          await deplacer(lieu(docs[i], 0.78, 0.58), 480, 12);
          if (j !== jeton) return;
          cliquer();
          docs[i].classList.add('est-copie');
          valeur.textContent = docs[i].dataset.valeur ?? '';
          curseur.classList.add('porte');
          await pause(230);
          if (j !== jeton) return;
          await deplacer(lieu(facts[i], 0.6, 0.58), 720, 40, true);
          if (j !== jeton) return;
          cliquer();
          curseur.classList.remove('porte');
          facts[i].classList.add('est-rempli');
          docs[i].classList.remove('est-copie');
          docs[i].classList.add('est-fait');
          majTotal();
          gestes += 1;
          ecrire(elGestes, gestes);
          await pause(260);
        }
        if (j !== jeton) return;
        etatFacture(true);
        await pause(560);
        if (j !== jeton) return;
        majAttente(Math.max(1, attente - 1));
        await docSuivant(j, false);
      }
    }

    /* Pendant ce temps, les bons de commande continuent d'arriver. */
    async function arrivees(j: number) {
      while (j === jeton) {
        await pause(acte === 2 ? 950 : 3800);
        await attendreEcran();
        if (j !== jeton) return;
        majAttente(attente + 1);
        feuilleTombe();
      }
    }

    /* Une bande pêche quitte une ligne du bon de commande et va prendre la
       place et la forme de sa cible : une ligne de la facture, ou le pied
       d'une barre du tableau de bord. */
    async function voler(bande: HTMLElement, de: HTMLElement, vers: HTMLElement, delai: number, duree: number) {
      const a = cadreDe(de);
      const z = cadreDe(vers);
      const dx = z.x - a.x;
      const dy = z.y - a.y - 3;
      Object.assign(bande.style, {
        left: `${a.x}px`,
        top: `${a.y + 3}px`,
        width: `${a.w}px`,
        height: `${a.h - 6}px`,
      });
      await fini(
        bande.animate(
          [
            { transform: 'translate(0, 0) scale(1, 1)', opacity: 0.9 },
            {
              transform: `translate(${dx * 0.5 + a.w * 0.22}px, ${dy * 0.42 - 14}px) scale(0.56, 0.72)`,
              opacity: 0.9,
              offset: 0.5,
            },
            { opacity: 0.85, offset: 0.82 },
            { transform: `translate(${dx}px, ${dy}px) scale(${z.w / a.w}, ${z.h / (a.h - 6)})`, opacity: 0 },
          ],
          { duration: duree, delay: delai, easing: 'cubic-bezier(0.45, 0, 0.15, 1)', fill: 'backwards' },
        ),
      );
    }

    /* Les trois réponses partent du même constat : plus aucun geste refait.
       L'agent et le tableau de bord montrent en plus une file déjà vidée,
       celle que l'automatisation vide sous les yeux du visiteur. */
    const solder = (j: number, file: boolean) => {
      compter(elGestes, gestes, 0, 900, j);
      gestes = 0;
      if (!file || attente === 0) {
        blocAttente.classList.toggle('est-vide', attente === 0);
        return;
      }
      compter(elAttente, attente, 0, 900, j);
      attente = 0;
      window.setTimeout(() => j === jeton && blocAttente.classList.add('est-vide'), 900);
    };

    /* ── Automatisation ── */
    async function boucleAuto(j: number, retard: number) {
      curseur.dataset.etat = 'cache';
      viderLignes();
      solder(j, false);
      /* La file se vide en cinq bons, quelle que soit sa longueur : la durée
         de cette réponse ne dépend pas du temps passé sur la phrase d'avant. */
      const lot = Math.max(3, Math.ceil(attente / 5));
      await pause(retard);
      while (j === jeton) {
        await attendreEcran();
        if (j !== jeton) return;
        const docs = lignes('[data-ligne-doc]');
        const facts = lignes('[data-ligne-facture]');
        const presse = attente > 0;
        const cadence = presse ? 32 : 75;
        docs.forEach((d, i) => window.setTimeout(() => j === jeton && d.classList.add('est-lu'), i * cadence));
        await pause(docs.length * cadence + (presse ? 110 : 300));
        if (j !== jeton) return;
        await Promise.all(
          docs.map((d, i) =>
            voler(bandes[i], d, facts[i], i * cadence, presse ? 380 : 600).then(() => {
              if (j !== jeton) return;
              facts[i].classList.add('est-rempli', 'est-valide');
              majTotal();
            }),
          ),
        );
        if (j !== jeton) return;
        etatFacture(true);
        if (presse) majAttente(Math.max(0, attente - lot));
        if (attente > 0) {
          await pause(220);
          if (j !== jeton) return;
          await docSuivant(j, true);
        } else {
          /* La file est vide : la facture émise reste à l'écran, c'est
             l'image que cette réponse laisse. */
          conclure();
          await pause(3200);
          if (j !== jeton) return;
          feuilleTombe();
          await docSuivant(j, false);
        }
      }
    }

    /* ── Agent IA ── */
    const etatAgent = (e: EtatAgent) => {
      pastilleAgent.dataset.etat = e;
      pastilleAgent.textContent = ETATS_AGENT[e];
    };

    const controler = (el: HTMLElement, texte: string, ton: 'attente' | 'cours' | 'ok' | 'doute') => {
      const b = el.querySelector('b');
      if (b) b.textContent = texte;
      el.dataset.ton = ton;
    };

    const resumer = (lues: number, conformes: number, reste: string, ton: 'doute' | 'ok') => {
      resumeMots[0].textContent = `${lues} lignes lues`;
      resumeMots[1].textContent = `${conformes} conformes`;
      resumeMots[2].textContent = reste;
      resumeMots[2].dataset.ton = ton;
      resume.classList.add('est-la');
    };

    const viderAgent = () => {
      etatAgent('lecture');
      Object.values(controles).forEach((c) => controler(c, '', 'attente'));
      doute.classList.remove('est-ouvert', 'est-valide');
      resume.classList.remove('est-la');
    };

    /* La ligne que l'agent ne tranche pas seul : la quatrième du bon, ou la
       dernière quand le plan étroit n'en montre que trois. */
    const suspecteDe = (docs: HTMLElement[]) => docs[Math.min(3, docs.length - 1)];

    /* L'agent a fini de lire : ce qu'il a contrôlé, et la ligne qu'il soumet. */
    const soumettre = (ligne: HTMLElement, n: number) => {
      etatAgent('doute');
      controler(controles.client, 'Reconnu', 'ok');
      controler(controles.refs, `${n} sur ${n}`, 'ok');
      controler(controles.montants, `${n - 1} sur ${n}`, 'doute');
      douteRef.textContent = ligne.dataset.ref ?? '';
      douteQte.textContent = ligne.dataset.qte ?? '';
      doutePrix.textContent = ligne.dataset.prix ?? '';
      douteMot.textContent = 'À valider par vous';
      doute.classList.remove('est-valide');
      doute.classList.add('est-ouvert');
      resumer(n, n - 1, '1 à valider', 'doute');
    };

    /* Le fil entre la ligne douteuse et la carte qui la soumet, légèrement
       bombé. Sur le plan étroit la carte est sous la page, pas à côté : un fil
       traverserait le volet, on s'en passe. */
    const relier = (ligne: HTMLElement) => {
      const de = lieu(ligne, 1, 0.5);
      de.x += 14;
      const vers = lieu(douteCarte, 0, 0.5);
      if (vers.x <= de.x) return;
      const c = {
        x: (de.x + vers.x) / 2 + (vers.y - de.y) * 0.3,
        y: (de.y + vers.y) / 2 - (vers.x - de.x) * 0.3,
      };
      const p = chemin(de, c, vers);
      p.classList.add('fil-doute');
      traces.append(p);
      p.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 320, fill: 'forwards' });
    };

    async function boucleAgent(j: number, retard: number) {
      curseur.dataset.etat = 'cache';
      viderPage();
      viderAgent();
      solder(j, true);
      await pause(retard);
      /* Un bon sur deux porte une ligne à faire valider : l'agent trie, il ne
         renvoie pas tout. Le premier en porte une, c'est lui qu'on voit. */
      let douteux = true;
      while (j === jeton) {
        await attendreEcran();
        if (j !== jeton) return;
        const docs = lignes('[data-ligne-doc]');
        const n = docs.length;
        const suspecte = douteux ? suspecteDe(docs) : null;
        etatAgent('lecture');
        controler(controles.client, 'Lecture', 'cours');
        controler(controles.refs, `0 sur ${n}`, 'cours');
        controler(controles.montants, `0 sur ${n}`, 'cours');

        /* Le trait descend la page à vitesse constante : chaque ligne est
           contrôlée à l'instant où il passe sur elle. */
        const DUREE = 1700;
        const tete = un('.page__tete');
        const fin = docs[n - 1];
        const y0 = tete.offsetTop;
        const y1 = fin.offsetTop + fin.offsetHeight;
        const quand = (y: number) => (DUREE * (y - y0)) / (y1 - y0);
        let conformes = 0;
        const lecture = faisceau.animate(
          [
            { transform: `translateY(${y0}px)`, opacity: 0 },
            { opacity: 1, offset: 0.08 },
            { opacity: 1, offset: 0.94 },
            { transform: `translateY(${y1}px)`, opacity: 0 },
          ],
          { duration: DUREE, easing: 'linear' },
        );
        window.setTimeout(() => j === jeton && controler(controles.client, 'Reconnu', 'ok'), quand(docs[0].offsetTop) * 0.7);
        docs.forEach((d, i) =>
          window.setTimeout(() => {
            if (j !== jeton) return;
            const conforme = d !== suspecte;
            d.classList.add(conforme ? 'est-conforme' : 'est-doute');
            if (conforme) conformes += 1;
            const dernier = i === n - 1;
            controler(controles.refs, `${i + 1} sur ${n}`, dernier ? 'ok' : 'cours');
            controler(controles.montants, `${conformes} sur ${n}`, !dernier ? 'cours' : suspecte ? 'doute' : 'ok');
          }, quand(d.offsetTop + d.offsetHeight / 2)),
        );
        await fini(lecture);
        if (j !== jeton) return;
        await pause(240);
        if (j !== jeton) return;

        if (suspecte) {
          soumettre(suspecte, n);
          /* La carte se déplie : sa place n'est connue qu'ensuite. */
          await pause(480);
          if (j !== jeton) return;
          relier(suspecte);
          await pause(1150);
          await attendreEcran();
          if (j !== jeton) return;
          /* Le seul geste qui reste au visiteur : valider le doute. Le
             curseur arrive par le dessous du volet, ou par le dessus quand
             le plan étroit ne laisse rien sous lui. */
          const v = cadreDe(volet);
          const dessous = v.y + v.h + 56 < monde.offsetHeight;
          poser({ x: v.x + v.w * 0.82, y: dessous ? v.y + v.h + 44 : v.y - 40 });
          curseur.dataset.etat = 'visible';
          await deplacer(lieu(douteBouton, 0.5, 0.62), 760, 26);
          if (j !== jeton) return;
          cliquer();
          suspecte.classList.replace('est-doute', 'est-conforme');
          doute.classList.add('est-valide');
          douteMot.textContent = 'Validée par vous';
          controler(controles.montants, `${n} sur ${n}`, 'ok');
          resumer(n, n - 1, '1 validée', 'ok');
          etatAgent('controle');
          traces.replaceChildren();
          conclure();
          await pause(640);
          if (j !== jeton) return;
          curseur.dataset.etat = 'cache';
          await pause(1900);
        } else {
          etatAgent('controle');
          resumer(n, n, '', 'ok');
          conclure();
          await pause(1700);
        }
        if (j !== jeton) return;
        feuilleTombe();
        await docSuivant(j, false, viderAgent);
        douteux = !douteux;
      }
    }

    /* ── Dashboard ── */
    const ecrireEmise = (el: HTMLElement, f: Emise) => {
      const ref = el.querySelector('.ref');
      const montant = el.querySelector('.emise__montant');
      if (ref) ref.textContent = f.ref;
      if (montant) montant.textContent = `${f.montant} €`;
      el.style.setProperty('--l', `${f.l}%`);
    };

    /* Les barres sont les cinq derniers jours : la dernière est aujourd'hui,
       le jour qu'affiche l'horloge. */
    const viderTableau = () => {
      barres.forEach((b, i) => {
        b.classList.remove('est-monte');
        b.style.removeProperty('--plus');
        const em = b.querySelector('em');
        if (em) em.textContent = INITIALES[(jour + 1 + i) % INITIALES.length];
      });
      factures = [...departEmises];
      emises.forEach((e, i) => {
        e.classList.remove('est-la');
        ecrireEmise(e, factures[i]);
      });
      traitees = 0;
      arrivee = 0;
      elTraitees.textContent = '0';
      tableau.classList.add('est-vide');
    };

    /* Une facture de plus : elle entre en haut de la liste et pousse les
       autres d'un rang (la dernière sort par le bas), le nombre avance d'un
       cran et la barre d'aujourd'hui grandit un peu. */
    const nouvelleFacture = () => {
      arrivee += 1;
      const suivante = SUIVANTES[arrivee % SUIVANTES.length];
      const ref = `FA-${String(premierNumero + arrivee).padStart(4, '0')}`;
      factures = [{ ref, ...suivante }, ...factures.slice(0, -1)];
      emises.forEach((e, i) => {
        ecrireEmise(e, factures[i]);
        e.animate(
          i === 0
            ? [{ translate: '0 calc(-100% - 5px)', opacity: 0 }, { translate: '0 0', opacity: 1 }]
            : [{ translate: '0 calc(-100% - 5px)' }, { translate: '0 0' }],
          { duration: 480, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        );
      });
      traitees += 1;
      ecrire(elTraitees, traitees, 10);
      barres[barres.length - 1]?.style.setProperty('--plus', String(Math.min(arrivee * 3, 12)));
    };

    async function boucleTableau(j: number) {
      curseur.dataset.etat = 'cache';
      viderPage();
      viderTableau();
      solder(j, true);
      await attendreEcran();
      if (j !== jeton) return;
      /* Les lignes sont lues une dernière fois, puis quittent la page : elles
         vont se poser au pied des barres, qui montent. Le bon de commande ne
         recule qu'après leur départ (voir le retard de sa transition). */
      const docs = lignes('[data-ligne-doc]');
      docs.forEach((d, i) => window.setTimeout(() => j === jeton && d.classList.add('est-lu'), i * 45));
      await pause(docs.length * 45 + 180);
      if (j !== jeton) return;
      const pas = docs.length > 1 ? (barres.length - 1) / (docs.length - 1) : 0;
      await Promise.all(
        docs.map((d, i) => {
          const k = Math.round(i * pas);
          return voler(bandes[i], d, pieds[k], i * 70, 720).then(() => {
            if (j !== jeton) return;
            d.classList.add('est-fait');
            barres[k].classList.add('est-monte');
            /* La première ligne posée met le compteur en marche. */
            if (traitees) return;
            traitees = TRAITEES;
            tableau.classList.remove('est-vide');
            compter(elTraitees, 0, TRAITEES, 1500, j);
          });
        }),
      );
      if (j !== jeton) return;
      barres.forEach((b) => b.classList.add('est-monte'));
      emises.forEach((e, i) => window.setTimeout(() => j === jeton && e.classList.add('est-la'), 200 + i * 150));
      await pause(1500);
      /* Le tableau de bord vit : les factures continuent d'arriver. */
      while (j === jeton) {
        await pause(2100);
        await attendreEcran();
        if (j !== jeton) return;
        nouvelleFacture();
        conclure();
      }
    }

    /* ── Sans mouvement : une image fixe par façon de faire ── */
    const figer = () => {
      viderLignes();
      viderAgent();
      viderTableau();
      const docs = lignes('[data-ligne-doc]');
      const facts = lignes('[data-ligne-facture]');
      curseur.dataset.etat = 'cache';
      const regle = mode !== 'main';
      elGestes.textContent = regle ? '0' : '2';
      elAttente.textContent = regle ? '0' : String(ATTENTE_DEPART);
      blocAttente.classList.toggle('est-vide', regle);
      if (mode === 'main') {
        docs.slice(0, 2).forEach((d) => d.classList.add('est-fait'));
        facts.slice(0, 2).forEach((f) => f.classList.add('est-rempli'));
      } else if (mode === 'auto') {
        docs.forEach((d) => d.classList.add('est-lu'));
        facts.forEach((f) => f.classList.add('est-rempli', 'est-valide'));
        etatFacture(true);
      } else if (mode === 'agent') {
        /* L'instant où l'agent rend la main : tout est coché sauf la ligne
           qu'il soumet. */
        const suspecte = suspecteDe(docs);
        docs.forEach((d) => d.classList.add(d === suspecte ? 'est-doute' : 'est-conforme'));
        soumettre(suspecte, docs.length);
      } else {
        barres.forEach((b) => b.classList.add('est-monte'));
        emises.forEach((e) => e.classList.add('est-la'));
        elTraitees.textContent = String(TRAITEES);
        tableau.classList.remove('est-vide');
      }
      majTotal();
    };

    /* Une boucle qui lève s'arrêterait sans bruit, scène figée au milieu d'un
       geste. Ici elle laisse une trace, arrête ses sœurs et la scène retombe
       sur son image fixe, celle du mouvement réduit. */
    const veiller = (boucle: Promise<void>, nom: string) => {
      boucle.catch((erreur: unknown) => {
        console.error(`Scène du récit : la boucle « ${nom} » s’est arrêtée`, erreur);
        jeton += 1;
        deroule += 1;
        figer();
      });
    };

    /* Le temps d'un changement de réponse, le plan tourne en mouvement de
       caméra (voir `.bascule` dans les styles) ; ensuite il retrouve la
       vivacité qu'il lui faut pour suivre le pointeur. */
    let finBascule = 0;
    const basculer = () => {
      scene.classList.add('bascule');
      window.clearTimeout(finBascule);
      finBascule = window.setTimeout(() => scene.classList.remove('bascule'), 1200);
    };

    const changerMode = (m: Mode) => {
      if (m === mode) return;
      const avant = mode;
      mode = m;
      jeton += 1;
      acheve = 0;
      scene.dataset.mode = m;
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBouton === m)));
      [curseur, doc, faisceau, ...bandes, ...emises].forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
      curseur.classList.remove('porte');
      traces.replaceChildren();
      if (reduit) return figer();
      basculer();
      /* Les fenêtres se replacent par une transition : une boucle dont les
         trajets partent d'elles attend qu'elles soient arrivées. Entre la
         copie et l'automatisation rien ne bouge, l'attente est courte. */
      const deplace = avant === 'agent' || avant === 'tableau';
      if (m === 'auto') {
        veiller(boucleAuto(jeton, deplace ? 820 : 360), 'automatisation');
      } else if (m === 'agent') {
        veiller(boucleAgent(jeton, avant === 'tableau' ? 900 : 700), 'agent IA');
      } else if (m === 'tableau') {
        veiller(boucleTableau(jeton), 'dashboard');
      } else {
        viderLignes();
        if (attente < ATTENTE_DEPART) {
          compter(elAttente, attente, ATTENTE_DEPART, 700, jeton);
          attente = ATTENTE_DEPART;
          blocAttente.classList.remove('est-vide');
        }
        veiller(boucleMain(jeton, deplace ? 700 : 0), 'à la main');
        veiller(arrivees(jeton), 'arrivées');
      }
    };

    /* L'horloge. À la main la journée file, et au deuxième écran c'est la
       semaine ; dès que la machine travaille, elle reprend un pas tranquille. */
    let minuteAffichee = -1;
    let dernier = performance.now();
    let horloge = 0;
    /* L'horloge ne demande une image que si la scène est à l'écran : hors
       champ, plus rien ne réveille la page. `planifier` la relance. */
    const planifier = () => {
      /* En mouvement réduit l'horloge reste à son heure de départ : c'était le
         seul élément de la scène à bouger encore. */
      if (reduit) return;
      if (!horloge && aLEcran()) horloge = requestAnimationFrame(battre);
    };
    const battre = (t: number) => {
      horloge = 0;
      /* Borné des deux côtés : l'heure d'une image peut précéder celle du
         montage, et un long arrêt ne doit pas faire sauter les aiguilles. */
      const dt = Math.max(0, Math.min(80, t - dernier));
      dernier = t;
      if (aLEcran()) {
        const cible = mode !== 'main' ? 0.7 : acte === 2 ? 52 : 5;
        vitesse += (cible - vitesse) * 0.035;
        minutes += (vitesse * dt) / 1000;
        if (minutes >= 18 * 60) {
          minutes = 9 * 60;
          jour = (jour + 1) % JOURS.length;
          elJour.textContent = JOURS[jour];
        }
        aigMin.setAttribute('transform', `rotate(${(minutes % 60) * 6})`);
        aigH.setAttribute('transform', `rotate(${(minutes / 60) * 30})`);
        const m = Math.floor(minutes);
        if (m !== minuteAffichee) {
          minuteAffichee = m;
          elHeure.textContent = `${Math.floor(m / 60)} h ${String(m % 60).padStart(2, '0')}`;
        }
      }
      planifier();
    };

    /* ── La régie ──
       Elle joue une suite de temps, en boucle : les trois réponses sur grand
       écran, le déroulé complet en une colonne. Seul le temps passé à l'écran
       compte ; hors champ, elle reste sur le temps en cours. Un jeton à elle
       (`deroule`) l'arrête, comme `jeton` arrête les boucles. */
    let deroule = 0;
    async function derouler(j: number, temps: Temps[]) {
      let i = 0;
      while (j === deroule) {
        const t = temps[i];
        acte = t.acte;
        scene.dataset.acte = String(t.acte);
        changerMode(t.mode);
        let ecoule = 0;
        let repere = performance.now();
        for (;;) {
          await pause(150);
          if (j !== deroule) return;
          const maintenant = performance.now();
          const vu = aLEcran();
          if (vu) ecoule += Math.min(300, maintenant - repere);
          repere = maintenant;
          if (!vu) continue;
          if (ecoule >= t.plafond) break;
          if (acheve && ecoule >= t.mini && maintenant - acheve >= t.tenue) break;
        }
        i = (i + 1) % temps.length;
      }
    }

    /* Ce que le visiteur a choisi au bouton, tant que la scène est à l'écran.
       Le récit ne le contredit pas : il reprend la main quand la scène sort. */
    let choix: Mode | null = null;

    /* Sur grand écran, le récit a la main : le travail à la main pour les deux
       premières phrases, la ronde des trois réponses pour la troisième. En
       mouvement réduit il n'y a pas de ronde, seulement l'image de
       l'automatisation. */
    const suivreRecit = () => {
      deroule += 1;
      if (acte === 3 && !reduit) veiller(derouler(deroule, REPONSES), 'réponses');
      else changerMode(acte === 3 ? 'auto' : 'main');
    };

    const fixerActe = (n: number) => {
      if (n === acte) return;
      acte = n;
      scene.dataset.acte = String(n);
      if (!choix) suivreRecit();
    };

    /* Sur grand écran : quelle phrase est à l'écran, la dernière dont le titre
       a passé les quatre cinquièmes de la fenêtre. La troisième lance les
       réponses. Le même passage dit si la scène est à l'écran : hors champ,
       les boucles attendent. */
    let attenteImage = false;
    const situer = () => {
      attenteImage = false;
      const r = scene.getBoundingClientRect();
      visible = r.bottom > 0 && r.top < window.innerHeight;
      planifier();
      if (!visible && choix) {
        /* La scène est sortie : le récit reprend la main, pour la retrouver
           au bon temps quand on y reviendra. */
        choix = null;
        if (annonce) annonce.textContent = '';
        if (colonne.matches) {
          if (!reduit) veiller(derouler(++deroule, DEROULE), 'déroulé');
        } else {
          suivreRecit();
        }
      }
      if (colonne.matches) return;
      let n = 1;
      for (const titre of titres) {
        if (titre.el.getBoundingClientRect().top < window.innerHeight * 0.8) n = titre.n;
      }
      fixerActe(n);
    };

    /* Le régime change (rotation, fenêtre redimensionnée) : on repart du
       récit. Sur grand écran, la phrase à l'écran est relue même si son
       numéro n'a pas changé, sans quoi la scène resterait sur le temps où la
       colonne l'avait laissée. */
    const regler = () => {
      deroule += 1;
      choix = null;
      if (annonce) annonce.textContent = '';
      if (reduit) return situer();
      if (colonne.matches) {
        veiller(derouler(deroule, DEROULE), 'déroulé');
      } else {
        acte = 0;
        situer();
      }
    };
    const surDefilement = () => {
      if (attenteImage) return;
      attenteImage = true;
      requestAnimationFrame(situer);
    };

    boutons.forEach((b) =>
      b.addEventListener('click', () => {
        const voulu = b.dataset.modeBouton;
        if (!estMode(voulu)) return;
        /* Un appui arrête la régie : la scène reste sur ce qu'on a choisi,
           jusqu'à ce qu'elle sorte de l'écran. */
        choix = voulu;
        deroule += 1;
        changerMode(voulu);
        /* La scène est muette pour un lecteur d'écran : le bouton dit ce
           qu'elle montre. Seulement au clic, pas quand le récit avance seul. */
        if (annonce) annonce.textContent = ANNONCES[voulu];
      }),
    );
    /* Les boutons sortent masqués du HTML : sans ce script ils seraient là,
       et inertes. */
    scene.querySelector<HTMLElement>('[data-mode-groupe]')?.removeAttribute('hidden');

    /* Le plan des fenêtres s'incline un peu vers le pointeur. */
    if (!reduit && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      cadre.addEventListener('pointermove', (e) => {
        const r = cadre.getBoundingClientRect();
        monde.style.setProperty('--ix', `${(((e.clientX - r.left) / r.width) * 2 - 1) * 5}deg`);
        monde.style.setProperty('--iy', `${(((e.clientY - r.top) / r.height) * 2 - 1) * -4}deg`);
      });
      cadre.addEventListener('pointerleave', () => {
        monde.style.removeProperty('--ix');
        monde.style.removeProperty('--iy');
      });
    }

    new ResizeObserver(ajuster).observe(cadre);
    ajuster();
    poser({ x: monde.offsetWidth * 0.55, y: monde.offsetHeight * 0.3 });

    window.addEventListener('scroll', surDefilement, { passive: true });
    window.addEventListener('resize', surDefilement, { passive: true });
    document.addEventListener('visibilitychange', planifier);
    /* `addEventListener` manque sur cet objet avant Safari 14 : sans lui, la
       scène garde simplement le régime de son chargement. */
    colonne.addEventListener?.('change', regler);

    if (reduit) {
      /* Des images fixes, qui suivent le récit : à la main pour les deux
         premières phrases, l'automatisation pour la troisième. */
      figer();
      situer();
      return;
    }

    situer();
    if (mode === 'main') {
      veiller(boucleMain(jeton, 0), 'à la main');
      veiller(arrivees(jeton), 'arrivées');
    }
    if (colonne.matches) veiller(derouler(++deroule, DEROULE), 'déroulé');
  }
</script>
