    .indicateur__nom,
    .pile__tete,
    .fenetre--tableau .fenetre__info { font-size: 10.5px; }

    .indicateur .mot-long { display: none; }
    .indicateur b { font-size: 22px; }

    .pile {
      gap: 5px;
