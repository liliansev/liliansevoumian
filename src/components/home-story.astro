  /* Sous 375 px, « Automatisation » ne tient plus à côté des trois autres :
     le bouton garde son nom complet pour un lecteur d'écran (`aria-label`) et
     n'affiche que son début. */
  @media (max-width: 374px) {
    .scene__mode .mot-long { display: none; }
    .scene__mode .mot-court { display: inline; }
  }

  /* Sans mouvement, on passe d'une image fixe à l'autre : ni caméra, ni
     fenêtre qui glisse, ni bulle qui se pose, ni carte qui avance. */
  @media (prefers-reduced-motion: reduce) {
    .doc__ligne::before,
    .facture__ligne i,
    .facture__ligne svg,
    .curseur__valeur,
    .scene__cadre::before,
    .monde,
    .scene[data-mode] .fenetre[class],
    .bulle,
    .echange__quand,
    .source,
    .article,
    .article .coche,
    .outil,
    .indicateur b,
    .carte,
    .carte svg,
