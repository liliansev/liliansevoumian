---
/*
 * Les projets clients (jamais les projets personnels, 14 octobre 2026), lus
 * dans les cas publiés, du plus récent au plus ancien : une carte par cas,
 * son premier chiffre en grand (en lilas), le client, ce que Lilian a
 * construit (`accroche`) et ses outils, une pastille par outil. Toute la
 * carte mène au cas ; au survol elle passe en lilas.
 */
import { getCollection } from 'astro:content';
import Outils from './outils.astro';
const cas = (await getCollection('cas-clients', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---
<section class="r-sec" id="projets" aria-labelledby="titre-projets">
  <div class="r-wrap">
    <header class="r-titre"><h2 id="titre-projets">Projets clients</h2><p>Ce que j’ai construit, et ce que ça a changé. <a class="r-lien" href="/cas-clients">Tous les cas</a></p></header>
    <div class="r-cas">
      {cas.map(({ id, data }) => {
        const chiffre = data.kpis[0];
        return (
          <article class="r-carte-cas">
            {chiffre ? (
              <p class="r-carte-cas__k"><strong>{chiffre.value}</strong><span>{chiffre.label}</span></p>
            ) : (
              <p class="r-carte-cas__k"><strong>{data.tags[0] ?? 'Projet'}</strong><span>{data.secteur}</span></p>
            )}
            <h3><a href={`/cas-clients/${id}`}>{data.client ?? data.title}</a></h3>
            <p class="r-carte-cas__texte">{data.accroche ?? data.description}</p>
            <Outils outils={data.tools.slice(0, 4)} />
            <span class="r-carte-cas__f" aria-hidden="true">↗</span>
          </article>
        );
      })}
    </div>
  </div>
</section>
