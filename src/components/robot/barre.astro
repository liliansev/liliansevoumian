---
/*
 * La barre de tout le site, « Citron et lilas » (l'accueil le 10 novembre
 * 2026, les autres pages le même jour, rendue par `Navigation`) : une pilule blanche cerclée
 * d'encre qui flotte en haut de l'écran et se resserre dès qu'on défile.
 * Le robot et « lilian » à gauche, les sections, puis le seul bouton
 * d'appel, « Parlons de votre projet » (`BoutonReservation`). Sous 900 px,
 * les liens passent dans un menu en `dialog`.
 *
 * Critique du 11 novembre 2026 : le citron est aux gestes. « Menu » est donc
 * un bouton au trait ; il n'y a plus de lien « Contact » à côté du bouton qui
 * mène au même formulaire (deux noms pour une porte, et un lien hors
 * `BoutonReservation`, donc hors statistiques) ; le lien de la section à
 * l'écran est marqué (`aria-current="location"`) ; quand le formulaire est à
 * l'écran, le bouton d'appel se repose (`est-au-contact`) et « Envoyer »
 * reste le seul citron.
 *
 * Seconde lecture du même jour : la pilule ne change plus de largeur sous le
 * pointeur (elle se resserrait de 122 px par côté au clic sur un lien, et le
 * pointeur immobile tombait sur le lien voisin) ; le menu marque lui aussi la
 * section à l'écran, et sa fermeture rend le focus à « Menu ».
 *
 * Dernière lecture du même jour : sous 560 px la barre porte elle aussi le
 * bouton d'appel (le robot seul à gauche, sans « lilian », lui laisse la
 * place). Sur l'accueil, où le bouton de l'ouverture vient après la photo et
 * tombe souvent sous le premier écran, elle ne le montre que tant que ce
 * bouton-là n'est pas à l'écran (`voit-le-geste`) : jamais les deux ensemble.
 *
 * Relecture de mesures du même jour : la page ne défile plus derrière le menu
 * ouvert, ses liens sont dans une `nav`, et sans script « Menu », qui
 * n'ouvrirait rien, ne s'affiche pas (les pages restent dans le pied).
 */
import BoutonReservation from '../BoutonReservation.astro';
import Robot from './robot.astro';

interface Lien { href: string; label: string }
interface Props {
  /** Les liens : les sections de l'accueil (par défaut), les ancres d'une page d'offre, ou les pages du site. */
  liens?: Lien[];
  /** D'où vient le clic sur le bouton d'appel, dans les statistiques. */
  source?: string;
  sourceMenu?: string;
  /** Où mène le logo : le haut de la page sur l'accueil, l'accueil ailleurs. */
  marqueHref?: string;
}
const accueil: Lien[] = [
  { href: '#services', label: 'Ce que je fais' },
  { href: '#projets', label: 'Projets' },
  { href: '#avis', label: 'Avis' },
  { href: '/blog', label: 'Blog' },
];
const { liens = accueil, source = 'home_nav', sourceMenu = 'home_menu', marqueHref = '#main-content' } = Astro.props;
const marqueLibelle = marqueHref === '/' ? "Lilian Sevoumian, retour à l'accueil" : 'Lilian Sevoumian, haut de page';
// L'accueil ouvre sur son propre bouton d'appel : la barre part du principe
// qu'il est à l'écran, et le script la corrige dès qu'il sait.
const gesteEnOuverture = marqueHref === '#main-content';
const ici = Astro.url.pathname.replace(/\/$/, '') || '/';
const courant = (href: string) => (href.startsWith('/') && (ici === href || ici.startsWith(`${href}/`)) ? 'page' : undefined);
---
<header class:list={['r-barre', gesteEnOuverture && 'voit-le-geste']} data-r-barre>
  <div class="r-barre__in">
    <a class="r-barre__logo" href={marqueHref} aria-label={marqueLibelle}><Robot /><span aria-hidden="true">lilian</span></a>
    <nav class="r-barre__liens" aria-label={marqueHref === '/' ? 'Navigation principale' : 'Sections'}>
      {liens.map((l) => <a href={l.href} aria-current={courant(l.href)}>{l.label}</a>)}
    </nav>
    <BoutonReservation source={source} class="r-btn r-btn--cta r-barre__cta">Parlons de votre projet</BoutonReservation>
    <button class="r-btn r-btn--trait r-barre__menu" type="button" aria-haspopup="dialog" aria-controls="r-menu" aria-expanded="false" data-r-menu-ouvrir>Menu</button>
  </div>
</header>
<dialog class="r-menu tenue-robot" id="r-menu" aria-label="Menu" tabindex="-1">
  <div class="r-menu__haut">
    <span class="r-barre__logo" aria-hidden="true"><Robot /><span>lilian</span></span>
    <button class="r-btn r-btn--trait" type="button" data-r-menu-fermer>Fermer</button>
  </div>
  <nav class="r-menu__liens" aria-label={marqueHref === '/' ? 'Navigation principale' : 'Sections'}>
    {liens.map((l) => <a class="r-menu__lien" href={l.href} aria-current={courant(l.href)}>{l.label}</a>)}
  </nav>
  <BoutonReservation source={sourceMenu} class="r-btn r-btn--cta r-menu__cta">Parlons de votre projet</BoutonReservation>
</dialog>
<script>
  const barre = document.querySelector<HTMLElement>('[data-r-barre]');
  // La pilule se resserre dès qu'on défile, jamais sous le pointeur : tant
  // qu'il est dessus elle garde sa largeur, et se met à jour quand il la quitte.
  const pilule = barre?.querySelector<HTMLElement>('.r-barre__in');
  let dessus = false;
  const surDefile = () => { if (!dessus) barre?.classList.toggle('est-defile', window.scrollY > 40); };
  pilule?.addEventListener('pointerenter', (e) => { dessus = e.pointerType === 'mouse'; });
  pilule?.addEventListener('pointerleave', () => { dessus = false; surDefile(); });
  window.addEventListener('scroll', surDefile, { passive: true });
  surDefile();
  const menu = document.getElementById('r-menu') as HTMLDialogElement | null;
  // Ouvert au doigt ou à la souris, le menu ne pose d'anneau de focus ni sur
  // « Fermer » à l'ouverture ni sur « Menu » à la fermeture (Lilian, 10
  // novembre 2026) ; au clavier (detail à 0), l'anneau reste.
  let auPointeur = false;
  const ouvrir = document.querySelector('[data-r-menu-ouvrir]');
  ouvrir?.addEventListener('click', (e) => {
    auPointeur = (e as MouseEvent).detail > 0;
    menu?.showModal();
    ouvrir.setAttribute('aria-expanded', 'true');
    if (auPointeur) menu?.focus();
  });
  document.querySelector('[data-r-menu-fermer]')?.addEventListener('click', () => menu?.close());
  // Un clic à côté de la feuille (sur le voile) ferme le menu, comme Échap.
  menu?.addEventListener('click', (e) => {
    if (e.target !== menu) return;
    const b = menu.getBoundingClientRect();
    if (e.clientX < b.left || e.clientX > b.right || e.clientY < b.top || e.clientY > b.bottom) menu.close();
  });
  // À la fermeture le focus revient sur « Menu » : lâché, il retombait sur la
  // page entière et la tabulation suivante repartait du haut. Au pointeur il y
  // revient sans anneau (`sans-anneau`, retiré dès que le bouton perd le focus).
  // Si le lien choisi a posé le focus ailleurs (le bouton d'appel le pose dans
  // le formulaire), il y reste.
  const bouton = ouvrir as HTMLElement | null;
  menu?.addEventListener('close', () => {
    bouton?.setAttribute('aria-expanded', 'false');
    const actif = document.activeElement;
    if (actif && actif !== document.body && actif !== bouton && !menu.contains(actif)) return;
    bouton?.classList.toggle('sans-anneau', auPointeur);
    bouton?.focus({ preventScroll: true });
  });
  bouton?.addEventListener('blur', () => bouton.classList.remove('sans-anneau'));
  // Un lien du menu vers une section de la page : le focus va à cette section,
  // pas à « Menu », d'où la tabulation suivante repartait du haut (et la page
  // remontait). La section ne s'encadre pas : le focus y est posé pour la suite.
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    menu.close();
    const cible = a.hash && a.pathname === location.pathname ? document.getElementById(a.hash.slice(1)) : null;
    if (!cible) return;
    if (!cible.hasAttribute('tabindex')) cible.setAttribute('tabindex', '-1');
    cible.focus({ preventScroll: true });
  }));

  if (barre && 'IntersectionObserver' in window) {
    // La section à l'écran : son lien est marqué dans la barre. La bande
    // d'observation est une ligne au tiers haut de la fenêtre.
    const ancres = [...barre.querySelectorAll<HTMLAnchorElement>('.r-barre__liens a[href^="#"]')];
    // Le menu des petits écrans porte la même marque.
    const tous = [...ancres, ...(menu?.querySelectorAll<HTMLAnchorElement>('.r-menu__lien[href^="#"]') ?? [])];
    const sections = ancres.map((a) => document.getElementById(a.hash.slice(1))).filter((s): s is HTMLElement => !!s);
    const vues = new Set<Element>();
    // Devant le formulaire, aucune section n'est marquée : la dernière
    // (« Avis ») le restait alors que l'île du contact remplissait l'écran.
    let auContact = false;
    const marquer = () => {
      const ici = auContact ? undefined : sections.filter((s) => vues.has(s)).pop();
      for (const a of tous) {
        if (ici && a.hash === `#${ici.id}`) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    if (sections.length) {
      const guet = new IntersectionObserver((entrees) => {
        for (const e of entrees) e.isIntersecting ? vues.add(e.target) : vues.delete(e.target);
        marquer();
      }, { rootMargin: '-34% 0px -65% 0px' });
      sections.forEach((s) => guet.observe(s));
    }
    // Le bouton d'appel de l'ouverture à l'écran : sur téléphone, celui de la
    // barre s'efface (deux citrons pour une porte, sinon). Pas de bouton en
    // ouverture : la barre garde le sien.
    const gesteOuverture = document.querySelector('.r-hero [data-contact-ouvrir]');
    if (gesteOuverture) {
      new IntersectionObserver(([e]) => barre.classList.toggle('voit-le-geste', e.isIntersecting), { rootMargin: '-72px 0px 0px 0px' }).observe(gesteOuverture);
    } else barre.classList.remove('voit-le-geste');
    // Le formulaire de contact à l'écran : le bouton d'appel se repose.
    const formulaire = document.querySelector('[data-formulaire-contact]');
    if (formulaire) {
      new IntersectionObserver(([e]) => {
        auContact = e.isIntersecting;
        barre.classList.toggle('est-au-contact', auContact);
        if (sections.length) marquer();
      }, { rootMargin: '-80px 0px -25% 0px' }).observe(formulaire);
    }
  }
</script>
