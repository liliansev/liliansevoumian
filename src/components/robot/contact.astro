---
/*
 * La fin de l'accueil, sur blanc : « Parlons de votre projet » et le
 * formulaire du site (`formulaire-contact.astro`, envoyé par /api/contact),
 * rien d'autre. Lilian, 10 novembre 2026 : « trop d'informations, le
 * formulaire, l'appel, et le mail. restons sur le formulaire point barre ».
 * Ni lien vers l'agenda, ni adresse sous le bouton (`note={false}` : elle ne
 * revient que si l'envoi échoue ou sans script). Tous les « Parlons de votre
 * projet » de la page y mènent : Layout fait défiler jusqu'au formulaire.
 */
import FormulaireContact from '../formulaire-contact.astro';
import Robot from './robot.astro';
---
<section class="r-contact" id="ecrire" aria-labelledby="titre-ecrire">
  <div class="r-wrap r-contact__grille">
    <div>
      <Robot class="r-contact__bot" />
      <h2 id="titre-ecrire">Parlons de votre projet</h2>
      <p>Trois lignes suffisent. Je lis tout, et je réponds moi-même.</p>
    </div>
    <FormulaireContact source="home_fin" variante="carnet" note={false} />
  </div>
</section>
