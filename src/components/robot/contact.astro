---
/*
 * La fin de l'accueil, sur blanc : « Parlons de votre projet », le
 * formulaire du site (`formulaire-contact.astro`, envoyé par /api/contact) et
 * le lien vers l'agenda (goal `lead_call`). Tous les « Parlons de votre
 * projet » de la page y mènent : Layout fait défiler jusqu'au formulaire.
 */
import BoutonReservation from '../BoutonReservation.astro';
import FormulaireContact from '../formulaire-contact.astro';
import { DUREE_RESERVATION_MINUTES } from '../../lib/reservation';
import Robot from './robot.astro';
---
<section class="r-contact" id="ecrire" aria-labelledby="titre-ecrire">
  <div class="r-wrap r-contact__grille">
    <div>
      <Robot class="r-contact__bot" />
      <h2 id="titre-ecrire">Parlons de votre projet</h2>
      <p>Trois lignes suffisent. Le message arrive directement dans ma boîte, et je réponds moi-même.</p>
      <p class="r-contact__agenda">Plutôt un appel ? <BoutonReservation source="home_fin" direct class="r-lien">Réservez {DUREE_RESERVATION_MINUTES}&nbsp;minutes<span class="sr-only"> (ouvre l’agenda)</span></BoutonReservation></p>
    </div>
    <FormulaireContact source="home_fin" variante="carnet" />
  </div>
</section>
