---
/*
 * Les étapes d'un cas client, en cartes : ce qui a été construit, pièce par
 * pièce. Elles n'apparaissent qu'au bureau (`bureau.css`), dans la pile des
 * projets de l'accueil. Rien n'y bouge : c'était un canvas de modules reliés
 * par des fils animés, Lilian a demandé le 10 novembre 2026 « pas
 * d'animations ici, juste des belles cards ».
 *
 * Deux formes, lues dans le frontmatter du cas, jamais écrites ici :
 *   - `flow` : ce qui déclenche et ce qui traite, côte à côte, puis les trois
 *     actions dessous (la même donnée que le schéma de la page du cas) ;
 *   - `parcours` : cinq étapes dans l'ordre, numérotées, pour une application
 *     qui se lit d'un bout à l'autre (trois en haut, deux en bas).
 * Un cas sans l'une ni l'autre n'a pas de cartes.
 *
 * Chaque carte porte la couleur de son outil (`data/outils.ts`) quand on le
 * connaît : par `outil`, par un nom d'outil dans son sur-titre ou son titre,
 * ou par son icône de marque ; sinon le gris neutre. Une seule carte est sur
 * lilas : ce qui traite dans un `flow`, l'aboutissement d'un `parcours`.
 * Tout est décoratif (`aria-hidden`) ; une phrase dit la même chose aux
 * lecteurs d'écran.
 */
import { Icon } from 'astro-icon/components';
import { couleursOutils } from '../../data/outils';

interface Noeud { icon: string; kicker: string; title: string; sub?: string; outil?: string }
interface Props {
  flow?: { describe: string; trigger: Noeud; agent: Noeud; actions: Noeud[] };
  parcours?: Noeud[];
  decrit?: string;
}
const { flow, parcours, decrit } = Astro.props;

const MARQUES: Record<string, string> = {
  hubspot: 'HubSpot', gmail: 'Gmail', mistralai: 'Mistral', anthropic: 'Claude', claude: 'Claude',
  shopify: 'Shopify', slack: 'Slack', notion: 'Notion', make: 'Make', n8n: 'n8n', airtable: 'Airtable', glide: 'Glide',
};
const couleur = (n: Noeud) => {
  if (n.outil && couleursOutils[n.outil]) return couleursOutils[n.outil];
  const texte = `${n.kicker} ${n.title}`;
  const nomme = Object.keys(couleursOutils).find((o) => o !== 'IA' && new RegExp(`(^|[^\\p{L}])${o}([^\\p{L}]|$)`, 'u').test(texte));
  if (nomme) return couleursOutils[nomme];
  const marque = MARQUES[n.icon.split(':')[1] ?? ''];
  return marque ? couleursOutils[marque] : '#cfc8bf';
};

const cartes: (Noeud & { forte?: boolean })[] = flow
  ? [flow.trigger, { ...flow.agent, forte: true }, ...flow.actions]
  : (parcours ?? []).map((n, i, tous) => ({ ...n, forte: i === tous.length - 1 }));
---
{cartes.length > 0 && (
  <div class:list={['r-etapes', flow ? 'r-etapes--eventail' : 'r-etapes--file']}>
    <p class="sr-only">{flow ? flow.describe : decrit}</p>
    <ol class="r-etapes__liste" aria-hidden="true">
      {cartes.map((n, i) => (
        <li class:list={['r-etape', n.forte && 'r-etape--forte']} style={`--o:${couleur(n)}`}>
          <span class="r-etape__tete">
            <span class="r-etape__ic"><Icon name={n.icon} /></span>
            {parcours && <span class="r-etape__rang">{String(i + 1).padStart(2, '0')}</span>}
          </span>
          <span class="r-etape__sur">{n.kicker}</span>
          <strong>{n.title}</strong>
          {n.sub && <span class="r-etape__sous">{n.sub}</span>}
        </li>
      ))}
    </ol>
  </div>
)}
