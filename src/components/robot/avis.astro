---
/*
 * « Ils en parlent » : les trois recommandations de `data/avis.ts`, mot pour
 * mot, en bulles de discussion, la deuxième à droite. Le passage qui compte
 * est surligné en citron.
 */
import { Image } from 'astro:assets';
import { avis } from '../../data/avis';
---
<section class="r-sec" id="avis" aria-labelledby="titre-avis">
  <div class="r-wrap r-avis">
    <header class="r-titre"><h2 id="titre-avis">Ils en parlent</h2><p>Trois personnes avec qui j’ai travaillé.</p></header>
    <div class="r-fil">
      {avis.map((a) => (
        <figure class="r-bulle">
          <Image src={a.image} alt="" width={50} height={50} densities={[1, 2]} loading="lazy" />
          <div>
            <blockquote><p>{a.citation[0]}<mark>{a.citation[1]}</mark>{a.citation[2]}</p></blockquote>
            <figcaption><strong>{a.nom}</strong> · {a.role}</figcaption>
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>
