---
import LinkCTA from './LinkCTA.astro';
/*
 * Offres.astro — section §04
 *
 * Volontairement SANS catalogue de formats : on ne fait pas choisir le prospect
 * dans une grille figée. Bloc à gauche (porte ouverte : Lilian propose le format
 * adapté), CTA à droite. Minimaliste. Les liens augmentes.fr restent.
 */
---

<section
  id="offres"
  data-section
  class="bloc-lime relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]"
>
  <div class="relative max-w-[680px] mx-auto reveal flex flex-col items-center text-center gap-6">

    {/* Porte ouverte — centrée */}
    <div class="section-number !mb-0">TRAVAILLER ENSEMBLE</div>
    <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] m-0 text-[var(--color-ink)] max-w-[18ch]">
      On trouve le <mark class="inv">bon format</mark> ensemble.
    </h2>
    <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 max-w-[54ch]">
      Régie, mission cadrée, mentoring d'équipe, coaching ponctuel… je n'ai pas
      de grille figée. On part de votre besoin réel et je vous propose le format
      le plus adapté, souvent un mélange.
    </p>

    {/* Actions */}
    <div class="mt-2 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 w-full sm:w-auto">
      <a
        href="https://cal.com/lilian-sevoumian/20min" target="_blank" rel="noopener noreferrer"
        class="btn-primary justify-center"
        data-fast-goal="lead_call"
        data-fast-goal-source="offres"
      >
        Réserver mon diagnostic&nbsp;· 20&nbsp;min
      </a>
      <LinkCTA href="#cas">Ou voir les résultats clients</LinkCTA>
    </div>

    {/* Pont augmentes.fr — route l'intention « apprendre soi-même » vers la
        plateforme formations. Lien secondaire, jamais primaire. */}
    <p class="mt-4 mono-caption text-[var(--color-ink-low)]">
      VOUS PRÉFÉREZ APPRENDRE À LE FAIRE VOUS-MÊME&nbsp;?
      <a
        href="https://augmentes.fr"
        target="_blank"
        rel="noopener noreferrer"
        class="tap-44 text-[var(--color-accent-text)] hover:text-[var(--color-ink)] transition-colors ml-1"
      >
        FORMATIONS MAKE &amp; N8N SUR AUGMENTES.FR&nbsp;<span aria-hidden="true">↗</span>
      </a>
    </p>

  </div>
</section>
