---
/*
 * Offres.astro — section §04
 *
 * Volontairement SANS catalogue de formats : on ne fait pas choisir le prospect
 * dans une grille figée. Bloc à gauche (porte ouverte : Lilian propose le format
 * adapté), CTA à droite. Minimaliste. Les liens augmentes.fr restent.
 */
---

<section
  id="offres"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_minmax(0,400px)] gap-10 lg:gap-16 items-center">

      {/* Bloc gauche — la porte ouverte */}
      <div class="reveal flex flex-col gap-5">
        <div class="section-number">TRAVAILLER ENSEMBLE</div>
        <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] m-0 text-[var(--color-ink)] max-w-[16ch]">
          On trouve le bon format ensemble.
        </h2>
        <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] m-0 max-w-[52ch]">
          Régie, mission cadrée, mentoring d'équipe, coaching ponctuel… je n'ai pas
          de grille figée. On part de votre besoin réel et je vous propose le format
          le plus adapté, souvent un mélange.
        </p>
      </div>

      {/* CTA droite */}
      <div class="reveal">
        <div class="card flex flex-col gap-4 p-7 md:p-8">
          <p class="mono-caption text-[var(--color-ink-low)] leading-[1.5]">
            PREMIER ÉCHANGE · 20 MIN · SANS ENGAGEMENT
          </p>
          <a
            href="https://cal.com/lilian-sevoumian/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full justify-center"
            data-fast-goal="lead_call"
            data-fast-goal-source="offres"
          >
            Réserver un appel · 20 min
          </a>
          <a href="#contact-form" class="btn-ghost w-full justify-center">
            M'écrire
          </a>
        </div>
      </div>

    </div>

    {/* Pont augmentes.fr — route l'intention « apprendre soi-même » vers la
        plateforme formations. Lien secondaire, jamais primaire. */}
    <p class="reveal mt-10 md:mt-12 mono-caption text-[var(--color-ink-low)]">
      VOUS PRÉFÉREZ APPRENDRE À LE FAIRE VOUS-MÊME&nbsp;?
      <a
        href="https://augmentes.fr"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[var(--color-accent)] hover:text-[var(--color-ink)] transition-colors ml-1"
      >
        FORMATIONS MAKE &amp; N8N SUR AUGMENTES.FR&nbsp;<span aria-hidden="true">↗</span>
      </a>
    </p>

  </div>
</section>
