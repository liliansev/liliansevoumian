---
import LinkCTA from './LinkCTA.astro';
import BoutonReservation from './BoutonReservation.astro';
import { DUREE_RESERVATION_MINUTES } from '../lib/reservation';
/*
 * Offres.astro — les formats de collaboration.
 *
 * Pas de numéro de section dans cet en-tête : il portait « §04 » quand l'ordre
 * de la home en faisait la quatrième, et elle y est huitième depuis que le
 * calculateur est remonté en deuxième position. L'ordre vit dans index.astro,
 * à un seul endroit ; le répéter ici crée une deuxième vérité qui se périme
 * sans que rien ne le signale.
 *
 * Trois formats décrits, et toujours pas de grille tarifaire.
 *
 * La version précédente tenait en cinquante mots et citait quatre formats
 * (« Régie, mission cadrée, mentoring d'équipe, coaching ponctuel… ») sans en
 * définir un seul : ni livrable, ni périmètre, ni point de départ. C'était la
 * section la plus courte de la page — cinq fois moins haute que celle des
 * outils — et la seule qui vend. Ne rien décrire ne protégeait de rien : ça
 * repoussait la totalité de la décision à l'appel de 20 min, ce qui est
 * l'inverse de ce que la page promet.
 *
 * Le prix reste absent, et la position qui l'explique est désormais ÉNONCÉE ICI
 * plutôt que réservée à la FAQ. Elle y tenait la question « Combien coûte une
 * automatisation ? », qui était cinquième sur six et repliée dans un accordéon,
 * à 9 500 px du haut de page : personne ne se budget-qualifiait dessus. Le
 * lecteur se pose la question au moment où il lit ce qu'on peut construire pour
 * lui, c'est-à-dire ici. Le fond ne change pas — le même énoncé vaut trois
 * jours chez l'un et trois mois chez l'autre, le devis est ferme et arrive
 * après l'appel — il devient seulement trouvable deux fois.
 *
 * Les trois formats ne sont pas inventés : ils recouvrent ce que le site prouve
 * déjà ailleurs — les quatre cas clients (construire), la page « reprendre une
 * automatisation qui casse » et la question « Et si un de mes outils change et
 * que tout casse ? » de la FAQ (reprendre), la certification formateur et les
 * trois cents personnes formées (rendre la main). Les questions de la FAQ sont
 * citées par leur énoncé et non par leur rang, pour la même raison que le
 * numéro de section a disparu : leur ordre bouge.
 */

const formats = [
  {
    titre: 'Construire ce qui n’existe pas',
    corps:
      'Un workflow ou un agent, de la première brique à la mise en production dans vos outils. Vous repartez avec la documentation, et je corrige sans surcoût le mois qui suit la livraison.',
    depart: 'On part du process qui vous coûte le plus de temps.',
  },
  {
    titre: 'Reprendre ce qui casse',
    corps:
      'Une automatisation héritée de quelqu’un d’autre, qui tombe à chaque changement d’API. Je la relis, je la répare, et je la laisse dans un état où votre équipe peut la suivre.',
    depart: 'On part de ce qui tourne déjà, mal.',
  },
  {
    titre: 'Rendre la main à votre équipe',
    corps:
      'Des sessions sur vos propres scénarios, pas sur des cas d’école. Certifié formateur Make, plus de trois cents personnes formées depuis 2020.',
    depart: 'On part de ce que personne chez vous n’ose encore toucher.',
  },
];
---

<section
  id="offres"
  data-section
  {/* Bande grise et non aplat lime. Deux raisons qui vont dans le même sens.
      La section « contact » 900 px plus bas portait le même aplat, le même
      bouton et la même destination : deux fins de page en lime se disputaient
      la conclusion. Et le lime perd son sens s'il revient trop souvent : il est
      rendu ici à trois moments qui se distinguent — le début (hero), la preuve
      (témoignages), la fin (contact). Le panneau de résultat du simulateur est
      une incrustation dans une bande grise, pas un aplat de section.
      (Décision de ce fichier, pas une règle écrite dans DESIGN.md — une version
      antérieure de ce commentaire la citait comme telle, à tort.) */}
  class="section-band relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <div class="reveal mb-12 md:mb-16">
      {/* Sans sur-titre : « TRAVAILLER ENSEMBLE » annonçait en petites capitales
          ce que le titre annonce en grand, et le verbe du titre est plus précis
          que le sien. */}
      <div class="offres-header">
        <h2 class="font-display font-semibold text-[length:var(--text-headline)] leading-[1.05] tracking-[-0.035em] m-0 text-[var(--color-ink)] max-w-[20ch]">
          Construire, reprendre, ou <mark>rendre la main</mark>.
        </h2>
      </div>
      <p class="text-[length:var(--text-body-large)] text-[var(--color-ink-mid)] leading-[1.5] mt-6 md:mt-7 mb-0 max-w-[56ch]">
        Trois formats. Le vôtre est souvent un mélange des trois, et c’est
        l’appel de {DUREE_RESERVATION_MINUTES} min qui le décide.
      </p>
    </div>

    {/* Filets et non cartes : le rythme de la page vient des traits, et une
        grille de trois cartes à icône est le motif que ce site évite partout
        ailleurs. `auto-fit` plutôt qu'un nombre de colonnes figé — trois
        formats aujourd'hui, la grille ne casse pas s'il y en a deux ou quatre. */}
    <div class="reveal-stagger offres-grille">
      {formats.map((f) => (
        <div class="reveal offres-item">
          <h3 class="font-display font-semibold text-[length:var(--text-title)] leading-[1.2] tracking-[-0.02em] m-0 text-[var(--color-ink)]">
            {f.titre}
          </h3>
          <p class="text-[length:var(--text-body)] text-[var(--color-ink-mid)] leading-[1.6] mt-3 mb-0">
            {f.corps}
          </p>
          <p class="text-[length:var(--text-body-sm)] text-[var(--color-ink-low)] leading-[1.5] mt-4 mb-0 offres-depart">
            {f.depart}
          </p>
        </div>
      ))}
    </div>

    {/* La durée, le mode d'engagement et le budget, énoncés une fois pour les
        trois — les répéter par format aurait donné trois fois la même phrase.

        La ligne budget est la seule mention entrante du mot sur la page : les
        deux autres occurrences étaient des liens SORTANTS vers augmentes.fr, si
        bien que le lecteur qui cherchait « budget » ne trouvait qu'une porte de
        sortie. Elle porte le mot en tête, en encre pleine, pour qu'il se
        repère au balayage sans ajouter un sur-titre en capitales. */}
    <div class="reveal offres-cadre">
      <p>
        En régie ou en mission cadrée, selon ce qui vous arrange. La durée dépend
        du périmètre.
      </p>
      <p class="offres-budget">
        <strong>Budget&nbsp;:</strong> pas de grille tarifaire, parce que le même
        énoncé vaut trois jours de travail chez l’un et trois mois chez l’autre.
        Le devis est ferme et arrive après l’appel de {DUREE_RESERVATION_MINUTES} min, une fois le
        périmètre posé. Si c’est votre sujet principal, dites-le dès le début.
        Je vous dis franchement si le projet tient dedans.
      </p>
    </div>

    {/* Actions */}
    <div class="reveal mt-10 md:mt-12 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
      <BoutonReservation source="offres" class="btn-primary justify-center">
        Automatiser mon business
      </BoutonReservation>
      {/* La page, pas l'ancre. `#cas` renvoyait le lecteur six mille pixels en
          arrière, au milieu d'un carrousel qu'il venait de dépasser : un lien
          qui remonte aussi loin se vit comme une perte de place, pas comme une
          sortie. `/cas-clients` va vers l'avant et montre les quatre cas
          entiers plutôt qu'une slide sur quatre. */}
      {/* Pas de `goal` en attribut ici : le listener délégué de Layout tague
          déjà tout lien vers /cas-clients en `case_opened`, et deux goals sur
          le même clic compteraient la même intention deux fois. */}
      <LinkCTA href="/cas-clients">Ou voir les résultats clients</LinkCTA>
    </div>

    {/* L'offre web reste une route distincte : ce pont qualifie l'intention sans
        ajouter un septième lien dans la barre de navigation de la home. */}
    <div class="reveal mt-10 pt-7 border-t border-[var(--color-divider)] flex flex-col md:flex-row md:items-center md:justify-between gap-5">
      <p class="m-0 max-w-[58ch] text-[length:var(--text-body)] leading-[1.6] text-[var(--color-ink-mid)]">
        Vous cherchez plutôt un site conçu pour continuer à évoluer après sa
        mise en ligne&nbsp;? La création commence à 1&nbsp;900&nbsp;€ HT, puis
        Care ou Growth prend le relais si le projet le justifie.
      </p>
      <LinkCTA href="/sites-web-abonnement">Voir l’offre sites web</LinkCTA>
    </div>

    {/* Pont augmentes.fr — route l'intention « apprendre soi-même » vers la
        plateforme formations. Lien secondaire, jamais primaire. */}
    {/* CASSE NORMALE ET NON PETITES CAPITALES, et c'est la même correction aux
        trois endroits du site où une PHRASE entière était composée en capitales
        à onze pixels. Les capitales suppriment la silhouette des mots : l'œil ne
        lit plus une forme, il déchiffre lettre à lettre. Passe encore sur un
        libellé de bouton de trois mots ; sur quatre-vingts caractères, à la plus
        petite taille du système et avec 0,06 em d'interlettrage, c'était la
        ligne la moins lisible de la page. Le détecteur d'anti-patterns la
        relève sous `all-caps-body`, et le site avait déjà pris cette décision
        ailleurs — la réassurance de /reprendre-une-automatisation-qui-casse est
        descendue du sur-titre dans le chapô pour exactement ce motif.
        Le corps passe à --text-body-sm, la mesure que le cadre budget de cette
        même section emploie déjà. */}
    <p class="reveal mt-8 text-[length:var(--text-body-sm)] leading-[1.6] text-[var(--color-ink-low)]">
      Vous préférez apprendre à le faire vous-même&nbsp;?
      <a
        href="https://augmentes.fr"
        target="_blank"
        rel="noopener noreferrer"
        class="tap-44 text-[var(--color-accent-text)] hover:text-[var(--color-ink)] transition-colors ml-1"
        data-fast-goal="outbound_formations"
        data-fast-goal-source="offres"
      >
        Formations Make &amp; n8n sur augmentes.fr&nbsp;<span aria-hidden="true">↗</span>
      </a>
    </p>

  </div>
</section>

<style>
  .offres-header {
    position: relative;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .offres-grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    /* Une seule gouttière, sur les deux axes, fluide. Les trois règles qu'elle
       remplace se contredisaient dans deux plages mesurées : `auto-fit` passe à
       deux colonnes dès 578 px alors que la gouttière horizontale n'arrivait
       qu'à 640 — les colonnes s'y touchaient et leurs deux filets de tête n'en
       formaient qu'un. Et de 640 à 1008 px, la gouttière verticale nulle faisait
       toucher le filet du troisième format à la dernière ligne du premier, au
       pixel près. */
    gap: clamp(1.75rem, 4vw, 4rem);
  }

  .offres-item {
    /* La note « On part de… » se cale en bas de colonne. Sans ça, la troisième
       carte la posait 26 px plus haut que les deux autres — son corps fait trois
       lignes contre quatre — et un rôle répété se lisait à trois horizontales
       différentes, dans une grille explicitement filetée en colonnes. */
    display: flex;
    flex-direction: column;
    /* Le filet ouvre chaque format, comme les pull-quotes des témoignages. En
       une seule colonne il devient une séparation horizontale, en plusieurs il
       coiffe chaque colonne — même trait, deux lectures. */
    border-top: 1px solid var(--color-divider);
    padding: 1.75rem 0 0;
  }

  /* Le filet court sur toute la largeur, le texte s'arrête à sa mesure : posé
     sur le paragraphe lui-même, le trait s'interrompait au milieu de la grille
     et se lisait comme une bordure cassée. */
  .offres-depart { margin-top: auto; padding-top: 1rem; }

  .offres-cadre {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-divider);
  }
  .offres-cadre p {
    margin: 0;
    max-width: 62ch;
    font-size: var(--text-body-sm);
    line-height: 1.6;
    color: var(--color-ink-low);
  }
  /* 24 px pour un interligne de 22,4 : l'écart entre les deux lignes du cadre
     dépasse la ligne pleine, sinon le budget se lirait comme la suite de la
     phrase sur l'engagement. */
  .offres-cadre p + p { margin-top: 1.5rem; }

  /* La ligne budget monte d'un rang par rapport au reste du cadre : ce n'est
     plus de la mention légale, c'est la réponse à la question que le lecteur
     se pose ici. Encre moyenne pour le corps (6,6:1 sur la bande grise), encre
     pleine sur le mot lui-même. */
  .offres-budget { color: var(--color-ink-mid); }
  .offres-budget strong {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
