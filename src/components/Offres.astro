---
import SectionHeader from './SectionHeader.astro';
import LinkCTA from './LinkCTA.astro';
import BoutonReservation from './BoutonReservation.astro';
import SubscriptionGrid from './SubscriptionGrid.astro';
import { automationSubscriptions, webSubscriptions, maintenanceScope } from '../data/maintenance';
import { automationStartingPrice, webStartingPrice } from '../data/service-pricing';
import { DUREE_RESERVATION_MINUTES } from '../lib/reservation';
/*
 * Offres — les trois formats de collaboration, puis ce qu'ils coûtent.
 *
 * C'est l'île claire de la page (`.bloc-encre`) : le lecteur y vient vérifier
 * un prix. Les deux prix se lisent donc dans un titre, pas dans une note : la
 * création (à partir de, sur devis), puis le suivi mensuel et sa grille.
 *
 * Tout est posé sur une même grille de trois colonnes : les trois formats, les
 * deux prix (le titre dans la première colonne, son explication dans les deux
 * autres), la liste des abonnements (`SubscriptionGrid`, dont la première
 * colonne est calée ici sur cette grille) et la rangée de fin (l'action, puis
 * les deux autres portes). Ni cadre ni filet : l'espace sépare.
 *
 * Les trois formats ne sont pas inventés : ils recouvrent ce que le site
 * prouve ailleurs, les cas clients (créer), la page « reprendre une
 * automatisation qui casse » (fiabiliser), la certification de formateur et
 * les trois cents personnes formées (former).
 *
 * Les tarifs viennent de data/maintenance.ts et de data/service-pricing.ts,
 * partagés avec l'accueil et les questions.
 */

const formats = [
  {
    titre: 'Créer une automatisation',
    corps:
      'Un workflow ou un agent, du cadrage à la mise en production dans vos outils. Je documente la solution et j’en assure ensuite le suivi avec un abonnement mensuel.',
    depart: 'Pour une tâche encore traitée à la main.',
  },
  {
    titre: 'Fiabiliser l’existant',
    corps:
      'J’examine votre automatisation, identifie les points de panne et reprends les connexions ou les règles qui posent problème.',
    depart: 'Pour un workflow devenu difficile à utiliser ou à maintenir.',
  },
  {
    titre: 'Former votre équipe',
    corps:
      'Des sessions sur vos scénarios pour comprendre leur fonctionnement, les utiliser et repérer les problèmes.',
    depart: 'Pour faciliter la prise en main des outils livrés.',
  },
];
---

<section
  id="offres"
  data-section
  class="bloc-encre relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">
    <SectionHeader
      title="Une solution à créer ou à reprendre."
      body="Nous partons de ce qui existe chez vous et de ce que vous voulez améliorer."
      titleMaxWidth="20ch"
    />

    <div class="offres">
      <div class="offres-grille reveal-stagger">
        {formats.map((f) => (
          <div class="reveal offres-format">
            <h3>{f.titre}</h3>
            <p class="offres-format__corps">{f.corps}</p>
            <p class="offres-format__depart">{f.depart}</p>
          </div>
        ))}
      </div>

      {/* Le prix de création, énoncé une fois pour les trois formats. */}
      <div class="reveal offres-grille offres-prix">
        <h3>
          Création à partir de {automationStartingPrice.toLocaleString('fr-FR')}&nbsp;€&nbsp;HT, sur devis.
        </h3>
        <p>
          Nous priorisons les workflows et les agents pendant l’appel de {DUREE_RESERVATION_MINUTES}&nbsp;min.
          Vous recevez ensuite un devis pour le périmètre convenu, distinct de l’abonnement de suivi. Il précise
          le travail à réaliser et le calendrier.
        </p>
      </div>

      <div id="abonnements" class="offres-suivi">
        <div class="reveal offres-grille offres-prix">
          <h3>Un suivi prévu dès le départ.</h3>
          <p>
            Chaque automatisation livrée s’accompagne d’un abonnement mensuel. Hébergement, maintenance et petits
            ajustements de l’existant sont inclus.
          </p>
        </div>
        <div class="reveal">
          <SubscriptionGrid offers={automationSubscriptions} label="Abonnements automatisations et IA" />
        </div>
        <p class="offres-note">{maintenanceScope}</p>
      </div>

      {/* La fin de l'île : l'action à gauche, puis les deux autres portes. Le
          lien vers les cas mène à la page et non à l'ancre `#cas`, qui ferait
          remonter le lecteur au milieu d'un carrousel déjà dépassé. Il ne
          porte pas de `goal` : Layout tague déjà tout lien vers /cas-clients
          en `case_opened`. */}
      <div class="reveal offres-grille offres-fin">
        <div class="offres-action">
          <BoutonReservation source="offres" class="btn-primary justify-center" />
          <LinkCTA href="/cas-clients">Voir les cas clients</LinkCTA>
        </div>

        <div class="offres-porte">
          <p>
            Pour un site web, la création commence à {webStartingPrice.toLocaleString('fr-FR')}&nbsp;€&nbsp;HT, puis
            l’abonnement de suivi commence à {webSubscriptions[0].schemaPrice}&nbsp;€&nbsp;HT&nbsp;/&nbsp;mois pour une
            landing page.
          </p>
          <LinkCTA href="/sites-web-abonnement">Voir l’offre sites web</LinkCTA>
        </div>

        {/* La sortie vers augmentes.fr, pour qui veut apprendre à le faire
            lui-même plutôt que confier une mission. */}
        <div class="offres-porte">
          <p>Vous préférez apprendre à le faire vous-même&nbsp;?</p>
          <LinkCTA href="https://augmentes.fr" external goal="outbound_formations" goalSource="offres">
            Voir les formations Make et n8n
          </LinkCTA>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .offres {
    display: grid;
    gap: var(--spacing-bloc);
  }

  /* Une colonne, puis trois dès que chacune garde une mesure lisible. */
  .offres-grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-groupe) var(--spacing-gouttiere);
  }

  /* La note « Pour… » se cale en bas de colonne : les trois corps n'ont pas la
     même longueur, et un rôle répété se lirait sinon à trois hauteurs. */
  .offres-format {
    display: flex;
    flex-direction: column;
  }

  .offres-format h3 {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-title);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .offres-format__corps {
    max-width: 60ch;
    margin: 0.75rem 0 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  .offres-format__depart {
    margin: auto 0 0;
    padding-top: 1rem;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  /* Un prix : le titre le dit, le paragraphe l'explique. */
  .offres-prix {
    align-items: baseline;
    row-gap: var(--spacing-lie);
  }

  .offres-prix h3 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-title-lg);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .offres-prix p {
    max-width: 62ch;
    margin: 0;
    color: var(--color-ink-mid);
    line-height: var(--leading-body);
  }

  .offres-suivi {
    display: grid;
    gap: var(--spacing-groupe);
  }

  /* La note colle à la grille qu'elle précise. */
  .offres-note {
    max-width: 65ch;
    margin: calc(var(--spacing-lie) - var(--spacing-groupe)) 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .offres-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-colle);
  }

  .offres-porte p {
    max-width: 48ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-sm);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .offres-grille {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .offres-prix p {
      grid-column: 2 / -1;
    }

    /* La liste des abonnements se cale sur la grille de l'île : sa première
       colonne prend la largeur d'une des trois, pour que ses phrases partent
       de la même verticale que les textes au-dessus et au-dessous d'elle. Le
       prix reste à droite, à sa largeur. */
    .offres-suivi :global(.formules) {
      grid-template-columns: calc((100% - 2 * var(--spacing-gouttiere)) / 3) minmax(0, 1fr) auto;
    }
  }
</style>
