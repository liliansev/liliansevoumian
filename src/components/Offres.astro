---
/*
 * Offres.astro — section §04
 *
 * Remplace Methode (4 étapes process) ET Pricing (CTA seul) par une section
 * unique avec 4 cards-services + prix publics HT. Pattern transparence radicale
 * aligné brand voice opinionated/technique/premium.
 *
 * Two-Voice : violet pour les engagements workflow (Vibe Coder régie, Mission
 * one-shot), ember pour les engagements IA-flavored (Mentoring 3 mois, Coaching).
 */
import SectionHeader from './SectionHeader.astro';
import { PRICING, eur } from '../data/pricing';

interface Offre {
  num: string;
  accent: 'violet' | 'ember';
  title: string;
  format: string;
  price: string;
  description: string;
  cta: string;
  href: string;
  /* Tracking DataFast : goal natif + params optionnels (type/source).
     Les 3 offres "mission" partagent le goal `contact_lead` (étape unique
     du funnel) ; le coaching est une micro-conversion distincte. */
  goal: string;
  goalType?: 'call';
  goalSource?: string;
  /** Pré-remplit le message du formulaire de contact (offres mission → #contact). */
  prefill?: string;
}

const offres: Offre[] = [
  {
    num: '01',
    accent: 'violet',
    title: 'Régie automation & apps internes',
    format: 'RÉGIE · 1–2 J/SEM',
    price: `${eur(PRICING.regieDayRate)} €/JOUR`,
    description: "Je rejoins votre équipe pour livrer des automations et des applications web avec Claude Code.",
    cta: 'Lancer la régie',
    href: '#contact',
    goal: 'cta_contact_click',
    goalSource: 'offre_regie',
    prefill: 'Régie automation & apps internes',
  },
  {
    num: '02',
    accent: 'ember',
    title: 'Mentoring 3 mois',
    format: 'FORFAIT · ACCOMPAGNEMENT',
    price: `${eur(PRICING.mentoringMonthly)} €/MOIS`,
    description: "Trois mois pour autonomiser votre équipe sur n8n, Make et Claude. Mentoring direct, formation, et je débloque vos projets internes.",
    cta: 'Discuter du programme',
    href: '#contact',
    goal: 'cta_contact_click',
    goalSource: 'offre_mentoring',
    prefill: 'Mentoring 3 mois',
  },
  {
    num: '03',
    accent: 'violet',
    title: 'Mission perso',
    format: 'ONE-SHOT · CADRÉ',
    price: `À PARTIR DE ${eur(PRICING.missionFloor)} €`,
    description: "Mission ponctuelle selon votre besoin. Diagnostic, plan d'action chiffré, livraison.",
    cta: 'Cadrer la mission',
    href: '#contact',
    goal: 'cta_contact_click',
    goalSource: 'offre_mission',
    prefill: 'Mission perso',
  },
  {
    num: '04',
    accent: 'ember',
    title: 'Coaching ponctuel',
    format: '1H · CIBLÉ',
    price: `${eur(PRICING.coachingHourly)} €/H`,
    description: "Débloquer rapidement une situation. Conseil ultra-ciblé sur une problématique métier.",
    cta: 'Réserver un coaching',
    href: 'https://go.liliansevoumian.fr/coaching',
    goal: 'book_coaching',
  },
];
---

<section
  id="offres"
  data-section
  data-fast-scroll="scroll_to_section_offres"
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">
    <SectionHeader
      number="04"
      label="OFFRES"
      title="Comment on peut travailler ensemble ?"
      titleMaxWidth="26ch"
    />

    {/* Grid 12-col alternance 7+5 / 5+7 — rythme zigzag, cards uniformément
        verticales (pas de prix+desc en row sur les wide). */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3 lg:gap-4">
      {offres.map((o, i) => {
        const wide = i === 0 || i === 3;
        const span = wide ? 'md:col-span-7' : 'md:col-span-5';
        const isExternal = o.href.startsWith('http');
        return (
        <article class={`reveal relative bg-[var(--color-paper)] border border-[var(--color-divider)] rounded-[var(--radius-md)] p-6 md:p-8 flex flex-col gap-5 ${span}`}>
          <span class="grid-corner tl" aria-hidden="true"></span>
          <span class="grid-corner tr" aria-hidden="true"></span>
          <span class="grid-corner bl" aria-hidden="true"></span>
          <span class="grid-corner br" aria-hidden="true"></span>

          {/* Header : num + format chip */}
          <div class="flex items-baseline justify-between gap-3 flex-wrap">
            <span class="mono-caption text-[var(--color-ink-low)]">{o.num} — OFFRE</span>
            <span class={`chip ${o.accent === 'violet' ? 'chip-violet' : 'chip-ember'}`}>
              {o.format}
            </span>
          </div>

          {/* Title */}
          <h3 class="font-display font-semibold text-[length:var(--text-title-lg)] tracking-[-0.025em] text-[var(--color-ink)] m-0 leading-[1.15]">
            {o.title}
          </h3>

          {/* Prix mono large */}
          <div
            class="font-mono font-medium tracking-[0.02em] text-[var(--color-ink)] tabular-nums"
            style="font-size: var(--text-metric);"
          >
            {o.price}
          </div>

          {/* Description */}
          <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body-sm)] leading-[1.55] m-0 flex-1 max-w-[72ch]">
            {o.description}
          </p>

          {/* CTA */}
          <a
            href={o.href}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener noreferrer' : undefined}
            class="btn-primary w-full sm:w-auto sm:self-start justify-center"
            data-fast-goal={o.goal}
            data-fast-goal-type={o.goalType}
            data-fast-goal-source={o.goalSource}
            data-prefill={o.prefill}
          >
            {o.cta}
          </a>
        </article>
        );
      })}
    </div>

    {/* Footer note : prix HT + engagement + délai devis */}
    <div class="reveal mt-8 mono-caption text-[var(--color-ink-low)] flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-1 h-1 rounded-full bg-[var(--color-violet)] inline-block"></span>
        TOUS LES PRIX SONT EN HT
      </span>
      <span aria-hidden="true">·</span>
      <span>PAS D'ENGAGEMENT</span>
      <span aria-hidden="true">·</span>
      <span>DEVIS SOUS 48 H</span>
    </div>

    {/* Pont augmentes.fr — route l'intention « apprendre soi-même » (≠ déléguer
        une mission) vers la plateforme formations. Lien secondaire, jamais primaire. */}
    <p class="reveal mt-4 mono-caption text-[var(--color-ink-low)]">
      VOUS PRÉFÉREZ APPRENDRE À LE FAIRE VOUS-MÊME&nbsp;?
      <a
        href="https://augmentes.fr"
        target="_blank"
        rel="noopener noreferrer"
        data-fast-goal="augmentes_click"
        data-fast-goal-source="offres"
        class="text-[var(--color-ember-deep)] hover:text-[var(--color-ink)] transition-colors ml-1"
      >
        FORMATIONS MAKE &amp; N8N SUR AUGMENTES.FR&nbsp;↗
      </a>
    </p>
  </div>
</section>
