---
/*
 * CaseStudy.astro — section §02 (refonte).
 *
 * Grille de cartes ÉGALES, toutes cliquables (chaque carte = un lien vers le
 * détail du cas), avec un CTA « Voir le cas ». Plus de carte héro surdimensionnée,
 * plus d'animation workflow. Cas clients réels 2026 — aucune métrique inventée.
 *
 * `href` : destination du « Voir le cas ». Par défaut /cas-clients ; à pointer
 * vers une page de détail dédiée (ou un post LinkedIn) par cas quand elles existent.
 */
import SectionHeader from './SectionHeader.astro';
import { Icon } from 'astro-icon/components';

const TOOL_ICONS: Record<string, string> = {
  'n8n':    'simple-icons:n8n',
  'Make':   'simple-icons:make',
  'Notion': 'simple-icons:notion',
};

interface Case {
  client: string;
  sector: string;
  title: string;
  description: string;
  stack: string[];
  ai?: string[];
  href: string;
}

const cases: Case[] = [
  {
    client: 'Fraich Touch',
    sector: 'AGENCE DE STAFFING',
    title: '33 scénarios Make → 3. Zéro facture bloquée.',
    description: 'Refonte d\'un système de facturation refait trois fois : 3 scénarios documentés, tableau de bord Notion en temps réel et alertes d\'erreur. Maintenance allégée de moitié.',
    stack: ['Make', 'Notion'],
    href: '/cas-clients',
  },
  {
    client: 'M Partners',
    sector: 'EXECUTIVE SEARCH',
    title: 'Un agent IA qui qualifie la prospection recrutement.',
    description: 'Pipeline n8n : import Specter → Loxo, enrichissement, puis un agent IA qui repère le bon poste (CEO/Founder de la cible) et trie les contacts en listes « Validés » / « À vérifier ».',
    stack: ['n8n', 'Loxo', 'Specter'],
    ai: ['Agent IA'],
    href: '/cas-clients',
  },
  {
    client: 'Celeris',
    sector: 'DISTRIBUTION IT · ODOO',
    title: 'Mentoring n8n + catalogue HPE synchronisé dans Odoo.',
    description: 'Mentoring 3 mois pour rendre l\'équipe autonome sur n8n. Première mission : fin du copier-coller des produits HPE, récupérés via l\'API et injectés directement dans Odoo.',
    stack: ['n8n', 'Odoo', 'API HPE'],
    href: '/cas-clients',
  },
];
---

<section
  id="cas"
  data-section
  data-fast-scroll="scroll_to_section_cas"
  class="relative bg-[var(--color-surface-low)] py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-b border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="02"
      label="CAS CLIENTS"
      title="Des projets livrés, documentés."
      titleMaxWidth="22ch"
    />

    <!-- Grille de cartes égales, toutes cliquables -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 lg:gap-4 reveal-stagger">
      {cases.map((c) => (
        <a
          href={c.href}
          class="case-card reveal relative card card-interactive flex flex-col gap-5 h-full group no-underline"
        >
          <span class="grid-corner tl" aria-hidden="true"></span>
          <span class="grid-corner tr" aria-hidden="true"></span>
          <span class="grid-corner bl" aria-hidden="true"></span>
          <span class="grid-corner br" aria-hidden="true"></span>

          {/* Header : client + secteur */}
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 pb-4 border-b border-[var(--color-divider)]">
            <span class="font-display font-semibold text-[length:var(--text-title)] tracking-[-0.02em] text-[var(--color-ink)]">{c.client}</span>
            <span class="mono-caption text-[var(--color-ink-low)]">{c.sector}</span>
          </div>

          {/* Titre — le résultat */}
          <h3 class="font-display font-semibold text-[length:var(--text-title)] tracking-[-0.02em] text-[var(--color-ink)] leading-[1.2] m-0 max-w-[26ch]">
            {c.title}
          </h3>

          {/* Description */}
          <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body-sm)] leading-[1.55] m-0">
            {c.description}
          </p>

          {/* Stack — workflow (violet) + IA (ember) */}
          <div class="flex flex-wrap items-center gap-2">
            {c.stack.map((tool) => (
              <span class="chip chip-violet inline-flex items-center gap-1.5">
                {TOOL_ICONS[tool] && <Icon name={TOOL_ICONS[tool]} class="case-tool-logo" aria-hidden="true" />}
                {tool}
              </span>
            ))}
            {c.ai?.map((tool) => (
              <span class="chip chip-ember inline-flex items-center gap-1.5">{tool}</span>
            ))}
          </div>

          {/* CTA — pinned bottom */}
          <span class="mt-auto pt-4 border-t border-[var(--color-divider)] inline-flex items-center gap-1.5 mono-label text-[var(--color-violet-deep)]">
            VOIR LE CAS
            <span class="transition-transform duration-200 ease-out group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>

    <!-- Footer link — signal de récurrence -->
    <div class="reveal mt-8 flex items-center gap-3">
      <span class="mono-caption text-[var(--color-ink-low)]">+ 12 WORKFLOWS EN PROD DEPUIS 2021</span>
      <span class="text-[var(--color-ink-faint)]">·</span>
      <a
        href="https://www.linkedin.com/in/liliansevoumian/"
        target="_blank"
        rel="noopener noreferrer"
        class="mono-caption text-[var(--color-violet-deep)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1.5"
      >
        VOIR LE DÉTAIL SUR LINKEDIN
        <span aria-hidden="true">↗</span>
      </a>
    </div>

  </div>
</section>

<style>
  .case-tool-logo {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }
  /* La carte est un lien : pas de soulignement, couleur de texte héritée. */
  .case-card,
  .case-card:hover {
    text-decoration: none;
  }
</style>
