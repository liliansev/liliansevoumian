---
/*
 * CaseStudy.astro — section §02.
 *
 * Grille de cartes ÉGALES, toutes cliquables (chaque carte = un lien vers le
 * détail du cas), avec un CTA « Voir le cas ». Cartes orientées EXPERTISE
 * MÉTIER + présentation succincte du client — pas de métriques internes ni de
 * liste d'outils (sans valeur pour un prospect, et parfois confidentielles).
 * Les plateformes restent nommées ailleurs (hero, section Stack) où elles
 * signalent la compétence sans exposer le détail des missions.
 *
 * `href` : destination du « Voir le cas ». Par défaut /cas-clients ; à pointer
 * vers une page de détail dédiée par cas quand elles existent.
 */
import SectionHeader from './SectionHeader.astro';

interface Case {
  client: string;
  sector: string;
  title: string;
  description: string;
  href: string;
}

const cases: Case[] = [
  {
    client: 'Fraich Touch',
    sector: 'AGENCE DE GESTION DE TALENTS',
    title: 'Une facturation qui tourne seule, sans erreur.',
    description: 'Agence de gestion de talents (santé, sport, entreprenariat) qui pilote les partenariats marques de ses créateurs. J\'ai repensé et fiabilisé tout leur système de facturation, automatisé de bout en bout, documenté et surveillé, pour que l\'équipe arrête de courir après les paiements et se concentre sur ses talents.',
    href: '/cas-clients',
  },
  {
    client: 'M Partners',
    sector: 'EXECUTIVE SEARCH · TECH & VC',
    title: 'Une prospection qualifiée par l\'IA.',
    description: 'Cabinet de chasse de têtes spécialisé sur l\'écosystème startup et capital-risque. J\'ai industrialisé leur prospection : la collecte et l\'enrichissement des cibles sont automatisés, puis un agent IA qualifie les bons dirigeants à approcher. L\'équipe se concentre sur la relation, plus sur la recherche manuelle.',
    href: '/cas-clients',
  },
  {
    client: 'Celeris',
    sector: 'DISTRIBUTEUR IT B2B',
    title: 'Un catalogue produits qui s\'enrichit tout seul.',
    description: 'Distributeur IT B2B, acteur établi du marché français. J\'accompagne leurs équipes dans leur montée en compétence sur l\'automatisation, et j\'ai conçu un agent IA qui gère leur catalogue produits directement dans leur ERP, pensé pour tourner en interne, avec une exigence forte de souveraineté des données.',
    href: '/cas-clients',
  },
];
---

<section
  id="cas"
  data-section
  data-fast-scroll="scroll_to_section_cas"
  class="relative bg-[var(--color-surface-low)] py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-b border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="02"
      label="CAS CLIENTS"
      title="Des projets en production, documentés."
      titleMaxWidth="22ch"
    />

    <!-- Grille de cartes égales, toutes cliquables -->
    <div role="group" aria-label="Cas clients" class="flex overflow-x-auto snap-x snap-mandatory no-scrollbar gap-3 pb-2 md:grid md:grid-cols-2 lg:grid-cols-3 lg:gap-4 md:overflow-visible md:pb-0 reveal-stagger">
      {cases.map((c) => (
        <a
          href={c.href}
          class="case-card reveal relative card card-interactive flex flex-col gap-5 h-full group no-underline snap-start shrink-0 basis-[80%] sm:basis-[55%] md:basis-auto"
        >
          <span class="grid-corner tl" aria-hidden="true"></span>
          <span class="grid-corner tr" aria-hidden="true"></span>
          <span class="grid-corner bl" aria-hidden="true"></span>
          <span class="grid-corner br" aria-hidden="true"></span>

          {/* Header : client + secteur */}
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 pb-4 border-b border-[var(--color-divider)]">
            <span class="font-display font-medium text-[length:var(--text-title)] tracking-[-0.02em] text-[var(--color-ink)]">{c.client}</span>
            <span class="mono-caption text-[var(--color-ink-low)]">{c.sector}</span>
          </div>

          {/* Titre — l'angle expertise métier */}
          <h3 class="font-display font-semibold text-[length:var(--text-title)] tracking-[-0.02em] text-[var(--color-ink)] leading-[1.2] m-0 max-w-[26ch]">
            {c.title}
          </h3>

          {/* Description — société succincte + valeur métier */}
          <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body-sm)] leading-[1.55] m-0">
            {c.description}
          </p>

          {/* CTA — pinned bottom */}
          <span class="mt-auto pt-4 border-t border-[var(--color-divider)] inline-flex items-center gap-1.5 mono-label text-[var(--color-violet-deep)]">
            VOIR LE CAS
            <span class="transition-transform duration-200 ease-out group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>

    <!-- Footer link — signal de récurrence -->
    <div class="reveal mt-8 flex items-center gap-3">
      <span class="mono-caption text-[var(--color-ink-low)]">+ DES WORKFLOWS EN PRODUCTION DEPUIS 2021</span>
      <span class="text-[var(--color-ink-faint)]">·</span>
      <a
        href="https://www.linkedin.com/in/liliansevoumian/"
        target="_blank"
        rel="noopener noreferrer"
        class="mono-caption text-[var(--color-violet-deep)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1.5"
      >
        VOIR LE DÉTAIL SUR LINKEDIN
        <span aria-hidden="true">↗</span>
      </a>
    </div>

  </div>
</section>

<style>
  /* La carte est un lien : pas de soulignement, couleur de texte héritée. */
  .case-card,
  .case-card:hover {
    text-decoration: none;
  }
</style>
