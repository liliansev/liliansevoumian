---
/* Cas clients : un carrousel de trois missions, chacune avec son contexte, ce
   qu'elle a changé et un schéma en trois étapes. Sans écran simulé. */
import SectionHeader from './SectionHeader.astro';
import LinkCTA from './LinkCTA.astro';
import CaseIllustration from './CaseIllustration.astro';
import { Icon } from 'astro-icon/components';

const fraichTouch = {
  client: 'Fraich Touch',
  logo: '/logos/fraichtouch.svg',
  logoScale: 2.2,
  sector: 'Agence de gestion de talents',
  title: 'Comment Fraich Touch a automatisé sa facturation HubSpot et Pennylane',
  description:
    "Agence de gestion de talents (santé, sport, entrepreneuriat) qui pilote les partenariats marques de ses créateurs. J’ai reconstruit leur facturation dans <strong>Make</strong> : un deal signé dans <strong>HubSpot</strong> devient un devis puis jusqu’à douze factures <strong>Pennylane</strong>, suivies dans <strong>Notion</strong>. Les relances partent toutes seules, l’équipe se concentre sur ses talents.",
  /* Ce que le client a GAGNÉ — du temps, de l'effort en moins — et jamais ce
     que le système fait techniquement : « 0,00 € d'écart sur le cas test » ne
     dit rien à un dirigeant. Tout vient du .md correspondant, sans exception ;
     quand la fiche ne contient aucune durée (Humble+), le gain reste
     qualitatif plutôt qu'inventé. Les secteurs sont écrits comme dans le
     frontmatter des fiches. */
  results: ['~4\u00a0h par semaine récupérées', 'Un nouveau collaborateur formé en 30\u00a0min'],
  href: '/cas-clients/facturation-automatisee-fraich-touch',
};
const mPartners = {
  client: 'M Partners',
  sector: 'Executive Search · Tech & VC',
  title: 'Comment M Partners scrape et qualifie ses prospects avec un agent IA',
  description:
    "Cabinet de chasse de têtes spécialisé sur l’écosystème startup et capital-risque. J’ai industrialisé leur prospection dans <strong>Make</strong> : le <strong>scraping</strong> des pages d’équipe est automatisé, un <strong>agent IA</strong> qualifie les bons dirigeants, puis <strong>Loxo</strong> centralise le CRM et les séquences de prospection. L’équipe garde son temps pour la relation.",
  results: ['~10\u00a0min par run au lieu de 1 à 3\u00a0h', '6× plus d’entreprises traitables par semaine'],
  href: '/cas-clients/m-partners',
};
const humblePlus = {
  client: 'Humble+',
  sector: 'Nutrition fonctionnelle · E-commerce B2B',
  title: 'Comment Humble+ a automatisé ses commandes Shopify et ses factures B2B',
  description:
    "Marque française de compléments alimentaires distribuée en direct et via un réseau <strong>e-commerce B2B</strong>. J’ai porté leur scénario <strong>Make</strong> dans un workflow <strong>n8n</strong> qui lit les bons de commande PDF ou Excel, sécurise les montants, crée la commande <strong>Shopify</strong> puis la facture <strong>Pennylane</strong>, avec validation <strong>Slack</strong> pendant la phase de stabilisation.",
  results: ['De la commande à la facture, sans ressaisie', 'Les commandes s’enchaînent sans attendre'],
  href: '/cas-clients/humble-plus',
};
---

{/* Sans filet en pied : la section qui suit sur la page est une île claire,
    qui sépare d'elle-même. */}
<section
  id="cas"
  data-section
  data-case-carousel
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    {/* Le titre et les flèches partagent une ligne : le carrousel suit son
        titre de près, sans rangée vide entre les deux. */}
    <div class="case-tete">
      <SectionHeader
        title="Ce que ça change chez mes clients."
        titleMaxWidth="24ch"
        spacing="none"
      />

      <div class="case-carousel-toolbar reveal">
        <p class="sr-only" aria-live="polite" data-case-announcement>Projet 1 sur 3 : Humble+</p>
        <div class="case-carousel-arrows" aria-label="Navigation des cas clients">
          <button
            type="button"
            class="case-carousel-arrow"
            aria-label="Projet précédent"
            aria-controls="case-carousel-track"
            data-case-prev
            disabled
          >
            <Icon name="lucide:arrow-left" aria-hidden="true" />
          </button>
          <button
            type="button"
            class="case-carousel-arrow"
            aria-label="Projet suivant"
            aria-controls="case-carousel-track"
            data-case-next
          >
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </button>
        </div>
      </div>
    </div>

    <div
      id="case-carousel-track"
      class="case-carousel-track no-scrollbar reveal"
      role="region"
      aria-roledescription="carrousel"
      aria-label="Cas clients récents"
      tabindex="0"
      data-case-track
    >
      <article
        class="case-slide"
        role="group"
        aria-roledescription="diapositive"
        aria-label="1 sur 3 : Humble+"
        data-case-slide
        data-case-active
        data-case-name="Humble+"
      >
        <div class="case-slide-grid">
          <div class="case-copy">
            <div class="case-meta">
              <span class="case-client">{humblePlus.client}</span>
              <span class="case-secteur">{humblePlus.sector}</span>
              <time class="case-date" datetime="2026-07-23">Juillet 2026</time>
            </div>
            <h3>{humblePlus.title}</h3>
            <p class="case-description" set:html={humblePlus.description} />
            <p class="case-results">
              {humblePlus.results.map((result, i) => (
                <>{i > 0 && ' '}<span>{result}</span></>
              ))}
            </p>
            <a href={humblePlus.href} class="case-cta group">
              <span class="case-cta-dot" aria-hidden="true"><Icon name="lucide:arrow-right" class="case-cta-arrow" /></span>
              <span class="case-cta-text">Voir le cas</span>
            </a>
          </div>

          <div class="case-visual">
            <CaseIllustration steps={[
              { icon: 'simple-icons:n8n', tool: 'n8n', action: 'Lire et contrôler le bon de commande' },
              { icon: 'simple-icons:shopify', tool: 'Shopify', action: 'Créer la commande' },
              { icon: 'lucide:receipt-text', tool: 'Pennylane', action: 'Préparer la facture' },
            ]} />
          </div>
        </div>
      </article>

      <article
        class="case-slide"
        role="group"
        aria-roledescription="diapositive"
        aria-label="2 sur 3 : M Partners"
        data-case-slide
        data-case-name="M Partners"
      >
        <div class="case-slide-grid">
          <div class="case-copy">
            <div class="case-meta">
              <span class="case-client">{mPartners.client}</span>
              <span class="case-secteur">{mPartners.sector}</span>
              <time class="case-date" datetime="2026-05-05">Mai 2026</time>
            </div>
            <h3>{mPartners.title}</h3>
            <p class="case-description" set:html={mPartners.description} />
            <p class="case-results">
              {mPartners.results.map((result, i) => (
                <>{i > 0 && ' '}<span>{result}</span></>
              ))}
            </p>
            <a href={mPartners.href} class="case-cta group">
              <span class="case-cta-dot" aria-hidden="true"><Icon name="lucide:arrow-right" class="case-cta-arrow" /></span>
              <span class="case-cta-text">Voir le cas</span>
            </a>
          </div>

          <div class="case-visual">
            <CaseIllustration steps={[
              { icon: 'lucide:globe', tool: 'Sites web', action: 'Repérer les décideurs' },
              { icon: 'simple-icons:make', tool: 'Make + IA', action: 'Qualifier les profils' },
              { icon: 'lucide:contact-round', tool: 'Loxo', action: 'CRM et prospection' },
            ]} />
          </div>
        </div>
      </article>

      <article
        class="case-slide"
        role="group"
        aria-roledescription="diapositive"
        aria-label="3 sur 3 : Fraich Touch"
        data-case-slide
        data-case-name="Fraich Touch"
      >
        <div class="case-slide-grid">
          <div class="case-copy">
            <div class="case-meta">
              <img class="case-logo" src={fraichTouch.logo} alt={fraichTouch.client} width="810" height="810" style={`--logo-scale:${fraichTouch.logoScale ?? 1}`} loading="lazy" decoding="async" />
              <span class="case-secteur">{fraichTouch.sector}</span>
              <time class="case-date" datetime="2026-01-30">Janvier 2026</time>
            </div>
            <h3>{fraichTouch.title}</h3>
            <p class="case-description" set:html={fraichTouch.description} />
            <p class="case-results">
              {fraichTouch.results.map((result, i) => (
                <>{i > 0 && ' '}<span>{result}</span></>
              ))}
            </p>
            <a href={fraichTouch.href} class="case-cta group">
              <span class="case-cta-dot" aria-hidden="true"><Icon name="lucide:arrow-right" class="case-cta-arrow" /></span>
              <span class="case-cta-text">Voir le cas</span>
            </a>
          </div>

          <div class="case-visual">
            <CaseIllustration steps={[
              { icon: 'simple-icons:hubspot', tool: 'HubSpot', action: 'Détecter le deal signé' },
              { icon: 'simple-icons:make', tool: 'Make', action: 'Calculer les échéances' },
              { icon: 'lucide:receipt-text', tool: 'Pennylane', action: 'Créer la facture' },
            ]} />
          </div>
        </div>
      </article>
    </div>

    <div class="case-carousel-pagination reveal" aria-label="Accès direct aux cas clients">
      {/* Sans numéro : les trois boutons sont visibles ensemble, avec le nom
          du client et le trait d'état.

          Le secteur est écrit sous le nom du client, et c'est ce qui fait de
          cette rangée autre chose qu'une commande de carrousel. La question du
          lecteur à cet endroit est « est-ce que l'un de ces trois me
          ressemble ? », et un nom de client ne lui apprend rien ; son secteur,
          si. Le carrousel n'en montre qu'un à la fois, donc c'est cette rangée
          qui rend les trois lisibles d'un coup d'œil, sans deux clics. Les
          libellés viennent des trois objets du frontmatter. */}
      {[humblePlus, mPartners, fraichTouch].map((cas, index) => (
        <button
          type="button"
          class="case-carousel-dot"
          aria-label={`Afficher le cas ${cas.client}, ${cas.sector}`}
          aria-current={index === 0 ? 'true' : undefined}
          data-case-dot
          data-case-index={index}
        >
          <span class="case-carousel-dot-label">{cas.client}</span>
          <span class="case-carousel-dot-secteur">{cas.sector}</span>
        </button>
      ))}
    </div>

    <div class="case-carousel-footer reveal">
      <LinkCTA href="/cas-clients">Voir tous les cas</LinkCTA>
    </div>

  </div>
</section>

<style>
  /* Le titre à gauche, les flèches à droite, calées sur sa dernière ligne.
     Faute de place, les flèches passent dessous et restent à droite. */
  .case-tete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-lie);
    margin-bottom: var(--spacing-groupe);
  }

  .case-carousel-toolbar {
    margin-left: auto;
  }

  .case-carousel-arrows {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  [data-case-carousel]:not([data-case-ready]) .case-carousel-arrows,
  [data-case-carousel]:not([data-case-ready]) .case-carousel-pagination {
    visibility: hidden;
  }

  .case-carousel-arrow {
    display: inline-grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    color: var(--color-ink);
    background: var(--color-surface-high);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    cursor: pointer;
  }

  .case-carousel-arrow:hover:not(:disabled),
  .case-carousel-arrow:focus-visible:not(:disabled) {
    color: var(--color-night);
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .case-carousel-arrow:active:not(:disabled) {
    transform: translateY(0) scale(0.96);
  }

  .case-carousel-arrow:disabled {
    color: var(--color-ink-faint);
    background: transparent;
    border-color: var(--color-divider);
    cursor: not-allowed;
    opacity: 0.7;
  }

  .case-carousel-arrow :global(svg) {
    width: 18px;
    height: 18px;
  }

  .case-carousel-track {
    /* La gouttière est nommée parce que deux autres déclarations en dépendent :
       la largeur de la diapositive et la marge de fin qui rend la dernière
       position de calage atteignable. Trois valeurs qui doivent rester égales,
       et rien ne signalait une dérive entre elles. */
    --case-gap: clamp(1rem, 2vw, 1.5rem);
    /* Le carrousel emprunte --duration-reveal (380 ms), la durée la plus répandue
       du système, plutôt que la courbe interne de Chrome. Le défilement natif en
       `smooth` mettait 564 ms mesurées à 1440 px et 286 ms à 402 px : la même
       commande répondait deux fois moins vite selon la largeur de la fenêtre, sur
       une durée qu'aucun jeton ne pilotait. Le JS lit cette valeur et
       --ease-out-quint, et anime lui-même scrollLeft. */
    --case-scroll-duration: var(--duration-reveal);
    display: flex;
    align-items: stretch;
    gap: var(--case-gap);
    width: 100%;
    padding: 2px;
    margin: -2px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 2px;
  }

  /* Le calage natif est suspendu pendant le défilement piloté : avec
     `mandatory`, chaque écriture de scrollLeft en rAF est susceptible d'être
     rattrapée par le moteur de calage, qui ramène alors la piste au point le
     plus proche au milieu du geste. L'attribut est retiré à l'arrivée, sur un
     point de calage exact — la remise en service ne produit donc aucun saut. */
  .case-carousel-track[data-case-scripted] {
    scroll-snap-type: none;
  }

  /* La diapositive ne prend pas toute la largeur de la piste : il lui manque de
     quoi laisser dépasser le bord de la suivante, sans quoi rien n'annonce
     qu'il y a trois cas et pas un.
     Ce qui dépasse est calé sur le rembourrage de la carte, moins 2 px : la
     coupe tombe juste avant la colonne de texte de la carte suivante, à toutes
     les largeurs. On voit un bord de carte (son filet et sa surface), jamais
     une colonne de lettres tranchées. */
  .case-slide {
    --case-padding: clamp(1.25rem, 3vw, 2.25rem);
    --case-peek: calc(var(--case-padding) - 2px);
    flex: 0 0 auto;
    width: calc(100% - var(--case-gap) - var(--case-peek));
    min-width: 0;
    padding: var(--case-padding);
    background:
      linear-gradient(var(--color-grid-line), var(--color-grid-line)) 0 0 / 100% 1px no-repeat,
      var(--color-surface-low);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* La dernière diapositive était la seule dont le cadrage différait des trois
     autres, et ce n'était pas un choix : `scroll-snap-align: start` sur une
     largeur amputée du filet rend la dernière position de calage inatteignable
     d'exactement la valeur du filet. Mesuré : 46 px manquaient à 402 px de
     fenêtre, 59 px à 1440. La carte s'arrêtait donc décalée vers la droite, avec
     un morceau de la PRÉCÉDENTE visible à gauche — le geste inverse de celui que
     les trois autres font.
     La marge de fin rend cette course. Elle vaut la gouttière plus le filet, et
     l'égalité n'est pas approchée : la course maximale devient 3 × (largeur utile
     − filet), c'est-à-dire au pixel près l'abscisse qui aligne la quatrième carte
     à gauche. Ce qui dépasse alors à droite est du vide, et c'est exact — il n'y
     a pas de cinquième cas. */
  .case-slide:last-child {
    margin-inline-end: calc(var(--case-gap) + var(--case-peek));
  }

  .case-slide-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .case-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    min-width: 0;
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    width: 100%;
  }

  .case-client {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* Le secteur et la date : deux libellés du même rang, en bas de casse. */
  .case-secteur,
  .case-date {
    color: var(--color-ink-low);
    font-size: var(--text-mono-label);
    font-weight: 500;
    line-height: 1.4;
  }

  .case-date {
    margin-left: auto;
    white-space: nowrap;
  }

  .case-copy h3 {
    max-width: 20ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .case-description {
    max-width: 48ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* Les mots-clés du résumé — outils, briques métier — sont posés à l'encre et
     en 600, comme le `strong` de la prose des fiches. Le résumé est le seul
     endroit de la home où l'on nomme les outils d'une mission ; en ink-mid et
     au même poids que le reste, ils se lisaient comme du texte de liaison.
     `:global` est requis : la description arrive par `set:html`, donc hors du
     périmètre du style scopé. */
  .case-description :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* Les résultats se lisent à la suite, à l'encre, séparés par un point : la
     pastille pêche qui portait chacun d'eux est réservée au bouton d'appel
     (8 octobre 2026). L'espace écrite entre deux résultats est pour qui lit le
     HTML sans la mise en page : ils se collaient (« 1 à 3 h6× plus… »). */
  .case-results > span {
    color: var(--color-ink);
  }

  .case-results > span + span::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--color-ink-low);
  }

  .case-results {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin: 0;
    max-width: 100%;
    font-size: var(--text-mono-label);
    font-weight: 500;
    line-height: 1.4;
  }

  .case-visual {
    min-width: 0;
  }

  .case-carousel-pagination {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.5rem, 2vw, 1.25rem);
    margin-top: 1.25rem;
  }

  .case-carousel-dot {
    position: relative;
    /* Colonne et non rangée depuis que le secteur est passé sous le nom : en
       `align-items: center`, les deux lignes se centraient l'une sur l'autre et
       les noms de clients cessaient de s'aligner entre eux. */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    min-height: 44px;
    padding: 0.75rem 0 0;
    color: var(--color-ink-low);
    background: transparent;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: var(--text-mono-label);
    text-align: left;
  }

  /* La hiérarchie des deux rangs passe par la taille et la graisse, pas par
     une couleur plus pâle : deux des trois boutons sont inactifs à tout
     instant, et le secteur est du petit texte, il lui faut 4,5:1. Il hérite
     donc de la couleur du bouton (ink-low) et c'est le nom du client qui se
     détache. Quand le cas devient actif, le bouton passe à l'encre et le
     secteur reste en ink-low : la hiérarchie se rejoue alors en couleur, sans
     qu'aucun des deux rangs ne descende sous le seuil.
     `text-wrap: balance` parce que ces secteurs tiennent sur deux lignes dans
     une colonne de quart de page, et qu'un mot orphelin en seconde ligne
     désaligne toute la rangée. */
  .case-carousel-dot-label {
    font-size: var(--text-body-sm);
    font-weight: 600;
  }

  .case-carousel-dot-secteur {
    line-height: 1.3;
    text-wrap: balance;
  }

  .case-carousel-dot[aria-current='true'] .case-carousel-dot-secteur {
    color: var(--color-ink-low);
  }

  /* Une colonne sous 40rem, et non trois. Le secteur ajoute une seconde ligne
     à chaque bouton : à 375 px de fenêtre, une colonne d'un tiers de page fait
     une centaine de pixels, où le plus long secteur tomberait sur trois ou
     quatre lignes. L'un sous l'autre, les trois cas restent visibles ensemble,
     ce qui est toute la raison d'être de cette rangée. */
  @media (max-width: 40rem) {
    .case-carousel-pagination {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem 1rem;
    }
  }

  /* ink-faint et non divider : ce trait est le seul indicateur d'état des cas
     non sélectionnés, il lui faut le seuil des indicateurs non textuels
     (3:1), sinon la pagination n'annonce pas qu'il reste trois cas à voir. */
  .case-carousel-dot::before {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    content: '';
    background: var(--color-ink-faint);
    transition: background-color 300ms var(--ease-out-quint);
  }

  .case-carousel-dot:hover,
  .case-carousel-dot:focus-visible,
  .case-carousel-dot:active,
  .case-carousel-dot[aria-current='true'] {
    color: var(--color-ink);
  }

  /* Le filet passe à l'encre dès l'appui, avant même que la carte ne soit
     arrivée. L'état `aria-current`, lui, attend l'arrivée réelle : sans ce
     retour à l'appui, presser un onglet ne produirait plus rien pendant les
     380 ms du déplacement. */
  .case-carousel-dot:active::before,
  .case-carousel-dot[aria-current='true']::before {
    background: var(--color-ink);
  }

  /* Le nom du client reste affiché à toutes les largeurs : sur téléphone
     l'écran ne montre qu'un cas, c'est là que les noms comptent le plus. S'il
     manque de place il est tronqué : un nom coupé nomme encore. */
  .case-carousel-dot-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .case-carousel-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: clamp(1.25rem, 2vw, 1.75rem);
  }

  /* « Voir le cas » : une flèche dans un cercle, qui se remplit de pêche au
     survol, puis le libellé en bas de casse comme tout ce qui se clique. */
  .case-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
  }
  .case-cta-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    color: var(--color-ink);
    transition: background-color var(--duration-default) var(--ease-out-quint),
                border-color var(--duration-default) var(--ease-out-quint),
                color var(--duration-default) var(--ease-out-quint);
  }
  /* La flèche passe à la nuit : sur la pêche, du blanc tient 1,74:1 et le
     glyphe disparaîtrait pendant tout le survol. Ce qui se pose sur l'accent
     est toujours la nuit, 10,19:1. */
  .case-cta:hover .case-cta-dot,
  .case-cta:focus-visible .case-cta-dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-night);
  }
  .case-cta-dot :global(.case-cta-arrow) {
    width: 1rem;
    height: 1rem;
    transition: transform var(--duration-default) var(--ease-out-quint);
  }
  .case-cta:hover :global(.case-cta-arrow),
  .case-cta:focus-visible :global(.case-cta-arrow) {
    transform: translateX(3px);
  }
  .case-cta-text {
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-ink-mid);
    transition: color var(--duration-default) var(--ease-out-quint);
  }
  .case-cta:hover .case-cta-text,
  .case-cta:focus-visible .case-cta-text {
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .case-cta-dot, .case-cta-dot :global(.case-cta-arrow), .case-cta-text { transition: none; }
    .case-cta:hover :global(.case-cta-arrow),
    .case-cta:focus-visible :global(.case-cta-arrow) { transform: none; }
  }

  /* Logo client : silhouette monochrome, blanche (`brightness(0)` la met en
     noir, `invert(1)` retourne ce noir en blanc). À revoir si la section passe
     un jour dans un panneau clair. */
  .case-logo {
    height: calc(26px * var(--logo-scale, 1));
    width: auto;
    max-width: 180px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }
  @media (max-width: 899px) {
    .case-slide-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .case-copy h3 {
      max-width: 24ch;
    }
  }

  @media (max-width: 899px) {
    .case-copy,
    .case-description {
      max-width: none;
    }
  }

  @media (max-width: 639px) {
    /* Le rembourrage seul : la largeur et la marge de fin suivent, puisqu'elles
       le lisent. Écrire `padding` en dur ici aurait laissé le filet calé sur la
       valeur du bureau, ce qui est exactement la dérive d'origine. */
    .case-slide {
      --case-padding: 1.125rem;
    }

    .case-slide-grid {
      gap: 1.75rem;
    }

    .case-meta {
      align-items: flex-start;
    }

    .case-date {
      flex: 0 0 100%;
      margin-left: 0;
    }

    .case-logo {
      max-width: 144px;
    }
  }

  /* La piste n'a plus de `scroll-behavior: smooth` à neutraliser ici : le
     déplacement est piloté en JS, qui saute directement à l'arrivée quand le
     système demande moins d'animation. La déclaration CSS aurait été un second
     endroit à tenir à jour pour la même règle. */
  @media (prefers-reduced-motion: reduce) {
    .case-carousel-arrow,
    .case-carousel-dot::before {
      transition: none;
    }

    /* Couper la transition ne suffisait pas : le déplacement d'un pixel et
       l'échelle à l'appui jouaient encore, simplement sans durée. */
    .case-carousel-arrow:hover:not(:disabled),
    .case-carousel-arrow:focus-visible:not(:disabled),
    .case-carousel-arrow:active:not(:disabled) {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-case-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-case-track]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-case-slide]'));
    const previous = carousel.querySelector<HTMLButtonElement>('[data-case-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-case-next]');
    const announcement = carousel.querySelector<HTMLElement>('[data-case-announcement]');
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-case-dot]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!track || !previous || !next || slides.length === 0) return;

    /* Deux index, et la distinction est tout le sujet du correctif.
       `activeIndex` est ce qui est RÉELLEMENT à l'écran ; `targetIndex` est ce
       vers quoi on se déplace. Avant, un seul index basculait tout au clic :
       mesurée, la pagination changeait d'onglet 12 ms après l'appui pendant que
       la carte mettait 564 ms à arriver — pendant une demi-seconde le carrousel
       annonçait un cas qu'on ne voyait pas encore, y compris au lecteur d'écran.
       Ce qui répond à l'appui (les flèches, qui doivent pouvoir s'enchaîner) lit
       la cible ; ce qui décrit l'écran (onglet courant, `inert`, `aria-hidden`,
       annonce vocale) attend l'arrivée. */
    let activeIndex = 0;
    let targetIndex = 0;
    let scrollEndTimer = 0;
    let scrollRaf: number | null = null;
    let scripted = false;

    const trackStyles = getComputedStyle(track);
    const bounded = (index: number) => Math.max(0, Math.min(index, slides.length - 1));

    /* Durée et courbe viennent des jetons — DESIGN.md interdit d'écrire l'une ou
       l'autre sur place, et le défilement natif n'obéissait à aucune des deux.
       Les valeurs de repli ne servent qu'au cas où la feuille de style n'aurait
       pas encore été appliquée : elles reprennent --duration-reveal et
       --ease-out-quint à l'identique. */
    const scrollDuration = parseFloat(trackStyles.getPropertyValue('--case-scroll-duration')) || 380;
    const scrollPadding = parseFloat(trackStyles.scrollPaddingInlineStart) || 0;

    /* Résout la courbe de Bézier du jeton pour une abscisse donnée. La bissection
       sur 24 pas descend sous 10⁻⁷, soit très en dessous du pixel sur la course
       d'une diapositive ; une approximation recopiée aurait été une seconde
       définition de --ease-out-quint, exactement ce que la DA a déjà eu à
       corriger deux fois. */
    const easingFromToken = (declaration: string) => {
      const numbers = declaration.match(/-?\d*\.?\d+/g)?.map(Number);
      if (!numbers || numbers.length < 4) return (progress: number) => progress;
      const [x1, y1, x2, y2] = numbers;
      const axis = (a: number, b: number, t: number) =>
        3 * (1 - t) * (1 - t) * t * a + 3 * (1 - t) * t * t * b + t * t * t;
      return (progress: number) => {
        let low = 0;
        let high = 1;
        let t = progress;
        for (let step = 0; step < 24; step += 1) {
          t = (low + high) / 2;
          if (axis(x1, x2, t) < progress) low = t;
          else high = t;
        }
        return axis(y1, y2, t);
      };
    };
    const ease = easingFromToken(trackStyles.getPropertyValue('--ease-out-quint'));

    /* L'abscisse de calage de la diapositive, dans le même repère que
       `scrollLeft`. Le retrait de `scroll-padding-inline` n'est pas cosmétique :
       sans lui le JS visait 2 px à droite du point de calage natif, et le moteur
       de calage rattrapait ces 2 px après coup, en un second déplacement. */
    const slideOffset = (slide: HTMLElement) => {
      const trackBox = track.getBoundingClientRect();
      const slideBox = slide.getBoundingClientRect();
      return slideBox.left - trackBox.left + track.scrollLeft - scrollPadding;
    };

    // Ce que la commande doit rendre TOUT DE SUITE : de quoi enchaîner les appuis
    // sans dépasser les bornes, la carte n'étant pas encore arrivée.
    const syncArrows = () => {
      previous.disabled = targetIndex === 0;
      next.disabled = targetIndex === slides.length - 1;
    };

    // Ce qui décrit l'écran, et n'est donc écrit qu'une fois la carte arrivée.
    const settle = (index: number) => {
      activeIndex = bounded(index);
      targetIndex = activeIndex;
      syncArrows();
      if (announcement) {
        announcement.textContent = `Projet ${activeIndex + 1} sur ${slides.length} : ${slides[activeIndex].dataset.caseName ?? ''}`;
      }

      slides.forEach((slide, slideIndex) => {
        if (slideIndex === activeIndex) {
          slide.setAttribute('data-case-active', '');
          slide.removeAttribute('aria-hidden');
          slide.removeAttribute('inert');
        } else {
          slide.removeAttribute('data-case-active');
          slide.setAttribute('aria-hidden', 'true');
          slide.setAttribute('inert', '');
        }
      });

      dots.forEach((dot, dotIndex) => {
        if (dotIndex === activeIndex) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const findClosestSlide = () => {
      const position = track.scrollLeft;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      slides.forEach((slide, index) => {
        const distance = Math.abs(slideOffset(slide) - position);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const stopScripted = () => {
      if (scrollRaf !== null) {
        cancelAnimationFrame(scrollRaf);
        scrollRaf = null;
      }
      if (scripted) {
        scripted = false;
        track.removeAttribute('data-case-scripted');
      }
    };

    const scrollTo = (left: number, onArrival: () => void) => {
      stopScripted();
      const limit = track.scrollWidth - track.clientWidth;
      const destination = Math.max(0, Math.min(left, limit));
      const origin = track.scrollLeft;
      const distance = destination - origin;

      // Moins d'un pixel à parcourir, ou une préférence système pour moins de
      // mouvement : on arrive tout de suite.
      if (reducedMotion.matches || Math.abs(distance) < 1) {
        track.scrollLeft = destination;
        onArrival();
        return;
      }

      scripted = true;
      track.setAttribute('data-case-scripted', '');
      const startedAt = performance.now();

      const frame = (now: number) => {
        const progress = Math.min((now - startedAt) / scrollDuration, 1);
        track.scrollLeft = origin + distance * ease(progress);
        if (progress < 1) {
          scrollRaf = requestAnimationFrame(frame);
          return;
        }
        scrollRaf = null;
        scripted = false;
        track.removeAttribute('data-case-scripted');
        track.scrollLeft = destination;
        onArrival();
      };

      scrollRaf = requestAnimationFrame(frame);
    };

    const goTo = (index: number) => {
      const wanted = bounded(index);
      targetIndex = wanted;
      syncArrows();
      scrollTo(slideOffset(slides[wanted]), () => settle(wanted));
    };

    previous.addEventListener('click', () => goTo(targetIndex - 1));
    next.addEventListener('click', () => goTo(targetIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.caseIndex);
        if (Number.isInteger(index)) goTo(index);
      });
    });

    // Le doigt et la molette l'emportent sur un déplacement en cours : une piste
    // qui continue sa course sous la main est le défaut que le défilement natif
    // avait déjà, et qu'il n'y avait aucune raison de reconduire.
    (['pointerdown', 'wheel', 'touchstart'] as const).forEach((type) => {
      track.addEventListener(type, stopScripted, { passive: true });
    });

    track.addEventListener('scroll', () => {
      // Pendant un déplacement piloté, l'arrivée est déjà datée : la relecture de
      // la diapositive la plus proche ne servirait qu'à écrire deux fois le même
      // état, et à le faire une image trop tôt.
      if (scripted) return;
      window.clearTimeout(scrollEndTimer);
      scrollEndTimer = window.setTimeout(() => settle(findClosestSlide()), 80);
    }, { passive: true });

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(targetIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(targetIndex + 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(slides.length - 1);
      }
    });

    settle(0);
    carousel.setAttribute('data-case-ready', '');
  });
</script>
