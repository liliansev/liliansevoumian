---
/*
 * CaseStudy.astro — les quatre cas clients, en carrousel.
 *
 * Pas de numéro de section dans cet en-tête : il portait « §02 » quand l'ordre
 * de la home en faisait la deuxième, et elle y est troisième depuis que le
 * calculateur est remonté avant elle. L'ordre vit dans index.astro, à un seul
 * endroit ; le répéter ici crée une deuxième vérité qui se périme sans que rien
 * ne le signale.
 *
 * Carrousel chronologique (projet le plus récent en premier), avec un mockup
 * sur-mesure par mission pour rendre concret CE QUE FAIT l'automatisation :
 *   · Fraich Touch  → panneau facturation (factures payées / relance auto)
 *   · M Partners    → canvas de workflow (sourcing → agent IA → CRM)
 *   · Celeris       → catalogue ERP enrichi par agent IA, en interne
 *   · Humble+       → order-to-cash B2B (PDF/XLS → Shopify → Pennylane)
 * Tout en monochrome (tokens projet) ; seul --color-success (fonctionnel) pointe
 * les statuts positifs. Copy et angle métier inchangés.
 */
import SectionHeader from './SectionHeader.astro';
import MockupWindow from './mockups/MockupWindow.astro';
import MockupList from './mockups/MockupList.astro';
import WorkflowCanvas from './mockups/WorkflowCanvas.astro';
import { brandColorFor } from '../data/brands';
import { Icon } from 'astro-icon/components';

const fraichTouch = {
  client: 'Fraich Touch',
  logo: '/logos/fraichtouch.svg',
  logoScale: 2.2,
  sector: 'AGENCE DE GESTION DE TALENTS',
  title: 'Facturation complexe 100% automatisée depuis HubSpot',
  description:
    "Agence de gestion de talents (santé, sport, entrepreneuriat) qui pilote les partenariats marques de ses créateurs. J'ai repensé leur système de facturation : automatisé de bout en bout, documenté et surveillé. Les relances partent toutes seules, l'équipe se concentre sur ses talents.",
  /* Ce que le client a GAGNÉ — du temps, de l'effort en moins — et jamais ce
     que le système fait techniquement : « 0,00 € d'écart sur le cas test » ne
     dit rien à un dirigeant. Tout vient du .md correspondant, sans exception ;
     quand la fiche ne contient aucune durée (Celeris, Humble+), le gain reste
     qualitatif plutôt qu'inventé. Mêmes valeurs que le frontmatter, qui
     alimente aussi les cartes « cas voisins ». */
  results: ['~4 H PAR SEMAINE RÉCUPÉRÉES', 'UN NOUVEAU COLLABORATEUR FORMÉ EN 30 MIN'],
  href: '/cas-clients/facturation-automatisee-fraich-touch',
};
const mPartners = {
  client: 'M Partners',
  sector: 'EXECUTIVE SEARCH · TECH & VC',
  title: "Scraping, sourcing et qualification alimentée par l'IA",
  description:
    "Cabinet de chasse de têtes spécialisé sur l'écosystème startup et capital-risque. J'ai industrialisé leur prospection : la collecte et l'enrichissement des cibles sont automatisés, puis un agent IA qualifie les bons dirigeants à approcher. L'équipe garde son temps pour la relation.",
  results: ['~10 MIN PAR RUN AU LIEU DE 1 À 3 H', '6× PLUS D’ENTREPRISES TRAITABLES PAR SEMAINE'],
  href: '/cas-clients/m-partners',
};
const celeris = {
  client: 'Celeris',
  logo: '/logos/celeris.webp',
  sector: 'DISTRIBUTEUR IT B2B',
  title: "Un catalogue produits qui s'enrichit tout seul.",
  description:
    "Distributeur IT B2B, acteur établi du marché français. J'accompagne leurs équipes dans leur montée en compétence sur l'automatisation, et j'ai conçu un agent IA qui gère leur catalogue produits directement dans leur ERP. Il est pensé pour tourner en interne, avec une exigence forte de souveraineté des données.",
  /* « EN TEST » vient de la fiche source (celeris.md:13, « 319 sur ~515, en
     test ») : le chiffre circulait sans sa réserve, ce qui le faisait passer
     pour un résultat de production. */
  results: ['L’AGENT RÉDIGE LES FICHES, LE COMMERCIAL VALIDE', '6 PRODUITS SUR 10 APPARIÉS AUTOMATIQUEMENT, EN TEST'],
  href: '/cas-clients/celeris',
};
const humblePlus = {
  client: 'Humble+',
  sector: 'NUTRITION FONCTIONNELLE · E-COMMERCE B2B',
  title: 'Des bons de commande B2B aux factures, sans ressaisie',
  description:
    "Marque française de compléments alimentaires distribuée en direct et via un réseau B2B. J'ai porté leur scénario Make dans un workflow n8n qui lit les bons de commande PDF ou Excel, sécurise les montants, crée la commande Shopify puis la facture Pennylane, avec validation Slack pendant la phase de stabilisation.",
  results: ['COMMANDE → FACTURE SANS RESSAISIE', 'LES COMMANDES S’ENCHAÎNENT SANS ATTENDRE'],
  href: '/cas-clients/humble-plus',
};
---

<section
  id="cas"
  data-section
  data-case-carousel
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-b border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    {/* Sans sur-titre : « CAS CLIENTS » nommait la section en petites capitales
        au-dessus d'un titre qui dit « mes derniers projets », et la navigation
        porte déjà l'entrée du même nom. */}
    <SectionHeader
      title="Mes derniers projets d'Agents IA et automatisation."
      titleMaxWidth="24ch"
    />

    <div class="case-carousel-toolbar reveal">
      <p class="sr-only" aria-live="polite" data-case-announcement>Projet 1 sur 4 : Humble+</p>
      <div class="case-carousel-arrows" aria-label="Navigation des cas clients">
        <button
          type="button"
          class="case-carousel-arrow"
          aria-label="Projet précédent"
          aria-controls="case-carousel-track"
          data-case-prev
          disabled
        >
          <Icon name="lucide:arrow-left" aria-hidden="true" />
        </button>
        <button
          type="button"
          class="case-carousel-arrow"
          aria-label="Projet suivant"
          aria-controls="case-carousel-track"
          data-case-next
        >
          <Icon name="lucide:arrow-right" aria-hidden="true" />
        </button>
      </div>
    </div>

    <div
      id="case-carousel-track"
      class="case-carousel-track no-scrollbar reveal"
      role="region"
      aria-roledescription="carrousel"
      aria-label="Cas clients récents"
      tabindex="0"
      data-case-track
    >
      {/* L'ordre n'est plus strictement chronologique, et le critère est celui
          que DESIGN.md pose déjà pour les visuels : « un cas qui n'a pas la
          matière n'a pas le visuel ». Celeris est un vrai travail — ERP, agent
          IA, souveraineté — mais ses deux indicateurs de tête sont un statut
          (« brouillon ») et un taux « en test », donc pas encore un résultat
          livré. Il passait en deuxième position, c'est-à-dire à l'endroit où un
          lecteur qui cherche son analogue le plus proche tombe en premier, sur
          une page qui promet des automatisations « qui tiennent en production ».
          Les trois cas livrés passent devant, dans leur ordre chronologique ;
          celui qui n'a pas encore ses chiffres ferme la marche. */}
      {/* ── 01 · Humble+ · juillet 2026 ── */}
      <article
        class="case-slide"
        role="group"
        aria-roledescription="diapositive"
        aria-label="1 sur 4 : Humble+"
        data-case-slide
        data-case-active
        data-case-name="Humble+"
      >
        <div class="case-slide-grid">
          <div class="case-copy">
            <div class="case-meta">
              <span class="case-client">{humblePlus.client}</span>
              <span class="mono-caption text-[var(--color-ink-low)]">{humblePlus.sector}</span>
              <time class="case-date" datetime="2026-07-23">JUIL. 2026</time>
            </div>
            <h3>{humblePlus.title}</h3>
            <p class="case-description">{humblePlus.description}</p>
            <p class="case-results">
              {humblePlus.results.map((result, i) => (
                <Fragment>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <span>{result}</span>
                </Fragment>
              ))}
            </p>
            <a href={humblePlus.href} class="case-cta group">
              <span class="case-cta-dot" aria-hidden="true"><span class="case-cta-arrow">→</span></span>
              <span class="case-cta-text">VOIR LE CAS</span>
            </a>
          </div>

          <div class="case-visual">
            <MockupWindow file="commandes · b2b.order-to-cash" status="actif" statusTone="success" schema flush>
              <WorkflowCanvas
                describe="Schéma simplifié du workflow Humble+ : les bons de commande PDF ou Excel arrivent par email, un agent Mistral extrait et contrôle les données, puis le workflow orchestre la commande Shopify, la facture Pennylane et la validation humaine des cas sensibles dans Slack."
                trigger={{ icon: 'simple-icons:gmail', color: brandColorFor('simple-icons:gmail'), kicker: 'Mail reçu', title: 'PDF + XLS', sub: 'pharmacie · salles' }}
                agent={{ icon: 'simple-icons:mistralai', color: brandColorFor('simple-icons:mistralai'), kicker: 'OCR + IA', title: 'Extrait & contrôle', sub: 'EAN · montants · client' }}
                actions={[
                  { icon: 'simple-icons:shopify', color: brandColorFor('simple-icons:shopify'), kicker: 'Shopify', title: 'Commande' },
                  { icon: 'lucide:receipt-text', kicker: 'Pennylane', title: 'Facture' },
                  { icon: 'simple-icons:slack', color: brandColorFor('simple-icons:slack'), kicker: 'Contrôle', title: 'Validation humaine' },
                ]}
              />
              <Fragment slot="footer">
                <span>Sécurité anti-doublon</span>
              </Fragment>
            </MockupWindow>
          </div>
        </div>
      </article>

      <article
        class="case-slide"
        role="group"
        aria-roledescription="diapositive"
        aria-label="2 sur 4 : M Partners"
        data-case-slide
        data-case-name="M Partners"
      >
        <div class="case-slide-grid">
          <div class="case-copy">
            <div class="case-meta">
              <span class="case-client">{mPartners.client}</span>
              <span class="mono-caption text-[var(--color-ink-low)]">{mPartners.sector}</span>
              <time class="case-date" datetime="2026-05-05">MAI 2026</time>
            </div>
            <h3>{mPartners.title}</h3>
            <p class="case-description">{mPartners.description}</p>
            <p class="case-results">
              {mPartners.results.map((result, i) => (
                <Fragment>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <span>{result}</span>
                </Fragment>
              ))}
            </p>
            <a href={mPartners.href} class="case-cta group">
              <span class="case-cta-dot" aria-hidden="true"><span class="case-cta-arrow">→</span></span>
              <span class="case-cta-text">VOIR LE CAS</span>
            </a>
          </div>

          <div class="case-visual">
            <MockupWindow file="prospection · sourcing-to-crm.flow" status="actif" statusTone="success" schema flush>
              <WorkflowCanvas
                describe="Schéma du workflow de prospection : les cibles sont collectées et enrichies, un agent IA les qualifie et les score, puis les meilleurs dirigeants sont poussés dans le CRM avec une shortlist priorisée et des alertes."
                trigger={{ icon: 'lucide:users', kicker: 'Sourcing', title: 'Cibles collectées', sub: 'LinkedIn · bases' }}
                agent={{ icon: 'simple-icons:anthropic', color: brandColorFor('simple-icons:anthropic'), kicker: 'Agent IA', title: 'Qualifie & score', sub: 'fit · séniorité · signaux' }}
                actions={[
                  { icon: 'simple-icons:hubspot', color: brandColorFor('simple-icons:hubspot'), kicker: 'CRM', title: 'À approcher' },
                  { icon: 'lucide:list-checks', kicker: 'Shortlist', title: 'Top 20 %' },
                  { icon: 'lucide:bell', kicker: 'Alerte', title: 'Nouveau signal' },
                ]}
              />
            </MockupWindow>
          </div>
        </div>
      </article>

      <article
        class="case-slide"
        role="group"
        aria-roledescription="diapositive"
        aria-label="3 sur 4 : Fraich Touch"
        data-case-slide
        data-case-name="Fraich Touch"
      >
        <div class="case-slide-grid">
          <div class="case-copy">
            <div class="case-meta">
              <img class="case-logo" src={fraichTouch.logo} alt={fraichTouch.client} width="810" height="810" style={`--logo-scale:${fraichTouch.logoScale ?? 1}`} loading="lazy" decoding="async" />
              <span class="mono-caption text-[var(--color-ink-low)]">{fraichTouch.sector}</span>
              <time class="case-date" datetime="2026-01-30">JANV. 2026</time>
            </div>
            <h3>{fraichTouch.title}</h3>
            <p class="case-description">{fraichTouch.description}</p>
            <p class="case-results">
              {fraichTouch.results.map((result, i) => (
                <Fragment>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <span>{result}</span>
                </Fragment>
              ))}
            </p>
            <a href={fraichTouch.href} class="case-cta group">
              <span class="case-cta-dot" aria-hidden="true"><span class="case-cta-arrow">→</span></span>
              <span class="case-cta-text">VOIR LE CAS</span>
            </a>
          </div>

          <div class="case-visual">
            <MockupWindow file="facturation · clients.auto" status="3 payées" statusTone="success" schema>
              <MockupList
                items={[
                  { label: 'Brand × Créateur', sub: 'INV-2041', value: '4 200 €', status: 'done' },
                  { label: 'Partenariat sport', sub: 'INV-2042', value: '1 850 €', status: 'done' },
                  { label: 'Relance J+7', sub: 'INV-2043', value: '2 600 €', status: 'pending' },
                ]}
              />
              <Fragment slot="footer">
                <span>▸ RELANCES AUTO · J+7 / J+14</span>
                <span class="ml-auto">0 RETARD</span>
              </Fragment>
            </MockupWindow>
          </div>
        </div>
      </article>

      <article
        class="case-slide"
        role="group"
        aria-roledescription="diapositive"
        aria-label="4 sur 4 : Celeris"
        data-case-slide
        data-case-name="Celeris"
      >
        <div class="case-slide-grid">
          <div class="case-copy">
            <div class="case-meta">
              <img class="case-logo" src={celeris.logo} alt={celeris.client} width="512" height="218" style={`--logo-scale:${celeris.logoScale ?? 1}`} loading="lazy" decoding="async" />
              <span class="mono-caption text-[var(--color-ink-low)]">{celeris.sector}</span>
              <time class="case-date" datetime="2026-06-20">JUIN 2026</time>
            </div>
            <h3>{celeris.title}</h3>
            <p class="case-description">{celeris.description}</p>
            <p class="case-results">
              {celeris.results.map((result, i) => (
                <Fragment>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <span>{result}</span>
                </Fragment>
              ))}
            </p>
            <a href={celeris.href} class="case-cta group">
              <span class="case-cta-dot" aria-hidden="true"><span class="case-cta-arrow">→</span></span>
              <span class="case-cta-text">VOIR LE CAS</span>
            </a>
          </div>

          <div class="case-visual">
            <MockupWindow file="catalogue · erp.sync" status="synchronisé" statusTone="success" schema>
              <MockupList
                items={[
                  { label: 'Onduleur 3000 VA', sub: 'SKU-44821', value: '+12 champs', status: 'done' },
                  { label: 'Switch 48 ports', sub: 'SKU-44822', value: '+9 champs', status: 'done' },
                  { label: 'NAS 4 baies', sub: 'SKU-44823', value: 'en cours', status: 'pending' },
                ]}
              />
              <Fragment slot="footer">
                <span>▸ AGENT IA · EN INTERNE</span>
                <span class="ml-auto">SOUVERAINETÉ ✓</span>
              </Fragment>
            </MockupWindow>
          </div>
        </div>
      </article>
    </div>

    <div class="case-carousel-pagination reveal" aria-label="Accès direct aux cas clients">
      {/* Sans numéro. DESIGN.md déclare la numérotation retirée partout et cite
          nommément la pagination des cas ; elle y tournait encore. Le `01 / 04`
          des pages de cas a été gardé, lui, parce qu'il dit une progression dans
          un article long — où j'en suis, combien il reste. Ici les quatre
          boutons sont visibles ensemble, avec le nom du client et le filet
          d'état : le chiffre ne répondait à aucune question. */}
      {['Humble+', 'M Partners', 'Fraich Touch', 'Celeris'].map((label, index) => (
        <button
          type="button"
          class="case-carousel-dot"
          aria-label={`Afficher le cas ${label}`}
          aria-current={index === 0 ? 'true' : undefined}
          data-case-dot
          data-case-index={index}
        >
          <span class="case-carousel-dot-label">{label}</span>
        </button>
      ))}
    </div>

    <div class="case-carousel-footer reveal">
      <a href="/cas-clients" class="link-cta">
        <span class="link-cta__label">VOIR TOUS LES CAS</span>
        <span class="link-cta__arrow" aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .case-carousel-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 1.25rem;
  }

  .case-carousel-arrows {
    display: flex;
    align-items: center;
  }

  .case-carousel-arrows {
    gap: 0.5rem;
  }

  [data-case-carousel]:not([data-case-ready]) .case-carousel-arrows,
  [data-case-carousel]:not([data-case-ready]) .case-carousel-pagination {
    visibility: hidden;
  }

  .case-carousel-arrow {
    display: inline-grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    color: var(--color-ink);
    background: var(--color-surface-high);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    cursor: pointer;
  }

  .case-carousel-arrow:hover:not(:disabled),
  .case-carousel-arrow:focus-visible:not(:disabled) {
    color: var(--color-ink);
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .case-carousel-arrow:active:not(:disabled) {
    transform: translateY(0) scale(0.96);
  }

  .case-carousel-arrow:disabled {
    color: var(--color-ink-faint);
    background: transparent;
    border-color: var(--color-divider);
    cursor: not-allowed;
    opacity: 0.7;
  }

  .case-carousel-arrow :global(svg) {
    width: 18px;
    height: 18px;
  }

  .case-carousel-track {
    /* La gouttière est nommée parce que deux autres déclarations en dépendent :
       la largeur de la diapositive et la marge de fin qui rend la dernière
       position de calage atteignable. Trois valeurs qui doivent rester égales,
       et rien ne signalait une dérive entre elles. */
    --case-gap: clamp(1rem, 2vw, 1.5rem);
    /* Le carrousel emprunte --duration-reveal (380 ms), la durée la plus répandue
       du système, plutôt que la courbe interne de Chrome. Le défilement natif en
       `smooth` mettait 564 ms mesurées à 1440 px et 286 ms à 402 px : la même
       commande répondait deux fois moins vite selon la largeur de la fenêtre, sur
       une durée qu'aucun jeton ne pilotait. Le JS lit cette valeur et
       --ease-out-quint, et anime lui-même scrollLeft. */
    --case-scroll-duration: var(--duration-reveal);
    display: flex;
    align-items: stretch;
    gap: var(--case-gap);
    width: 100%;
    padding: 2px;
    margin: -2px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 2px;
  }

  /* Le calage natif est suspendu pendant le défilement piloté : avec
     `mandatory`, chaque écriture de scrollLeft en rAF est susceptible d'être
     rattrapée par le moteur de calage, qui ramène alors la piste au point le
     plus proche au milieu du geste. L'attribut est retiré à l'arrivée, sur un
     point de calage exact — la remise en service ne produit donc aucun saut. */
  .case-carousel-track[data-case-scripted] {
    scroll-snap-type: none;
  }

  /* La diapositive ne prend pas toute la largeur de la piste : il lui manque de
     quoi laisser dépasser le bord de la suivante. Quatre cas chiffrés vivaient
     derrière un geste que rien n'annonçait — la carte occupait la largeur
     entière, et un lecteur qui ne balaie pas repartait avec une preuve sur
     quatre.
     Ce qui dépasse est désormais calé sur le rembourrage de la carte, et non sur
     une courbe indépendante. Mesuré avant : 28 px dépassaient à 375, 402 et
     430 px, pour 18 px de rembourrage — soit 10 px de colonne de texte, dont
     9 px de glyphes tranchés sur chacune des six lignes de la carte suivante. On
     y lisait une colonne de lettres orphelines, pas « il y en a d'autres » : trop
     peu pour qu'un mot se devine, assez pour que l'œil s'y arrête. L'autre issue
     — 110 à 130 px, où un mot entier se lit — laissait 214 px de carte à 402 px
     de fenêtre, soit 176 px de contenu : la maquette produit n'y tient pas.
     Le filet vaut donc le rembourrage moins 2 px : la coupe tombe juste avant la
     colonne de texte, à toutes les largeurs et sans exception mobile à écrire.
     Ce qui dépasse est un bord de carte — 1 px de filet et du papier — c'est-à-dire
     exactement ce que le bureau montrait déjà (35,6 px pour 36 px de
     rembourrage), et que le mobile était seul à ne pas faire. */
  .case-slide {
    --case-padding: clamp(1.25rem, 3vw, 2.25rem);
    --case-peek: calc(var(--case-padding) - 2px);
    flex: 0 0 auto;
    width: calc(100% - var(--case-gap) - var(--case-peek));
    min-width: 0;
    padding: var(--case-padding);
    background:
      linear-gradient(var(--color-grid-line), var(--color-grid-line)) 0 0 / 100% 1px no-repeat,
      var(--color-surface-high);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* La dernière diapositive était la seule dont le cadrage différait des trois
     autres, et ce n'était pas un choix : `scroll-snap-align: start` sur une
     largeur amputée du filet rend la dernière position de calage inatteignable
     d'exactement la valeur du filet. Mesuré : 46 px manquaient à 402 px de
     fenêtre, 59 px à 1440. La carte s'arrêtait donc décalée vers la droite, avec
     un morceau de la PRÉCÉDENTE visible à gauche — le geste inverse de celui que
     les trois autres font.
     La marge de fin rend cette course. Elle vaut la gouttière plus le filet, et
     l'égalité n'est pas approchée : la course maximale devient 3 × (largeur utile
     − filet), c'est-à-dire au pixel près l'abscisse qui aligne la quatrième carte
     à gauche. Ce qui dépasse alors à droite est du vide, et c'est exact — il n'y
     a pas de cinquième cas. */
  .case-slide:last-child {
    margin-inline-end: calc(var(--case-gap) + var(--case-peek));
  }

  .case-slide-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    min-height: clamp(430px, 40vw, 520px);
  }

  .case-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    min-width: 0;
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    width: 100%;
  }

  .case-client {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .case-date {
    margin-left: auto;
    color: var(--color-ink-low);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .case-copy h3 {
    max-width: 20ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .case-description {
    max-width: 48ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* Le point médian devient inutile dès que chaque résultat a son propre
     aplat : deux pastilles séparées se lisent sans séparateur. */
  .case-results > span[aria-hidden='true'] { display: none; }

  .case-results > span:not([aria-hidden='true']) {
    background: var(--color-lime);
    color: var(--color-ink);
    padding: 0.4em 0.7em;
  }

  .case-results {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin: 0;
    color: var(--color-ink-mid);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .case-visual {
    min-width: 0;
  }

  .case-slide:not([data-case-active]) :global(.wf-wire-flow),
  .case-slide:not([data-case-active]) :global(.wf-node.is-accent .wf-dot) {
    animation-play-state: paused;
  }

  .case-carousel-pagination {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.5rem, 2vw, 1.25rem);
    margin-top: 1.25rem;
  }

  .case-carousel-dot {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.75rem 0 0;
    color: var(--color-ink-low);
    background: transparent;
    border: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    letter-spacing: 0.02em;
    text-align: left;
  }

  /* ink-faint et non divider : cette barre est le seul indicateur d'état des
     cas non sélectionnés, et à 1,26:1 elle était invisible — la pagination
     n'annonçait donc pas qu'il restait trois cas à voir. 3,03:1, seuil des
     indicateurs non textuels. */
  .case-carousel-dot::before {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    content: '';
    background: var(--color-ink-faint);
    transition: background-color 300ms var(--ease-out-quint);
  }

  .case-carousel-dot:hover,
  .case-carousel-dot:focus-visible,
  .case-carousel-dot:active,
  .case-carousel-dot[aria-current='true'] {
    color: var(--color-ink);
  }

  /* Le filet passe à l'encre dès l'appui, avant même que la carte ne soit
     arrivée. L'état `aria-current`, lui, attend l'arrivée réelle : sans ce
     retour à l'appui, presser un onglet ne produirait plus rien pendant les
     380 ms du déplacement. */
  .case-carousel-dot:active::before,
  .case-carousel-dot[aria-current='true']::before {
    background: var(--color-ink);
  }

  /* Le nom du client reste affiché à toutes les largeurs. Il disparaissait sous
     640 px et la pagination se réduisait à « 01 02 03 04 » : quatre traits
     numérotés ne disent pas ce qu'ils contiennent, et c'est précisément là que
     les libellés manquaient le plus, l'écran ne montrant qu'un cas. Mesuré à
     402 px, chaque colonne fait 80 px — de quoi poser « 02 Celeris » en entier
     et « 03 M Partne… » tronqué. Un nom coupé nomme encore ; un numéro nu ne
     nomme rien. */
  .case-carousel-dot-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .case-carousel-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: clamp(1.25rem, 2vw, 1.75rem);
  }

  /* CTA "Voir le cas" — DA dédiée : pastille flèche circulaire qui se remplit de
     l'accent flamme au hover (distincte du CTA-texte souligné du reste du site). */
  .case-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
  }
  .case-cta-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    color: var(--color-ink);
    transition: background-color var(--duration-default) var(--ease-out-quint),
                border-color var(--duration-default) var(--ease-out-quint),
                color var(--duration-default) var(--ease-out-quint);
  }
  /* La flèche passe à l'encre, pas au papier : sur un fond lime, du blanc tient
     1,25:1 et le glyphe disparaissait pendant tout le survol. Le lime est une
     surface, ce qui se pose dessus est de l'encre. */
  .case-cta:hover .case-cta-dot,
  .case-cta:focus-visible .case-cta-dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-ink);
  }
  .case-cta-arrow {
    transition: transform var(--duration-default) var(--ease-out-quint);
  }
  .case-cta:hover .case-cta-arrow,
  .case-cta:focus-visible .case-cta-arrow {
    transform: translateX(2px);
  }
  .case-cta-text {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink-mid);
    transition: color var(--duration-default) var(--ease-out-quint);
  }
  .case-cta:hover .case-cta-text,
  .case-cta:focus-visible .case-cta-text {
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .case-cta-dot, .case-cta-arrow, .case-cta-text { transition: none; }
  }

  /* Logo client — silhouette monochrome (encre / blanc en dark). */
  .case-logo {
    height: calc(26px * var(--logo-scale, 1));
    width: auto;
    max-width: 180px;
    object-fit: contain;
    filter: brightness(0);
    opacity: 0.9;
  }
  /* Le seuil de repli est calé sur la largeur dont la maquette a besoin, et non
     sur une valeur ronde. Il valait 899 px, alors que WorkflowCanvas ne se replie
     en pile qu'à 720 px de fenêtre : entre les deux, la diapositive restait en
     deux colonnes et la colonne visuelle n'avait plus la place de porter le
     schéma sans que rien ne se redéclenche. Mesuré sur la diapositive Humble+, en
     deux colonnes : 900 px de fenêtre → colonne de 371 px, six nœuds tronqués et
     le nom de fichier rogné de 92 px ; 1013 px → 421 px, quatre débordements ;
     1180 px → 495 px, il reste 6 px sur « Pennylane ». La première largeur où
     plus rien ne déborde nulle part est 1220 px, soit une colonne visuelle de
     511 px. En dessous, la diapositive passe donc en une seule colonne et la
     maquette récupère toute la largeur de la carte — 806 px à 1013 px de fenêtre
     au lieu de 421.
     Le plafond de lecture du paragraphe (48ch) est conservé dans cette plage :
     lâché à toute la largeur comme il l'est sous 900 px, il produisait des lignes
     de 110 caractères, très au-dessus des 65 à 75 lisibles. */
  @media (max-width: 1219px) {
    .case-slide-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .case-copy h3 {
      max-width: 24ch;
    }
  }

  @media (max-width: 899px) {
    .case-copy,
    .case-description {
      max-width: none;
    }
  }

  @media (max-width: 639px) {
    .case-carousel-toolbar {
      margin-bottom: 1rem;
    }

    /* Le rembourrage seul : la largeur et la marge de fin suivent, puisqu'elles
       le lisent. Écrire `padding` en dur ici aurait laissé le filet calé sur la
       valeur du bureau, ce qui est exactement la dérive d'origine. */
    .case-slide {
      --case-padding: 1.125rem;
    }

    .case-slide-grid {
      gap: 1.75rem;
    }

    .case-meta {
      align-items: flex-start;
    }

    .case-date {
      flex: 0 0 100%;
      margin-left: 0;
    }

    .case-logo {
      max-width: 144px;
    }
  }

  /* La piste n'a plus de `scroll-behavior: smooth` à neutraliser ici : le
     déplacement est piloté en JS, qui saute directement à l'arrivée quand le
     système demande moins d'animation. La déclaration CSS aurait été un second
     endroit à tenir à jour pour la même règle. */
  @media (prefers-reduced-motion: reduce) {
    .case-carousel-arrow,
    .case-carousel-dot::before {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-case-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-case-track]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-case-slide]'));
    const previous = carousel.querySelector<HTMLButtonElement>('[data-case-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-case-next]');
    const announcement = carousel.querySelector<HTMLElement>('[data-case-announcement]');
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-case-dot]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!track || !previous || !next || slides.length === 0) return;

    /* Deux index, et la distinction est tout le sujet du correctif.
       `activeIndex` est ce qui est RÉELLEMENT à l'écran ; `targetIndex` est ce
       vers quoi on se déplace. Avant, un seul index basculait tout au clic :
       mesurée, la pagination changeait d'onglet 12 ms après l'appui pendant que
       la carte mettait 564 ms à arriver — pendant une demi-seconde le carrousel
       annonçait un cas qu'on ne voyait pas encore, y compris au lecteur d'écran.
       Ce qui répond à l'appui (les flèches, qui doivent pouvoir s'enchaîner) lit
       la cible ; ce qui décrit l'écran (onglet courant, `inert`, `aria-hidden`,
       annonce vocale) attend l'arrivée. */
    let activeIndex = 0;
    let targetIndex = 0;
    let scrollEndTimer = 0;
    let scrollRaf: number | null = null;
    let scripted = false;

    const trackStyles = getComputedStyle(track);
    const bounded = (index: number) => Math.max(0, Math.min(index, slides.length - 1));

    /* Durée et courbe viennent des jetons — DESIGN.md interdit d'écrire l'une ou
       l'autre sur place, et le défilement natif n'obéissait à aucune des deux.
       Les valeurs de repli ne servent qu'au cas où la feuille de style n'aurait
       pas encore été appliquée : elles reprennent --duration-reveal et
       --ease-out-quint à l'identique. */
    const scrollDuration = parseFloat(trackStyles.getPropertyValue('--case-scroll-duration')) || 380;
    const scrollPadding = parseFloat(trackStyles.scrollPaddingInlineStart) || 0;

    /* Résout la courbe de Bézier du jeton pour une abscisse donnée. La bissection
       sur 24 pas descend sous 10⁻⁷, soit très en dessous du pixel sur la course
       d'une diapositive ; une approximation recopiée aurait été une seconde
       définition de --ease-out-quint, exactement ce que la DA a déjà eu à
       corriger deux fois. */
    const easingFromToken = (declaration: string) => {
      const numbers = declaration.match(/-?\d*\.?\d+/g)?.map(Number);
      if (!numbers || numbers.length < 4) return (progress: number) => progress;
      const [x1, y1, x2, y2] = numbers;
      const axis = (a: number, b: number, t: number) =>
        3 * (1 - t) * (1 - t) * t * a + 3 * (1 - t) * t * t * b + t * t * t;
      return (progress: number) => {
        let low = 0;
        let high = 1;
        let t = progress;
        for (let step = 0; step < 24; step += 1) {
          t = (low + high) / 2;
          if (axis(x1, x2, t) < progress) low = t;
          else high = t;
        }
        return axis(y1, y2, t);
      };
    };
    const ease = easingFromToken(trackStyles.getPropertyValue('--ease-out-quint'));

    /* L'abscisse de calage de la diapositive, dans le même repère que
       `scrollLeft`. Le retrait de `scroll-padding-inline` n'est pas cosmétique :
       sans lui le JS visait 2 px à droite du point de calage natif, et le moteur
       de calage rattrapait ces 2 px après coup, en un second déplacement. */
    const slideOffset = (slide: HTMLElement) => {
      const trackBox = track.getBoundingClientRect();
      const slideBox = slide.getBoundingClientRect();
      return slideBox.left - trackBox.left + track.scrollLeft - scrollPadding;
    };

    // Ce que la commande doit rendre TOUT DE SUITE : de quoi enchaîner les appuis
    // sans dépasser les bornes, la carte n'étant pas encore arrivée.
    const syncArrows = () => {
      previous.disabled = targetIndex === 0;
      next.disabled = targetIndex === slides.length - 1;
    };

    // Ce qui décrit l'écran, et n'est donc écrit qu'une fois la carte arrivée.
    const settle = (index: number) => {
      activeIndex = bounded(index);
      targetIndex = activeIndex;
      syncArrows();
      if (announcement) {
        announcement.textContent = `Projet ${activeIndex + 1} sur ${slides.length} : ${slides[activeIndex].dataset.caseName ?? ''}`;
      }

      slides.forEach((slide, slideIndex) => {
        if (slideIndex === activeIndex) {
          slide.setAttribute('data-case-active', '');
          slide.removeAttribute('aria-hidden');
          slide.removeAttribute('inert');
        } else {
          slide.removeAttribute('data-case-active');
          slide.setAttribute('aria-hidden', 'true');
          slide.setAttribute('inert', '');
        }
      });

      dots.forEach((dot, dotIndex) => {
        if (dotIndex === activeIndex) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const findClosestSlide = () => {
      const position = track.scrollLeft;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      slides.forEach((slide, index) => {
        const distance = Math.abs(slideOffset(slide) - position);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const stopScripted = () => {
      if (scrollRaf !== null) {
        cancelAnimationFrame(scrollRaf);
        scrollRaf = null;
      }
      if (scripted) {
        scripted = false;
        track.removeAttribute('data-case-scripted');
      }
    };

    const scrollTo = (left: number, onArrival: () => void) => {
      stopScripted();
      const limit = track.scrollWidth - track.clientWidth;
      const destination = Math.max(0, Math.min(left, limit));
      const origin = track.scrollLeft;
      const distance = destination - origin;

      // Moins d'un pixel à parcourir, ou une préférence système pour moins de
      // mouvement : on arrive tout de suite.
      if (reducedMotion.matches || Math.abs(distance) < 1) {
        track.scrollLeft = destination;
        onArrival();
        return;
      }

      scripted = true;
      track.setAttribute('data-case-scripted', '');
      const startedAt = performance.now();

      const frame = (now: number) => {
        const progress = Math.min((now - startedAt) / scrollDuration, 1);
        track.scrollLeft = origin + distance * ease(progress);
        if (progress < 1) {
          scrollRaf = requestAnimationFrame(frame);
          return;
        }
        scrollRaf = null;
        scripted = false;
        track.removeAttribute('data-case-scripted');
        track.scrollLeft = destination;
        onArrival();
      };

      scrollRaf = requestAnimationFrame(frame);
    };

    const goTo = (index: number) => {
      const wanted = bounded(index);
      targetIndex = wanted;
      syncArrows();
      scrollTo(slideOffset(slides[wanted]), () => settle(wanted));
    };

    previous.addEventListener('click', () => goTo(targetIndex - 1));
    next.addEventListener('click', () => goTo(targetIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.caseIndex);
        if (Number.isInteger(index)) goTo(index);
      });
    });

    // Le doigt et la molette l'emportent sur un déplacement en cours : une piste
    // qui continue sa course sous la main est le défaut que le défilement natif
    // avait déjà, et qu'il n'y avait aucune raison de reconduire.
    (['pointerdown', 'wheel', 'touchstart'] as const).forEach((type) => {
      track.addEventListener(type, stopScripted, { passive: true });
    });

    track.addEventListener('scroll', () => {
      // Pendant un déplacement piloté, l'arrivée est déjà datée : la relecture de
      // la diapositive la plus proche ne servirait qu'à écrire deux fois le même
      // état, et à le faire une image trop tôt.
      if (scripted) return;
      window.clearTimeout(scrollEndTimer);
      scrollEndTimer = window.setTimeout(() => settle(findClosestSlide()), 80);
    }, { passive: true });

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(targetIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(targetIndex + 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(slides.length - 1);
      }
    });

    settle(0);
    carousel.setAttribute('data-case-ready', '');
  });
</script>
