---
/*
 * CaseStudy.astro — section §02.
 *
 * Lignes alternées texte + mini-mockup produit (façon capture d'app), un mockup
 * sur-mesure par mission pour rendre concret CE QUE FAIT l'automatisation :
 *   · Fraich Touch  → panneau facturation (factures payées / relance auto)
 *   · M Partners    → canvas de workflow (sourcing → agent IA → CRM)
 *   · Celeris       → catalogue ERP enrichi par agent IA, en interne
 *   · Humble+       → order-to-cash B2B (PDF/XLS → Shopify → Pennylane)
 * Tout en monochrome (tokens projet) ; seul --color-success (fonctionnel) pointe
 * les statuts positifs. Copy et angle métier inchangés.
 */
import SectionHeader from './SectionHeader.astro';
import MockupWindow from './mockups/MockupWindow.astro';
import MockupList from './mockups/MockupList.astro';
import WorkflowCanvas from './mockups/WorkflowCanvas.astro';
import { brandColorFor } from '../data/brands';

const fraichTouch = {
  client: 'Fraich Touch',
  logo: '/logos/fraichtouch.svg',
  logoScale: 2.2,
  sector: 'AGENCE DE GESTION DE TALENTS',
  title: 'Facturation complexe 100% automatisée depuis HubSpot',
  description:
    "Agence de gestion de talents (santé, sport, entrepreneuriat) qui pilote les partenariats marques de ses créateurs. J'ai repensé et fiabilisé tout leur système de facturation, automatisé de bout en bout, documenté et surveillé, pour que l'équipe arrête de courir après les paiements et se concentre sur ses talents.",
  /* Chiffres réels — mêmes KPIs que le frontmatter de la sous-page. */
  results: ['16 → 0 FACTURES EN ERREUR', '~4 H/SEM DE MAINTENANCE EN MOINS'],
  href: '/cas-clients/facturation-automatisee-fraich-touch',
};
const mPartners = {
  client: 'M Partners',
  sector: 'EXECUTIVE SEARCH · TECH & VC',
  title: "Scraping, sourcing et qualification alimentée par l'IA",
  description:
    "Cabinet de chasse de têtes spécialisé sur l'écosystème startup et capital-risque. J'ai industrialisé leur prospection : la collecte et l'enrichissement des cibles sont automatisés, puis un agent IA qualifie les bons dirigeants à approcher. L'équipe se concentre sur la relation, plus sur la recherche manuelle.",
  results: ['3 H → 10 MIN PAR RUN DE SOURCING', '300 ENTREPRISES/SEM'],
  href: '/cas-clients/m-partners',
};
const celeris = {
  client: 'Celeris',
  logo: '/logos/celeris.webp',
  sector: 'DISTRIBUTEUR IT B2B',
  title: "Un catalogue produits qui s'enrichit tout seul.",
  description:
    "Distributeur IT B2B, acteur établi du marché français. J'accompagne leurs équipes dans leur montée en compétence sur l'automatisation, et j'ai conçu un agent IA qui gère leur catalogue produits directement dans leur ERP, pensé pour tourner en interne, avec une exigence forte de souveraineté des données.",
  href: '/cas-clients/celeris',
};
const humblePlus = {
  client: 'Humble+',
  sector: 'NUTRITION FONCTIONNELLE · E-COMMERCE B2B',
  title: 'Des bons de commande B2B aux factures, sans ressaisie',
  description:
    "Marque française de compléments alimentaires distribuée en direct et via un réseau B2B. J'ai remplacé un scénario Make fragile par un workflow n8n qui lit les bons de commande PDF ou Excel, sécurise les montants, crée la commande Shopify puis la facture Pennylane, avec validation Slack pendant la phase de stabilisation.",
  results: ['2 FLUX PDF + XLS UNIFIÉS', "0,00 € D'ÉCART SUR LE CAS TEST"],
  href: '/cas-clients/humble-plus',
};
---

<section
  id="cas"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-b border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      number="02"
      label="CAS CLIENTS"
      title="Mes derniers projets IA & Automatisations"
      titleMaxWidth="24ch"
    />

    <div class="flex flex-col gap-16 md:gap-20 lg:gap-24">

      {/* ── Fraich Touch : texte ⟶ facturation ── */}
      <article class="reveal grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center">
        <div class="flex flex-col gap-5">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
            <img class="case-logo" src={fraichTouch.logo} alt={fraichTouch.client} width="810" height="810" style={`--logo-scale:${fraichTouch.logoScale ?? 1}`} loading="lazy" decoding="async" />
            <span class="mono-caption text-[var(--color-ink-low)]">{fraichTouch.sector}</span>
          </div>
          <h3 class="font-display font-semibold text-[length:var(--text-title-lg)] tracking-[-0.02em] text-[var(--color-ink)] leading-[1.15] m-0 max-w-[20ch]">{fraichTouch.title}</h3>
          <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body)] leading-[1.6] m-0 max-w-[46ch]">{fraichTouch.description}</p>
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 mono-caption text-[var(--color-ink-mid)] m-0">
            {fraichTouch.results.map((result, i) => (
              <Fragment>
                {i > 0 && <span aria-hidden="true">·</span>}
                <span>{result}</span>
              </Fragment>
            ))}
          </p>
          <a href={fraichTouch.href} class="case-cta group w-fit">
            <span class="case-cta-dot" aria-hidden="true"><span class="case-cta-arrow">→</span></span>
            <span class="case-cta-text">VOIR LE CAS</span>
          </a>
        </div>
        <div>
          <MockupWindow file="facturation — clients.auto" status="3 payées" statusTone="success">
            <MockupList
              items={[
                { label: 'Brand × Créateur', sub: 'INV-2041', value: '4 200 €', status: 'done' },
                { label: 'Partenariat sport', sub: 'INV-2042', value: '1 850 €', status: 'done' },
                { label: 'Relance J+7', sub: 'INV-2043', value: '2 600 €', status: 'pending' },
              ]}
            />
            <Fragment slot="footer">
              <span>▸ RELANCES AUTO · J+7 / J+14</span>
              <span class="ml-auto">0 RETARD</span>
            </Fragment>
          </MockupWindow>
        </div>
      </article>

      {/* ── M Partners : workflow ⟵ texte (alterné) ── */}
      <article class="reveal grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center">
        <div class="order-2 lg:order-1">
          <MockupWindow file="prospection — sourcing-to-crm.flow" status="actif" statusTone="success" flush>
            <WorkflowCanvas
              describe="Schéma du workflow de prospection : les cibles sont collectées et enrichies, un agent IA les qualifie et les score, puis les meilleurs dirigeants sont poussés dans le CRM avec une shortlist priorisée et des alertes."
              trigger={{ icon: 'lucide:users', kicker: 'Sourcing', title: 'Cibles collectées', sub: 'LinkedIn · bases' }}
              agent={{ icon: 'simple-icons:anthropic', color: brandColorFor('simple-icons:anthropic'), kicker: 'Agent IA', title: 'Qualifie & score', sub: 'fit · séniorité · signaux' }}
              actions={[
                { icon: 'simple-icons:hubspot', color: brandColorFor('simple-icons:hubspot'), kicker: 'CRM', title: 'À approcher' },
                { icon: 'lucide:list-checks', kicker: 'Shortlist', title: 'Top 20 %' },
                { icon: 'lucide:bell', kicker: 'Alerte', title: 'Nouveau signal' },
              ]}
            />
          </MockupWindow>
        </div>
        <div class="order-1 lg:order-2 flex flex-col gap-5">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-display font-medium text-[length:var(--text-title)] tracking-[-0.02em] text-[var(--color-ink)]">{mPartners.client}</span>
            <span class="mono-caption text-[var(--color-ink-low)]">{mPartners.sector}</span>
          </div>
          <h3 class="font-display font-semibold text-[length:var(--text-title-lg)] tracking-[-0.02em] text-[var(--color-ink)] leading-[1.15] m-0 max-w-[20ch]">{mPartners.title}</h3>
          <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body)] leading-[1.6] m-0 max-w-[46ch]">{mPartners.description}</p>
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 mono-caption text-[var(--color-ink-mid)] m-0">
            {mPartners.results.map((result, i) => (
              <Fragment>
                {i > 0 && <span aria-hidden="true">·</span>}
                <span>{result}</span>
              </Fragment>
            ))}
          </p>
          <a href={mPartners.href} class="case-cta group w-fit">
            <span class="case-cta-dot" aria-hidden="true"><span class="case-cta-arrow">→</span></span>
            <span class="case-cta-text">VOIR LE CAS</span>
          </a>
        </div>
      </article>

      {/* ── Celeris : texte ⟶ catalogue ERP ── */}
      <article class="reveal grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center">
        <div class="flex flex-col gap-5">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
            <img class="case-logo" src={celeris.logo} alt={celeris.client} width="512" height="218" style={`--logo-scale:${celeris.logoScale ?? 1}`} loading="lazy" decoding="async" />
            <span class="mono-caption text-[var(--color-ink-low)]">{celeris.sector}</span>
          </div>
          <h3 class="font-display font-semibold text-[length:var(--text-title-lg)] tracking-[-0.02em] text-[var(--color-ink)] leading-[1.15] m-0 max-w-[20ch]">{celeris.title}</h3>
          <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body)] leading-[1.6] m-0 max-w-[46ch]">{celeris.description}</p>
          <a href={celeris.href} class="case-cta group w-fit">
            <span class="case-cta-dot" aria-hidden="true"><span class="case-cta-arrow">→</span></span>
            <span class="case-cta-text">VOIR LE CAS</span>
          </a>
        </div>
        <div>
          <MockupWindow file="catalogue — erp.sync" status="synchronisé" statusTone="success">
            <MockupList
              items={[
                { label: 'Onduleur 3000 VA', sub: 'SKU-44821', value: '+12 champs', status: 'done' },
                { label: 'Switch 48 ports', sub: 'SKU-44822', value: '+9 champs', status: 'done' },
                { label: 'NAS 4 baies', sub: 'SKU-44823', value: 'en cours', status: 'pending' },
              ]}
            />
            <Fragment slot="footer">
              <span>▸ AGENT IA · EN INTERNE</span>
              <span class="ml-auto">SOUVERAINETÉ ✓</span>
            </Fragment>
          </MockupWindow>
        </div>
      </article>

      {/* ── Humble+ : order-to-cash ⟵ texte (alterné) ── */}
      <article class="reveal grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center">
        <div class="order-2 lg:order-1">
          <MockupWindow file="commandes — b2b.order-to-cash" status="actif" statusTone="success" flush>
            <WorkflowCanvas
              describe="Schéma simplifié du workflow Humble+ : les bons de commande PDF ou Excel arrivent par email, un agent Mistral extrait et contrôle les données, puis le workflow orchestre la commande Shopify, la facture Pennylane et la validation humaine des cas sensibles dans Slack."
              trigger={{ icon: 'simple-icons:gmail', color: brandColorFor('simple-icons:gmail'), kicker: 'Entrée B2B', title: 'PDF + XLS', sub: 'pharmacie · salles' }}
              agent={{ icon: 'simple-icons:mistralai', color: brandColorFor('simple-icons:mistralai'), kicker: 'OCR + IA', title: 'Extrait & contrôle', sub: 'EAN · montants · client' }}
              actions={[
                { icon: 'simple-icons:shopify', color: brandColorFor('simple-icons:shopify'), kicker: 'Shopify', title: 'Commande' },
                { icon: 'lucide:receipt-text', kicker: 'Pennylane', title: 'Facture' },
                { icon: 'simple-icons:slack', color: brandColorFor('simple-icons:slack'), kicker: 'Contrôle', title: 'Validation humaine' },
              ]}
            />
            <Fragment slot="footer">
              <span>▸ ANTI-DOUBLON · CONTRÔLE AU CENTIME</span>
              <span class="ml-auto">2 FLUX</span>
            </Fragment>
          </MockupWindow>
        </div>
        <div class="order-1 lg:order-2 flex flex-col gap-5">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-display font-medium text-[length:var(--text-title)] tracking-[-0.02em] text-[var(--color-ink)]">{humblePlus.client}</span>
            <span class="mono-caption text-[var(--color-ink-low)]">{humblePlus.sector}</span>
          </div>
          <h3 class="font-display font-semibold text-[length:var(--text-title-lg)] tracking-[-0.02em] text-[var(--color-ink)] leading-[1.15] m-0 max-w-[20ch]">{humblePlus.title}</h3>
          <p class="text-[var(--color-ink-mid)] text-[length:var(--text-body)] leading-[1.6] m-0 max-w-[46ch]">{humblePlus.description}</p>
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 mono-caption text-[var(--color-ink-mid)] m-0">
            {humblePlus.results.map((result, i) => (
              <Fragment>
                {i > 0 && <span aria-hidden="true">·</span>}
                <span>{result}</span>
              </Fragment>
            ))}
          </p>
          <a href={humblePlus.href} class="case-cta group w-fit">
            <span class="case-cta-dot" aria-hidden="true"><span class="case-cta-arrow">→</span></span>
            <span class="case-cta-text">VOIR LE CAS</span>
          </a>
        </div>
      </article>

    </div>

  </div>
</section>

<style>
  /* CTA "Voir le cas" — DA dédiée : pastille flèche circulaire qui se remplit de
     l'accent flamme au hover (distincte du CTA-texte souligné du reste du site). */
  .case-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
  }
  .case-cta-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    color: var(--color-ink);
    transition: background-color var(--duration-default) var(--ease-out-quint),
                border-color var(--duration-default) var(--ease-out-quint),
                color var(--duration-default) var(--ease-out-quint);
  }
  .case-cta:hover .case-cta-dot,
  .case-cta:focus-visible .case-cta-dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-paper);
  }
  .case-cta-arrow {
    transition: transform var(--duration-default) var(--ease-out-quint);
  }
  .case-cta:hover .case-cta-arrow,
  .case-cta:focus-visible .case-cta-arrow {
    transform: translateX(2px);
  }
  .case-cta-text {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink-mid);
    transition: color var(--duration-default) var(--ease-out-quint);
  }
  .case-cta:hover .case-cta-text,
  .case-cta:focus-visible .case-cta-text {
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .case-cta-dot, .case-cta-arrow, .case-cta-text { transition: none; }
  }

  /* Logo client — silhouette monochrome (encre / blanc en dark). */
  .case-logo {
    height: calc(26px * var(--logo-scale, 1));
    width: auto;
    max-width: 180px;
    object-fit: contain;
    filter: brightness(0);
    opacity: 0.9;
  }
  :global(html.dark) .case-logo { filter: brightness(0) invert(1); opacity: 0.92; }
  @media (prefers-color-scheme: dark) {
    :global(html:not(.light)) .case-logo { filter: brightness(0) invert(1); opacity: 0.92; }
  }
</style>
