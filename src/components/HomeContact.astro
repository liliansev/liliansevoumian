---
import SectionHeader from './SectionHeader.astro';
import BoutonReservation from './BoutonReservation.astro';
import LinkCTA from './LinkCTA.astro';

const briefSubject = 'Mon projet — site, application ou automatisation';
const briefBody = `Bonjour Lilian,

Voici mon projet :

Entreprise et activité :
Besoin ou problème à résoudre :
Outils utilisés aujourd’hui :
Échéance envisagée :

Merci !`;
const briefHref = `mailto:bonjour@liliansevoumian.fr?subject=${encodeURIComponent(briefSubject)}&body=${encodeURIComponent(briefBody)}`;
---

<section
  id="contact"
  data-section
  class="bloc-lime relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)]"
>
  <div class="relative max-w-[1200px] mx-auto">
    <SectionHeader
      title="Parlons de <mark class='inv'>votre projet.</mark>"
      body="Décrivez-moi ce que vous voulez faire avancer."
      titleMaxWidth="20ch"
      bodyMaxWidth="58ch"
    />

    <div class="home-contact reveal">
      <div class="home-contact__actions">
        <BoutonReservation source="home_contact" class="btn-primary justify-center">
          Réserver un échange
        </BoutonReservation>
        <LinkCTA href={briefHref} goal="lead_email" goalSource="home_contact_brief">
          Envoyer mon brief par email
        </LinkCTA>
        <p>Un brouillon à compléter dans votre messagerie.</p>
      </div>

      <div class="home-contact__brief">
        <h3>Votre point de départ</h3>
        <p>Activité, besoin, outils et échéance&nbsp;: ces quatre repères suffisent.</p>
        <a href="mailto:bonjour@liliansevoumian.fr" data-fast-goal="lead_email" data-fast-goal-source="home_contact" class="text-link-arrow">
          <span>bonjour@liliansevoumian.fr</span><span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
    gap: 4rem;
    align-items: start;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border-strong);
  }

  .home-contact__actions {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    min-width: 0;
  }

  .home-contact p {
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .home-contact h3 {
    margin: 0;
    font-size: var(--text-title);
    font-weight: 600;
    line-height: 1.2;
  }

  .home-contact__brief {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    min-width: 0;
    padding-left: 2rem;
    border-left: 1px solid var(--color-border-strong);
  }

  .home-contact__brief a {
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .home-contact { grid-template-columns: 1fr; gap: 2.5rem; }
    .home-contact__brief { padding-top: 2rem; padding-left: 0; border-top: 1px solid var(--color-divider); border-left: 0; }
  }
</style>
