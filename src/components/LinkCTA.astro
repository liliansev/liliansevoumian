---
/*
 * LinkCTA — appel à l'action "texte" (pas un bouton). Inspiration éditoriale
 * Mistral : libellé mono + flèche qui avance, soulignement qui se dessine de
 * gauche à droite au hover/focus. À réserver aux actions SECONDAIRES — l'action
 * primaire d'une zone reste un .btn-primary plein (une seule par zone).
 *
 * La flèche est décorative (aria-hidden) ; le libellé passe via <slot/>.
 * C'est une icône Lucide, comme les flèches des boutons et des listes : un
 * glyphe typographique à côté d'icônes dessinées donnait deux dessins de
 * flèche sur une même page.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  external?: boolean;
  class?: string;
  goal?: string;
  goalSource?: string;
  prefill?: string;
}

const {
  href,
  external = false,
  class: className = '',
  goal,
  goalSource,
  prefill,
} = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-fast-goal={goal}
  data-fast-goal-source={goalSource}
  data-prefill={prefill}
  class={`link-cta ${className}`}
>
  <span class="link-cta__label"><slot />{external && <span class="sr-only"> (nouvel onglet)</span>}</span>
  <Icon name={external ? 'lucide:arrow-up-right' : 'lucide:arrow-right'} class="link-cta__arrow" aria-hidden="true" />
</a>
