---
/*
 * fin-de-page — la fin de chaque page : une phrase, un champ, le bouton.
 *
 * Elle est née sur l'accueil (elle s'appelait `home-offers`) et ferme toutes
 * les pages depuis le 3 octobre 2026 : chacune avait sa propre section de
 * contact, avec son titre, sa carte et son libellé de bouton. Il n'y a plus
 * qu'un geste, écrit une fois. Une page change le titre et la phrase qui le
 * suit ; l'accueil ajoute la ligne des prix.
 *
 * La page s'ouvre sur un titre posé sur une grille ; elle se ferme de la même
 * façon. Une phrase, centrée, qui dit ce qu'on fait ensuite, puis le champ et
 * le bouton.
 *
 * Le bouton est précédé d'un champ, comme une barre de prompt : le visiteur
 * écrit en une phrase ce qui lui fait perdre du temps. Écrire une phrase
 * engage moins que réserver un appel. Ce qu'il écrit ouvre la conversation de
 * `home-invite`, qui lui propose ensuite son moyen : WhatsApp, e-mail ou un
 * appel. Le champ est facultatif : vide, le bouton ouvre la même conversation.
 * Si la barre d'écriture n'a pas démarré, le bouton ouvre l'agenda, où la
 * phrase écrite est reprise (voir l'embed, dans Layout) ; sans aucun script,
 * c'est un simple lien vers l'agenda.
 *
 * Tout lien vers l'agenda passe par `BoutonReservation`.
 */
import { Icon } from 'astro-icon/components';
import BoutonReservation from './BoutonReservation.astro';
import { automationStartingPrice } from '../data/service-pricing';
import { DUREE_RESERVATION_MINUTES, LIBELLE_CONTACT_RESERVATION } from '../lib/reservation';

interface Props {
  /** Ancre de la section. `contact` partout ; l'accueil garde `offres`. */
  id?: string;
  /** Le titre, en HTML : un fragment court peut y être souligné par `mark`. */
  titre?: string;
  /** La phrase sous le titre, en HTML (un lien `lien-prose` y est permis). */
  suite?: string;
  /** D'où vient le clic, dans les statistiques. */
  source: string;
  /** La ligne des prix sous l'invite : l'accueil seulement, les pages d'offre
      portent déjà leurs prix. */
  prix?: boolean;
}

const {
  id = 'contact',
  titre = 'Dites-moi ce qui vous fait <mark>perdre du temps.</mark>',
  suite = 'Écrivez-moi.',
  source,
  prix = false,
} = Astro.props;

/* Mêmes noms que dans les blocs des métiers : une offre n'a qu'un nom sur la
   page. Les sites web ont quitté l'accueil le 3 octobre 2026 : la seconde
   offre est « Dashboards et outils métiers », sur devis, et mène à la partie
   « Applications » de la page d'offre. */
const euros = (montant: number) => `${montant.toLocaleString('fr-FR')}\u00a0€\u00a0HT`;
const offres = [
  {
    href: '/automatisations-ia',
    nom: 'Automatisation et agents\u00a0IA',
    avant: 'à partir de',
    prix: euros(automationStartingPrice),
    source: 'home_services_automation',
  },
  {
    href: '/sites-web-abonnement#applications',
    nom: 'Dashboards et outils métiers',
    avant: '',
    prix: 'sur devis',
    source: 'home_services_web',
  },
] as const;
---

<section id={id} data-section class="fin relative px-[var(--spacing-section-x)]">
  <div class="fin__grille" aria-hidden="true"></div>

  <div class="fin__centre reveal">
    {/* Sur l'accueil, le titre répond à celui qui ouvre le récit (« Vous
        perdez du temps. ») : la page se ferme sur la même idée, rendue cette
        fois au visiteur. */}
    <h2 class="fin__titre" set:html={titre} />
    <p class="fin__suite" set:html={suite} />
    <form class="invite" data-invite novalidate>
      <label class="sr-only" for="besoin">Ce qui vous fait perdre du temps, en une phrase (facultatif)</label>
      <textarea
        id="besoin"
        class="invite__champ"
        name="besoin"
        rows="1"
        maxlength="600"
        autocomplete="off"
        placeholder="J’ai une société de… et j’aimerais…"
        data-invite-champ
      ></textarea>
      <BoutonReservation
        source={source}
        class="btn-primary invite__envoi"
        aria-describedby="fin-apres"
        data-cal-note-from="#besoin"
        data-invite-envoi=""
      >
        {LIBELLE_CONTACT_RESERVATION} <Icon name="lucide:arrow-right" size={18} aria-hidden="true" />
      </BoutonReservation>
    </form>
    {/* Ce qui se passe après le clic. Rien n'est promis ici qui ne soit vrai du
        bouton lui-même : il ouvre la conversation de `home-invite` avec le mot
        écrit, et c'est elle qui propose WhatsApp, l'e-mail ou l'appel.
        « En visio » vient de l'événement Cal.com, qui se tient sur Google Meet
        (vérifié dans l'agenda le 2 octobre 2026) ; « sans engagement » est déjà
        écrit dans /llms.txt. */}
    <p id="fin-apres" class="fin__apres">
      Vous choisissez ensuite comment me joindre&nbsp;: WhatsApp, <span class="whitespace-nowrap">e-mail</span> ou un appel de
      {DUREE_RESERVATION_MINUTES}&nbsp;minutes en visio, sans engagement.
    </p>

    {/* Les prix tiennent en une ligne sous le bouton, pour qui est descendu
        jusqu'ici en cherchant un ordre de grandeur ; chacun mène à sa page
        d'offre. */}
    {prix && <p class="fin__prix">
      {offres.map((offre, i) => (
        <>
          {i > 0 && <span class="fin__sep" aria-hidden="true"> · </span>}
          <a href={offre.href} data-fast-goal="service_path_opened" data-fast-goal-source={offre.source}>
            {offre.nom}, {offre.avant}{offre.avant && ' '}<strong>{offre.prix}</strong>
          </a>
        </>
      ))}
    </p>}
  </div>
</section>

<style>
  .fin {
    --maille: var(--spacing-maille);
    --trait: color-mix(in srgb, var(--color-ink) 10%, transparent);
    display: grid;
    place-items: center;
    min-height: min(46rem, 88svh);
    padding-block: var(--spacing-section-y);
    overflow: clip;
    isolation: isolate;
  }

  /* La maille du premier écran, comptée depuis le centre, qui s'efface vers
     les bords. Immobile : le mouvement était au début, ici la page se pose. */
  .fin__grille {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(var(--trait) 1px, transparent 1px) 50% 50% / var(--maille) var(--maille),
      linear-gradient(90deg, var(--trait) 1px, transparent 1px) 50% 50% / var(--maille) var(--maille);
    -webkit-mask-image: radial-gradient(ellipse 62% 70% at 50% 50%, var(--color-night) 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 62% 70% at 50% 50%, var(--color-night) 0%, transparent 100%);
  }

  .fin__centre {
    display: grid;
    justify-items: center;
    gap: var(--spacing-lie);
    max-width: 62rem;
    text-align: center;
  }

  .fin__titre {
    max-width: 17ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    /* Borné par la largeur sous 372 px, pour que « perdre du temps. » reste
       sur une ligne à 320 px. */
    font-size: min(var(--text-story), 8.6vw);
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .fin__suite {
    max-width: 44ch;
    margin: 0;
    color: var(--color-ink-mid);
    font-size: var(--text-body-large);
    line-height: 1.5;
    text-wrap: balance;
  }

  /* ── L'invite : un champ et le bouton, dans un même cadre, comme une barre
        de prompt. Le focus se lit sur le cadre entier, pas sur le champ. ── */
  .invite {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.5rem;
    width: min(100%, 42rem);
    margin-top: 0.5rem;
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-night-deep) 86%, var(--color-ink));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
    text-align: left;
    transition:
      opacity var(--duration-default) var(--ease-out-quint),
      border-color var(--duration-default) var(--ease-out-quint),
      box-shadow var(--duration-default) var(--ease-out-quint);
  }

  /* Conversation ouverte : ce champ se met en retrait, pour qu'il n'y ait
     qu'un champ où écrire à l'écran. C'est `home-invite` qui pose `inert`, et
     qui le retire quand la conversation se referme. */
  .invite[inert] {
    opacity: 0.35;
  }

  .invite:focus-within {
    border-color: var(--color-peche);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent),
      0 0 0 3px color-mix(in srgb, var(--color-peche) 26%, transparent);
  }

  /* Le champ grandit avec ce qu'on y écrit (`field-sizing`, et le script pour
     les navigateurs qui ne l'ont pas). 16 px : en dessous, iOS zoome. */
  .invite__champ {
    field-sizing: content;
    min-width: 0;
    min-height: 44px;
    max-height: 9rem;
    padding: 0.625rem 0;
    border: 0;
    border-radius: var(--radius-xs);
    outline: none;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-body);
    line-height: 1.5;
    resize: none;
  }

  .invite__champ::placeholder {
    color: var(--color-ink-low);
    opacity: 1;
  }

  /* Le même bouton que dans la barre de navigation : même libellé, même casse,
     même flèche. Une action n'a qu'un seul traitement sur le site. */
  .invite :global(.invite__envoi) {
    min-height: 44px;
    white-space: nowrap;
  }

  /* Collée à l'invite : elle parle d'elle. */
  .fin__apres {
    max-width: 52ch;
    margin: calc(var(--spacing-colle) - var(--spacing-lie)) 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
    text-wrap: balance;
  }

  .fin__prix {
    max-width: none;
    margin: 0.5rem 0 0;
    color: var(--color-ink-low);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .fin__prix a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink-mid);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-ink) 28%, transparent);
    text-underline-offset: 0.28em;
    transition:
      color var(--duration-default) var(--ease-out-quint),
      text-decoration-color var(--duration-default) var(--ease-out-quint);
  }

  .fin__prix strong {
    margin-left: 0.3em;
    color: var(--color-ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .fin__prix a:hover {
      color: var(--color-ink);
      text-decoration-color: var(--color-peche);
    }
  }

  @media (max-width: 640px) {
    .fin {
      --maille: 3rem;
    }

    /* Une offre par ligne : côte à côte, les deux prix se coupaient au milieu.
       Le lien redevient un bloc de texte : en boîte flexible, son libellé se
       repliait en colonne à côté du prix quand la ligne ne tenait plus. Son
       remplissage vertical garde une cible de 44 px. */
    .fin__prix {
      display: grid;
      justify-items: center;
    }

    .fin__prix a {
      display: block;
      min-height: 0;
      padding-block: 0.75rem;
      text-wrap: balance;
    }

    .fin__sep {
      display: none;
    }

    /* Le champ au-dessus, le bouton dessous, sur toute la largeur. */
    .invite {
      grid-template-columns: minmax(0, 1fr);
      padding: 0.5rem;
    }

    .invite__champ {
      padding-inline: 0.75rem;
    }

    .invite :global(.invite__envoi) {
      justify-content: center;
    }
  }

  /* Hors du grand écran, la fin n'a pas besoin de tout un écran : elle
     laissait 200 à 230 px de vide au-dessus du titre et sous les prix, soit
     presque deux fois l'écart entre deux sections. */
  @media (max-width: 1023px) {
    .fin {
      min-height: min(40rem, 70svh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fin__prix a,
    .invite {
      transition: none;
    }
  }
</style>

<script>
  /* Entrée envoie, comme dans une barre de prompt (Maj + Entrée va à la ligne) :
     l'envoi est un clic sur le bouton, que `home-invite` intercepte pour ouvrir
     la conversation avec le mot écrit (si elle n'a pas démarré, Layout ouvre
     l'agenda). Sans ce script, le bouton marche seul.
     Pas d'écouteur `submit` : le formulaire n'a ni bouton d'envoi ni champ
     d'une ligne, rien ne peut donc le soumettre. */
  const invite = document.querySelector<HTMLFormElement>('[data-invite]');
  const champ = invite?.querySelector<HTMLTextAreaElement>('[data-invite-champ]');
  const envoi = invite?.querySelector<HTMLAnchorElement>('[data-invite-envoi]');
  if (invite && champ && envoi) {
    champ.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.shiftKey || e.isComposing) return;
      e.preventDefault();
      envoi.click();
    });
    /* Repli pour les navigateurs sans `field-sizing: content`. */
    if (!CSS.supports('field-sizing', 'content')) {
      const ajuster = () => {
        champ.style.height = 'auto';
        champ.style.height = `${champ.scrollHeight}px`;
      };
      champ.addEventListener('input', ajuster);
      ajuster();
    }
  }
</script>
