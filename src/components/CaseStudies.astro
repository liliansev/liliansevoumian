---
const caseStudies = [
  {
    metric: "-70\u00A0%",
    metricLabel: "TEMPS DE TRAITEMENT",
    badgeText: "-70%",
    title: "Onboarding client\u00A0: de 45\u00A0min à 12\u00A0min",
    description: "Un e-commerce en forte croissance perdait 45\u00A0minutes par nouveau client sur la saisie CRM, la facturation et l'envoi des accès. Workflow Make déployé en 5\u00A0jours. Résultat\u00A0: tout est automatisé, zéro erreur.",
    color: "#E86A33",
    cardClass: "card-3d-white-orange",
    badgeTextColor: "text-white",
  },
  {
    metric: "3x",
    metricLabel: "CAPACITÉ DE TRAITEMENT",
    badgeText: "3x",
    title: "Support client\u00A0: 850\u00A0tickets/mois sans recrutement",
    description: "Un SaaS noyait son équipe support sous les demandes répétitives. Chatbot IA déployé en 3\u00A0semaines\u00A0: il résout le niveau\u00A01 et escalade les cas complexes avec tout le contexte.",
    color: "#9333EA",
    cardClass: "card-3d-white-purple",
    badgeTextColor: "text-white",
  },
  {
    metric: "+15\u00A0h",
    metricLabel: "ÉCONOMISÉES PAR SEMAINE",
    badgeText: "+15h",
    title: "12 rapports manuels remplacés par des dashboards temps réel",
    description: "Un cabinet conseil passait 2\u00A0jours par semaine à compiler des rapports dans Excel. Dashboards automatisés avec alertes IA. ROI atteint en 3\u00A0semaines.",
    color: "#22D3EE",
    cardClass: "card-3d-white-cyan",
    badgeTextColor: "text-[#1A1A1A]",
  },
];
---

<section id="cas-clients" class="relative bg-white overflow-hidden">
  <div class="relative z-[1] py-20 lg:py-[120px] px-[var(--spacing-section-x)]">
    <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-12">
      <!-- Header -->
      <div class="flex flex-col items-center gap-5 fade-in-section">
        <span class="inline-block text-[12px] font-semibold tracking-[2px] uppercase text-[#E86A33] font-mono">
          RÉSULTATS
        </span>
        <h2 class="text-[40px] font-bold text-center text-[#1A1A1A] font-display w-full">
          Ce que l'automatisation change concrètement
        </h2>
      </div>

      <!-- Desktop: 3 columns grid -->
      <div class="hidden md:grid md:grid-cols-3 gap-6 reveal-stagger w-full">
        {caseStudies.map((study) => (
          <div class:list={["reveal-card flex flex-col gap-5 p-[28px_24px]", study.cardClass]}>
            <!-- Badge pill -->
            <span
              class:list={["inline-flex items-center justify-center self-start rounded-full px-[14px] py-[6px] text-[14px] font-bold font-mono", study.badgeTextColor]}
              style={`background: ${study.color};`}
            >
              {study.badgeText}
            </span>

            <!-- Title -->
            <h3 class="text-[18px] font-bold text-[#1A1A1A] font-display">
              {study.title}
            </h3>

            <!-- Description -->
            <p class="text-[14px] leading-[1.5] flex-1 text-[#666666] font-body">
              {study.description}
            </p>
          </div>
        ))}
      </div>

      <!-- Mobile: Horizontal scroll -->
      <div class="md:hidden relative w-full overflow-hidden">
        <div class="reveal-stagger flex gap-4 overflow-x-auto scrollbar-hide snap-x snap-mandatory pb-3 pl-0 pr-0">
          {caseStudies.map((study) => (
            <div class:list={["reveal-card flex flex-col gap-5 p-6 snap-start shrink-0 w-[85vw] max-w-[340px]", study.cardClass]}>
              <!-- Badge pill -->
              <span
                class:list={["inline-flex items-center justify-center self-start rounded-full px-[14px] py-[6px] text-[14px] font-bold font-mono", study.badgeTextColor]}
                style={`background: ${study.color};`}
              >
                {study.badgeText}
              </span>

              <!-- Title -->
              <h3 class="text-[18px] font-bold text-[#1A1A1A] font-display">
                {study.title}
              </h3>

              <!-- Description -->
              <p class="text-[14px] leading-[1.5] flex-1 text-[#666666] font-body">
                {study.description}
              </p>
            </div>
          ))}

          <!-- Spacer for right padding -->
          <div class="shrink-0 w-3" aria-hidden="true"></div>
        </div>

        <!-- Fade gradient on the right -->
        <div
          class="absolute top-0 right-0 bottom-0 w-12 pointer-events-none"
          style="background: linear-gradient(to left, white, transparent);"
          aria-hidden="true"
        ></div>
      </div>
    </div>
  </div>
</section>
