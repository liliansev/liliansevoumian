---
const caseStudies = [
  {
    metric: "-70\u00A0%",
    metricLabel: "TEMPS DE TRAITEMENT",
    badgeText: "-70%",
    title: "Onboarding client\u00A0: de 45\u00A0min à 12\u00A0min",
    description: "Un e-commerce en forte croissance perdait 45\u00A0minutes par nouveau client sur la saisie CRM, la facturation et l'envoi des accès. Workflow Make déployé en 5\u00A0jours. Résultat\u00A0: tout est automatisé, zéro erreur.",
    color: "#E86A33",
    cardClass: "card-3d-white-orange",
    badgeTextColor: "text-white",
    btnTextColor: "text-white",
    href: "/cas-clients/onboarding-ecommerce",
  },
  {
    metric: "3x",
    metricLabel: "CAPACITÉ DE TRAITEMENT",
    badgeText: "3x",
    title: "Support client\u00A0: 850\u00A0tickets/mois sans recrutement",
    description: "Un SaaS noyait son équipe support sous les demandes répétitives. Chatbot IA déployé en 3\u00A0semaines\u00A0: il résout le niveau\u00A01 et escalade les cas complexes avec tout le contexte.",
    color: "#9333EA",
    cardClass: "card-3d-white-purple",
    badgeTextColor: "text-white",
    btnTextColor: "text-white",
    href: "/cas-clients/chatbot-support-saas",
  },
  {
    metric: "+15\u00A0h",
    metricLabel: "ÉCONOMISÉES PAR SEMAINE",
    badgeText: "+15h",
    title: "12 rapports manuels remplacés par des dashboards temps réel",
    description: "Un cabinet conseil passait 2\u00A0jours par semaine à compiler des rapports dans Excel. Dashboards automatisés avec alertes IA. ROI atteint en 3\u00A0semaines.",
    color: "#22D3EE",
    cardClass: "card-3d-white-cyan",
    badgeTextColor: "text-[#1A1A1A]",
    btnTextColor: "text-[#1A1A1A]",
    href: "/cas-clients/reporting-dashboards-ia",
  },
];
---

<section data-bg="cream" id="cas-clients" class="relative bg-[var(--color-bg-dark)] overflow-hidden">
  <div class="absolute inset-0 dot-grid-cream" aria-hidden="true"></div>
  <div class="relative z-[1] py-[var(--spacing-section)] px-[var(--spacing-section-x)]">
    <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-12">
      <!-- Header -->
      <div class="flex flex-col items-center fade-in-section">
        <span class="inline-block text-[length:var(--text-caption)] font-semibold tracking-[2px] uppercase text-[#1A1A1A] font-mono mb-3">
          RÉSULTATS
        </span>
        <h2 class="text-[length:var(--text-heading)] font-bold text-center text-[#1A1A1A] font-display w-full">
          -70&nbsp;% de temps, 3x plus de capacité&nbsp;: résultats clients
        </h2>
      </div>

      <!-- Desktop: 3 columns grid -->
      <div class="hidden md:grid md:grid-cols-3 gap-6 reveal-stagger w-full">
        {caseStudies.map((study) => (
          <a href={study.href} class:list={["reveal-card card-3d-hover flex flex-col p-[28px_24px] no-underline group", study.cardClass]}>
            <!-- Badge pill -->
            <span
              class:list={["inline-flex items-center justify-center self-start rounded-full px-[14px] py-[6px] text-[length:var(--text-body)] font-bold font-mono", study.badgeTextColor]}
              style={`background: ${study.color};`}
            >
              {study.badgeText}
            </span>

            <!-- Title -->
            <h3 class="text-[length:var(--text-body-lg)] font-bold text-[#1A1A1A] font-display mt-3 mb-3">
              {study.title}
            </h3>

            <!-- Description -->
            <p class="text-[length:var(--text-body)] leading-[1.5] flex-1 text-[#666666] font-body">
              {study.description}
            </p>

            <!-- Read more -->
            <span class:list={["inline-flex items-center justify-center self-start rounded-lg px-5 py-2.5 mt-4 text-sm font-semibold font-body transition-all group-hover:opacity-90", study.btnTextColor]} style={`background: ${study.color};`}>
              Voir l'étude de cas <span class="inline-block ml-1 transition-transform group-hover:translate-x-1">&rarr;</span>
            </span>
          </a>
        ))}
      </div>

      <!-- Mobile: Horizontal scroll -->
      <div class="md:hidden relative w-full overflow-hidden">
        <div class="reveal-stagger flex gap-4 overflow-x-auto scrollbar-hide snap-x snap-mandatory pb-3 pl-0 pr-0">
          {caseStudies.map((study) => (
            <a href={study.href} class:list={["reveal-card flex flex-col p-6 snap-start shrink-0 w-[85vw] max-w-[340px] no-underline group", study.cardClass]}>
              <!-- Badge pill -->
              <span
                class:list={["inline-flex items-center justify-center self-start rounded-full px-[14px] py-[6px] text-[length:var(--text-body)] font-bold font-mono", study.badgeTextColor]}
                style={`background: ${study.color};`}
              >
                {study.badgeText}
              </span>

              <!-- Title -->
              <h3 class="text-[length:var(--text-body-lg)] font-bold text-[#1A1A1A] font-display mt-3 mb-3">
                {study.title}
              </h3>

              <!-- Description -->
              <p class="text-[length:var(--text-body)] leading-[1.5] flex-1 text-[#666666] font-body">
                {study.description}
              </p>

              <!-- Read more -->
              <span class="inline-flex items-center gap-1 mt-4 text-sm font-medium font-body transition-colors" style={`color: ${study.color};`}>
                Voir l'étude de cas
                <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
              </span>
            </a>
          ))}

          <!-- Spacer for right padding -->
          <div class="shrink-0 w-3" aria-hidden="true"></div>
        </div>

        <!-- Fade gradient on the right -->
        <div
          class="absolute top-0 right-0 bottom-0 w-12 pointer-events-none"
          style="background: linear-gradient(to left, #F8F7F4, transparent);"
          aria-hidden="true"
        ></div>

        <!-- Scroll indicator dots -->
        <div id="case-dots" class="flex justify-center gap-2 mt-4" aria-hidden="true">
          <div class="w-6 h-2 rounded-[4px] bg-[#1A1A1A] transition-all duration-200" data-dot="0"></div>
          <div class="w-2 h-2 rounded-full bg-[#D4D4D8] transition-all duration-200" data-dot="1"></div>
          <div class="w-2 h-2 rounded-full bg-[#D4D4D8] transition-all duration-200" data-dot="2"></div>
        </div>
      </div>

      <!-- Link to all case studies -->
      <a href="/cas-clients" class="inline-flex items-center gap-2 text-[length:var(--text-body)] font-medium font-body text-[#666666] hover:text-[#1A1A1A] transition-colors group">
        Voir tous les cas clients
        <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<script>
  function initScrollDots() {
    const scroller = document.querySelector('#cas-clients .overflow-x-auto');
    const dots = document.querySelectorAll('#case-dots [data-dot]');
    if (!scroller || !dots.length) return;

    scroller.addEventListener('scroll', () => {
      const scrollLeft = scroller.scrollLeft;
      const cardWidth = scroller.querySelector('.snap-start')?.clientWidth || 300;
      const gap = 16;
      const active = Math.round(scrollLeft / (cardWidth + gap));
      const clamped = Math.min(Math.max(active, 0), 2);

      dots.forEach((dot, i) => {
        if (i === clamped) {
          (dot as HTMLElement).style.backgroundColor = '#1A1A1A';
          (dot as HTMLElement).style.width = '24px';
          (dot as HTMLElement).style.borderRadius = '4px';
        } else {
          (dot as HTMLElement).style.backgroundColor = '#D4D4D8';
          (dot as HTMLElement).style.width = '8px';
          (dot as HTMLElement).style.borderRadius = '9999px';
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollDots);
  } else {
    initScrollDots();
  }
  document.addEventListener('astro:page-load', initScrollDots);
</script>
