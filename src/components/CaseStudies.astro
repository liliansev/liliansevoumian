---
import { Icon } from 'astro-icon/components';
import CaseStudyCard from './ui/CaseStudyCard.astro';
import { getCaseStudies } from '../lib/notion';

const allCaseStudies = await getCaseStudies();
const caseStudies = allCaseStudies.slice(0, 3);
const hasMore = allCaseStudies.length > 3;
---

{caseStudies.length > 0 && (
  <section id="cas-clients" class="section-padding px-6 bg-zinc-100">
    <div class="max-w-5xl mx-auto">
      <!-- Header -->
      <div class="mb-10 lg:mb-16">
        <p class="fluid-text-xs text-zinc-500 font-medium uppercase mb-3">
          Cas clients
        </p>
        <h2 class="fluid-h1 font-semibold text-zinc-900 max-w-2xl text-reveal">
          Des résultats<br />concrets.
        </h2>
      </div>

      <!-- Cards Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-10">
        {caseStudies.map((caseStudy) => (
          <CaseStudyCard caseStudy={caseStudy} />
        ))}
      </div>

      <!-- Link to all case studies -->
      {hasMore && (
        <div class="text-center">
          <a
            href="/cas-clients"
            class="group inline-flex items-center gap-2 text-zinc-600 hover:text-zinc-900 font-medium transition-colors"
          >
            Voir tous les cas clients
            <Icon
              name="lucide:arrow-right"
              class="w-4 h-4 transition-transform group-hover:translate-x-1"
            />
          </a>
        </div>
      )}
    </div>
  </section>
)}
