---
/*
 * Automatisations — « ce que j'automatise », en process et non en outils.
 *
 * LA SECTION QUI MANQUAIT. La home répondait dix fois à « quelle est l'étape
 * suivante » (dix-neuf points de réservation, une barre fixe, un bloc contact
 * en trois temps) et jamais, en clair, à la première question que se pose un
 * prospect : QUE SAIT-IL FAIRE. Le hero donnait une catégorie — n8n, Make,
 * agents IA. La section « outils » liste des outils. La section « offres »
 * liste des modes de collaboration : construire, reprendre, rendre la main.
 * Aucune des trois ne nomme un process que le lecteur reconnaîtrait comme le
 * sien.
 *
 * Cette liste existait pourtant, écrite, sur /expert-make et /expert-n8n
 * (« synchroniser votre CRM », « générer devis et factures depuis un
 * formulaire », « router les demandes entrantes »). Elle était invisible depuis
 * la page d'accueil. Elle remonte ici, reformulée autour de ce que les quatre
 * cas clients prouvent réellement.
 *
 * D'OÙ LA COLONNE DE PREUVES. Quatre des six lignes portent le cas qui les
 * documente, et le lien y mène. C'est la règle qui tient cette section : une
 * capacité annoncée renvoie à la mission où elle a tourné, ou elle reste
 * délibérément sans chiffre. Les deux lignes qui n'ont pas de cas publié —
 * reporting et alertes, reprise d'un existant — n'avancent aucune métrique ;
 * l'une est adossée à une réponse de la FAQ, l'autre à sa propre page.
 *
 * Placée juste après le hero et le bandeau d'outils, avant les cas : le lecteur
 * doit pouvoir se reconnaître AVANT qu'on lui montre des clients qui ne sont
 * pas lui.
 */
import SectionHeader from './SectionHeader.astro';
import LinkCTA from './LinkCTA.astro';

interface Process {
  titre: string;
  corps: string;
  /** Le cas qui documente cette ligne. Absent = aucun chiffre n'est avancé. */
  preuve?: { libelle: string; href: string };
}

const process: Process[] = [
  {
    titre: 'Facturation et devis',
    corps:
      'Du deal signé à la facture envoyée : échéances, TVA selon le pays, relances. La ressaisie disparaît, les erreurs remontent au lieu de dormir dans une file.',
    preuve: { libelle: 'Fraich Touch', href: '/cas-clients/facturation-automatisee-fraich-touch' },
  },
  {
    titre: 'Commandes e-commerce B2B',
    corps:
      'Un bon de commande reçu en PDF ou en Excel devient une commande Shopify et une facture, avec les bons produits, les bonnes remises et le bon client.',
    preuve: { libelle: 'Humble+', href: '/cas-clients/humble-plus' },
  },
  {
    titre: 'Prospection et qualification',
    corps:
      'Sourcing des signaux, collecte des cibles, notation des profils par un agent IA, puis envoi dans le CRM et les séquences. Vous validez, la machine fait le reste.',
    preuve: { libelle: 'M Partners', href: '/cas-clients/m-partners' },
  },
  {
    titre: 'Catalogue et données produit',
    corps:
      'Des fiches lues, structurées et créées directement dans votre ERP, en brouillon, pour qu’une personne valide avant publication.',
    preuve: { libelle: 'Celeris', href: '/cas-clients/celeris' },
  },
  {
    titre: 'Reporting et alertes',
    corps:
      'Les chiffres se consolident sans personne, et la panne se voit le jour où elle arrive : l’alerte tombe dans Slack, Notion ou votre boîte mail.',
  },
  {
    titre: 'Reprendre ce qui casse',
    corps:
      'Une automatisation construite par quelqu’un d’autre, qui tombe à chaque changement d’API. Je la relis, je la répare, je la rends suivable.',
    preuve: { libelle: 'La page dédiée', href: '/reprendre-une-automatisation-qui-casse' },
  },
];
---

<section
  id="automatisations"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      title="Ce que j'automatise, <mark>concrètement.</mark>"
      body="Six familles de process, celles qui reviennent le plus. Quatre sont documentées en détail dans un cas client, avec l'avant, l'après et les chiffres mesurés."
      titleMaxWidth="20ch"
      bodyMaxWidth="62ch"
    />

    {/* Même dispositif que les formats de la section « offres » : un filet de
        tête par item, jamais une carte. Le rythme de la page vient des traits,
        et une grille de six cartes à icône est exactement le motif que ce site
        évite partout ailleurs. */}
    <div class="reveal-stagger process-grille">
      {process.map((p) => (
        <div class="reveal process-item">
          <h3 class="font-display font-semibold text-[length:var(--text-title)] leading-[1.2] tracking-[-0.02em] m-0 text-[var(--color-ink)]">
            {p.titre}
          </h3>
          <p class="text-[length:var(--text-body)] text-[var(--color-ink-mid)] leading-[1.6] mt-3 mb-0">
            {p.corps}
          </p>
          {p.preuve && (
            <p class="process-preuve">
              <a class="lien-prose" href={p.preuve.href}>{p.preuve.libelle}</a>
            </p>
          )}
        </div>
      ))}
    </div>

    <div class="reveal process-pied">
      <p>
        Votre process n'est dans aucune de ces six&nbsp;? C'est le cas le plus
        fréquent&nbsp;: ce qui se répète chez vous ne ressemble à ce qui se
        répète ailleurs que de loin. La question utile n'est pas de savoir dans
        quelle famille il tombe, mais combien de temps il vous coûte.
      </p>
      <LinkCTA href="/cas-clients">Voir les quatre cas en entier</LinkCTA>
    </div>

  </div>
</section>

<style>
  .process-grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1.75rem, 4vw, 3.5rem);
  }

  .process-item {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-divider);
    padding: 1.75rem 0 0;
  }

  /* La preuve se cale en bas de colonne, comme la note « On part de… » des
     formats : les corps font trois ou quatre lignes selon la ligne, et un même
     rôle posé à trois horizontales différentes se lit comme un désalignement
     dans une grille explicitement filetée en colonnes. */
  .process-preuve {
    margin: auto 0 0;
    padding-top: 1rem;
    font-size: var(--text-body-sm);
    color: var(--color-ink-low);
  }

  .process-pied {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .process-pied p {
    margin: 0;
    max-width: 62ch;
    font-size: var(--text-body-sm);
    line-height: 1.6;
    color: var(--color-ink-low);
  }
</style>
