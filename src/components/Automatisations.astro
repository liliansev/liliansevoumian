---
// Scènes illustratives générées par IA, distinctes des vrais cas clients.
import { Image } from 'astro:assets';
import dossiers from '../assets/work-scenes/dossiers.png';
import commandes from '../assets/work-scenes/commandes.png';
import appel from '../assets/work-scenes/appel.png';
import SectionHeader from './SectionHeader.astro';

interface Famille {
  titre: string;
  corps: string;
}

const familles: Famille[] = [
  {
    titre: 'Facturation et devis',
    corps:
      '<strong>Créer les devis et les factures</strong> à partir de votre CRM, puis suivre les échéances et déclencher les relances.',
  },
  {
    titre: 'Commandes e-commerce B2B',
    corps:
      'Lire un bon de commande PDF ou Excel pour <strong>préparer la commande Shopify et la facture</strong>, avec des contrôles sur les produits et les montants.',
  },
  {
    titre: 'Prospection et qualification',
    corps:
      'Collecter des prospects, <strong>les qualifier selon vos critères</strong> et préparer leur ajout dans le CRM. Votre équipe se concentre sur les échanges.',
  },
  {
    titre: 'Catalogue et données produit',
    corps:
      'Extraire les informations des fiches fournisseurs et <strong>préparer les fiches produit dans votre ERP</strong>, à valider avant publication.',
  },
  {
    titre: 'Reporting et alertes',
    corps:
      '<strong>Rassembler vos chiffres dans un même suivi</strong> et envoyer une alerte lorsqu’un dossier ou une erreur demande votre attention.',
  },
  {
    titre: 'Demandes entrantes',
    corps:
      'Classer les emails et les formulaires, rassembler le contexte et <strong>transmettre chaque demande à la bonne personne.</strong>',
  },
];

const scenes = [
  { image: dossiers, alt: 'Une professionnelle consulte ses dossiers devant son ordinateur.', familles: [familles[0], familles[4]] },
  { image: commandes, alt: 'Un professionnel prépare une commande sur ordinateur dans une réserve.', familles: [familles[1], familles[3]] },
  { image: appel, alt: 'Une professionnelle au téléphone prend des notes à son bureau.', familles: [familles[2], familles[5]] },
];
---

<section
  id="automatisations"
  data-section
  class="relative py-[var(--spacing-section-y)] px-[var(--spacing-section-x)] border-t border-[var(--color-divider)]"
>
  <div class="relative max-w-[1200px] mx-auto">

    <SectionHeader
      title="Quelles tâches prennent <mark>trop de temps ?</mark>"
      body="Voici quelques points de départ pour alléger le quotidien de vos équipes."
      titleMaxWidth="20ch"
      bodyMaxWidth="62ch"
    />

    <div class="process-grille">
      {scenes.map((scene) => (
        <div class="process-group">
          <Image
            src={scene.image}
            alt={scene.alt}
            width={768}
            widths={[384, 768, 1200]}
            sizes="(min-width: 1340px) 368px, (min-width: 900px) 29vw, (min-width: 768px) 90vw, calc(100vw - 48px)"
            format="webp"
            quality={82}
            loading="lazy"
            decoding="async"
            class="process-photo"
          />
          {scene.familles.map((f) => (
            <div class="process-item">
              <h3 class="font-display font-semibold text-[length:var(--text-title)] leading-[1.2] tracking-[-0.02em] m-0 text-[var(--color-ink)]">
                {f.titre}
              </h3>
              <p class="text-[length:var(--text-body)] text-[var(--color-ink-mid)] leading-[1.6] mt-3 mb-0" set:html={f.corps} />
            </div>
          ))}
        </div>
      ))}
    </div>

    <div class="reveal process-pied">
      <p>
        Nous partons de <strong>vos outils et de vos tâches réelles</strong> pour choisir ce qui mérite d’être automatisé.
      </p>
      <a href="#offres" class="btn-primary">Voir les offres et le suivi <span aria-hidden="true">→</span></a>
    </div>

  </div>
</section>

<style>
  .process-grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .process-group {
    display: grid;
    grid-template-rows: auto 1fr 1fr;
    gap: 1.5rem;
    min-width: 0;
  }

  .process-group :global(.process-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--color-surface-low);
  }

  .process-item + .process-item {
    border-top: 1px solid var(--color-divider);
    padding-top: 1.5rem;
  }

  @media (max-width: 899px) {
    .process-grille {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }

    .process-group {
      grid-template-rows: auto auto auto;
    }
  }

  .process-pied {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .process-pied p {
    margin: 0;
    max-width: 62ch;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-ink-low);
  }
</style>
