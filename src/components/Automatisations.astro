---
/*
 * Automatisations — six points de départ, rangés sous trois scènes de travail.
 * Les photos sont des scènes illustratives générées par IA, distinctes des
 * vrais cas clients.
 */
import { Image } from 'astro:assets';
import dossiers from '../assets/work-scenes/dossiers.png';
import commandes from '../assets/work-scenes/commandes.png';
import appel from '../assets/work-scenes/appel.png';
import SectionHeader from './SectionHeader.astro';
import LinkCTA from './LinkCTA.astro';

interface Famille {
  titre: string;
  corps: string;
}

const familles: Famille[] = [
  {
    titre: 'Facturation et devis',
    corps:
      '<strong>Créer les devis et les factures</strong> à partir de votre CRM, puis suivre les échéances et déclencher les relances.',
  },
  {
    titre: 'Commandes e-commerce B2B',
    corps:
      'Lire un bon de commande PDF ou Excel pour <strong>préparer la commande Shopify et la facture</strong>, avec des contrôles sur les produits et les montants.',
  },
  {
    titre: 'Prospection et qualification',
    corps:
      'Collecter des prospects, <strong>les qualifier selon vos critères</strong> et préparer leur ajout dans le CRM. Votre équipe se concentre sur les échanges.',
  },
  {
    titre: 'Catalogue et données produit',
    corps:
      'Extraire les informations des fiches fournisseurs et <strong>préparer les fiches produit dans votre ERP</strong>, à valider avant publication.',
  },
  {
    titre: 'Reporting et alertes',
    corps:
      '<strong>Rassembler vos chiffres dans un même suivi</strong> et envoyer une alerte lorsqu’un dossier ou une erreur demande votre attention.',
  },
  {
    titre: 'Demandes entrantes',
    corps:
      'Classer les e-mails et les formulaires, rassembler le contexte et <strong>transmettre chaque demande à la bonne personne.</strong>',
  },
];

const scenes = [
  { image: dossiers, alt: 'Une professionnelle consulte ses dossiers devant son ordinateur.', familles: [familles[0], familles[4]] },
  { image: commandes, alt: 'Un professionnel prépare une commande sur ordinateur dans une réserve.', familles: [familles[1], familles[3]] },
  { image: appel, alt: 'Une professionnelle au téléphone prend des notes à son bureau.', familles: [familles[2], familles[5]] },
];
---

<section
  id="automatisations"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">

    <SectionHeader
      title="Quelles tâches prennent trop de temps&nbsp;?"
      body="Voici quelques points de départ pour alléger le quotidien de vos équipes."
      titleMaxWidth="20ch"
    />

    <div class="process-grille">
      {scenes.map((scene) => (
        <div class="process-group">
          {/* L'enveloppe porte le rayon et le rognage, et c'est elle qui s'ouvre
              au défilement pendant que la photo se pose (geste n° 3 de
              global.css). Sans `animation-timeline`, la photo est simplement
              là, arrondie. */}
          <div class="media-ouvre process-media">
            <Image
              src={scene.image}
              alt={scene.alt}
              width={768}
              widths={[384, 768, 1200]}
              sizes="(min-width: 1340px) 352px, (min-width: 900px) 27vw, (min-width: 768px) 90vw, calc(100vw - 48px)"
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
              class="process-photo"
            />
          </div>
          {scene.familles.map((f) => (
            <div class="process-item">
              <h3 class="m-0">{f.titre}</h3>
              <p class="m-0 mt-[var(--spacing-colle)] leading-[var(--leading-body)] text-[var(--color-ink-mid)]" set:html={f.corps} />
            </div>
          ))}
        </div>
      ))}
    </div>

    {/* La sortie de la section : un lien fléché. Le bouton plein reste celui
        de la conversation, dans la barre et en fin de page. */}
    <div class="reveal process-pied">
      <p>
        Nous partons de <strong>vos outils et de vos tâches réelles</strong> pour choisir ce qui mérite d’être automatisé.
      </p>
      <LinkCTA href="#offres">Voir les offres et le suivi</LinkCTA>
    </div>

  </div>
</section>

<style>
  .process-grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-gouttiere);
  }

  /* Trois rangées par scène : la photo, puis deux tâches de même hauteur, pour
     que les titres de la seconde rangée s'alignent d'une colonne à l'autre.
     L'espace les sépare, sans filet. */
  .process-group {
    display: grid;
    grid-template-rows: auto 1fr 1fr;
    gap: var(--spacing-groupe);
    min-width: 0;
  }

  /* Le fond d'attente est sur l'enveloppe : posé sur l'image, il dépasserait
     du rayon pendant le chargement. */
  .process-media {
    background: var(--color-surface-low);
  }

  .process-group :global(.process-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  @media (max-width: 899px) {
    .process-grille {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-bloc);
    }

    .process-group {
      grid-template-rows: auto;
    }
  }

  .process-pied {
    display: grid;
    justify-items: start;
    gap: var(--spacing-colle);
    margin-top: var(--spacing-bloc);
  }

  .process-pied p {
    margin: 0;
    line-height: var(--leading-body);
    color: var(--color-ink-mid);
  }
</style>
