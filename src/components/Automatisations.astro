---
/*
 * Automatisations — six points de départ, en trois colonnes. Les photos de
 * scènes de bureau générées qui les coiffaient sont retirées le 28 octobre
 * 2026 (Lilian : elles « font banque d'images ») : le texte suffit.
 */
import SectionHeader from './SectionHeader.astro';
import LinkCTA from './LinkCTA.astro';

interface Famille {
  titre: string;
  corps: string;
}

const familles: Famille[] = [
  {
    titre: 'Facturation et devis',
    corps:
      '<strong>Créer les devis et les factures</strong> à partir de votre CRM, puis suivre les échéances et déclencher les relances.',
  },
  {
    titre: 'Commandes e-commerce B2B',
    corps:
      'Lire un bon de commande PDF ou Excel pour <strong>préparer la commande Shopify et la facture</strong>, avec des contrôles sur les produits et les montants.',
  },
  {
    titre: 'Prospection et qualification',
    corps:
      'Collecter des prospects, <strong>les qualifier selon vos critères</strong> et préparer leur ajout dans le CRM. Votre équipe se concentre sur les échanges.',
  },
  {
    titre: 'Catalogue et données produit',
    corps:
      'Extraire les informations des fiches fournisseurs et <strong>préparer les fiches produit dans votre ERP</strong>, à valider avant publication.',
  },
  {
    titre: 'Reporting et alertes',
    corps:
      '<strong>Rassembler vos chiffres dans un même suivi</strong> et envoyer une alerte lorsqu’un dossier ou une erreur demande votre attention.',
  },
  {
    titre: 'Demandes entrantes',
    corps:
      'Classer les e-mails et les formulaires, rassembler le contexte et <strong>transmettre chaque demande à la bonne personne.</strong>',
  },
];

---

<section
  id="automatisations"
  data-section
  class="relative border-b border-[var(--color-divider)] px-[var(--spacing-section-x)] py-[var(--spacing-section-y)]"
>
  <div class="relative mx-auto max-w-[1200px]">

    <SectionHeader
      title="Quelles tâches prennent trop de temps&nbsp;?"
      body="Voici quelques points de départ pour alléger le quotidien de vos équipes."
      titleMaxWidth="20ch"
    />

    <ul class="process-grille" role="list">
      {familles.map((f) => (
        <li class="process-item reveal">
          <h3 class="m-0">{f.titre}</h3>
          <p class="m-0 mt-[var(--spacing-colle)] leading-[var(--leading-body)] text-[var(--color-ink-mid)]" set:html={f.corps} />
        </li>
      ))}
    </ul>

    {/* La sortie de la section : un lien fléché. Le bouton plein reste celui
        de la conversation, dans la barre et en fin de page. */}
    <div class="reveal process-pied">
      <p>
        Nous partons de <strong>vos outils et de vos tâches réelles</strong> pour choisir ce qui mérite d’être automatisé.
      </p>
      <LinkCTA href="#offres">Voir les offres et le suivi</LinkCTA>
    </div>

  </div>
</section>

<style>
  /* Six tâches en trois colonnes, chacune sous un trait de pointillés
     d'encre, comme les entrées du menu du carnet. */
  .process-grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-groupe) var(--spacing-gouttiere);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-item {
    max-width: none;
    padding-top: var(--spacing-lie);
    border-top: 2px dashed var(--color-service-border);
  }

  @media (max-width: 899px) {
    .process-grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .process-grille {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .process-pied {
    display: grid;
    justify-items: start;
    gap: var(--spacing-colle);
    margin-top: var(--spacing-bloc);
  }

  .process-pied p {
    margin: 0;
    line-height: var(--leading-body);
    color: var(--color-ink-mid);
  }
</style>
