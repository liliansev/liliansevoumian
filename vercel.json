{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "formations.liliansevoumian.fr"
        }
      ],
      "destination": "https://lab.augmentes.fr/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "formations.liliansevoumian.fr"
        }
      ],
      "destination": "https://lab.augmentes.fr/:path+",
      "permanent": true
    },
    {
      "source": "/sites-web-abonnement",
      "destination": "/outils-metiers",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/js/script.js",
      "destination": "https://datafa.st/js/script.cookieless.js"
    }
  ]
}
